% 50-self-hosting-main.weft — Stage 8-final: the entry point and CLI dispatch,
% written in C, compiled by kcc itself.  With this the whole compiler but for the
% raw-syscall wrappers is C, and the same source is the entry on both targets.

\chapter{Self-Hosting: The Entry Point in C}
\label{ch:self-hosting-main}

The driver's \texttt{\_main} (Chapter~\ref{ch:driver}) was the last piece of the
compiler still written in assembly other than the raw-syscall wrappers.  It is
pure control flow---initialise the subsystems, compare \texttt{argv[1]} against
each mode flag, run the corresponding prefix of the pipeline---so porting it to C
costs nothing in fidelity and buys two things at once.  First, it finishes the
self-hosting effort: every line of the compiler that is not a \texttt{svc}/%
\texttt{syscall} instruction is now C that kcc compiles.  Second, it is exactly
the entry point the second target needs.  A C function \texttt{main} becomes the
symbol \texttt{\_main} that Darwin's \texttt{libSystem} start calls, and it is
also the \texttt{main} that the Linux runtime's \texttt{\_start}
(Chapter~\ref{ch:runtime-linux}) calls after laying out \texttt{argc}/%
\texttt{argv}/\texttt{envp} from the stack---so one C source is the entry on both
platforms.  The environment pointer, which the driver hands to the linker
through \texttt{execve}, is recovered the same way the assembly did: it sits
immediately past \texttt{argv}'s terminating null, at \texttt{argv + argc + 1}.

Because \texttt{main} drives the entire compiler, the port is verified
functionally: swap the kcc-compiled \texttt{main.o} in for the assembly one and
the whole test corpus---\texttt{difftest}'s byte-exact comparison against clang,
the code-generation suite, and the diagnostic suite---must still pass, which it
can only do if the dispatch is faithful.

\section{Entry Point and Mode Dispatch}

\texttt{main} initialises the subsystems, then dispatches on the arguments.  The
diagnostic modes (\texttt{-{}-dump-tokens}, \texttt{-{}-dump-ast},
\texttt{-{}-check}, \texttt{-{}-dump-ir}, \ldots) are selected by \texttt{argv[1]};
anything else is a compile (\texttt{-c} anywhere) or a compile-and-link.

Two behaviours make the driver a usable gcc-style \texttt{CC=}.  First,
\texttt{-E} (preprocess only) is recognised \emph{anywhere} in the command line
and takes priority: \texttt{kcc\_run\_preprocess} registers the target, include
directories (\texttt{-I}), macros (\texttt{-D}), and force-includes
(\texttt{-include}) through the shared \texttt{kcc\_driver\_register\_flags}---so
a \texttt{\#include} resolves exactly as it would when compiling, not silently
vanishing---then preprocesses the source operand it returns (the last non-flag
word, or \texttt{-} for standard input), and \texttt{kcc\_pp\_emit\_text} writes the preprocessed token
stream back as C \emph{source text}---token spellings with line-preserving
newlines and no line markers---rather than kcc's token dump, because that is the
form a build system's compiler probe (Kbuild's \texttt{cc-version.sh}) reads.
Second, the startup banner is written to \texttt{stderr}, keeping \texttt{stdout}
clean for that probe.  The same faithful emission also drives
\texttt{kcc\_assemble\_source}: an assembly input (\texttt{.S}/\texttt{.s}) named
on a \texttt{-c} line is preprocessed straight into \texttt{<out>.s}---by pointing
\texttt{kcc\_io\_fd} at the file for the duration---and handed to the system
assembler, so kcc builds the kernel's hand-written assembly, not only its C.

@l c
@d Selfhost: main @{
/* subsystem init, front-end phases, sema, IR, driver, syscalls */
void kcc_arena_init(void);
void kcc_lex_kw_init(void);
void kcc_pp_add_default_includes(const char *path);
void kcc_io_puts(const char *);
void kcc_io_err(const char *);
void kcc_io_flush(void);
int kcc_strcmp(const char *, const char *);
void kcc_sys_exit(int);
void kcc_source_open(const char *);
void kcc_source_encode(void);
void kcc_source_splice(void);
void kcc_lex_init(void *base, unsigned long size);
void kcc_lex_dump_all(void);
unsigned long kcc_diag_had_errors(void);
void kcc_pp_init(void);
void kcc_pp_dump_all(void);
void kcc_strtab_init(void);
void kcc_typedef_init(void);
void *kcc_parse(void);
void kcc_ast_dump(void);
void kcc_types_init(void);
void kcc_symtab_init(void);
void kcc_sema_check(void *tu);
void kcc_sema_dump_types(void *tu);
void kcc_ir_init(void);
void kcc_ir_build(void *tu);
void kcc_opt_run(void);
void kcc_ir_dump(void);
void kcc_driver_compile_all(int argc, char **argv);
void kcc_driver_link_all(int argc, char **argv);
const char *kcc_driver_register_flags(long argc, char **argv);
void kcc_driver_apply_force_includes(void);
extern void *kcc_src_base;
extern unsigned long kcc_src_size;
extern char **kcc_envp;                          /* defined by the driver */
extern unsigned long kcc_target;                 /* set by --target=x86_64[-linux] */
extern unsigned long kcc_x86_os;
void kcc_pp_next(void);
/* For assembling `.S'/`.s' sources: preprocess-to-file then spawn the system as. */
unsigned long kcc_strlen(const char *);
void *kcc_arena_alloc(long);
long kcc_sys_open(const char *path, long flags, long mode);
long kcc_sys_close(long fd);
int kcc_driver_spawn(const char *path, char *const argv[]);
extern long kcc_io_fd;                           /* 1 (stdout) unless redirected */
extern unsigned long kcc_lex_asm;                /* relax `'' for .S/.s inputs */
void kcc_io_write(const char *buf, unsigned long len);
extern unsigned long kcc_tok_type, kcc_tok_len, kcc_tok_line;
extern const char *kcc_tok_start;
extern unsigned long kcc_pp_lead_ws;             /* token had leading source whitespace */

/* gcc-style -E: emit the preprocessed token stream as C source TEXT (not kcc's
   token dump).  Each token's spelling is written verbatim; a newline is emitted
   whenever the source line advances.  On the same line a space is written only
   where the source \emph{separated} the tokens.  The preprocessor reports that per
   token as \texttt{kcc\_pp\_lead\_ws}: normally the byte before the token, but at a
   macro-expansion boundary---where that byte lives in a macro buffer and the source
   gap is invisible---the leading whitespace of the invocation, carried through so
   \texttt{= VAL} prints \texttt{= 42}, matching gcc's PREV\_WHITE flag.  Reproducing
   the spacing rather than forcing a space between every pair is what lets the output
   feed an assembler: \texttt{.macro} must not become `\texttt{. macro}', a
   `\texttt{672:}' label must not split, and `\texttt{\%rax}' must stay joined.  A few
   would-fuse pairs still get a synthesised space even when the source (or the macro
   body) had none: two word tokens (\texttt{.balign}+\texttt{16}), two punctuators that
   would join into a longer operator (\texttt{--}/\texttt{>>}/\texttt{\&\&}), a pp-number
   before a \texttt{+}/\texttt{-}/\texttt{.} that could extend it (\texttt{1e}+\texttt{+5}
   $\to$ \texttt{1e+5}, \texttt{3}+\texttt{.5}), in asm mode a word then a
   \texttt{\%}/\texttt{\$}/\texttt{(} operand starter (a mnemonic and its \texttt{\%reg})
   or a symbol then a string/char literal.  The number case fires only at an expansion
   boundary---detected by the current token not abutting the previous one's end---so a
   body-internal \texttt{5+3} stays verbatim, as in gcc.  Line markers are omitted
   (matching gcc's -P).  Defined here, in the driver, over kcc_pp_next and the
   spacing flag it publishes. */
static int kcc_word_char(char c) {
    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
           (c >= '0' && c <= '9') || c == '_';
}

/* Would a token ending in `a' and one starting with `b', written adjacent, lex
   as a single longer pp-token?  The two-character C punctuators (`--', `>>',
   `&&', `+=', `->', ...); a mirror of the preprocessor's own paste table, kept
   local so the emitter stays self-contained.  `/'+`/' is deliberately absent:
   after phase 3 those are two operators, and a computed include path such as
   `asm/trace//x86_fpu.h' must keep its `//' rather than gain a stray space. */
static int kcc_emit_pastes(char a, char b) {
    switch (a) {
    case '+': return b == '+' || b == '=';
    case '-': return b == '-' || b == '>' || b == '=';
    case '<': return b == '<' || b == '=' || b == ':' || b == '%';
    case '>': return b == '>' || b == '=';
    case '=': case '!': case '*': case '/': case '%': case '^': return b == '=';
    case '&': return b == '&' || b == '=';
    case '|': return b == '|' || b == '=';
    case '#': return b == '#';
    case ':': return b == '>';
    case '.': return b == '.';
    default:  return 0;
    }
}

static void kcc_pp_emit_text(void) {
    unsigned long prev_line = 0;
    char prev_last = 0;
    unsigned long prev_type = 0;
    const char *prev_end = 0;                     /* end of the last token emitted */
    for (;;) {
        kcc_pp_next();
        if (kcc_tok_type == 0) break;             /* TOK_EOF */
        unsigned long line = kcc_tok_line;
        if (prev_line == 0) prev_line = line;
        else if (line != prev_line) {
            /* One newline on any line change.  Line numbers are NOT globally
               monotonic---each #include resets to~1, so catching up by count
               (`while prev<line') would merge every header's tail into the
               includer's line and, for a .S file, swallow a `.macro's `.endm'.
               A single newline per change puts every source line on its own
               output line, which is all the assembler (or a C re-parse) needs. */
            kcc_io_puts("\n");
            prev_line = line;
        }
        else {
            /* A space is emitted where the source separated the tokens.  The
               preprocessor publishes that as kcc_pp_lead_ws: for a plain token it
               is the byte before it, but across a macro-expansion boundary---where
               that byte lives in a macro buffer---it is the leading whitespace of
               the invocation, carried through so `= VAL' prints `= 42' and not
               `=42'.  Two adjacent word tokens still get a forced space even when
               the source had none, since fusing them would forge a wrong token
               (`.balign'+`16'->`.balign16'); a word then a `%'/`$'/`(' operand
               starter needs the same only in assembly (a mnemonic and its `%reg',
               `$imm', or `('), never in C where they are always distinct tokens. */
            const char *s = kcc_tok_start;
            char b = s[0];
            int space = (int)kcc_pp_lead_ws;
            if (!space && kcc_word_char(prev_last) &&
                (kcc_word_char(b) ||
                 (kcc_lex_asm && (b == '%' || b == '$' || b == '('))))
                space = 1;
            /* Two punctuators that would fuse into one longer token if abutted
               (`-'+`-'->`--', `>'+`>'->`>>', `&'+`&'->`&&') must stay apart
               across a macro-expansion boundary, where the source gap that kept
               them separate lives in another buffer and s[-1] cannot see it.
               The kernel plants exactly this: `MAX_NICE - MIN_NICE' with
               `MIN_NICE' expanding to `-20' would otherwise print `19 --20',
               which a re-parse reads as a post-decrement. */
            if (!space && kcc_emit_pastes(prev_last, b))
                space = 1;
            /* A pp-number abutting `+'/`-'/`.' can fuse into ONE number---a
               `.'-fraction (`3'+`.5'->`3.5'), or an exponent sign when the number
               ends in e/E/p/P (`1e'+`+5'->`1e+5', `0x1p'+`+3').  This only happens
               across a macro-expansion boundary: two tokens contiguous in the same
               buffer (`5+3' in an object-like body) already lexed apart and stay
               verbatim.  A boundary is exactly where the current token does not
               abut the previous one's end.  gcc spaces the whole class (matching
               its conservative PREV_WHITE avoid-paste); we do too rather than test
               the last char, keeping `= P3+1' as `3 +1'. */
            if (!space && kcc_tok_start != prev_end && prev_type == 2 /* TOK_NUMBER */ &&
                (b == '+' || b == '-' || b == '.'))
                space = 1;
            /* In assembly a directive or symbol abutting a string/char operand
               must stay separated: ELFNOTE's `.asciz CONFIG_BUILD_SALT' with an
               empty build salt expands to `.asciz ""', and glued to `.asciz""'
               the assembler reads an unterminated string and loses the note's
               `4484' label.  A C encoding-prefixed literal (L"..", u8"..") is a
               single token that never arrives here split, so gate this on asm
               mode to leave C output byte-for-byte unchanged. */
            if (!space && kcc_lex_asm && kcc_word_char(prev_last) &&
                (b == '"' || b == '\''))
                space = 1;
            if (space) kcc_io_puts(" ");
        }
        kcc_io_write(kcc_tok_start, kcc_tok_len);
        prev_last = kcc_tok_start[kcc_tok_len - 1];
        prev_type = kcc_tok_type;
        prev_end = kcc_tok_start + kcc_tok_len;
    }
    kcc_io_puts("\n");
    kcc_io_flush();
}

/* Terminal paths, mirroring the assembly's .Lmain_exit / _error_exit / usage. */
static void exit_ok(void)          { kcc_io_flush(); kcc_sys_exit(0); }
static void die_usage(const char *m){ kcc_io_err(m); kcc_sys_exit(1); }
static void finish(void) {
    if (kcc_diag_had_errors()) { kcc_io_flush(); kcc_sys_exit(1); }
    kcc_io_flush(); kcc_sys_exit(0);
}

/* Translation phases 1-2 then lexer init on the source at a given path.  An
   assembly input (`.S'/`.s') puts the lexer in relaxed mode so a stray `'' in a
   GAS `#'/`;' comment or a bare `'a' char does not read as an unterminated
   character constant. */
static void open_lex_path(const char *path) {
    unsigned long lp = kcc_strlen(path);
    kcc_lex_asm = (lp >= 2 && path[lp - 2] == '.' &&
                   (path[lp - 1] == 'S' || path[lp - 1] == 's')) ? 1 : 0;
    kcc_source_open(path);
    kcc_source_encode();                          /* phase 1: trigraphs */
    kcc_source_splice();                          /* phase 2: line splicing */
    kcc_lex_init(kcc_src_base, kcc_src_size);
}
static void open_lex(char **argv) { open_lex_path(argv[2]); }

/* Preprocess-only mode (`-E`): register the command line's target, include
   directories, macros, and force-includes exactly as the compile path does---so
   the headers a Kbuild `-nostdinc -I... -include...` line names actually
   resolve---then preprocess the source operand it returns and emit the token
   text.  Without registering `-I`/`-D`/`-include` here, every `#include` would
   fail to find its header and the output would be the unexpanded source. */
static void kcc_run_preprocess(int argc, char **argv) {
    const char *src = kcc_driver_register_flags(argc, argv);
    if (!src) die_usage("kcc: error: -E requires a source file\n");
    open_lex_path(src);
    kcc_pp_init();
    kcc_driver_apply_force_includes();
    kcc_pp_emit_text();
    finish();
}

/* Assemble a `.S'/`.s' source into an object, the way `gcc -c foo.S' does: a
   `.S' is run through the C preprocessor (emitting faithful assembler text into
   <out>.s), a `.s' is already preprocessed; either is handed to the system
   assembler.  Called from the compile loop for every assembly input, so a
   Kbuild line naming head_64.S resolves its headers and macros exactly as a C
   compile would.  Flags (-I/-D/-include) are already registered by the caller;
   we mirror the compile path's pp setup (init then force-includes).  Output is
   redirected to <out>.s by pointing kcc_io_fd at it for the duration. */
int kcc_assemble_source(const char *src, const char *out) {
    unsigned long ls = kcc_strlen(src);
    const char *asmpath = src;
    if (src[ls - 1] == 'S') {                     /* .S: preprocess first */
        unsigned long lo = kcc_strlen(out);
        char *tmp = (char *)kcc_arena_alloc((long)(lo + 3));
        unsigned long j = 0;
        for (; j < lo; j++) tmp[j] = out[j];
        tmp[lo] = '.'; tmp[lo + 1] = 's'; tmp[lo + 2] = 0;
        long fd = kcc_sys_open(tmp, 0x601, 0x1a4); /* O_WRONLY|O_CREAT|O_TRUNC, 0644 */
        if (fd < 0) { kcc_io_err("kcc: error: cannot create assembler output\n"); return 1; }
        kcc_io_flush();                            /* flush any pending stdout */
        long saved = kcc_io_fd;
        kcc_io_fd = fd;
        open_lex_path(src);
        kcc_pp_init();
        kcc_driver_apply_force_includes();
        kcc_pp_emit_text();                        /* writes preprocessed text to fd */
        kcc_io_fd = saved;
        kcc_sys_close(fd);
        if (kcc_diag_had_errors()) return 1;
        asmpath = tmp;
    }
    char *av[6];
    av[0] = (char *)"as";
    av[1] = (char *)"--64";
    av[2] = (char *)"-o";
    av[3] = (char *)out;
    av[4] = (char *)asmpath;
    av[5] = 0;
    return kcc_driver_spawn("/usr/bin/as", av) ? 1 : 0;
}

int main(int argc, char **argv) {
    /* envp sits past argv's terminating NULL, exactly as the assembly computes
       it; the driver passes it on to the linker via execve. */
    kcc_envp = argv + argc + 1;

    kcc_arena_init();
    kcc_lex_kw_init();
    /* register dirname(argv[0])+"include" once, before any file, so the shipped
       hosted headers resolve with no -I. */
    kcc_pp_add_default_includes(argv[0]);
    /* The startup banner is a diagnostic, so it goes to stderr---keeping stdout
       clean for `-E` output that build-system compiler probes capture. */
    kcc_io_err("kcc v0.1.0 - a formal C17 compiler for ARM64\n");

    if (argc < 2) {
        kcc_io_puts("usage: kcc [--dump-tokens|-E|--dump-ast|--dump-types|--check|--dump-ir|-c <src> -o <out>] <source.c>\n");
        exit_ok();
    }

    /* -E (preprocess only) may appear anywhere in a gcc/Kbuild command line;
       when present it takes priority and emits preprocessed source text. */
    for (int i = 1; i < argc; i++) {
        if (kcc_strcmp(argv[i], "-E") == 0) { kcc_run_preprocess(argc, argv); }
    }

    const char *a1 = argv[1];

    if (kcc_strcmp(a1, "--dump-tokens") == 0) {
        if (argc < 3) die_usage("kcc: error: --dump-tokens requires a source file\n");
        open_lex(argv);
        kcc_lex_dump_all();
        finish();
    }
    if (kcc_strcmp(a1, "--dump-ast") == 0) {
        if (argc < 3) die_usage("kcc: error: --dump-ast requires a source file\n");
        open_lex(argv);
        kcc_pp_init();
        kcc_strtab_init();
        kcc_typedef_init();
        kcc_parse();
        kcc_ast_dump();
        finish();
    }
    if (kcc_strcmp(a1, "--dump-types") == 0) {
        if (argc < 3) die_usage("kcc: error: --dump-types requires a source file\n");
        open_lex(argv);
        kcc_pp_init();
        kcc_strtab_init();
        kcc_typedef_init();
        void *tu = kcc_parse();
        kcc_types_init();
        kcc_symtab_init();
        kcc_sema_check(tu);
        kcc_sema_dump_types(tu);
        finish();
    }
    if (kcc_strcmp(a1, "--check") == 0) {
        if (argc < 3) die_usage("kcc: error: --check requires a source file\n");
        open_lex(argv);
        kcc_pp_init();
        kcc_strtab_init();
        kcc_typedef_init();
        void *tu = kcc_parse();
        kcc_types_init();
        kcc_symtab_init();
        kcc_sema_check(tu);
        kcc_io_flush();
        if (kcc_diag_had_errors()) kcc_sys_exit(1);
        kcc_io_puts("semantic check passed\n");
        exit_ok();
    }
    if (kcc_strcmp(a1, "--dump-ir") == 0) {
        if (argc < 3) die_usage("kcc: error: --dump-ir requires a source file\n");
        open_lex(argv);
        kcc_pp_init();
        kcc_strtab_init();
        kcc_typedef_init();
        void *tu = kcc_parse();
        kcc_types_init();
        kcc_symtab_init();
        kcc_sema_check(tu);
        if (kcc_diag_had_errors()) { kcc_io_flush(); kcc_sys_exit(1); }
        kcc_ir_init();
        kcc_ir_build(tu);
        kcc_opt_run();
        kcc_ir_dump();
        finish();
    }
    /* Compile-only mode: "-c" anywhere in the argument list, not only as the
       first argument.  gcc-driven builds (Kbuild) lead with the compiler flags
       and end with `-c -o out.o in.c`, so a fixed argv[1] test would miss it and
       fall through to link mode, feeding the object flags to ld. */
    for (int i = 1; i < argc; i++) {
        if (kcc_strcmp(argv[i], "-c") == 0) {
            kcc_driver_compile_all(argc, argv);   /* one object per source */
            exit_ok();
        }
    }

    /* Not a flag: the argument is a source file.  Compile every source and link
       the resulting objects into an executable (the default mode). */
    kcc_driver_link_all(argc, argv);
    exit_ok();
    return 0;                                     /* unreachable */
}
@}

\section{Composition and Verification}

@d Selfhost: main file @{
@<Selfhost: main@>
@}

@d Selfhost: main verify @{
#!/usr/bin/env bash
# make selfhost-main — compile kcc's entry point in C with kcc, relink in place
# of the assembly main.o, and run difftest + diagtest + codegen.  Because main
# drives the whole compiler, a clean sweep proves the dispatch is faithful.
set -euo pipefail
SDK=$(xcrun --show-sdk-path)
SH=tmp/selfhost
sources="main syscalls arena strings io hashtab vec strtab source lexer \
lexer_tables diag preprocessor parser expressions statements declarations \
types symtab conversions sema ir opt emit_arm64 emit_x86 linker codegen emit_macho dwarf driver"
echo "[1/4] compiling tmp/selfhost/main.c with kcc"
tmp/kcc -c "$SH/main.c" -o "$SH/main_c.o" >/dev/null
echo "[2/4] linking tmp/kcc_selfhost_main (main.o -> C)"
OBJ=""
for f in $sources; do
    if [ "$f" = "main" ]; then OBJ="$OBJ $SH/main_c.o"; else OBJ="$OBJ tmp/src/${f}.o"; fi
done
ld -o tmp/kcc_selfhost_main $OBJ -lSystem -syslibroot "$SDK" -e _main -arch arm64
cp tmp/kcc "$SH/kcc_asm_backup_main"
cp tmp/kcc_selfhost_main tmp/kcc
echo "[3/4] difftest + diagtest"
set +e
bash tmp/tests/difftest.sh >/tmp/main_difftest.log 2>&1; dstatus=$?
tail -1 /tmp/main_difftest.log
bash tmp/tests/diagtest.sh >/tmp/main_diag.log 2>&1; diagst=$?
tail -1 /tmp/main_diag.log
set -e
if [ $dstatus -ne 0 ] || [ $diagst -ne 0 ]; then cp "$SH/kcc_asm_backup_main" tmp/kcc; exit 1; fi
echo "[4/4] codegen suite with the self-hosted entry point"
set +e
bash tmp/tests/test_codegen.sh
status=$?
cp "$SH/kcc_asm_backup_main" tmp/kcc
exit $status
@}
