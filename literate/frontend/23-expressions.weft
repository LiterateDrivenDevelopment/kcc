% 23-expressions.weft — Expression Parsing
%
% This chapter implements expression parsing for the C17 recursive-descent
% parser.  Expressions are parsed using the precedence climbing method:
% a single function kcc_parse_binary_expr() handles all binary operators
% by consulting a precedence table, eliminating the need for separate
% functions per precedence level.
%
% The expression grammar follows ISO 9899:2018 §6.5:
%   expression → assignment-expr (',' assignment-expr)*
%   assignment-expr → conditional-expr | unary-expr assign-op assignment-expr
%   conditional-expr → binary-expr ('?' expr ':' conditional-expr)?
%   binary-expr → unary-expr (binop unary-expr)*    [precedence climbing]
%   unary-expr → postfix-expr | prefix-op unary-expr | sizeof | _Alignof | cast
%   postfix-expr → primary (postfix-op)*
%   primary → ident | number | string | char | '(' expr ')' | compound-literal

\chapter{Expression Parsing}
\label{ch:expressions}

Expression parsing translates the operator-rich surface syntax of C into AST nodes that capture evaluation order and associativity (\stdref{6.5}).  Rather than writing a separate function for each of C's fifteen precedence levels, we use precedence climbing: a single \texttt{kcc\_parse\_binary\_expr} function consults a lookup table to decide when to recurse.  This chapter covers the precedence table, the entry point for comma expressions, assignment and conditional operators, the climbing loop for binary operators, unary and cast expressions, postfix chains, and primary expressions including parenthesized sub-expressions and compound literals.

\section{Precedence Table}

The precedence climbing algorithm uses a lookup table mapping each
binary operator token to its precedence level.  The table is indexed
by \texttt{(tok\_type $-$ 60)}, covering the punctuator range.  Each
entry is a pair of bytes: precedence level (0 = not a binary op) and
a flag indicating right-associativity (unused for binary ops, which
are all left-associative).

C17 precedence levels (\stdref{6.5}):
\begin{center}
\begin{tabular}{rll}
\hline
Level & Operators & Associativity \\
\hline
4  & \texttt{||} & left \\
5  & \texttt{\&\&} & left \\
6  & \texttt{|} & left \\
7  & \texttt{\^{}} & left \\
8  & \texttt{\&} & left \\
9  & \texttt{== !=} & left \\
10 & \texttt{< > <= >=} & left \\
11 & \texttt{<< >>} & left \\
12 & \texttt{+ -} & left \\
13 & \texttt{* / \%} & left \\
\hline
\end{tabular}
\end{center}

@d Expr: precedence table @{
// -- Operator precedence lookup ----------------------------------------
// Given a token type t in the punctuator range (60+), the precedence
// is stored at _kcc_prec_table[t - 60].  Zero means "not a binary op".

.text

// -- _kcc_prec_lookup --------------------------------------------------
// uint64_t _kcc_prec_lookup(uint64_t tok_type)
//   x0 = token type
// Returns precedence level (0 = not a binary op).
.globl _kcc_prec_lookup
.p2align 2
_kcc_prec_lookup:
    // Check range: must be >= 60
    cmp x0, #60
    b.lo .Lprec_none

    sub x0, x0, #60
    // Check upper bound
    cmp x0, #48
    b.hs .Lprec_none

    adrp x1, _kcc_prec_table@@PAGE
    add  x1, x1, _kcc_prec_table@@PAGEOFF
    ldrb w0, [x1, x0]
    ret

.Lprec_none:
    mov x0, #0
    ret
@| _kcc_prec_lookup
@}

\section{Expression Entry Point}

\texttt{kcc\_parse\_expr} is the top-level expression parser.  It
parses an assignment expression, then checks for the comma operator
(\stdref{6.5.17}).

@d Expr: parse expression @{
// -- kcc_parse_expr ----------------------------------------------------
// node *kcc_parse_expr(void)
// Parses a full expression (handles comma operator).
// Returns AST node.
.globl _kcc_parse_expr
.p2align 2
_kcc_parse_expr:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]     // x20 is used for the comma rhs below

    bl _kcc_parse_assign_expr
    mov x19, x0                  // x19 = lhs

.Lexpr_comma_loop:
    // Check for comma operator
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_COMMA
    b.ne .Lexpr_done

    // Consume comma
    bl _kcc_pp_next

    // Parse rhs
    bl _kcc_parse_assign_expr
    // x0 = rhs

    // Build comma node: x19=lhs, x20=rhs
    mov x20, x0                  // x20 = rhs (callee-saved)
    mov x0, #AST_COMMA_EXPR
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]      // lhs
    str x20, [x0, #AST_F1]      // rhs
    mov x19, x0                  // new lhs = comma node
    b .Lexpr_comma_loop

.Lexpr_done:
    mov x0, x19

    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_parse_expr
@}

\section{Assignment Expression}

Assignment is right-associative: parse a conditional expression, and if
the next token is an assignment operator (\texttt{=}, \texttt{+=},
\texttt{-=}, etc.), recurse on the right-hand side.

@d Expr: parse assign @{
// -- kcc_parse_assign_expr ---------------------------------------------
// node *kcc_parse_assign_expr(void)
// Parses an assignment expression (right-associative).
.globl _kcc_parse_assign_expr
.p2align 2
_kcc_parse_assign_expr:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    bl _kcc_parse_cond_expr
    mov x19, x0                  // x19 = lhs

    // Check for assignment operators (94-104)
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]

    cmp  x0, #TOK_ASSIGN
    b.lt .Lassign_done
    cmp  x0, #TOK_OR_ASSIGN
    b.gt .Lassign_done

    // It's an assignment operator
    mov x20, x0                  // x20 = operator token

    // Consume the operator
    bl _kcc_pp_next

    // Recurse for right-hand side (right-associative)
    bl _kcc_parse_assign_expr
    mov x21, x0                  // x21 = rhs

    // Build assign node
    mov x0, #AST_ASSIGN_EXPR
    bl _kcc_ast_alloc
    str x20, [x0, #AST_F0]      // op
    str x19, [x0, #AST_F1]      // lhs
    str x21, [x0, #AST_F2]      // rhs
    mov x19, x0

.Lassign_done:
    mov x0, x19

    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_parse_assign_expr
@}

\section{Conditional Expression}

The ternary operator \texttt{?:} (\stdref{6.5.15}): parse a binary
expression, and if the next token is \texttt{?}, parse the ``then''
expression, expect \texttt{:}, and parse the ``else'' conditional.

@d Expr: parse conditional @{
// -- kcc_parse_cond_expr -----------------------------------------------
// node *kcc_parse_cond_expr(void)
// Parses a conditional expression (ternary ? :).
.globl _kcc_parse_cond_expr
.p2align 2
_kcc_parse_cond_expr:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    // Parse binary expression with minimum precedence 4 (logical OR)
    mov x0, #4
    bl _kcc_parse_binary_expr
    mov x19, x0                  // x19 = condition

    // Check for '?'
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_QUESTION
    b.ne .Lcond_done

    // Consume '?'
    bl _kcc_pp_next

    // GNU `a ?: b': an omitted middle operand (next token is ':') is recorded
    // as then == 0, so the IR reuses the condition's value.
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_COLON
    b.eq .Lcond_elvis

    // Parse 'then' expression (full expression, not just assignment)
    bl _kcc_parse_expr
    mov x20, x0                  // x20 = then
    b .Lcond_colon
.Lcond_elvis:
    mov x20, #0                  // omitted: reuse the condition
.Lcond_colon:

    // Expect ':'
    mov x0, #TOK_COLON
    bl _kcc_parse_expect

    // Parse 'else' (conditional, not assignment — right-associative)
    bl _kcc_parse_cond_expr
    mov x21, x0                  // x21 = else

    // Build cond node
    mov x0, #AST_COND_EXPR
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]      // condition
    str x20, [x0, #AST_F1]      // then
    str x21, [x0, #AST_F2]      // else
    mov x19, x0

.Lcond_done:
    mov x0, x19

    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_parse_cond_expr
@}

\section{Binary Expression (Precedence Climbing)}

The core of expression parsing.  \texttt{kcc\_parse\_binary\_expr}
receives a minimum precedence level and loops: parse a unary expression
as the left-hand side, then while the next token is a binary operator
with precedence $\geq$ \texttt{min\_prec}, consume it, recursively
parse the right-hand side with \texttt{(prec + 1)} (for left-associativity),
and build an \texttt{AST\_BINARY\_EXPR} node.

@d Expr: parse binary @{
// -- kcc_parse_binary_expr ---------------------------------------------
// node *kcc_parse_binary_expr(uint64_t min_prec)
//   x0 = minimum precedence level
// Returns AST node for the binary expression.
.globl _kcc_parse_binary_expr
.p2align 2
_kcc_parse_binary_expr:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]

    mov x19, x0                  // x19 = min_prec

    // Parse left operand (unary/cast)
    bl _kcc_parse_cast_expr
    mov x20, x0                  // x20 = lhs

.Lbinary_loop:
    // Peek at current token
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    mov  x21, x0                 // x21 = current token type

    // Look up precedence
    bl _kcc_prec_lookup
    mov x22, x0                  // x22 = precedence

    // If prec == 0 or prec < min_prec, stop
    cbz  x22, .Lbinary_done
    cmp  x22, x19
    b.lo .Lbinary_done

    // Consume the operator
    bl _kcc_pp_next

    // Parse right operand with prec+1 (left-associative)
    add x0, x22, #1
    bl _kcc_parse_binary_expr
    mov x22, x0                  // x22 = rhs (callee-saved)

    // Build binary node: x21=op, x20=lhs, x22=rhs
    mov x0, #AST_BINARY_EXPR
    bl _kcc_ast_alloc
    str x21, [x0, #AST_F0]      // op
    str x20, [x0, #AST_F1]      // lhs
    str x22, [x0, #AST_F2]      // rhs

    mov x20, x0                  // new lhs
    b .Lbinary_loop

.Lbinary_done:
    mov x0, x20

    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_parse_binary_expr
@}

\section{Unary Expression}

Unary expressions (\stdref{6.5.3}): prefix operators \texttt{++},
\texttt{--}, \texttt{\&}, \texttt{*}, \texttt{+}, \texttt{-},
\texttt{\~{}}, \texttt{!}, plus \texttt{sizeof} and \texttt{\_Alignof}.

@d Expr: parse unary @{
// -- kcc_parse_unary_expr ----------------------------------------------
// node *kcc_parse_unary_expr(void)
// Parses a unary expression.
.globl _kcc_parse_unary_expr
.p2align 2
_kcc_parse_unary_expr:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]

    // Check for prefix operators
    cmp x0, #TOK_INC             // ++
    b.eq .Lunary_prefix
    cmp x0, #TOK_DEC             // --
    b.eq .Lunary_prefix
    cmp x0, #TOK_AMP             // &
    b.eq .Lunary_prefix
    cmp x0, #TOK_STAR            // *
    b.eq .Lunary_prefix
    cmp x0, #TOK_PLUS            // +
    b.eq .Lunary_prefix
    cmp x0, #TOK_MINUS           // -
    b.eq .Lunary_prefix
    cmp x0, #TOK_TILDE           // ~
    b.eq .Lunary_prefix
    cmp x0, #TOK_BANG            // !
    b.eq .Lunary_prefix

    // sizeof
    cmp x0, #TOK_SIZEOF
    b.eq .Lunary_sizeof

    // _Alignof
    cmp x0, #TOK__ALIGNOF
    b.eq .Lunary_alignof

    // Otherwise, postfix expression
    bl _kcc_parse_postfix_expr
    b .Lunary_done_direct

.Lunary_prefix:
    mov x19, x0                  // x19 = operator token
    bl _kcc_pp_next               // consume operator

    // Recurse for operand
    bl _kcc_parse_cast_expr
    mov x20, x0                  // x20 = operand

    // Build unary node
    mov x0, #AST_UNARY_EXPR
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]      // op
    str x20, [x0, #AST_F1]      // operand
    mov x1, #1
    str  x1, [x0, #AST_F2]      // prefix = 1
    b .Lunary_done_direct
@| _kcc_parse_unary_expr
@}

\paragraph{Sizeof and \_Alignof.}
The \texttt{sizeof} operator (\stdref{6.5.3.4}) comes in two forms:
\texttt{sizeof(type-name)} queries the size of a type directly, while
\texttt{sizeof expr} measures the type of an expression without evaluating it.
The \texttt{\_Alignof} operator always takes a parenthesized type name.
Both produce compile-time integer constants.

@d Expr: parse unary @{
.Lunary_sizeof:
    // Consume 'sizeof'
    bl _kcc_pp_next

    // Check for '(' type-name ')'
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_LPAREN
    b.ne .Lunary_sizeof_expr

    // Could be sizeof(type) or sizeof(expr) — check next token
    // Save state: we'll peek after '(' to see if it's a type
    bl _kcc_pp_next               // consume '('

    // Check if next token starts a type
    bl _kcc_parse_is_type_token
    cbz x0, .Lunary_sizeof_paren_expr

    // sizeof(type-name)
    bl _kcc_parse_type_name
    mov x19, x0                  // x19 = type node
    mov x0, #TOK_RPAREN
    bl _kcc_parse_expect

    mov x0, #AST_SIZEOF_EXPR
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]      // operand = type
    mov x1, #1
    str  x1, [x0, #AST_F1]      // is_type = 1
    b .Lunary_done_direct

.Lunary_sizeof_paren_expr:
    // It's sizeof(expr) — parse expression inside parens
    bl _kcc_parse_expr
    mov x19, x0
    mov x0, #TOK_RPAREN
    bl _kcc_parse_expect

    // Wrap in paren node
    mov x20, x19
    mov x0, #AST_PAREN_EXPR
    bl _kcc_ast_alloc
    str x20, [x0, #AST_F0]
    mov x19, x0

    mov x0, #AST_SIZEOF_EXPR
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]      // operand = paren(expr)
    str xzr, [x0, #AST_F1]      // is_type = 0
    b .Lunary_done_direct

.Lunary_sizeof_expr:
    // sizeof unary-expression
    bl _kcc_parse_unary_expr
    mov x19, x0

    mov x0, #AST_SIZEOF_EXPR
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]
    str xzr, [x0, #AST_F1]      // is_type = 0
    b .Lunary_done_direct

.Lunary_alignof:
    // _Alignof ( type-name )
    bl _kcc_pp_next               // consume '_Alignof'
    mov x0, #TOK_LPAREN
    bl _kcc_parse_expect

    bl _kcc_parse_type_name
    mov x19, x0

    mov x0, #TOK_RPAREN
    bl _kcc_parse_expect

    mov x0, #AST_ALIGNOF_EXPR
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]

.Lunary_done_direct:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@}

\section{Cast Expression}

A cast expression (\stdref{6.5.4}) looks like \texttt{(type-name) expr}.
The difficulty is distinguishing a cast from a parenthesized expression.
We check: if the current token is \texttt{(} and the next token starts
a type specifier, it's a cast; otherwise fall through to unary.

@d Expr: parse cast @{
// -- kcc_parse_cast_expr -----------------------------------------------
// node *kcc_parse_cast_expr(void)
// Parses a cast expression or falls through to unary.
.globl _kcc_parse_cast_expr
.p2align 2
_kcc_parse_cast_expr:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    // Check for '(' that might start a cast
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_LPAREN
    b.ne .Lcast_unary

    // Save token state to determine if this is a cast or paren expr.
    // We need to look ahead: consume '(' and check if type follows.
    // But we can't un-consume, so we'll use is_type_token after '('.

    // Consume '('
    bl _kcc_pp_next

    // GNU statement expression: `({ statements })`.  A brace immediately
    // after the opening parenthesis is unambiguous -- no type-name or
    // ordinary expression can begin with `{` in this position.
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_LBRACE
    b.eq .Lcast_stmt_expr

    // Check if next token starts a type
    bl _kcc_parse_is_type_token
    cbz x0, .Lcast_paren_expr

    // It's a cast: (type-name) cast-expr
    bl _kcc_parse_type_name
    mov x19, x0                  // x19 = type

    mov x0, #TOK_RPAREN
    bl _kcc_parse_expect

    // Check for compound literal: (type) { ... }
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_LBRACE
    b.eq .Lcast_compound_lit

    // Regular cast
    bl _kcc_parse_cast_expr
    mov x20, x0                  // x20 = inner expr

    mov x0, #AST_CAST_EXPR
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]      // type
    str x20, [x0, #AST_F1]      // expr
    b .Lcast_done

.Lcast_compound_lit:
    // Compound literal: (type) { init-list }.  Like a parenthesised primary it
    // is a postfix-expression, so member/subscript/call suffixes may chain onto
    // it: `(struct S){1,2}.a`, `(int[]){1,2,3}[i]`.
    bl _kcc_parse_initializer
    mov x20, x0                  // x20 = init list

    mov x0, #AST_COMPOUND_LIT
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]      // type
    str x20, [x0, #AST_F1]      // init_list
    bl _kcc_parse_postfix_tail   // apply any .m / [i] / (args) suffixes
    b .Lcast_done

.Lcast_paren_expr:
    // Not a cast — it's a parenthesized expression
    bl _kcc_parse_expr
    mov x19, x0

    mov x0, #TOK_RPAREN
    bl _kcc_parse_expect

    // Wrap in paren node, then continue with postfix operations
    mov x0, #AST_PAREN_EXPR
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]

    // Apply postfix operations (call, subscript, member access, etc.)
    bl _kcc_parse_postfix_tail
    b .Lcast_done

.Lcast_stmt_expr:
    // GNU statement expression: the `(` is consumed and a compound statement
    // follows.  `_kcc_parse_compound` consumes the whole `{ ... }` block; the
    // value of the construct is that of its final expression-statement,
    // determined later in semantic analysis.  Suffixes may chain onto it, so
    // it too runs through the postfix tail.
    bl _kcc_parse_compound        // consumes `{ ... }`
    mov x19, x0

    mov x0, #TOK_RPAREN
    bl _kcc_parse_expect

    mov x0, #AST_STMT_EXPR
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]        // F0 = compound statement
    bl _kcc_parse_postfix_tail
    b .Lcast_done

.Lcast_unary:
    bl _kcc_parse_unary_expr

.Lcast_done:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_parse_cast_expr
@}

\section{Postfix Expression}

Postfix expressions (\stdref{6.5.2}): a primary expression followed
by zero or more postfix operations: array subscript \texttt{[i]},
function call \texttt{(args)}, member access \texttt{.field} or
\texttt{->field}, and postfix \texttt{++}/\texttt{--}.

@d Expr: parse postfix @{
// -- kcc_parse_postfix_expr --------------------------------------------
// node *kcc_parse_postfix_expr(void)
// Parses a primary expression followed by postfix operations.
.globl _kcc_parse_postfix_expr
.p2align 2
_kcc_parse_postfix_expr:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    // Parse primary
    bl _kcc_parse_primary_expr
    // x0 = primary node

    // Apply postfix tail
    bl _kcc_parse_postfix_tail

    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- kcc_parse_postfix_tail --------------------------------------------
// node *kcc_parse_postfix_tail(node *expr)
//   x0 = expression to apply postfix operations to
// Returns the final expression node.
.globl _kcc_parse_postfix_tail
.p2align 2
_kcc_parse_postfix_tail:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    mov x19, x0                  // x19 = current expr

.Lpostfix_loop:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]

    cmp x0, #TOK_LBRACKET
    b.eq .Lpostfix_subscript

    cmp x0, #TOK_LPAREN
    b.eq .Lpostfix_call

    cmp x0, #TOK_DOT
    b.eq .Lpostfix_member_dot

    cmp x0, #TOK_ARROW
    b.eq .Lpostfix_member_arrow

    cmp x0, #TOK_INC
    b.eq .Lpostfix_inc

    cmp x0, #TOK_DEC
    b.eq .Lpostfix_dec

    // No more postfix ops
    mov x0, x19
    b .Lpostfix_done

.Lpostfix_subscript:
    // Consume '['
    bl _kcc_pp_next
    // Parse index expression
    bl _kcc_parse_expr
    mov x20, x0                  // x20 = index
    // Expect ']'
    mov x0, #TOK_RBRACKET
    bl _kcc_parse_expect
    // Build subscript node
    mov x0, #AST_SUBSCRIPT
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]      // array
    str x20, [x0, #AST_F1]      // index
    mov x19, x0
    b .Lpostfix_loop

.Lpostfix_call:
    // Special form va_arg(ap, type-name): the second operand is a type, not
    // an expression, so it cannot go through the normal argument list.
    ldr x0, [x19, #AST_TAG]
    cmp x0, #AST_IDENT_EXPR
    b.ne .Lpostfix_call_normal
    ldr x0, [x19, #AST_F0]      // interned callee name
    adrp x1, _kcc_str_va_arg@@PAGE
    add  x1, x1, _kcc_str_va_arg@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lpostfix_va_arg

.Lpostfix_call_normal:
    // Consume '('
    bl _kcc_pp_next
    // Parse argument list
    bl _kcc_parse_arg_list
    mov x20, x0                  // x20 = first arg (or null)
    // Expect ')'
    mov x0, #TOK_RPAREN
    bl _kcc_parse_expect
    // Build call node
    mov x0, #AST_CALL_EXPR
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]      // callee
    str x20, [x0, #AST_F1]      // first arg
    mov x19, x0
    b .Lpostfix_loop

.Lpostfix_va_arg:
    bl _kcc_pp_next              // consume '('
    bl _kcc_parse_assign_expr    // the va_list expression
    mov x20, x0
    mov x0, #TOK_COMMA
    bl _kcc_parse_expect
    bl _kcc_parse_type_name      // the target type
    mov x21, x0
    mov x0, #TOK_RPAREN
    bl _kcc_parse_expect
    mov x0, #AST_VA_ARG
    bl _kcc_ast_alloc
    str x20, [x0, #AST_F0]      // va_list expr
    str x21, [x0, #AST_F1]      // type node
    mov x19, x0
    b .Lpostfix_loop
@| _kcc_parse_postfix_expr
@| _kcc_parse_postfix_tail
@}

\paragraph{Member access and increment/decrement.}
The remaining postfix operators handle structure and union member access
via the dot (\texttt{.}) and arrow (\texttt{->}) operators, and the
postfix increment/decrement operators (\texttt{++}/\texttt{--}).
The dot and arrow cases share a common path that interns the field name
and builds an \texttt{AST\_MEMBER} node.

@d Expr: parse postfix @{
.Lpostfix_member_dot:
    mov x21, #0                   // x21 = 0 means dot
    bl _kcc_pp_next               // consume '.'
    b .Lpostfix_member_common

.Lpostfix_member_arrow:
    mov x21, #1                   // x21 = 1 means arrow
    bl _kcc_pp_next               // consume '->'

.Lpostfix_member_common:
    // Current token should be identifier (field name)
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_tok_len@@PAGE
    add  x1, x1, _kcc_tok_len@@PAGEOFF
    ldr  x1, [x1]
    bl _kcc_strtab_intern
    mov x20, x0                  // x20 = interned name

    // Consume identifier
    bl _kcc_pp_next

    // Build member node
    mov x0, #AST_MEMBER
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]      // object
    str x20, [x0, #AST_F1]      // name_ptr
    str x21, [x0, #AST_F2]      // arrow flag (0=dot, 1=arrow)
    mov x19, x0
    b .Lpostfix_loop

.Lpostfix_inc:
    bl _kcc_pp_next               // consume '++'
    mov x0, #AST_UNARY_EXPR
    bl _kcc_ast_alloc
    mov x1, #TOK_INC
    str  x1, [x0, #AST_F0]      // op = ++
    str x19, [x0, #AST_F1]      // operand
    str xzr, [x0, #AST_F2]      // postfix = 0
    mov x19, x0
    b .Lpostfix_loop

.Lpostfix_dec:
    bl _kcc_pp_next               // consume '--'
    mov x0, #AST_UNARY_EXPR
    bl _kcc_ast_alloc
    mov x1, #TOK_DEC
    str  x1, [x0, #AST_F0]      // op = --
    str x19, [x0, #AST_F1]      // operand
    str xzr, [x0, #AST_F2]      // postfix = 0
    mov x19, x0
    b .Lpostfix_loop

.Lpostfix_done:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@}

\section{Primary Expression}

Primary expressions (\stdref{6.5.1}): identifiers, integer constants,
string literals, character constants, and parenthesized expressions.

Because \texttt{kcc\_ast\_alloc} stamps a node with the \emph{current}
token's location, the identifier case allocates its node \emph{before}
consuming the token.  Otherwise the node would record the position of
the following token, and a diagnostic caret on, say, an undeclared
identifier would point one token too far to the right.

For string literals, the lexer delivers the raw token including the
surrounding double quotes.  We strip the quotes, then call
\texttt{kcc\_strlit\_process} (Chapter~\ref{ch:string-literals}) to translate
C~escape sequences: \verb|\n|~becomes \texttt{0x0A},
\verb|\t|~becomes \texttt{0x09}, \verb|\\|~becomes a single backslash,
and so on.  The function returns a freshly allocated buffer with the
processed bytes and its new (possibly shorter) length.
Character literals receive the same treatment: we strip the single
quotes, run the escape processor, and read the first byte of the
result.  This means \verb|'\n'| correctly evaluates to~10.

@d Expr: parse primary @{
// -- kcc_parse_primary_expr --------------------------------------------
// node *kcc_parse_primary_expr(void)
// Parses a primary expression.
.globl _kcc_parse_primary_expr
.p2align 2
_kcc_parse_primary_expr:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]

    cmp x0, #TOK_IDENT
    b.eq .Lprimary_ident

    cmp x0, #TOK_NUMBER
    b.eq .Lprimary_number

    cmp x0, #TOK_STRING_LIT
    b.eq .Lprimary_string

    cmp x0, #TOK_CHAR_LIT
    b.eq .Lprimary_char

    cmp x0, #TOK_LPAREN
    b.eq .Lprimary_paren

    cmp x0, #TOK__GENERIC
    b.eq .Lprimary_generic

    // Error: unexpected token
    adrp x0, _kcc_expr_msg_expected@@PAGE
    add  x0, x0, _kcc_expr_msg_expected@@PAGEOFF
    bl _kcc_parse_error
    mov x0, #0                   // return null
    b .Lprimary_done

.Lprimary_ident:
    // Intern the identifier name
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_tok_len@@PAGE
    add  x1, x1, _kcc_tok_len@@PAGEOFF
    ldr  x1, [x1]
    bl _kcc_strtab_intern
    mov x19, x0                  // x19 = interned name

    // Build ident node BEFORE consuming, so it records the identifier's
    // own column rather than that of the following token.
    mov x0, #AST_IDENT_EXPR
    bl _kcc_ast_alloc
    mov x20, x0
    str x19, [x20, #AST_F0]      // name_ptr

    // Consume identifier
    bl _kcc_pp_next
    mov x0, x20
    b .Lprimary_done

.Lprimary_number:
    // A pp-number is either an integer or a floating constant.
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_tok_len@@PAGE
    add  x1, x1, _kcc_tok_len@@PAGEOFF
    ldr  x1, [x1]
    bl _kcc_is_float_literal
    cbnz x0, .Lprimary_float

    // Integer literal: parse the value from token text.
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_tok_len@@PAGE
    add  x1, x1, _kcc_tok_len@@PAGEOFF
    ldr  x1, [x1]
    bl _kcc_parse_atoi
    mov x19, x0                  // x19 = numeric value

    // Scan the suffix for u/U (unsigned) and l/L (long rank).  Scanning the
    // whole token text is safe: `u` and `l` are never digits in any radix
    // (decimal, 0x hex, 0 octal, 0b binary), so only the suffix letters match.
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_tok_len@@PAGE
    add  x1, x1, _kcc_tok_len@@PAGEOFF
    ldr  x1, [x1]
    add  x1, x0, x1              // x1 = one past last char
    mov  x21, #0                 // x21 = unsigned flag (bit 0)
    mov  x3, #0                  // x3 = count of l/L
.Lnum_sfx_loop:
    cmp  x0, x1
    b.hs .Lnum_sfx_done
    ldrb w2, [x0], #1
    orr  w2, w2, #0x20           // fold to lower case
    cmp  w2, #'u'
    b.ne .Lnum_sfx_notu
    orr  x21, x21, #1
    b    .Lnum_sfx_loop
.Lnum_sfx_notu:
    cmp  w2, #'l'
    b.ne .Lnum_sfx_loop
    add  x3, x3, #1
    b    .Lnum_sfx_loop
.Lnum_sfx_done:
    cmp  x3, #2                  // clamp long rank at 2 (long long)
    b.ls .Lnum_sfx_rank
    mov  x3, #2
.Lnum_sfx_rank:
    lsl  x3, x3, #1             // rank into bits 1-2
    orr  x21, x21, x3           // x21 = suffix-derived flags

    // Value-directed widening (C17 6.4.4.1): the constant's type is the first
    // in a suffix-and-base-dependent list that can represent its value.  The
    // suffix fixed a floor (unsigned bit x4, long rank x5); climb from there
    // by magnitude.  LP64: int=32b, long=long long=64b.
    and  x4, x21, #1            // x4 = unsigned floor
    lsr  x5, x21, #1
    and  x5, x5, #3            // x5 = long-rank floor
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x0, [x0]
    ldrb w6, [x0]              // first char: '0' prefix ⇒ non-decimal
    cmp  w6, #'0'
    cset w7, ne               // w7 = isDecimal
    mov  w8, #0xFFFF
    movk w8, #0x7FFF, lsl #16 // w8 = INT_MAX (0x7FFFFFFF)
    cmp  x19, x8
    cset w9, ls               // w9 = fits signed int
    mov  w10, #-1             // w10 = UINT_MAX (0xFFFFFFFF)
    cmp  x19, x10
    cset w11, ls              // w11 = fits unsigned int
    cmp  x19, #0
    cset w12, pl              // w12 = fits signed long (top bit clear)
    cbnz x4, .Lwiden_u
    cbnz w7, .Lwiden_dec
    // Non-decimal, no unsigned suffix: int,uint,long,ulong,llong,ullong.
    cbnz x5, .Lwiden_rank_hi
    cbnz w9, .Lwiden_r0s
    cbnz w11, .Lwiden_r0u
    cbnz w12, .Lwiden_r1s
    mov  x2, #1
    mov  x3, #1
    b .Lwiden_done
.Lwiden_dec:
    // Decimal, no unsigned suffix: int,long,long long (signed).
    cbnz x5, .Lwiden_dec_hi
    cbnz w9, .Lwiden_r0s
    cbnz w12, .Lwiden_r1s
    mov  x2, #1               // > LLONG_MAX: unsigned long (extension)
    mov  x3, #1
    b .Lwiden_done
.Lwiden_dec_hi:
    cbnz w12, .Lwiden_keepRs
    mov  x2, x5
    mov  x3, #1
    b .Lwiden_done
.Lwiden_rank_hi:
    // Non-decimal, rank ≥ long: long,ulong,llong,ullong.
    cbnz w12, .Lwiden_keepRs
    mov  x2, x5
    mov  x3, #1
    b .Lwiden_done
.Lwiden_u:
    // Unsigned suffix: uint,ulong,ullong.
    mov  x3, #1
    cbnz x5, .Lwiden_keepRu
    cbnz w11, .Lwiden_r0u_set
    mov  x2, #1               // unsigned long
    b .Lwiden_done
.Lwiden_keepRu:
    mov  x2, x5
    b .Lwiden_done
.Lwiden_r0u_set:
    mov  x2, #0
    b .Lwiden_done
.Lwiden_r0s:
    mov  x2, #0
    mov  x3, #0
    b .Lwiden_done
.Lwiden_r0u:
    mov  x2, #0
    mov  x3, #1
    b .Lwiden_done
.Lwiden_r1s:
    mov  x2, #1
    mov  x3, #0
    b .Lwiden_done
.Lwiden_keepRs:
    mov  x2, x5
    mov  x3, #0
.Lwiden_done:
    lsl  x2, x2, #1           // rank into bits 1-2
    orr  x21, x3, x2          // x21 = final type flags

    // Consume number
    bl _kcc_pp_next

    mov x0, #AST_INT_LIT
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]      // value
    str x21, [x0, #AST_F2]      // suffix flags: bit0=unsigned, bits1-2=long rank
    b .Lprimary_done

.Lprimary_float:
    // Floating constant: evaluate to a double bit pattern.  An `f`/`F` suffix
    // makes it a single-precision float: round the value to single precision
    // and mark the node so sema types it as float.
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_tok_len@@PAGE
    add  x1, x1, _kcc_tok_len@@PAGEOFF
    ldr  x1, [x1]
    add  x2, x0, x1
    ldrb w2, [x2, #-1]           // last character = suffix
    mov  x20, #0                  // is_float flag
    cmp  w2, #'f'
    b.eq .Lpf_isfloat
    cmp  w2, #'F'
    b.ne .Lpf_atof
.Lpf_isfloat:
    mov  x20, #1
.Lpf_atof:
    bl _kcc_parse_atof
    mov x19, x0                  // x19 = double bit pattern
    cbz x20, .Lpf_build
    mov x0, x19
    bl _kcc_round_to_float       // round to single precision
    mov x19, x0
.Lpf_build:
    bl _kcc_pp_next

    mov x0, #AST_FLOAT_LIT
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]      // double bit pattern (single-rounded if float)
    str x20, [x0, #AST_F2]      // is_float suffix flag
    b .Lprimary_done

.Lprimary_string:
    // Gather this literal and any adjacent ones (phase 6), with escapes
    // processed; the gather consumes every string token and leaves the next
    // token current.
    bl _kcc_strlit_gather
    mov x19, x0                  // concatenated ptr
    mov x20, x1                  // total len

    mov x0, #AST_STR_LIT
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]      // str_ptr
    str x20, [x0, #AST_F1]      // str_len
    b .Lprimary_done

.Lprimary_char:
    // Parse character value (with escape processing)
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_tok_len@@PAGE
    add  x1, x1, _kcc_tok_len@@PAGEOFF
    ldr  x1, [x1]
    add  x0, x0, #1            // skip opening quote
    sub  x1, x1, #2            // exclude quotes
    bl _kcc_strlit_process
    ldrb w19, [x0]              // first processed byte

    // Consume char literal
    bl _kcc_pp_next

    mov x0, #AST_CHAR_LIT
    bl _kcc_ast_alloc
    mov x1, x19
    str  x1, [x0, #AST_F0]      // value
    b .Lprimary_done
@| _kcc_parse_primary_expr
@}

\paragraph{Parenthesized expressions and generic selection.}
When the cast-expression parser has already consumed the opening parenthesis
and determined that what follows is not a type name, control arrives at
\texttt{.Lprimary\_paren} to handle a regular parenthesized expression.
The \texttt{\_Generic} keyword (\stdref{6.5.1.1}) introduces a generic
selection: \texttt{\_Generic(controlling-expr, type: expr, ...)},
resolved at compile time based on the type of the controlling expression.

@d Expr: parse primary @{
.Lprimary_paren:
    // Handled by cast_expr, but if we get here directly,
    // consume '(' and parse expression
    bl _kcc_pp_next               // consume '('
    bl _kcc_parse_expr
    mov x19, x0

    mov x0, #TOK_RPAREN
    bl _kcc_parse_expect

    mov x0, #AST_PAREN_EXPR
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]      // inner
    b .Lprimary_done

.Lprimary_generic:
    // _Generic ( assignment-expr , generic-assoc-list )
    bl _kcc_pp_next               // consume '_Generic'
    mov x0, #TOK_LPAREN
    bl _kcc_parse_expect

    // Parse controlling expression
    bl _kcc_parse_assign_expr
    mov x19, x0                  // x19 = controlling expr

    mov x0, #TOK_COMMA
    bl _kcc_parse_expect

    // Parse generic association list
    mov x20, #0                  // first assoc
    mov x21, #0                  // last assoc

.Lprimary_generic_loop:
    // Check for 'default' or type-name
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_DEFAULT
    b.eq .Lprimary_generic_default

    // Parse type-name
    bl _kcc_parse_type_name
    mov x9, x0                   // x9 = type (temp, will save after alloc)
    b .Lprimary_generic_assoc

.Lprimary_generic_default:
    bl _kcc_pp_next               // consume 'default'
    mov x9, #0                   // type = null (default)

.Lprimary_generic_assoc:
    mov x0, #TOK_COLON
    bl _kcc_parse_expect

    // Save type on stack before parsing expr
    str x9, [sp, #40]
    bl _kcc_parse_assign_expr
    // x0 = expr, type at [sp, #40]
    ldr x1, [sp, #40]           // x1 = type

    // Push type and expr (volatile regs won't survive alloc)
    stp x1, x0, [sp, #-16]!
    mov x0, #AST_GENERIC_ASSOC
    bl _kcc_ast_alloc
    ldp x1, x2, [sp], #16      // x1 = type, x2 = expr
    str x1, [x0, #AST_F0]       // type (0=default)
    str x2, [x0, #AST_F1]       // expr

    // Append to list
    cbz x20, .Lprimary_generic_first
    str x0, [x21, #AST_F4]      // last->next = new
    mov x21, x0
    b .Lprimary_generic_next

.Lprimary_generic_first:
    mov x20, x0
    mov x21, x0

.Lprimary_generic_next:
    // Check for more associations
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_COMMA
    b.ne .Lprimary_generic_end
    bl _kcc_pp_next               // consume ','
    b .Lprimary_generic_loop

.Lprimary_generic_end:
    mov x0, #TOK_RPAREN
    bl _kcc_parse_expect

    mov x0, #AST_GENERIC
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]      // controlling_expr
    str x20, [x0, #AST_F1]      // first_assoc

.Lprimary_done:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@}

\paragraph{Integer literal conversion.}
The helper \texttt{kcc\_parse\_atoi} converts integer literal token text
into a machine integer.  It recognises four radix prefixes: bare digits
for decimal, \texttt{0x}/\texttt{0X} for hexadecimal, a leading zero for
octal, and \texttt{0b}/\texttt{0B} for binary.  Type suffixes
(\texttt{u}, \texttt{U}, \texttt{l}, \texttt{L}) are skipped when computing
the \emph{value}---they do not change the magnitude---but they are not lost:
back in \texttt{.Lprimary\_number} a second, whole-token scan records them as
flags in \texttt{AST\_F2} (bit~0 for \texttt{unsigned}, bits~1--2 for the long
rank: 0~\texttt{int}, 1~\texttt{long}, 2~\texttt{long long}).  Scanning the
entire token is sound because \texttt{u} and \texttt{l} are digits in no
radix, so only genuine suffix letters ever match.  Sema turns those flags into
the constant's type, so \texttt{3L} is a \texttt{long} and \texttt{0u} an
\texttt{unsigned int}---which in turn makes \texttt{\_Generic} select the
matching \texttt{long}/\texttt{unsigned} association.

The suffix only fixes a \emph{floor}.  \stdref{6.4.4.1} then gives the
constant the first type from a list---dependent on the suffix and on whether
the token is decimal or not---that can represent its value.  So a bare
\texttt{2147483648} is too large for \texttt{int} and becomes \texttt{long};
a hexadecimal \texttt{0xFFFFFFFF} that overflows \texttt{int} becomes
\texttt{unsigned int} (the non-decimal lists admit the unsigned rungs, the
decimal lists do not).  We compute this in place right after the suffix scan,
while both the value and the original token text are still in hand: with the
unsigned floor, the long-rank floor, the decimal flag, and three
representability tests (fits signed \texttt{int}, fits unsigned \texttt{int},
fits signed \texttt{long}---\texttt{long} and \texttt{long long} share a width
on LP64) we climb the appropriate list and rewrite \texttt{AST\_F2} to the
final type's flags.  Sema and the IR builder are unchanged; they simply read
the upgraded flags.

@d Expr: parse primary @{
// -- kcc_parse_atoi ----------------------------------------------------
// uint64_t kcc_parse_atoi(const char *str, uint64_t len)
//   x0 = pointer to digit string
//   x1 = length
// Returns parsed unsigned integer value.
// Handles decimal, hex (0x), octal (0), binary (0b).
.globl _kcc_parse_atoi
.p2align 2
_kcc_parse_atoi:
    stp x29, x30, [sp, #-16]!
    mov x29, sp

    cbz x1, .Latoi_zero

    // Check for 0x, 0b, 0 prefix
    ldrb w2, [x0]
    cmp w2, #'0'
    b.ne .Latoi_decimal

    cmp x1, #1
    b.eq .Latoi_zero              // just "0"

    ldrb w2, [x0, #1]
    cmp w2, #'x'
    b.eq .Latoi_hex
    cmp w2, #'X'
    b.eq .Latoi_hex
    cmp w2, #'b'
    b.eq .Latoi_binary
    cmp w2, #'B'
    b.eq .Latoi_binary

    // Octal
    b .Latoi_octal

.Latoi_decimal:
    mov x2, #0                   // accumulator
    mov x3, #10
.Latoi_dec_loop:
    cbz x1, .Latoi_done
    ldrb w4, [x0], #1
    // Skip type suffixes (u, U, l, L)
    cmp w4, #'u'
    b.eq .Latoi_done
    cmp w4, #'U'
    b.eq .Latoi_done
    cmp w4, #'l'
    b.eq .Latoi_done
    cmp w4, #'L'
    b.eq .Latoi_done
    sub w4, w4, #'0'
    mul x2, x2, x3
    add x2, x2, x4
    sub x1, x1, #1
    b .Latoi_dec_loop

.Latoi_hex:
    add x0, x0, #2              // skip "0x"
    sub x1, x1, #2
    mov x2, #0
.Latoi_hex_loop:
    cbz x1, .Latoi_done
    ldrb w4, [x0], #1
    cmp w4, #'u'
    b.eq .Latoi_done
    cmp w4, #'U'
    b.eq .Latoi_done
    cmp w4, #'l'
    b.eq .Latoi_done
    cmp w4, #'L'
    b.eq .Latoi_done
    // Convert hex digit
    cmp w4, #'9'
    b.le .Latoi_hex_digit
    cmp w4, #'a'
    b.ge .Latoi_hex_lower
    // A-F
    sub w4, w4, #'A'
    add w4, w4, #10
    b .Latoi_hex_acc
.Latoi_hex_lower:
    sub w4, w4, #'a'
    add w4, w4, #10
    b .Latoi_hex_acc
.Latoi_hex_digit:
    sub w4, w4, #'0'
.Latoi_hex_acc:
    lsl x2, x2, #4
    add x2, x2, x4
    sub x1, x1, #1
    b .Latoi_hex_loop

.Latoi_octal:
    mov x2, #0
.Latoi_oct_loop:
    cbz x1, .Latoi_done
    ldrb w4, [x0], #1
    cmp w4, #'u'
    b.eq .Latoi_done
    cmp w4, #'U'
    b.eq .Latoi_done
    cmp w4, #'l'
    b.eq .Latoi_done
    cmp w4, #'L'
    b.eq .Latoi_done
    sub w4, w4, #'0'
    lsl x2, x2, #3
    add x2, x2, x4
    sub x1, x1, #1
    b .Latoi_oct_loop

.Latoi_binary:
    add x0, x0, #2              // skip "0b"
    sub x1, x1, #2
    mov x2, #0
.Latoi_bin_loop:
    cbz x1, .Latoi_done
    ldrb w4, [x0], #1
    cmp w4, #'u'
    b.eq .Latoi_done
    cmp w4, #'U'
    b.eq .Latoi_done
    cmp w4, #'l'
    b.eq .Latoi_done
    cmp w4, #'L'
    b.eq .Latoi_done
    sub w4, w4, #'0'
    lsl x2, x2, #1
    add x2, x2, x4
    sub x1, x1, #1
    b .Latoi_bin_loop

.Latoi_zero:
    mov x2, #0

.Latoi_done:
    mov x0, x2

    ldp x29, x30, [sp], #16
    ret
@| _kcc_parse_atoi
@}

\section{Floating Constants}
\label{sec:parse-float}

A preprocessing number is a floating constant---rather than an
integer---when its spelling contains a radix point, an exponent, or a
floating suffix (\texttt{f}/\texttt{F}).  The classification has two
regimes.  A \emph{decimal} number is a float if it contains
\texttt{.}, \texttt{e}/\texttt{E}, or \texttt{f}/\texttt{F}.  A
\emph{hexadecimal} number (\texttt{0x}\ldots) needs its own rule: there
\texttt{f}/\texttt{F} are ordinary hex \emph{digits} and \texttt{e} is
too, so only a radix point or a binary exponent \texttt{p}/\texttt{P}
distinguishes a hex float (\texttt{0x1.fp1}) from a hex integer
(\texttt{0xff}).  \texttt{kcc\_is\_float\_literal} branches on the
\texttt{0x} prefix and scans accordingly.

\texttt{kcc\_parse\_atof} then evaluates the constant to an IEEE-754
\texttt{double} \emph{at compile time} on the host's own
floating-point unit.  For a decimal constant it accumulates \emph{all}
significant digits into a single integer mantissa $M$, counts the
fractional digits $F$, reads any \texttt{e}-exponent, and reconstructs
the value as $M \times 10^{\,e-F}$ with one final multiply or divide.
Folding every digit into a single scaling step keeps the whole
computation to one rounding: an exactly representable fraction such as
\texttt{3.875} lands on its exact double, whereas the naive
digit-by-digit $+\,d/10^{k}$ method rounds at every fraction digit and
drifts a ULP low.  The power $10^{|e-F|}$ is built by repeated
multiplication, which is itself exact for $|e-F| \le 22$; only far
larger magnitudes lose a bit, and those do not occur in real literals.

A hexadecimal constant \texttt{0x}$m$\texttt{.}$f$\texttt{p}$e$ takes a
parallel path: the mantissa digits accumulate in base sixteen (the
fraction as $d/16^{k}$) and the value is scaled by a \emph{binary}
exponent $2^{e}$.  Because the base is a power of two, such constants
are exact whenever the mantissa fits, which is precisely why the
standard provides them.  Either way the 64-bit result is returned as
its bit pattern (via \texttt{fmov}), ready to be stored verbatim in the
literal's AST node and, later, materialised as an \texttt{IR\_CONST}.

@d Expr: parse float @{
// -- kcc_is_float_literal ---------------------------------------------
// uint64_t kcc_is_float_literal(const char *str, uint64_t len)
//   Returns 1 if the pp-number is a floating constant, else 0.
.text
.globl _kcc_is_float_literal
.p2align 2
_kcc_is_float_literal:
    cbz x1, .Lisf_no
    // Hexadecimal integer? 0x / 0X → never a (decimal) float here.
    cmp x1, #2
    b.lo .Lisf_scan
    ldrb w2, [x0]
    cmp w2, #'0'
    b.ne .Lisf_scan
    ldrb w2, [x0, #1]
    orr w2, w2, #0x20            // tolower
    cmp w2, #'x'
    b.eq .Lisf_hex              // 0x… → hex; float only if it has '.'/'p'/'P'

.Lisf_scan:
    mov x3, #0                   // index
.Lisf_loop:
    cmp x3, x1
    b.hs .Lisf_no
    ldrb w2, [x0, x3]
    cmp w2, #'.'
    b.eq .Lisf_yes
    cmp w2, #'e'
    b.eq .Lisf_yes
    cmp w2, #'E'
    b.eq .Lisf_yes
    cmp w2, #'f'
    b.eq .Lisf_yes
    cmp w2, #'F'
    b.eq .Lisf_yes
    add x3, x3, #1
    b .Lisf_loop
.Lisf_hex:
    // In a hex literal `f`/`F` are digits, not a float suffix; only a
    // radix point or a binary exponent `p`/`P` marks a hex float.
    mov x3, #2                   // skip "0x"
.Lisf_hex_loop:
    cmp x3, x1
    b.hs .Lisf_no
    ldrb w2, [x0, x3]
    cmp w2, #'.'
    b.eq .Lisf_yes
    orr w2, w2, #0x20
    cmp w2, #'p'
    b.eq .Lisf_yes
    add x3, x3, #1
    b .Lisf_hex_loop
.Lisf_yes:
    mov x0, #1
    ret
.Lisf_no:
    mov x0, #0
    ret

// -- kcc_parse_atof ---------------------------------------------------
// uint64_t kcc_parse_atof(const char *str, uint64_t len)
//   x0 = digit string, x1 = length
// Returns the IEEE-754 double bit pattern of the decimal constant.
// Leaf function: uses only caller-saved x2-x12 and d0-d5.
.text
.globl _kcc_parse_atof
.p2align 2
_kcc_parse_atof:
    add x3, x0, x1               // x3 = end
    mov x2, x0                   // x2 = cursor
    // Hexadecimal floating constant `0x<hex>.<hex>p<exp>` (\stdref{6.4.4.2}):
    // a hex mantissa scaled by a \emph{binary} exponent, e.g. 0x1.fp1 = 3.875.
    cmp x1, #2
    b.lo .Latof_dec
    ldrb w4, [x0]
    cmp w4, #'0'
    b.ne .Latof_dec
    ldrb w4, [x0, #1]
    orr w4, w4, #0x20
    cmp w4, #'x'
    b.eq .Latof_hex
.Latof_dec:
    // Accumulate all significant digits into a single integer mantissa
    // \reg{x5}, counting fractional digits in \reg{x6}.  Reconstructing the
    // value with one final scale by $10^{\text{net}}$ keeps the whole
    // computation to a single rounding step, so an exact decimal such as
    // 3.875 lands on its exact double.  Per-digit \texttt{fdiv} accumulation
    // (the naive method) rounds at every digit and drifts a ULP low.
    mov x5, #0                   // M = integer mantissa
    mov x6, #0                   // F = fractional-digit count
    mov x8, #0                   // e-exponent magnitude (0 if no 'e' part)
    mov x9, #0                   // e-exponent sign: 0 = +, 1 = -
    mov x12, #10
.Latof_int:
    cmp x2, x3
    b.hs .Latof_scale
    ldrb w7, [x2]
    cmp w7, #'.'
    b.eq .Latof_frac
    cmp w7, #'e'
    b.eq .Latof_exp
    cmp w7, #'E'
    b.eq .Latof_exp
    sub x10, x7, #'0'
    cmp x10, #9
    b.hi .Latof_scale           // suffix or other → done
    mul x5, x5, x12
    add x5, x5, x10             // M = M*10 + digit
    add x2, x2, #1
    b .Latof_int

.Latof_frac:
    add x2, x2, #1               // skip '.'
.Latof_frac_loop:
    cmp x2, x3
    b.hs .Latof_scale
    ldrb w7, [x2]
    cmp w7, #'e'
    b.eq .Latof_exp
    cmp w7, #'E'
    b.eq .Latof_exp
    sub x10, x7, #'0'
    cmp x10, #9
    b.hi .Latof_scale
    mul x5, x5, x12
    add x5, x5, x10
    add x6, x6, #1             // one more fractional digit
    add x2, x2, #1
    b .Latof_frac_loop

.Latof_exp:
    add x2, x2, #1               // skip e/E
    mov x8, #0                   // exponent magnitude
    mov x9, #0                   // sign: 0 = +, 1 = -
    cmp x2, x3
    b.hs .Latof_scale
    ldrb w7, [x2]
    cmp w7, #'+'
    b.eq .Latof_exp_skip
    cmp w7, #'-'
    b.ne .Latof_exp_digits
    mov x9, #1
.Latof_exp_skip:
    add x2, x2, #1
.Latof_exp_digits:
    cmp x2, x3
    b.hs .Latof_scale
    ldrb w7, [x2]
    sub x10, x7, #'0'
    cmp x10, #9
    b.hi .Latof_scale
    mov x12, #10
    mul x8, x8, x12
    add x8, x8, x10
    add x2, x2, #1
    b .Latof_exp_digits

.Latof_scale:
    // Net power of ten = (signed e-exponent) - (fractional-digit count).
    cbz x9, .Latof_scale_net
    neg x8, x8
.Latof_scale_net:
    sub x8, x8, x6              // x8 = net decimal exponent (signed)
    scvtf d0, x5                // d0 = mantissa value
    mov x9, #10
    scvtf d3, x9                // d3 = 10.0
    mov x9, #1
    scvtf d1, x9                // d1 = 10^0 = 1.0
    cmp x8, #0
    b.ge .Latof_scale_mag
    neg x11, x8                 // |net| for a negative exponent
    b .Latof_scale_pow
.Latof_scale_mag:
    mov x11, x8
.Latof_scale_pow:
    cbz x11, .Latof_end
.Latof_scale_pow_loop:
    fmul d1, d1, d3             // build 10^|net| (exact for |net| <= 22)
    subs x11, x11, #1
    b.ne .Latof_scale_pow_loop
    cmp x8, #0
    b.lt .Latof_scale_div
    fmul d0, d0, d1             // one correctly-rounded scale up
    b .Latof_end
.Latof_scale_div:
    fdiv d0, d0, d1             // one correctly-rounded scale down
    b .Latof_end

.Latof_hex:
    add x2, x0, #2               // skip "0x"
    fmov d0, xzr                 // mantissa accumulator
    mov x5, #16
    scvtf d5, x5                 // d5 = 16.0
.Lhex_int:
    cmp x2, x3
    b.hs .Lhex_exp0
    ldrb w6, [x2]
    cmp w6, #'.'
    b.eq .Lhex_frac
    cmp w6, #'p'
    b.eq .Lhex_exp
    cmp w6, #'P'
    b.eq .Lhex_exp
    sub x7, x6, #'0'             // decode a hex digit
    cmp x7, #9
    b.ls .Lhex_int_add
    orr w7, w6, #0x20
    sub x7, x7, #'a'
    cmp x7, #5
    b.hi .Lhex_exp0             // not a hex digit → mantissa complete
    add x7, x7, #10
.Lhex_int_add:
    fmul d0, d0, d5
    scvtf d1, x7
    fadd d0, d0, d1
    add x2, x2, #1
    b .Lhex_int
.Lhex_frac:
    add x2, x2, #1               // skip '.'
    mov x5, #1
    scvtf d4, x5                 // d4 = 1.0 (running 16^k divisor)
.Lhex_frac_loop:
    cmp x2, x3
    b.hs .Lhex_exp0
    ldrb w6, [x2]
    cmp w6, #'p'
    b.eq .Lhex_exp
    cmp w6, #'P'
    b.eq .Lhex_exp
    sub x7, x6, #'0'
    cmp x7, #9
    b.ls .Lhex_frac_add
    orr w7, w6, #0x20
    sub x7, x7, #'a'
    cmp x7, #5
    b.hi .Lhex_exp0
    add x7, x7, #10
.Lhex_frac_add:
    fmul d4, d4, d5             // divisor *= 16
    scvtf d1, x7
    fdiv d1, d1, d4            // digit / 16^k
    fadd d0, d0, d1
    add x2, x2, #1
    b .Lhex_frac_loop
.Lhex_exp:
    add x2, x2, #1               // skip 'p'/'P'
    mov x8, #0                   // exponent magnitude
    mov x9, #0                   // sign: 0 = +, 1 = -
    cmp x2, x3
    b.hs .Lhex_exp_apply
    ldrb w6, [x2]
    cmp w6, #'+'
    b.eq .Lhex_exp_sskip
    cmp w6, #'-'
    b.ne .Lhex_exp_digits
    mov x9, #1
.Lhex_exp_sskip:
    add x2, x2, #1
.Lhex_exp_digits:
    cmp x2, x3
    b.hs .Lhex_exp_apply
    ldrb w6, [x2]
    sub x7, x6, #'0'
    cmp x7, #9
    b.hi .Lhex_exp_apply        // suffix (f/l) or end
    mov x10, #10
    mul x8, x8, x10
    add x8, x8, x7
    add x2, x2, #1
    b .Lhex_exp_digits
.Lhex_exp0:
    mov x8, #0                   // no binary exponent seen → scale by 2^0
    mov x9, #0
.Lhex_exp_apply:
    // Scale the mantissa by 2^exponent (binary), multiplying/dividing by 2.
    mov x5, #2
    scvtf d2, x5                 // d2 = 2.0
    cbz x8, .Latof_end
    cbnz x9, .Lhex_exp_negloop
.Lhex_exp_mul:
    fmul d0, d0, d2
    subs x8, x8, #1
    b.ne .Lhex_exp_mul
    b .Latof_end
.Lhex_exp_negloop:
    fdiv d0, d0, d2
    subs x8, x8, #1
    b.ne .Lhex_exp_negloop

.Latof_end:
    fmov x0, d0                  // return the double's bit pattern
    ret

// -- kcc_round_to_float -------------------------------------------------------
// uint64_t kcc_round_to_float(uint64_t double_bits)
//   Rounds a double to single precision and returns it back in double format,
//   so an `f`-suffixed literal such as 16777217.0f holds exactly the value a
//   single-precision float would.  Uses the compiler host's own FPU.
.text
.globl _kcc_round_to_float
.p2align 2
_kcc_round_to_float:
    fmov d0, x0
    fcvt s0, d0                  // double → single (rounds to nearest)
    fcvt d0, s0                  // single → double (exact widening)
    fmov x0, d0
    ret
@| _kcc_is_float_literal _kcc_parse_atof _kcc_round_to_float
@}

\section{Argument List}

\texttt{kcc\_parse\_arg\_list} parses a comma-separated list of
assignment expressions for function call arguments.  Returns a
linked list of nodes via \texttt{F4}.

@d Expr: parse arg list @{
// -- kcc_parse_arg_list ------------------------------------------------
// node *kcc_parse_arg_list(void)
// Parses a comma-separated list of assignment expressions.
// Returns first argument node (linked via F4), or null if empty.
.globl _kcc_parse_arg_list
.p2align 2
_kcc_parse_arg_list:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    // Check for empty argument list (next token is ')')
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_RPAREN
    b.eq .Largs_empty

    mov x19, #0                  // x19 = first arg
    mov x20, #0                  // x20 = last arg

.Largs_loop:
    // Parse one argument (assignment expression)
    bl _kcc_parse_assign_expr
    mov x21, x0                  // x21 = new arg

    // Append to list
    cbz x19, .Largs_first
    str x21, [x20, #AST_F4]     // last->next = new
    mov x20, x21
    b .Largs_comma

.Largs_first:
    mov x19, x21
    mov x20, x21

.Largs_comma:
    // Check for ','
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_COMMA
    b.ne .Largs_done_list

    bl _kcc_pp_next               // consume ','
    b .Largs_loop

.Largs_done_list:
    mov x0, x19
    b .Largs_done

.Largs_empty:
    mov x0, #0

.Largs_done:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_parse_arg_list
@}

\section{Expression Data}

This fragment collects the static data used by the expression parser: the
diagnostic string emitted when an unexpected token appears where an expression
is expected, and the precedence lookup table that drives the binary operator
precedence climbing algorithm.  The table is laid out as 48~bytes starting at
token type~60, one byte per punctuator slot, with nonzero entries for the
binary operators at their C17 precedence levels.

@d Expr: data @{
// -- Expression parser data --------------------------------------------
.section __TEXT,__cstring,cstring_literals

_kcc_expr_msg_expected:
    .asciz "expected expression"

_kcc_str_va_arg:
    .asciz "va_arg"

// -- Precedence table --------------------------------------------------
// Indexed by (tok_type - 60).  48 entries covering all punctuators.
// Value = precedence level (0 = not a binary operator).
.data
.p2align 2
_kcc_prec_table:
    //  60  (    61  )    62  {    63  }    64  [    65  ]    66  ;    67  ,
    .byte 0,   0,   0,   0,   0,   0,   0,   0
    //  68  .    69  ->   70  ++   71  --   72  &    73  *    74  +    75  -
    .byte 0,   0,   0,   0,   8,  13,  12,  12
    //  76  ~    77  !    78  /    79  %    80  <<   81  >>   82  <    83  >
    .byte 0,   0,  13,  13,  11,  11,  10,  10
    //  84  <=   85  >=   86  ==   87  !=   88  ^    89  |    90  &&   91  ||
    .byte 10,  10,   9,   9,   7,   6,   5,   4
    //  92  ?    93  :    94  =    95  *=   96  /=   97  %=   98  +=   99  -=
    .byte 0,   0,   0,   0,   0,   0,   0,   0
    // 100 <<=  101 >>=  102 &=   103 ^=   104 |=   105 #    106 ##   107 ...
    .byte 0,   0,   0,   0,   0,   0,   0,   0
@}
