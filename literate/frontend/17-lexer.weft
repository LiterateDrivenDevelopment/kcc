\paragraph{Token name pointer table.}
A flat array of 108 pointers, indexed by token type code, enables
constant-time lookup in \texttt{kcc\_lex\_type\_name}.  Gaps in the
code space (6--9 for future structural tokens, 54--59 reserved
between keywords and punctuators) are filled with null entries.

@d Lexer: token names @{
// -- Token name pointer table ---------------------------------------
// Indexed by token type code.  Entries 6-9, 54-59 are NULL (unused).
.data
.p2align 3
_kcc_tok_names:
    .quad _kcc_tn_eof             // 0  TOK_EOF
    .quad _kcc_tn_identifier      // 1  TOK_IDENT
    .quad _kcc_tn_number          // 2  TOK_NUMBER
    .quad _kcc_tn_char_lit        // 3  TOK_CHAR_LIT
    .quad _kcc_tn_string_lit      // 4  TOK_STRING_LIT
    .quad _kcc_tn_unknown         // 5  TOK_UNKNOWN
    .quad 0, 0, 0, 0             // 6-9  reserved
    // Keywords 10-53
    .quad _kcc_tn_auto            // 10
    .quad _kcc_tn_break           // 11
    .quad _kcc_tn_case            // 12
    .quad _kcc_tn_char            // 13
    .quad _kcc_tn_const           // 14
    .quad _kcc_tn_continue        // 15
    .quad _kcc_tn_default         // 16
    .quad _kcc_tn_do              // 17
    .quad _kcc_tn_double          // 18
    .quad _kcc_tn_else            // 19
    .quad _kcc_tn_enum            // 20
    .quad _kcc_tn_extern          // 21
    .quad _kcc_tn_float           // 22
    .quad _kcc_tn_for             // 23
    .quad _kcc_tn_goto            // 24
    .quad _kcc_tn_if              // 25
    .quad _kcc_tn_inline          // 26
    .quad _kcc_tn_int             // 27
    .quad _kcc_tn_long            // 28
    .quad _kcc_tn_register        // 29
    .quad _kcc_tn_restrict        // 30
    .quad _kcc_tn_return          // 31
    .quad _kcc_tn_short           // 32
    .quad _kcc_tn_signed          // 33
    .quad _kcc_tn_sizeof          // 34
    .quad _kcc_tn_static          // 35
    .quad _kcc_tn_struct          // 36
    .quad _kcc_tn_switch          // 37
    .quad _kcc_tn_typedef         // 38
    .quad _kcc_tn_union           // 39
    .quad _kcc_tn_unsigned        // 40
    .quad _kcc_tn_void            // 41
    .quad _kcc_tn_volatile        // 42
    .quad _kcc_tn_while           // 43
    .quad _kcc_tn_alignas         // 44
    .quad _kcc_tn_alignof         // 45
    .quad _kcc_tn_atomic          // 46
    .quad _kcc_tn_bool            // 47
    .quad _kcc_tn_complex         // 48
    .quad _kcc_tn_generic         // 49
    .quad _kcc_tn_imaginary       // 50
    .quad _kcc_tn_noreturn        // 51
    .quad _kcc_tn_static_assert   // 52
    .quad _kcc_tn_thread_local    // 53
    .quad 0, 0, 0, 0, 0, 0       // 54-59  reserved
    // Punctuators 60-107
    .quad _kcc_tn_lparen          // 60
    .quad _kcc_tn_rparen          // 61
    .quad _kcc_tn_lbrace          // 62
    .quad _kcc_tn_rbrace          // 63
    .quad _kcc_tn_lbracket        // 64
    .quad _kcc_tn_rbracket        // 65
    .quad _kcc_tn_semi            // 66
    .quad _kcc_tn_comma           // 67
    .quad _kcc_tn_dot             // 68
    .quad _kcc_tn_arrow           // 69
    .quad _kcc_tn_plusplus        // 70
    .quad _kcc_tn_minusminus     // 71
    .quad _kcc_tn_amp             // 72
    .quad _kcc_tn_star            // 73
    .quad _kcc_tn_plus            // 74
    .quad _kcc_tn_minus           // 75
    .quad _kcc_tn_tilde           // 76
    .quad _kcc_tn_exclaim         // 77
    .quad _kcc_tn_slash           // 78
    .quad _kcc_tn_percent         // 79
    .quad _kcc_tn_lessless        // 80
    .quad _kcc_tn_greatergreater  // 81
    .quad _kcc_tn_less            // 82
    .quad _kcc_tn_greater         // 83
    .quad _kcc_tn_lessequal       // 84
    .quad _kcc_tn_greaterequal    // 85
    .quad _kcc_tn_equalequal      // 86
    .quad _kcc_tn_exclaimequal    // 87
    .quad _kcc_tn_caret           // 88
    .quad _kcc_tn_pipe            // 89
    .quad _kcc_tn_ampamp          // 90
    .quad _kcc_tn_pipepipe        // 91
    .quad _kcc_tn_question        // 92
    .quad _kcc_tn_colon           // 93
    .quad _kcc_tn_equal           // 94
    .quad _kcc_tn_starequal       // 95
    .quad _kcc_tn_slashequal      // 96
    .quad _kcc_tn_percentequal    // 97
    .quad _kcc_tn_plusequal       // 98
    .quad _kcc_tn_minusequal      // 99
    .quad _kcc_tn_lesslessequal   // 100
    .quad _kcc_tn_greatergreaterequal // 101
    .quad _kcc_tn_ampequal        // 102
    .quad _kcc_tn_caretequal      // 103
    .quad _kcc_tn_pipeequal       // 104
    .quad _kcc_tn_hash            // 105
    .quad _kcc_tn_hashhash        // 106
    .quad _kcc_tn_ellipsis        // 107
@}

\section{Keyword Table Initialization}

At startup, we populate a hash table with all 44 C17 keywords.
Each entry maps the keyword text to its token type code.

@d Lexer: keyword data @{
// -- Keyword strings ------------------------------------------------
.section __TEXT,__cstring,cstring_literals
_kcc_kw_s_auto:       .asciz "auto"
_kcc_kw_s_break:      .asciz "break"
_kcc_kw_s_case:       .asciz "case"
_kcc_kw_s_char:       .asciz "char"
_kcc_kw_s_const:      .asciz "const"
_kcc_kw_s_continue:   .asciz "continue"
_kcc_kw_s_default:    .asciz "default"
_kcc_kw_s_do:         .asciz "do"
_kcc_kw_s_double:     .asciz "double"
_kcc_kw_s_else:       .asciz "else"
_kcc_kw_s_enum:       .asciz "enum"
_kcc_kw_s_extern:     .asciz "extern"
_kcc_kw_s_float:      .asciz "float"
_kcc_kw_s_for:        .asciz "for"
_kcc_kw_s_goto:       .asciz "goto"
_kcc_kw_s_if:         .asciz "if"
_kcc_kw_s_inline:     .asciz "inline"
_kcc_kw_s_int:        .asciz "int"
_kcc_kw_s_long:       .asciz "long"
_kcc_kw_s_register:   .asciz "register"
_kcc_kw_s_restrict:   .asciz "restrict"
_kcc_kw_s_return:     .asciz "return"
_kcc_kw_s_short:      .asciz "short"
_kcc_kw_s_signed:     .asciz "signed"
_kcc_kw_s_sizeof:     .asciz "sizeof"
_kcc_kw_s_static:     .asciz "static"
_kcc_kw_s_struct:     .asciz "struct"
_kcc_kw_s_switch:     .asciz "switch"
_kcc_kw_s_typedef:    .asciz "typedef"
_kcc_kw_s_union:      .asciz "union"
_kcc_kw_s_unsigned:   .asciz "unsigned"
_kcc_kw_s_void:       .asciz "void"
_kcc_kw_s_volatile:   .asciz "volatile"
_kcc_kw_s_while:      .asciz "while"
_kcc_kw_s_alignas:    .asciz "_Alignas"
_kcc_kw_s_alignof:    .asciz "_Alignof"
_kcc_kw_s_atomic:     .asciz "_Atomic"
_kcc_kw_s_bool:       .asciz "_Bool"
_kcc_kw_s_complex:    .asciz "_Complex"
_kcc_kw_s_generic:    .asciz "_Generic"
_kcc_kw_s_imaginary:  .asciz "_Imaginary"
_kcc_kw_s_noreturn:   .asciz "_Noreturn"
_kcc_kw_s_sassert:    .asciz "_Static_assert"
_kcc_kw_s_tlocal:     .asciz "_Thread_local"

// -- Keyword registration table -------------------------------------
// Each entry: (string_ptr, string_len, token_type) = 24 bytes
.data
.p2align 3
_kcc_kw_reg_table:
    .quad _kcc_kw_s_auto,       4,  10
    .quad _kcc_kw_s_break,      5,  11
    .quad _kcc_kw_s_case,       4,  12
    .quad _kcc_kw_s_char,       4,  13
    .quad _kcc_kw_s_const,      5,  14
    .quad _kcc_kw_s_continue,   8,  15
    .quad _kcc_kw_s_default,    7,  16
    .quad _kcc_kw_s_do,         2,  17
    .quad _kcc_kw_s_double,     6,  18
    .quad _kcc_kw_s_else,       4,  19
    .quad _kcc_kw_s_enum,       4,  20
    .quad _kcc_kw_s_extern,     6,  21
    .quad _kcc_kw_s_float,      5,  22
    .quad _kcc_kw_s_for,        3,  23
    .quad _kcc_kw_s_goto,       4,  24
    .quad _kcc_kw_s_if,         2,  25
    .quad _kcc_kw_s_inline,     6,  26
    .quad _kcc_kw_s_int,        3,  27
    .quad _kcc_kw_s_long,       4,  28
    .quad _kcc_kw_s_register,   8,  29
    .quad _kcc_kw_s_restrict,   8,  30
    .quad _kcc_kw_s_return,     6,  31
    .quad _kcc_kw_s_short,      5,  32
    .quad _kcc_kw_s_signed,     6,  33
    .quad _kcc_kw_s_sizeof,     6,  34
    .quad _kcc_kw_s_static,     6,  35
    .quad _kcc_kw_s_struct,     6,  36
    .quad _kcc_kw_s_switch,     6,  37
    .quad _kcc_kw_s_typedef,    7,  38
    .quad _kcc_kw_s_union,      5,  39
    .quad _kcc_kw_s_unsigned,   8,  40
    .quad _kcc_kw_s_void,       4,  41
    .quad _kcc_kw_s_volatile,   8,  42
    .quad _kcc_kw_s_while,      5,  43
    .quad _kcc_kw_s_alignas,    8,  44
    .quad _kcc_kw_s_alignof,    8,  45
