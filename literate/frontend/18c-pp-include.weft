\paragraph{POSIX file bridges.}
Two POSIX headers round out what a library's gzip file wrappers need---zlib's
\texttt{gz*} layer is the motivating case.  \verb|<fcntl.h>| supplies the
open-flag macros and \texttt{open}; \verb|<unistd.h>| supplies the raw
file-descriptor I/O (\texttt{read}, \texttt{write}, \texttt{close},
\texttt{lseek}) and the \texttt{SEEK\_*} whence constants.  Neither is an ISO
C header, but the front end needs the flag values and prototypes to type each
call, and the linker binds them to \texttt{libSystem}.  Two details earn their
keep: the open flags carry their exact Apple values, so the call reaches the
platform \texttt{open} with the semantics it expects; and \texttt{lseek}
returns the wide \texttt{off\_t} (and \texttt{read}/\texttt{write} an
\texttt{ssize\_t}), so declaring them keeps a file offset or byte count from
being truncated to \texttt{int} by an implicit declaration.

@d Header: fcntl @{
#ifndef _FCNTL_H
#define _FCNTL_H
typedef unsigned short mode_t;
#define O_RDONLY   0x0000
#define O_WRONLY   0x0001
#define O_RDWR     0x0002
#define O_ACCMODE  0x0003
#define O_NONBLOCK 0x0004
#define O_APPEND   0x0008
#define O_CREAT    0x0200
#define O_TRUNC    0x0400
#define O_EXCL     0x0800
#define O_CLOEXEC  0x1000000
int open(const char *path, int oflag, ...);
int creat(const char *path, mode_t mode);
int fcntl(int fd, int cmd, ...);
#endif
@}

@d Header: unistd @{
#ifndef _UNISTD_H
#define _UNISTD_H
typedef long ssize_t;
typedef long off_t;
#ifndef SEEK_SET
#define SEEK_SET 0
#define SEEK_CUR 1
#define SEEK_END 2
#endif
ssize_t read(int fd, void *buf, unsigned long nbyte);
ssize_t write(int fd, const void *buf, unsigned long nbyte);
int close(int fd);
off_t lseek(int fd, off_t offset, int whence);
int unlink(const char *path);
int isatty(int fd);
#endif
@}

\paragraph{End-to-end tests.}
The preprocessor already runs ahead of the code generator, so these
tests compile and execute programs that lean on it: object-like and
function-like macros, conditional compilation, and---through
\texttt{run\_test\_include}---a shared header that supplies both a macro
constant and a \texttt{struct} definition to the translation unit that
includes it.  The last case is the one that matters for self-hosting: a
project header sitting beside its \texttt{.c} file must be found and its
declarations honoured on the \texttt{-c} path.

@d Test: codegen preprocessor @{
echo ""
echo "--- Preprocessor ---"

run_test "pp-define-const" \
    "#define ANSWER 42
int main(void){ return ANSWER; }" 42

run_test "pp-define-arith" \
    "#define N 5
#define M 3
int main(void){ return N * M; }" 15

run_test "pp-define-funclike" \
    "#define SQ(x) ((x)*(x))
int main(void){ return SQ(6); }" 36

run_test "pp-ifdef-true" \
    "#define DEBUG
int main(void){
#ifdef DEBUG
  return 7;
#else
  return 0;
#endif
}" 7

run_test "pp-ifndef-else" \
    "int main(void){
#ifdef NOPE
  return 0;
#else
  return 9;
#endif
}" 9

run_test_include "pp-include-macro" \
    "#define LIMIT 7" \
    "#include \"defs.h\"
int main(void){ return LIMIT + 3; }" 10

run_test_include "pp-include-struct" \
    "struct Pair { int a; int b; };" \
    "#include \"defs.h\"
int main(void){ struct Pair p; p.a = 4; p.b = 6; return p.a + p.b; }" 10
@}

\section{Error Directive}

\texttt{\#error} emits a diagnostic with the rest of the directive
line as the message.

@d PP: error directive @{
.text
// -- _kcc_pp_do_error -----------------------------------------------
.p2align 2
_kcc_pp_do_error:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    // Get rest of line as message
    bl _kcc_pp_rest_of_line
    mov x19, x0               // msg ptr
    mov x20, x1               // msg len

    // Create null-terminated copy in arena
    add  x0, x20, #1
    bl _kcc_arena_alloc
    mov  x2, x0               // dst
    mov  x0, x2
    mov  x1, x19
    mov  x3, x20
    // memcpy(dst, src, len)
    mov  x1, x19
    mov  x2, x20
    bl _kcc_memcpy

    // Null terminate
    add  x1, x0, x20
    strb wzr, [x1]

    // Emit error
    adrp x1, _kcc_pp_dir_line@@PAGE
    add  x1, x1, _kcc_pp_dir_line@@PAGEOFF
    ldr  x1, [x1]             // line
    mov  x2, x0               // msg (arena copy, null-terminated)
    mov  x0, x1                // line
    mov  x1, #1               // col
    bl _kcc_diag_error

    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@}

