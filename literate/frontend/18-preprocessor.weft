% 18-preprocessor.weft — The C17 Preprocessor
%
% Translation phase 4 (§5.1.1.2 paragraph 4): preprocessing directives
% are executed, macro invocations are expanded, and _Pragma operators
% are executed.  The result is a stream of preprocessing tokens ready
% for the parser.
%
% The preprocessor wraps the lexer: the parser calls kcc_pp_next()
% instead of kcc_lex_next() directly.  Directives and macro expansion
% are handled transparently.

\chapter{The Preprocessor}
\label{ch:preprocessor}

The C preprocessor is a text-transformation engine defined by
\stdref{6.10}.  It processes directives (\texttt{\#define},
\texttt{\#include}, conditionals) and expands macros before the
translation unit reaches the parser.

Our preprocessor wraps the Phase~3 lexer: it calls
\texttt{kcc\_lex\_next} internally, processes any directive or macro
it encounters, and presents the caller with a fully preprocessed
token stream.

\section{Data Structures}

A \emph{macro definition} records the macro's name, replacement body,
and (for function-like macros) parameter list.  Macros are stored in
a hash table mapping name text to a pointer to the definition
structure.

The \emph{context stack} supports nested \texttt{\#include} and macro
expansion by saving and restoring the lexer's scanning state.  The
\emph{conditional stack} tracks nested \texttt{\#if}/\texttt{\#endif}
groups.

@d PP: constants @{
// -- Preprocessor constants -----------------------------------------

// Macro definition layout (arena-allocated)
.equ PP_MACRO_NAME,      0    // pointer to macro name text
.equ PP_MACRO_NAMELEN,   8    // length of name
.equ PP_MACRO_FLAGS,    16    // bit flags (see below)
.equ PP_MACRO_NPARAMS,  24   // parameter count (func-like)
.equ PP_MACRO_BODY,     32   // pointer to replacement text
.equ PP_MACRO_BODYLEN,  40   // replacement text length
.equ PP_MACRO_PARAMS,   48   // pointer to param name array
.equ PP_MACRO_SIZE,     56

// Macro flags
.equ PP_FLAG_FUNCLIKE,   1   // function-like macro
.equ PP_FLAG_EXPANDING,  2   // currently being expanded (anti-recursion)
.equ PP_FLAG_BUILTIN,    4   // predefined, cannot #undef
.equ PP_FLAG_VARIADIC,   8   // function-like macro with a trailing ... (__VA_ARGS__)

// Parameter entry (16 bytes each)
.equ PP_PARAM_NAME,      0
.equ PP_PARAM_LEN,       8
.equ PP_PARAM_SIZE,     16

// Context stack entry (for #include and macro expansion)
.equ PP_CTX_TYPE,        0   // 0=include, 1=expand
.equ PP_CTX_CURSOR,      8   // saved _kcc_lex_cursor
.equ PP_CTX_END,        16   // saved _kcc_lex_end
.equ PP_CTX_LINE,       24   // saved _kcc_lex_line
.equ PP_CTX_LSTART,     32   // saved _kcc_lex_line_start
.equ PP_CTX_SRC_BASE,   40   // saved _kcc_src_base (include only)
.equ PP_CTX_SRC_SIZE,   48   // saved _kcc_src_size (include only)
.equ PP_CTX_SRC_PATH,   56   // saved _kcc_src_path (include only)
.equ PP_CTX_MACRO,      64   // macro_def ptr to unmark (expand only)
.equ PP_CTX_PREVLINE,   72   // saved prev_line
.equ PP_CTX_SIZE,       80

.equ PP_CTX_INCLUDE,     0
.equ PP_CTX_EXPAND,      1

// Limits
.equ PP_MAX_CTX_DEPTH, 256   // max include + expansion depth
.equ PP_MAX_COND,       64   // max conditional nesting
.equ PP_MAX_ARGS,       64   // max function-like macro args

// Conditional stack states
.equ PP_COND_ACTIVE,     0   // in the active branch
.equ PP_COND_SKIP,       1   // skipping (branch not taken)
.equ PP_COND_DONE,       2   // active branch already found
@}

\section{Initialization}

\texttt{kcc\_pp\_init} creates the macro hash table and registers the
predefined macros required by \stdref{6.10.8}.

@d PP: init @{
.text
// -- kcc_pp_init ----------------------------------------------------
// void kcc_pp_init(void)
// Initializes the preprocessor: creates macro table, sets up
// predefined macros, clears all state.
.globl _kcc_pp_init
.p2align 2
_kcc_pp_init:
    stp x29, x30, [sp, #-16]!
    mov x29, sp

    // Create macro hash table (capacity 256)
    mov x0, #256
    bl _kcc_ht_init
    adrp x1, _kcc_pp_macros@@PAGE
    add  x1, x1, _kcc_pp_macros@@PAGEOFF
    str  x0, [x1]

    // Clear context depth
    adrp x0, _kcc_pp_ctx_depth@@PAGE
    add  x0, x0, _kcc_pp_ctx_depth@@PAGEOFF
    str  xzr, [x0]

    // Clear conditional depth
    adrp x0, _kcc_pp_cond_depth@@PAGE
    add  x0, x0, _kcc_pp_cond_depth@@PAGEOFF
    str  xzr, [x0]

    // Clear prev_line (0 means "beginning of file" → first # is BOL)
    adrp x0, _kcc_pp_prev_line@@PAGE
    add  x0, x0, _kcc_pp_prev_line@@PAGEOFF
    str  xzr, [x0]

    // Clear has_pending
    adrp x0, _kcc_pp_has_pending@@PAGE
    add  x0, x0, _kcc_pp_has_pending@@PAGEOFF
    str  xzr, [x0]

    // Register predefined macros
    bl _kcc_pp_predefine

    ldp x29, x30, [sp], #16
    ret
@| _kcc_pp_init
@}

\section{The Preprocessor Loop}

\texttt{kcc\_pp\_next} is the main entry point.  It replaces
\texttt{kcc\_lex\_next} in the compilation pipeline.  Each call
returns one preprocessed token in the \texttt{\_kcc\_tok\_*} globals.

The loop handles three concerns:
\begin{enumerate}
\item \textbf{Conditional skip.}  If we are inside a false
      \texttt{\#if}/\texttt{\#ifdef} branch, all tokens are discarded
      except directive-introducing \texttt{\#} at the start of a
      line, which may toggle the conditional state.
\item \textbf{Directive processing.}  A \texttt{\#} token at the
      beginning of a line is a preprocessing directive.  The
      dispatcher consumes the entire directive and loops.
\item \textbf{Macro expansion.}  An identifier token is looked up
      in the macro table; if found, its expansion is pushed onto the
      context stack and the loop restarts to lex from the expansion.
\end{enumerate}

``Beginning of line'' is detected by comparing the token's line number
with the line of the previous token returned to the caller.

@d PP: next token @{
.text
// -- kcc_pp_next ----------------------------------------------------
// void kcc_pp_next(void)
// Returns next preprocessed token in _kcc_tok_* globals.
.globl _kcc_pp_next
.p2align 2
_kcc_pp_next:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]

.Lpp_loop:
    // Check for pending token (set by directive/expansion overflow)
    adrp x0, _kcc_pp_has_pending@@PAGE
    add  x0, x0, _kcc_pp_has_pending@@PAGEOFF
    ldr  x1, [x0]
    cbz  x1, .Lpp_call_lex
    str  xzr, [x0]            // clear pending flag
    b .Lpp_got_token

.Lpp_call_lex:
    bl _kcc_lex_next

.Lpp_got_token:
    // Load token type and line
    adrp x19, _kcc_tok_type@@PAGE
    add  x19, x19, _kcc_tok_type@@PAGEOFF
    ldr  x20, [x19]           // x20 = tok_type

    adrp x0, _kcc_tok_line@@PAGE
    add  x0, x0, _kcc_tok_line@@PAGEOFF
    ldr  x21, [x0]            // x21 = tok_line

    // ----- Handle EOF -----
    cbz  x20, .Lpp_eof

    // ----- Conditional skip -----
    adrp x0, _kcc_pp_cond_depth@@PAGE
    add  x0, x0, _kcc_pp_cond_depth@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lpp_active      // no conditionals → always active

    // Check top of conditional stack
    sub  x1, x0, #1
    adrp x2, _kcc_pp_cond_stack@@PAGE
    add  x2, x2, _kcc_pp_cond_stack@@PAGEOFF
    ldrb w3, [x2, x1]
    cmp  w3, #PP_COND_ACTIVE
    b.eq .Lpp_active

    // --- Skipping: only look for # at BOL ---
    cmp  x20, #TOK_HASH
    b.ne .Lpp_skip_tok
    // Check BOL
    adrp x0, _kcc_pp_prev_line@@PAGE
    add  x0, x0, _kcc_pp_prev_line@@PAGEOFF
    ldr  x0, [x0]
    cmp  x21, x0
    b.ls .Lpp_skip_tok         // same or earlier line → not BOL
    // Directive while skipping — update prev_line
    adrp x0, _kcc_pp_prev_line@@PAGE
    add  x0, x0, _kcc_pp_prev_line@@PAGEOFF
    str  x21, [x0]
    bl _kcc_pp_skip_directive
    b .Lpp_loop

.Lpp_skip_tok:
    adrp x0, _kcc_pp_prev_line@@PAGE
    add  x0, x0, _kcc_pp_prev_line@@PAGEOFF
    str  x21, [x0]
    b .Lpp_loop

    // ----- Active processing -----
.Lpp_active:
    // Check for # directive at BOL
    cmp  x20, #TOK_HASH
    b.ne .Lpp_not_directive
    adrp x0, _kcc_pp_prev_line@@PAGE
    add  x0, x0, _kcc_pp_prev_line@@PAGEOFF
    ldr  x0, [x0]
    cmp  x21, x0
    b.ls .Lpp_not_directive    // not BOL
    // Process directive (consumes the line)
    adrp x0, _kcc_pp_prev_line@@PAGE
    add  x0, x0, _kcc_pp_prev_line@@PAGEOFF
    str  x21, [x0]
    bl _kcc_pp_dispatch
    b .Lpp_loop

.Lpp_not_directive:
    // Check for macro expansion
    cmp  x20, #TOK_IDENT
    b.ne .Lpp_return
    bl _kcc_pp_try_expand
    cbnz x0, .Lpp_loop        // expanded → loop to get token from expansion

.Lpp_return:
    // Update prev_line and return
    adrp x0, _kcc_pp_prev_line@@PAGE
    add  x0, x0, _kcc_pp_prev_line@@PAGEOFF
    str  x21, [x0]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

.Lpp_eof:
    // Pop context stack if non-empty
    adrp x0, _kcc_pp_ctx_depth@@PAGE
    add  x0, x0, _kcc_pp_ctx_depth@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lpp_real_eof
    bl _kcc_pp_ctx_pop
    // Argument prescan boundary: if a drain floor is active and the stack has
    // dropped below it, the argument being expanded is exhausted---return this
    // TOK_EOF rather than reading on into the enclosing text (which would
    // over-read, and could even expand an enclosing macro).
    adrp x0, _kcc_pp_drain_floor@@PAGE
    add  x0, x0, _kcc_pp_drain_floor@@PAGEOFF
    ldr  x1, [x0]
    cbz  x1, .Lpp_loop
    adrp x0, _kcc_pp_ctx_depth@@PAGE
    add  x0, x0, _kcc_pp_ctx_depth@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, x1
    b.lt .Lpp_return          // popped below the floor → stop at EOF
    b .Lpp_loop

.Lpp_real_eof:
    // Check for unterminated conditionals
    adrp x0, _kcc_pp_cond_depth@@PAGE
    add  x0, x0, _kcc_pp_cond_depth@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lpp_eof_ok
    // Emit warning
    adrp x0, _kcc_tok_line@@PAGE
    add  x0, x0, _kcc_tok_line@@PAGEOFF
    ldr  x0, [x0]
    mov  x1, #1
    adrp x2, _kcc_pp_err_unterm_cond@@PAGE
    add  x2, x2, _kcc_pp_err_unterm_cond@@PAGEOFF
    bl _kcc_diag_error
.Lpp_eof_ok:
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_pp_next
@}

\section{Directive Dispatch}

When we encounter \texttt{\#} at the beginning of a line, the next
token is the directive name.  We dispatch to the appropriate handler
by comparing the name against the twelve C17 directives.

@d PP: directive dispatch @{
.text
// -- _kcc_pp_dispatch -----------------------------------------------
// Internal: dispatches a preprocessing directive.
// Called after '#' has been consumed. Reads directive name and routes.
.p2align 2
_kcc_pp_dispatch:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]

    // Save directive line number
    adrp x0, _kcc_tok_line@@PAGE
    add  x0, x0, _kcc_tok_line@@PAGEOFF
    ldr  x19, [x0]
    adrp x0, _kcc_pp_dir_line@@PAGE
    add  x0, x0, _kcc_pp_dir_line@@PAGEOFF
    str  x19, [x0]

    // Read directive name
    bl _kcc_lex_next

    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    // Directive name can be TOK_IDENT(1) or a keyword(10-53)
    // since "if" and "else" are C keywords the lexer recognizes
    cmp  x0, #TOK_IDENT
    b.eq .Ldir_has_name
    cmp  x0, #10               // TOK_AUTO (first keyword)
    b.lt .Ldir_null
    cmp  x0, #53               // TOK__THREAD_LOCAL (last keyword)
    b.gt .Ldir_null
.Ldir_has_name:

    // Load name ptr and len into callee-saved regs
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x20, [x0]            // x20 = name ptr
    adrp x0, _kcc_tok_len@@PAGE
    add  x0, x0, _kcc_tok_len@@PAGEOFF
    ldr  x21, [x0]            // x21 = name len

    // Dispatch by length, then memcmp
    cmp x21, #2
    b.eq .Ldir_l2
    cmp x21, #4
    b.eq .Ldir_l4
    cmp x21, #5
    b.eq .Ldir_l5
    cmp x21, #6
    b.eq .Ldir_l6
    cmp x21, #7
    b.eq .Ldir_l7
    b .Ldir_unknown

.Ldir_l2:  // "if"
    mov x0, x20
    adrp x1, _kcc_pp_s_if@@PAGE
    add  x1, x1, _kcc_pp_s_if@@PAGEOFF
    mov x2, #2
    bl _kcc_memcmp
    cbz x0, .Ldir_if
    b .Ldir_unknown

.Ldir_l4:  // elif, else, line
    mov x0, x20
    adrp x1, _kcc_pp_s_elif@@PAGE
    add  x1, x1, _kcc_pp_s_elif@@PAGEOFF
    mov x2, #4
    bl _kcc_memcmp
    cbz x0, .Ldir_elif

    mov x0, x20
    adrp x1, _kcc_pp_s_else@@PAGE
    add  x1, x1, _kcc_pp_s_else@@PAGEOFF
    mov x2, #4
    bl _kcc_memcmp
    cbz x0, .Ldir_else

    mov x0, x20
    adrp x1, _kcc_pp_s_line@@PAGE
    add  x1, x1, _kcc_pp_s_line@@PAGEOFF
    mov x2, #4
    bl _kcc_memcmp
    cbz x0, .Ldir_line_ctrl
    b .Ldir_unknown

.Ldir_l5:  // undef, ifdef, endif, error
    mov x0, x20
    adrp x1, _kcc_pp_s_ifdef@@PAGE
    add  x1, x1, _kcc_pp_s_ifdef@@PAGEOFF
    mov x2, #5
    bl _kcc_memcmp
    cbz x0, .Ldir_ifdef

    mov x0, x20
    adrp x1, _kcc_pp_s_undef@@PAGE
    add  x1, x1, _kcc_pp_s_undef@@PAGEOFF
    mov x2, #5
    bl _kcc_memcmp
    cbz x0, .Ldir_undef

    mov x0, x20
    adrp x1, _kcc_pp_s_endif@@PAGE
    add  x1, x1, _kcc_pp_s_endif@@PAGEOFF
    mov x2, #5
    bl _kcc_memcmp
    cbz x0, .Ldir_endif

    mov x0, x20
    adrp x1, _kcc_pp_s_error@@PAGE
    add  x1, x1, _kcc_pp_s_error@@PAGEOFF
    mov x2, #5
    bl _kcc_memcmp
    cbz x0, .Ldir_error
    b .Ldir_unknown

.Ldir_l6:  // define, ifndef, pragma
    mov x0, x20
    adrp x1, _kcc_pp_s_define@@PAGE
    add  x1, x1, _kcc_pp_s_define@@PAGEOFF
    mov x2, #6
    bl _kcc_memcmp
    cbz x0, .Ldir_define

    mov x0, x20
    adrp x1, _kcc_pp_s_ifndef@@PAGE
    add  x1, x1, _kcc_pp_s_ifndef@@PAGEOFF
    mov x2, #6
    bl _kcc_memcmp
    cbz x0, .Ldir_ifndef

    mov x0, x20
    adrp x1, _kcc_pp_s_pragma@@PAGE
    add  x1, x1, _kcc_pp_s_pragma@@PAGEOFF
    mov x2, #6
    bl _kcc_memcmp
    cbz x0, .Ldir_pragma
    b .Ldir_unknown

.Ldir_l7:  // include
    mov x0, x20
    adrp x1, _kcc_pp_s_include@@PAGE
    add  x1, x1, _kcc_pp_s_include@@PAGEOFF
    mov x2, #7
    bl _kcc_memcmp
    cbz x0, .Ldir_include
    b .Ldir_unknown
@}

\paragraph{Directive handlers.}
Once the name has been identified by length and content, control falls
through to a dispatch target that calls the appropriate handler function.
Each handler is a standalone routine that consumes the rest of the
directive line and returns to the dispatcher, which then restores
callee-saved registers and returns to the preprocessor loop.

@d PP: directive dispatch @{
// Dispatch targets
.Ldir_define:
    bl _kcc_pp_do_define
    b .Ldir_done
.Ldir_undef:
    bl _kcc_pp_do_undef
    b .Ldir_done
.Ldir_ifdef:
    mov x0, #0                 // negate=0 → ifdef
    bl _kcc_pp_do_ifdef
    b .Ldir_done
.Ldir_ifndef:
    mov x0, #1                 // negate=1 → ifndef
    bl _kcc_pp_do_ifdef
    b .Ldir_done
.Ldir_if:
    bl _kcc_pp_do_if
    b .Ldir_done
.Ldir_elif:
    bl _kcc_pp_do_elif
    b .Ldir_done
.Ldir_else:
    bl _kcc_pp_do_else
    b .Ldir_done
.Ldir_endif:
    bl _kcc_pp_do_endif
    b .Ldir_done
.Ldir_include:
    bl _kcc_pp_do_include
    b .Ldir_done
.Ldir_error:
    bl _kcc_pp_do_error
    b .Ldir_done
.Ldir_line_ctrl:
    bl _kcc_pp_do_line         // #line N: adjust the reported line number
    b .Ldir_done
.Ldir_pragma:
    bl _kcc_pp_do_pragma       // push_macro/pop_macro; other pragmas ignored
    b .Ldir_done
.Ldir_null:
    bl _kcc_pp_skip_line
    b .Ldir_done
.Ldir_unknown:
    mov x0, x19
    mov x1, #1
    adrp x2, _kcc_pp_err_unknown_dir@@PAGE
    add  x2, x2, _kcc_pp_err_unknown_dir@@PAGEOFF
    bl _kcc_diag_warning
    bl _kcc_pp_skip_line

.Ldir_done:
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@}

\section{Context Stack}

The context stack saves and restores lexer state for macro expansion
and \texttt{\#include}.  Push saves the current state and points the
lexer at a new buffer.  Pop restores the saved state and (for
expansion) clears the anti-recursion flag on the expanded macro.

@d PP: context @{
.text
// -- _kcc_pp_ctx_push -----------------------------------------------
// Push include context. x0 = type (PP_CTX_INCLUDE)
.p2align 2
_kcc_pp_ctx_push:
    stp x29, x30, [sp, #-16]!
    mov x29, sp

    adrp x1, _kcc_pp_ctx_depth@@PAGE
    add  x1, x1, _kcc_pp_ctx_depth@@PAGEOFF
    ldr  x2, [x1]
    cmp  x2, #PP_MAX_CTX_DEPTH
    b.hs .Lctx_overflow

    // Calculate stack entry address
    mov  x3, #PP_CTX_SIZE
    mul  x4, x2, x3
    adrp x5, _kcc_pp_ctx_stack@@PAGE
    add  x5, x5, _kcc_pp_ctx_stack@@PAGEOFF
    add  x5, x5, x4           // x5 = entry ptr

    // Save type
    str  x0, [x5, #PP_CTX_TYPE]

    // Save lexer state
    adrp x0, _kcc_lex_cursor@@PAGE
    add  x0, x0, _kcc_lex_cursor@@PAGEOFF
    ldr  x0, [x0]
    str  x0, [x5, #PP_CTX_CURSOR]

    adrp x0, _kcc_lex_end@@PAGE
    add  x0, x0, _kcc_lex_end@@PAGEOFF
    ldr  x0, [x0]
    str  x0, [x5, #PP_CTX_END]

    adrp x0, _kcc_lex_line@@PAGE
    add  x0, x0, _kcc_lex_line@@PAGEOFF
    ldr  x0, [x0]
    str  x0, [x5, #PP_CTX_LINE]

    adrp x0, _kcc_lex_line_start@@PAGE
    add  x0, x0, _kcc_lex_line_start@@PAGEOFF
    ldr  x0, [x0]
    str  x0, [x5, #PP_CTX_LSTART]

    // Save source state (for include)
    adrp x0, _kcc_src_base@@PAGE
    add  x0, x0, _kcc_src_base@@PAGEOFF
    ldr  x0, [x0]
    str  x0, [x5, #PP_CTX_SRC_BASE]

    adrp x0, _kcc_src_size@@PAGE
    add  x0, x0, _kcc_src_size@@PAGEOFF
    ldr  x0, [x0]
    str  x0, [x5, #PP_CTX_SRC_SIZE]

    adrp x0, _kcc_src_path@@PAGE
    add  x0, x0, _kcc_src_path@@PAGEOFF
    ldr  x0, [x0]
    str  x0, [x5, #PP_CTX_SRC_PATH]

    // Save prev_line
    adrp x0, _kcc_pp_prev_line@@PAGE
    add  x0, x0, _kcc_pp_prev_line@@PAGEOFF
    ldr  x0, [x0]
    str  x0, [x5, #PP_CTX_PREVLINE]

    // Clear macro pointer
    str  xzr, [x5, #PP_CTX_MACRO]

    // Increment depth
    add  x2, x2, #1
    str  x2, [x1]

    ldp x29, x30, [sp], #16
    ret

.Lctx_overflow:
    adrp x0, _kcc_tok_line@@PAGE
    add  x0, x0, _kcc_tok_line@@PAGEOFF
    ldr  x0, [x0]
    mov  x1, #1
    adrp x2, _kcc_pp_err_depth@@PAGE
    add  x2, x2, _kcc_pp_err_depth@@PAGEOFF
    bl _kcc_diag_error
    mov  x0, #1
    bl _kcc_sys_exit

// -- _kcc_pp_ctx_push_expand ----------------------------------------
// Push expansion context.
// x0=type(PP_CTX_EXPAND), x1=macro_def, x2=buffer, x3=buflen
.p2align 2
_kcc_pp_ctx_push_expand:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]

    mov x19, x1               // macro_def
    mov x20, x2               // buffer
    mov x21, x3               // buflen

    // Push the base context (saves lexer state)
    mov x0, #PP_CTX_EXPAND
    bl _kcc_pp_ctx_push

    // Now patch the entry with macro pointer
    adrp x0, _kcc_pp_ctx_depth@@PAGE
    add  x0, x0, _kcc_pp_ctx_depth@@PAGEOFF
    ldr  x0, [x0]
    sub  x0, x0, #1           // just-pushed entry
    mov  x1, #PP_CTX_SIZE
    mul  x0, x0, x1
    adrp x1, _kcc_pp_ctx_stack@@PAGE
    add  x1, x1, _kcc_pp_ctx_stack@@PAGEOFF
    add  x1, x1, x0
    str  x19, [x1, #PP_CTX_MACRO]

    // Point lexer at expansion buffer
    adrp x0, _kcc_lex_cursor@@PAGE
    add  x0, x0, _kcc_lex_cursor@@PAGEOFF
    str  x20, [x0]

    adrp x0, _kcc_lex_end@@PAGE
    add  x0, x0, _kcc_lex_end@@PAGEOFF
    add  x1, x20, x21
    str  x1, [x0]

    // Set line to current token line (for error reporting)
    // line_start = buffer start
    adrp x0, _kcc_lex_line_start@@PAGE
    add  x0, x0, _kcc_lex_line_start@@PAGEOFF
    str  x20, [x0]

    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@}

When an included file or macro expansion reaches \texttt{TOK\_EOF},
the preprocessor loop calls \texttt{\_kcc\_pp\_ctx\_pop} to restore
the previous lexer state.  For expansion contexts, the macro's
anti-recursion flag (\texttt{PP\_FLAG\_EXPANDING}) is cleared so that
later occurrences of the same macro name can be expanded again.  For
include contexts, the saved source buffer and path are restored in
addition to the lexer cursor.

@d PP: context @{
// -- _kcc_pp_ctx_pop ------------------------------------------------
// Pop context stack. Restores lexer state. Unmarks macro if expand.
.p2align 2
_kcc_pp_ctx_pop:
    stp x29, x30, [sp, #-16]!
    mov x29, sp

    adrp x0, _kcc_pp_ctx_depth@@PAGE
    add  x0, x0, _kcc_pp_ctx_depth@@PAGEOFF
    ldr  x1, [x0]
    cbz  x1, .Lctx_pop_done   // empty stack (shouldn't happen)
    sub  x1, x1, #1
    str  x1, [x0]

    // Get entry
    mov  x2, #PP_CTX_SIZE
    mul  x3, x1, x2
    adrp x4, _kcc_pp_ctx_stack@@PAGE
    add  x4, x4, _kcc_pp_ctx_stack@@PAGEOFF
    add  x4, x4, x3           // x4 = entry ptr

    // Check type
    ldr  x0, [x4, #PP_CTX_TYPE]
    cmp  x0, #PP_CTX_EXPAND
    b.eq .Lctx_pop_expand

    // -- Include pop: restore source state too --
    ldr  x0, [x4, #PP_CTX_SRC_BASE]
    adrp x1, _kcc_src_base@@PAGE
    add  x1, x1, _kcc_src_base@@PAGEOFF
    str  x0, [x1]

    ldr  x0, [x4, #PP_CTX_SRC_SIZE]
    adrp x1, _kcc_src_size@@PAGE
    add  x1, x1, _kcc_src_size@@PAGEOFF
    str  x0, [x1]

    ldr  x0, [x4, #PP_CTX_SRC_PATH]
    adrp x1, _kcc_src_path@@PAGE
    add  x1, x1, _kcc_src_path@@PAGEOFF
    str  x0, [x1]
    b .Lctx_pop_restore

.Lctx_pop_expand:
    // Unmark macro anti-recursion flag
    ldr  x0, [x4, #PP_CTX_MACRO]
    cbz  x0, .Lctx_pop_restore
    ldr  x1, [x0, #PP_MACRO_FLAGS]
    bic  x1, x1, #PP_FLAG_EXPANDING
    str  x1, [x0, #PP_MACRO_FLAGS]

.Lctx_pop_restore:
    // Restore lexer state
    ldr  x0, [x4, #PP_CTX_CURSOR]
    adrp x1, _kcc_lex_cursor@@PAGE
    add  x1, x1, _kcc_lex_cursor@@PAGEOFF
    str  x0, [x1]

    ldr  x0, [x4, #PP_CTX_END]
    adrp x1, _kcc_lex_end@@PAGE
    add  x1, x1, _kcc_lex_end@@PAGEOFF
    str  x0, [x1]

    ldr  x0, [x4, #PP_CTX_LINE]
    adrp x1, _kcc_lex_line@@PAGE
    add  x1, x1, _kcc_lex_line@@PAGEOFF
    str  x0, [x1]

    ldr  x0, [x4, #PP_CTX_LSTART]
    adrp x1, _kcc_lex_line_start@@PAGE
    add  x1, x1, _kcc_lex_line_start@@PAGEOFF
    str  x0, [x1]

    // Restore prev_line
    ldr  x0, [x4, #PP_CTX_PREVLINE]
    adrp x1, _kcc_pp_prev_line@@PAGE
    add  x1, x1, _kcc_pp_prev_line@@PAGEOFF
    str  x0, [x1]

.Lctx_pop_done:
    ldp x29, x30, [sp], #16
    ret
@}

\section{Helper Functions}

Two utility routines support the directive handlers.
\texttt{\_kcc\_pp\_skip\_line} advances the lexer cursor past the end of
the current line, updating the line counter when it crosses a newline.
Directives call it to discard trailing tokens after the significant
part has been processed.  \texttt{\_kcc\_pp\_rest\_of\_line} returns a
pointer and length for the remaining text on the directive line, with
leading and trailing whitespace trimmed, so that \texttt{\#define}
bodies and \texttt{\#if} expressions can be extracted cleanly.

@d PP: helpers @{
.text
// -- _kcc_pp_skip_line ----------------------------------------------
// Advances the lexer cursor past the end of the current line.
.p2align 2
_kcc_pp_skip_line:
    adrp x0, _kcc_lex_cursor@@PAGE
    add  x0, x0, _kcc_lex_cursor@@PAGEOFF
    ldr  x1, [x0]
    adrp x2, _kcc_lex_end@@PAGE
    add  x2, x2, _kcc_lex_end@@PAGEOFF
    ldr  x2, [x2]
.Lsl_loop:
    cmp  x1, x2
    b.hs .Lsl_done
    ldrb w3, [x1]
    add  x1, x1, #1
    cmp  w3, #0x0A
    b.ne .Lsl_loop
    // Found newline: update line counter
    adrp x3, _kcc_lex_line@@PAGE
    add  x3, x3, _kcc_lex_line@@PAGEOFF
    ldr  x4, [x3]
    add  x4, x4, #1
    str  x4, [x3]
    adrp x3, _kcc_lex_line_start@@PAGE
    add  x3, x3, _kcc_lex_line_start@@PAGEOFF
    str  x1, [x3]
.Lsl_done:
    str  x1, [x0]
    ret

// -- _kcc_pp_rest_of_line -------------------------------------------
// Returns rest of directive line from cursor.
// x0 = text start (after leading whitespace), x1 = text length
// Advances cursor to the newline (lexer will skip it).
.p2align 2
_kcc_pp_rest_of_line:
    stp x29, x30, [sp, #-16]!
    mov x29, sp

    adrp x2, _kcc_lex_cursor@@PAGE
    add  x2, x2, _kcc_lex_cursor@@PAGEOFF
    ldr  x0, [x2]             // cursor
    mov  x4, x2               // save ptr to cursor global

    adrp x2, _kcc_lex_end@@PAGE
    add  x2, x2, _kcc_lex_end@@PAGEOFF
    ldr  x1, [x2]             // end

    // Skip leading spaces/tabs
.Lrol_skip:
    cmp  x0, x1
    b.hs .Lrol_empty
    ldrb w3, [x0]
    cmp  w3, #' '
    b.eq .Lrol_sk
    cmp  w3, #0x09
    b.eq .Lrol_sk
    b .Lrol_start
.Lrol_sk:
    add  x0, x0, #1
    b .Lrol_skip

.Lrol_start:
    mov  x5, x0               // text start
    mov  x7, #0               // state: 0=normal 1=block-comment 2=string 3=char
    // Scan to the newline that terminates the directive.  A block comment is
    // whitespace that may span physical lines (\stdref{5.1.1.2} phase 3): the
    // newline \emph{inside} it does not end the directive, so we keep scanning
    // to the closing \texttt{*/} --- otherwise the comment's continuation line
    // (e.g. the second line of a two-line comment after a \texttt{\#define})
    // would be lexed as code.  String and character literals are tracked so a
    // \texttt{/*} inside one is not mistaken for a comment.
.Lrol_scan:
    cmp  x0, x1
    b.hs .Lrol_at_end
    ldrb w3, [x0]
    cmp  x7, #1
    b.eq .Lrol_st_block
    cmp  x7, #2
    b.eq .Lrol_st_str
    cmp  x7, #3
    b.eq .Lrol_st_char
    // normal state
    cmp  w3, #0x0A
    b.eq .Lrol_found_nl
    cmp  w3, #'"'
    b.eq .Lrol_enter_str
    cmp  w3, #0x27            // '
    b.eq .Lrol_enter_char
    cmp  w3, #'/'
    b.ne .Lrol_adv1
    add  x8, x0, #1
    cmp  x8, x1
    b.hs .Lrol_adv1
    ldrb w9, [x8]
    cmp  w9, #'*'
    b.ne .Lrol_adv1
    mov  x7, #1              // enter block comment
    add  x0, x0, #2
    b .Lrol_scan
.Lrol_enter_str:
    mov  x7, #2
    add  x0, x0, #1
    b .Lrol_scan
.Lrol_enter_char:
    mov  x7, #3
    add  x0, x0, #1
    b .Lrol_scan
.Lrol_adv1:
    add  x0, x0, #1
    b .Lrol_scan
.Lrol_st_block:
    cmp  w3, #'*'
    b.ne .Lrol_block_adv
    add  x8, x0, #1
    cmp  x8, x1
    b.hs .Lrol_block_adv
    ldrb w9, [x8]
    cmp  w9, #'/'
    b.ne .Lrol_block_adv
    mov  x7, #0             // close block comment
    add  x0, x0, #2
    b .Lrol_scan
.Lrol_block_adv:
    cmp  w3, #0x0A          // newline inside comment: keep line count accurate
    b.ne .Lrol_adv1
    adrp x8, _kcc_lex_line@@PAGE
    add  x8, x8, _kcc_lex_line@@PAGEOFF
    ldr  x9, [x8]
    add  x9, x9, #1
    str  x9, [x8]
    add  x0, x0, #1
    b .Lrol_scan
.Lrol_st_str:
    cmp  w3, #0x5C          // backslash: skip the escaped character
    b.ne .Lrol_str_q
    add  x0, x0, #2
    b .Lrol_scan
.Lrol_str_q:
    cmp  w3, #'"'
    b.ne .Lrol_str_nl
    mov  x7, #0
    add  x0, x0, #1
    b .Lrol_scan
.Lrol_str_nl:
    cmp  w3, #0x0A          // an unterminated string still ends at the newline
    b.eq .Lrol_found_nl
    add  x0, x0, #1
    b .Lrol_scan
.Lrol_st_char:
    cmp  w3, #0x5C
    b.ne .Lrol_char_q
    add  x0, x0, #2
    b .Lrol_scan
.Lrol_char_q:
    cmp  w3, #0x27
    b.ne .Lrol_char_nl
    mov  x7, #0
    add  x0, x0, #1
    b .Lrol_scan
.Lrol_char_nl:
    cmp  w3, #0x0A
    b.eq .Lrol_found_nl
    add  x0, x0, #1
    b .Lrol_scan

.Lrol_found_nl:
    // Set cursor to newline (lexer will skip it later)
    str  x0, [x4]
    // Trim trailing whitespace
    mov  x6, x0
.Lrol_trim:
    cmp  x6, x5
    b.ls .Lrol_trimmed
    sub  x6, x6, #1
    ldrb w3, [x6]
    cmp  w3, #' '
    b.eq .Lrol_trim
    cmp  w3, #0x09
    b.eq .Lrol_trim
    add  x6, x6, #1
    b .Lrol_ret
.Lrol_trimmed:
    mov  x6, x5
.Lrol_ret:
    mov  x0, x5               // text start
    sub  x1, x6, x5           // text length
    ldp  x29, x30, [sp], #16
    ret

.Lrol_at_end:
    str  x1, [x4]             // cursor = end
    mov  x6, x0
    b .Lrol_ret

.Lrol_empty:
    str  x1, [x4]
    mov  x0, x1
    mov  x1, #0
    ldp  x29, x30, [sp], #16
    ret
@}

\section{Preprocessed Output (\texttt{-E} Mode)}

\texttt{kcc\_pp\_dump\_all} emits the entire preprocessed token stream
to stdout, one token per line, in the same format as
\texttt{kcc\_lex\_dump\_all}.

@d PP: dump @{
.text
// -- kcc_pp_dump_all ------------------------------------------------
// void kcc_pp_dump_all(void)
// Calls kcc_pp_next in a loop and dumps each token.
.globl _kcc_pp_dump_all
.p2align 2
_kcc_pp_dump_all:
    stp x29, x30, [sp, #-16]!
    mov x29, sp

.Lppdump_loop:
    bl _kcc_pp_next

    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lppdump_done    // TOK_EOF

    bl _kcc_lex_dump_token
    b .Lppdump_loop

.Lppdump_done:
    ldp x29, x30, [sp], #16
    ret
@| _kcc_pp_dump_all
@}

\section{Global State}

The preprocessor keeps its state in a set of global variables.  The
macro hash table (\texttt{\_kcc\_pp\_macros}) maps macro names to
definition structures.  The context stack records saved lexer states
for nested \texttt{\#include} files and macro expansions, while the
conditional stack tracks \texttt{\#if}/\texttt{\#endif} nesting depth
and branch state.  The \texttt{prev\_line} variable enables
beginning-of-line detection for directive recognition.

@d PP: data @{
// -- Preprocessor global state --------------------------------------
.data
.p2align 3
.globl _kcc_pp_macros
_kcc_pp_macros:      .quad 0     // pointer to macro hash table
_kcc_pp_macro_stack: .quad 0     // head of the #pragma push_macro save stack
_kcc_pp_eval_depth:  .quad 0     // #if-expression macro recursion guard
.globl _kcc_line_delta
_kcc_line_delta:     .quad 0     // #line adjustment: __LINE__ = _kcc_lex_line + this
_kcc_pp_drain_floor: .quad 0     // >0: pp_next stops when the ctx stack drops below it (argument prescan)
.globl _kcc_pp_ctx_depth
_kcc_pp_ctx_depth:   .quad 0     // context stack depth
_kcc_pp_cond_depth:  .quad 0     // conditional stack depth
_kcc_pp_prev_line:   .quad 0     // line of previous token (BOL detection)
_kcc_pp_has_pending: .quad 0     // pending token flag
_kcc_pp_dir_line:    .quad 0     // line of current directive

// Context stack (PP_MAX_CTX_DEPTH * PP_CTX_SIZE bytes)
// 256 * 80 = 20480 bytes
.p2align 3
_kcc_pp_ctx_stack:   .space 20480

// Conditional stack (PP_MAX_COND bytes)
.p2align 3
_kcc_pp_cond_stack:  .space 64

// -- Directive name strings -----------------------------------------
.section __TEXT,__cstring,cstring_literals
_kcc_pp_s_define:    .asciz "define"
_kcc_pp_s_undef:     .asciz "undef"
_kcc_pp_s_ifdef:     .asciz "ifdef"
_kcc_pp_s_ifndef:    .asciz "ifndef"
_kcc_pp_s_if:        .asciz "if"
_kcc_pp_s_elif:      .asciz "elif"
_kcc_pp_s_else:      .asciz "else"
_kcc_pp_s_endif:     .asciz "endif"
_kcc_pp_s_include:   .asciz "include"
_kcc_pp_s_error:     .asciz "error"
_kcc_pp_s_line:      .asciz "line"
_kcc_pp_s_pragma:    .asciz "pragma"
_kcc_pp_s_push_macro: .asciz "push_macro"
_kcc_pp_s_pop_macro:  .asciz "pop_macro"
_kcc_pp_s_defined:   .asciz "defined"

// -- Predefined macro name strings ----------------------------------
_kcc_pp_pre_stdc:     .asciz "__STDC__"
_kcc_pp_pre_stdc_ver: .asciz "__STDC_VERSION__"
_kcc_pp_pre_hosted:   .asciz "__STDC_HOSTED__"
_kcc_pp_pre_no_atomics: .asciz "__STDC_NO_ATOMICS__"
_kcc_pp_pre_no_threads: .asciz "__STDC_NO_THREADS__"
_kcc_pp_pre_no_complex: .asciz "__STDC_NO_COMPLEX__"
_kcc_pp_pre_no_vla:   .asciz "__STDC_NO_VLA__"
_kcc_pp_pre_lp64:     .asciz "__LP64__"
_kcc_pp_pre_lp64b:    .asciz "_LP64"
_kcc_pp_va_args_str:  .asciz "__VA_ARGS__"
_kcc_pp_pre_linem:    .asciz "__LINE__"
_kcc_pp_pre_one:      .asciz "1"
_kcc_pp_pre_c17val:   .asciz "201710L"

// -- Error messages -------------------------------------------------
_kcc_pp_err_unknown_dir:  .asciz "unknown preprocessing directive"
_kcc_pp_err_def_name:     .asciz "expected identifier after #define"
_kcc_pp_err_def_param:    .asciz "expected parameter name or ')' in macro parameter list"
_kcc_pp_err_ifdef_name:   .asciz "expected identifier after #ifdef/#ifndef"
_kcc_pp_err_stray_elif:   .asciz "#elif without matching #if"
_kcc_pp_err_stray_else:   .asciz "#else without matching #if"
_kcc_pp_err_stray_endif:  .asciz "#endif without matching #if"
_kcc_pp_err_include:      .asciz "#include expects \"file\" or <file>"
_kcc_pp_err_notfound:     .asciz "#include file not found"
_kcc_pp_err_unterm_cond:  .asciz "unterminated conditional directive"
_kcc_pp_err_unterm_args:  .asciz "unterminated macro argument list"
_kcc_pp_err_depth:        .asciz "maximum include/expansion depth exceeded"
@| _kcc_pp_macros
@| _kcc_pp_ctx_depth
@| _kcc_pp_cond_depth
@| _kcc_pp_prev_line
@| _kcc_pp_has_pending
@| _kcc_pp_dir_line
@| _kcc_pp_ctx_stack
@| _kcc_pp_cond_stack
@| _kcc_pp_s_define
@| _kcc_pp_s_undef
@| _kcc_pp_s_ifdef
@| _kcc_pp_s_ifndef
@| _kcc_pp_s_if
@| _kcc_pp_s_elif
@| _kcc_pp_s_else
@| _kcc_pp_s_endif
@| _kcc_pp_s_include
@| _kcc_pp_s_error
@| _kcc_pp_s_line
@| _kcc_pp_s_pragma
@| _kcc_pp_s_defined
@| _kcc_pp_pre_stdc
@| _kcc_pp_pre_stdc_ver
@| _kcc_pp_pre_hosted
@| _kcc_pp_pre_one
@| _kcc_pp_pre_c17val
@| _kcc_pp_err_unknown_dir
@| _kcc_pp_err_def_name
@| _kcc_pp_err_def_param
@| _kcc_pp_err_ifdef_name
@| _kcc_pp_err_stray_elif
@| _kcc_pp_err_stray_else
@| _kcc_pp_err_stray_endif
@| _kcc_pp_err_include
@| _kcc_pp_err_unterm_cond
@| _kcc_pp_err_unterm_args
@| _kcc_pp_err_depth
@}
