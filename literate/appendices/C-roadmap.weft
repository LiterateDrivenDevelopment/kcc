% C-roadmap.weft — Complete phase roadmap for kcc
%
% This appendix documents every phase required to produce a
% fully conforming C17 compiler from bare ARM64 assembly.

\chapter{Development Roadmap}
\label{ch:roadmap}

This appendix enumerates the complete sequence of implementation
phases that take \kcc{} from a bootable skeleton (Phase~0) to a
self-hosting, conforming C17 compiler (Phase~8).  Each phase lists
the \texttt{.weft} files to be created or extended, the new tangled
output files, and the acceptance criteria that must hold before the
phase is considered complete.

% ────────────────────────────────────────────────────────────────
\section{Phase 0 --- Project Skeleton}
\label{sec:phase0}

\textbf{Goal.}  Prove the literate infrastructure works end to end:
\texttt{just build} produces a native ARM64 binary that boots,
prints a banner, and exits cleanly.  No C source is compiled yet.

\textbf{weft files.}
\begin{itemize}
\item \texttt{kcc.weft} --- master file, LaTeX preamble, includes.
\item \texttt{literate/assembly.weft} --- output routing (all
      output directives live here).
\item \texttt{literate/foundations/01-normative-corpus.weft} ---
      standards and citation conventions (prose only).
\item \texttt{literate/foundations/02-conformance-model.weft} ---
      conformance obligations (prose only).
\item \texttt{literate/machine/07-arm64-conventions.weft} ---
      register map, Apple ABI, \texttt{FUNC}/\texttt{ENDFUNC}/\texttt{SYSCALL} macros.
\item \texttt{literate/machine/08-syscalls.weft} ---
      \texttt{exit}, \texttt{write}, \texttt{read}, \texttt{open},
      \texttt{close}, \texttt{mmap} wrappers.
\item \texttt{literate/machine/09-memory-management.weft} ---
      arena allocator (bump pointer over \texttt{mmap} chunks).
\item \texttt{literate/machine/11-string-operations.weft} ---
      \texttt{strlen}, \texttt{memcpy}, \texttt{memcmp}, \texttt{memset}.
\item \texttt{literate/machine/12-io.weft} ---
      buffered file I/O (4\,KiB static buffer, flush/putc/puts).
\item \texttt{literate/driver/43-main.weft} ---
      \texttt{\_main} entry point, argument parsing, banner.
\end{itemize}

\textbf{Tangled output.}
\texttt{main.s}, \texttt{syscalls.s}, \texttt{arena.s},
\texttt{strings.s}, \texttt{io.s}.

\textbf{Acceptance.}
\begin{enumerate}
\item \texttt{just tangle} succeeds with no errors.
\item \texttt{just build} assembles and links with no errors.
\item \texttt{tmp/kcc} prints its banner and exits 0.
\item \texttt{tmp/kcc hello.c} echoes the source file name.
\end{enumerate}

\textbf{Status.} Complete.

% ────────────────────────────────────────────────────────────────
\section{Phase 1 --- Data Structures and Lexer Foundation}
\label{sec:phase1}

\textbf{Goal.}  Read a C source file from disk and tokenize it into
a stream of C17 preprocessing tokens (\stdref{6.4}).

\textbf{weft files.}
\begin{itemize}
\item \texttt{literate/machine/10-data-structures.weft} ---
      hash table (open addressing, FNV-1a) and dynamic vector,
      both arena-allocated.
\item \texttt{literate/machine/14-source-manager.weft} ---
      \texttt{mmap}-based file reading, source location tracking
      (file/line/column as a packed 64-bit value).
\item \texttt{literate/frontend/17-lexer.weft} ---
      character classification tables, tokenizer for all C17
      token classes: identifiers, keywords, integer/floating
      constants, string/char literals, punctuators.
\end{itemize}

\textbf{New tangled files.}
\texttt{hashtab.s}, \texttt{vec.s}, \texttt{strtab.s},
\texttt{source.s}, \texttt{lexer.s}, \texttt{lexer\_tables.s}.

\textbf{Acceptance.}
\begin{enumerate}
\item \texttt{tmp/kcc --dump-tokens hello.c} prints every token
      with its source location.
\item All 44 C17 keywords are recognized.
\item Integer, floating, character, and string literals are
      correctly classified (value parsing deferred to Phase~5).
\item Unterminated strings and unrecognized characters produce
      diagnostics on stderr.
\end{enumerate}

\textbf{Status.} Complete.

% ────────────────────────────────────────────────────────────────
\section{Phase 2 --- Complete Lexer and Diagnostics}
\label{sec:phase2}

\textbf{Goal.}  Finish the tokenizer to full C17 conformance and
build the diagnostic engine required by \stdref{5.1.1.3}.

\textbf{weft files.}
\begin{itemize}
\item \texttt{literate/machine/13-diagnostics.weft} ---
      diagnostic engine: error/warning/note classification,
      source-location printing (``file:line:col: error: ...''),
      error-count tracking, fatal-error limit.
\item \texttt{literate/frontend/15-source-encoding.weft} ---
      Phase~1 of translation: trigraph replacement, source
      character set mapping (\stdref{5.1.1.2} phase 1).
\item \texttt{literate/frontend/16-line-splicing.weft} ---
      Phase~2 of translation: backslash-newline splicing
      (\stdref{5.1.1.2} phase 2).
\item \texttt{literate/verification/44-test-harness.weft} ---
      test runner: discover tests, run each, report pass/fail.
\item \texttt{literate/verification/45-conformance-tests.weft} ---
      initial lexer conformance tests.
\end{itemize}

\textbf{New tangled files.}
\texttt{diag.s}, \texttt{test\_runner.s}, \texttt{test\_lexer.s}.

\textbf{Acceptance.}
\begin{enumerate}
\item Diagnostics follow the format
      \texttt{file:line:col: error: message}.
\item Trigraphs and line splicing are handled before tokenization.
\item \texttt{just test} runs the test suite and reports results.
\item The lexer correctly tokenizes the GCC torture test suite's
      lexer-visible subset (no preprocessing yet).
\end{enumerate}

\textbf{Status.} Complete.

% ────────────────────────────────────────────────────────────────
\section{Phase 3 --- Preprocessor}
\label{sec:phase3}

\textbf{Goal.}  Implement the full C17 preprocessor
(\stdref{6.10}), covering translation phases 3 and 4.

\textbf{weft files.}
\begin{itemize}
\item \texttt{literate/frontend/18-preprocessor.weft} ---
      macro definition (\texttt{\#define}), macro expansion
      (object-like and function-like with stringification and
      token pasting), conditional compilation
      (\texttt{\#if}/\texttt{\#ifdef}/\texttt{\#elif}/\texttt{\#else}/\texttt{\#endif}),
      file inclusion (\texttt{\#include}), line control
      (\texttt{\#line}), error directive (\texttt{\#error}),
      pragma handling (\texttt{\#pragma}, including
      \texttt{\_Pragma} operator), null directive.
\item \texttt{literate/frontend/19-string-literals.weft} ---
      Phase~5: escape sequence processing, execution charset
      mapping.
\item \texttt{literate/frontend/20-concatenation.weft} ---
      Phase~6: adjacent string literal concatenation.
\end{itemize}

\textbf{New tangled files.}
\texttt{preprocessor.s}.

\textbf{Acceptance.}
\begin{enumerate}
\item \texttt{tmp/kcc -E file.c} outputs the preprocessed token
      stream (translation phases 1--6 complete).
\item Recursive and self-referential macros terminate correctly
      per \stdref{6.10.3.4}.
\item \texttt{\#include} searches \texttt{-I} directories and
      the system include path.
\item String concatenation across macro boundaries works.
\item Predefined macros (\texttt{\_\_FILE\_\_},
      \texttt{\_\_LINE\_\_}, \texttt{\_\_DATE\_\_},
      \texttt{\_\_TIME\_\_}, \texttt{\_\_STDC\_\_},
      \texttt{\_\_STDC\_VERSION\_\_}) are set correctly.
\end{enumerate}

\textbf{Status.} Complete (core directives: \texttt{\#define}
object-like and function-like,
\texttt{\#include} of a quoted header resolved relative to the
including file, \texttt{\#if}/\texttt{\#ifdef}/\texttt{\#endif},
\texttt{\#error}; predefined macros).  A \texttt{-I} system search path
remains for Phase~9.

% ────────────────────────────────────────────────────────────────
\section{Phase 4 --- Parser}
\label{sec:phase4}

\textbf{Goal.}  Build a recursive-descent parser that consumes
the preprocessed token stream and produces a typed abstract syntax
tree (AST) for every C17 construct.

\textbf{weft files.}
\begin{itemize}
\item \texttt{literate/frontend/21-parser.weft} ---
      parser core: recursive descent infrastructure, AST node
      allocation (arena), AST node types, error recovery
      (synchronization tokens).
\item \texttt{literate/frontend/22-declarations.weft} ---
      declaration parsing: declaration specifiers, declarators
      (including abstract and function), the typedef hack
      (lexer feedback), \texttt{struct}/\texttt{union}/\texttt{enum}
      definitions, \texttt{\_Static\_assert}.
\item \texttt{literate/frontend/23-expressions.weft} ---
      expression parsing: precedence climbing for all C17
      operators (15 precedence levels), postfix operators
      (call, subscript, member access, increment/decrement),
      unary operators, cast expressions, compound literals,
      \texttt{\_Generic} selection, \texttt{sizeof}/\texttt{\_Alignof}.
\item \texttt{literate/frontend/24-statements.weft} ---
      statement parsing: compound, \texttt{if}/\texttt{else},
      \texttt{switch}/\texttt{case}/\texttt{default},
      \texttt{while}, \texttt{do}/\texttt{while}, \texttt{for},
      \texttt{goto}, \texttt{continue}, \texttt{break},
      \texttt{return}, labeled statements, expression statements.
\end{itemize}

\textbf{New tangled files.}
\texttt{parser.s}, \texttt{declarations.s},
\texttt{expressions.s}, \texttt{statements.s}.

\textbf{Acceptance.}
\begin{enumerate}
\item \texttt{tmp/kcc --dump-ast file.c} prints the AST in a
      readable tree format.
\item All syntactically valid C17 programs parse without error.
\item Syntax errors produce useful diagnostics with the
      offending token highlighted.
\item The typedef ambiguity is resolved correctly (e.g.,
      \texttt{T * x;} parsed as declaration when \texttt{T} is
      a typedef name).
\item \texttt{sizeof(int)} and \texttt{sizeof x} both parse.
\end{enumerate}

\textbf{Status.} Complete.

% ────────────────────────────────────────────────────────────────
\section{Phase 5 --- Type System and Semantic Analysis}
\label{sec:phase5}

\textbf{Goal.}  Implement the C17 type system and semantic
analysis pass that decorates the AST with type information and
checks all constraints.

\textbf{weft files.}
\begin{itemize}
\item \texttt{literate/semantics/25-symbol-table.weft} ---
      four namespaces (\stdref{6.2.3}): ordinary identifiers,
      tags, labels, struct/union members.  Scope management:
      file, function, block, function-prototype scopes.
      Linkage resolution (external, internal, none).
\item \texttt{literate/semantics/26-type-system.weft} ---
      internal type representation: basic types, qualified types,
      pointer, array (fixed, variable-length, incomplete),
      function types, struct/union/enum types.
      Type compatibility (\stdref{6.2.7}) and composite type
      construction.
\item \texttt{literate/semantics/27-type-conversions.weft} ---
      integer promotions (\stdref{6.3.1.1}), usual arithmetic
      conversions (\stdref{6.3.1.8}), implicit conversions,
      explicit casts, pointer conversions.
\item \texttt{literate/semantics/28-type-checking.weft} ---
      constraint checking for every expression operator per
      \stdref{6.5}: operand type requirements, result types,
      lvalue-to-rvalue conversion, array-to-pointer decay,
      function-to-pointer decay.
\item \texttt{literate/semantics/29-initializers.weft} ---
      initializer processing (\stdref{6.7.9}): designated
      initializers, brace elision, string initializers for
      arrays, recursive struct/union/array initialization.
\item \texttt{literate/semantics/30-constant-expressions.weft} ---
      compile-time evaluation (\stdref{6.6}): integer constant
      expressions, arithmetic constant expressions, address
      constants.
\end{itemize}

\textbf{New tangled files.}
\texttt{symtab.s}, \texttt{types.s}, \texttt{conversions.s},
\texttt{sema.s}.

\textbf{Acceptance.}
\begin{enumerate}
\item Type errors produce clear diagnostics citing the
      relevant Standard clause.
\item \texttt{tmp/kcc --dump-types file.c} prints every
      expression with its resolved type.
\item Implicit conversions (integer promotions, UAC, pointer
      decay) are inserted automatically.
\item Struct member access chains resolve correctly through
      anonymous structs/unions.
\item \texttt{enum} constants are typed as \texttt{int} per
      \stdref{6.7.2.2}.
\item Initializer lists with designators and brace elision
      produce the correct initialized object.
\end{enumerate}

\textbf{Status.} Complete (core type checking for integer types,
pointers, functions; \texttt{--dump-types} and \texttt{--check} flags).

% ────────────────────────────────────────────────────────────────
\section{Phase 6 --- Intermediate Representation and Optimization}
\label{sec:phase6}

\textbf{Goal.}  Lower the typed AST into a linear intermediate
representation (IR) with virtual registers, and implement
essential optimization passes.

\textbf{weft files.}
\begin{itemize}
\item \texttt{literate/ir/31-ir-design.weft} ---
      IR design: linear IR with virtual registers, basic blocks,
      control-flow graph, SSA-like properties (each virtual
      register assigned once).  IR instruction set: arithmetic,
      comparison, branch, call, load, store, alloca, phi, cast.
\item \texttt{literate/ir/32-ir-builder.weft} ---
      AST-to-IR lowering: expression evaluation, short-circuit
      boolean operators, \texttt{switch} lowering (jump table or
      if-chain), loop lowering, struct passing/returning.
\item \texttt{literate/ir/33-ir-validation.weft} ---
      IR well-formedness checks: every use dominated by its
      definition, consistent types, correct basic-block
      termination, reachability analysis.
\item \texttt{literate/optimization/34-ir-passes.weft} ---
      pass infrastructure: pass manager, iteration control,
      analysis caching.
\item \texttt{literate/optimization/35-peephole.weft} ---
      algebraic simplifications: constant folding, strength
      reduction, identity elimination (\texttt{x+0}, \texttt{x*1}).
\item \texttt{literate/optimization/36-dce.weft} ---
      dead code elimination: remove instructions whose results
      are never used, remove unreachable basic blocks.
\end{itemize}

\textbf{New tangled files.}
\texttt{ir.s}, \texttt{opt.s}.

\textbf{Acceptance.}
\begin{enumerate}
\item \texttt{tmp/kcc --dump-ir file.c} prints the IR in a
      readable textual format.
\item IR validation passes with no errors for all valid programs.
\item Constant expressions evaluate at compile time.
\item Dead stores and unused computations are eliminated.
\item The IR correctly models all C17 control flow, including
      \texttt{goto}, \texttt{switch} fall-through, and
      \texttt{setjmp}/\texttt{longjmp} (treated as opaque calls).
\end{enumerate}

\textbf{Status.} Complete (constant folding, DCE, pass manager;
\texttt{--dump-ir} flag).

% ────────────────────────────────────────────────────────────────
\section{Phase 7 --- ARM64 Backend}
\label{sec:phase7}

\textbf{Goal.}  Generate native ARM64 machine code and emit
Mach-O object files directly --- no external assembler needed.
This is the self-referential core: ARM64 assembly generating
ARM64 machine code.

\textbf{Strategy.}  Phase~7a uses a simplified \emph{stack-slot
allocator} where every virtual register lives on the stack.
Scratch registers \texttt{x9}, \texttt{x10}, \texttt{x11} shuttle
values between stack slots and ALU operations.  This produces
correct but suboptimal code quickly.  Phase~7b (future) will
introduce linear-scan register allocation.

\textbf{weft files.}
\begin{itemize}
\item \texttt{literate/backend/37-codegen.weft} ---
      IR-to-ARM64 lowering: stack-slot strategy, instruction
      dispatch for all IR opcodes (arithmetic, logical, compare,
      memory, branch, call, return), prologue/epilogue emission,
      BB label tracking, forward-branch patching.
\item \texttt{literate/backend/38-emit-arm64.weft} ---
      ARM64 instruction binary encoding: code buffer management,
      data processing (register and immediate forms), logical
      operations, compare and conditional select (CSINC),
      load/store (unsigned offset, STP/LDP), branch (B, BL,
      B.cond, CBZ, CBNZ, RET), ADRP/ADD pair for relocations.
\item \texttt{literate/backend/39-emit-macho.weft} ---
      Mach-O object file emission: header, load commands
      (\texttt{LC\_SEGMENT\_64}, \texttt{LC\_SYMTAB},
      \texttt{LC\_DYSYMTAB}), \texttt{\_\_text} section,
      symbol table (nlist\_64), string table, relocation
      entries (\texttt{ARM64\_RELOC\_BRANCH26}).
\item \texttt{literate/backend/40-linker-info.weft} ---
      relocation and symbol table management: add/lookup symbols,
      add relocations, extern deduplication.
\item \texttt{literate/driver/42-driver.weft} ---
      \texttt{-c} flag dispatch: pipeline orchestration from
      source through lex, parse, sema, IR, codegen, to Mach-O
      output.
\end{itemize}

\textbf{New tangled files.}
\texttt{codegen.s}, \texttt{emit\_arm64.s}, \texttt{emit\_macho.s},
\texttt{linker.s}, \texttt{driver.s}.

\textbf{Acceptance.}
\begin{enumerate}
\item \texttt{tmp/kcc -c file.c -o file.o} produces a valid
      Mach-O object file.
\item \texttt{ld file.o -o file -lSystem ...} links the object
      file into a working executable.
\item Generated code passes the C17 conformance test suite
      (integer arithmetic, control flow, function calls,
      structs, pointers, arrays).
\item Calling convention is correct: \kcc{}-compiled code can
      call system libraries and vice versa.
\item The object file is accepted by Apple's \texttt{ld} linker
      without warnings.
\end{enumerate}

\textbf{Status.} Complete.  All IR opcodes have codegen handlers;
constants, arithmetic, locals, control flow, loops, function calls,
global variables, break/continue, string literals, \texttt{printf},
bitwise/comparison/logical operators, pointers, cast, negation,
unsigned operations, and type extensions all compile, link, and run
correctly.  Valid Mach-O with \texttt{LC\_BUILD\_VERSION}.

\textbf{Completed milestones.}
\begin{itemize}
\item[\checkmark] Return constants, arithmetic, locals, \texttt{if}/\texttt{else}.
\item[\checkmark] \texttt{while}, \texttt{do}/\texttt{while}, \texttt{for} (with explicit \texttt{i = i + 1}).
\item[\checkmark] Function calls: multi-argument, variadic, external (\texttt{printf}).
\item[\checkmark] Global variables via \texttt{ADRP}+\texttt{ADD} relocation.
\item[\checkmark] String literals in \texttt{\_\_text} section with cstring fixups.
\item[\checkmark] Bitwise operators, comparisons, logical \texttt{\&\&}/\texttt{||}, unary \texttt{!}.
\item[\checkmark] Pointers (address-of, dereference), cast expressions, negation.
\item[\checkmark] Comma operator, \texttt{break}/\texttt{continue}, nested calls.
\item[\checkmark] Post/pre increment and decrement (\texttt{i++}, \texttt{++i},
      \texttt{i-{}-}, \texttt{-{}-i}): load-modify-store sequence for both
      locals and globals.
\item[\checkmark] Compound assignment operators (\texttt{+=}, \texttt{-=}, \texttt{*=},
      \texttt{/=}, etc.) for both local and global variables.
\item[\checkmark] Ternary operator (\texttt{?:}): alloca rendezvous pattern
      ensures both branches store to a shared slot; merge block loads the
      result.
\item[\checkmark] \texttt{switch}/\texttt{case}/\texttt{default}: three-pass
      lowering (create BBs, dispatch chain, bodies) with C fall-through
      semantics and \texttt{break} via the loop stack.
\item[\checkmark] \texttt{sizeof}: lowered to \texttt{IR\_CONST} with the
      operand type's \texttt{TY\_SIZE}; both type and expression forms
      supported.
\item[\checkmark] Arrays (\texttt{a[i]}): \texttt{IR\_ALLOCA} with slot
      count, \texttt{IR\_GEP} for address arithmetic, frame pre-scan for
      alloca storage layout.
\item[\checkmark] Structs (\texttt{s.x}): field-count alloca, field-index
      lookup via AST field chain walk, \texttt{IR\_GEP} for member access.
      Fixed sema to register struct tags from \texttt{AST\_TYPE\_STRUCT}
      wrappers and to look up tags for forward references.
\item[\checkmark] Multi-variable declarations (\texttt{int a=3, b=4;}):
      compound-statement appender now walks the \texttt{F4} tail of
      multi-declarator chains so that subsequent items link after the last
      declarator instead of overwriting the chain.
\item[\checkmark] \texttt{IR\_TRUNC} and \texttt{IR\_BITCAST}: codegen
      handlers for type-narrowing casts (mask to target width) and
      same-width reinterpretation.  Cast expressions in the IR builder
      now emit \texttt{IR\_TRUNC} when the target type is narrower
      than the source.
\item[\checkmark] Remaining IR opcodes: \texttt{IR\_UMOD} (unsigned
      modulo via \texttt{UDIV}+\texttt{MSUB}), \texttt{IR\_CMP\_ULT}
      and \texttt{IR\_CMP\_ULE} (unsigned comparisons via
      \texttt{CSET} with \texttt{LO}/\texttt{LS} conditions),
      \texttt{IR\_SEXT} (sign extension via hardcoded \texttt{SBFM}
      instruction words), \texttt{IR\_ZEXT} (zero extension via
      hardcoded \texttt{UBFM} instruction words).  The IR builder's
      binary handler remaps signed opcodes to unsigned variants when
      the left operand's type has \texttt{TY\_F0}=0.
\end{itemize}

% ────────────────────────────────────────────────────────────────
\section{Phase 8 --- Self-Hosting}
\label{sec:phase8}

\textbf{Goal.}  Demonstrate that \kcc{} can compile a
non-trivial C program --- ideally a C subset of itself or an
equivalent program --- and produce correct output.  This is the
ultimate proof that the compiler is correct and complete.

\textbf{Strategy.}  Phase~8 proceeds in three stages.  Stage~8a
fixes missing C features and hardens the backend by compiling
increasingly complex programs.  Stage~8b writes a C implementation
of a \kcc{} subsystem (the lexer or the arena allocator) and
compiles it with \kcc{} itself.  Stage~8c performs differential
testing against \texttt{clang} and, if feasible, a full bootstrap
where \kcc{} compiles a stage-1 C compiler that then compiles
itself.

\textbf{Acceptance.}
\begin{enumerate}
\item At least one non-trivial C program (${}>1000$ lines)
      compiles and runs correctly under \kcc{}.
\item Differential testing against \texttt{clang} reveals no
      behavioral discrepancies on conforming programs.
\item The \stdref{J.3} implementation-defined behavior document
      is complete (Appendix~A).
\item The UB policy matrix is complete (Appendix~B).
\item \texttt{just weave} produces a typeset document that
      serves as a comprehensive textbook on both compiler
      construction and ARM64 systems programming.
\end{enumerate}

\textbf{Status.}  Stage~8a in progress.  201 codegen tests passing.
The compiler handles integer arithmetic, control flow, loops,
function calls (direct and indirect), structs (nested, arrays),
pointers, pointer-to-pointer and arrays of pointers, arrays,
brace-enclosed array and struct initializers (local and file-scope),
static locals, global variables, enums, switch/case, sizeof, character
literals, string literals, void functions, forward-declared prototypes,
function pointers, the preprocessor on the \texttt{-c} path
(\texttt{\#define}, \texttt{\#ifdef}, and \texttt{\#include} of a
source-relative header), and multi-file compilation (several
translation units in one invocation, sharing functions and
\texttt{extern} globals across objects).  A 1{,}130-line C test suite compiles and runs correctly:
hash tables, arena allocators, recursive-descent parsers, linked-list
manipulation, tree evaluators, and the sieve of Eratosthenes.
Stage~8b has begun: \kcc{}'s own arena allocator, re-written in C and
compiled by \kcc{}, replaces the hand-written assembly arena in a
\texttt{kcc\_selfhost} binary that passes all 201 codegen tests
(Chapter~\ref{ch:self-hosting-arena}); and a 250-line C tokenizer,
compiled by \kcc{}, self-tests green and matches \texttt{clang}
(Chapter~\ref{ch:self-hosting-lexer}), a program whose size flushed out
two codegen bugs now fixed.

\textbf{Completed milestones.}
\begin{itemize}
\item[\checkmark] All-spill backend: every IR opcode has a
      codegen handler; valid Mach-O with \texttt{LC\_BUILD\_VERSION}.
\item[\checkmark] Pointer arithmetic: scale factor clamped to
      \texttt{max(TY\_SIZE, 8)} for the all-spill model.
\item[\checkmark] Struct support: nested struct access (recursive
      \texttt{build\_member\_addr}), struct arrays with correct
      \texttt{TY\_SIZE/8} alloca slots.
\item[\checkmark] Global initializers: emit \texttt{IR\_GLOBAL\_REF}
      + \texttt{IR\_STORE} at top of \texttt{main()} entry block.
\item[\checkmark] Local array decay: \texttt{build\_ident} detects
      arrays via bit-63 pointer tag + AST field check, returns
      alloca address without loading.
\item[\checkmark] Function pointers: grouped-declarator parsing
      \texttt{(*name)(params)}, \texttt{IR\_CALL\_IND} opcode with
      \texttt{BLR} emission, function-to-pointer decay, DCE marking,
      linker symbol precedence fix.
\item[\checkmark] Void functions, forward-declared prototypes,
      character literals, and pointer-to-pointer: verified end to end
      by direct compilation.  The \texttt{IR\_RET} handler already
      distinguishes \texttt{void}, prototypes are skipped by the IR
      builder, and multi-level indirection lowers correctly.
\item[\checkmark] Arrays of pointers (\texttt{int *a[N]},
      \texttt{char **argv}): the pointer-variable tag is now taken
      from the declared kind rather than the array element, so a
      pointer-array is indexed from its alloca base via GEP instead
      of being mis-lowered as a scalar pointer.
\item[\checkmark] Brace-enclosed initializer lists: positional
      \texttt{IR\_GEP$+$IR\_STORE} per element for both arrays and
      flat structs, implicit array bounds inferred from the element
      count, zero-fill of the unspecified tail, and file-scope lookup
      tables via \texttt{\_kcc\_ir\_emit\_global\_inits} (BSS supplies
      the zero image).  String initializers for char arrays and
      designated initializers remain for Phase~9.
\item[\checkmark] Static locals: hoisted to a per-declaration global
      named \texttt{sl\_}\meta{node address} by
      \texttt{\_kcc\_ir\_static\_name}, so no stack alloca is emitted.
      A per-function \texttt{statics} table redirects identifier and
      assignment references onto the mangled symbol (shadowing any
      like-named file-scope global), and a second pass in
      \texttt{\_kcc\_ir\_emit\_global\_inits} emits the one-time
      initialiser at program start.  Nested-block statics and static
      aggregates remain for Phase~9.
\item[\checkmark] Preprocessor on the \texttt{-c} path: object- and
      function-like \texttt{\#define}, \texttt{\#ifdef}/\texttt{\#ifndef}
      conditionals, and \texttt{\#include} of a quoted header resolved
      relative to the including file's directory (then the working
      directory).  \texttt{\_kcc\_sys\_open} was fixed to collapse the
      kernel's carry-flag \texttt{errno} to $-1$ so a missing header
      produces a clean diagnostic instead of crashing on a bogus
      descriptor.  A \texttt{-I} system search path is left to Phase~9.
\item[\checkmark] Multi-file compilation:
      \texttt{\_kcc\_driver\_compile} now returns a status so
      \texttt{\_kcc\_driver\_compile\_all} can loop it over every source
      argument, writing one object per input
      (\texttt{.c}$\to$\texttt{.o}).  \texttt{extern} data is honoured:
      an \texttt{extern} declaration reserves no storage, and a
      reference to a global not defined in the current unit is emitted
      as an undefined external symbol (via a \texttt{defined\_globals}
      set feeding the \texttt{IR\_GLOBAL\_REF} handler's choice between
      \texttt{linker\_global\_sym} and \texttt{linker\_extern}), so two
      objects can share a global without colliding.  Automatic linking
      (invoking \texttt{ld}) is left to Phase~9.
\item[\checkmark] 201 codegen tests covering all features
      (11 Phase~8 test groups: nested structs, struct arrays,
      global init, pointer arithmetic, pointer arrays, initializer
      lists, static locals, preprocessor, multi-file, self-hosting
      patterns, function pointers).
\end{itemize}

\textbf{Remaining work --- Stage 8a: missing C features.}

The following features are needed before \kcc{} can compile
a realistic subsystem of itself.

\begin{itemize}
\item \textbf{Typedef support.}  The parser recognizes
      \texttt{typedef} but codegen has not been stress-tested
      with typedef'd structs and function pointer types.
\item \textbf{String initializers for char arrays.}
      \texttt{char s[] = "abc"} must copy the literal bytes into the
      array rather than storing the string pointer.
\item \textbf{Automatic linking.}  \kcc{} now emits one object per
      source, but the resulting \texttt{.o} files are still handed to
      \texttt{ld} by the caller; invoking the linker from the driver is
      a Phase~9 convenience.
\end{itemize}

\noindent Pointer-to-pointer, arrays of pointers, void functions,
forward-declared prototypes, character literals, brace-enclosed
initializer lists (array and flat-struct, local and file-scope),
static locals, and multi-file compilation (multiple translation units
with shared \texttt{extern} data) were originally listed here; all are
now implemented and covered by the codegen suite (see the completed
milestones above).

\textbf{Stage 8b: subsystem in C.}

\begin{itemize}
\item[\checkmark] The \kcc{} arena allocator is re-implemented in C
      (Chapter~\ref{ch:self-hosting-arena}), a faithful port of the
      assembly arena of Chapter~\ref{ch:arena} with the same exported
      symbols and 24-byte chunk layout.
\item[\checkmark] \texttt{just selfhost} compiles it with \kcc{}
      (\texttt{kcc -c arena.c -o arena\_c.o}), relinks a
      \texttt{kcc\_selfhost} binary with the hand-written
      \texttt{arena.o} replaced by the C-compiled object, and runs the
      full code-generation suite against it.
\item[\checkmark] Behaviour is identical: \texttt{kcc\_selfhost} passes
      all 201 codegen tests, exercising the C arena's fast and slow
      paths across every allocation the compiler makes.  \kcc{} has
      compiled a correctness-critical piece of itself.
\item[\checkmark] A branch-heavy tokenizer in C
      (Chapter~\ref{ch:self-hosting-lexer}) is compiled by \kcc{},
      self-tests green, and agrees with \texttt{clang}
      (\texttt{just selfhost-lexer}).  Building it exposed and fixed two
      real codegen bugs a 250-line program reaches but the unit tests
      do not: the basic-block label table overflowed on large functions
      (fixed-size open-addressed hash $\to$ sized to the block count),
      and address-of assumed a bare identifier (\texttt{\&a[i]} now
      dispatches on operand shape).
\item Remaining: port more of the front-end and, eventually, compile
      enough of \kcc{} to bootstrap.
\end{itemize}

\textbf{Stage 8c: validation.}

\begin{itemize}
\item[\checkmark] Differential testing
      (Chapter~\ref{ch:differential-testing}, \texttt{just difftest}):
      a 97-program corpus is compiled by both \kcc{} and \texttt{clang},
      run freestanding, and compared with \texttt{clang} as the oracle.
      \kcc{} agrees on every program with zero miscompilations and no
      remaining expected divergence.  The sweep drove a string of
      fixes---function pointers in \texttt{struct} fields, 32-bit
      integer wraparound (\texttt{\_kcc\_ir\_norm32}), enumerators with
      explicit values, \texttt{sizeof} of a whole array, the comma
      operator in a \texttt{for} clause \emph{and} labels in a compound
      (two distinct callee-saved-register bugs, in \texttt{parse\_expr}
      and \texttt{parse\_stmt}), pointer difference, \texttt{goto}/labels
      lowered end to end (\S\ref{sec:ir-goto}), multi-dimensional
      arrays laid out flat with a recursive slot count
      (\texttt{\_kcc\_ir\_type\_slots}), and---last of the sweep's
      open constructs---\texttt{struct} return by value via a hidden
      result pointer (\S\ref{sec:struct-return}), which uncovered a
      latent \texttt{(void)}-parameter miscount along the way.  The
      harness needs no hand-computed expected values, so it scales to
      programs far more complex than the code-generation suite's.
\item Bootstrap test: write a minimal C compiler (or expression
      evaluator) in C, compile it with \kcc{}, then use it to
      compile itself.  Compare the two binaries.
\item Performance characterization: measure compilation speed
      and generated-code quality against \texttt{clang -O0}.
\item Appendix~A: \stdref{J.3} implementation-defined behavior.
\item Appendix~B: undefined-behavior policy matrix.
\end{itemize}

% ────────────────────────────────────────────────────────────────
\section{Phase 9 --- Production Compiler}
\label{sec:phase9}

\textbf{Goal.}  Elevate \kcc{} from a working subset compiler to a
conforming, efficient, and usable C17 implementation suitable for
compiling real-world programs.  Phase~8 proves correctness on a
significant codebase; Phase~9 fills every remaining gap in the
language, the ABI, the optimizer, and the tooling.

\textbf{Strategy.}  Phase~9 is divided into five stages, ordered by
impact.  Stage~9a completes the C17 type system (floating point,
unions, qualifiers).  Stage~9b makes the calling convention fully
ABI-compliant (struct-by-value, stack arguments, variadic definitions).
Stage~9c replaces the all-spill model with a real register allocator.
Stage~9d adds optimization passes that bring generated-code quality
within striking distance of \texttt{clang -O1}.  Stage~9e delivers
the tooling and diagnostics expected of a production compiler.

\subsection{Stage 9a --- Complete Type System}

The current backend handles integer types only.  This stage adds
every remaining C17 type.

\begin{itemize}
\item \textbf{Floating point.}  The type singletons (\texttt{TY\_FLOAT},
      \texttt{TY\_DOUBLE}, \texttt{TY\_LDOUBLE}) already exist in the
      type system but have no IR or codegen support.  Add IR opcodes
      \texttt{IR\_FADD}, \texttt{IR\_FSUB}, \texttt{IR\_FMUL},
      \texttt{IR\_FDIV}, \texttt{IR\_FCMP\_*}, \texttt{IR\_SITOFP},
      \texttt{IR\_FPTOSI}, \texttt{IR\_FPEXT}, \texttt{IR\_FPTRUNC}.
      Codegen uses NEON/FP registers \texttt{d0}--\texttt{d7} for
      arguments and \texttt{d8}--\texttt{d15} as callee-saved
      scratch.  Floating-point literals require a constant pool
      in the \texttt{\_\_text} section with \texttt{LDR} (literal)
      instructions.
\item \textbf{Unions.}  \texttt{TY\_UNION} is defined but never
      lowered.  The IR builder must treat unions like structs
      whose fields all start at offset~0; \texttt{TY\_SIZE} equals
      the largest member.  Codegen is identical to structs
      except that \texttt{IR\_GEP} stride is always~0 for member
      access.
\item \textbf{\_Bool.}  \texttt{TY\_BOOL} exists as a singleton.
      The IR builder must insert \texttt{IR\_TRUNC} to 1~bit on
      assignment (any non-zero value becomes~1) and
      \texttt{IR\_ZEXT} on promotion.
\item \textbf{Type qualifiers.}  \texttt{const} objects should
      land in \texttt{\_\_const} section.  \texttt{volatile} loads
      and stores must not be eliminated by DCE or reordered by
      future optimization passes.  \texttt{restrict} can be
      ignored initially (it is a hint, not a constraint).
\item \textbf{\_Alignof and \_Alignas.}  Lower \texttt{\_Alignof}
      to \texttt{IR\_CONST} with the type's alignment.
      \texttt{\_Alignas} adjusts alloca padding and
      \texttt{\_\_data}-section alignment.
\item \textbf{Designated initializers.}  Struct and array
      initializers with \texttt{.field = val} and
      \texttt{[index] = val} syntax, including nested
      designators.
\item \textbf{Compound literals.}  \texttt{(type)\{init\}}
      creates a temporary with block scope; lower to an
      anonymous alloca + initializer stores.
\item \textbf{\_Generic.}  Type-dispatch at compile time; the
      sema pass selects the matching association and replaces
      the \texttt{\_Generic} node with the selected expression.
\end{itemize}

\subsection{Stage 9b --- Full ABI Compliance}

The current calling convention passes at most~8 integer arguments
in \texttt{x0}--\texttt{x7} and ignores struct-by-value semantics.
This stage makes \kcc{} fully AAPCS64-compliant.

\begin{itemize}
\item \textbf{Stack arguments.}  When a function has more than~8
      integer or~8 floating-point arguments, excess arguments
      must be pushed to the stack in right-to-left order with
      natural alignment.
\item[\checkmark] \textbf{Struct return by value.}  Implemented
      (\S\ref{sec:struct-return}) with a \emph{hidden result pointer}:
      the caller allocates the destination and passes its address as
      a trailing argument; the callee copies the aggregate there and
      returns \texttt{void}.  Because \kcc{} lays every struct field
      in its own 8-byte slot, this one convention covers structs of
      any size uniformly (rather than packing ${\le}16$-byte structs
      into \texttt{x0}--\texttt{x1}), and it is self-consistent for
      \kcc{}-to-\kcc{} calls, which is all the corpus requires.  A
      later refinement can adopt the exact AAPCS64 register-packing
      and \texttt{x8} rules for interoperation with \texttt{clang}
      object files.
\item[\checkmark] \textbf{Struct pass by value.}  Implemented
      (\S\ref{sec:struct-args}) as the mirror image of struct return:
      the caller passes the \emph{address} of the argument object in a
      single register (via \texttt{\_kcc\_ir\_build\_struct\_addr}) and
      the callee's \texttt{build\_param} copies the $N$ slots into its
      own parameter storage, giving true by-value semantics.  Each
      struct argument consumes one register, so this composes with the
      hidden result pointer and with scalar arguments.  As with the
      return path, this is the uniform all-spill convention rather than
      AAPCS64's ${\le}16$-byte register packing; adopting the exact
      register/stack rules is deferred to \texttt{clang}-interop work.
\item \textbf{Variadic function definitions.}  The current
      compiler can \emph{call} variadic functions (\texttt{printf})
      but cannot \emph{define} them.  Implement
      \texttt{va\_list}/\texttt{va\_start}/\texttt{va\_arg}/\texttt{va\_end}
      as compiler builtins that manage the register save area
      on the stack (AAPCS64~\S{}9.2).
\item \textbf{Correct struct member alignment.}  Padding bytes
      between struct members must match the AAPCS64 alignment
      rules.  The type constructor must compute correct
      \texttt{TY\_SIZE} with padding, and \texttt{IR\_GEP}
      offsets must account for alignment gaps.
\end{itemize}

\subsection{Stage 9c --- Register Allocation}

The all-spill model generates roughly $3\times$ as many
load/store instructions as necessary.  This stage introduces
register allocation to eliminate redundant memory traffic.

\begin{itemize}
\item \textbf{Liveness analysis.}  Compute live-in and live-out
      sets for each basic block using iterative dataflow.
      Build per-vreg live intervals from the BB-level results.
\item \textbf{Linear-scan allocator.}  Assign physical registers
      (\texttt{x9}--\texttt{x15}, \texttt{x19}--\texttt{x28},
      \texttt{d0}--\texttt{d31}) to vregs based on sorted
      live intervals.  Spill the vreg with the longest remaining
      interval when registers are exhausted.
\item \textbf{Spill code insertion.}  Spilled vregs get stack
      slots; insert loads before uses and stores after defs.
      Coalesce adjacent load/store pairs where possible.
\item \textbf{Callee-saved management.}  The prologue/epilogue
      must save and restore only the callee-saved registers
      that the function actually uses, shrinking stack frames.
\item \textbf{FP register allocation.}  Floating-point vregs
      compete for \texttt{d8}--\texttt{d15} (callee-saved) and
      \texttt{d16}--\texttt{d31} (caller-saved).
\end{itemize}

\subsection{Stage 9d --- Optimization}

Phase~6 provides constant folding and dead code elimination.
This stage adds passes that substantially improve code quality.

\begin{itemize}
\item \textbf{Common subexpression elimination (CSE).}  Hash
      each instruction's opcode + operands; reuse an existing
      vreg instead of recomputing an identical value.
\item \textbf{Copy propagation.}  Replace uses of
      \texttt{IR\_LOAD} with the original vreg when the address
      has not been stored to since the load.
\item \textbf{Strength reduction.}  Convert multiplications by
      powers of two into shifts; convert divisions by constants
      into multiply-high sequences.
\item \textbf{Basic-block reordering.}  Place fall-through
      successors physically after their predecessors to
      eliminate unconditional branches.
\item \textbf{Instruction combining.}  Fuse
      \texttt{CMP}+\texttt{B.cond} into \texttt{CBZ}/\texttt{CBNZ}
      where possible; fold \texttt{ADD}+\texttt{LDR} into
      addressing modes.
\item \textbf{Tail-call optimization.}  Replace
      \texttt{BL}+\texttt{RET} with \texttt{B} when the callee's
      frame is compatible.
\item \textbf{Loop-invariant code motion (LICM).}  Hoist
      instructions whose operands do not change inside a loop
      to the loop's preheader block.
\end{itemize}

\subsection{Stage 9e --- Tooling and Diagnostics}

A production compiler needs more than correct code generation.

\begin{itemize}
\item \textbf{DWARF debug information.}  Emit
      \texttt{\_\_debug\_info}, \texttt{\_\_debug\_line},
      \texttt{\_\_debug\_abbrev}, and \texttt{\_\_debug\_str}
      sections so that \texttt{lldb} can set breakpoints,
      inspect variables, and show source locations.
\item \textbf{Warning system.}  Implement at least
      \texttt{-Wall}-equivalent diagnostics: unused variables,
      implicit int conversions, missing return statements,
      unreachable code, shadowed declarations, comparison of
      signed and unsigned.
\item \textbf{Error recovery.}  The parser currently aborts on
      the first error.  Add synchronization-point recovery
      (skip to next \texttt{;} or \texttt{\}}) to report
      multiple errors per compilation.
\item \textbf{Command-line interface.}  Full flag parsing:
      \texttt{-O0}/\texttt{-O1}/\texttt{-O2} (controls which
      optimization passes run), \texttt{-Wall}/\texttt{-Werror},
      \texttt{-I path} (include search path),
      \texttt{-D name=val} (command-line defines),
      \texttt{-S} (emit assembly text), \texttt{-E} (preprocess
      only, already implemented), \texttt{-o output}.
\item \textbf{Automatic linking.}  When invoked without
      \texttt{-c}, the driver should compile to a temporary
      \texttt{.o} and invoke \texttt{ld} to produce an
      executable, eliminating the manual link step.
\item \textbf{System header compatibility.}  Handle
      \texttt{\#include <stdio.h>} by providing a minimal
      freestanding header set or by parsing Apple SDK headers
      (requires attribute and extension tolerance).
\item \textbf{Source-level profiling.}  Instrument function
      entry/exit for \texttt{-pg}-style profiling or basic
      timing output.
\end{itemize}

\textbf{Acceptance.}
\begin{enumerate}
\item The full C17 type system is implemented: floating point,
      unions, \_Bool, qualifiers, \_Generic.
\item The calling convention matches AAPCS64: struct-by-value,
      stack arguments, variadic definitions all work.
\item Register allocation reduces code size by at least
      $2\times$ compared to the all-spill baseline.
\item \texttt{lldb} can debug \kcc{}-compiled programs with
      source-level breakpoints and variable inspection.
\item The compiler accepts at least two \texttt{-O} levels and
      produces measurably better code at \texttt{-O1} vs
      \texttt{-O0}.
\item \texttt{tmp/kcc hello.c -o hello} compiles, links, and
      runs without a manual \texttt{ld} invocation.
\item \kcc{} compiles a subset of its own source or an
      equivalent-complexity program ($>5000$ lines of C)
      and produces a correct, debuggable executable.
\end{enumerate}

