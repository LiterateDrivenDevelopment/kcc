% assembly.weft — Output Routing
%
% This file contains all output directives for kcc.  It is the single
% point that maps logical code fragments to physical assembly files.
%
% When adding a new .s file to kcc, add its output directive HERE.
% Fragment definitions go in the appropriate chapter .weft file.

\chapter*{Output Routing}
\addcontentsline{toc}{chapter}{Output Routing}

The following output directives route code fragments to their
physical assembly files under \texttt{tmp/src/}.

\bigskip

\noindent\textbf{main.s} --- the compiler entry point:

@o tmp/src/main.s @{
@<ARM64: common macros@>
@<Main: entry point@>
@<Main: data@>
@}

\noindent\textbf{syscalls.s} --- macOS system call wrappers:

@o tmp/src/syscalls.s @{
@<ARM64: common macros@>
@<Syscall: constants@>
@<Syscall: exit@>
@<Syscall: write@>
@<Syscall: read@>
@<Syscall: open@>
@<Syscall: close@>
@<Syscall: mmap@>
@<Syscall: lseek@>
@}

\noindent\textbf{arena.s} --- arena memory allocator:

@o tmp/src/arena.s @{
@<ARM64: common macros@>
@<Syscall: constants@>
@<Arena: constants@>
@<Arena: init@>
@<Arena: alloc fast path@>
@<Arena: alloc slow path@>
@<Arena: data@>
@}

\noindent\textbf{strings.s} --- string and memory operations:

@o tmp/src/strings.s @{
@<ARM64: common macros@>
@<String: strlen@>
@<String: memcpy@>
@<String: memcmp@>
@<String: memset@>
@<String: strcmp@>
@}

