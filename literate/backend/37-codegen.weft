% 37-codegen.weft — IR to ARM64 Code Generation
%
% This chapter implements the core code generator.  It walks the IR
% produced by the frontend and emits ARM64 machine code using the
% ``all-spill'' strategy: every virtual register is assigned a stack
% slot.  Instructions load sources into scratch registers (x9, x10),
% compute the result in x11, and store it back.  This produces correct
% (if unoptimized) code and allows us to get a working compiler before
% implementing register allocation.

\chapter{Code Generation}
\label{ch:codegen}

This chapter is where the compiler's abstract IR meets the target machine.  The code generator walks each IR function and emits ARM64 machine code using a simple ``all-spill'' strategy: every virtual register is assigned a stack slot, and each instruction loads its sources from the stack into scratch registers (x9, x10), computes the result in x11, and stores it back.  This avoids the complexity of register allocation while producing correct code.  The chapter covers the stack-frame layout, initialization of the cstring buffer for string literals, the main instruction-lowering loop, and the post-codegen fixup pass that patches string-literal symbol values.

\section{Strategy}

The stack frame for a generated function has three regions:
\begin{verbatim}
  [x29+0]               saved x29/x30 (16 bytes)
  [x29+16]              vreg value slots (vreg_count * 8)
  [x29+16+vc*8]         alloca storage  (total_alloca_slots * 8)
\end{verbatim}

The total frame size is
$\mathit{align16}(16 + \text{vreg\_count}\times 8
+ \text{alloca\_slots}\times 8)$.
A pre-scan pass walks all \texttt{IR\_ALLOCA} instructions before
code generation, sums their slot counts, and assigns each alloca a
running offset (stored in \texttt{SRC2}).  This lets
\texttt{IR\_ALLOCA} compute its storage address at emit time
and ensures alloca storage does not overlap vreg slots.
We use x9 for source~1, x10 for source~2, x11 as the destination
scratch register, and x12 as an additional scratch for
\texttt{IR\_GEP} address arithmetic.

\section{Constants}

The code generator's fixed parameters---slot size, scratch register assignments, and patch-entry layout---are defined here as assembler equates so they can be referenced symbolically throughout the backend.

@d CodeGen: constants @{
// -- CodeGen constants --------------------------------------------------------
.equ CG_SLOT_SIZE,   8           // each vreg occupies 8 bytes on stack
.equ CG_REG_SRC1,   9           // x9 = first source scratch
.equ CG_REG_SRC2,  10           // x10 = second source scratch
.equ CG_REG_DST,   11           // x11 = destination scratch

// Forward-branch patch entry: {code_offset(8), target_bb_id(8)} = 16 bytes
.equ PATCH_OFFSET,   0
.equ PATCH_TARGET,   8
.equ PATCH_SIZE,    16
@}

\section{Initialization}

Initialization zeroes the frame-size state and prepares the
infrastructure for string literals.  We allocate a 4\,KB
\emph{cstring buffer} where literal bytes will accumulate during
code generation, a counter for naming symbols
(\texttt{l\_.str.0}, \texttt{l\_.str.1}, \ldots), and a
\emph{fixup vector} whose elements are pairs
$(\mathit{sym\_index}, \mathit{cstr\_offset})$.  After all
instructions have been lowered, the fixup pass
(\S\ref{sec:emit-strings}) patches each symbol's value and
appends the raw string data to the code section.

@d CodeGen: init @{
// -- kcc_codegen_init ---------------------------------------------------------
.text
.globl _kcc_codegen_init
.p2align 2
_kcc_codegen_init:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    // Zero state
    adrp x0, _kcc_cg_frame_size@@PAGE
    add  x0, x0, _kcc_cg_frame_size@@PAGEOFF
    str xzr, [x0]

    // Allocate cstring buffer (4KB initial)
    mov x0, #4096
    bl _kcc_arena_alloc
    adrp x1, _kcc_cstr_buf@@PAGE
    add  x1, x1, _kcc_cstr_buf@@PAGEOFF
    str x0, [x1]

    adrp x1, _kcc_cstr_pos@@PAGE
    add  x1, x1, _kcc_cstr_pos@@PAGEOFF
    str xzr, [x1]

    adrp x1, _kcc_cstr_count@@PAGE
    add  x1, x1, _kcc_cstr_count@@PAGEOFF
    str xzr, [x1]

    // Allocate fixup vec (elem=16: {sym_index, cstr_offset})
    mov x0, #VEC_SIZE
    bl _kcc_arena_alloc
    adrp x1, _kcc_cstr_fixups@@PAGE
    add  x1, x1, _kcc_cstr_fixups@@PAGEOFF
    str x0, [x1]
    mov x1, #16
    str x1, [x0, #VEC_ELEMSIZE]
    mov x1, #32
    str x1, [x0, #VEC_CAP]
    str xzr, [x0, #VEC_COUNT]
    mov x19, x0

    mov x0, #512                   // 32 * 16
    bl _kcc_arena_alloc
    str x0, [x19, #VEC_DATA]

    // Fresh set of globals defined in this translation unit
    mov x0, #32
    bl _kcc_ht_init
    adrp x1, _kcc_cg_defined_globals@@PAGE
    add  x1, x1, _kcc_cg_defined_globals@@PAGEOFF
    str x0, [x1]

    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_codegen_init
@}

\section{Pre-register Global Sizes}
\label{sec:preregister-globals}

Before code generation begins, the driver calls
\texttt{kcc\_preregister\_globals} to walk the AST translation unit and
pre-register every global variable in the linker with its correct
allocation size.  Scalar and pointer globals need eight bytes, while
struct globals need $n \times 8$ bytes (one eight-byte slot per field).
Because \texttt{kcc\_linker\_global\_sym} deduplicates---returning
immediately when a symbol is already defined---subsequent references
during code generation are no-ops with respect to allocation.

A global declared \texttt{extern} is a \emph{declaration}, not a
definition: its storage lives in another translation unit, so this pass
skips it and reserves no bytes.  The names it does define are recorded
in a per-unit \texttt{defined\_globals} set.  This set is what lets the
\texttt{IR\_GLOBAL\_REF} handler decide, for each reference, between a
locally defined symbol and an undefined external one: a name absent
from the set is emitted through \texttt{kcc\_linker\_extern} so the
linker resolves it against whichever object supplies the definition.
Without the set, every reference would define its own copy and two
objects naming the same global would collide.

@d CodeGen: preregister globals @{
// -- kcc_preregister_globals --------------------------------------------------
// void kcc_preregister_globals(node *trans_unit)
//   x0 = AST_TRANS_UNIT node
// Walks top-level variable declarations, resolves their types, and
// pre-registers each global with the linker at the correct byte size.
.text
.globl _kcc_preregister_globals
.p2align 2
_kcc_preregister_globals:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    str x23, [sp, #48]

    ldr x23, [x0, #AST_F0]      // first declaration (kept for the static pass)
    mov x19, x23

.Lprg_loop:
    cbz x19, .Lprg_statics

    ldr x0, [x19, #AST_TAG]
    cmp x0, #AST_VAR_DECL
    b.ne .Lprg_next

    ldr x20, [x19, #AST_F1]     // name
    cbz x20, .Lprg_next

    // extern globals are declarations, not definitions: emit no storage
    ldr x0, [x19, #AST_F3]      // storage class (2 = extern)
    cmp x0, #2
    b.eq .Lprg_next

    // Resolve the declared type
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_resolve_type
    cbz x0, .Lprg_next

    // For arrays, each element needs max(elem_size, 8) bytes
    // to match the all-spill model's 8-byte slot minimum.
    ldr x1, [x0, #TY_KIND]
    cmp x1, #TY_ARRAY
    b.ne .Lprg_scalar_size

    ldr x21, [x0, #TY_F1]      // array length
    ldr x0, [x0, #TY_F0]       // element type
    ldr x1, [x0, #TY_SIZE]     // element size
    mov x2, #8
    cmp x1, x2
    csel x1, x1, x2, ge        // max(elem_size, 8)
    mul x21, x21, x1
    b .Lprg_have_size

.Lprg_scalar_size:
    ldr x21, [x0, #TY_SIZE]
    cmp x21, #8
    b.ge .Lprg_have_size
    mov x21, #8
.Lprg_have_size:

    // Build "_" + name
    mov x0, x20
    bl _kcc_strlen
    add x0, x0, #2
    bl _kcc_arena_alloc
    mov x22, x0
    mov w1, #'_'
    strb w1, [x22]
    mov x0, x20
    bl _kcc_strlen
    add x2, x0, #1
    add x0, x22, #1
    mov x1, x20
    bl _kcc_memcpy

    mov x0, x22
    mov x1, x21
    bl _kcc_linker_global_sym

    // Remember the source name as defined-in-this-TU
    mov x0, x20
    bl _kcc_strlen
    mov x2, x0                   // keylen
    adrp x0, _kcc_cg_defined_globals@@PAGE
    add  x0, x0, _kcc_cg_defined_globals@@PAGEOFF
    ldr x0, [x0]
    mov x1, x20                  // key = source name
    mov x3, #1                   // present
    bl _kcc_ht_put

.Lprg_next:
    ldr x19, [x19, #AST_F4]     // next sibling
    b .Lprg_loop

.Lprg_statics:
    // Second pass: static locals are defined here too, under their mangled
    // names.  Record each so IR_GLOBAL_REF treats it as locally defined.
    mov x19, x23
.Lprg_fn_loop:
    cbz x19, .Lprg_done
    ldr x0, [x19, #AST_TAG]
    cmp x0, #AST_FUNC_DECL
    b.ne .Lprg_fn_next
    ldr x0, [x19, #AST_F3]      // function body
    cbz x0, .Lprg_fn_next
    ldr x20, [x0, #AST_F0]      // first body statement
.Lprg_st_loop:
    cbz x20, .Lprg_fn_next
    ldr x0, [x20, #AST_TAG]
    cmp x0, #AST_VAR_DECL
    b.ne .Lprg_st_next
    ldr x0, [x20, #AST_F3]      // storage class (3 = static)
    cmp x0, #3
    b.ne .Lprg_st_next

    mov x0, x20
    bl _kcc_ir_static_name
    mov x21, x0                  // mangled name
    bl _kcc_strlen
    mov x2, x0                   // keylen
    adrp x0, _kcc_cg_defined_globals@@PAGE
    add  x0, x0, _kcc_cg_defined_globals@@PAGEOFF
    ldr x0, [x0]
    mov x1, x21                  // key = mangled name
    mov x3, #1
    bl _kcc_ht_put

.Lprg_st_next:
    ldr x20, [x20, #AST_F4]
    b .Lprg_st_loop
.Lprg_fn_next:
    ldr x19, [x19, #AST_F4]
    b .Lprg_fn_loop

.Lprg_done:
    ldr x23, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@| _kcc_preregister_globals
@}

\section{Compile All Functions}

The top-level entry point iterates the IR function vector and calls
\texttt{kcc\_codegen\_func} for each one.  After this loop completes,
the code buffer contains the machine code for every function but
string literal data has not yet been appended---that is a separate
finalization step (\S\ref{sec:emit-strings}).

@d CodeGen: compile all @{
// -- kcc_codegen_all ----------------------------------------------------------
// void kcc_codegen_all(void)
// Iterates all IR functions and generates code for each.
.text
.globl _kcc_codegen_all
.p2align 2
_kcc_codegen_all:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    // Get IR functions vec
    adrp x0, _kcc_ir_funcs@@PAGE
    add  x0, x0, _kcc_ir_funcs@@PAGEOFF
    ldr x0, [x0]
    cbz x0, .Lcga_done

    ldr x19, [x0, #VEC_COUNT]     // number of functions
    mov x20, #0                    // index

.Lcga_loop:
    cmp x20, x19
    b.ge .Lcga_done

    // Get function pointer: vec_get(funcs_vec, index)
    adrp x0, _kcc_ir_funcs@@PAGE
    add  x0, x0, _kcc_ir_funcs@@PAGEOFF
    ldr x0, [x0]
    mov x1, x20
    bl _kcc_vec_get
    ldr x0, [x0]                  // dereference: vec stores pointers

    bl _kcc_codegen_func

    add x20, x20, #1
    b .Lcga_loop

.Lcga_done:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_codegen_all
@}

\section{Compile Function}

Compiling one IR function proceeds in nine steps:
\begin{enumerate}
\item \textbf{Frame size.}  Pre-scan all \texttt{IR\_ALLOCA}
      instructions, sum their slot counts, then compute
      $\mathrm{align16}(16 + \mathit{vreg\_count} \times 8
      + \mathit{alloca\_slots} \times 8)$.
\item \textbf{Function start.}  Record the current code-buffer
      offset so the linker symbol gets the correct value.
\item \textbf{BB label table.}  Allocate a hash table that maps
      BB~IDs to code offsets, used by branch instructions.  The table
      is open-addressed and never resizes, so it must be sized to the
      function up front: its capacity is the next power of two at or
      above four times the block count (never below~64).  A fixed
      capacity would spin forever in \texttt{ht\_put} once a large
      function---a real tokenizer's \texttt{lex\_next}, say---exceeded
      it; sizing to the block count keeps the load factor low and the
      insertion loop bounded.
\item \textbf{Patch vector.}  A vector of
      $(\mathit{code\_offset}, \mathit{target\_bb\_id})$ pairs
      for forward branches that need back-patching.
\item \textbf{Prologue.}  For small frames ($\leq 504$ bytes),
      emit \texttt{STP\;x29,\;x30,\;[sp,\;\#-frame\_size]!};
      for larger frames, emit \texttt{SUB\;sp,\;sp,\;\#frame\_size}
      followed by \texttt{STP\;x29,\;x30,\;[sp]} using the
      signed-offset form, because the signed 7-bit \textsc{stp}/\textsc{ldp}
      immediate (scaled by~8) only covers $-512$
      to~$+504$; the epilogue's positive post-index hits the
      limit first.  Both paths finish with \texttt{MOV\;x29,\;sp}.
\item \textbf{Store arguments.}  Copy \texttt{x0}--\texttt{x7}
      to their corresponding vreg stack slots.
\item \textbf{Walk BBs.}  For each basic block, record its label
      offset in the hash table, then generate code for each
      instruction.
\item \textbf{Patch.}  Resolve all forward branch placeholders.
\item \textbf{Symbol.}  Register the function as a defined
      \texttt{N\_SECT\textbar N\_EXT} symbol with the Mach-O
      underscore prefix.
\end{enumerate}

@d CodeGen: compile function @{
// -- kcc_codegen_func ---------------------------------------------------------
// void kcc_codegen_func(ir_func *func)
//   x0 = pointer to IR function
.text
.globl _kcc_codegen_func
.p2align 2
_kcc_codegen_func:
    stp x29, x30, [sp, #-112]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    stp x25, x26, [sp, #64]
    stp x27, x28, [sp, #80]

    mov x19, x0                    // x19 = ir_func

    // 1. Compute frame size via alloca pre-scan.
    //    Value slots: vreg_count * 8 (one 8-byte slot per vreg).
    //    Alloca storage: sum of all IR_ALLOCA.SRC1 values * 8.
    //    Each alloca records its running offset in SRC2.
    ldr x20, [x19, #IRF_VREG_N]   // vreg_count (temporary)

    // Pre-scan: walk all BBs/instructions, find allocas, assign offsets
    mov x0, #0                     // running alloca slot offset
    ldr x1, [x19, #IRF_BLOCKS]    // blocks vec
    ldr x2, [x1, #VEC_COUNT]      // num BBs
    mov x3, #0                     // BB index
.Lcgf_alloca_scan_bb:
    cmp x3, x2
    b.ge .Lcgf_alloca_scan_done
    // save loop state to stack temp area [sp, #96..104]
    str x0, [sp, #96]
    str x2, [sp, #104]
    stp x1, x3, [sp, #88]         // x1=blocks_vec, x3=bb_idx overlapping — use 88,96 is taken
    // Actually use dedicated temp save
    stp x3, x2, [sp, #88]         // save bb_idx, bb_count
    str x0, [sp, #104]            // save running offset
    mov x0, x1                     // blocks vec
    mov x1, x3                     // index
    bl _kcc_vec_get
    ldr x4, [x0]                   // x4 = BB ptr
    ldr x4, [x4, #BB_FIRST]       // first instr
.Lcgf_alloca_scan_instr:
    cbz x4, .Lcgf_alloca_scan_next_bb
    ldr x5, [x4, #IR_OP]
    cmp x5, #IR_ALLOCA
    b.ne .Lcgf_alloca_scan_skip
    // Found alloca: store running offset in SRC2, advance by SRC1
    ldr x0, [sp, #104]            // running offset
    str x0, [x4, #IR_SRC2]        // record offset for this alloca
    ldr x5, [x4, #IR_SRC1]        // slot count
    cbz x5, .Lcgf_alloca_one
    add x0, x0, x5                // advance by slot count
    b .Lcgf_alloca_save
.Lcgf_alloca_one:
    add x0, x0, #1                // default: 1 slot
.Lcgf_alloca_save:
    str x0, [sp, #104]
.Lcgf_alloca_scan_skip:
    ldr x4, [x4, #IR_NEXT]
    b .Lcgf_alloca_scan_instr
.Lcgf_alloca_scan_next_bb:
    ldp x3, x2, [sp, #88]         // restore bb_idx, bb_count
    ldr x0, [sp, #104]            // running offset
    ldr x1, [x19, #IRF_BLOCKS]    // blocks vec (reload)
    add x3, x3, #1
    b .Lcgf_alloca_scan_bb
.Lcgf_alloca_scan_done:
    // x0 = total alloca slots, x20 = vreg_count
    // frame_size = align16(16 + vreg_count*8 + total_alloca*8)
    lsl x1, x20, #3               // vreg_count * 8
    lsl x0, x0, #3                // total_alloca_slots * 8
    add x0, x0, x1                 // + vreg value slots
    add x0, x0, #16                // + fp/lr
    add x0, x0, #15
    and x0, x0, #~15              // align to 16
    mov x20, x0                    // x20 = frame_size

    adrp x1, _kcc_cg_frame_size@@PAGE
    add  x1, x1, _kcc_cg_frame_size@@PAGEOFF
    str x20, [x1]

    // Store vreg_count for alloca address computation
    ldr x0, [x19, #IRF_VREG_N]
    adrp x1, _kcc_cg_vreg_count@@PAGE
    add  x1, x1, _kcc_cg_vreg_count@@PAGEOFF
    str x0, [x1]

    // 2. Record function start offset
    bl _kcc_code_current_pos
    mov x21, x0                    // x21 = func_start_offset

    // 3. Initialize BB label hash table (bb_id → code_offset), sized to
    //    the function's BB count: next power of two >= 4*bb_count, min 64.
    ldr x0, [x19, #IRF_BLOCKS]
    ldr x0, [x0, #VEC_COUNT]      // bb_count
    lsl x0, x0, #2                // 4 * bb_count (keeps load factor low)
    cmp x0, #64
    b.ls .Lcgf_bbcap_min
    sub x0, x0, #1
    clz x1, x0
    mov x2, #64
    sub x1, x2, x1                // 64 - clz(x-1)
    mov x2, #1
    lsl x0, x2, x1               // next power of two
    b .Lcgf_bbcap_done
.Lcgf_bbcap_min:
    mov x0, #64
.Lcgf_bbcap_done:
    bl _kcc_ht_init
    mov x22, x0                    // x22 = bb_labels ht

    // 4. Initialize forward-branch patch vec
    mov x0, #VEC_SIZE
    bl _kcc_arena_alloc
    mov x23, x0                    // x23 = patch vec
    mov x1, #PATCH_SIZE
    str x1, [x23, #VEC_ELEMSIZE]
    mov x1, #32
    str x1, [x23, #VEC_CAP]
    str xzr, [x23, #VEC_COUNT]

    mov x0, #512                   // 32 * 16
    bl _kcc_arena_alloc
    str x0, [x23, #VEC_DATA]

    // 5. Emit prologue
    cmp x20, #504
    b.hi .Lcgf_large_prologue

    // Small frame: stp x29, x30, [sp, #-frame_size]!
    mov x0, #29
    mov x1, #30
    mov x2, #31
    neg x3, x20
    asr x3, x3, #3
    bl _kcc_enc_stp_pre
    bl _kcc_code_emit32
    b .Lcgf_prologue_mov

.Lcgf_large_prologue:
    // Large frame: sub sp, sp, #frame_size  then  stp x29, x30, [sp]
    mov x0, #31                    // rd = sp
    mov x1, #31                    // rn = sp
    mov x2, x20                   // imm12 = frame_size
    mov x3, #1                    // sf = 64-bit
    bl _kcc_enc_sub_imm
    bl _kcc_code_emit32
    // stp x29, x30, [sp, #0] — signed-offset form: 0xA9007BFD
    movz w0, #0x7BFD
    movk w0, #0xA900, lsl #16
    bl _kcc_code_emit32

.Lcgf_prologue_mov:
    // mov x29, sp → ADD x29, sp, #0
    mov x0, #29
    mov x1, #31
    mov x2, #0
    mov x3, #1
    bl _kcc_enc_add_imm
    bl _kcc_code_emit32
@| _kcc_codegen_func
@}

\paragraph{Storing Register Arguments}
After the prologue, the compiler copies each register argument
(\texttt{x0}--\texttt{x7}) into its corresponding vreg stack slot.
The ARM64 calling convention passes the first eight integer
arguments in registers, so parameter~$k$ lands in register~$k$ and
must be spilled to \texttt{[x29,\;\#16\;+\;k\,*\,8]}.  The scaled
immediate for the unsigned-offset \textsc{str} is simply
$k + 2$, reusing the same slot-offset formula as the rest of the
all-spill backend.

@d CodeGen: compile function @{
    // 6. Store arguments (x0-x7) to their vreg stack slots
    ldr x24, [x19, #IRF_PARAMS]   // param count
    mov x25, #0                    // param index

.Lcgf_store_args:
    cmp x25, x24
    b.ge .Lcgf_walk_bbs
    cmp x25, #8
    b.ge .Lcgf_walk_bbs           // max 8 register args

    // STR x<param>, [x29, #slot_offset(param)]
    // slot_offset(vreg) = -(16 + vreg*8) but for unsigned offset STR
    // we need positive offset from sp. Actually with frame pointer:
    // sp = x29 - frame_size + 16? No.
    // After prologue: x29 = sp, and sp was decremented by frame_size.
    // So x29 points to the OLD sp - frame_size.
    // Stored fp/lr are at [x29, #0] and [x29, #8].
    // vreg N is at [x29, #16 + N*8] ... wait no.
    //
    // Let's use: vreg N at [sp, #16 + N*8]
    // Since x29 == sp after prologue, this is [x29, #16 + N*8]
    // Frame layout:
    //   [x29+0]: saved x29 (old fp)
    //   [x29+8]: saved x30 (lr)
    //   [x29+16]: vreg 0
    //   [x29+24]: vreg 1
    //   ...
    //   [x29+16+N*8]: vreg N

    // Encode STR: rt=param_reg, rn=29(x29), imm12_scaled=(16+param*8)/8
    mov x0, x25                    // rt = x<param_index>
    mov x1, #29                    // rn = x29
    add x2, x25, #2               // imm12_scaled = (16 + param*8)/8 = param + 2
    mov x3, #1                     // size = 64-bit
    bl _kcc_enc_str_imm
    bl _kcc_code_emit32

    add x25, x25, #1
    b .Lcgf_store_args
@}

\paragraph{Walking Basic Blocks}
With the prologue in place and arguments spilled, the compiler
enters the main loop over basic blocks.  For each BB it records
the current code-buffer offset in the label hash table (keyed by
BB~ID) so that backward branches can compute their displacement
immediately.  It then walks the linked list of IR instructions
and delegates each one to \texttt{kcc\_codegen\_instr}, passing
the label table and patch vector as context.

@d CodeGen: compile function @{
.Lcgf_walk_bbs:
    // 7. Walk all BBs: get blocks vec from function
    ldr x24, [x19, #IRF_BLOCKS]   // blocks vec
    ldr x25, [x24, #VEC_COUNT]    // number of BBs
    mov x26, #0                    // BB index

.Lcgf_bb_loop:
    cmp x26, x25
    b.ge .Lcgf_patch

    // Get BB pointer
    mov x0, x24
    mov x1, x26
    bl _kcc_vec_get
    ldr x27, [x0]                  // x27 = current BB

    // Record BB label: bb_id → current code offset
    // Allocate persistent key buffer (8 bytes) so ht stores a unique pointer
    // (All entries must have distinct key pointers for memcmp during lookup)
    mov x0, #8
    bl _kcc_arena_alloc
    mov x28, x0                    // x28 = persistent key buffer
    ldr x1, [x27, #BB_ID]
    str x1, [x28]                  // store bb_id in arena-allocated memory

    // ht_put(bb_labels, key_ptr, 8, code_offset+1)
    bl _kcc_code_current_pos
    add x3, x0, #1                // value = offset + 1 (distinguish from 0)
    mov x0, x22                    // ht
    mov x1, x28                    // key = arena-allocated pointer to bb_id
    mov x2, #8                     // keylen = 8 bytes
    bl _kcc_ht_put

    // Walk instructions in this BB
    ldr x27, [x27, #BB_FIRST]     // first instruction

.Lcgf_instr_loop:
    cbz x27, .Lcgf_next_bb

    // Generate code for this instruction
    mov x0, x27                    // instruction
    mov x1, x22                    // bb_labels ht
    mov x2, x23                    // patch vec
    bl _kcc_codegen_instr

    // Next instruction
    ldr x27, [x27, #IR_NEXT]
    b .Lcgf_instr_loop

.Lcgf_next_bb:
    add x26, x26, #1
    b .Lcgf_bb_loop
@}

\paragraph{Patching Forward Branches and Registering the Symbol}
Once every basic block has been lowered, two bookkeeping tasks
remain.  First, the forward-branch patch pass resolves all
placeholder \textsc{b} and \textsc{cbnz} instructions whose
targets were not yet known at emission time.  Second, the
function is registered as a defined Mach-O symbol with the
conventional underscore prefix (\texttt{\_main} for
\texttt{main}) and inserted into the extern hash table so that
call sites in other functions can resolve to it.

@d CodeGen: compile function @{
.Lcgf_patch:
    // 8. Patch forward branches
    mov x0, x22                    // bb_labels ht
    mov x1, x23                    // patch vec
    bl _kcc_codegen_patch_branches

    // 9. Add function symbol to linker (Mach-O needs leading underscore)
    ldr x24, [x19, #IRF_NAME]     // name
    mov x0, x24
    bl _kcc_strlen
    add x0, x0, #2                // +1 for '_' prefix, +1 for null
    bl _kcc_arena_alloc
    mov x25, x0                   // x25 = new name buffer
    mov w1, #'_'
    strb w1, [x25]                // prefix '_'
    add x0, x25, #1              // dest = buf+1
    mov x1, x24                   // src = original name
    mov x2, x24
    mov x0, x2
    bl _kcc_strlen
    add x2, x0, #1               // len = strlen(name) + 1 (include null)
    add x0, x25, #1              // dest
    mov x1, x24                   // src
    bl _kcc_memcpy
    mov x0, x25                   // name = "_main"
    mov x1, #1                     // section = 1 (__text)
    mov x2, x21                    // value = func_start_offset
    mov x3, #(N_SECT | N_EXT)     // flags = defined + external
    bl _kcc_linker_add_sym
    mov x26, x0                    // x26 = sym_index

    // Register in extern hash table so calls from other functions find it
    mov x0, x25
    bl _kcc_strlen
    mov x27, x0                    // name len
    adrp x0, _kcc_linker_extern_ht@@PAGE
    add  x0, x0, _kcc_linker_extern_ht@@PAGEOFF
    ldr x0, [x0]
    mov x1, x25                    // key = prefixed name
    mov x2, x27                    // keylen
    add x3, x26, #1               // value = sym_index + 1
    bl _kcc_ht_put

    ldp x27, x28, [sp, #80]
    ldp x25, x26, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #112
    ret
@}

\section{Vreg Slot Offset}

The ``all-spill'' strategy means every virtual register lives at a
fixed stack offset.  The frame layout (with x29 pointing to its
base) is:
\begin{verbatim}
  [x29 + 0]  : saved x29
  [x29 + 8]  : saved x30
  [x29 + 16] : vreg 0
  [x29 + 24] : vreg 1
  ...
  [x29 + 16 + N*8] : vreg N
\end{verbatim}

ARM64 unsigned-offset loads and stores encode the immediate as
\texttt{imm12\_scaled} = byte\_offset / access\_size.  For 64-bit
accesses the divisor is~8, so vreg~$N$ has
$\mathit{imm12\_scaled} = (16 + N \times 8)/8 = N + 2$.

Three helpers wrap this: \texttt{slot\_offset} returns the scaled
immediate, \texttt{load\_vreg} emits a \textsc{ldr} from a vreg
slot into a named register, and \texttt{store\_vreg} emits the
corresponding \textsc{str}.

@d CodeGen: vreg slot offset @{
// -- kcc_cg_slot_offset -------------------------------------------------------
// uint64_t kcc_cg_slot_offset(uint64_t vreg)
// Returns the scaled imm12 value for LDR/STR unsigned offset (64-bit).
// slot_offset = (16 + vreg * 8) / 8 = vreg + 2
// So LDR x9, [x29, #(16 + vreg*8)] encodes imm12_scaled = vreg + 2
.text
.globl _kcc_cg_slot_offset
.p2align 2
_kcc_cg_slot_offset:
    add x0, x0, #2                // imm12_scaled = vreg + 2
    ret
@| _kcc_cg_slot_offset
@}

\paragraph{Register Transfers.}
With the offset calculation factored out, loading and storing virtual
registers becomes a thin wrapper around the ARM64 \textsc{ldr}/\textsc{str}
encoding helpers.  \texttt{\_kcc\_cg\_load\_vreg} emits a 64-bit
\texttt{LDR} from the vreg's stack slot into a scratch register
(\texttt{x9}--\texttt{x11}), while \texttt{\_kcc\_cg\_store\_vreg}
emits the corresponding \texttt{STR} to spill a scratch register back
to the slot.  Both use \texttt{x29} as the base register and the
scaled immediate computed by \texttt{\_kcc\_cg\_slot\_offset}.

@d CodeGen: vreg slot offset @{
// -- kcc_cg_load_vreg ---------------------------------------------------------
// void kcc_cg_load_vreg(uint64_t vreg, uint64_t reg)
//   x0 = vreg number, x1 = target register number (9, 10, or 11)
// Emits: LDR x<reg>, [x29, #slot_offset]
.text
.globl _kcc_cg_load_vreg
.p2align 2
_kcc_cg_load_vreg:
    stp x29, x30, [sp, #-16]!
    mov x29, sp

    add x2, x0, #2                // imm12_scaled = vreg + 2
    mov x0, x1                     // rt = target reg
    mov x1, #29                    // rn = x29
    // x2 already set
    mov x3, #1                     // size = 64-bit
    bl _kcc_enc_ldr_imm
    bl _kcc_code_emit32

    ldp x29, x30, [sp], #16
    ret

// -- kcc_cg_store_vreg --------------------------------------------------------
// void kcc_cg_store_vreg(uint64_t vreg, uint64_t reg)
//   x0 = vreg number, x1 = source register number
// Emits: STR x<reg>, [x29, #slot_offset]
.text
.globl _kcc_cg_store_vreg
.p2align 2
_kcc_cg_store_vreg:
    stp x29, x30, [sp, #-16]!
    mov x29, sp

    add x2, x0, #2                // imm12_scaled = vreg + 2
    mov x0, x1                     // rt = source reg
    mov x1, #29                    // rn = x29
    // x2 already set
    mov x3, #1                     // size = 64-bit
    bl _kcc_enc_str_imm
    bl _kcc_code_emit32

    ldp x29, x30, [sp], #16
    ret

// -- kcc_cg_load_vreg_fp / kcc_cg_store_vreg_fp -------------------------------
// Move a double between a vreg's stack slot and a floating-point register.
//   x0 = vreg number, x1 = FP register number (0, 1, or 2)
// The slot layout is identical to the integer helpers (offset vreg+2,
// scaled by 8), so a double round-trips through the same 8-byte slot.
.text
.globl _kcc_cg_load_vreg_fp
.p2align 2
_kcc_cg_load_vreg_fp:
    stp x29, x30, [sp, #-16]!
    mov x29, sp
    add x2, x0, #2                // imm12 = vreg + 2
    mov x0, x1                     // Rt = FP reg
    mov x1, #29                    // Rn = x29
    bl _kcc_enc_ldr_fp
    bl _kcc_code_emit32
    ldp x29, x30, [sp], #16
    ret

.text
.globl _kcc_cg_store_vreg_fp
.p2align 2
_kcc_cg_store_vreg_fp:
    stp x29, x30, [sp, #-16]!
    mov x29, sp
    add x2, x0, #2
    mov x0, x1                     // Rt = FP reg
    mov x1, #29
    bl _kcc_enc_str_fp
    bl _kcc_code_emit32
    ldp x29, x30, [sp], #16
    ret
@| _kcc_cg_load_vreg _kcc_cg_store_vreg _kcc_cg_load_vreg_fp _kcc_cg_store_vreg_fp
@}

\section{Instruction Dispatch}

The instruction dispatcher is a large switch over IR opcodes.
Most cases follow the same pattern: load source vregs into scratch
registers, compute, store the result.  Two cases deserve special
attention.

\paragraph{Function calls and the Apple variadic ABI.}
On Apple ARM64, variadic functions read their non-fixed arguments
from the \emph{stack}, not from registers.  The standard AAPCS64
passes arguments in \texttt{x0}--\texttt{x7}, but Apple diverges:
the callee's \texttt{va\_list} walks the stack frame, ignoring
registers beyond the declared parameters.  Because the compiler
does not know at the call site whether the callee is variadic, we
adopt a safe strategy: load all arguments into
\texttt{x0}--\texttt{x7} as usual \emph{and also} push
\texttt{args[1..N{-}1]} onto the stack.  Non-variadic callees
simply ignore the stack copies; variadic callees (like
\texttt{printf}) find them where expected.  The emitted sequence is:
%
\begin{enumerate}
\item \texttt{SUB sp, sp, \#aligned\_size}
\item \texttt{STR x\textit{k}, [sp, \#(\textit{k}{-}1)*8]}
      for each $k \in [1, N{-}1]$
\item \texttt{BL \_callee}
\item \texttt{ADD sp, sp, \#aligned\_size}
\end{enumerate}

\paragraph{String literals.}
\texttt{IR\_STRING\_LIT} delegates to
\texttt{kcc\_codegen\_string\_lit}
(\S\ref{sec:emit-strings}), which copies the string bytes into the
cstring buffer, creates a local symbol, and emits an
\textsc{adrp}+\textsc{add} pair so the generated code gets a
pointer to the data.

@d CodeGen: instruction dispatch @{
// -- kcc_codegen_instr --------------------------------------------------------
// void kcc_codegen_instr(ir_instr *instr, ht *bb_labels, vec *patches)
//   x0 = instruction, x1 = bb label ht, x2 = patch vec
.text
.globl _kcc_codegen_instr
.p2align 2
_kcc_codegen_instr:
    stp x29, x30, [sp, #-112]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    stp x25, x26, [sp, #64]
    str x27, [sp, #80]

    mov x19, x0                    // instr
    mov x20, x1                    // bb_labels
    mov x21, x2                    // patches

    ldr x22, [x19, #IR_OP]        // opcode

    // Floating-point arithmetic and comparison route to a parallel set of
    // handlers.  Only these opcodes use the FP unit; IR_CONST/LOAD/STORE
    // also carry a double type but move the raw bit pattern, so they stay
    // on the ordinary path.
    ldr x0, [x19, #IR_TYPE]
    cbz x0, .Lcgi_dispatch
    ldr x0, [x0, #TY_KIND]
    cmp x0, #TY_FLOAT
    b.eq .Lcgi_fp_dispatch
    cmp x0, #TY_DOUBLE
    b.ne .Lcgi_dispatch
.Lcgi_fp_dispatch:
    cmp x22, #IR_ADD
    b.eq .Lcgi_fadd
    cmp x22, #IR_SUB
    b.eq .Lcgi_fsub
    cmp x22, #IR_MUL
    b.eq .Lcgi_fmul
    cmp x22, #IR_SDIV
    b.eq .Lcgi_fdiv
    cmp x22, #IR_CMP_EQ
    b.eq .Lcgi_fcmp
    cmp x22, #IR_CMP_NE
    b.eq .Lcgi_fcmp
    cmp x22, #IR_CMP_SLT
    b.eq .Lcgi_fcmp
    cmp x22, #IR_CMP_SLE
    b.eq .Lcgi_fcmp
    cmp x22, #IR_CMP_SGT
    b.eq .Lcgi_fcmp
    cmp x22, #IR_CMP_SGE
    b.eq .Lcgi_fcmp
    // Other fp-typed opcodes (const/load/store): ordinary path.

.Lcgi_dispatch:
    // Dispatch on opcode
    cmp x22, #IR_NOP
    b.eq .Lcgi_done

    cmp x22, #IR_CONST
    b.eq .Lcgi_const

    cmp x22, #IR_ADD
    b.eq .Lcgi_add
    cmp x22, #IR_SUB
    b.eq .Lcgi_sub
    cmp x22, #IR_MUL
    b.eq .Lcgi_mul
    cmp x22, #IR_SDIV
    b.eq .Lcgi_sdiv
    cmp x22, #IR_UDIV
    b.eq .Lcgi_udiv
    cmp x22, #IR_SMOD
    b.eq .Lcgi_smod
    cmp x22, #IR_UMOD
    b.eq .Lcgi_umod
    cmp x22, #IR_NEG
    b.eq .Lcgi_neg

    cmp x22, #IR_AND
    b.eq .Lcgi_and
    cmp x22, #IR_OR
    b.eq .Lcgi_or
    cmp x22, #IR_XOR
    b.eq .Lcgi_xor
    cmp x22, #IR_SHL
    b.eq .Lcgi_shl
    cmp x22, #IR_LSHR
    b.eq .Lcgi_lshr
    cmp x22, #IR_ASHR
    b.eq .Lcgi_ashr
    cmp x22, #IR_NOT
    b.eq .Lcgi_not

    cmp x22, #IR_CMP_EQ
    b.eq .Lcgi_cmp_eq
    cmp x22, #IR_CMP_NE
    b.eq .Lcgi_cmp_ne
    cmp x22, #IR_CMP_SLT
    b.eq .Lcgi_cmp_slt
    cmp x22, #IR_CMP_SLE
    b.eq .Lcgi_cmp_sle
    cmp x22, #IR_CMP_SGT
    b.eq .Lcgi_cmp_sgt
    cmp x22, #IR_CMP_SGE
    b.eq .Lcgi_cmp_sge
    cmp x22, #IR_CMP_ULT
    b.eq .Lcgi_cmp_ult
    cmp x22, #IR_CMP_ULE
    b.eq .Lcgi_cmp_ule

    cmp x22, #IR_LOAD
    b.eq .Lcgi_load
    cmp x22, #IR_STORE
    b.eq .Lcgi_store
    cmp x22, #IR_ALLOCA
    b.eq .Lcgi_alloca
    cmp x22, #IR_GEP
    b.eq .Lcgi_gep

    cmp x22, #IR_BR
    b.eq .Lcgi_br
    cmp x22, #IR_BR_COND
    b.eq .Lcgi_br_cond
    cmp x22, #IR_RET
    b.eq .Lcgi_ret
    cmp x22, #IR_CALL
    b.eq .Lcgi_call
    cmp x22, #IR_CALL_IND
    b.eq .Lcgi_call_ind
    cmp x22, #IR_GLOBAL_REF
    b.eq .Lcgi_global_ref
    cmp x22, #IR_STRING_LIT
    b.eq .Lcgi_string_lit

    cmp x22, #IR_TRUNC
    b.eq .Lcgi_trunc
    cmp x22, #IR_BITCAST
    b.eq .Lcgi_bitcast
    cmp x22, #IR_SEXT
    b.eq .Lcgi_sext
    cmp x22, #IR_ZEXT
    b.eq .Lcgi_zext
    cmp x22, #IR_SITOFP
    b.eq .Lcgi_sitofp
    cmp x22, #IR_FPTOSI
    b.eq .Lcgi_fptosi

    // Unknown opcode: skip
    b .Lcgi_done
@| _kcc_codegen_instr
@}

\subsection{Loading Constants}

An \texttt{IR\_CONST} materialises an arbitrary 64-bit immediate into
x11 using a \textsc{movz}\,+\,\textsc{movk} sequence.  \textsc{movz}
loads the lowest 16~bits and zeroes the rest; each subsequent
\textsc{movk} patches one 16-bit half-word lane if it is non-zero.
This produces 1--4 instructions depending on the value.

@d CodeGen: instruction dispatch @{
// ---- IR_CONST: load immediate into x11, store to dest slot ----
.Lcgi_const:
    ldr x23, [x19, #IR_SRC1]      // immediate value
    ldr x24, [x19, #IR_DEST]      // dest vreg

    // Emit MOVZ for bits [15:0]
    mov x0, #CG_REG_DST           // rd = x11
    and x1, x23, #0xFFFF          // imm16 = low 16 bits
    mov x2, #0                     // hw = 0
    mov x3, #1                     // sf = 64-bit
    bl _kcc_enc_movz
    bl _kcc_code_emit32

    // Check if we need MOVK for bits [31:16]
    lsr x0, x23, #16
    and x0, x0, #0xFFFF
    cbz x0, .Lcgi_const_hw2

    mov x0, #CG_REG_DST
    lsr x1, x23, #16
    and x1, x1, #0xFFFF
    mov x2, #1                     // hw = 1
    mov x3, #1
    bl _kcc_enc_movk
    bl _kcc_code_emit32

.Lcgi_const_hw2:
    lsr x0, x23, #32
    and x0, x0, #0xFFFF
    cbz x0, .Lcgi_const_hw3

    mov x0, #CG_REG_DST
    lsr x1, x23, #32
    and x1, x1, #0xFFFF
    mov x2, #2                     // hw = 2
    mov x3, #1
    bl _kcc_enc_movk
    bl _kcc_code_emit32

.Lcgi_const_hw3:
    lsr x0, x23, #48
    and x0, x0, #0xFFFF
    cbz x0, .Lcgi_const_store

    mov x0, #CG_REG_DST
    lsr x1, x23, #48
    and x1, x1, #0xFFFF
    mov x2, #3                     // hw = 3
    mov x3, #1
    bl _kcc_enc_movk
    bl _kcc_code_emit32

.Lcgi_const_store:
    // Store x11 to dest vreg slot
    mov x0, x24                    // vreg
    mov x1, #CG_REG_DST           // reg = x11
    bl _kcc_cg_store_vreg
    b .Lcgi_done
@}

\subsection{Arithmetic and Bitwise Operations}

All binary arithmetic and bitwise instructions follow the same
pattern: load the two source vregs into x9 and x10, perform the
operation into x11, and store x11 to the destination slot.  The
\textsc{add}, \textsc{sub}, \textsc{mul}, \textsc{sdiv}, and
\textsc{udiv} cases differ only in which encoder they call.

Signed modulo requires two instructions: \texttt{sdiv\;x11,\;x9,\;x10}
followed by \texttt{msub\;x11,\;x11,\;x10,\;x9}, which computes
$x_9 - (x_9 / x_{10}) \times x_{10}$.  Negation is \texttt{sub\;x11,\;xzr,\;x9}.

The bitwise operations (\textsc{and}, \textsc{orr}, \textsc{eor},
shifts, and \textsc{not}) use the same load--compute--store pattern
with logical-class encoders.

@d CodeGen: instruction dispatch @{
// ---- Binary arithmetic: load src1→x9, src2→x10, op→x11, store ----
.Lcgi_add:
    ldr x0, [x19, #IR_SRC1]
    mov x1, #CG_REG_SRC1
    bl _kcc_cg_load_vreg
    ldr x0, [x19, #IR_SRC2]
    mov x1, #CG_REG_SRC2
    bl _kcc_cg_load_vreg

    mov x0, #CG_REG_DST
    mov x1, #CG_REG_SRC1
    mov x2, #CG_REG_SRC2
    mov x3, #1
    bl _kcc_enc_add_reg
    bl _kcc_code_emit32

    ldr x0, [x19, #IR_DEST]
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg
    b .Lcgi_done

.Lcgi_sub:
    ldr x0, [x19, #IR_SRC1]
    mov x1, #CG_REG_SRC1
    bl _kcc_cg_load_vreg
    ldr x0, [x19, #IR_SRC2]
    mov x1, #CG_REG_SRC2
    bl _kcc_cg_load_vreg

    mov x0, #CG_REG_DST
    mov x1, #CG_REG_SRC1
    mov x2, #CG_REG_SRC2
    mov x3, #1
    bl _kcc_enc_sub_reg
    bl _kcc_code_emit32

    ldr x0, [x19, #IR_DEST]
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg
    b .Lcgi_done

.Lcgi_mul:
    ldr x0, [x19, #IR_SRC1]
    mov x1, #CG_REG_SRC1
    bl _kcc_cg_load_vreg
    ldr x0, [x19, #IR_SRC2]
    mov x1, #CG_REG_SRC2
    bl _kcc_cg_load_vreg

    mov x0, #CG_REG_DST
    mov x1, #CG_REG_SRC1
    mov x2, #CG_REG_SRC2
    mov x3, #1
    bl _kcc_enc_mul
    bl _kcc_code_emit32

    ldr x0, [x19, #IR_DEST]
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg
    b .Lcgi_done

.Lcgi_sdiv:
    ldr x0, [x19, #IR_SRC1]
    mov x1, #CG_REG_SRC1
    bl _kcc_cg_load_vreg
    ldr x0, [x19, #IR_SRC2]
    mov x1, #CG_REG_SRC2
    bl _kcc_cg_load_vreg

    mov x0, #CG_REG_DST
    mov x1, #CG_REG_SRC1
    mov x2, #CG_REG_SRC2
    mov x3, #1
    bl _kcc_enc_sdiv
    bl _kcc_code_emit32

    ldr x0, [x19, #IR_DEST]
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg
    b .Lcgi_done

.Lcgi_udiv:
    ldr x0, [x19, #IR_SRC1]
    mov x1, #CG_REG_SRC1
    bl _kcc_cg_load_vreg
    ldr x0, [x19, #IR_SRC2]
    mov x1, #CG_REG_SRC2
    bl _kcc_cg_load_vreg

    mov x0, #CG_REG_DST
    mov x1, #CG_REG_SRC1
    mov x2, #CG_REG_SRC2
    mov x3, #1
    bl _kcc_enc_udiv
    bl _kcc_code_emit32

    ldr x0, [x19, #IR_DEST]
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg
    b .Lcgi_done

.Lcgi_smod:
    // SMOD: x11 = x9 - (x9/x10)*x10  → sdiv x11,x9,x10; msub x11,x11,x10,x9
    ldr x0, [x19, #IR_SRC1]
    mov x1, #CG_REG_SRC1
    bl _kcc_cg_load_vreg
    ldr x0, [x19, #IR_SRC2]
    mov x1, #CG_REG_SRC2
    bl _kcc_cg_load_vreg

    // sdiv x11, x9, x10
    mov x0, #CG_REG_DST
    mov x1, #CG_REG_SRC1
    mov x2, #CG_REG_SRC2
    mov x3, #1
    bl _kcc_enc_sdiv
    bl _kcc_code_emit32

    // msub x11, x11, x10, x9  (x11 = x9 - x11*x10)
    mov x0, #CG_REG_DST           // rd
    mov x1, #CG_REG_DST           // rn (quotient)
    mov x2, #CG_REG_SRC2          // rm (divisor)
    mov x3, #CG_REG_SRC1          // ra (dividend)
    mov x4, #1                     // sf
    bl _kcc_enc_msub
    bl _kcc_code_emit32

    ldr x0, [x19, #IR_DEST]
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg
    b .Lcgi_done

.Lcgi_umod:
    // UMOD: x11 = x9 - (x9/x10)*x10  → udiv x11,x9,x10; msub x11,x11,x10,x9
    ldr x0, [x19, #IR_SRC1]
    mov x1, #CG_REG_SRC1
    bl _kcc_cg_load_vreg
    ldr x0, [x19, #IR_SRC2]
    mov x1, #CG_REG_SRC2
    bl _kcc_cg_load_vreg

    // udiv x11, x9, x10
    mov x0, #CG_REG_DST
    mov x1, #CG_REG_SRC1
    mov x2, #CG_REG_SRC2
    mov x3, #1
    bl _kcc_enc_udiv
    bl _kcc_code_emit32

    // msub x11, x11, x10, x9  (x11 = x9 - x11*x10)
    mov x0, #CG_REG_DST
    mov x1, #CG_REG_DST
    mov x2, #CG_REG_SRC2
    mov x3, #CG_REG_SRC1
    mov x4, #1
    bl _kcc_enc_msub
    bl _kcc_code_emit32

    ldr x0, [x19, #IR_DEST]
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg
    b .Lcgi_done

.Lcgi_neg:
    // NEG x11, x9 → SUB x11, xzr, x9
    ldr x0, [x19, #IR_SRC1]
    mov x1, #CG_REG_SRC1
    bl _kcc_cg_load_vreg

    mov x0, #CG_REG_DST           // rd
    mov x1, #31                    // rn = xzr
    mov x2, #CG_REG_SRC1          // rm
    mov x3, #1                     // sf
    bl _kcc_enc_sub_reg
    bl _kcc_code_emit32

    ldr x0, [x19, #IR_DEST]
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg
    b .Lcgi_done
@}

\paragraph{Bitwise Operations}
The bitwise group---\textsc{and}, \textsc{orr}, \textsc{eor},
shifts, and \textsc{mvn}---follows the same load--compute--store
pattern as arithmetic.  Each binary bitwise operation loads the two
source vregs into \texttt{x9} and \texttt{x10}, calls the
appropriate logical-class encoder, and stores the result from
\texttt{x11} to the destination slot.  Shifts use
register-variable forms (\textsc{lsl}, \textsc{lsr}, \textsc{asr})
rather than immediate encodings, since the shift amount comes from
a vreg.  The unary \textsc{not} (\texttt{IR\_NOT}) uses
\textsc{mvn} with a single source operand.

@d CodeGen: instruction dispatch @{
// ---- Bitwise operations ----
.Lcgi_and:
    ldr x0, [x19, #IR_SRC1]
    mov x1, #CG_REG_SRC1
    bl _kcc_cg_load_vreg
    ldr x0, [x19, #IR_SRC2]
    mov x1, #CG_REG_SRC2
    bl _kcc_cg_load_vreg

    mov x0, #CG_REG_DST
    mov x1, #CG_REG_SRC1
    mov x2, #CG_REG_SRC2
    mov x3, #1
    bl _kcc_enc_and_reg
    bl _kcc_code_emit32

    ldr x0, [x19, #IR_DEST]
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg
    b .Lcgi_done

.Lcgi_or:
    ldr x0, [x19, #IR_SRC1]
    mov x1, #CG_REG_SRC1
    bl _kcc_cg_load_vreg
    ldr x0, [x19, #IR_SRC2]
    mov x1, #CG_REG_SRC2
    bl _kcc_cg_load_vreg

    mov x0, #CG_REG_DST
    mov x1, #CG_REG_SRC1
    mov x2, #CG_REG_SRC2
    mov x3, #1
    bl _kcc_enc_orr_reg
    bl _kcc_code_emit32

    ldr x0, [x19, #IR_DEST]
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg
    b .Lcgi_done

.Lcgi_xor:
    ldr x0, [x19, #IR_SRC1]
    mov x1, #CG_REG_SRC1
    bl _kcc_cg_load_vreg
    ldr x0, [x19, #IR_SRC2]
    mov x1, #CG_REG_SRC2
    bl _kcc_cg_load_vreg

    mov x0, #CG_REG_DST
    mov x1, #CG_REG_SRC1
    mov x2, #CG_REG_SRC2
    mov x3, #1
    bl _kcc_enc_eor_reg
    bl _kcc_code_emit32

    ldr x0, [x19, #IR_DEST]
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg
    b .Lcgi_done

.Lcgi_shl:
    ldr x0, [x19, #IR_SRC1]
    mov x1, #CG_REG_SRC1
    bl _kcc_cg_load_vreg
    ldr x0, [x19, #IR_SRC2]
    mov x1, #CG_REG_SRC2
    bl _kcc_cg_load_vreg

    mov x0, #CG_REG_DST
    mov x1, #CG_REG_SRC1
    mov x2, #CG_REG_SRC2
    mov x3, #1
    bl _kcc_enc_lsl_reg
    bl _kcc_code_emit32

    ldr x0, [x19, #IR_DEST]
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg
    b .Lcgi_done

.Lcgi_lshr:
    ldr x0, [x19, #IR_SRC1]
    mov x1, #CG_REG_SRC1
    bl _kcc_cg_load_vreg
    ldr x0, [x19, #IR_SRC2]
    mov x1, #CG_REG_SRC2
    bl _kcc_cg_load_vreg

    mov x0, #CG_REG_DST
    mov x1, #CG_REG_SRC1
    mov x2, #CG_REG_SRC2
    mov x3, #1
    bl _kcc_enc_lsr_reg
    bl _kcc_code_emit32

    ldr x0, [x19, #IR_DEST]
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg
    b .Lcgi_done

.Lcgi_ashr:
    ldr x0, [x19, #IR_SRC1]
    mov x1, #CG_REG_SRC1
    bl _kcc_cg_load_vreg
    ldr x0, [x19, #IR_SRC2]
    mov x1, #CG_REG_SRC2
    bl _kcc_cg_load_vreg

    mov x0, #CG_REG_DST
    mov x1, #CG_REG_SRC1
    mov x2, #CG_REG_SRC2
    mov x3, #1
    bl _kcc_enc_asr_reg
    bl _kcc_code_emit32

    ldr x0, [x19, #IR_DEST]
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg
    b .Lcgi_done

.Lcgi_not:
    ldr x0, [x19, #IR_SRC1]
    mov x1, #CG_REG_SRC1
    bl _kcc_cg_load_vreg

    mov x0, #CG_REG_DST
    mov x1, #CG_REG_SRC1
    mov x2, #1                     // sf
    bl _kcc_enc_mvn
    bl _kcc_code_emit32

    ldr x0, [x19, #IR_DEST]
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg
    b .Lcgi_done
@}

\subsection{Comparison Operations}

Integer comparisons emit \texttt{CMP\;x9,\;x10} (which is really
\texttt{SUBS\;xzr,\;x9,\;x10}---subtract and set flags, discard
result) followed by \texttt{CSET\;x11,\;\textit{cond}}.  The
\textsc{cset} pseudo-instruction encodes as
\texttt{CSINC\;x11,\;xzr,\;xzr,\;inv(cond)}: if the
\emph{inverted} condition is false, the result is~1; otherwise~0.
All six comparisons share a common tail; each case simply loads
the inverted condition code into x23 and falls through:

\begin{center}
\begin{tabular}{lcc}
\hline
IR opcode & ARM64 cond & Inverted \\
\hline
\texttt{CMP\_EQ} & EQ (0) & NE (1) \\
\texttt{CMP\_NE} & NE (1) & EQ (0) \\
\texttt{CMP\_SLT} & LT (11) & GE (10) \\
\texttt{CMP\_SLE} & LE (13) & GT (12) \\
\texttt{CMP\_SGT} & GT (12) & LE (13) \\
\texttt{CMP\_SGE} & GE (10) & LT (11) \\
\texttt{CMP\_ULT} & LO/CC (3) & HS/CS (2) \\
\texttt{CMP\_ULE} & LS (9) & HI (8) \\
\hline
\end{tabular}
\end{center}

@d CodeGen: instruction dispatch @{
// ---- Compare operations ----
// Pattern: load src1→x9, src2→x10, CMP x9,x10, CSET x11,<inv_cond>

.Lcgi_cmp_eq:
    mov x23, #1                    // inv_cond for EQ = NE (1)
    b .Lcgi_cmp_common
.Lcgi_cmp_ne:
    mov x23, #0                    // inv_cond for NE = EQ (0)
    b .Lcgi_cmp_common
.Lcgi_cmp_slt:
    mov x23, #10                   // inv_cond for LT = GE (10)
    b .Lcgi_cmp_common
.Lcgi_cmp_sle:
    mov x23, #12                   // inv_cond for LE = GT (12)
    b .Lcgi_cmp_common
.Lcgi_cmp_sgt:
    mov x23, #13                   // inv_cond for GT = LE (13)
    b .Lcgi_cmp_common
.Lcgi_cmp_sge:
    mov x23, #11                   // inv_cond for GE = LT (11)
    b .Lcgi_cmp_common
.Lcgi_cmp_ult:
    mov x23, #2                    // inv_cond for LO/CC = HS/CS (2)
    b .Lcgi_cmp_common
.Lcgi_cmp_ule:
    mov x23, #8                    // inv_cond for LS = HI (8)
    b .Lcgi_cmp_common

.Lcgi_cmp_common:
    ldr x0, [x19, #IR_SRC1]
    mov x1, #CG_REG_SRC1
    bl _kcc_cg_load_vreg
    ldr x0, [x19, #IR_SRC2]
    mov x1, #CG_REG_SRC2
    bl _kcc_cg_load_vreg

    // CMP x9, x10
    mov x0, #CG_REG_SRC1
    mov x1, #CG_REG_SRC2
    mov x2, #1                     // sf
    bl _kcc_enc_cmp_reg
    bl _kcc_code_emit32

    // CSET x11, inv_cond
    mov x0, #CG_REG_DST
    mov x1, x23                    // inv_cond
    mov x2, #1                     // sf
    bl _kcc_enc_cset
    bl _kcc_code_emit32

    ldr x0, [x19, #IR_DEST]
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg
    b .Lcgi_done
@}

\subsection{Type Conversions}

\texttt{IR\_TRUNC} masks a value to the width of the target type.
The target's \texttt{TY\_SIZE} (1, 2, or~4 bytes) selects the mask;
the handler loads the mask into \texttt{x10} and uses
\texttt{AND\;x11,\;x9,\;x10}.  If no type is attached or the size
is~8, the instruction is a plain copy.

\texttt{IR\_SEXT} sign-extends a narrow value to 64~bits.  The source
width is stored in \texttt{IR\_SRC2} (1, 2, or~4 bytes); the handler
emits \textsc{sbfm} with the appropriate \texttt{imms} field (7, 15,
or~31).  \texttt{IR\_ZEXT} zero-extends analogously using
\textsc{ubfm}.

\texttt{IR\_BITCAST} reinterprets the bit pattern as a different type
without changing any bits---a no-op in the all-spill strategy.

@d CodeGen: instruction dispatch @{
// ---- Type conversions ----

.Lcgi_trunc:
    ldr x0, [x19, #IR_SRC1]
    mov x1, #CG_REG_SRC1          // x9 = source value
    bl _kcc_cg_load_vreg

    // Get target type size
    ldr x0, [x19, #IR_TYPE]
    cbz x0, .Lcgi_trunc_copy
    ldr x23, [x0, #TY_SIZE]

    cmp x23, #1
    b.eq .Lcgi_trunc_1
    cmp x23, #2
    b.eq .Lcgi_trunc_2
    cmp x23, #4
    b.eq .Lcgi_trunc_4
    b .Lcgi_trunc_copy

.Lcgi_trunc_1:
    // MOVZ x10, #0xFF
    mov x0, #CG_REG_SRC2
    mov x1, #0xFF
    mov x2, #0
    mov x3, #1
    bl _kcc_enc_movz
    bl _kcc_code_emit32
    b .Lcgi_trunc_mask

.Lcgi_trunc_2:
    // MOVZ x10, #0xFFFF
    mov x0, #CG_REG_SRC2
    mov x1, #0xFFFF
    mov x2, #0
    mov x3, #1
    bl _kcc_enc_movz
    bl _kcc_code_emit32
    b .Lcgi_trunc_mask

.Lcgi_trunc_4:
    // MOVZ x10, #0xFFFF; MOVK x10, #0xFFFF, hw=1
    mov x0, #CG_REG_SRC2
    mov x1, #0xFFFF
    mov x2, #0
    mov x3, #1
    bl _kcc_enc_movz
    bl _kcc_code_emit32

    mov x0, #CG_REG_SRC2
    mov x1, #0xFFFF
    mov x2, #1
    mov x3, #1
    bl _kcc_enc_movk
    bl _kcc_code_emit32
    b .Lcgi_trunc_mask

.Lcgi_trunc_mask:
    // AND x11, x9, x10
    mov x0, #CG_REG_DST
    mov x1, #CG_REG_SRC1
    mov x2, #CG_REG_SRC2
    mov x3, #1
    bl _kcc_enc_and_reg
    bl _kcc_code_emit32

    ldr x0, [x19, #IR_DEST]
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg
    b .Lcgi_done

.Lcgi_trunc_copy:
    // No masking — copy src to dest via ADD x11, x9, #0
    mov x0, #CG_REG_DST
    mov x1, #CG_REG_SRC1
    mov x2, #0
    mov x3, #1
    bl _kcc_enc_add_imm
    bl _kcc_code_emit32

    ldr x0, [x19, #IR_DEST]
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg
    b .Lcgi_done

.Lcgi_bitcast:
    // Pure type reinterpretation — copy src to dest
    ldr x0, [x19, #IR_SRC1]
    mov x1, #CG_REG_SRC1
    bl _kcc_cg_load_vreg

    mov x0, #CG_REG_DST
    mov x1, #CG_REG_SRC1
    mov x2, #0
    mov x3, #1
    bl _kcc_enc_add_imm
    bl _kcc_code_emit32

    ldr x0, [x19, #IR_DEST]
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg
    b .Lcgi_done

.Lcgi_sext:
    // Sign-extend: SRC2 = source width in bytes
    ldr x0, [x19, #IR_SRC1]
    mov x1, #CG_REG_SRC1
    bl _kcc_cg_load_vreg

    ldr x23, [x19, #IR_SRC2]      // source width
    cmp x23, #1
    b.eq .Lcgi_sext_1
    cmp x23, #2
    b.eq .Lcgi_sext_2
    cmp x23, #4
    b.eq .Lcgi_sext_4
    b .Lcgi_sext_copy

.Lcgi_sext_1:
    // SXTB x11, x9 → SBFM x11, x9, #0, #7 = 0x93401D2B
    movz w0, #0x1D2B
    movk w0, #0x9340, lsl #16
    bl _kcc_code_emit32
    b .Lcgi_sext_store

.Lcgi_sext_2:
    // SXTH x11, x9 → SBFM x11, x9, #0, #15 = 0x93403D2B
    movz w0, #0x3D2B
    movk w0, #0x9340, lsl #16
    bl _kcc_code_emit32
    b .Lcgi_sext_store

.Lcgi_sext_4:
    // SXTW x11, x9 → SBFM x11, x9, #0, #31 = 0x93407D2B
    movz w0, #0x7D2B
    movk w0, #0x9340, lsl #16
    bl _kcc_code_emit32
    b .Lcgi_sext_store

.Lcgi_sext_copy:
    mov x0, #CG_REG_DST
    mov x1, #CG_REG_SRC1
    mov x2, #0
    mov x3, #1
    bl _kcc_enc_add_imm
    bl _kcc_code_emit32

.Lcgi_sext_store:
    ldr x0, [x19, #IR_DEST]
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg
    b .Lcgi_done

.Lcgi_zext:
    // Zero-extend: SRC2 = source width in bytes
    ldr x0, [x19, #IR_SRC1]
    mov x1, #CG_REG_SRC1
    bl _kcc_cg_load_vreg

    ldr x23, [x19, #IR_SRC2]
    cmp x23, #1
    b.eq .Lcgi_zext_1
    cmp x23, #2
    b.eq .Lcgi_zext_2
    cmp x23, #4
    b.eq .Lcgi_zext_4
    b .Lcgi_sext_copy              // fallback: plain copy

.Lcgi_zext_1:
    // UXTB x11, x9 → UBFM x11, x9, #0, #7 = 0xD3401D2B
    movz w0, #0x1D2B
    movk w0, #0xD340, lsl #16
    bl _kcc_code_emit32
    b .Lcgi_sext_store

.Lcgi_zext_2:
    // UXTH x11, x9 → UBFM x11, x9, #0, #15 = 0xD3403D2B
    movz w0, #0x3D2B
    movk w0, #0xD340, lsl #16
    bl _kcc_code_emit32
    b .Lcgi_sext_store

.Lcgi_zext_4:
    // 32→64: UBFM x11, x9, #0, #31 = 0xD3407D2B
    movz w0, #0x7D2B
    movk w0, #0xD340, lsl #16
    bl _kcc_code_emit32
    b .Lcgi_sext_store
@}

\subsection{Floating-Point Operations}

The floating-point handlers mirror the integer ones but route their
operands through the FP register file.  A double lives in the same
eight-byte spill slot as any other value, so \texttt{\_kcc\_cg\_load\_vreg\_fp}
reloads it into \texttt{d0}/\texttt{d1}, the two-source op computes into
\texttt{d2}, and \texttt{\_kcc\_cg\_store\_vreg\_fp} spills it back.
Comparisons reuse the integer comparison tail: after \textsc{fcmp}
sets the flags, the very same inverted condition codes drive
\textsc{cset}, because an \emph{ordered} floating comparison leaves
\texttt{N}, \texttt{Z}, and \texttt{V} in exactly the arrangement the
signed integer conditions already test.  The conversions bridge the two
register files---\textsc{scvtf} reads an integer slot and writes a
double slot, \textsc{fcvtzs} does the reverse with round-toward-zero,
matching C's truncating cast.

@d CodeGen: floating point @{
// ---- Floating-point arithmetic: src1→d0, src2→d1, fOP→d2, store ----
.Lcgi_fadd:
    mov x23, #2                    // fp dp2 opcode: fadd
    b .Lcgi_fp_arith
.Lcgi_fsub:
    mov x23, #3                    // fsub
    b .Lcgi_fp_arith
.Lcgi_fmul:
    mov x23, #0                    // fmul
    b .Lcgi_fp_arith
.Lcgi_fdiv:
    mov x23, #1                    // fdiv

.Lcgi_fp_arith:
    ldr x0, [x19, #IR_SRC1]
    mov x1, #0                     // d0
    bl _kcc_cg_load_vreg_fp
    ldr x0, [x19, #IR_SRC2]
    mov x1, #1                     // d1
    bl _kcc_cg_load_vreg_fp
    mov x0, #2                     // Rd = d2
    mov x1, #0                     // Rn = d0
    mov x2, #1                     // Rm = d1
    mov x3, x23                    // opcode
    bl _kcc_enc_fp_dp2
    bl _kcc_code_emit32
    ldr x0, [x19, #IR_DEST]
    mov x1, #2                     // d2
    bl _kcc_cg_store_vreg_fp
    b .Lcgi_done

// ---- Floating-point comparison: fcmp d0,d1 then cset x11,<inv_cond> ----
.Lcgi_fcmp:
    mov x23, #1                    // EQ  → inv NE (1)
    cmp x22, #IR_CMP_EQ
    b.eq .Lcgi_fcmp_do
    mov x23, #0                    // NE  → inv EQ (0)
    cmp x22, #IR_CMP_NE
    b.eq .Lcgi_fcmp_do
    mov x23, #10                   // SLT → inv GE (10)
    cmp x22, #IR_CMP_SLT
    b.eq .Lcgi_fcmp_do
    mov x23, #12                   // SLE → inv GT (12)
    cmp x22, #IR_CMP_SLE
    b.eq .Lcgi_fcmp_do
    mov x23, #13                   // SGT → inv LE (13)
    cmp x22, #IR_CMP_SGT
    b.eq .Lcgi_fcmp_do
    mov x23, #11                   // SGE → inv LT (11)

.Lcgi_fcmp_do:
    ldr x0, [x19, #IR_SRC1]
    mov x1, #0
    bl _kcc_cg_load_vreg_fp
    ldr x0, [x19, #IR_SRC2]
    mov x1, #1
    bl _kcc_cg_load_vreg_fp
    mov x0, #0                     // Rn = d0
    mov x1, #1                     // Rm = d1
    bl _kcc_enc_fcmp
    bl _kcc_code_emit32
    mov x0, #CG_REG_DST
    mov x1, x23                    // inverted condition
    mov x2, #1
    bl _kcc_enc_cset
    bl _kcc_code_emit32
    ldr x0, [x19, #IR_DEST]
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg          // result is an integer 0/1
    b .Lcgi_done

// ---- Conversions between the integer and floating register files ----
.Lcgi_sitofp:
    ldr x0, [x19, #IR_SRC1]
    mov x1, #CG_REG_SRC1           // x9
    bl _kcc_cg_load_vreg
    mov x0, #0                     // Rd = d0
    mov x1, #CG_REG_SRC1           // Rn = x9
    bl _kcc_enc_scvtf
    bl _kcc_code_emit32
    ldr x0, [x19, #IR_DEST]
    mov x1, #0                     // d0
    bl _kcc_cg_store_vreg_fp
    b .Lcgi_done

.Lcgi_fptosi:
    ldr x0, [x19, #IR_SRC1]
    mov x1, #0                     // d0
    bl _kcc_cg_load_vreg_fp
    mov x0, #CG_REG_SRC1           // Rd = x9 (integer)
    mov x1, #0                     // Rn = d0
    bl _kcc_enc_fcvtzs
    bl _kcc_code_emit32
    ldr x0, [x19, #IR_DEST]
    mov x1, #CG_REG_SRC1
    bl _kcc_cg_store_vreg
    b .Lcgi_done
@}

\subsection{Memory Operations}

\texttt{IR\_LOAD} dereferences a pointer: load the address from
the source vreg into x9, then \texttt{LDR\;x11,\;[x9]} to fetch
the value, and store x11 to the destination slot.

\texttt{IR\_STORE} is the inverse: load the value into x9 and
the pointer into x10, then \texttt{STR\;x9,\;[x10]}.  When the
\texttt{IR\_DEST} field is nonzero it acts as an access-size
override: 1\,$\to$\,\textsc{strb}, 2\,$\to$\,\textsc{strh},
4\,$\to$\,32-bit \textsc{str}.  This parallels the \texttt{IR\_LOAD}
override in \texttt{IR\_SRC2} and is used by the assignment builder
for pointer-dereference writes (\texttt{*p\;=\;v}), where a
64-bit store would corrupt adjacent bytes.

\texttt{IR\_ALLOCA} computes the \emph{address} of the variable's
storage.  To avoid the slot-aliasing bug (see Debugging Lessons),
alloca storage lives past the vreg value slots.  The pre-scan in
\texttt{kcc\_codegen\_func} assigns each alloca a running offset
(stored in \texttt{SRC2}) and sizes the frame accordingly.  The
address is \texttt{x29 + 16 + vreg\_count * 8 + offset * 8}, which
is distinct from the vreg's own value slot at
\texttt{x29 + 16 + dest * 8}.

\texttt{IR\_GEP} (Get Element Pointer) computes an element address
for array subscript: \texttt{base + index * 8}.  It loads the base
pointer and the index from their vreg slots, emits a
\texttt{MADD\;x11,\;x10,\;x12,\;x9} (where x12 holds the constant~8)
and stores the resulting address in the destination vreg.

@d CodeGen: instruction dispatch @{
// ---- Memory operations ----
.Lcgi_load:
    // Load: x9 = pointer from src1 slot, x11 = *x9, store x11 to dest
    ldr x0, [x19, #IR_SRC1]
    mov x1, #CG_REG_SRC1
    bl _kcc_cg_load_vreg

    // Check if this is a byte/halfword load (IR_SRC2 = access size override)
    ldr x23, [x19, #IR_SRC2]
    cmp x23, #1
    b.eq .Lcgi_load_8
    cmp x23, #2
    b.eq .Lcgi_load_16
    cmp x23, #4
    b.eq .Lcgi_load_32

    // Default: 64-bit load (works for alloca slots and pointer-width values)
    mov x0, #CG_REG_DST
    mov x1, #CG_REG_SRC1
    mov x2, #0
    mov x3, #1
    bl _kcc_enc_ldr_imm
    bl _kcc_code_emit32
    b .Lcgi_load_done
.Lcgi_load_8:
    // LDRB x11, [x9] — byte load, zero-extends to 64-bit
    mov x0, #CG_REG_DST
    mov x1, #CG_REG_SRC1
    mov x2, #0
    mov x3, #2
    bl _kcc_enc_ldr_imm
    bl _kcc_code_emit32
    b .Lcgi_load_done
.Lcgi_load_16:
    // LDRH x11, [x9] — halfword load, zero-extends to 64-bit
    mov x0, #CG_REG_DST
    mov x1, #CG_REG_SRC1
    mov x2, #0
    mov x3, #3
    bl _kcc_enc_ldr_imm
    bl _kcc_code_emit32
    b .Lcgi_load_done
.Lcgi_load_32:
    // LDR w11, [x9] — word load, zero-extends to 64-bit
    mov x0, #CG_REG_DST
    mov x1, #CG_REG_SRC1
    mov x2, #0
    mov x3, #0
    bl _kcc_enc_ldr_imm
    bl _kcc_code_emit32
.Lcgi_load_done:
    ldr x0, [x19, #IR_DEST]
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg
    b .Lcgi_done

.Lcgi_store:
    // Store: x9 = value from src1, x10 = pointer from src2, *x10 = x9
    // IR_STORE: SRC1 = value vreg, SRC2 = pointer vreg
    // IR_DEST = access size override (0 → 64-bit default)
    ldr x0, [x19, #IR_SRC1]
    mov x1, #CG_REG_SRC1
    bl _kcc_cg_load_vreg
    ldr x0, [x19, #IR_SRC2]
    mov x1, #CG_REG_SRC2
    bl _kcc_cg_load_vreg

    ldr x23, [x19, #IR_DEST]
    cmp x23, #1
    b.eq .Lcgi_store_8
    cmp x23, #2
    b.eq .Lcgi_store_16
    cmp x23, #4
    b.eq .Lcgi_store_32

    // Default: 64-bit store (alloca slots and pointer-sized values)
    mov x0, #CG_REG_SRC1
    mov x1, #CG_REG_SRC2
    mov x2, #0
    mov x3, #1                     // size = 64-bit
    bl _kcc_enc_str_imm
    bl _kcc_code_emit32
    b .Lcgi_done

.Lcgi_store_8:
    mov x0, #CG_REG_SRC1
    mov x1, #CG_REG_SRC2
    mov x2, #0
    mov x3, #2                     // size = byte (STRB)
    bl _kcc_enc_str_imm
    bl _kcc_code_emit32
    b .Lcgi_done

.Lcgi_store_16:
    mov x0, #CG_REG_SRC1
    mov x1, #CG_REG_SRC2
    mov x2, #0
    mov x3, #3                     // size = halfword (STRH)
    bl _kcc_enc_str_imm
    bl _kcc_code_emit32
    b .Lcgi_done

.Lcgi_store_32:
    mov x0, #CG_REG_SRC1
    mov x1, #CG_REG_SRC2
    mov x2, #0
    mov x3, #0                     // size = word (STR W)
    bl _kcc_enc_str_imm
    bl _kcc_code_emit32
    b .Lcgi_done

.Lcgi_alloca:
    // Alloca: compute address of storage past the vreg value slots.
    // Pre-scan stored the running offset in SRC2.
    // Address = x29 + 16 + vreg_count*8 + SRC2*8
    ldr x24, [x19, #IR_DEST]      // dest vreg
    ldr x25, [x19, #IR_SRC2]      // alloca offset (from pre-scan)

    ldr x0, [x19, #IR_SRC1]       // slot count (for frame calc verification)

    // Get vreg_count from ir_func
    adrp x0, _kcc_cg_vreg_count@@PAGE
    add  x0, x0, _kcc_cg_vreg_count@@PAGEOFF
    ldr x0, [x0]

    // Storage address = 16 + vreg_count*8 + offset*8
    lsl x1, x0, #3                // vreg_count * 8
    lsl x2, x25, #3               // offset * 8
    add x2, x2, x1
    add x2, x2, #16               // imm12 = 16 + vreg_count*8 + offset*8

    mov x0, #CG_REG_DST           // rd = x11
    mov x1, #29                    // rn = x29
    // x2 already set (imm12)
    mov x3, #1                     // sf
    bl _kcc_enc_add_imm
    bl _kcc_code_emit32

    // Store x11 (the address) to dest's VALUE slot
    mov x0, x24
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg
    b .Lcgi_done

.Lcgi_gep:
    // GEP: base + index * 8
    // SRC1 = base ptr vreg, SRC2 = index vreg
    ldr x0, [x19, #IR_SRC1]
    mov x1, #CG_REG_SRC1          // x9 = base
    bl _kcc_cg_load_vreg
    ldr x0, [x19, #IR_SRC2]
    mov x1, #CG_REG_SRC2          // x10 = index
    bl _kcc_cg_load_vreg

    // MOVZ x12, #8  (slot stride)
    mov x0, #12                    // rd = x12
    mov x1, #8                    // imm16 = 8
    mov x2, #0                    // hw = 0
    mov x3, #1                    // sf = 64-bit
    bl _kcc_enc_movz
    bl _kcc_code_emit32

    // MUL x10, x10, x12  →  index * 8
    mov x0, #CG_REG_SRC2          // rd = x10
    mov x1, #CG_REG_SRC2          // rn = x10
    mov x2, #12                    // rm = x12
    mov x3, #1                    // sf = 64-bit
    bl _kcc_enc_mul
    bl _kcc_code_emit32

    // ADD x11, x9, x10  →  base + index*8
    mov x0, #CG_REG_DST           // rd = x11
    mov x1, #CG_REG_SRC1          // rn = x9 (base)
    mov x2, #CG_REG_SRC2          // rm = x10 (index*8)
    mov x3, #1                    // sf = 64-bit
    bl _kcc_enc_add_reg
    bl _kcc_code_emit32

    // Store result to dest
    ldr x0, [x19, #IR_DEST]
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg
    b .Lcgi_done
@}

\subsection{Control Flow}

Branch instructions must handle both backward and forward targets.
For \texttt{IR\_BR} (unconditional) and \texttt{IR\_BR\_COND}
(conditional), the code generator looks up the target BB in the
label hash table.  If found, the offset is known and the branch
is emitted directly.  If not found (a forward reference), a
placeholder instruction is emitted and the location is recorded in
the patch vector; after all BBs have been processed, the patching
pass resolves these.

Conditional branches emit \texttt{CBNZ\;x9,\;true\_bb} (branch
if the condition vreg is non-zero) followed by
\texttt{B\;false\_bb}.  Either or both targets may be forward
references.

\texttt{IR\_RET} loads the return value (if non-void) into x0 and
emits the function epilogue: \texttt{LDP\;x29,\;x30,\;[sp],\;\#frame\_size}
followed by \textsc{ret}.

@d CodeGen: instruction dispatch @{
// ---- Control flow ----
.Lcgi_br:
    // Unconditional branch to BB (SRC1 = target BB_ID)
    ldr x23, [x19, #IR_SRC1]      // target BB_ID

    // Look up target in bb_labels
    str x23, [sp, #88]            // store bb_id for key
    mov x0, x20                    // ht
    add x1, sp, #88               // key = &bb_id
    mov x2, #8                     // keylen
    bl _kcc_ht_get
    cbz x0, .Lcgi_br_forward

    // Backward branch: compute offset
    sub x0, x0, #1                // undo +1 encoding
    bl _kcc_code_current_pos
    mov x24, x0                    // current pos

    // Look up again (we lost the value)
    mov x0, x20
    add x1, sp, #88
    mov x2, #8
    bl _kcc_ht_get
    sub x23, x0, #1               // target offset

    // offset = target - current
    sub x0, x23, x24
    bl _kcc_enc_b
    bl _kcc_code_emit32
    b .Lcgi_done

.Lcgi_br_forward:
    // Forward branch: emit placeholder, record for patching
    bl _kcc_code_current_pos
    mov x24, x0                    // patch offset

    // Emit NOP as placeholder
    mov x0, #0x14000000            // B with offset=0
    bl _kcc_code_emit32

    // Add to patch list: {code_offset, target_bb_id}
    str x24, [sp, #88]            // PATCH_OFFSET
    ldr x0, [x19, #IR_SRC1]
    str x0, [sp, #96]           // PATCH_TARGET = bb_id

    mov x0, x21                    // patch vec
    add x1, sp, #88               // entry pointer
    bl _kcc_vec_push
    b .Lcgi_done

.Lcgi_br_cond:
    // Conditional branch: DEST=cond vreg, SRC1=true BB_ID, SRC2=false BB_ID
    ldr x0, [x19, #IR_DEST]       // condition vreg
    mov x1, #CG_REG_SRC1
    bl _kcc_cg_load_vreg

    // CBNZ x9, <true_bb> (may be forward)
    ldr x23, [x19, #IR_SRC1]      // true BB_ID

    // Check if true target is known
    str x23, [sp, #88]
    mov x0, x20
    add x1, sp, #88
    mov x2, #8
    bl _kcc_ht_get
    cbz x0, .Lcgi_brcond_fwd_true

    // True target is backward
    sub x23, x0, #1               // target offset
    bl _kcc_code_current_pos
    sub x0, x23, x0               // offset = target - current
    mov x1, x0                     // offset in bytes
    mov x0, #CG_REG_SRC1          // rt = x9
    mov x2, #1                     // sf
    bl _kcc_enc_cbnz
    bl _kcc_code_emit32
    b .Lcgi_brcond_false

.Lcgi_brcond_fwd_true:
    // Forward: emit CBNZ placeholder
    bl _kcc_code_current_pos
    mov x24, x0

    // CBNZ x9, +0 (placeholder)
    mov w0, #0xB5000000            // CBNZ 64-bit with imm19=0
    add w0, w0, #CG_REG_SRC1      // rt = x9 (Rt field at bits [4:0])
    bl _kcc_code_emit32

    // Record patch: type CBNZ
    str x24, [sp, #88]
    ldr x0, [x19, #IR_SRC1]
    str x0, [sp, #96]
    mov x0, x21
    add x1, sp, #88
    bl _kcc_vec_push

.Lcgi_brcond_false:
    // Now emit B to false BB_ID
    ldr x23, [x19, #IR_SRC2]      // false BB_ID
    str x23, [sp, #88]
    mov x0, x20
    add x1, sp, #88
    mov x2, #8
    bl _kcc_ht_get
    cbz x0, .Lcgi_brcond_fwd_false

    // Backward
    sub x23, x0, #1
    bl _kcc_code_current_pos
    sub x0, x23, x0
    bl _kcc_enc_b
    bl _kcc_code_emit32
    b .Lcgi_done

.Lcgi_brcond_fwd_false:
    bl _kcc_code_current_pos
    mov x24, x0
    mov x0, #0x14000000
    bl _kcc_code_emit32
    str x24, [sp, #88]
    ldr x0, [x19, #IR_SRC2]
    str x0, [sp, #96]
    mov x0, x21
    add x1, sp, #88
    bl _kcc_vec_push
    b .Lcgi_done
@}

\paragraph{Function Return}
The \texttt{IR\_RET} handler closes the current function.  If the
return type is not void, the source vreg is loaded into \texttt{x0}
(the ABI return register).  For small frames ($\leq 504$ bytes)
the epilogue uses a post-indexed \textsc{ldp} that restores
\texttt{x29}/\texttt{x30} and deallocates the frame in one
instruction; for larger frames it uses a signed-offset \textsc{ldp}
followed by \texttt{ADD\;sp,\;sp,\;\#frame\_size}, mirroring the
large-frame prologue.  Both paths finish with \textsc{ret}.  The
504-byte limit ensures the \textsc{ldp} post-index immediate
($\mathit{frame}/8$) fits in a signed 7-bit field whose positive
range is $0$--$63$.

@d CodeGen: instruction dispatch @{
.Lcgi_ret:
    // Return: load return value to x0, emit epilogue
    ldr x23, [x19, #IR_SRC1]      // return value vreg (0 if void)

    // Check if this is a void return (no src1)
    ldr x24, [x19, #IR_TYPE]
    cbz x24, .Lcgi_ret_epilogue
    ldr x24, [x24]                 // type kind
    cmp x24, #1                    // TY_VOID = 1
    b.eq .Lcgi_ret_epilogue

    // Load return value to x0
    mov x0, x23
    mov x1, #0                     // target reg = x0
    bl _kcc_cg_load_vreg

.Lcgi_ret_epilogue:
    // Emit epilogue
    adrp x0, _kcc_cg_frame_size@@PAGE
    add  x0, x0, _kcc_cg_frame_size@@PAGEOFF
    ldr x24, [x0]

    cmp x24, #504
    b.hi .Lcgi_ret_large

    // Small frame: ldp x29, x30, [sp], #frame_size
    mov x0, #29
    mov x1, #30
    mov x2, #31
    lsr x3, x24, #3
    bl _kcc_enc_ldp_post
    bl _kcc_code_emit32
    b .Lcgi_ret_emit_ret

.Lcgi_ret_large:
    // Large frame: ldp x29, x30, [sp]  then  add sp, sp, #frame_size
    // ldp x29, x30, [sp, #0] — signed-offset form: 0xA9407BFD
    movz w0, #0x7BFD
    movk w0, #0xA940, lsl #16
    bl _kcc_code_emit32
    mov x0, #31                    // rd = sp
    mov x1, #31                    // rn = sp
    mov x2, x24                   // imm12 = frame_size
    mov x3, #1
    bl _kcc_enc_add_imm
    bl _kcc_code_emit32

.Lcgi_ret_emit_ret:
    // RET
    bl _kcc_enc_ret
    bl _kcc_code_emit32
    b .Lcgi_done
@}

\subsection{Function Calls and External References}

The call sequence is the most complex case.  For each
\texttt{IR\_CALL}:
\begin{enumerate}
\item Extract the argument count and load each argument vreg into
      \texttt{x0}--\texttt{x7} using the vreg-load helper.
\item If two or more arguments exist, push them onto the stack
      for variadic ABI compatibility (see the discussion at the
      start of this section).
\item Prefix the callee name with an underscore (Mach-O convention),
      register it as an external symbol, record a
      \texttt{BRANCH26} relocation, and emit \texttt{BL} with a
      zero offset (the linker fills in the real target).
\item Store x0 (the return value) to the destination vreg slot.
\item If we adjusted the stack, emit \texttt{ADD\;sp,\;sp,\;\#adj}
      to restore it.
\end{enumerate}

\texttt{IR\_GLOBAL\_REF} emits an \textsc{adrp}\,+\,\textsc{add}
pair with \texttt{PAGE21} and \texttt{PAGEOFF12} relocations,
storing the resulting address in x11.  The symbol is registered
via \texttt{kcc\_linker\_global\_sym}, which allocates space in
the \texttt{\_\_DATA,\_\_common} zerofill section.

\texttt{IR\_STRING\_LIT} delegates to the string literal handler
described in \S\ref{sec:emit-strings}.

@d CodeGen: instruction dispatch @{
.Lcgi_call:
    // Call: SRC1 = callee name, SRC2 = args array [count, vreg0, ...], DEST = result vreg
    // Apple ARM64 ABI: variadic args go on the stack, not in registers.
    // We pass all args in registers AND also push args[1..N-1] on the stack
    // so both variadic and non-variadic calls work correctly.
    ldr x23, [x19, #IR_SRC1]      // callee name
    ldr x24, [x19, #IR_DEST]      // result vreg
    ldr x26, [x19, #IR_SRC2]      // args array (or 0 if no args)

    // Get arg count into x22 (free after dispatch)
    mov x22, #0
    cbz x26, .Lcgi_call_load
    ldr x22, [x26]
.Lcgi_call_load:

    // Marshal arguments: load each arg vreg into x0-x7
    cbz x22, .Lcgi_call_args_done
    mov x27, #0
.Lcgi_call_arg_loop:
    cmp x27, x22
    b.ge .Lcgi_call_args_done
    cmp x27, #8
    b.ge .Lcgi_call_args_done
    add x0, x27, #1
    ldr x0, [x26, x0, lsl #3]     // vreg = args[index+1]
    mov x1, x27                    // target reg = x0-x7
    bl _kcc_cg_load_vreg
    add x27, x27, #1
    b .Lcgi_call_arg_loop
.Lcgi_call_args_done:

    // Push variadic args onto stack (args[1..N-1])
    cmp x22, #2
    b.lt .Lcgi_call_no_stack

    // stack_adj = align16((arg_count - 1) * 8)
    sub x0, x22, #1
    lsl x0, x0, #3
    add x0, x0, #15
    and x0, x0, #~15
    str x0, [sp, #88]             // save stack_adj

    // Emit: SUB sp, sp, #stack_adj
    mov x0, #31                    // rd = sp
    mov x1, #31                    // rn = sp
    ldr x2, [sp, #88]
    mov x3, #1
    bl _kcc_enc_sub_imm
    bl _kcc_code_emit32

    // Emit STR x<N>, [sp, #(N-1)*8] for each variadic arg
    mov x27, #1
.Lcgi_call_stack_loop:
    cmp x27, x22
    b.ge .Lcgi_call_no_stack
    cmp x27, #8
    b.ge .Lcgi_call_no_stack

    mov x0, x27                    // rt = x<arg_index> (already loaded)
    mov x1, #31                    // rn = sp
    sub x2, x27, #1               // imm12_scaled = (arg_index - 1)
    mov x3, #1                     // size = 64-bit
    bl _kcc_enc_str_imm
    bl _kcc_code_emit32

    add x27, x27, #1
    b .Lcgi_call_stack_loop
.Lcgi_call_no_stack:

    // Build Mach-O name with underscore prefix: "_" + name
    mov x0, x23
    bl _kcc_strlen
    add x0, x0, #2                // +1 prefix, +1 null
    bl _kcc_arena_alloc
    mov x25, x0
    mov w1, #'_'
    strb w1, [x25]
    mov x0, x23
    bl _kcc_strlen
    add x2, x0, #1               // len including null
    add x0, x25, #1              // dest = after '_'
    mov x1, x23                   // src = original name
    bl _kcc_memcpy

    // Add external symbol
    mov x0, x25
    bl _kcc_linker_extern
    mov x25, x0                    // sym_index

    // Record relocation at current position
    bl _kcc_code_current_pos
    mov x1, #ARM64_RELOC_BRANCH26
    mov x2, x25                    // sym_index
    bl _kcc_linker_add_reloc

    // Emit BL with offset=0 (linker will patch)
    mov x0, #0
    bl _kcc_enc_bl
    bl _kcc_code_emit32

    // Store return value (x0) to dest vreg slot
    mov x0, x24                    // dest vreg
    mov x1, #0                     // source reg = x0
    bl _kcc_cg_store_vreg

    // Restore stack if we pushed variadic args
    cmp x22, #2
    b.lt .Lcgi_done

    // Emit: ADD sp, sp, #stack_adj
    mov x0, #31
    mov x1, #31
    ldr x2, [sp, #88]
    mov x3, #1
    bl _kcc_enc_add_imm
    bl _kcc_code_emit32

    b .Lcgi_done

.Lcgi_call_ind:
    // Indirect call: SRC1 = fn-ptr vreg, SRC2 = args array, DEST = result vreg
    ldr x23, [x19, #IR_SRC1]      // fn-ptr vreg
    ldr x24, [x19, #IR_DEST]
    ldr x26, [x19, #IR_SRC2]

    // Get arg count
    mov x22, #0
    cbz x26, .Lcgi_cind_load
    ldr x22, [x26]
.Lcgi_cind_load:

    // Marshal arguments into x0-x7
    cbz x22, .Lcgi_cind_args_done
    mov x27, #0
.Lcgi_cind_arg_loop:
    cmp x27, x22
    b.ge .Lcgi_cind_args_done
    cmp x27, #8
    b.ge .Lcgi_cind_args_done
    add x0, x27, #1
    ldr x0, [x26, x0, lsl #3]
    mov x1, x27
    bl _kcc_cg_load_vreg
    add x27, x27, #1
    b .Lcgi_cind_arg_loop
.Lcgi_cind_args_done:

    // Push variadic args onto stack (same as direct call)
    cmp x22, #2
    b.lt .Lcgi_cind_no_stack

    sub x0, x22, #1
    lsl x0, x0, #3
    add x0, x0, #15
    and x0, x0, #~15
    str x0, [sp, #88]

    mov x0, #31
    mov x1, #31
    ldr x2, [sp, #88]
    mov x3, #1
    bl _kcc_enc_sub_imm
    bl _kcc_code_emit32

    mov x27, #1
.Lcgi_cind_stack_loop:
    cmp x27, x22
    b.ge .Lcgi_cind_no_stack
    cmp x27, #8
    b.ge .Lcgi_cind_no_stack

    mov x0, x27
    mov x1, #31
    sub x2, x27, #1
    mov x3, #1
    bl _kcc_enc_str_imm
    bl _kcc_code_emit32

    add x27, x27, #1
    b .Lcgi_cind_stack_loop
.Lcgi_cind_no_stack:

    // Load fn-ptr vreg into x9 (scratch)
    mov x0, x23
    mov x1, #9
    bl _kcc_cg_load_vreg

    // Emit BLR x9
    mov x0, #9
    bl _kcc_enc_blr
    bl _kcc_code_emit32

    // Store return value (x0) to dest vreg slot
    mov x0, x24
    mov x1, #0
    bl _kcc_cg_store_vreg

    // Restore stack if we pushed variadic args
    cmp x22, #2
    b.lt .Lcgi_done

    mov x0, #31
    mov x1, #31
    ldr x2, [sp, #88]
    mov x3, #1
    bl _kcc_enc_add_imm
    bl _kcc_code_emit32

    b .Lcgi_done
@}

\paragraph{Indirect Calls.}
\texttt{IR\_CALL\_IND} handles calls through function pointers.
The code generator loads the function pointer value from the
stack slot identified by \texttt{SRC1} into scratch register
\texttt{x9}, marshals arguments into \texttt{x0}--\texttt{x7}
(with variadic copies on the stack per Apple~ABI), and emits
\texttt{BLR~x9} instead of \texttt{BL~<symbol>}.

\paragraph{Global Variable References and String Literals}
\texttt{IR\_GLOBAL\_REF} materialises the address of a global
variable using the two-instruction \textsc{adrp}\,+\,\textsc{add}
idiom.  The symbol is registered via
\texttt{kcc\_linker\_global\_sym}, which allocates space in the
\texttt{\_\_DATA,\_\_common} zerofill section, and two relocations
(\texttt{PAGE21} and \texttt{PAGEOFF12}) are recorded so the
linker can patch the instruction pair at link time.
\texttt{IR\_STRING\_LIT} delegates to a dedicated handler
described in \S\ref{sec:emit-strings}.  The \texttt{.Lcgi\_done}
label restores callee-saved registers and returns.

@d CodeGen: instruction dispatch @{
.Lcgi_global_ref:
    // GLOBAL_REF: SRC1 = symbol name (char*), DEST = vreg to store addr
    ldr x23, [x19, #IR_SRC1]      // symbol name
    ldr x24, [x19, #IR_DEST]      // dest vreg

    // Build Mach-O name: "_" + name
    mov x0, x23
    bl _kcc_strlen
    add x0, x0, #2                // +1 for '_', +1 for null
    bl _kcc_arena_alloc
    mov x25, x0                    // x25 = prefixed name buffer
    mov w1, #'_'
    strb w1, [x25]
    mov x0, x23
    bl _kcc_strlen
    add x2, x0, #1               // len + null
    add x0, x25, #1              // dest = after '_'
    mov x1, x23                   // src = original name
    bl _kcc_memcpy

    // Defined in this TU, or an external reference (extern / another TU)?
    mov x0, x23
    bl _kcc_strlen
    mov x2, x0                     // keylen
    adrp x0, _kcc_cg_defined_globals@@PAGE
    add  x0, x0, _kcc_cg_defined_globals@@PAGEOFF
    ldr x0, [x0]
    mov x1, x23                    // key = source name
    bl _kcc_ht_get
    cbz x0, .Lcgi_gref_extern

    // Defined here: reserve BSS storage (section 2)
    mov x0, x25
    mov x1, #8                     // default 8 bytes per scalar global
    bl _kcc_linker_global_sym
    mov x25, x0                    // sym_index
    b .Lcgi_gref_reloc

.Lcgi_gref_extern:
    // Defined elsewhere: emit an undefined external symbol for the linker
    mov x0, x25
    bl _kcc_linker_extern
    mov x25, x0                    // sym_index

.Lcgi_gref_reloc:

    // Emit ADRP x11, symbol@@PAGE (with PAGE21 reloc)
    bl _kcc_code_current_pos
    mov x0, x0                     // offset
    mov x1, #ARM64_RELOC_PAGE21
    mov x2, x25                    // sym_index
    bl _kcc_linker_add_reloc

    mov x0, #CG_REG_DST           // rd = x11
    mov x1, #0                     // imm21 = 0 (linker patches)
    bl _kcc_enc_adrp
    bl _kcc_code_emit32

    // Emit ADD x11, x11, symbol@@PAGEOFF (with PAGEOFF12 reloc)
    bl _kcc_code_current_pos
    mov x0, x0                     // offset
    mov x1, #ARM64_RELOC_PAGEOFF12
    mov x2, x25                    // sym_index
    bl _kcc_linker_add_reloc

    mov x0, #CG_REG_DST           // rd = x11
    mov x1, #CG_REG_DST           // rn = x11
    mov x2, #0                     // imm12 = 0 (linker patches)
    mov x3, #1                     // sf = 64-bit
    bl _kcc_enc_add_imm
    bl _kcc_code_emit32

    // Store x11 (address of global) to dest vreg slot
    mov x0, x24
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg
    b .Lcgi_done

.Lcgi_string_lit:
    mov x0, x19                    // instruction
    bl _kcc_codegen_string_lit
    b .Lcgi_done

.Lcgi_done:
    ldr x27, [sp, #80]
    ldp x25, x26, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #112
    ret
@}

\paragraph{End-to-end tests: constants and arithmetic.}
The code generator lowers each arithmetic \texttt{IR\_ADD}/\texttt{IR\_SUB}/\ldots{}
instruction by loading the two source vregs from their stack slots into
scratch registers \texttt{x9} and \texttt{x10}, executing the ARM64
operation, and storing the result from \texttt{x11} back to the
destination slot.  The simplest case---returning a constant---verifies
that \texttt{IR\_CONST} correctly encodes a \texttt{MOVZ}/\texttt{MOVK}
sequence and that \texttt{IR\_RET} loads the value into \texttt{x0}
before the epilogue.  Subsequent tests exercise each binary operator
and confirm that operator precedence (handled at the parser level) is
preserved through IR lowering.

@d Test: codegen constants @{
echo ""
echo "--- Constants and Arithmetic ---"

run_test "return constant" \
    "int main(void) { return 42; }" 42

run_test "addition" \
    "int main(void) { return 2 + 3; }" 5

run_test "subtraction" \
    "int main(void) { return 10 - 3; }" 7

run_test "multiplication" \
    "int main(void) { return 6 * 7; }" 42

run_test "division" \
    "int main(void) { return 100 / 10; }" 10

run_test "modulo" \
    "int main(void) { return 17 % 5; }" 2

run_test "complex arithmetic" \
    "int main(void) { return 2 + 3 * 4; }" 14

run_test "negation" \
    "int main(void) { return -(-42); }" 42

run_test "bitwise and" \
    "int main(void) { return 0xFF & 0x0F; }" 15

run_test "bitwise or" \
    "int main(void) { return 0xF0 | 0x0F; }" 255

run_test "bitwise xor" \
    "int main(void) { return 0xFF ^ 0x0F; }" 240

run_test "left shift" \
    "int main(void) { return 1 << 4; }" 16

run_test "right shift" \
    "int main(void) { return 32 >> 2; }" 8
@}

\section{Branch Patching}

After all basic blocks have been emitted, we resolve forward branch
references.  Each entry in the patch vector contains a code offset
and a target BB~ID.  We look up the target in the label hash table,
compute the signed byte offset, and call \texttt{code\_patch32} to
overwrite the placeholder.  Two instruction formats need handling:
\textsc{b} (where the offset occupies the low 26~bits) and
\textsc{cbnz} (where the 19-bit offset sits at bits [23:5]).
We distinguish the two by reading the existing instruction and
checking bit~24.

@d CodeGen: patch branches @{
// -- kcc_codegen_patch_branches -----------------------------------------------
// void kcc_codegen_patch_branches(ht *bb_labels, vec *patches)
//   x0 = bb_labels hash table
//   x1 = patch vec
.text
.globl _kcc_codegen_patch_branches
.p2align 2
_kcc_codegen_patch_branches:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    str x23, [sp, #48]

    mov x19, x0                    // bb_labels ht
    mov x20, x1                    // patch vec
    ldr x21, [x20, #VEC_COUNT]    // patch count
    mov x22, #0                    // index

.Lcpb_loop:
    cmp x22, x21
    b.ge .Lcpb_done

    // Get patch entry
    mov x0, x20
    mov x1, x22
    bl _kcc_vec_get
    mov x23, x0                    // pointer to patch entry

    ldr x0, [x23, #PATCH_OFFSET]  // code offset of branch instr
    ldr x1, [x23, #PATCH_TARGET]  // target BB_ID

    // Look up target BB offset
    str x1, [sp, #56]             // store bb_id as key
    mov x0, x19                    // ht
    add x1, sp, #56               // key
    mov x2, #8                     // keylen
    bl _kcc_ht_get
    cbz x0, .Lcpb_next            // target not found (shouldn't happen)
    sub x0, x0, #1                // undo +1 encoding → target_offset

    // Read original instruction to determine type
    ldr x1, [x23, #PATCH_OFFSET]  // branch_offset
    adrp x2, _kcc_code_buf@@PAGE
    add  x2, x2, _kcc_code_buf@@PAGEOFF
    ldr x2, [x2]
    ldr w3, [x2, x1]              // original instruction

    // Compute offset in bytes: target - branch_pos
    sub x4, x0, x1                // offset_bytes = target_offset - branch_offset

    // Check instruction type: B (0x14) vs CBNZ (0xB5) vs CBZ (0xB4)
    lsr w5, w3, #24
    cmp w5, #0x14                  // B?
    b.eq .Lcpb_patch_b
    cmp w5, #0xB5                  // CBNZ 64-bit?
    b.eq .Lcpb_patch_cbnz
    cmp w5, #0x35                  // CBNZ 32-bit?
    b.eq .Lcpb_patch_cbnz
    // Default: treat as B
    b .Lcpb_patch_b

.Lcpb_patch_b:
    // Re-encode B with correct offset
    mov x0, x4                     // offset_bytes
    bl _kcc_enc_b
    // Patch
    ldr x1, [x23, #PATCH_OFFSET]
    mov x1, x1
    mov w1, w0                     // new instruction in w1... wait
    // kcc_code_patch32(offset, word): x0=offset, x1=word
    mov w2, w0                     // save encoded instruction
    ldr x0, [x23, #PATCH_OFFSET]
    mov w1, w2
    bl _kcc_code_patch32
    b .Lcpb_next

.Lcpb_patch_cbnz:
    // Re-encode CBNZ: keep rt and sf from original, update imm19
    and w5, w3, #0x1F              // extract Rt
    asr x6, x4, #2                // offset in instructions
    and w6, w6, #0x7FFFF          // imm19
    mov w7, #0xB5000000            // CBNZ 64-bit base
    orr w7, w7, w6, lsl #5        // imm19
    orr w7, w7, w5                // Rt
    // Patch
    ldr x0, [x23, #PATCH_OFFSET]
    mov w1, w7
    bl _kcc_code_patch32
    b .Lcpb_next

.Lcpb_next:
    add x22, x22, #1
    b .Lcpb_loop

.Lcpb_done:
    ldr x23, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@| _kcc_codegen_patch_branches
@}

\section{String Literal Codegen}
\label{sec:emit-strings}

String literals require two things that no other IR instruction
needs: persistent data that outlives the instruction, and a
PC-relative pointer to that data.  Our approach avoids adding a
separate Mach-O section (which would change section counts,
segment sizes, and symbol numbering): we append the raw string
bytes to the \emph{end} of the \texttt{\_\_text} section, after
all machine code.

The scheme works in two phases:

\paragraph{Phase~1: per-instruction (\texttt{kcc\_codegen\_string\_lit}).}
Each \texttt{IR\_STRING\_LIT} instruction triggers the following
steps:
\begin{enumerate}
\item Copy the string bytes (already escape-processed by the
      parser) into the \emph{cstring buffer}, a 4\,KB arena
      allocation, and append a null terminator.
\item Mint a local symbol name \texttt{l\_.str.\textit{N}} using
      a monotonically increasing counter.  Because the final
      offset is not yet known, the symbol is created with
      \texttt{value\,=\,0}.
\item Record a fixup entry $(\mathit{sym\_index},
      \mathit{cstr\_offset})$ so the value can be patched later.
\item Emit an \textsc{adrp}\,+\,\textsc{add} pair with
      \texttt{PAGE21} and \texttt{PAGEOFF12} relocations.
      The linker will resolve these to the symbol's final
      address.
\item Store the resulting pointer (in~x11) to the destination
      vreg's stack slot.
\end{enumerate}

\paragraph{Phase~2: finalization (\texttt{kcc\_codegen\_emit\_strings}).}
Called from the driver after \texttt{kcc\_codegen\_all} and before
\texttt{kcc\_macho\_init}:
\begin{enumerate}
\item Record the current code position as the boundary between
      machine code and string data.
\item Walk the fixup vector and set each symbol's value to
      $\mathit{code\_size} + \mathit{cstr\_offset}$.
\item Copy the entire cstring buffer to the end of the code
      buffer (growing it if necessary).
\end{enumerate}

The result is a single contiguous \texttt{\_\_text} section where
the first part is executable instructions and the tail is read-only
string data—exactly the layout that Apple's linker expects.

@d CodeGen: emit strings @{
// -- kcc_codegen_string_lit ---------------------------------------------------
// void kcc_codegen_string_lit(ir_instr *instr)
// Handles IR_STRING_LIT: copies string to cstring buffer, creates a
// local symbol with ADRP+ADD relocations, stores pointer to dest vreg.
.text
.globl _kcc_codegen_string_lit
.p2align 2
_kcc_codegen_string_lit:
    stp x29, x30, [sp, #-96]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    stp x25, x26, [sp, #64]

    mov x19, x0                    // instr
    ldr x20, [x19, #IR_SRC1]      // string data ptr
    ldr x21, [x19, #IR_SRC2]      // string length
    ldr x22, [x19, #IR_DEST]      // dest vreg

    // 1. Get current cstring buffer position
    adrp x0, _kcc_cstr_pos@@PAGE
    add  x0, x0, _kcc_cstr_pos@@PAGEOFF
    ldr x23, [x0]                  // x23 = cstr_offset

    // 2. Copy string data to cstring buffer
    adrp x0, _kcc_cstr_buf@@PAGE
    add  x0, x0, _kcc_cstr_buf@@PAGEOFF
    ldr x0, [x0]
    add x0, x0, x23                // dest = buf + offset
    mov x1, x20                    // src = string data
    mov x2, x21                    // len
    cbz x2, .Lcgsl_nullterm
    bl _kcc_memcpy

.Lcgsl_nullterm:
    // 3. Null-terminate
    adrp x0, _kcc_cstr_buf@@PAGE
    add  x0, x0, _kcc_cstr_buf@@PAGEOFF
    ldr x0, [x0]
    add x1, x23, x21
    strb wzr, [x0, x1]

    // 4. Advance cstr_pos
    add x24, x23, x21
    add x24, x24, #1
    adrp x0, _kcc_cstr_pos@@PAGE
    add  x0, x0, _kcc_cstr_pos@@PAGEOFF
    str x24, [x0]
@| _kcc_codegen_string_lit
@}

\paragraph{Symbol Name Construction and Relocation Emission}
With the string bytes safely buffered, the next step is to give
the literal a linker-visible identity.  The code mints a local
symbol name of the form \texttt{l\_.str.\textit{N}} by
incrementing a monotonic counter and converting it to decimal
with a digit-reversal loop.  It then registers the symbol
(\texttt{N\_SECT\,|\,N\_EXT}, section~1, value~0 as a
placeholder), records a fixup pair $(\mathit{sym\_index},
\mathit{cstr\_offset})$, and emits the
\textsc{adrp}\,+\,\textsc{add} relocation sequence that will let
the linker resolve the pointer at link time.

@d CodeGen: emit strings @{
    // 5. Build symbol name "l_.str.N"
    adrp x0, _kcc_cstr_count@@PAGE
    add  x0, x0, _kcc_cstr_count@@PAGEOFF
    ldr x24, [x0]                  // x24 = N
    add x1, x24, #1
    str x1, [x0]                   // count++

    mov x0, #20
    bl _kcc_arena_alloc
    mov x25, x0                    // x25 = name buffer

    // Write "l_.str." prefix (7 bytes)
    mov w1, #'l'
    strb w1, [x25, #0]
    mov w1, #'_'
    strb w1, [x25, #1]
    mov w1, #'.'
    strb w1, [x25, #2]
    mov w1, #'s'
    strb w1, [x25, #3]
    mov w1, #'t'
    strb w1, [x25, #4]
    mov w1, #'r'
    strb w1, [x25, #5]
    mov w1, #'.'
    strb w1, [x25, #6]

    // Convert N to decimal at offset 7
    add x0, x25, #7
    mov x1, x24
    cbz x1, .Lcgsl_zero

    mov x2, x0
.Lcgsl_cvt:
    cbz x1, .Lcgsl_rev
    mov x3, #10
    udiv x4, x1, x3
    msub x5, x4, x3, x1
    add w5, w5, #'0'
    strb w5, [x0], #1
    mov x1, x4
    b .Lcgsl_cvt

.Lcgsl_rev:
    strb wzr, [x0]
    sub x3, x0, #1
.Lcgsl_rvlp:
    cmp x2, x3
    b.ge .Lcgsl_named
    ldrb w4, [x2]
    ldrb w5, [x3]
    strb w5, [x2], #1
    strb w4, [x3], #-1
    b .Lcgsl_rvlp

.Lcgsl_zero:
    mov w1, #'0'
    strb w1, [x0]
    strb wzr, [x0, #1]

.Lcgsl_named:
    // 6. Add symbol: section 1, value 0 (fixed up later)
    mov x0, x25
    mov x1, #1                    // section = 1 (__text)
    mov x2, #0                    // value = 0 (placeholder)
    mov x3, #(N_SECT | N_EXT)
    bl _kcc_linker_add_sym
    mov x26, x0                    // x26 = sym_index

    // 7. Record fixup {sym_index, cstr_offset}
    str x26, [sp, #80]
    str x23, [sp, #88]
    adrp x0, _kcc_cstr_fixups@@PAGE
    add  x0, x0, _kcc_cstr_fixups@@PAGEOFF
    ldr x0, [x0]
    add x1, sp, #80
    bl _kcc_vec_push

    // 8. Emit ADRP x11, sym@@PAGE
    bl _kcc_code_current_pos
    mov x1, #ARM64_RELOC_PAGE21
    mov x2, x26
    bl _kcc_linker_add_reloc

    mov x0, #CG_REG_DST
    mov x1, #0
    bl _kcc_enc_adrp
    bl _kcc_code_emit32

    // 9. Emit ADD x11, x11, sym@@PAGEOFF
    bl _kcc_code_current_pos
    mov x1, #ARM64_RELOC_PAGEOFF12
    mov x2, x26
    bl _kcc_linker_add_reloc

    mov x0, #CG_REG_DST
    mov x1, #CG_REG_DST
    mov x2, #0
    mov x3, #1
    bl _kcc_enc_add_imm
    bl _kcc_code_emit32

    // 10. Store x11 to dest vreg
    mov x0, x22
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg

    ldp x25, x26, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #96
    ret
@}

\paragraph{String Data Finalization}
After all functions have been compiled, the string data must be
appended to the code buffer so that the \textsc{adrp}\,+\,\textsc{add}
relocations resolve to valid addresses within the \texttt{\_\_text}
section.  The finalization pass first records the current code
position as the boundary between executable instructions and
read-only data.  It then walks the fixup vector and patches each
string symbol's value to $\mathit{code\_size} +
\mathit{cstr\_offset}$.  Finally, it copies the accumulated
cstring buffer to the tail of the code buffer, growing the
buffer if the combined size exceeds its capacity.

@d CodeGen: emit strings @{
// -- kcc_codegen_emit_strings -------------------------------------------------
// void kcc_codegen_emit_strings(void)
// Fixes up string symbol values and appends cstring data to code buffer.
// Must be called after kcc_codegen_all() and before kcc_macho_init().
.text
.globl _kcc_codegen_emit_strings
.p2align 2
_kcc_codegen_emit_strings:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]

    // Check if any strings were emitted
    adrp x0, _kcc_cstr_pos@@PAGE
    add  x0, x0, _kcc_cstr_pos@@PAGEOFF
    ldr x0, [x0]
    cbz x0, .Lces_done

    // 1. Boundary between code and cstring data
    bl _kcc_code_current_pos
    mov x19, x0                    // x19 = code_size

    // 2. Patch each string symbol's value
    adrp x0, _kcc_cstr_fixups@@PAGE
    add  x0, x0, _kcc_cstr_fixups@@PAGEOFF
    ldr x20, [x0]                  // fixup vec
    ldr x21, [x20, #VEC_COUNT]
    mov x22, #0

.Lces_fixup_loop:
    cmp x22, x21
    b.ge .Lces_append

    mov x0, x20
    mov x1, x22
    bl _kcc_vec_get
    ldr x23, [x0]                  // sym_index
    ldr x24, [x0, #8]             // cstr_offset

    // value = code_size + cstr_offset
    add x24, x19, x24

    // Update symbol entry
    adrp x0, _kcc_linker_syms@@PAGE
    add  x0, x0, _kcc_linker_syms@@PAGEOFF
    ldr x0, [x0]
    ldr x0, [x0, #VEC_DATA]
    mov x1, #SYM_ENTRY_SIZE
    mul x1, x23, x1
    add x0, x0, x1
    str x24, [x0, #SYM_VALUE]

    add x22, x22, #1
    b .Lces_fixup_loop

.Lces_append:
    // 3. Append cstring data to code buffer
    adrp x0, _kcc_cstr_pos@@PAGE
    add  x0, x0, _kcc_cstr_pos@@PAGEOFF
    ldr x23, [x0]                  // cstr total size

    adrp x0, _kcc_code_pos@@PAGE
    add  x0, x0, _kcc_code_pos@@PAGEOFF
    ldr x20, [x0]                  // code_pos

    adrp x0, _kcc_code_cap@@PAGE
    add  x0, x0, _kcc_code_cap@@PAGEOFF
    ldr x21, [x0]                  // code_cap

    // Grow if needed
    add x24, x20, x23
    cmp x24, x21
    b.le .Lces_copy

    lsl x0, x24, #1
    adrp x1, _kcc_code_cap@@PAGE
    add  x1, x1, _kcc_code_cap@@PAGEOFF
    str x0, [x1]
    bl _kcc_arena_alloc
    mov x21, x0

    adrp x0, _kcc_code_buf@@PAGE
    add  x0, x0, _kcc_code_buf@@PAGEOFF
    ldr x1, [x0]
    str x21, [x0]

    mov x0, x21
    mov x2, x20
    bl _kcc_memcpy

.Lces_copy:
    adrp x0, _kcc_code_buf@@PAGE
    add  x0, x0, _kcc_code_buf@@PAGEOFF
    ldr x0, [x0]
    add x0, x0, x20

    adrp x1, _kcc_cstr_buf@@PAGE
    add  x1, x1, _kcc_cstr_buf@@PAGEOFF
    ldr x1, [x1]

    mov x2, x23
    bl _kcc_memcpy

    // Update code_pos
    add x20, x20, x23
    adrp x0, _kcc_code_pos@@PAGE
    add  x0, x0, _kcc_code_pos@@PAGEOFF
    str x20, [x0]

.Lces_done:
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@| _kcc_codegen_emit_strings
@}

\section{CodeGen Data}

Module-level mutable state for the code generator: the current
function's frame size (set per-function, read by the instruction
dispatcher for alloca and epilogue emission) and four words for
the cstring subsystem---the data buffer, write position, literal
counter, and fixup vector pointer.

@d CodeGen: data @{
// -- CodeGen data -------------------------------------------------------------
.data
.p2align 3
.globl _kcc_cg_frame_size
_kcc_cg_frame_size:  .quad 0     // current function's frame size
.globl _kcc_cg_vreg_count
_kcc_cg_vreg_count:  .quad 0     // current function's vreg count
.globl _kcc_cstr_buf
_kcc_cstr_buf:       .quad 0     // cstring data buffer
.globl _kcc_cstr_pos
_kcc_cstr_pos:       .quad 0     // write position in cstring buffer
.globl _kcc_cstr_count
_kcc_cstr_count:     .quad 0     // string literal counter (for naming)
.globl _kcc_cstr_fixups
