% 32-ir-builder.weft — AST to IR Lowering and IR Dump
%
% This chapter walks the typed AST and produces linear IR with
% virtual registers and basic blocks.  It also provides the textual
% dump for --dump-ir.

\chapter{IR Builder}
\label{ch:ir-builder}

With the IR data structures defined in Chapter~\ref{ch:ir-design}, we now need machinery to translate the typed AST into linear IR.  This chapter implements the IR builder, which walks the AST recursively and emits IR instructions for each expression, statement, and declaration.  Control-flow constructs (\texttt{if}/\texttt{else}, \texttt{while}, \texttt{for}, \texttt{do}/\texttt{while}, \texttt{break}/\texttt{continue}) are lowered into conditional and unconditional branches between basic blocks.  The chapter also provides the textual dump used by the \texttt{--dump-ir} flag for debugging.

\section{IR Dump}

We implement the dump first so that we can test the builder
incrementally.  The format mirrors LLVM IR loosely:
\begin{verbatim}
func @main() -> i32:
  bb0:
    %0 = const i32 42
    ret i32 %0
\end{verbatim}

@d IR: dump @{
// -- kcc_ir_dump ----------------------------------------------------------
// void kcc_ir_dump(void)
// Prints all IR functions in textual form.
.text
.globl _kcc_ir_dump
.p2align 2
_kcc_ir_dump:
    stp x29, x30, [sp, #-96]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    stp x25, x26, [sp, #64]

    // Load function list vec
    adrp x0, _kcc_ir_funcs@@PAGE
    add  x0, x0, _kcc_ir_funcs@@PAGEOFF
    ldr x19, [x0]               // x19 = vec ptr
    cbz x19, .Lird_done

    ldr x20, [x19, #VEC_COUNT]  // x20 = func count
    mov x21, #0                 // x21 = index

.Lird_func_loop:
    cmp x21, x20
    b.ge .Lird_done

    // Get func pointer: vec_get(vec, index)
    mov x0, x19
    mov x1, x21
    bl _kcc_vec_get
    ldr x22, [x0]              // x22 = IR func ptr (deref pointer elem)

    // Print "func @@"
    adrp x0, _kcc_ir_str_func@@PAGE
    add  x0, x0, _kcc_ir_str_func@@PAGEOFF
    bl _kcc_io_puts

    // Print function name
    ldr x0, [x22, #IRF_NAME]
    bl _kcc_io_puts

    // Print "() -> "
    adrp x0, _kcc_ir_str_arrow@@PAGE
    add  x0, x0, _kcc_ir_str_arrow@@PAGEOFF
    bl _kcc_io_puts

    // Print return type
    ldr x0, [x22, #IRF_RETTYPE]
    bl _kcc_ir_dump_type_short

    // Print ":"
    adrp x0, _kcc_ir_str_colon_nl@@PAGE
    add  x0, x0, _kcc_ir_str_colon_nl@@PAGEOFF
    bl _kcc_io_puts

    // Walk basic blocks via the blocks vec
    ldr x0, [x22, #IRF_BLOCKS]
    cbz x0, .Lird_next_func
    // Save blocks vec info in callee-saved regs
    // We reuse x22 temporarily - save func ptr on stack
    str x22, [sp, #80]          // save func ptr in free stack slot
    mov x22, x0                 // x22 = blocks vec
    ldr x23, [x22, #VEC_COUNT]
    mov x24, #0

.Lird_bb_loop:
    cmp x24, x23
    b.ge .Lird_bb_done

    mov x0, x22
    mov x1, x24
    bl _kcc_vec_get
    ldr x25, [x0]              // x25 = BB ptr

    // Print "  bb"
    adrp x0, _kcc_ir_str_bb@@PAGE
    add  x0, x0, _kcc_ir_str_bb@@PAGEOFF
    bl _kcc_io_puts

    // Print BB id
    ldr x0, [x25, #BB_ID]
    bl _kcc_io_putu

    // Print ":"
    adrp x0, _kcc_ir_str_colon_nl@@PAGE
    add  x0, x0, _kcc_ir_str_colon_nl@@PAGEOFF
    bl _kcc_io_puts

    // Walk instructions in this BB
    ldr x26, [x25, #BB_FIRST]

.Lird_instr_loop:
    cbz x26, .Lird_next_bb

    mov x0, x26
    bl _kcc_ir_dump_instr

    ldr x26, [x26, #IR_NEXT]
    b .Lird_instr_loop

.Lird_next_bb:
    add x24, x24, #1
    b .Lird_bb_loop

.Lird_bb_done:
    ldr x22, [sp, #80]         // restore func ptr
    // Print blank line between functions
    mov x0, #'\n'
    bl _kcc_io_putc

.Lird_next_func:
    add x21, x21, #1
    b .Lird_func_loop

.Lird_done:
    bl _kcc_io_flush
    ldp x25, x26, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #96
    ret
@| _kcc_ir_dump
@}

\subsection{Dumping a Single Instruction}

Each instruction is printed on one line with four-space indentation.
The general format is
\texttt{\%\textit{dest}\;=\;\textit{op}\;\textit{type}\;\textit{src1},\;\textit{src2}},
though the exact layout varies by opcode: branches print
\texttt{bb\textit{N}} targets, calls print the callee name and
argument list, and side-effect-only instructions (\textsc{store},
\textsc{ret}, \textsc{br}) omit the destination.

@d IR: dump instruction @{
// -- kcc_ir_dump_instr ----------------------------------------------------
// void kcc_ir_dump_instr(ir_instr *instr)
//   x0 = instruction pointer
// Prints one instruction line with leading "    " indent.
.text
.globl _kcc_ir_dump_instr
.p2align 2
_kcc_ir_dump_instr:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]

    mov x19, x0                // x19 = instr
    ldr x20, [x19, #IR_OP]     // x20 = opcode

    // Print indent
    adrp x0, _kcc_ir_str_indent@@PAGE
    add  x0, x0, _kcc_ir_str_indent@@PAGEOFF
    bl _kcc_io_puts

    // Opcodes that don't produce a dest: store, br, br_cond, ret, nop
    cmp x20, #IR_STORE
    b.eq .Lidi_no_dest
    cmp x20, #IR_BR
    b.eq .Lidi_no_dest
    cmp x20, #IR_BR_COND
    b.eq .Lidi_no_dest
    cmp x20, #IR_RET
    b.eq .Lidi_no_dest
    cmp x20, #IR_NOP
    b.eq .Lidi_no_dest

    // Print "%N = "
    mov x0, #'%'
    bl _kcc_io_putc
    ldr x0, [x19, #IR_DEST]
    bl _kcc_io_putu
    adrp x0, _kcc_ir_str_eq@@PAGE
    add  x0, x0, _kcc_ir_str_eq@@PAGEOFF
    bl _kcc_io_puts

.Lidi_no_dest:
    // Dispatch on opcode
    cmp x20, #IR_ADD
    b.eq .Lidi_add
    cmp x20, #IR_SUB
    b.eq .Lidi_sub
    cmp x20, #IR_MUL
    b.eq .Lidi_mul
    cmp x20, #IR_SDIV
    b.eq .Lidi_sdiv
    cmp x20, #IR_UDIV
    b.eq .Lidi_udiv
    cmp x20, #IR_SMOD
    b.eq .Lidi_smod
    cmp x20, #IR_UMOD
    b.eq .Lidi_umod
    cmp x20, #IR_NEG
    b.eq .Lidi_neg
    cmp x20, #IR_AND
    b.eq .Lidi_and
    cmp x20, #IR_OR
    b.eq .Lidi_or
    cmp x20, #IR_XOR
    b.eq .Lidi_xor
    cmp x20, #IR_SHL
    b.eq .Lidi_shl
    cmp x20, #IR_LSHR
    b.eq .Lidi_lshr
    cmp x20, #IR_ASHR
    b.eq .Lidi_ashr
    cmp x20, #IR_NOT
    b.eq .Lidi_not
    cmp x20, #IR_CMP_EQ
    b.eq .Lidi_cmp_eq
    cmp x20, #IR_CMP_NE
    b.eq .Lidi_cmp_ne
    cmp x20, #IR_CMP_SLT
    b.eq .Lidi_cmp_slt
    cmp x20, #IR_CMP_SLE
    b.eq .Lidi_cmp_sle
    cmp x20, #IR_CMP_SGT
    b.eq .Lidi_cmp_sgt
    cmp x20, #IR_CMP_SGE
    b.eq .Lidi_cmp_sge
    cmp x20, #IR_LOAD
    b.eq .Lidi_load
    cmp x20, #IR_STORE
    b.eq .Lidi_store
    cmp x20, #IR_ALLOCA
    b.eq .Lidi_alloca
    cmp x20, #IR_GEP
    b.eq .Lidi_gep
    cmp x20, #IR_BR
    b.eq .Lidi_br
    cmp x20, #IR_BR_COND
    b.eq .Lidi_br_cond
    cmp x20, #IR_RET
    b.eq .Lidi_ret
    cmp x20, #IR_CALL
    b.eq .Lidi_call
    cmp x20, #IR_SEXT
    b.eq .Lidi_sext
    cmp x20, #IR_ZEXT
    b.eq .Lidi_zext
    cmp x20, #IR_TRUNC
    b.eq .Lidi_trunc
    cmp x20, #IR_CONST
    b.eq .Lidi_const
    cmp x20, #IR_NOP
    b.eq .Lidi_nop
    cmp x20, #IR_GLOBAL_REF
    b.eq .Lidi_global_ref
    cmp x20, #IR_STRING_LIT
    b.eq .Lidi_string_lit

    // Unknown opcode
    adrp x0, _kcc_ir_str_unknown@@PAGE
    add  x0, x0, _kcc_ir_str_unknown@@PAGEOFF
    bl _kcc_io_puts
    b .Lidi_nl
@| _kcc_ir_dump_instr
@}

\paragraph{Binary and Comparison Operations}

Every arithmetic, bitwise, and comparison opcode follows the same
printing pattern: load the opcode's string label into \texttt{x0}
and branch to the shared \texttt{.Lidi\_binop} handler.  That handler
emits the format \texttt{op type \%src1, \%src2}, reading the type
descriptor from \texttt{IR\_TYPE} and both source virtual registers
from \texttt{IR\_SRC1} and \texttt{IR\_SRC2}.  Arithmetic opcodes
(\textsc{add}, \textsc{sub}, \textsc{mul}, \textsc{sdiv}/\textsc{udiv},
\textsc{smod}/\textsc{umod}) come first, followed by bitwise
(\textsc{and}, \textsc{or}, \textsc{xor}, \textsc{shl},
\textsc{lshr}, \textsc{ashr}) and the six signed comparison
predicates (\textsc{cmp\_eq} through \textsc{cmp\_sge}).

@d IR: dump instruction @{
// -- Binary ops: "op type %src1, %src2" -----------------------------------
.Lidi_add:
    adrp x0, _kcc_ir_op_add@@PAGE
    add  x0, x0, _kcc_ir_op_add@@PAGEOFF
    b .Lidi_binop
.Lidi_sub:
    adrp x0, _kcc_ir_op_sub@@PAGE
    add  x0, x0, _kcc_ir_op_sub@@PAGEOFF
    b .Lidi_binop
.Lidi_mul:
    adrp x0, _kcc_ir_op_mul@@PAGE
    add  x0, x0, _kcc_ir_op_mul@@PAGEOFF
    b .Lidi_binop
.Lidi_sdiv:
    adrp x0, _kcc_ir_op_sdiv@@PAGE
    add  x0, x0, _kcc_ir_op_sdiv@@PAGEOFF
    b .Lidi_binop
.Lidi_udiv:
    adrp x0, _kcc_ir_op_udiv@@PAGE
    add  x0, x0, _kcc_ir_op_udiv@@PAGEOFF
    b .Lidi_binop
.Lidi_smod:
    adrp x0, _kcc_ir_op_smod@@PAGE
    add  x0, x0, _kcc_ir_op_smod@@PAGEOFF
    b .Lidi_binop
.Lidi_umod:
    adrp x0, _kcc_ir_op_umod@@PAGE
    add  x0, x0, _kcc_ir_op_umod@@PAGEOFF
    b .Lidi_binop
.Lidi_and:
    adrp x0, _kcc_ir_op_and@@PAGE
    add  x0, x0, _kcc_ir_op_and@@PAGEOFF
    b .Lidi_binop
.Lidi_or:
    adrp x0, _kcc_ir_op_or@@PAGE
    add  x0, x0, _kcc_ir_op_or@@PAGEOFF
    b .Lidi_binop
.Lidi_xor:
    adrp x0, _kcc_ir_op_xor@@PAGE
    add  x0, x0, _kcc_ir_op_xor@@PAGEOFF
    b .Lidi_binop
.Lidi_shl:
    adrp x0, _kcc_ir_op_shl@@PAGE
    add  x0, x0, _kcc_ir_op_shl@@PAGEOFF
    b .Lidi_binop
.Lidi_lshr:
    adrp x0, _kcc_ir_op_lshr@@PAGE
    add  x0, x0, _kcc_ir_op_lshr@@PAGEOFF
    b .Lidi_binop
.Lidi_ashr:
    adrp x0, _kcc_ir_op_ashr@@PAGE
    add  x0, x0, _kcc_ir_op_ashr@@PAGEOFF
    b .Lidi_binop
.Lidi_cmp_eq:
    adrp x0, _kcc_ir_op_cmp_eq@@PAGE
    add  x0, x0, _kcc_ir_op_cmp_eq@@PAGEOFF
    b .Lidi_binop
.Lidi_cmp_ne:
    adrp x0, _kcc_ir_op_cmp_ne@@PAGE
    add  x0, x0, _kcc_ir_op_cmp_ne@@PAGEOFF
    b .Lidi_binop
.Lidi_cmp_slt:
    adrp x0, _kcc_ir_op_cmp_slt@@PAGE
    add  x0, x0, _kcc_ir_op_cmp_slt@@PAGEOFF
    b .Lidi_binop
.Lidi_cmp_sle:
    adrp x0, _kcc_ir_op_cmp_sle@@PAGE
    add  x0, x0, _kcc_ir_op_cmp_sle@@PAGEOFF
    b .Lidi_binop
.Lidi_cmp_sgt:
    adrp x0, _kcc_ir_op_cmp_sgt@@PAGE
    add  x0, x0, _kcc_ir_op_cmp_sgt@@PAGEOFF
    b .Lidi_binop
.Lidi_cmp_sge:
    adrp x0, _kcc_ir_op_cmp_sge@@PAGE
    add  x0, x0, _kcc_ir_op_cmp_sge@@PAGEOFF
    b .Lidi_binop

.Lidi_binop:
    bl _kcc_io_puts
    // Print " type %src1, %src2"
    mov x0, #' '
    bl _kcc_io_putc
    ldr x0, [x19, #IR_TYPE]
    bl _kcc_ir_dump_type_short
    mov x0, #' '
    bl _kcc_io_putc
    mov x0, #'%'
    bl _kcc_io_putc
    ldr x0, [x19, #IR_SRC1]
    bl _kcc_io_putu
    adrp x0, _kcc_ir_str_comma@@PAGE
    add  x0, x0, _kcc_ir_str_comma@@PAGEOFF
    bl _kcc_io_puts
    mov x0, #'%'
    bl _kcc_io_putc
    ldr x0, [x19, #IR_SRC2]
    bl _kcc_io_putu
    b .Lidi_nl
@}

\paragraph{Unary and Type-Conversion Operations}

Unary instructions---\textsc{neg}, \textsc{not}, and the three
width-changing casts \textsc{sext}, \textsc{zext}, \textsc{trunc}---use
the shared \texttt{.Lidi\_unop} handler.  The output format is
\texttt{op type \%src1}, identical to the binary pattern but with
only one source operand read from \texttt{IR\_SRC1}.  Sign- and
zero-extension are semantically distinct at the IR level so that
the backend can select the correct ARM64 widening instruction
(\texttt{SXTW} versus \texttt{UXTW}).

@d IR: dump instruction @{
// -- Unary ops: "op type %src1" -------------------------------------------
.Lidi_neg:
    adrp x0, _kcc_ir_op_neg@@PAGE
    add  x0, x0, _kcc_ir_op_neg@@PAGEOFF
    b .Lidi_unop
.Lidi_not:
    adrp x0, _kcc_ir_op_not@@PAGE
    add  x0, x0, _kcc_ir_op_not@@PAGEOFF
    b .Lidi_unop
.Lidi_sext:
    adrp x0, _kcc_ir_op_sext@@PAGE
    add  x0, x0, _kcc_ir_op_sext@@PAGEOFF
    b .Lidi_unop
.Lidi_zext:
    adrp x0, _kcc_ir_op_zext@@PAGE
    add  x0, x0, _kcc_ir_op_zext@@PAGEOFF
    b .Lidi_unop
.Lidi_trunc:
    adrp x0, _kcc_ir_op_trunc@@PAGE
    add  x0, x0, _kcc_ir_op_trunc@@PAGEOFF
    b .Lidi_unop

.Lidi_unop:
    bl _kcc_io_puts
    mov x0, #' '
    bl _kcc_io_putc
    ldr x0, [x19, #IR_TYPE]
    bl _kcc_ir_dump_type_short
    mov x0, #' '
    bl _kcc_io_putc
    mov x0, #'%'
    bl _kcc_io_putc
    ldr x0, [x19, #IR_SRC1]
    bl _kcc_io_putu
    b .Lidi_nl
@}

\paragraph{Memory, Control Flow, and Miscellaneous Operations}

The remaining opcodes each have their own bespoke printing logic
because their operand layouts differ from one another.  Memory
operations \textsc{load} and \textsc{store} include pointer
annotations; \textsc{alloca} prints only its type.  The branch
family uses basic-block identifiers (\texttt{bb\textit{N}}) rather
than virtual registers: \textsc{br} takes one target while
\textsc{br\_cond} takes a condition vreg plus true/false targets.
\textsc{ret} checks whether the return type is \texttt{void} to
decide if a value operand follows.  \textsc{call} prints the callee
name prefixed with \texttt{@@}.  Finally, \textsc{const},
\textsc{nop}, \textsc{global\_ref}, and \textsc{string\_lit} handle
immediates, no-ops, global symbol references, and inline string
data respectively.  The shared epilogue at \texttt{.Lidi\_nl}
appends a newline and restores callee-saved registers before
returning.

@d IR: dump instruction @{
// -- load: "load type, ptr %src1" -----------------------------------------
.Lidi_load:
    adrp x0, _kcc_ir_op_load@@PAGE
    add  x0, x0, _kcc_ir_op_load@@PAGEOFF
    bl _kcc_io_puts
    ldr x0, [x19, #IR_TYPE]
    bl _kcc_ir_dump_type_short
    adrp x0, _kcc_ir_str_ptr_pct@@PAGE
    add  x0, x0, _kcc_ir_str_ptr_pct@@PAGEOFF
    bl _kcc_io_puts
    ldr x0, [x19, #IR_SRC1]
    bl _kcc_io_putu
    b .Lidi_nl

// -- store: "store type %src1, ptr %src2" ---------------------------------
.Lidi_store:
    adrp x0, _kcc_ir_op_store@@PAGE
    add  x0, x0, _kcc_ir_op_store@@PAGEOFF
    bl _kcc_io_puts
    ldr x0, [x19, #IR_TYPE]
    bl _kcc_ir_dump_type_short
    mov x0, #' '
    bl _kcc_io_putc
    mov x0, #'%'
    bl _kcc_io_putc
    ldr x0, [x19, #IR_SRC1]
    bl _kcc_io_putu
    adrp x0, _kcc_ir_str_ptr_pct@@PAGE
    add  x0, x0, _kcc_ir_str_ptr_pct@@PAGEOFF
    bl _kcc_io_puts
    ldr x0, [x19, #IR_SRC2]
    bl _kcc_io_putu
    b .Lidi_nl

// -- alloca: "alloca type" ------------------------------------------------
.Lidi_alloca:
    adrp x0, _kcc_ir_op_alloca@@PAGE
    add  x0, x0, _kcc_ir_op_alloca@@PAGEOFF
    bl _kcc_io_puts
    ldr x0, [x19, #IR_TYPE]
    bl _kcc_ir_dump_type_short
    b .Lidi_nl

// -- gep: "gep %base, %index" ---------------------------------------------
.Lidi_gep:
    adrp x0, _kcc_ir_op_gep@@PAGE
    add  x0, x0, _kcc_ir_op_gep@@PAGEOFF
    bl _kcc_io_puts
    mov x0, #'%'
    bl _kcc_io_putc
    ldr x0, [x19, #IR_SRC1]
    bl _kcc_io_putu
    adrp x0, _kcc_ir_str_comma@@PAGE
    add  x0, x0, _kcc_ir_str_comma@@PAGEOFF
    bl _kcc_io_puts
    ldr x0, [x19, #IR_SRC2]
    bl _kcc_io_putu
    b .Lidi_nl

// -- br: "br bb<N>" -------------------------------------------------------
.Lidi_br:
    adrp x0, _kcc_ir_op_br@@PAGE
    add  x0, x0, _kcc_ir_op_br@@PAGEOFF
    bl _kcc_io_puts
    ldr x0, [x19, #IR_SRC1]
    bl _kcc_io_putu
    b .Lidi_nl

// -- br_cond: "br_cond %cond, bb<T>, bb<F>" ------------------------------
.Lidi_br_cond:
    adrp x0, _kcc_ir_op_br_cond@@PAGE
    add  x0, x0, _kcc_ir_op_br_cond@@PAGEOFF
    bl _kcc_io_puts
    mov x0, #'%'
    bl _kcc_io_putc
    ldr x0, [x19, #IR_DEST]   // cond vreg is in DEST for br_cond
    bl _kcc_io_putu
    adrp x0, _kcc_ir_str_comma_bb@@PAGE
    add  x0, x0, _kcc_ir_str_comma_bb@@PAGEOFF
    bl _kcc_io_puts
    ldr x0, [x19, #IR_SRC1]   // true BB id
    bl _kcc_io_putu
    adrp x0, _kcc_ir_str_comma_bb@@PAGE
    add  x0, x0, _kcc_ir_str_comma_bb@@PAGEOFF
    bl _kcc_io_puts
    ldr x0, [x19, #IR_SRC2]   // false BB id
    bl _kcc_io_putu
    b .Lidi_nl

// -- ret: "ret type %src1" or "ret void" ----------------------------------
.Lidi_ret:
    adrp x0, _kcc_ir_op_ret@@PAGE
    add  x0, x0, _kcc_ir_op_ret@@PAGEOFF
    bl _kcc_io_puts
    ldr x0, [x19, #IR_TYPE]
    bl _kcc_ir_dump_type_short
    // Check if void return
    ldr x0, [x19, #IR_TYPE]
    cbz x0, .Lidi_nl
    ldr x0, [x0, #TY_KIND]
    cmp x0, #TY_VOID
    b.eq .Lidi_nl
    // Non-void: print " %src1"
    mov x0, #' '
    bl _kcc_io_putc
    mov x0, #'%'
    bl _kcc_io_putc
    ldr x0, [x19, #IR_SRC1]
    bl _kcc_io_putu
    b .Lidi_nl

// -- call: "call type @@name(%src1, ...)" ---------------------------------
.Lidi_call:
    adrp x0, _kcc_ir_op_call@@PAGE
    add  x0, x0, _kcc_ir_op_call@@PAGEOFF
    bl _kcc_io_puts
    ldr x0, [x19, #IR_TYPE]
    bl _kcc_ir_dump_type_short
    // Print " @@<name>"
    mov x0, #' '
    bl _kcc_io_putc
    mov x0, #'@@'
    bl _kcc_io_putc
    ldr x0, [x19, #IR_SRC1]   // SRC1 = name pointer
    cbz x0, .Lidi_nl
    bl _kcc_io_puts
    b .Lidi_nl

// -- const: "const type <imm>" -------------------------------------------
.Lidi_const:
    adrp x0, _kcc_ir_op_const@@PAGE
    add  x0, x0, _kcc_ir_op_const@@PAGEOFF
    bl _kcc_io_puts
    ldr x0, [x19, #IR_TYPE]
    bl _kcc_ir_dump_type_short
    mov x0, #' '
    bl _kcc_io_putc
    ldr x0, [x19, #IR_SRC1]   // immediate value
    bl _kcc_io_putu
    b .Lidi_nl

// -- nop ------------------------------------------------------------------
.Lidi_nop:
    adrp x0, _kcc_ir_op_nop@@PAGE
    add  x0, x0, _kcc_ir_op_nop@@PAGEOFF
    bl _kcc_io_puts
    b .Lidi_nl

// -- global_ref: "global_ref type @@name" ---------------------------------
.Lidi_global_ref:
    adrp x0, _kcc_ir_op_global_ref@@PAGE
    add  x0, x0, _kcc_ir_op_global_ref@@PAGEOFF
    bl _kcc_io_puts
    ldr x0, [x19, #IR_TYPE]
    bl _kcc_ir_dump_type_short
    mov x0, #' '
    bl _kcc_io_putc
    mov x0, #'@@'
    bl _kcc_io_putc
    ldr x0, [x19, #IR_SRC1]   // name pointer
    cbz x0, .Lidi_nl
    bl _kcc_io_puts
    b .Lidi_nl

// -- string_lit: "string_lit \"<data>\"" ----------------------------------
.Lidi_string_lit:
    adrp x0, _kcc_ir_op_string_lit@@PAGE
    add  x0, x0, _kcc_ir_op_string_lit@@PAGEOFF
    bl _kcc_io_puts
    mov x0, #'"'
    bl _kcc_io_putc
    ldr x21, [x19, #IR_SRC1]
    ldr x22, [x19, #IR_SRC2]
    mov x20, #0
.Lidi_string_ch:
    cmp x20, x22
    b.ge .Lidi_string_end
    ldrb w0, [x21, x20]
    bl _kcc_io_putc
    add x20, x20, #1
    b .Lidi_string_ch
.Lidi_string_end:
    mov x0, #'"'
    bl _kcc_io_putc
    b .Lidi_nl

.Lidi_nl:
    mov x0, #'\n'
    bl _kcc_io_putc

    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@}

\subsection{Short Type Name}

For IR output we print compact type names: \texttt{i32}, \texttt{i64},
\texttt{void}, \texttt{ptr}, etc.

@d IR: dump type short @{
// -- kcc_ir_dump_type_short -----------------------------------------------
// void kcc_ir_dump_type_short(type_desc *t)
//   x0 = type descriptor (may be NULL)
// Prints a short type label.
.text
.globl _kcc_ir_dump_type_short
.p2align 2
_kcc_ir_dump_type_short:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    cbz x0, .Lidts_unknown
    mov x19, x0

    ldr x0, [x19, #TY_KIND]

    cmp x0, #TY_VOID
    b.eq .Lidts_void
    cmp x0, #TY_BOOL
    b.eq .Lidts_i1
    cmp x0, #TY_CHAR
    b.eq .Lidts_i8
    cmp x0, #TY_SHORT
    b.eq .Lidts_i16
    cmp x0, #TY_INT
    b.eq .Lidts_i32
    cmp x0, #TY_LONG
    b.eq .Lidts_i64
    cmp x0, #TY_LLONG
    b.eq .Lidts_i64
    cmp x0, #TY_FLOAT
    b.eq .Lidts_f32
    cmp x0, #TY_DOUBLE
    b.eq .Lidts_f64
    cmp x0, #TY_PTR
    b.eq .Lidts_ptr
    cmp x0, #TY_ARRAY
    b.eq .Lidts_ptr
    cmp x0, #TY_FUNC
    b.eq .Lidts_ptr
    cmp x0, #TY_STRUCT
    b.eq .Lidts_struct
    cmp x0, #TY_UNION
    b.eq .Lidts_struct
    cmp x0, #TY_ENUM
    b.eq .Lidts_i32
    b .Lidts_unknown

.Lidts_void:
    adrp x0, _kcc_ir_ty_void@@PAGE
    add  x0, x0, _kcc_ir_ty_void@@PAGEOFF
    b .Lidts_print
.Lidts_i1:
    adrp x0, _kcc_ir_ty_i1@@PAGE
    add  x0, x0, _kcc_ir_ty_i1@@PAGEOFF
    b .Lidts_print
.Lidts_i8:
    adrp x0, _kcc_ir_ty_i8@@PAGE
    add  x0, x0, _kcc_ir_ty_i8@@PAGEOFF
    b .Lidts_print
.Lidts_i16:
    adrp x0, _kcc_ir_ty_i16@@PAGE
    add  x0, x0, _kcc_ir_ty_i16@@PAGEOFF
    b .Lidts_print
.Lidts_i32:
    adrp x0, _kcc_ir_ty_i32@@PAGE
    add  x0, x0, _kcc_ir_ty_i32@@PAGEOFF
    b .Lidts_print
.Lidts_i64:
    adrp x0, _kcc_ir_ty_i64@@PAGE
    add  x0, x0, _kcc_ir_ty_i64@@PAGEOFF
    b .Lidts_print
.Lidts_f32:
    adrp x0, _kcc_ir_ty_f32@@PAGE
    add  x0, x0, _kcc_ir_ty_f32@@PAGEOFF
    b .Lidts_print
.Lidts_f64:
    adrp x0, _kcc_ir_ty_f64@@PAGE
    add  x0, x0, _kcc_ir_ty_f64@@PAGEOFF
    b .Lidts_print
.Lidts_ptr:
    adrp x0, _kcc_ir_ty_ptr@@PAGE
    add  x0, x0, _kcc_ir_ty_ptr@@PAGEOFF
    b .Lidts_print
.Lidts_struct:
    adrp x0, _kcc_ir_ty_struct@@PAGE
    add  x0, x0, _kcc_ir_ty_struct@@PAGEOFF
    b .Lidts_print
.Lidts_unknown:
    adrp x0, _kcc_ir_ty_unknown@@PAGE
    add  x0, x0, _kcc_ir_ty_unknown@@PAGEOFF

.Lidts_print:
    bl _kcc_io_puts

    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_ir_dump_type_short
@}

\section{IR Builder Entry Point}

The builder walks the translation unit, processing each function
declaration.  Non-function declarations (globals, typedefs) are
skipped for now.

@d IR: build @{
// -- kcc_ir_build ---------------------------------------------------------
// void kcc_ir_build(node *trans_unit)
//   x0 = AST_TRANS_UNIT node
// Walks all top-level declarations and builds IR for functions.
.text
.globl _kcc_ir_build
.p2align 2
_kcc_ir_build:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    ldr x19, [x0, #AST_F0]      // first declaration

.Lirb_loop:
    cbz x19, .Lirb_done

    // Check if it's a function declaration with a body
    ldr x0, [x19, #AST_TAG]
    cmp x0, #AST_FUNC_DECL
    b.ne .Lirb_next

    // F3 = body (compound stmt); skip prototypes
    ldr x0, [x19, #AST_F3]
    cbz x0, .Lirb_next

    mov x0, x19
    bl _kcc_ir_build_func

.Lirb_next:
    ldr x19, [x19, #AST_F4]     // next sibling
    b .Lirb_loop

.Lirb_done:
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_ir_build
@}

\section{Building a Function}

For each function, we create an IR function, allocate an entry basic
block, build alloca instructions for parameters and local variables,
then lower the body.

@d IR: build function @{
// -- kcc_ir_build_func ----------------------------------------------------
// void kcc_ir_build_func(node *func_decl)
//   x0 = AST_FUNC_DECL node (F0=type, F1=name, F2=params, F3=body)
// Builds IR for one function.
.text
.globl _kcc_ir_build_func
.p2align 2
_kcc_ir_build_func:
    stp x29, x30, [sp, #-80]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    str x25, [sp, #64]

    mov x19, x0                  // x19 = func_decl AST

    // Get return type from the resolved type (F3 from sema = type desc)
    // The function type is in F0 (type AST), resolved type should be
    // obtained from the symbol table entry or from AST_F3 (sema type)
    // For now, use int as default; check if sema stored type
    ldr x20, [x19, #AST_F1]     // x20 = name_ptr
    ldr x21, [x19, #AST_F0]     // x21 = type AST

    // Resolve return type: walk the type AST
    // The func type node has F0=return_type
    // If the type AST is AST_TYPE_FUNC, get its return type
    mov x22, #0                  // default ret type = NULL
    cbz x21, .Libf_default_ret
    ldr x0, [x21, #AST_TAG]
    cmp x0, #AST_TYPE_FUNC
    b.ne .Libf_default_ret
    // Get the return type from the func type AST
    ldr x0, [x21, #AST_F0]      // return type AST node
    cbz x0, .Libf_default_ret
    bl _kcc_sema_resolve_type
    mov x22, x0
    b .Libf_create

.Libf_default_ret:
    // Default: signed int
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr x22, [x0]

.Libf_create:
    // Create IR function
    mov x0, x20                  // name
    mov x1, x22                  // ret type
    bl _kcc_ir_alloc_func
    mov x23, x0                  // x23 = ir_func

    // Set as current function
    adrp x1, _kcc_ir_cur_func@@PAGE
    add  x1, x1, _kcc_ir_cur_func@@PAGEOFF
    str x23, [x1]

    // Reset locals hash table
    mov x0, #64
    bl _kcc_ht_init
    adrp x1, _kcc_ir_locals@@PAGE
    add  x1, x1, _kcc_ir_locals@@PAGEOFF
    str x0, [x1]

    // Create entry basic block
    bl _kcc_ir_alloc_bb
    mov x24, x0                  // x24 = entry BB
    str x24, [x23, #IRF_ENTRY]
    mov x0, x24
    bl _kcc_ir_set_bb

    // Count parameters and set IRF_PARAMS
    ldr x25, [x19, #AST_F2]     // x25 = first param decl
    mov x20, #0                   // param count
.Libf_count_params:
    cbz x25, .Libf_count_done
    ldr x0, [x25, #AST_TAG]
    cmp x0, #AST_PARAM_DECL
    b.ne .Libf_count_next
    add x20, x20, #1
.Libf_count_next:
    ldr x25, [x25, #AST_F4]
    b .Libf_count_params
.Libf_count_done:
    str x20, [x23, #IRF_PARAMS]  // set param count

    // Reserve vregs 0..n-1 for incoming parameter values
    // These slots will be filled by the codegen prologue (stores x0-x7)
    mov x25, #0
.Libf_reserve_vregs:
    cmp x25, x20
    b.ge .Libf_build_params
    bl _kcc_ir_next_vreg          // reserves vreg for param
    add x25, x25, #1
    b .Libf_reserve_vregs
.Libf_build_params:

    // Build alloca + store for each parameter
    ldr x25, [x19, #AST_F2]     // x25 = first param decl
    mov x20, #0                   // param index (0-based)

.Libf_param_loop:
    cbz x25, .Libf_body

    // Each param: F0=type, F1=name
    ldr x0, [x25, #AST_TAG]
    cmp x0, #AST_PARAM_DECL
    b.ne .Libf_param_next

    mov x0, x25
    mov x1, x20                   // pass param index
    bl _kcc_ir_build_param
    add x20, x20, #1

.Libf_param_next:
    ldr x25, [x25, #AST_F4]
    b .Libf_param_loop

.Libf_body:
    // Lower the function body (compound statement)
    ldr x0, [x19, #AST_F3]
    bl _kcc_ir_build_stmt

    // Ensure the last BB has a terminator (implicit return)
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    cbz x0, .Libf_register

    ldr x1, [x0, #BB_FLAGS]
    tst x1, #BB_FLAG_TERMINATED
    b.ne .Libf_register

    // Emit implicit return (void or UB for non-void without return)
    mov x0, #IR_RET
    bl _kcc_ir_alloc_instr
    str x22, [x0, #IR_TYPE]     // ret type
    bl _kcc_ir_emit

    // Mark BB terminated
    adrp x1, _kcc_ir_cur_bb@@PAGE
    add  x1, x1, _kcc_ir_cur_bb@@PAGEOFF
    ldr x1, [x1]
    ldr x2, [x1, #BB_FLAGS]
    orr x2, x2, #BB_FLAG_TERMINATED
    str x2, [x1, #BB_FLAGS]

.Libf_register:
    // Add function to global list
    adrp x0, _kcc_ir_funcs@@PAGE
    add  x0, x0, _kcc_ir_funcs@@PAGEOFF
    ldr x0, [x0]
    str x23, [sp, #72]          // store func ptr as element
    add x1, sp, #72
    bl _kcc_vec_push

    ldr x25, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #80
    ret
@| _kcc_ir_build_func
@}

\section{Building Parameters}

Each function parameter gets an \textsc{alloca} for its stack storage
and a \textsc{store} that saves the incoming register value.  The
codegen prologue copies \texttt{x0}--\texttt{x7} into vreg slots
0--7, so the parameter's ``incoming vreg'' is simply its index.
The alloca vreg is recorded in the \texttt{locals} hash table so
that later identifier references find the right address.

@d IR: build param @{
// -- kcc_ir_build_param ---------------------------------------------------
// void kcc_ir_build_param(node *param_decl, uint64_t param_index)
//   x0 = AST_PARAM_DECL (F0=type, F1=name)
//   x1 = param index (0-based, corresponds to reserved vreg)
// Emits alloca + store from the incoming param vreg, records in locals.
// The codegen prologue stores x<i> into vreg slot i. We emit:
//   %N = alloca type
//   store %i, ptr %N        (i = param_index = incoming value vreg)
.text
.globl _kcc_ir_build_param
.p2align 2
_kcc_ir_build_param:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    str x23, [sp, #48]

    mov x19, x0                  // param_decl
    mov x22, x1                  // x22 = param index (= incoming vreg)

    // Resolve type
    ldr x0, [x19, #AST_F0]
    cbz x0, .Libp_done
    bl _kcc_sema_resolve_type
    mov x20, x0                  // x20 = type desc
    cbz x20, .Libp_done

    // Get name
    ldr x21, [x19, #AST_F1]     // x21 = name ptr
    cbz x21, .Libp_done

    // Emit alloca for param storage
    mov x0, #IR_ALLOCA
    bl _kcc_ir_alloc_instr
    str x20, [x0, #IR_TYPE]
    mov x19, x0                  // save instr
    bl _kcc_ir_next_vreg
    str x0, [x19, #IR_DEST]
    mov x23, x0                  // x23 = alloca vreg number
    mov x0, x19
    bl _kcc_ir_emit

    // Emit store: store incoming param value into alloca'd storage
    // IR_STORE: SRC1 = value vreg (param index), SRC2 = pointer vreg (alloca)
    mov x0, #IR_STORE
    bl _kcc_ir_alloc_instr
    str x22, [x0, #IR_SRC1]     // value = incoming param vreg
    str x23, [x0, #IR_SRC2]     // ptr = alloca vreg
    str x20, [x0, #IR_TYPE]
    bl _kcc_ir_emit

    // Record in locals: name → alloca vreg
    adrp x0, _kcc_ir_locals@@PAGE
    add  x0, x0, _kcc_ir_locals@@PAGEOFF
    ldr x0, [x0]
    mov x4, x0                   // save ht
    mov x0, x21
    bl _kcc_strlen
    mov x2, x0                   // keylen
    mov x0, x4                   // ht
    mov x1, x21                  // key
    add x3, x23, #1              // value = alloca vreg + 1
    bl _kcc_ht_put

.Libp_done:
    ldr x23, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@| _kcc_ir_build_param
@}

\section{Building Statements}

The statement dispatcher matches the AST tag and calls the
appropriate lowering function.  Expression statements call
\texttt{ir\_build\_expr} and discard the result vreg.  Compound
statements recurse over their children.  All control-flow
statements (if, while, do, for) and break/continue have
dedicated builders in \S\ref{sec:ir-control-flow}.

@d IR: build statement @{
// -- kcc_ir_build_stmt ----------------------------------------------------
// void kcc_ir_build_stmt(node *stmt)
//   x0 = AST statement node
// Dispatches to the appropriate lowering based on AST_TAG.
.text
.globl _kcc_ir_build_stmt
.p2align 2
_kcc_ir_build_stmt:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    cbz x0, .Libs_done
    mov x19, x0

    ldr x0, [x19, #AST_TAG]

    cmp x0, #AST_COMPOUND
    b.eq .Libs_compound
    cmp x0, #AST_EXPR_STMT
    b.eq .Libs_expr
    cmp x0, #AST_RETURN_STMT
    b.eq .Libs_return
    cmp x0, #AST_IF_STMT
    b.eq .Libs_if
    cmp x0, #AST_WHILE_STMT
    b.eq .Libs_while
    cmp x0, #AST_DO_STMT
    b.eq .Libs_do
    cmp x0, #AST_FOR_STMT
    b.eq .Libs_for
    cmp x0, #AST_VAR_DECL
    b.eq .Libs_var_decl
    cmp x0, #AST_BREAK_STMT
    b.eq .Libs_break
    cmp x0, #AST_CONTINUE_STMT
    b.eq .Libs_continue
    cmp x0, #AST_SWITCH_STMT
    b.eq .Libs_switch
    cmp x0, #AST_CASE_STMT
    b.eq .Libs_done
    cmp x0, #AST_DEFAULT_STMT
    b.eq .Libs_done
    cmp x0, #AST_NULL_STMT
    b.eq .Libs_done

    // Unhandled statement type — skip
    b .Libs_done

.Libs_compound:
    // Walk all items in compound statement
    ldr x19, [x19, #AST_F0]     // first item
.Libs_compound_loop:
    cbz x19, .Libs_done
    mov x0, x19
    bl _kcc_ir_build_stmt
    ldr x19, [x19, #AST_F4]
    b .Libs_compound_loop

.Libs_expr:
    ldr x0, [x19, #AST_F0]      // expression
    bl _kcc_ir_build_expr
    b .Libs_done

.Libs_return:
    mov x0, x19
    bl _kcc_ir_build_return
    b .Libs_done

.Libs_if:
    mov x0, x19
    bl _kcc_ir_build_if
    b .Libs_done

.Libs_while:
    mov x0, x19
    bl _kcc_ir_build_while
    b .Libs_done

.Libs_do:
    mov x0, x19
    bl _kcc_ir_build_do
    b .Libs_done

.Libs_for:
    mov x0, x19
    bl _kcc_ir_build_for
    b .Libs_done

.Libs_var_decl:
    mov x0, x19
    bl _kcc_ir_build_var_decl
    b .Libs_done

.Libs_break:
    mov x0, x19
    bl _kcc_ir_build_break
    b .Libs_done

.Libs_continue:
    mov x0, x19
    bl _kcc_ir_build_continue
    b .Libs_done

.Libs_switch:
    mov x0, x19
    bl _kcc_ir_build_switch
    b .Libs_done

.Libs_done:
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_ir_build_stmt
@}

\section{Building Return}

A return statement evaluates its expression (if any), emits
\texttt{IR\_RET} with the result vreg as \texttt{SRC1}, and marks
the current basic block as terminated.  A void return emits
\texttt{IR\_RET} with a void type and no source operand.  The
termination flag prevents the builder from appending further
instructions to this block.

@d IR: build return @{
// -- kcc_ir_build_return --------------------------------------------------
// void kcc_ir_build_return(node *ret_stmt)
//   x0 = AST_RETURN_STMT (F0=expr or 0)
.text
.globl _kcc_ir_build_return
.p2align 2
_kcc_ir_build_return:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    mov x19, x0
    ldr x0, [x19, #AST_F0]      // return expression
    cbz x0, .Libret_void

    // Build the return expression
    bl _kcc_ir_build_expr
    mov x20, x0                  // x20 = vreg of return value

    // Emit ret with value
    mov x0, #IR_RET
    bl _kcc_ir_alloc_instr

    // Get return type from current function
    adrp x1, _kcc_ir_cur_func@@PAGE
    add  x1, x1, _kcc_ir_cur_func@@PAGEOFF
    ldr x1, [x1]
    ldr x1, [x1, #IRF_RETTYPE]
    str x1, [x0, #IR_TYPE]
    str x20, [x0, #IR_SRC1]
    bl _kcc_ir_emit

    // Mark BB as terminated
    b .Libret_terminate

.Libret_void:
    mov x0, #IR_RET
    bl _kcc_ir_alloc_instr
    // void ret
    adrp x1, _kcc_type_void@@PAGE
    add  x1, x1, _kcc_type_void@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    bl _kcc_ir_emit

.Libret_terminate:
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    cbz x0, .Libret_done
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

.Libret_done:
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_ir_build_return
@}

\section{Building Expressions}

The expression dispatcher examines the AST tag of its input node and
delegates to a specialised builder for each expression kind.  Every
builder returns the vreg number holding the result; this convention
lets callers compose expressions by feeding one builder's result into
another's operand slots.  Cast and parenthesised expressions are
handled inline: a cast simply builds its inner operand (truncation and
extension are deferred to a later phase), and a parenthesised
expression unwraps to its child.  The comma operator evaluates both
sides and returns the right-hand vreg.

@d IR: build expression @{
// -- kcc_ir_build_expr ----------------------------------------------------
// uint64_t kcc_ir_build_expr(node *expr)
//   x0 = AST expression node
// Returns vreg number containing the result.
.text
.globl _kcc_ir_build_expr
.p2align 2
_kcc_ir_build_expr:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    cbz x0, .Libe_zero
    mov x19, x0

    ldr x0, [x19, #AST_TAG]

    cmp x0, #AST_INT_LIT
    b.eq .Libe_int_lit
    cmp x0, #AST_CHAR_LIT
    b.eq .Libe_char_lit
    cmp x0, #AST_IDENT_EXPR
    b.eq .Libe_ident
    cmp x0, #AST_BINARY_EXPR
    b.eq .Libe_binary
    cmp x0, #AST_UNARY_EXPR
    b.eq .Libe_unary
    cmp x0, #AST_ASSIGN_EXPR
    b.eq .Libe_assign
    cmp x0, #AST_CALL_EXPR
    b.eq .Libe_call
    cmp x0, #AST_CAST_EXPR
    b.eq .Libe_cast
    cmp x0, #AST_COMMA_EXPR
    b.eq .Libe_comma
    cmp x0, #AST_COND_EXPR
    b.eq .Libe_cond
    cmp x0, #AST_PAREN_EXPR
    b.eq .Libe_paren
    cmp x0, #AST_STR_LIT
    b.eq .Libe_string_lit
    cmp x0, #AST_SIZEOF_EXPR
    b.eq .Libe_sizeof
    cmp x0, #AST_SUBSCRIPT
    b.eq .Libe_subscript

    // Unhandled expression — return 0
    b .Libe_zero

.Libe_int_lit:
    mov x0, x19
    bl _kcc_ir_build_int_lit
    b .Libe_done

.Libe_char_lit:
    mov x0, x19
    bl _kcc_ir_build_int_lit   // same treatment: F0=value
    b .Libe_done

.Libe_ident:
    mov x0, x19
    bl _kcc_ir_build_ident
    b .Libe_done

.Libe_binary:
    mov x0, x19
    bl _kcc_ir_build_binary
    b .Libe_done

.Libe_unary:
    mov x0, x19
    bl _kcc_ir_build_unary
    b .Libe_done

.Libe_assign:
    mov x0, x19
    bl _kcc_ir_build_assign
    b .Libe_done

.Libe_call:
    mov x0, x19
    bl _kcc_ir_build_call
    b .Libe_done

.Libe_cast:
    // For now, just build the inner expression
    ldr x0, [x19, #AST_F1]
    bl _kcc_ir_build_expr
    b .Libe_done

.Libe_comma:
    // Evaluate LHS (discard), return RHS
    ldr x0, [x19, #AST_F0]
    bl _kcc_ir_build_expr
    ldr x0, [x19, #AST_F1]
    bl _kcc_ir_build_expr
    b .Libe_done

.Libe_cond:
    mov x0, x19
    bl _kcc_ir_build_cond_expr
    b .Libe_done

.Libe_paren:
    // Unwrap parenthesized expression — just build inner
    ldr x0, [x19, #AST_F0]
    bl _kcc_ir_build_expr
    b .Libe_done

.Libe_string_lit:
    mov x0, x19
    bl _kcc_ir_build_string_lit
    b .Libe_done

.Libe_sizeof:
    mov x0, x19
    bl _kcc_ir_build_sizeof
    b .Libe_done

.Libe_subscript:
    mov x0, x19
    bl _kcc_ir_build_subscript
    b .Libe_done

.Libe_zero:
    mov x0, #0

.Libe_done:
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_ir_build_expr
@}

\subsection{Integer Literal}

An integer or character literal becomes an \texttt{IR\_CONST}
instruction whose \texttt{SRC1} field stores the immediate value.
The builder assigns the default type \texttt{i32} and allocates a
fresh vreg for the result.  Character literals receive the same
treatment because the parser stores the character's numeric value in
\texttt{AST\_F0}.

@d IR: build int literal @{
// -- kcc_ir_build_int_lit -------------------------------------------------
// uint64_t kcc_ir_build_int_lit(node *lit)
//   x0 = AST_INT_LIT or AST_CHAR_LIT (F0=value)
// Returns vreg.
.text
.globl _kcc_ir_build_int_lit
.p2align 2
_kcc_ir_build_int_lit:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    mov x19, x0                  // x19 = AST node (KEEP)
    ldr x20, [x19, #AST_F0]     // x20 = value

    mov x0, #IR_CONST
    bl _kcc_ir_alloc_instr
    mov x21, x0                  // x21 = instr

    // Default type: i32
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr x0, [x0]
    str x0, [x21, #IR_TYPE]

    str x20, [x21, #IR_SRC1]    // immediate value

    bl _kcc_ir_next_vreg
    str x0, [x21, #IR_DEST]
    mov x20, x0                 // save vreg

    mov x0, x21
    bl _kcc_ir_emit

    mov x0, x20                  // return vreg

    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_ir_build_int_lit
@}

\subsection{Sizeof Expression}

The \texttt{sizeof} operator (\stdref{6.5.3.4}) is a compile-time
constant: it measures the size of a type without generating any
run-time code.  The IR builder lowers it to a single
\texttt{IR\_CONST} whose immediate value is the type's size in bytes.

Two forms are possible.  When the operand is a type name
(\texttt{AST\_F1 = 1}), the builder calls
\texttt{\_kcc\_sema\_resolve\_type} on the type AST node to obtain a
type descriptor and reads its \texttt{TY\_SIZE} field.  When the
operand is an expression (\texttt{AST\_F1 = 0}), the semantic pass has
already type-checked the operand and stored its resolved type in the
operand node's \texttt{AST\_F3} field; the builder reads the size from
that descriptor.  In neither case is the operand expression evaluated
at run time.

@d IR: build sizeof @{
// -- kcc_ir_build_sizeof --------------------------------------------------
// uint64_t kcc_ir_build_sizeof(node *expr)
//   x0 = AST_SIZEOF_EXPR (F0=operand, F1=is_type)
// Returns vreg holding the size constant.
.text
.globl _kcc_ir_build_sizeof
.p2align 2
_kcc_ir_build_sizeof:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    mov x19, x0                  // x19 = sizeof node

    // Determine operand type
    ldr x0, [x19, #AST_F1]      // is_type flag
    cbnz x0, .Libs_sizeof_type

    // sizeof(expr): operand's resolved type is in F0->AST_F3
    ldr x0, [x19, #AST_F0]      // operand expression
    ldr x0, [x0, #AST_F3]       // resolved type descriptor
    b .Libs_sizeof_emit

.Libs_sizeof_type:
    // sizeof(type-name): resolve the type AST node
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_resolve_type

.Libs_sizeof_emit:
    // x0 = type descriptor → read TY_SIZE
    ldr x20, [x0, #TY_SIZE]     // x20 = size in bytes

    // Emit IR_CONST with the size value
    mov x0, #IR_CONST
    bl _kcc_ir_alloc_instr
    mov x21, x0                  // x21 = instr

    adrp x0, _kcc_type_long_u@@PAGE
    add  x0, x0, _kcc_type_long_u@@PAGEOFF
    ldr x0, [x0]
    str x0, [x21, #IR_TYPE]     // sizeof yields unsigned long

    str x20, [x21, #IR_SRC1]    // immediate = size

    bl _kcc_ir_next_vreg
    str x0, [x21, #IR_DEST]
    mov x20, x0                  // save vreg

    mov x0, x21
    bl _kcc_ir_emit

    mov x0, x20                  // return vreg

    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_ir_build_sizeof
@}

\paragraph{End-to-end tests.}
The sizeof operator must produce the correct size for each fundamental
type: \texttt{char} is 1~byte, \texttt{short} is 2, \texttt{int} is 4,
and \texttt{long} is 8 on ARM64.  The expression form
\texttt{sizeof~expr} must also return the type's size without
evaluating the expression.

@d Test: codegen sizeof @{
echo ""
echo "--- Sizeof ---"

run_test "sizeof-int" \
    "int main(void) { return sizeof(int); }" 4

run_test "sizeof-char" \
    "int main(void) { return sizeof(char); }" 1

run_test "sizeof-long" \
    "int main(void) { return sizeof(long); }" 8

run_test "sizeof-expr" \
    "int main(void) { int x = 42; return sizeof(x); }" 4

run_test "sizeof-ptr" \
    "int main(void) { int *p; return sizeof(p); }" 8

run_test "sizeof-arith" \
    "int main(void) { return sizeof(int) + sizeof(char); }" 5
@}

\subsection{Array Subscript}

The array subscript \texttt{a[i]} lowers to two IR operations: an
\texttt{IR\_GEP} (Get Element Pointer) that computes the address of
the $i$-th element, and an \texttt{IR\_LOAD} that reads the value
at that address.  The \texttt{IR\_GEP} instruction takes a base
pointer vreg in \texttt{SRC1} and an index vreg in \texttt{SRC2};
the code generator multiplies the index by the slot size (8~bytes in
the all-spill model) and adds it to the base address.

Two helpers split the work.
\texttt{\_kcc\_ir\_build\_subscript\_addr} resolves the array
identifier's alloca vreg and emits the \texttt{IR\_GEP}---it is
shared by both read (\texttt{a[i]}) and write (\texttt{a[i]=v})
paths.  \texttt{\_kcc\_ir\_build\_subscript} calls the address
helper and then emits an \texttt{IR\_LOAD} to produce a value vreg.
For assignment, the assign builder calls the address helper directly
and emits an \texttt{IR\_STORE} to write the right-hand side.

@d IR: build subscript @{
// -- kcc_ir_build_subscript_addr ------------------------------------------
// uint64_t kcc_ir_build_subscript_addr(node *subscript)
//   x0 = AST_SUBSCRIPT (F0=array ident, F1=index expr)
// Returns vreg holding the element address (GEP result).
.text
.globl _kcc_ir_build_subscript_addr
.p2align 2
_kcc_ir_build_subscript_addr:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    str x23, [sp, #48]

    mov x19, x0                  // x19 = subscript node

    // Get array base address (identifier → alloca vreg)
    ldr x0, [x19, #AST_F0]      // array expression
    ldr x1, [x0, #AST_TAG]
    cmp x1, #AST_IDENT_EXPR
    b.ne .Libsa_expr

    // Local array: look up alloca vreg
    ldr x20, [x0, #AST_F0]      // name ptr
    mov x0, x20
    bl _kcc_strlen
    mov x2, x0
    adrp x0, _kcc_ir_locals@@PAGE
    add  x0, x0, _kcc_ir_locals@@PAGEOFF
    ldr x0, [x0]
    mov x1, x20
    bl _kcc_ht_get
    cbz x0, .Libsa_expr
    sub x20, x0, #1              // alloca vreg
    b .Libsa_index

.Libsa_expr:
    // Fallback: build the array expression as a pointer
    ldr x0, [x19, #AST_F0]
    bl _kcc_ir_build_expr
    mov x20, x0                  // base vreg

.Libsa_index:
    // Build index expression
    ldr x0, [x19, #AST_F1]
    bl _kcc_ir_build_expr
    mov x21, x0                  // index vreg

    // Emit IR_GEP: base + index * element_size
    mov x0, #IR_GEP
    bl _kcc_ir_alloc_instr
    mov x22, x0
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x22, #IR_TYPE]
    str x20, [x22, #IR_SRC1]    // base pointer
    str x21, [x22, #IR_SRC2]    // index
    bl _kcc_ir_next_vreg
    str x0, [x22, #IR_DEST]
    mov x23, x0                  // result vreg
    mov x0, x22
    bl _kcc_ir_emit

    mov x0, x23                  // return GEP vreg

    ldr x23, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@| _kcc_ir_build_subscript_addr
@}

@d IR: build subscript @{
// -- kcc_ir_build_subscript -----------------------------------------------
// uint64_t kcc_ir_build_subscript(node *subscript)
//   x0 = AST_SUBSCRIPT (F0=array, F1=index)
// Returns vreg holding the loaded value.
.text
.globl _kcc_ir_build_subscript
.p2align 2
_kcc_ir_build_subscript:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    // Get element address
    bl _kcc_ir_build_subscript_addr
    mov x19, x0                  // GEP vreg (element address)

    // Emit IR_LOAD from element address
    mov x0, #IR_LOAD
    bl _kcc_ir_alloc_instr
    mov x20, x0
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x20, #IR_TYPE]
    str x19, [x20, #IR_SRC1]    // pointer = GEP result
    bl _kcc_ir_next_vreg
    str x0, [x20, #IR_DEST]
    mov x19, x0                  // result vreg
    mov x0, x20
    bl _kcc_ir_emit

    mov x0, x19                  // return value vreg

    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_ir_build_subscript
@}

Array tests verify declaration, element write, element read, multiple
elements, loop-based filling, and variable indexing.

@d Test: codegen arrays @{
echo ""
echo "--- Arrays ---"

run_test "array-write-read" \
    "int main(void) { int a[3]; a[0] = 10; return a[0]; }" 10

run_test "array-multi-elem" \
    "int main(void) { int a[3]; a[0] = 1; a[1] = 2; a[2] = 3; return a[0] + a[1] + a[2]; }" 6

run_test "array-overwrite" \
    "int main(void) { int a[2]; a[0] = 5; a[0] = 9; return a[0]; }" 9

run_test "array-index-var" \
    "int main(void) { int a[4]; int i = 2; a[i] = 7; return a[2]; }" 7

run_test "array-loop-fill" \
    "int main(void) { int a[5]; int i = 0; while (i < 5) { a[i] = i; i = i + 1; } return a[3]; }" 3

run_test "array-sum-loop" \
    "int main(void) { int a[4]; a[0]=1; a[1]=2; a[2]=3; a[3]=4; int s=0; int i=0; while(i<4){s=s+a[i];i=i+1;} return s; }" 10
@}

\subsection{Identifier (Variable Load)}

Loading a variable is a two-step lookup.  First the builder searches
the \texttt{\_kcc\_ir\_locals} hash table, which maps variable names
to alloca vreg numbers (stored as \texttt{vreg+1} so that zero can
serve as ``not found'').  If the name is found, a single
\texttt{IR\_LOAD} from the alloca vreg suffices.

If the name is absent from locals, the variable must be a global.
The builder emits \texttt{IR\_GLOBAL\_REF} to materialise the
symbol's address, then \texttt{IR\_LOAD} to fetch the value through
that address---two instructions instead of one.

@d IR: build ident @{
// -- kcc_ir_build_ident ---------------------------------------------------
// uint64_t kcc_ir_build_ident(node *ident)
//   x0 = AST_IDENT_EXPR (F0=name_ptr)
// Looks up the variable in locals and emits a load.
.text
.globl _kcc_ir_build_ident
.p2align 2
_kcc_ir_build_ident:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]

    mov x19, x0
    ldr x20, [x19, #AST_F0]     // name ptr
    cbz x20, .Libi_zero

    // Look up in locals hash table
    mov x0, x20
    bl _kcc_strlen
    mov x21, x0                  // keylen

    adrp x0, _kcc_ir_locals@@PAGE
    add  x0, x0, _kcc_ir_locals@@PAGEOFF
    ldr x0, [x0]
    mov x1, x20                  // key
    mov x2, x21                  // keylen
    bl _kcc_ht_get
    // x0 = value (vreg+1) or 0 if not found
    cbz x0, .Libi_global
    sub x22, x0, #1              // x22 = alloca vreg (stored as vreg+1)

    // Emit load from alloca
    mov x0, #IR_LOAD
    bl _kcc_ir_alloc_instr
    // Type: default i32 (should get from sema)
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    str x22, [x0, #IR_SRC1]     // src = alloca vreg

    mov x19, x0
    bl _kcc_ir_next_vreg
    str x0, [x19, #IR_DEST]
    mov x20, x0                  // save result vreg

    mov x0, x19
    bl _kcc_ir_emit

    mov x0, x20
    b .Libi_done

.Libi_global:
    // Not a local — emit global_ref to get address, then load value
    mov x0, #IR_GLOBAL_REF
    bl _kcc_ir_alloc_instr
    str x20, [x0, #IR_SRC1]     // name ptr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]

    mov x19, x0
    bl _kcc_ir_next_vreg
    str x0, [x19, #IR_DEST]
    mov x22, x0                  // x22 = address vreg

    mov x0, x19
    bl _kcc_ir_emit

    // Emit load from the global address
    mov x0, #IR_LOAD
    bl _kcc_ir_alloc_instr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    str x22, [x0, #IR_SRC1]     // src = address vreg

    mov x19, x0
    bl _kcc_ir_next_vreg
    str x0, [x19, #IR_DEST]
    mov x20, x0                  // x20 = loaded value vreg

    mov x0, x19
    bl _kcc_ir_emit

    mov x0, x20
    b .Libi_done

.Libi_zero:
    mov x0, #0

.Libi_done:
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_ir_build_ident
@}

\subsection{Binary Expression}

Binary expressions follow one of two paths.  For ordinary operators
(\texttt{+}, \texttt{-}, \texttt{*}, etc.) the builder evaluates both
sides, maps the AST token to an IR opcode, and emits a single
instruction.  For the short-circuit logical operators \texttt{\&\&}
and \texttt{||}, it must generate control flow: evaluating the
right-hand side only when the left-hand side does not already
determine the result.

\paragraph{Ordinary operators.}
The builder evaluates LHS and RHS first (in that order), then
dispatches through a token-to-opcode table covering arithmetic
(\texttt{+~-~*~/~\%}), bitwise (\texttt{\&~|~\^{}~<<~>>}), and
relational (\texttt{== != < <= > >=}) operators.  Each case sets
\texttt{x23} to the corresponding IR opcode and falls through to
the common emitter, which allocates the instruction, wires both
source vregs, and assigns a fresh destination vreg.

@d IR: build binary @{
// -- kcc_ir_build_binary --------------------------------------------------
// uint64_t kcc_ir_build_binary(node *expr)
//   x0 = AST_BINARY_EXPR (F0=op token, F1=lhs, F2=rhs)
// Returns vreg.
.text
.globl _kcc_ir_build_binary
.p2align 2
_kcc_ir_build_binary:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]

    mov x19, x0                  // AST node
    ldr x20, [x19, #AST_F0]     // op token code

    // Check for short-circuit operators
    cmp x20, #TOK_AND
    b.eq .Libb_short_and
    cmp x20, #TOK_OR
    b.eq .Libb_short_or

    // Build LHS
    ldr x0, [x19, #AST_F1]
    bl _kcc_ir_build_expr
    mov x21, x0                  // x21 = lhs vreg

    // Build RHS
    ldr x0, [x19, #AST_F2]
    bl _kcc_ir_build_expr
    mov x22, x0                  // x22 = rhs vreg

    // Map token to IR opcode
    cmp x20, #TOK_PLUS
    b.eq .Libb_op_add
    cmp x20, #TOK_MINUS
    b.eq .Libb_op_sub
    cmp x20, #TOK_STAR
    b.eq .Libb_op_mul
    cmp x20, #TOK_SLASH
    b.eq .Libb_op_sdiv
    cmp x20, #TOK_PERCENT
    b.eq .Libb_op_smod
    cmp x20, #TOK_AMP
    b.eq .Libb_op_and
    cmp x20, #TOK_PIPE
    b.eq .Libb_op_or
    cmp x20, #TOK_CARET
    b.eq .Libb_op_xor
    cmp x20, #TOK_SHL
    b.eq .Libb_op_shl
    cmp x20, #TOK_SHR
    b.eq .Libb_op_ashr
    cmp x20, #TOK_EQ
    b.eq .Libb_op_eq
    cmp x20, #TOK_NE
    b.eq .Libb_op_ne
    cmp x20, #TOK_LT
    b.eq .Libb_op_slt
    cmp x20, #TOK_LE
    b.eq .Libb_op_sle
    cmp x20, #TOK_GT
    b.eq .Libb_op_sgt
    cmp x20, #TOK_GE
    b.eq .Libb_op_sge

    // Default: add
    b .Libb_op_add

.Libb_op_add:  mov x23, #IR_ADD
    b .Libb_emit
.Libb_op_sub:  mov x23, #IR_SUB
    b .Libb_emit
.Libb_op_mul:  mov x23, #IR_MUL
    b .Libb_emit
.Libb_op_sdiv: mov x23, #IR_SDIV
    b .Libb_emit
.Libb_op_smod: mov x23, #IR_SMOD
    b .Libb_emit
.Libb_op_and:  mov x23, #IR_AND
    b .Libb_emit
.Libb_op_or:   mov x23, #IR_OR
    b .Libb_emit
.Libb_op_xor:  mov x23, #IR_XOR
    b .Libb_emit
.Libb_op_shl:  mov x23, #IR_SHL
    b .Libb_emit
.Libb_op_ashr: mov x23, #IR_ASHR
    b .Libb_emit
.Libb_op_eq:   mov x23, #IR_CMP_EQ
    b .Libb_emit
.Libb_op_ne:   mov x23, #IR_CMP_NE
    b .Libb_emit
.Libb_op_slt:  mov x23, #IR_CMP_SLT
    b .Libb_emit
.Libb_op_sle:  mov x23, #IR_CMP_SLE
    b .Libb_emit
.Libb_op_sgt:  mov x23, #IR_CMP_SGT
    b .Libb_emit
.Libb_op_sge:  mov x23, #IR_CMP_SGE
    b .Libb_emit

.Libb_emit:
    mov x0, x23
    bl _kcc_ir_alloc_instr
    mov x24, x0

    // Type: default i32
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr x0, [x0]
    str x0, [x24, #IR_TYPE]
    str x21, [x24, #IR_SRC1]
    str x22, [x24, #IR_SRC2]

    bl _kcc_ir_next_vreg
    str x0, [x24, #IR_DEST]
    mov x23, x0                  // result vreg

    mov x0, x24
    bl _kcc_ir_emit

    mov x0, x23
    b .Libb_done
@| _kcc_ir_build_binary
@}

\paragraph{Short-circuit logical AND.}
The C standard requires that \texttt{a \&\& b} evaluate \texttt{b}
only when \texttt{a} is nonzero.  The builder creates two fresh basic
blocks: \emph{rhs\_bb} and \emph{merge\_bb}.  It emits a conditional
branch on the LHS vreg: true falls through to \emph{rhs\_bb} (which
evaluates the RHS and branches to \emph{merge\_bb}), false jumps
directly to \emph{merge\_bb}.  The returned vreg is the RHS result
---a simplification that avoids phi nodes (a full SSA compiler would
merge both paths via a phi).

The short-circuit \texttt{||} mirrors this logic with the branch
targets swapped: a true LHS skips the RHS entirely.

@d IR: build binary @{
// -- Short-circuit && ----------------------------------------------------
.Libb_short_and:
    // Evaluate LHS
    ldr x0, [x19, #AST_F1]
    bl _kcc_ir_build_expr
    mov x21, x0                  // lhs vreg

    // Create BBs: rhs_bb, merge_bb
    bl _kcc_ir_alloc_bb
    mov x22, x0                  // rhs_bb
    bl _kcc_ir_alloc_bb
    mov x23, x0                  // merge_bb

    // Emit br_cond: if lhs, goto rhs_bb, else goto merge_bb
    mov x0, #IR_BR_COND
    bl _kcc_ir_alloc_instr
    str x21, [x0, #IR_DEST]     // condition
    ldr x1, [x22, #BB_ID]
    str x1, [x0, #IR_SRC1]      // true target
    ldr x1, [x23, #BB_ID]
    str x1, [x0, #IR_SRC2]      // false target
    bl _kcc_ir_emit

    // Mark current BB terminated
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

    // Switch to rhs_bb
    mov x0, x22
    bl _kcc_ir_set_bb

    // Evaluate RHS
    ldr x0, [x19, #AST_F2]
    bl _kcc_ir_build_expr
    mov x24, x0                  // rhs vreg

    // Branch to merge
    mov x0, #IR_BR
    bl _kcc_ir_alloc_instr
    ldr x1, [x23, #BB_ID]
    str x1, [x0, #IR_SRC1]
    bl _kcc_ir_emit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

    // Switch to merge_bb — result is the rhs vreg
    // (simplified: a real compiler would use phi nodes)
    mov x0, x23
    bl _kcc_ir_set_bb

    mov x0, x24                  // return rhs vreg
    b .Libb_done

// -- Short-circuit || ----------------------------------------------------
.Libb_short_or:
    // Evaluate LHS
    ldr x0, [x19, #AST_F1]
    bl _kcc_ir_build_expr
    mov x21, x0

    bl _kcc_ir_alloc_bb
    mov x22, x0                  // rhs_bb
    bl _kcc_ir_alloc_bb
    mov x23, x0                  // merge_bb

    // br_cond: if lhs, goto merge_bb, else goto rhs_bb
    mov x0, #IR_BR_COND
    bl _kcc_ir_alloc_instr
    str x21, [x0, #IR_DEST]
    ldr x1, [x23, #BB_ID]
    str x1, [x0, #IR_SRC1]      // true → merge (short-circuit)
    ldr x1, [x22, #BB_ID]
    str x1, [x0, #IR_SRC2]      // false → evaluate rhs
    bl _kcc_ir_emit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

    mov x0, x22
    bl _kcc_ir_set_bb

    ldr x0, [x19, #AST_F2]
    bl _kcc_ir_build_expr
    mov x24, x0

    mov x0, #IR_BR
    bl _kcc_ir_alloc_instr
    ldr x1, [x23, #BB_ID]
    str x1, [x0, #IR_SRC1]
    bl _kcc_ir_emit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

    mov x0, x23
    bl _kcc_ir_set_bb

    mov x0, x24
    b .Libb_done

.Libb_done:
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@}

\paragraph{End-to-end tests.}
Comparison operators (\texttt{==}, \texttt{!=}, \texttt{<}, \texttt{>},
\texttt{<=}, \texttt{>=}) lower to an \texttt{IR\_CMP\_*} instruction
that the code generator implements as \texttt{CMP} followed by
\texttt{CSET} with the appropriate condition code.  The logical
connectives \texttt{\&\&} and \texttt{||} use short-circuit evaluation:
the IR builder creates conditional branches so that the right-hand
operand is only evaluated when the left-hand side does not already
determine the result.  Logical negation \texttt{!} is lowered to
\texttt{IR\_CMP\_EQ} against a synthesised zero constant.

@d Test: codegen logical @{
echo ""
echo "--- Logical and Comparison ---"

run_test "logical and true" \
    "int main(void) { return 1 && 1; }" 1

run_test "logical and false" \
    "int main(void) { return 1 && 0; }" 0

run_test "logical or" \
    "int main(void) { return 0 || 1; }" 1

run_test "logical not" \
    "int main(void) { return !0; }" 1

run_test "logical not true" \
    "int main(void) { return !42; }" 0

run_test "chained comparison" \
    "int main(void) { return (3 > 2) + (2 > 1); }" 2

run_test "equality" \
    "int main(void) { return (5 == 5) + (5 != 3); }" 2

run_test "less/greater" \
    "int main(void) { return (1 < 2) + (2 > 1) + (2 <= 2) + (3 >= 3); }" 4

run_test "complex logical" \
    "int main(void) { return (1 && 0) || (1 && 1); }" 1
@}

\subsection{Unary Expression}

Unary operators dispatch on the token stored in \texttt{AST\_F0}.
Increment and decrement (\texttt{++}/\texttt{-{}-}) are intercepted
first and delegated to a dedicated builder (see below), because they
require address-based read-modify-write lowering rather than a simple
value transformation.  Arithmetic negation (\texttt{-}) emits
\texttt{IR\_NEG}, bitwise complement (\texttt{\~{}}) emits
\texttt{IR\_NOT}, and logical negation (\texttt{!}) is lowered to
\texttt{IR\_CMP\_EQ} against a synthesised zero constant---producing~1
when the operand is zero and 0 otherwise.  All other unary tokens
(e.g.\ address-of, dereference) are not yet supported and return the
operand unchanged.

@d IR: build unary @{
// -- kcc_ir_build_unary ---------------------------------------------------
// uint64_t kcc_ir_build_unary(node *expr)
//   x0 = AST_UNARY_EXPR (F0=op, F1=operand, F2=prefix/postfix)
.text
.globl _kcc_ir_build_unary
.p2align 2
_kcc_ir_build_unary:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]

    mov x19, x0
    ldr x20, [x19, #AST_F0]     // op token

    // Increment/decrement need address-based lowering, not value
    cmp x20, #TOK_INC
    b.eq .Libu_inc_dec
    cmp x20, #TOK_DEC
    b.eq .Libu_inc_dec

    // Build operand
    ldr x0, [x19, #AST_F1]
    bl _kcc_ir_build_expr
    mov x21, x0                  // operand vreg

    cmp x20, #TOK_MINUS
    b.eq .Libu_neg
    cmp x20, #TOK_TILDE
    b.eq .Libu_not
    cmp x20, #TOK_BANG
    b.eq .Libu_lnot

    // Default: return operand as-is
    mov x0, x21
    b .Libu_done

.Libu_neg:
    mov x0, #IR_NEG
    bl _kcc_ir_alloc_instr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    str x21, [x0, #IR_SRC1]
    mov x22, x0
    bl _kcc_ir_next_vreg
    str x0, [x22, #IR_DEST]
    mov x20, x0
    mov x0, x22
    bl _kcc_ir_emit
    mov x0, x20
    b .Libu_done

.Libu_not:
    mov x0, #IR_NOT
    bl _kcc_ir_alloc_instr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    str x21, [x0, #IR_SRC1]
    mov x22, x0
    bl _kcc_ir_next_vreg
    str x0, [x22, #IR_DEST]
    mov x20, x0
    mov x0, x22
    bl _kcc_ir_emit
    mov x0, x20
    b .Libu_done

.Libu_lnot:
    // Logical not: cmp_eq operand, 0
    // First emit const 0
    mov x0, #IR_CONST
    bl _kcc_ir_alloc_instr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    str xzr, [x0, #IR_SRC1]
    mov x22, x0
    bl _kcc_ir_next_vreg
    str x0, [x22, #IR_DEST]
    mov x20, x0                  // zero vreg
    mov x0, x22
    bl _kcc_ir_emit

    // Now cmp_eq
    mov x0, #IR_CMP_EQ
    bl _kcc_ir_alloc_instr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    str x21, [x0, #IR_SRC1]
    str x20, [x0, #IR_SRC2]
    mov x22, x0
    bl _kcc_ir_next_vreg
    str x0, [x22, #IR_DEST]
    mov x20, x0
    mov x0, x22
    bl _kcc_ir_emit
    mov x0, x20
    b .Libu_done

.Libu_inc_dec:
    mov x0, x19                  // pass AST node
    bl _kcc_ir_build_inc_dec
    b .Libu_done

.Libu_done:
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_ir_build_unary
@}

\paragraph{End-to-end tests: pointers.}
The address-of operator \texttt{\&x} returns the alloca vreg directly,
which already holds the stack address of the variable.  Dereferencing a
pointer \texttt{*p} emits \texttt{IR\_LOAD} with the pointer vreg as
source, producing the value stored at that address.  Cast expressions
currently pass through the inner expression unchanged, which is correct
for same-width integer casts on a 64-bit architecture.

@d Test: codegen pointers @{
echo ""
echo "--- Pointers ---"

run_test "address and deref" \
    "int main(void) { int x = 42; int *p = &x; return *p; }" 42

run_test "cast expression" \
    "int main(void) { long x = 42; return (int)x; }" 42
@}

\subsection{Increment and Decrement}

The increment and decrement operators (\texttt{++} and \texttt{-{}-})
are the only unary operators that \emph{modify} their operand: they
read the current value, add or subtract one, and write the result back.
The C17 standard (\stdref{6.5.2.4}, \stdref{6.5.3.1}) distinguishes
\emph{postfix} (\texttt{x++}) from \emph{prefix} (\texttt{++x}): the
postfix form evaluates to the value \emph{before} the modification,
while the prefix form evaluates to the value \emph{after}.

\paragraph{IR lowering pattern.}
Both forms produce the same four-instruction sequence---only the
returned vreg differs:

\begin{verbatim}
  %old  = load  i32, ptr %x_alloca
  %one  = const i32, 1
  %new  = add   i32, %old, %one    ; or sub for --
  store i32, %new, ptr %x_alloca
  ; result = %old (postfix) or %new (prefix)
\end{verbatim}

The builder looks up the operand in the locals table to obtain the
alloca vreg.  If the identifier is not a local, it falls back to
\texttt{IR\_GLOBAL\_REF} to obtain the address.  The
\texttt{AST\_F2} field of the \texttt{AST\_UNARY\_EXPR} node
carries the prefix/postfix flag (1 for prefix, 0 for postfix),
set by the parser.

@d IR: build increment/decrement @{
// -- kcc_ir_build_inc_dec -------------------------------------------------
// uint64_t kcc_ir_build_inc_dec(node *expr)
//   x0 = AST_UNARY_EXPR (F0=op, F1=operand, F2=prefix(1)/postfix(0))
// Lowers i++, ++i, i--, --i into a load-add/sub-store sequence.
// Returns old value (postfix) or new value (prefix).
.text
.globl _kcc_ir_build_inc_dec
.p2align 2
_kcc_ir_build_inc_dec:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]

    mov x19, x0                  // AST node
    ldr x20, [x19, #AST_F0]     // op (TOK_INC or TOK_DEC)
    ldr x21, [x19, #AST_F2]     // prefix flag (1=prefix, 0=postfix)

    // Operand must be an identifier (lvalue)
    ldr x0, [x19, #AST_F1]
    cbz x0, .Libid_zero
    ldr x1, [x0, #AST_TAG]
    cmp x1, #AST_IDENT_EXPR
    b.ne .Libid_zero

    ldr x22, [x0, #AST_F0]      // name ptr
    cbz x22, .Libid_zero

    // Look up in locals hash table
    mov x0, x22
    bl _kcc_strlen
    mov x2, x0                   // keylen

    adrp x0, _kcc_ir_locals@@PAGE
    add  x0, x0, _kcc_ir_locals@@PAGEOFF
    ldr x0, [x0]
    mov x1, x22
    bl _kcc_ht_get
    cbz x0, .Libid_global
    sub x22, x0, #1              // x22 = alloca vreg
    b .Libid_load
@| _kcc_ir_build_inc_dec
@}

For global variables, the builder first emits an \texttt{IR\_GLOBAL\_REF}
to materialise the address into a vreg, then continues with the same
load-modify-store sequence.

@d IR: build increment/decrement @{
.Libid_global:
    // Emit GLOBAL_REF to get address vreg
    mov x0, #IR_GLOBAL_REF
    bl _kcc_ir_alloc_instr
    str x22, [x0, #IR_SRC1]     // name ptr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    mov x19, x0
    bl _kcc_ir_next_vreg
    str x0, [x19, #IR_DEST]
    mov x22, x0                  // x22 = address vreg
    mov x0, x19
    bl _kcc_ir_emit
@}

The core read-modify-write sequence is shared by both local and global
operands.  The four steps---load, constant~1, add or subtract, and
store---follow directly.

@d IR: build increment/decrement @{
.Libid_load:
    // Step 1: load current value
    mov x0, #IR_LOAD
    bl _kcc_ir_alloc_instr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    str x22, [x0, #IR_SRC1]     // address vreg
    mov x19, x0
    bl _kcc_ir_next_vreg
    str x0, [x19, #IR_DEST]
    mov x23, x0                  // x23 = old value vreg
    mov x0, x19
    bl _kcc_ir_emit

    // Step 2: constant 1
    mov x0, #IR_CONST
    bl _kcc_ir_alloc_instr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    mov x2, #1
    str x2, [x0, #IR_SRC1]
    mov x19, x0
    bl _kcc_ir_next_vreg
    str x0, [x19, #IR_DEST]
    mov x24, x0                  // x24 = const 1 vreg
    mov x0, x19
    bl _kcc_ir_emit

    // Step 3: add (++) or sub (--)
    cmp x20, #TOK_INC
    mov x0, #IR_ADD
    b.eq .Libid_binop
    mov x0, #IR_SUB
.Libid_binop:
    bl _kcc_ir_alloc_instr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    str x23, [x0, #IR_SRC1]     // old value
    str x24, [x0, #IR_SRC2]     // const 1
    mov x19, x0
    bl _kcc_ir_next_vreg
    str x0, [x19, #IR_DEST]
    mov x24, x0                  // x24 = new value vreg
    mov x0, x19
    bl _kcc_ir_emit

    // Step 4: store new value back
    mov x0, #IR_STORE
    bl _kcc_ir_alloc_instr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    str x24, [x0, #IR_SRC1]     // new value
    str x22, [x0, #IR_SRC2]     // address
    bl _kcc_ir_emit

    // Return old (postfix) or new (prefix)
    cbnz x21, .Libid_prefix
    mov x0, x23                  // postfix: return old value
    b .Libid_done
.Libid_prefix:
    mov x0, x24                  // prefix: return new value
    b .Libid_done

.Libid_zero:
    mov x0, #0

.Libid_done:
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@}

\paragraph{End-to-end tests.}
The following tests verify the full compilation pipeline for all four
operator forms.  The for-loop test with \texttt{i++} is the most
critical: before this feature was implemented, the increment emitted
\texttt{IR\_NOP} and the loop ran forever.

@d Test: codegen increment @{
echo ""
echo "--- Increment / Decrement ---"

run_test "postfix increment stmt" \
    "int main(void) { int x = 5; x++; return x; }" 6

run_test "prefix increment" \
    "int main(void) { int x = 5; return ++x; }" 6

run_test "postfix returns old" \
    "int main(void) { int x = 5; int y = x++; return y; }" 5

run_test "prefix returns new" \
    "int main(void) { int x = 5; int y = ++x; return y; }" 6

run_test "postfix decrement stmt" \
    "int main(void) { int x = 5; x--; return x; }" 4

run_test "prefix decrement" \
    "int main(void) { int x = 5; return --x; }" 4

run_test "for-loop with i++" \
    "int main(void) { int s = 0; for (int i = 0; i < 5; i++) s = s + 2; return s; }" 10

run_test "for-loop sum with i++" \
    "int main(void) { int s = 0; for (int i = 0; i < 5; i++) s = s + i; return s; }" 10

run_test "do-while with i++" \
    "int main(void) { int i = 0; int s = 0; do { s = s + i; i++; } while (i <= 5); return s; }" 15

run_test "while with decrement" \
    "int main(void) { int x = 5; while (x > 0) x--; return x; }" 0

run_test "triple increment" \
    "int main(void) { int x = 0; x++; x++; x++; return x; }" 3
@}

\subsection{Assignment}

Assignment handles three cases.  A simple \texttt{=} evaluates the
RHS, looks up the LHS identifier in the locals table, and emits
\texttt{IR\_STORE} to write the value into the variable's alloca.
Compound assignments (\texttt{+=}, \texttt{-=}, \texttt{*=},
\texttt{/=}, \texttt{\%=}, \texttt{\&=}, \texttt{|=}, \texttt{\^{}=},
\texttt{<<=}, \texttt{>>=}) first load the current value, emit the
corresponding binary operation, then store the result back---exactly
the read-modify-write pattern described for increment/decrement above.
Finally, if the LHS identifier is not in locals, it must be a global:
the builder emits \texttt{IR\_GLOBAL\_REF} to materialise the
address.  For simple assignment the value is stored directly; for
compound operators the same load-binop-store sequence is applied,
loading from the global address vreg before emitting the binary
operation and storing the result back.

The compound path uses callee-saved registers \texttt{x23} (current
value vreg) and \texttt{x24} (IR opcode), so the frame must be 64
bytes to save \texttt{x19}--\texttt{x24}.  In all cases the returned
vreg is the stored value, matching the C semantics where assignment
is an expression (\stdref{6.5.16}).

@d IR: build assign @{
// -- kcc_ir_build_assign --------------------------------------------------
// uint64_t kcc_ir_build_assign(node *expr)
//   x0 = AST_ASSIGN_EXPR (F0=op, F1=lhs, F2=rhs)
// For simple assignment (=), evaluates RHS and stores to LHS alloca.
.text
.globl _kcc_ir_build_assign
.p2align 2
_kcc_ir_build_assign:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]

    mov x19, x0
    ldr x20, [x19, #AST_F0]     // op token

    // Build RHS first
    ldr x0, [x19, #AST_F2]
    bl _kcc_ir_build_expr
    mov x21, x0                  // rhs vreg

    // Get LHS — identifier or subscript
    ldr x0, [x19, #AST_F1]
    cbz x0, .Liba_done
    ldr x1, [x0, #AST_TAG]
    cmp x1, #AST_SUBSCRIPT
    b.eq .Liba_subscript
    cmp x1, #AST_IDENT_EXPR
    b.ne .Liba_done

    // Look up variable alloca
    ldr x22, [x0, #AST_F0]      // name ptr
    cbz x22, .Liba_done

    mov x0, x22
    bl _kcc_strlen
    mov x2, x0

    adrp x0, _kcc_ir_locals@@PAGE
    add  x0, x0, _kcc_ir_locals@@PAGEOFF
    ldr x0, [x0]
    mov x1, x22
    bl _kcc_ht_get
    cbz x0, .Liba_global_store
    sub x22, x0, #1              // alloca vreg (stored as vreg+1)

    // For compound assignment (+=, etc.), load current value first
    cmp x20, #TOK_ASSIGN
    b.eq .Liba_store

    // Load current value
    mov x0, #IR_LOAD
    bl _kcc_ir_alloc_instr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    str x22, [x0, #IR_SRC1]
    mov x19, x0
    bl _kcc_ir_next_vreg
    str x0, [x19, #IR_DEST]
    mov x23, x0                  // current value vreg
    mov x0, x19
    bl _kcc_ir_emit

    // Map compound op to IR opcode
    mov x24, #IR_ADD             // default
    cmp x20, #TOK_ADD_ASSIGN
    b.eq .Liba_compound
    mov x24, #IR_SUB
    cmp x20, #TOK_SUB_ASSIGN
    b.eq .Liba_compound
    mov x24, #IR_MUL
    cmp x20, #TOK_MUL_ASSIGN
    b.eq .Liba_compound
    mov x24, #IR_SDIV
    cmp x20, #TOK_DIV_ASSIGN
    b.eq .Liba_compound
    mov x24, #IR_SMOD
    cmp x20, #TOK_MOD_ASSIGN
    b.eq .Liba_compound
    mov x24, #IR_AND
    cmp x20, #TOK_AND_ASSIGN
    b.eq .Liba_compound
    mov x24, #IR_OR
    cmp x20, #TOK_OR_ASSIGN
    b.eq .Liba_compound
    mov x24, #IR_XOR
    cmp x20, #TOK_XOR_ASSIGN
    b.eq .Liba_compound
    mov x24, #IR_SHL
    cmp x20, #TOK_SHL_ASSIGN
    b.eq .Liba_compound
    mov x24, #IR_ASHR
    cmp x20, #TOK_SHR_ASSIGN
    b.eq .Liba_compound
    // Fallthrough: treat as simple assign
    b .Liba_store

.Liba_compound:
    // Emit binop: result = current_val op rhs
    mov x0, x24
    bl _kcc_ir_alloc_instr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    str x23, [x0, #IR_SRC1]
    str x21, [x0, #IR_SRC2]
    mov x19, x0
    bl _kcc_ir_next_vreg
    str x0, [x19, #IR_DEST]
    mov x21, x0                  // new rhs = result vreg
    mov x0, x19
    bl _kcc_ir_emit

.Liba_store:
    // Emit store
    mov x0, #IR_STORE
    bl _kcc_ir_alloc_instr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    str x21, [x0, #IR_SRC1]     // value
    str x22, [x0, #IR_SRC2]     // alloca
    bl _kcc_ir_emit

    mov x0, x21                  // return the stored value's vreg
    b .Liba_done

.Liba_global_store:
    // x22 = name ptr, x21 = rhs vreg, x20 = op token
    // Emit global_ref to get address vreg
    mov x0, #IR_GLOBAL_REF
    bl _kcc_ir_alloc_instr
    str x22, [x0, #IR_SRC1]     // name ptr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    mov x19, x0
    bl _kcc_ir_next_vreg
    str x0, [x19, #IR_DEST]
    mov x22, x0                  // x22 = global addr vreg
    mov x0, x19
    bl _kcc_ir_emit

    // For compound assignment on globals, load-modify-store
    cmp x20, #TOK_ASSIGN
    b.eq .Liba_global_simple

    // Load current value from global
    mov x0, #IR_LOAD
    bl _kcc_ir_alloc_instr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    str x22, [x0, #IR_SRC1]     // global addr vreg
    mov x19, x0
    bl _kcc_ir_next_vreg
    str x0, [x19, #IR_DEST]
    mov x23, x0                  // x23 = current value vreg
    mov x0, x19
    bl _kcc_ir_emit

    // Map compound op to IR opcode (same table as local path)
    mov x24, #IR_ADD
    cmp x20, #TOK_ADD_ASSIGN
    b.eq .Liba_global_compound
    mov x24, #IR_SUB
    cmp x20, #TOK_SUB_ASSIGN
    b.eq .Liba_global_compound
    mov x24, #IR_MUL
    cmp x20, #TOK_MUL_ASSIGN
    b.eq .Liba_global_compound
    mov x24, #IR_SDIV
    cmp x20, #TOK_DIV_ASSIGN
    b.eq .Liba_global_compound
    mov x24, #IR_SMOD
    cmp x20, #TOK_MOD_ASSIGN
    b.eq .Liba_global_compound
    mov x24, #IR_AND
    cmp x20, #TOK_AND_ASSIGN
    b.eq .Liba_global_compound
    mov x24, #IR_OR
    cmp x20, #TOK_OR_ASSIGN
    b.eq .Liba_global_compound
    mov x24, #IR_XOR
    cmp x20, #TOK_XOR_ASSIGN
    b.eq .Liba_global_compound
    mov x24, #IR_SHL
    cmp x20, #TOK_SHL_ASSIGN
    b.eq .Liba_global_compound
    mov x24, #IR_ASHR
    cmp x20, #TOK_SHR_ASSIGN
    b.eq .Liba_global_compound
    b .Liba_global_simple

.Liba_global_compound:
    // Emit binop: result = current_val op rhs
    mov x0, x24
    bl _kcc_ir_alloc_instr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    str x23, [x0, #IR_SRC1]     // current value
    str x21, [x0, #IR_SRC2]     // rhs
    mov x19, x0
    bl _kcc_ir_next_vreg
    str x0, [x19, #IR_DEST]
    mov x21, x0                  // x21 = compound result vreg
    mov x0, x19
    bl _kcc_ir_emit

.Liba_global_simple:
    // Store value to global address
    mov x0, #IR_STORE
    bl _kcc_ir_alloc_instr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    str x21, [x0, #IR_SRC1]     // value (rhs or compound result)
    str x22, [x0, #IR_SRC2]     // global addr
    bl _kcc_ir_emit
    mov x0, x21
    b .Liba_done

.Liba_subscript:
    // LHS is a[i]: x0 = AST_SUBSCRIPT node, x21 = rhs vreg
    // Build GEP from subscript, then store
    bl _kcc_ir_build_subscript_addr
    mov x22, x0                  // x22 = element address vreg

    // Emit store: rhs → element address
    mov x0, #IR_STORE
    bl _kcc_ir_alloc_instr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    str x21, [x0, #IR_SRC1]     // value
    str x22, [x0, #IR_SRC2]     // pointer (GEP result)
    bl _kcc_ir_emit
    mov x0, x21

.Liba_done:
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@| _kcc_ir_build_assign
@}

\paragraph{End-to-end tests.}
Compound assignment operators follow the read-modify-write pattern for
both local and global variables.  For locals, the builder loads via
the alloca vreg; for globals, it emits \texttt{IR\_GLOBAL\_REF} to
materialise the address, then the same load-binop-store sequence.  The
final three tests specifically exercise the global path, which was
initially missing and caused the RHS to overwrite the variable without
reading its current value.

@d Test: codegen compound @{
echo ""
echo "--- Compound Assignment ---"

run_test "add-assign" \
    "int main(void) { int x = 10; x += 5; return x; }" 15

run_test "sub-assign" \
    "int main(void) { int x = 10; x -= 5; return x; }" 5

run_test "mul-assign" \
    "int main(void) { int x = 10; x *= 5; return x; }" 50

run_test "div-assign" \
    "int main(void) { int x = 100; x /= 4; return x; }" 25

run_test "mod-assign" \
    "int main(void) { int x = 17; x %= 5; return x; }" 2

run_test "and-assign" \
    "int main(void) { int x = 0xFF; x &= 0x0F; return x; }" 15

run_test "or-assign" \
    "int main(void) { int x = 0xF0; x |= 0x0F; return x; }" 255

run_test "xor-assign" \
    "int main(void) { int x = 0xFF; x ^= 0x0F; return x; }" 240

run_test "shl-assign" \
    "int main(void) { int x = 1; x <<= 4; return x; }" 16

run_test "shr-assign" \
    "int main(void) { int x = 32; x >>= 2; return x; }" 8

run_test "compound in loop" \
    "int main(void) { int s = 0; for (int i = 1; i <= 5; i++) s += i; return s; }" 15

run_test "chained compound" \
    "int main(void) { int a = 1; int b = 2; a += 10; b *= 3; return a + b; }" 17

run_test "global add-assign" \
    "int g; int main(void) { g = 10; g += 5; return g; }" 15

run_test "global mul-assign" \
    "int g; int main(void) { g = 6; g *= 7; return g; }" 42

run_test "global sub-assign" \
    "int g; int main(void) { g = 10; g -= 3; return g; }" 7
@}

\subsection{Function Call}

A function call walks the argument list (linked via \texttt{AST\_F4}),
evaluates each argument expression, and stores the resulting vregs
into an arena-allocated array.  The array layout is
\texttt{[count, vreg0, vreg1, \ldots]} so the code generator can
marshal arguments into the ABI-correct registers or stack slots.
The \texttt{IR\_CALL} instruction stores the callee name in
\texttt{SRC1} and the argument array pointer in \texttt{SRC2}; the
destination vreg receives the return value.

@d IR: build call @{
// -- kcc_ir_build_call ----------------------------------------------------
// uint64_t kcc_ir_build_call(node *expr)
//   x0 = AST_CALL_EXPR (F0=callee, F1=first_arg linked via F4)
// Evaluates arguments, stores arg vregs in IR_SRC2 array, emits IR_CALL.
// IR_SRC2 points to arena-allocated: [count(8), vreg0(8), vreg1(8), ...]
.text
.globl _kcc_ir_build_call
.p2align 2
_kcc_ir_build_call:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]

    mov x19, x0                   // x19 = AST_CALL_EXPR node

    // Get callee name (assume direct call to ident)
    ldr x0, [x19, #AST_F0]       // callee expr
    cbz x0, .Libc_done_zero
    ldr x1, [x0, #AST_TAG]
    cmp x1, #AST_IDENT_EXPR
    b.ne .Libc_done_zero
    ldr x20, [x0, #AST_F0]       // x20 = callee name ptr

    // Count arguments (walk F4 chain)
    ldr x21, [x19, #AST_F1]      // x21 = first arg
    mov x22, #0                    // x22 = arg count
    mov x0, x21
.Libc_count_args:
    cbz x0, .Libc_count_done
    add x22, x22, #1
    ldr x0, [x0, #AST_F4]
    b .Libc_count_args
.Libc_count_done:

    // Allocate args array: (1 + count) * 8 bytes
    add x0, x22, #1
    lsl x0, x0, #3                // (count+1) * 8
    bl _kcc_arena_alloc
    mov x23, x0                    // x23 = args array
    str x22, [x23]                 // args[0] = count

    // Evaluate each argument expression and store vreg in array
    mov x24, x21                   // x24 = current arg node
    mov x21, #0                    // x21 = arg index
.Libc_eval_args:
    cmp x21, x22
    b.ge .Libc_eval_done
    mov x0, x24
    bl _kcc_ir_build_expr          // returns vreg in x0
    add x1, x21, #1               // offset = (index+1)
    str x0, [x23, x1, lsl #3]     // args[index+1] = vreg
    ldr x24, [x24, #AST_F4]       // next arg
    add x21, x21, #1
    b .Libc_eval_args
.Libc_eval_done:

    // Emit IR_CALL instruction
    mov x0, #IR_CALL
    bl _kcc_ir_alloc_instr
    str x20, [x0, #IR_SRC1]       // callee name
    str x23, [x0, #IR_SRC2]       // args array ptr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    mov x19, x0
    bl _kcc_ir_next_vreg
    str x0, [x19, #IR_DEST]
    mov x20, x0                    // result vreg

    mov x0, x19
    bl _kcc_ir_emit

    mov x0, x20
    b .Libc_done

.Libc_done_zero:
    mov x0, #0
.Libc_done:
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@| _kcc_ir_build_call
@}

\paragraph{End-to-end tests.}
The \texttt{IR\_CALL} instruction carries a callee name and an
arena-allocated argument array.  The code generator loads each
argument vreg from its stack slot into \texttt{x0}--\texttt{x7}
(following AAPCS64), emits a \texttt{BL} with an
\texttt{ARM64\_RELOC\_BRANCH26} relocation, and stores the return
value from \texttt{x0} into the destination vreg's slot.  Locally
defined functions become \texttt{N\_SECT|N\_EXT} symbols; external
calls become \texttt{N\_UNDF|N\_EXT} symbols resolved by the linker.
The recursive factorial test is particularly demanding: it verifies
that the prologue and epilogue correctly save and restore the frame
pointer and link register across a deep call chain.

@d Test: codegen functions @{
echo ""
echo "--- Functions ---"

run_test "simple call" \
    "int foo(int x) { return x + 1; } int main(void) { return foo(41); }" 42

run_test "nested calls" \
    "int foo(int x) { return x + 1; } int main(void) { return foo(foo(1)); }" 3

run_test "multi-arg" \
    "int add(int a, int b) { return a + b; } int main(void) { return add(20, 22); }" 42

run_test "three args" \
    "int sum3(int a, int b, int c) { return a + b + c; } int main(void) { return sum3(10, 20, 12); }" 42

run_test "recursive factorial" \
    "int fact(int n) { if (n <= 1) return 1; return n * fact(n - 1); } int main(void) { return fact(5); }" 120
@}

\subsection{String Literal}

A string literal is represented by \texttt{IR\_STRING\_LIT}, which
carries the data pointer in \texttt{SRC1} and the byte length in
\texttt{SRC2}.  The code generator
(Chapter~\ref{ch:codegen}) later appends this data to the
\texttt{\_\_text} section and emits a PC-relative reference so the
vreg holds the string's run-time address.

@d IR: build string literal @{
// -- kcc_ir_build_string_lit ----------------------------------------------
// uint64_t kcc_ir_build_string_lit(node *lit)
//   x0 = AST_STR_LIT (F0=str_ptr, F1=str_len)
// Returns vreg holding the string's address.
.text
.globl _kcc_ir_build_string_lit
.p2align 2
_kcc_ir_build_string_lit:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    mov x19, x0
    ldr x20, [x19, #AST_F0]     // str_ptr
    ldr x21, [x19, #AST_F1]     // str_len

    mov x0, #IR_STRING_LIT
    bl _kcc_ir_alloc_instr
    mov x19, x0                  // save instr

    str x20, [x19, #IR_SRC1]    // str data pointer
    str x21, [x19, #IR_SRC2]    // str length

    // Type: use int for now (value is a 64-bit pointer)
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr x0, [x0]
    str x0, [x19, #IR_TYPE]

    bl _kcc_ir_next_vreg
    str x0, [x19, #IR_DEST]
    mov x20, x0                  // save vreg

    mov x0, x19
    bl _kcc_ir_emit

    mov x0, x20                  // return vreg

    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_ir_build_string_lit
@}

\subsection{Conditional Expression}

The ternary operator \texttt{cond ? then : else} is lowered to three
fresh basic blocks plus a temporary alloca that serves as a rendezvous
point.  The condition vreg feeds an \texttt{IR\_BR\_COND} that routes
control to the \emph{then\_bb} or \emph{else\_bb}.  Each arm evaluates
its expression and \emph{stores} the result into the shared alloca,
then branches unconditionally to the \emph{merge\_bb}.  The merge block
loads the result back from the alloca, producing a single vreg that
the caller can reference regardless of which branch executed.

This store/load pattern replaces the earlier approach of ``returning
the last vreg,'' which failed because the then-branch vreg was never
referenced in the merge block and DCE eliminated it.  The alloca
approach works naturally with the all-spill code generator and avoids
phi nodes entirely.

@d IR: build conditional @{
// -- kcc_ir_build_cond_expr -----------------------------------------------
// uint64_t kcc_ir_build_cond_expr(node *expr)
//   x0 = AST_COND_EXPR (F0=cond, F1=then, F2=else)
// Lowers to: alloca tmp → br_cond → then: store → br merge
//                                  → else: store → br merge
//            merge: load tmp → return vreg
.text
.globl _kcc_ir_build_cond_expr
.p2align 2
_kcc_ir_build_cond_expr:
    stp x29, x30, [sp, #-80]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    str x25, [sp, #64]

    mov x19, x0

    // Allocate a temporary slot for the result
    mov x0, #IR_ALLOCA
    bl _kcc_ir_alloc_instr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    mov x20, x0                  // x20 = alloca instr
    bl _kcc_ir_next_vreg
    str x0, [x20, #IR_DEST]
    mov x25, x0                  // x25 = alloca vreg (result slot)
    mov x0, x20
    bl _kcc_ir_emit

    // Build condition
    ldr x0, [x19, #AST_F0]
    bl _kcc_ir_build_expr
    mov x20, x0                  // cond vreg

    // Create then/else/merge BBs
    bl _kcc_ir_alloc_bb
    mov x21, x0                  // then_bb
    bl _kcc_ir_alloc_bb
    mov x22, x0                  // else_bb
    bl _kcc_ir_alloc_bb
    mov x23, x0                  // merge_bb

    // Branch on condition
    mov x0, #IR_BR_COND
    bl _kcc_ir_alloc_instr
    str x20, [x0, #IR_DEST]
    ldr x1, [x21, #BB_ID]
    str x1, [x0, #IR_SRC1]
    ldr x1, [x22, #BB_ID]
    str x1, [x0, #IR_SRC2]
    bl _kcc_ir_emit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

    // Then branch: evaluate, store to alloca, branch to merge
    mov x0, x21
    bl _kcc_ir_set_bb
    ldr x0, [x19, #AST_F1]
    bl _kcc_ir_build_expr
    mov x24, x0                  // then_vreg

    mov x0, #IR_STORE
    bl _kcc_ir_alloc_instr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    str x24, [x0, #IR_SRC1]     // value
    str x25, [x0, #IR_SRC2]     // alloca
    bl _kcc_ir_emit

    mov x0, #IR_BR
    bl _kcc_ir_alloc_instr
    ldr x1, [x23, #BB_ID]
    str x1, [x0, #IR_SRC1]
    bl _kcc_ir_emit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

    // Else branch: evaluate, store to alloca, branch to merge
    mov x0, x22
    bl _kcc_ir_set_bb
    ldr x0, [x19, #AST_F2]
    bl _kcc_ir_build_expr
    mov x24, x0                  // else_vreg

    mov x0, #IR_STORE
    bl _kcc_ir_alloc_instr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    str x24, [x0, #IR_SRC1]     // value
    str x25, [x0, #IR_SRC2]     // alloca
    bl _kcc_ir_emit

    mov x0, #IR_BR
    bl _kcc_ir_alloc_instr
    ldr x1, [x23, #BB_ID]
    str x1, [x0, #IR_SRC1]
    bl _kcc_ir_emit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

    // Merge: load from alloca → result vreg
    mov x0, x23
    bl _kcc_ir_set_bb

    mov x0, #IR_LOAD
    bl _kcc_ir_alloc_instr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    str x25, [x0, #IR_SRC1]     // alloca vreg
    mov x20, x0
    bl _kcc_ir_next_vreg
    str x0, [x20, #IR_DEST]
    mov x24, x0                  // result vreg
    mov x0, x20
    bl _kcc_ir_emit

    mov x0, x24                  // return result vreg

    ldr x25, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #80
    ret
@| _kcc_ir_build_cond_expr
@}

\paragraph{End-to-end tests.}
The alloca rendezvous pattern ensures that whichever branch executes,
the result is stored to a known location and loaded in the merge block.
These tests cover both truth values, variable conditions, initialiser
context, nesting, use as a function argument, and sub-expression
evaluation within the arms.

@d Test: codegen ternary @{
echo ""
echo "--- Ternary Operator ---"

run_test "ternary-true" \
    "int main(void) { return 1 ? 42 : 99; }" 42

run_test "ternary-false" \
    "int main(void) { return 0 ? 42 : 99; }" 99

run_test "ternary-var-cond" \
    "int main(void) { int x = 1; return x ? 10 : 20; }" 10

run_test "ternary-var-init" \
    "int main(void) { int x = 1 ? 5 : 9; return x; }" 5

run_test "ternary-nested" \
    "int main(void) { return 1 ? (0 ? 1 : 2) : 3; }" 2

run_test "ternary-expr-arms" \
    "int main(void) { int a=10; int b=3; return 1 ? a+b : a-b; }" 13

run_test "ternary-false-path" \
    "int main(void) { int a=10; int b=3; return 0 ? a+b : a-b; }" 7
@}

\section{Building Variable Declarations}

A variable declaration emits \texttt{IR\_ALLOCA} to reserve a stack
slot, then records the mapping \texttt{name $\to$ vreg+1} in the
locals hash table (the \texttt{+1} bias lets zero represent ``not
found'').  If the declaration carries an initialiser, the builder
evaluates the expression and emits \texttt{IR\_STORE} to write the
initial value into the alloca.  The type is resolved via
\texttt{\_kcc\_sema\_resolve\_type}; if resolution fails, the
builder falls back to \texttt{i32}.

@d IR: build var decl @{
// -- kcc_ir_build_var_decl ------------------------------------------------
// void kcc_ir_build_var_decl(node *decl)
//   x0 = AST_VAR_DECL (F0=type, F1=name, F2=init)
.text
.globl _kcc_ir_build_var_decl
.p2align 2
_kcc_ir_build_var_decl:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]

    mov x19, x0                  // x19 = decl node (KEEP)
    ldr x20, [x19, #AST_F1]     // x20 = name
    cbz x20, .Libvd_done

    // Resolve type
    ldr x0, [x19, #AST_F0]
    cbz x0, .Libvd_default_type
    bl _kcc_sema_resolve_type
    mov x21, x0
    cbnz x21, .Libvd_alloca
.Libvd_default_type:
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr x21, [x0]

.Libvd_alloca:
    // Determine alloca slot count: arrays need N slots, scalars need 1
    mov x24, #1                  // default: 1 slot
    ldr x0, [x21, #TY_KIND]
    cmp x0, #TY_ARRAY
    b.ne .Libvd_emit_alloca
    ldr x24, [x21, #TY_F1]      // array length
    cbz x24, .Libvd_emit_alloca
    // For arrays, the element type is what we store per slot
    ldr x21, [x21, #TY_F0]      // element type

.Libvd_emit_alloca:
    // Emit alloca — SRC1 = slot count
    mov x0, #IR_ALLOCA
    bl _kcc_ir_alloc_instr
    str x21, [x0, #IR_TYPE]
    str x24, [x0, #IR_SRC1]     // slot count (1 for scalar, N for array)
    mov x22, x0                  // x22 = alloca instr
    bl _kcc_ir_next_vreg
    str x0, [x22, #IR_DEST]
    mov x23, x0                  // x23 = alloca vreg number
    mov x0, x22
    bl _kcc_ir_emit

    // Record in locals: name -> alloca vreg
    mov x0, x20
    bl _kcc_strlen
    mov x2, x0                   // keylen
    adrp x0, _kcc_ir_locals@@PAGE
    add  x0, x0, _kcc_ir_locals@@PAGEOFF
    ldr x0, [x0]
    mov x1, x20                  // key = name
    add x3, x23, #1              // value = alloca vreg + 1 (0 reserved for not-found)
    bl _kcc_ht_put

    // Check for initializer (x19 = decl node, still valid)
    ldr x0, [x19, #AST_F2]      // init expr
    cbz x0, .Libvd_done

    // Build initializer expression
    bl _kcc_ir_build_expr
    mov x24, x0                  // x24 = init value vreg

    // Emit store: value -> alloca
    mov x0, #IR_STORE
    bl _kcc_ir_alloc_instr
    str x21, [x0, #IR_TYPE]     // type
    str x24, [x0, #IR_SRC1]     // value vreg
    str x23, [x0, #IR_SRC2]     // alloca vreg
    bl _kcc_ir_emit

.Libvd_done:
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@| _kcc_ir_build_var_decl
@}

\paragraph{End-to-end tests.}
Each local variable declaration emits an \texttt{IR\_ALLOCA}
instruction, which the code generator maps to a unique 8-byte slot
in the function's stack frame at offset $-(16 + \text{vreg} \times 8)$
from the frame pointer.  An initialiser compiles to an
\texttt{IR\_STORE} that writes the value into the slot, and every
subsequent use compiles to an \texttt{IR\_LOAD} that reads it back.
These tests verify that distinct locals occupy distinct slots and
that values survive across intervening statements.

@d Test: codegen locals @{
echo ""
echo "--- Local Variables ---"

run_test "local variable" \
    "int main(void) { int x = 10; return x; }" 10

run_test "two locals" \
    "int main(void) { int a = 3; int b = 4; return a + b; }" 7

run_test "local reassignment" \
    "int main(void) { int x = 1; x = 42; return x; }" 42

run_test "char literal" \
    "int main(void) { char c = 'A'; return c; }" 65
@}

\section{Building Control Flow}
\label{sec:ir-control-flow}

Control-flow statements create fresh basic blocks and wire them
together with \texttt{IR\_BR} and \texttt{IR\_BR\_COND}.  Each
builder follows the same discipline: after emitting a terminator
(\texttt{IR\_BR}, \texttt{IR\_BR\_COND}, or \texttt{IR\_RET}), it
sets \texttt{BB\_FLAG\_TERMINATED} on the current block so that later
code does not accidentally append instructions after a branch.  Only
after switching to a new block with \texttt{\_kcc\_ir\_set\_bb} can
the builder resume emitting.

\subsection{If Statement}

An \texttt{if} with an else clause produces three blocks:
\emph{then\_bb}, \emph{else\_bb}, and \emph{merge\_bb}.  The
condition vreg feeds a conditional branch; each arm builds its body,
then jumps to \emph{merge\_bb} (unless it was already terminated by a
\texttt{return} or \texttt{break}).  An \texttt{if} without an else
skips the \emph{else\_bb} and branches either to \emph{then\_bb} or
directly to \emph{merge\_bb}.

@d IR: build if @{
// -- kcc_ir_build_if ------------------------------------------------------
// void kcc_ir_build_if(node *stmt)
//   x0 = AST_IF_STMT (F0=cond, F1=then, F2=else)
.text
.globl _kcc_ir_build_if
.p2align 2
_kcc_ir_build_if:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    str x23, [sp, #48]

    mov x19, x0                  // if_stmt

    // Build condition
    ldr x0, [x19, #AST_F0]
    bl _kcc_ir_build_expr
    mov x20, x0                  // cond vreg

    // Create BBs
    bl _kcc_ir_alloc_bb
    mov x21, x0                  // then_bb
    ldr x0, [x19, #AST_F2]      // else branch
    cbz x0, .Libif_no_else

    // Has else
    bl _kcc_ir_alloc_bb
    mov x22, x0                  // else_bb
    bl _kcc_ir_alloc_bb
    mov x23, x0                  // merge_bb

    // Emit br_cond
    mov x0, #IR_BR_COND
    bl _kcc_ir_alloc_instr
    str x20, [x0, #IR_DEST]
    ldr x1, [x21, #BB_ID]
    str x1, [x0, #IR_SRC1]
    ldr x1, [x22, #BB_ID]
    str x1, [x0, #IR_SRC2]
    bl _kcc_ir_emit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

    // Then block
    mov x0, x21
    bl _kcc_ir_set_bb
    ldr x0, [x19, #AST_F1]
    bl _kcc_ir_build_stmt
    // Branch to merge (if not already terminated)
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    tst x1, #BB_FLAG_TERMINATED
    b.ne .Libif_else_block
    mov x0, #IR_BR
    bl _kcc_ir_alloc_instr
    ldr x1, [x23, #BB_ID]
    str x1, [x0, #IR_SRC1]
    bl _kcc_ir_emit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

.Libif_else_block:
    mov x0, x22
    bl _kcc_ir_set_bb
    ldr x0, [x19, #AST_F2]
    bl _kcc_ir_build_stmt
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    tst x1, #BB_FLAG_TERMINATED
    b.ne .Libif_merge
    mov x0, #IR_BR
    bl _kcc_ir_alloc_instr
    ldr x1, [x23, #BB_ID]
    str x1, [x0, #IR_SRC1]
    bl _kcc_ir_emit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

.Libif_merge:
    mov x0, x23
    bl _kcc_ir_set_bb
    b .Libif_done

.Libif_no_else:
    // No else: branch to then_bb or merge_bb
    bl _kcc_ir_alloc_bb
    mov x23, x0                  // merge_bb

    mov x0, #IR_BR_COND
    bl _kcc_ir_alloc_instr
    str x20, [x0, #IR_DEST]
    ldr x1, [x21, #BB_ID]
    str x1, [x0, #IR_SRC1]
    ldr x1, [x23, #BB_ID]
    str x1, [x0, #IR_SRC2]
    bl _kcc_ir_emit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

    mov x0, x21
    bl _kcc_ir_set_bb
    ldr x0, [x19, #AST_F1]
    bl _kcc_ir_build_stmt
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    tst x1, #BB_FLAG_TERMINATED
    b.ne .Libif_merge2
    mov x0, #IR_BR
    bl _kcc_ir_alloc_instr
    ldr x1, [x23, #BB_ID]
    str x1, [x0, #IR_SRC1]
    bl _kcc_ir_emit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

.Libif_merge2:
    mov x0, x23
    bl _kcc_ir_set_bb

.Libif_done:
    ldr x23, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@| _kcc_ir_build_if
@}

\subsection{While Statement}

A \texttt{while} loop creates three blocks: \emph{cond\_bb} (the
loop header), \emph{body\_bb}, and \emph{exit\_bb}.  The entry block
branches unconditionally to \emph{cond\_bb}, which evaluates the
condition and branches to \emph{body\_bb} (true) or \emph{exit\_bb}
(false).  After executing the body, a back-edge branches to
\emph{cond\_bb}.  The loop stack receives \texttt{(break=exit\_bb,
continue=cond\_bb)} so that \texttt{break} and \texttt{continue}
inside the body emit the correct branch target.

@d IR: build while @{
// -- kcc_ir_build_while ---------------------------------------------------
// void kcc_ir_build_while(node *stmt)
//   x0 = AST_WHILE_STMT (F0=cond, F1=body)
.text
.globl _kcc_ir_build_while
.p2align 2
_kcc_ir_build_while:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    str x23, [sp, #48]

    mov x19, x0

    // Create: cond_bb, body_bb, exit_bb
    bl _kcc_ir_alloc_bb
    mov x20, x0                  // cond_bb
    bl _kcc_ir_alloc_bb
    mov x21, x0                  // body_bb
    bl _kcc_ir_alloc_bb
    mov x22, x0                  // exit_bb

    // Branch to cond_bb
    mov x0, #IR_BR
    bl _kcc_ir_alloc_instr
    ldr x1, [x20, #BB_ID]
    str x1, [x0, #IR_SRC1]
    bl _kcc_ir_emit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

    // Cond block
    mov x0, x20
    bl _kcc_ir_set_bb
    ldr x0, [x19, #AST_F0]
    bl _kcc_ir_build_expr
    mov x23, x0                  // cond vreg

    mov x0, #IR_BR_COND
    bl _kcc_ir_alloc_instr
    str x23, [x0, #IR_DEST]
    ldr x1, [x21, #BB_ID]
    str x1, [x0, #IR_SRC1]      // true → body
    ldr x1, [x22, #BB_ID]
    str x1, [x0, #IR_SRC2]      // false → exit
    bl _kcc_ir_emit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

    // Body block — push loop stack (break=exit_bb, continue=cond_bb)
    ldr x0, [x22, #BB_ID]       // break target = exit_bb id
    ldr x1, [x20, #BB_ID]       // continue target = cond_bb id
    bl _kcc_loop_push

    mov x0, x21
    bl _kcc_ir_set_bb
    ldr x0, [x19, #AST_F1]
    bl _kcc_ir_build_stmt

    bl _kcc_loop_pop

    // Loop back to cond
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    tst x1, #BB_FLAG_TERMINATED
    b.ne .Libw_exit
    mov x0, #IR_BR
    bl _kcc_ir_alloc_instr
    ldr x1, [x20, #BB_ID]
    str x1, [x0, #IR_SRC1]
    bl _kcc_ir_emit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

.Libw_exit:
    mov x0, x22
    bl _kcc_ir_set_bb

    ldr x23, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@| _kcc_ir_build_while
@}

\subsection{Do-While Statement}

A \texttt{do-while} loop guarantees at least one body execution.
The CFG is the mirror image of \texttt{while}: the entry block
branches directly to \emph{body\_bb}, which falls through to
\emph{cond\_bb}.  The condition evaluates its expression and branches
back to \emph{body\_bb} (true) or out to \emph{exit\_bb} (false).
The loop stack entries are \texttt{(break=exit\_bb,
continue=cond\_bb)}, just as with \texttt{while}.

@d IR: build do @{
// -- kcc_ir_build_do ------------------------------------------------------
// void kcc_ir_build_do(node *stmt)
//   x0 = AST_DO_STMT (F0=body, F1=cond)
.text
.globl _kcc_ir_build_do
.p2align 2
_kcc_ir_build_do:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    str x23, [sp, #48]

    mov x19, x0

    bl _kcc_ir_alloc_bb
    mov x20, x0                  // body_bb
    bl _kcc_ir_alloc_bb
    mov x21, x0                  // cond_bb
    bl _kcc_ir_alloc_bb
    mov x22, x0                  // exit_bb

    // Branch to body
    mov x0, #IR_BR
    bl _kcc_ir_alloc_instr
    ldr x1, [x20, #BB_ID]
    str x1, [x0, #IR_SRC1]
    bl _kcc_ir_emit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

    // Body — push loop stack (break=exit_bb, continue=cond_bb)
    ldr x0, [x22, #BB_ID]       // break target = exit_bb
    ldr x1, [x21, #BB_ID]       // continue target = cond_bb
    bl _kcc_loop_push

    mov x0, x20
    bl _kcc_ir_set_bb
    ldr x0, [x19, #AST_F0]
    bl _kcc_ir_build_stmt

    bl _kcc_loop_pop

    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    tst x1, #BB_FLAG_TERMINATED
    b.ne .Libd_cond
    mov x0, #IR_BR
    bl _kcc_ir_alloc_instr
    ldr x1, [x21, #BB_ID]
    str x1, [x0, #IR_SRC1]
    bl _kcc_ir_emit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

.Libd_cond:
    mov x0, x21
    bl _kcc_ir_set_bb
    ldr x0, [x19, #AST_F1]
    bl _kcc_ir_build_expr
    mov x23, x0

    mov x0, #IR_BR_COND
    bl _kcc_ir_alloc_instr
    str x23, [x0, #IR_DEST]
    ldr x1, [x20, #BB_ID]
    str x1, [x0, #IR_SRC1]      // true → body (loop)
    ldr x1, [x22, #BB_ID]
    str x1, [x0, #IR_SRC2]      // false → exit
    bl _kcc_ir_emit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

    mov x0, x22
    bl _kcc_ir_set_bb

    ldr x23, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@| _kcc_ir_build_do
@}

\subsection{For Statement}

A \texttt{for} loop is the most complex control-flow construct,
producing four blocks: \emph{cond\_bb}, \emph{body\_bb},
\emph{incr\_bb}, and \emph{exit\_bb}.  The builder first emits the
initialiser (which may be a declaration or expression) into the
current block, then branches to \emph{cond\_bb}.  The condition block
evaluates its expression (or branches unconditionally to the body for
\texttt{for(;;)}), the body executes, control flows to
\emph{incr\_bb} for the increment expression, and a back-edge returns
to \emph{cond\_bb}.  Note that \texttt{continue} targets
\emph{incr\_bb}, not \emph{cond\_bb}---ensuring the increment runs
before the next condition test.

@d IR: build for @{
// -- kcc_ir_build_for -----------------------------------------------------
// void kcc_ir_build_for(node *stmt)
//   x0 = AST_FOR_STMT (F0=init, F1=cond, F2=incr, F3=body)
.text
.globl _kcc_ir_build_for
.p2align 2
_kcc_ir_build_for:
    stp x29, x30, [sp, #-80]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]

    mov x19, x0

    // Build init (may be decl or expr)
    ldr x0, [x19, #AST_F0]
    cbz x0, .Libfor_bbs
    bl _kcc_ir_build_stmt

.Libfor_bbs:
    bl _kcc_ir_alloc_bb
    mov x20, x0                  // cond_bb
    bl _kcc_ir_alloc_bb
    mov x21, x0                  // body_bb
    bl _kcc_ir_alloc_bb
    mov x22, x0                  // incr_bb
    bl _kcc_ir_alloc_bb
    mov x23, x0                  // exit_bb

    // Branch to cond
    mov x0, #IR_BR
    bl _kcc_ir_alloc_instr
    ldr x1, [x20, #BB_ID]
    str x1, [x0, #IR_SRC1]
    bl _kcc_ir_emit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

    // Cond block
    mov x0, x20
    bl _kcc_ir_set_bb
    ldr x0, [x19, #AST_F1]
    cbz x0, .Libfor_no_cond
    bl _kcc_ir_build_expr
    mov x24, x0

    mov x0, #IR_BR_COND
    bl _kcc_ir_alloc_instr
    str x24, [x0, #IR_DEST]
    ldr x1, [x21, #BB_ID]
    str x1, [x0, #IR_SRC1]
    ldr x1, [x23, #BB_ID]
    str x1, [x0, #IR_SRC2]
    bl _kcc_ir_emit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]
    b .Libfor_body

.Libfor_no_cond:
    // Infinite loop: branch directly to body
    mov x0, #IR_BR
    bl _kcc_ir_alloc_instr
    ldr x1, [x21, #BB_ID]
    str x1, [x0, #IR_SRC1]
    bl _kcc_ir_emit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

.Libfor_body:
    // Push loop stack (break=exit_bb, continue=incr_bb)
    ldr x0, [x23, #BB_ID]       // break target = exit_bb
    ldr x1, [x22, #BB_ID]       // continue target = incr_bb
    bl _kcc_loop_push

    mov x0, x21
    bl _kcc_ir_set_bb
    ldr x0, [x19, #AST_F3]
    cbz x0, .Libfor_pop_incr
    bl _kcc_ir_build_stmt

.Libfor_pop_incr:
    bl _kcc_loop_pop

.Libfor_incr:
    // Branch to incr (if not terminated)
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    tst x1, #BB_FLAG_TERMINATED
    b.ne .Libfor_incr_bb
    mov x0, #IR_BR
    bl _kcc_ir_alloc_instr
    ldr x1, [x22, #BB_ID]
    str x1, [x0, #IR_SRC1]
    bl _kcc_ir_emit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

.Libfor_incr_bb:
    mov x0, x22
    bl _kcc_ir_set_bb
    ldr x0, [x19, #AST_F2]
    cbz x0, .Libfor_loop_back
    bl _kcc_ir_build_expr        // discard result

.Libfor_loop_back:
    mov x0, #IR_BR
    bl _kcc_ir_alloc_instr
    ldr x1, [x20, #BB_ID]
    str x1, [x0, #IR_SRC1]
    bl _kcc_ir_emit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

    mov x0, x23
    bl _kcc_ir_set_bb

    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #80
    ret
@| _kcc_ir_build_for
@}

\paragraph{End-to-end tests.}
The IR builder lowers each control-flow construct into a graph of basic
blocks connected by \texttt{IR\_BR} (unconditional) and
\texttt{IR\_BR\_COND} (conditional) terminators.  An \texttt{if/else}
produces a diamond of four blocks (entry, true, false, merge); a
\texttt{while} loop produces a condition block with a back-edge; a
\texttt{for} loop adds a separate increment block that
\texttt{continue} targets.  The code generator records each basic
block's starting offset in a hash table and patches forward branches
after all blocks have been emitted.  These tests use the explicit
\texttt{i = i + 1} form to isolate loop lowering from the
increment operators tested elsewhere.

@d Test: codegen control flow @{
echo ""
echo "--- Control Flow ---"

run_test "if true" \
    "int main(void) { if (1) return 10; return 20; }" 10

run_test "if false" \
    "int main(void) { if (0) return 10; return 20; }" 20

run_test "if-else" \
    "int main(void) { int x = 5; if (x > 3) return 1; else return 0; }" 1

run_test "nested if" \
    "int main(void) { int x = 5; if (x > 0) { if (x > 3) return 1; return 2; } return 3; }" 1

run_test "while loop" \
    "int main(void) { int x = 0; while (x < 10) x = x + 1; return x; }" 10

run_test "do-while loop" \
    "int main(void) { int i = 0; int s = 0; do { s = s + i; i = i + 1; } while (i <= 5); return s; }" 15

run_test "for loop" \
    "int main(void) { int s = 0; for (int i = 0; i < 5; i = i + 1) s = s + 2; return s; }" 10

run_test "break" \
    "int main(void) { int i = 0; while (1) { if (i == 5) break; i = i + 1; } return i; }" 5

run_test "continue" \
    "int main(void) { int s = 0; for (int i = 0; i < 10; i = i + 1) { if (i % 2 == 0) continue; s = s + 1; } return s; }" 5

run_test "multiple returns" \
    "int f(int x) { if (x > 0) return 1; if (x < 0) return 2; return 0; } int main(void) { return f(5) + f(-3) + f(0); }" 3
@}

\subsection{Switch Statement}

A \texttt{switch} statement (\stdref{6.8.4.2}) evaluates a controlling
expression and transfers control to the matching \texttt{case} label.
The IR builder lowers it to a compare-and-branch dispatch chain: for
each \texttt{case}, a fresh basic block tests \texttt{cond\_vreg ==
case\_val} and branches to the case body on success or to the next
comparison on failure.  After all cases, the chain falls through to
the \texttt{default} body if present, or to the exit block otherwise.

Case bodies observe C fall-through semantics: unless a \texttt{break}
terminates the current basic block, execution flows into the next
case's body.  The builder achieves this by emitting an unconditional
branch from a non-terminated body block to the next case's block.  The
exit block is pushed onto the loop stack as a break target so that
\texttt{break} statements inside the switch branch to it.

The builder uses three passes over the compound body's item list.
Pass~1 creates a basic block for every \texttt{case} and
\texttt{default} label and stashes the BB pointer in an unused AST
field (\texttt{F2} for cases, \texttt{F1} for default).  Pass~2 emits
the dispatch chain: each comparison occupies its own basic block
terminated by \texttt{IR\_BR\_COND}.  Pass~3 walks the items once more
and builds each statement in the appropriate basic block, inserting
fall-through branches between consecutive labels when the preceding
block is not yet terminated.

@d IR: build switch @{
// -- kcc_ir_build_switch --------------------------------------------------
// void kcc_ir_build_switch(node *stmt)
//   x0 = AST_SWITCH_STMT (F0=expr, F1=compound body)
// Lowers to: dispatch chain → case bodies → exit_bb
.text
.globl _kcc_ir_build_switch
.p2align 2
_kcc_ir_build_switch:
    stp x29, x30, [sp, #-96]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    stp x25, x26, [sp, #64]
    str x27, [sp, #80]

    mov x19, x0                  // x19 = switch node

    // 1. Evaluate controlling expression
    ldr x0, [x19, #AST_F0]
    bl _kcc_ir_build_expr
    mov x20, x0                  // x20 = cond_vreg

    // 2. Allocate exit BB
    bl _kcc_ir_alloc_bb
    mov x21, x0                  // x21 = exit_bb

    // 3. Get first item of compound body
    ldr x0, [x19, #AST_F1]      // compound stmt
    ldr x23, [x0, #AST_F0]      // x23 = first item (constant)

    mov x22, #0                  // x22 = default_bb (null)

    // ── Pass 1: create BBs for each case/default ──
    mov x24, x23
.Lsw_scan:
    cbz x24, .Lsw_scan_done
    ldr x0, [x24, #AST_TAG]
    cmp x0, #AST_CASE_STMT
    b.ne .Lsw_scan_nocase
    bl _kcc_ir_alloc_bb
    str x0, [x24, #AST_F2]      // stash case BB in F2
    b .Lsw_scan_next
.Lsw_scan_nocase:
    cmp x0, #AST_DEFAULT_STMT
    b.ne .Lsw_scan_next
    bl _kcc_ir_alloc_bb
    str x0, [x24, #AST_F1]      // stash default BB in F1
    mov x22, x0                  // remember default_bb
.Lsw_scan_next:
    ldr x24, [x24, #AST_F4]
    b .Lsw_scan
.Lsw_scan_done:

    // ── Pass 2: dispatch chain ──
    // For each case: emit const + cmp_eq + br_cond in current BB,
    // then create a fresh dispatch BB for the next comparison.
    mov x24, x23
.Lsw_disp:
    cbz x24, .Lsw_disp_done
    ldr x0, [x24, #AST_TAG]
    cmp x0, #AST_CASE_STMT
    b.ne .Lsw_disp_next

    // Get case constant value
    ldr x0, [x24, #AST_F0]      // case expr (AST_INT_LIT)
    ldr x25, [x0, #AST_F0]      // integer value

    // Emit IR_CONST for case value
    mov x0, #IR_CONST
    bl _kcc_ir_alloc_instr
    mov x26, x0
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x26, #IR_TYPE]
    str x25, [x26, #IR_SRC1]    // immediate value
    bl _kcc_ir_next_vreg
    str x0, [x26, #IR_DEST]
    mov x25, x0                  // x25 = case_const_vreg
    mov x0, x26
    bl _kcc_ir_emit

    // Emit IR_CMP_EQ(cond_vreg, case_const_vreg)
    mov x0, #IR_CMP_EQ
    bl _kcc_ir_alloc_instr
    mov x26, x0
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x26, #IR_TYPE]
    str x20, [x26, #IR_SRC1]    // cond_vreg
    str x25, [x26, #IR_SRC2]    // case_const_vreg
    bl _kcc_ir_next_vreg
    str x0, [x26, #IR_DEST]
    mov x25, x0                  // x25 = cmp_vreg
    mov x0, x26
    bl _kcc_ir_emit

    // Create next dispatch BB
    bl _kcc_ir_alloc_bb
    mov x27, x0                  // x27 = next_dispatch_bb

    // Emit IR_BR_COND: true → case_bb, false → next_dispatch_bb
    mov x0, #IR_BR_COND
    bl _kcc_ir_alloc_instr
    str x25, [x0, #IR_DEST]     // condition vreg
    ldr x1, [x24, #AST_F2]      // case_bb (stashed in pass 1)
    ldr x1, [x1, #BB_ID]
    str x1, [x0, #IR_SRC1]      // true target
    ldr x1, [x27, #BB_ID]
    str x1, [x0, #IR_SRC2]      // false target
    bl _kcc_ir_emit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

    // Switch to next dispatch BB
    mov x0, x27
    bl _kcc_ir_set_bb

.Lsw_disp_next:
    ldr x24, [x24, #AST_F4]
    b .Lsw_disp
.Lsw_disp_done:

    // End of dispatch chain: branch to default or exit
    cbz x22, .Lsw_disp_exit
    // Branch to default_bb
    mov x0, #IR_BR
    bl _kcc_ir_alloc_instr
    ldr x1, [x22, #BB_ID]
    str x1, [x0, #IR_SRC1]
    bl _kcc_ir_emit
    b .Lsw_disp_term
.Lsw_disp_exit:
    // Branch to exit_bb
    mov x0, #IR_BR
    bl _kcc_ir_alloc_instr
    ldr x1, [x21, #BB_ID]
    str x1, [x0, #IR_SRC1]
    bl _kcc_ir_emit
.Lsw_disp_term:
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

    // ── Pass 3: emit case/default bodies ──
    // Push break target (continue=0, not valid in switch)
    ldr x0, [x21, #BB_ID]       // break → exit_bb
    mov x1, #0                  // no continue target
    bl _kcc_loop_push

    mov x24, x23
.Lsw_body:
    cbz x24, .Lsw_body_done
    ldr x0, [x24, #AST_TAG]
    cmp x0, #AST_CASE_STMT
    b.eq .Lsw_body_case
    cmp x0, #AST_DEFAULT_STMT
    b.eq .Lsw_body_default

    // Regular statement: build in current BB
    mov x0, x24
    bl _kcc_ir_build_stmt
    b .Lsw_body_next

.Lsw_body_case:
    ldr x25, [x24, #AST_F2]     // case_bb

    // If current BB not terminated, emit fallthrough branch
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    tst x1, #BB_FLAG_TERMINATED
    b.ne .Lsw_case_set_bb
    mov x0, #IR_BR
    bl _kcc_ir_alloc_instr
    ldr x1, [x25, #BB_ID]
    str x1, [x0, #IR_SRC1]
    bl _kcc_ir_emit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]
.Lsw_case_set_bb:
    mov x0, x25
    bl _kcc_ir_set_bb
    ldr x0, [x24, #AST_F1]      // case body statement
    cbz x0, .Lsw_body_next
    bl _kcc_ir_build_stmt
    b .Lsw_body_next

.Lsw_body_default:
    // If current BB not terminated, emit fallthrough
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    tst x1, #BB_FLAG_TERMINATED
    b.ne .Lsw_default_set_bb
    mov x0, #IR_BR
    bl _kcc_ir_alloc_instr
    ldr x1, [x22, #BB_ID]
    str x1, [x0, #IR_SRC1]
    bl _kcc_ir_emit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]
.Lsw_default_set_bb:
    mov x0, x22
    bl _kcc_ir_set_bb
    ldr x0, [x24, #AST_F0]      // default body statement
    cbz x0, .Lsw_body_next
    bl _kcc_ir_build_stmt
    b .Lsw_body_next

.Lsw_body_next:
    ldr x24, [x24, #AST_F4]
    b .Lsw_body
.Lsw_body_done:
    bl _kcc_loop_pop

    // If current BB not terminated, branch to exit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    tst x1, #BB_FLAG_TERMINATED
    b.ne .Lsw_set_exit
    mov x0, #IR_BR
    bl _kcc_ir_alloc_instr
    ldr x1, [x21, #BB_ID]
    str x1, [x0, #IR_SRC1]
    bl _kcc_ir_emit
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

.Lsw_set_exit:
    mov x0, x21
    bl _kcc_ir_set_bb

    ldr x27, [sp, #80]
    ldp x25, x26, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #96
    ret
@| _kcc_ir_build_switch
@}

\paragraph{End-to-end tests.}
The dispatch chain compares the controlling expression against each
\texttt{case} constant in order and branches to the first match.
Fall-through between cases follows C semantics: without a
\texttt{break}, control flows into the next case body.  The
\texttt{default} label catches any value not matched by the cases.

@d Test: codegen switch @{
echo ""
echo "--- Switch ---"

run_test "switch-case1" \
    "int main(void) { switch (1) { case 1: return 10; case 2: return 20; } return 0; }" 10

run_test "switch-case2" \
    "int main(void) { switch (2) { case 1: return 10; case 2: return 20; } return 0; }" 20

run_test "switch-default" \
    "int main(void) { switch (5) { case 1: return 10; default: return 99; } return 0; }" 99

run_test "switch-no-match" \
    "int main(void) { switch (5) { case 1: return 10; case 2: return 20; } return 0; }" 0

run_test "switch-break" \
    "int main(void) { int r = 0; switch (2) { case 1: r = 10; break; case 2: r = 20; break; case 3: r = 30; break; } return r; }" 20

run_test "switch-fallthrough" \
    "int main(void) { int r = 0; switch (1) { case 1: r = r + 10; case 2: r = r + 20; case 3: r = r + 30; break; } return r; }" 60

run_test "switch-default-fallthrough" \
    "int main(void) { int r = 0; switch (9) { case 1: r = 1; break; default: r = 50; break; } return r; }" 50

run_test "switch-var-expr" \
    "int main(void) { int x = 3; int r = 0; switch (x) { case 1: r = 10; break; case 3: r = 30; break; } return r; }" 30
@}

\subsection{Break and Continue}

The loop stack is a fixed-size array of 16 entries (supporting up to
16 levels of nesting), where each entry holds a
\texttt{(break\_bb\_id, continue\_bb\_id)} pair.  Every loop builder
pushes its targets onto the stack before building the body, and pops
after.  \texttt{\_kcc\_ir\_build\_break} reads the break target from
the stack top, emits \texttt{IR\_BR} to that block, and marks the
current block terminated.  \texttt{\_kcc\_ir\_build\_continue} does
the same with the continue target.

@d IR: build break @{
// -- Loop Stack -----------------------------------------------------------
// Tracks break/continue BB targets for nested loops.
// Max 16 nesting levels. Each entry: {break_bb_id, continue_bb_id} (8 bytes each).
.text

// void _kcc_loop_push(uint64_t break_bb_id, uint64_t continue_bb_id)
.globl _kcc_loop_push
.p2align 2
_kcc_loop_push:
    adrp x2, _kcc_loop_depth@@PAGE
    add  x2, x2, _kcc_loop_depth@@PAGEOFF
    ldr  x3, [x2]
    // Store break_bb at stack[depth*2]
    adrp x4, _kcc_loop_stack@@PAGE
    add  x4, x4, _kcc_loop_stack@@PAGEOFF
    lsl  x5, x3, #4              // depth * 16
    str  x0, [x4, x5]            // break_bb_id
    add  x5, x5, #8
    str  x1, [x4, x5]            // continue_bb_id
    add  x3, x3, #1
    str  x3, [x2]
    ret

// void _kcc_loop_pop(void)
.globl _kcc_loop_pop
.p2align 2
_kcc_loop_pop:
    adrp x0, _kcc_loop_depth@@PAGE
    add  x0, x0, _kcc_loop_depth@@PAGEOFF
    ldr  x1, [x0]
    sub  x1, x1, #1
    str  x1, [x0]
    ret
@| _kcc_loop_push
@| _kcc_loop_pop
@}

\paragraph{Break Statement.}
When the parser encounters a \texttt{break} statement inside a loop,
the IR builder must emit an unconditional branch to the loop's exit
basic block.  \texttt{\_kcc\_ir\_build\_break} reads the break target
from the top of the loop stack, allocates an \texttt{IR\_BR} instruction
pointing at that block, and marks the current basic block as terminated
so that no further instructions are appended to it (\stdref{6.8.6.3}).

@d IR: build break @{
// -- kcc_ir_build_break ---------------------------------------------------
// void kcc_ir_build_break(node *stmt)
// Emits unconditional branch to current loop's break target (exit BB).
.globl _kcc_ir_build_break
.p2align 2
_kcc_ir_build_break:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    // Get break target from top of loop stack
    adrp x0, _kcc_loop_depth@@PAGE
    add  x0, x0, _kcc_loop_depth@@PAGEOFF
    ldr  x0, [x0]
    sub  x0, x0, #1              // top index
    lsl  x0, x0, #4              // *16
    adrp x1, _kcc_loop_stack@@PAGE
    add  x1, x1, _kcc_loop_stack@@PAGEOFF
    ldr  x19, [x1, x0]          // x19 = break_bb_id (callee-saved)

    // Emit IR_BR to break target
    mov x0, #IR_BR
    bl _kcc_ir_alloc_instr
    str x19, [x0, #IR_SRC1]
    bl _kcc_ir_emit

    // Mark current BB as terminated
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_ir_build_break
@}

A \texttt{continue} statement jumps to the loop's condition-test basic
block rather than the exit.  The logic mirrors \texttt{break} except
that it reads the continue target (offset~+8) from the loop stack
entry instead of the break target (offset~+0).

@d IR: build continue @{
// -- kcc_ir_build_continue ------------------------------------------------
// void kcc_ir_build_continue(node *stmt)
// Emits unconditional branch to current loop's continue target (cond BB).
.text
.globl _kcc_ir_build_continue
.p2align 2
_kcc_ir_build_continue:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    // Get continue target from top of loop stack
    adrp x0, _kcc_loop_depth@@PAGE
    add  x0, x0, _kcc_loop_depth@@PAGEOFF
    ldr  x0, [x0]
    sub  x0, x0, #1              // top index
    lsl  x0, x0, #4              // *16
    add  x0, x0, #8              // offset to continue_bb_id
    adrp x1, _kcc_loop_stack@@PAGE
    add  x1, x1, _kcc_loop_stack@@PAGEOFF
    ldr  x19, [x1, x0]          // x19 = continue_bb_id (callee-saved)

    // Emit IR_BR to continue target
    mov x0, #IR_BR
    bl _kcc_ir_alloc_instr
    str x19, [x0, #IR_SRC1]
    bl _kcc_ir_emit

    // Mark current BB as terminated
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_ir_build_continue
@}

\paragraph{End-to-end tests: miscellaneous.}
The comma operator evaluates the left operand for its side effects,
discards the result, and returns the right operand---the IR builder
simply calls \texttt{kcc\_ir\_build\_expr} on each side and returns
the second vreg.  The remaining tests guard boundary conditions:
returning zero (ensures the epilogue does not clobber \texttt{x0})
and returning~255 (the maximum value representable in an 8-bit exit
status on Unix).

@d Test: codegen misc @{
echo ""
echo "--- Miscellaneous ---"

run_test "comma operator" \
    "int main(void) { return (1, 2, 3); }" 3

run_test "return zero" \
    "int main(void) { return 0; }" 0

run_test "large constant" \
    "int main(void) { return 255; }" 255
@}

\section{String Constants}

The IR dump and builder share a set of string constants for opcode
mnemonics, punctuation, and formatting.  These live in the
\texttt{\_\_TEXT,\_\_cstring} section so the linker can deduplicate
them.  The loop stack data (depth counter and 16-entry array) is
placed in \texttt{.data} since it is mutable at run time.

@d IR: builder data @{
// -- IR builder string constants ------------------------------------------
.section __TEXT,__cstring,cstring_literals

_kcc_ir_str_func:       .asciz "func @@"
_kcc_ir_str_arrow:      .asciz "() -> "
_kcc_ir_str_colon_nl:   .asciz ":\n"
_kcc_ir_str_bb:         .asciz "  bb"
_kcc_ir_str_indent:     .asciz "    "
_kcc_ir_str_eq:         .asciz " = "
_kcc_ir_str_comma:      .asciz ", %"
_kcc_ir_str_ptr_pct:    .asciz ", ptr %"
_kcc_ir_str_comma_bb:   .asciz ", bb"
_kcc_ir_str_unknown:    .asciz "???"

// Opcode names
_kcc_ir_op_add:         .asciz "add"
_kcc_ir_op_sub:         .asciz "sub"
_kcc_ir_op_mul:         .asciz "mul"
_kcc_ir_op_sdiv:        .asciz "sdiv"
_kcc_ir_op_udiv:        .asciz "udiv"
_kcc_ir_op_smod:        .asciz "smod"
_kcc_ir_op_umod:        .asciz "umod"
_kcc_ir_op_neg:         .asciz "neg"
_kcc_ir_op_and:         .asciz "and"
_kcc_ir_op_or:          .asciz "or"
_kcc_ir_op_xor:         .asciz "xor"
_kcc_ir_op_shl:         .asciz "shl"
_kcc_ir_op_lshr:        .asciz "lshr"
_kcc_ir_op_ashr:        .asciz "ashr"
_kcc_ir_op_not:         .asciz "not"
_kcc_ir_op_cmp_eq:      .asciz "cmp_eq"
_kcc_ir_op_cmp_ne:      .asciz "cmp_ne"
_kcc_ir_op_cmp_slt:     .asciz "cmp_slt"
_kcc_ir_op_cmp_sle:     .asciz "cmp_sle"
_kcc_ir_op_cmp_sgt:     .asciz "cmp_sgt"
_kcc_ir_op_cmp_sge:     .asciz "cmp_sge"
_kcc_ir_op_load:        .asciz "load "
_kcc_ir_op_store:       .asciz "store "
_kcc_ir_op_alloca:      .asciz "alloca "
_kcc_ir_op_gep:         .asciz "gep "
_kcc_ir_op_br:          .asciz "br bb"
_kcc_ir_op_br_cond:     .asciz "br_cond %"
_kcc_ir_op_ret:         .asciz "ret "
_kcc_ir_op_call:        .asciz "call "
_kcc_ir_op_sext:        .asciz "sext"
_kcc_ir_op_zext:        .asciz "zext"
_kcc_ir_op_trunc:       .asciz "trunc"
_kcc_ir_op_const:       .asciz "const "
_kcc_ir_op_nop:         .asciz "nop"
_kcc_ir_op_global_ref:  .asciz "global_ref "
_kcc_ir_op_string_lit:  .asciz "string_lit "

// -- Loop stack (break/continue targets) --
.data
.p2align 3
.globl _kcc_loop_depth
_kcc_loop_depth: .quad 0
.globl _kcc_loop_stack
_kcc_loop_stack: .space 256   // 16 levels * 16 bytes (break_bb, continue_bb)

// Short type names
.section __TEXT,__cstring,cstring_literals
_kcc_ir_ty_void:        .asciz "void"
_kcc_ir_ty_i1:          .asciz "i1"
_kcc_ir_ty_i8:          .asciz "i8"
_kcc_ir_ty_i16:         .asciz "i16"
_kcc_ir_ty_i32:         .asciz "i32"
_kcc_ir_ty_i64:         .asciz "i64"
_kcc_ir_ty_f32:         .asciz "f32"
_kcc_ir_ty_f64:         .asciz "f64"
_kcc_ir_ty_ptr:         .asciz "ptr"
_kcc_ir_ty_struct:      .asciz "struct"
_kcc_ir_ty_unknown:     .asciz "?type"
@| _kcc_ir_str_func
@| _kcc_ir_str_arrow
@| _kcc_ir_str_colon_nl
@| _kcc_ir_str_bb
@| _kcc_ir_str_indent
@| _kcc_ir_str_eq
@| _kcc_ir_str_comma
@| _kcc_ir_str_ptr_pct
@| _kcc_ir_str_comma_bb
@| _kcc_ir_str_unknown
@| _kcc_ir_op_add
@| _kcc_ir_op_sub
@| _kcc_ir_op_mul
@| _kcc_ir_op_sdiv
@| _kcc_ir_op_udiv
@| _kcc_ir_op_smod
@| _kcc_ir_op_umod
@| _kcc_ir_op_neg
@| _kcc_ir_op_and
@| _kcc_ir_op_or
@| _kcc_ir_op_xor
@| _kcc_ir_op_shl
@| _kcc_ir_op_lshr
@| _kcc_ir_op_ashr
@| _kcc_ir_op_not
@| _kcc_ir_op_cmp_eq
@| _kcc_ir_op_cmp_ne
@| _kcc_ir_op_cmp_slt
@| _kcc_ir_op_cmp_sle
@| _kcc_ir_op_cmp_sgt
@| _kcc_ir_op_cmp_sge
@| _kcc_ir_op_load
@| _kcc_ir_op_store
@| _kcc_ir_op_alloca
@| _kcc_ir_op_gep
@| _kcc_ir_op_br
@| _kcc_ir_op_br_cond
@| _kcc_ir_op_ret
@| _kcc_ir_op_call
@| _kcc_ir_op_sext
@| _kcc_ir_op_zext
@| _kcc_ir_op_trunc
@| _kcc_ir_op_const
@| _kcc_ir_op_nop
@| _kcc_ir_op_global_ref
@| _kcc_ir_op_string_lit
@| _kcc_loop_depth
@| _kcc_loop_stack
@| _kcc_ir_ty_void
@| _kcc_ir_ty_i1
@| _kcc_ir_ty_i8
@| _kcc_ir_ty_i16
@| _kcc_ir_ty_i32
@| _kcc_ir_ty_i64
@| _kcc_ir_ty_f32
@| _kcc_ir_ty_f64
@| _kcc_ir_ty_ptr
@| _kcc_ir_ty_struct
@| _kcc_ir_ty_unknown
@}
