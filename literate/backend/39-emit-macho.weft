% 39-emit-macho.weft — Mach-O Object File Writer
%
% This chapter writes a minimal Mach-O 64-bit object file containing:
%   - One __TEXT,__text section (the generated code)
%   - A symbol table (defined functions + external references)
%   - Relocations for BL instructions to external functions
%   - A string table for symbol names
%
% The file layout follows Apple's conventions strictly so that ld64
% can link the result into a working executable.

\chapter{Mach-O Emission}
\label{ch:emit-macho}

Once all machine code has been emitted and relocations recorded, the compiler must package the result into a file format that the system linker can consume.  This chapter writes a minimal Mach-O 64-bit object file (\texttt{MH\_OBJECT}) following Apple's conventions.  The output contains a \texttt{\_\_TEXT,\_\_text} section holding the generated code, a symbol table of defined and external symbols, relocation entries for branch and data-reference instructions, a string table for symbol names, and an \texttt{LC\_BUILD\_VERSION} load command to suppress linker warnings.

\section{Constants}

The constants define Mach-O magic numbers, CPU type codes, load
command identifiers, and structure sizes according to the
\texttt{mach-o/loader.h} and \texttt{mach-o/nlist.h} headers.
All values are for the 64-bit ARM64 object file format
(\texttt{MH\_OBJECT}).

@d MachO: constants @{
// -- Mach-O constants ---------------------------------------------------------
.equ MH_MAGIC_64,              0xFEEDFACF
.equ CPU_TYPE_ARM64,           0x0100000C   // CPU_TYPE_ARM64
.equ CPU_SUBTYPE_ALL,          0x00000000
.equ MH_OBJECT,               0x01
.equ MH_SUBSECTIONS_VIA_SYMBOLS, 0x2000

// Load commands
.equ LC_SEGMENT_64,            0x19
.equ LC_SYMTAB,               0x02
.equ LC_DYSYMTAB,             0x0B
.equ LC_BUILD_VERSION,        0x32

// Sizes
.equ MACH_HEADER_SIZE,        32
.equ SEGMENT_CMD_SIZE,        72
.equ SECTION_64_SIZE,         80
.equ SYMTAB_CMD_SIZE,         24
.equ DYSYMTAB_CMD_SIZE,       80
.equ BUILD_VERSION_CMD_SIZE,  24
.equ NLIST_64_SIZE,           16
.equ RELOC_INFO_SIZE,         8

// Section types/attributes
.equ S_REGULAR,               0x00
.equ S_MOD_INIT_FUNC_POINTERS, 0x09
.equ S_ATTR_PURE_INSTRUCTIONS, 0x80000000
.equ S_ATTR_SOME_INSTRUCTIONS, 0x00000400
.equ ARM64_RELOC_UNSIGNED,    0x00

// Relocation info bit packing
// r_info = r_symbolnum(24) | r_pcrel(1) | r_length(2) | r_extern(1) | r_type(4)
// For ARM64_RELOC_BRANCH26: pcrel=1, length=2 (4 bytes), extern=1, type=2

// Output buffer
.equ MACHO_BUF_SIZE,          65536
@}

\section{Output Buffer Management}

Rather than seeking and writing pieces of the file in random order,
we build the entire object file in one arena-allocated buffer and flush
it in a single \texttt{write} system call.  A \emph{fixed} 64\,KB buffer
was the original design, but that silently overflowed on large inputs---a
deeply nested or very long function easily emits more than 64\,KB of
code, and the writers would then \texttt{memcpy} past the buffer and
crash.  Because \texttt{kcc\_macho\_init} runs \emph{after} code
generation and string-table emission, every unbounded contributor is
already known, so it sizes the buffer to the content: the code size, the
DWARF blob, \texttt{nsyms} entries at a generous 288-byte budget each
(the 16-byte \texttt{nlist\_64} plus a 256-byte name allowance), the
relocations, and a fixed 64\,KB of slack for the header, load commands,
and alignment.  Header, symbol table, and relocations therefore always
fit; the sole residual risk---a symbol name longer than the per-symbol
budget, copied through \texttt{write\_bytes}---is caught by an explicit
capacity guard (\texttt{\_kcc\_macho\_cap}) that turns an oversized object
into a clean diagnostic instead of memory corruption.  The helpers
\texttt{write8}/\texttt{16}/\texttt{32}/\texttt{64} append little-endian
values; \texttt{write\_bytes} copies raw data (and holds the guard);
\texttt{pad\_to} inserts zero bytes until the write position is aligned to
the given power of two.

@d MachO: output buffer @{
// -- kcc_macho_init -----------------------------------------------------------
// void kcc_macho_init(const char *filename)
//   x0 = output file path
// Opens the file for writing and allocates the output buffer.
.text
.globl _kcc_macho_init
.p2align 2
_kcc_macho_init:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    mov x19, x0                    // save filename

    // Open file: O_WRONLY|O_CREAT|O_TRUNC = 0x601
    mov x0, x19
    mov x1, #0x601
    mov x2, #0644
    movk x2, #0, lsl #16          // mode 0644 octal = 420 decimal
    mov x2, #420
    bl _kcc_sys_open
    // Check for error
    cmp x0, #0
    b.lt .Lmi_err

    adrp x1, _kcc_macho_fd@@PAGE
    add  x1, x1, _kcc_macho_fd@@PAGEOFF
    str x0, [x1]

    // Size the buffer to the content (see prose): code + dwarf
    // + nsyms*288 + nrelocs*8 + 64 KiB slack.
    bl   _kcc_dwarf_total_len       // x0 = DWARF bytes (0 unless -g); clobbers x0-x1
    mov  x19, x0                    // reuse x19 (filename no longer needed)
    adrp x0, _kcc_code_pos@@PAGE
    add  x0, x0, _kcc_code_pos@@PAGEOFF
    ldr  x0, [x0]                   // code size
    add  x19, x19, x0              // x19 = code + dwarf
    adrp x1, _kcc_linker_syms@@PAGE
    add  x1, x1, _kcc_linker_syms@@PAGEOFF
    ldr  x1, [x1]
    ldr  x1, [x1, #VEC_COUNT]       // nsyms
    mov  x2, #288
    madd x19, x1, x2, x19           // + nsyms*288
    adrp x1, _kcc_linker_relocs@@PAGE
    add  x1, x1, _kcc_linker_relocs@@PAGEOFF
    ldr  x1, [x1]
    ldr  x1, [x1, #VEC_COUNT]       // nrelocs
    add  x19, x19, x1, lsl #3       // + nrelocs*8
    add  x19, x19, #MACHO_BUF_SIZE  // + 64 KiB fixed slack (floors tiny objects)
    mov  x0, x19
    bl _kcc_arena_alloc
    adrp x2, _kcc_macho_buf@@PAGE
    add  x2, x2, _kcc_macho_buf@@PAGEOFF
    str x0, [x2]
    adrp x2, _kcc_macho_cap@@PAGE
    add  x2, x2, _kcc_macho_cap@@PAGEOFF
    str x19, [x2]                   // record capacity for the overflow guard

    // Reset position
    adrp x1, _kcc_macho_pos@@PAGE
    add  x1, x1, _kcc_macho_pos@@PAGEOFF
    str xzr, [x1]

    b .Lmi_done

.Lmi_err:
    adrp x0, _kcc_macho_err_open@@PAGE
    add  x0, x0, _kcc_macho_err_open@@PAGEOFF
    bl _kcc_io_err
    mov x0, #1
    bl _kcc_sys_exit

.Lmi_done:
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_macho_init
@}

\paragraph{Primitive Integer Writers}

The next four functions---\texttt{\_kcc\_macho\_write8},
\texttt{\_kcc\_macho\_write16}, \texttt{\_kcc\_macho\_write32}, and
\texttt{\_kcc\_macho\_write64}---each store a single little-endian
value at the current buffer position and advance the position counter
by the appropriate number of bytes.  They share an identical pattern:
load the buffer base from \texttt{\_kcc\_macho\_buf}, load the
current offset from \texttt{\_kcc\_macho\_pos}, perform a sized store
(\texttt{strb}/\texttt{strh}/\texttt{str~w}/\texttt{str~x}), and
bump the offset.  Because they never call another function, they are
leaf routines with no stack frame.

@d MachO: output buffer @{
// -- kcc_macho_write8 ---------------------------------------------------------
.text
.globl _kcc_macho_write8
.p2align 2
_kcc_macho_write8:
    adrp x1, _kcc_macho_buf@@PAGE
    add  x1, x1, _kcc_macho_buf@@PAGEOFF
    ldr x1, [x1]
    adrp x2, _kcc_macho_pos@@PAGE
    add  x2, x2, _kcc_macho_pos@@PAGEOFF
    ldr x3, [x2]
    strb w0, [x1, x3]
    add x3, x3, #1
    str x3, [x2]
    ret

// -- kcc_macho_write16 --------------------------------------------------------
.text
.globl _kcc_macho_write16
.p2align 2
_kcc_macho_write16:
    adrp x1, _kcc_macho_buf@@PAGE
    add  x1, x1, _kcc_macho_buf@@PAGEOFF
    ldr x1, [x1]
    adrp x2, _kcc_macho_pos@@PAGE
    add  x2, x2, _kcc_macho_pos@@PAGEOFF
    ldr x3, [x2]
    strh w0, [x1, x3]
    add x3, x3, #2
    str x3, [x2]
    ret

// -- kcc_macho_write32 --------------------------------------------------------
.text
.globl _kcc_macho_write32
.p2align 2
_kcc_macho_write32:
    adrp x1, _kcc_macho_buf@@PAGE
    add  x1, x1, _kcc_macho_buf@@PAGEOFF
    ldr x1, [x1]
    adrp x2, _kcc_macho_pos@@PAGE
    add  x2, x2, _kcc_macho_pos@@PAGEOFF
    ldr x3, [x2]
    str w0, [x1, x3]
    add x3, x3, #4
    str x3, [x2]
    ret

// -- kcc_macho_write64 --------------------------------------------------------
.text
.globl _kcc_macho_write64
.p2align 2
_kcc_macho_write64:
    adrp x1, _kcc_macho_buf@@PAGE
    add  x1, x1, _kcc_macho_buf@@PAGEOFF
    ldr x1, [x1]
    adrp x2, _kcc_macho_pos@@PAGE
    add  x2, x2, _kcc_macho_pos@@PAGEOFF
    ldr x3, [x2]
    str x0, [x1, x3]
    add x3, x3, #8
    str x3, [x2]
    ret
@| _kcc_macho_write8
@| _kcc_macho_write16
@| _kcc_macho_write32
@| _kcc_macho_write64
@}

\paragraph{Bulk Data Copy and Alignment Padding}

Two more routines complete the buffer API.
\texttt{\_kcc\_macho\_write\_bytes} copies an arbitrary byte range
into the output buffer using \texttt{\_kcc\_memcpy} and advances the
position by the source length; it is used to emit raw code bytes and
symbol-name strings.  \texttt{\_kcc\_macho\_pad\_to} inserts zero
bytes until the write position reaches the next multiple of a given
alignment---needed because Mach-O relocations must be 4-byte aligned
and the code section size is not guaranteed to be a multiple of~4.

@d MachO: output buffer @{
// -- kcc_macho_write_bytes ----------------------------------------------------
// void kcc_macho_write_bytes(const void *src, uint64_t len)
.text
.globl _kcc_macho_write_bytes
.p2align 2
_kcc_macho_write_bytes:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    mov x19, x1                    // len

    adrp x2, _kcc_macho_buf@@PAGE
    add  x2, x2, _kcc_macho_buf@@PAGEOFF
    ldr x2, [x2]
    adrp x3, _kcc_macho_pos@@PAGE
    add  x3, x3, _kcc_macho_pos@@PAGEOFF
    ldr x4, [x3]

    // Overflow guard (see prose): pos + len must fit within capacity.
    adrp x5, _kcc_macho_cap@@PAGE
    add  x5, x5, _kcc_macho_cap@@PAGEOFF
    ldr x5, [x5]
    add x6, x4, x19
    cmp x6, x5
    b.hi .Lmacho_overflow

    // memcpy(buf+pos, src, len)
    add x5, x2, x4                // dest = buf + pos
    // x0 = src, x19 = len
    mov x2, x19
    mov x1, x0
    mov x0, x5
    bl _kcc_memcpy

    // Update pos
    adrp x3, _kcc_macho_pos@@PAGE
    add  x3, x3, _kcc_macho_pos@@PAGEOFF
    ldr x4, [x3]
    add x4, x4, x19
    str x4, [x3]

    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// Shared overflow bailout: the object file did not fit the sized buffer.
// Reached only from the write_bytes guard; prints a diagnostic and exits so a
// pathological input (e.g. an identifier longer than the per-symbol budget)
// fails cleanly rather than corrupting memory.
.Lmacho_overflow:
    adrp x0, _kcc_macho_err_overflow@@PAGE
    add  x0, x0, _kcc_macho_err_overflow@@PAGEOFF
    bl _kcc_io_err
    mov x0, #1
    bl _kcc_sys_exit

// -- kcc_macho_pad_to ---------------------------------------------------------
// void kcc_macho_pad_to(uint64_t alignment)
// Pads with zeros until position is aligned to given boundary.
.text
.globl _kcc_macho_pad_to
.p2align 2
_kcc_macho_pad_to:
    stp x29, x30, [sp, #-16]!
    mov x29, sp

    adrp x1, _kcc_macho_pos@@PAGE
    add  x1, x1, _kcc_macho_pos@@PAGEOFF
    ldr x2, [x1]

    // Compute padding needed
    sub x3, x0, #1                // alignment - 1
    add x4, x2, x3
    bic x4, x4, x3                // aligned pos
    sub x5, x4, x2                // bytes to pad
    cbz x5, .Lmpt_done

    // Write zeros
    adrp x1, _kcc_macho_buf@@PAGE
    add  x1, x1, _kcc_macho_buf@@PAGEOFF
    ldr x1, [x1]
    add x1, x1, x2                // buf + current_pos

.Lmpt_loop:
    cbz x5, .Lmpt_update
    strb wzr, [x1], #1
    sub x5, x5, #1
    b .Lmpt_loop

.Lmpt_update:
    adrp x1, _kcc_macho_pos@@PAGE
    add  x1, x1, _kcc_macho_pos@@PAGEOFF
    str x4, [x1]

.Lmpt_done:
    ldp x29, x30, [sp], #16
    ret
@| _kcc_macho_write_bytes
@| _kcc_macho_pad_to
@}

\section{Finalize and Write}

The finalize function is the heart of the Mach-O writer.  It
computes the file layout, writes every structure in order, and
flushes the result to disk.

The file layout for our object files is:
\begin{verbatim}
  +0    : mach_header_64         (32 bytes)
  +32   : LC_SEGMENT_64          (72 + 80*nsects)
          LC_BUILD_VERSION       (24 bytes)
          LC_SYMTAB              (24 bytes)
          LC_DYSYMTAB            (80 bytes)
  +hdrsz: __text section data    (code_size bytes)
          padding to 4-byte align
          relocation entries      (8 bytes each)
          nlist_64 symbol table  (16 bytes each)
          string table           (variable)
\end{verbatim}

We emit two sections: \texttt{\_\_TEXT,\_\_text} (executable code
plus trailing string data) and \texttt{\_\_DATA,\_\_common}
(a \texttt{S\_ZEROFILL} section for global variables, which
occupies no file space).

\subsection{Layout Computation}

The first phase reads the linker tables to determine symbol counts,
string table size, and the byte offsets of every structure in the file.
These offsets are stored in callee-saved registers and stack slots
for use by subsequent phases.

@d MachO: finalize @{
// -- kcc_macho_finalize -------------------------------------------------------
// void kcc_macho_finalize(void)
// Assembles and writes the complete Mach-O object file.
.text
.globl _kcc_macho_finalize
.p2align 2
_kcc_macho_finalize:
    stp x29, x30, [sp, #-128]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    stp x25, x26, [sp, #64]
    stp x27, x28, [sp, #80]

    // ---- Compute layout sizes ----
    // Get code size
    adrp x0, _kcc_code_pos@@PAGE
    add  x0, x0, _kcc_code_pos@@PAGEOFF
    ldr x19, [x0]                  // x19 = code_size

    // Get symbol count
    adrp x0, _kcc_linker_syms@@PAGE
    add  x0, x0, _kcc_linker_syms@@PAGEOFF
    ldr x0, [x0]
    ldr x20, [x0, #VEC_COUNT]     // x20 = nsyms

    // Get reloc count
    adrp x0, _kcc_linker_relocs@@PAGE
    add  x0, x0, _kcc_linker_relocs@@PAGEOFF
    ldr x0, [x0]
    ldr x21, [x0, #VEC_COUNT]     // x21 = nrelocs

    // Get globals size
    adrp x0, _kcc_globals_size@@PAGE
    add  x0, x0, _kcc_globals_size@@PAGEOFF
    ldr x0, [x0]
    str x0, [sp, #112]            // sp+112 = globals_size

    // Compute load commands size:
    // LC_SEGMENT_64 (72 + 80*2 = 232) + LC_BUILD_VERSION (24) + LC_SYMTAB (24) + LC_DYSYMTAB (80) = 360
    // Base layout: 2 sections (__text + __DATA,__common zerofill).
    mov x22, #(232 + 24 + 24 + 80)  // = 360
    // A module-init unit adds a third section (__DATA,__mod_init_func), i.e.
    // one more 80-byte section_64 inside the same segment (no extra command).
    adrp x0, _kcc_modinit_present@@PAGE
    add  x0, x0, _kcc_modinit_present@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lmf_no_modinit_lc
    add  x22, x22, #80
.Lmf_no_modinit_lc:
    // A const-pointer table adds a __DATA_CONST,__const section (one more
    // 80-byte section_64 inside the same segment).
    adrp x0, _kcc_rodata_const_present@@PAGE
    add  x0, x0, _kcc_rodata_const_present@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lmf_no_const_lc
    add  x22, x22, #80
.Lmf_no_const_lc:
    // Under -g, reserve a __DWARF LC_SEGMENT_64 (72 + 80*3 sections = 312).
    // Adding it to x22 here auto-shifts every downstream file offset.
    adrp x0, _kcc_dwarf_enabled@@PAGE
    add  x0, x0, _kcc_dwarf_enabled@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lmf_no_dwarf_seg
    add  x22, x22, #(72 + 80*3)
.Lmf_no_dwarf_seg:

    // Section data offset = header + load cmds
    add x23, x22, #MACH_HEADER_SIZE  // x23 = text_offset (header + LCs)

    // Relocation offset = text_offset + code_size (aligned to 4).  Under -g
    // the DWARF blob is laid down right after the code, so its span is
    // reserved here — this keeps LINKEDIT (relocs/symtab/strtab) last, as ld
    // requires, and auto-shifts every downstream file offset past the blob.
    add x24, x23, x19
    adrp x0, _kcc_dwarf_enabled@@PAGE
    add  x0, x0, _kcc_dwarf_enabled@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lmf_no_dw_reserve
    bl   _kcc_dwarf_total_len
    add  x24, x24, x0
.Lmf_no_dw_reserve:
    // Reserve the 8-byte __mod_init_func pointer (8-aligned) between the code
    // (and any DWARF blob) and the LINKEDIT tables, and remember its offset.
    adrp x0, _kcc_modinit_present@@PAGE
    add  x0, x0, _kcc_modinit_present@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lmf_no_modinit_off
    add x24, x24, #7
    bic x24, x24, #7             // 8-align → pointer file offset
    adrp x0, _kcc_modinit_fileoff@@PAGE
    add  x0, x0, _kcc_modinit_fileoff@@PAGEOFF
    str x24, [x0]
    add x24, x24, #8             // reserve the pointer's 8 bytes
.Lmf_no_modinit_off:
    // Reserve the __const section's data (const_size bytes, 8-aligned) after the
    // modinit pointer; remember its file offset.
    adrp x0, _kcc_rodata_const_present@@PAGE
    add  x0, x0, _kcc_rodata_const_present@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lmf_no_const_off
    add x24, x24, #7
    bic x24, x24, #7
    adrp x0, _kcc_rodata_const_fileoff@@PAGE
    add  x0, x0, _kcc_rodata_const_fileoff@@PAGEOFF
    str x24, [x0]
    adrp x0, _kcc_rodata_const_size@@PAGE
    add  x0, x0, _kcc_rodata_const_size@@PAGEOFF
    ldr x0, [x0]
    add x24, x24, x0             // reserve the const data
.Lmf_no_const_off:
    add x24, x24, #3
    bic x24, x24, #3              // x24 = reloc_offset (4-byte aligned)

    // Symbol table offset = reloc_offset + nrelocs * 8
    mov x25, #RELOC_INFO_SIZE
    mul x25, x21, x25
    add x25, x24, x25             // x25 = symtab_offset
    // A module-init unit appends one extra relocation (the pointer's UNSIGNED).
    adrp x0, _kcc_modinit_present@@PAGE
    add  x0, x0, _kcc_modinit_present@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lmf_no_modinit_reloc_sz
    add x25, x25, #RELOC_INFO_SIZE
.Lmf_no_modinit_reloc_sz:
    // The __const section appends one UNSIGNED reloc per non-NULL slot.
    adrp x0, _kcc_rodata_const_present@@PAGE
    add  x0, x0, _kcc_rodata_const_present@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lmf_no_const_reloc_sz
    adrp x0, _kcc_rodata_const_relocs@@PAGE
    add  x0, x0, _kcc_rodata_const_relocs@@PAGEOFF
    ldr x0, [x0]
    ldr x0, [x0, #VEC_COUNT]     // number of const relocs
    mov x1, #RELOC_INFO_SIZE
    mul x0, x0, x1
    add x25, x25, x0
.Lmf_no_const_reloc_sz:

    // String table offset = symtab_offset + nsyms * 16
    mov x26, #NLIST_64_SIZE
    mul x26, x20, x26
    add x26, x25, x26             // x26 = strtab_offset

    // Compute string table size (sum of all symbol name lengths + 1 for each + 1 for leading NUL)
    // We'll need to build the strtab as we write symbols
    // For now, compute it
    mov x27, #1                    // start at 1 (leading NUL byte)
    mov x28, #0                    // symbol index
.Lmf_strtab_size:
    cmp x28, x20
    b.ge .Lmf_strtab_done
    // Get symbol entry
    adrp x0, _kcc_linker_syms@@PAGE
    add  x0, x0, _kcc_linker_syms@@PAGEOFF
    ldr x0, [x0]
    mov x1, x28
    bl _kcc_vec_get
    ldr x0, [x0, #SYM_NAME]       // name ptr
    bl _kcc_strlen
    add x27, x27, x0
    add x27, x27, #1              // +1 for null terminator
    add x28, x28, #1
    b .Lmf_strtab_size
.Lmf_strtab_done:
    // x27 = strtab_size
@| _kcc_macho_finalize
@}

\paragraph{Symbol Classification for \texttt{LC\_DYSYMTAB}}

The dynamic symbol table command requires the counts of defined
external and undefined external symbols.  Mach-O mandates that
defined symbols precede undefined ones in the symbol table, so we
walk the linker's symbol vector and count how many have a non-zero
\texttt{SYM\_SECTION} (defined) versus zero (undefined).  The
defined count is stored in \texttt{x28}; the undefined count is
derived later by subtraction from the total \texttt{x20}.

@d MachO: finalize @{
    // Count defined vs undefined symbols for dysymtab
    mov x28, #0                    // index
    str xzr, [sp, #96]            // nlocal = 0
    str xzr, [sp, #104]           // nextdef = 0 (we count defined externals)
.Lmf_count_syms:
    cmp x28, x20
    b.ge .Lmf_count_done
    adrp x0, _kcc_linker_syms@@PAGE
    add  x0, x0, _kcc_linker_syms@@PAGEOFF
    ldr x0, [x0]
    mov x1, x28
    bl _kcc_vec_get
    ldr x1, [x0, #SYM_FLAGS]
    // If section != 0, it's defined
    ldr x2, [x0, #SYM_SECTION]
    cbz x2, .Lmf_sym_undef
    // Defined external
    ldr x3, [sp, #104]
    add x3, x3, #1
    str x3, [sp, #104]
    b .Lmf_sym_next
.Lmf_sym_undef:
    // Undefined — counted by subtraction later
.Lmf_sym_next:
    add x28, x28, #1
    b .Lmf_count_syms
.Lmf_count_done:
    ldr x28, [sp, #104]           // nextdef (defined external count)
@}

\subsection{Header and Load Commands}

With all offsets computed, we write the Mach-O header (magic,
CPU type, file type, load command count and size) followed by the
four load commands: \texttt{LC\_SEGMENT\_64} (containing the
\texttt{\_\_text} and \texttt{\_\_common} section headers),
\texttt{LC\_BUILD\_VERSION} (suppresses Apple linker warnings),
\texttt{LC\_SYMTAB}, and \texttt{LC\_DYSYMTAB}.

Section names (\texttt{\_\_text}, \texttt{\_\_TEXT}, etc.) are
written as inline immediate bytes rather than referencing string
constants---this avoids the linker dead-stripping trailing null
bytes from local atoms, which caused subtle bugs in earlier
versions.

@d MachO: finalize @{
    // ---- Write Mach-O header ----
    // magic
    mov w0, #0xFACF
    movk w0, #0xFEED, lsl #16
    bl _kcc_macho_write32
    // cputype
    mov w0, #0x000C
    movk w0, #0x0100, lsl #16
    bl _kcc_macho_write32
    // cpusubtype
    mov w0, #0
    bl _kcc_macho_write32
    // filetype = MH_OBJECT
    mov w0, #MH_OBJECT
    bl _kcc_macho_write32
    // ncmds = 4 (segment + build_version + symtab + dysymtab), +1 __DWARF under -g
    mov w0, #4
    adrp x1, _kcc_dwarf_enabled@@PAGE
    add  x1, x1, _kcc_dwarf_enabled@@PAGEOFF
    ldr  x1, [x1]
    cbz  x1, .Lmf_ncmds_done
    add  w0, w0, #1
.Lmf_ncmds_done:
    bl _kcc_macho_write32
    // sizeofcmds
    mov w0, w22
    bl _kcc_macho_write32
    // flags = MH_SUBSECTIONS_VIA_SYMBOLS
    mov w0, #MH_SUBSECTIONS_VIA_SYMBOLS
    bl _kcc_macho_write32
    // reserved (64-bit padding)
    mov w0, #0
    bl _kcc_macho_write32

    // ---- LC_SEGMENT_64 ----
    // cmd
    mov w0, #LC_SEGMENT_64
    bl _kcc_macho_write32
    // cmdsize = 72 + 80*nsects.  Base 232 (2 sections); +80 for
    // __mod_init_func, +80 for __DATA_CONST,__const.
    mov w0, #232
    adrp x1, _kcc_modinit_present@@PAGE
    add  x1, x1, _kcc_modinit_present@@PAGEOFF
    ldr  x1, [x1]
    cbz  x1, .Lmf_cmdsz_nomod
    add  w0, w0, #80
.Lmf_cmdsz_nomod:
    adrp x1, _kcc_rodata_const_present@@PAGE
    add  x1, x1, _kcc_rodata_const_present@@PAGEOFF
    ldr  x1, [x1]
    cbz  x1, .Lmf_seg_cmdsize
    add  w0, w0, #80
.Lmf_seg_cmdsize:
    bl _kcc_macho_write32
    // segname (16 bytes, empty for object files)
    mov x0, #0
    bl _kcc_macho_write64
    mov x0, #0
    bl _kcc_macho_write64
    // vmaddr
    mov x0, #0
    bl _kcc_macho_write64
    // vmsize = code_size + globals_size (+ the aligned 8-byte modinit pointer)
    ldr x0, [sp, #112]            // globals_size
    add x0, x0, x19               // + code_size
    adrp x1, _kcc_modinit_present@@PAGE
    add  x1, x1, _kcc_modinit_present@@PAGEOFF
    ldr  x1, [x1]
    cbz  x1, .Lmf_seg_vmsize
    add x0, x0, #7
    bic x0, x0, #7               // 8-align the pointer's VM address
    add x0, x0, #8               // + 8 bytes for the pointer
.Lmf_seg_vmsize:
    adrp x1, _kcc_rodata_const_present@@PAGE
    add  x1, x1, _kcc_rodata_const_present@@PAGEOFF
    ldr  x1, [x1]
    cbz  x1, .Lmf_seg_vmsize_done
    add x0, x0, #7
    bic x0, x0, #7               // 8-align the __const section's VM address
    adrp x1, _kcc_rodata_const_size@@PAGE
    add  x1, x1, _kcc_rodata_const_size@@PAGEOFF
    ldr x1, [x1]
    add x0, x0, x1               // + const data
.Lmf_seg_vmsize_done:
    bl _kcc_macho_write64
    // fileoff = text_offset
    mov x0, x23
    bl _kcc_macho_write64
    // filesize = code_size (zerofill doesn't occupy file space); when a
    // __mod_init_func pointer follows the code, extend to cover its 8 bytes.
    mov x0, x19
    adrp x1, _kcc_modinit_present@@PAGE
    add  x1, x1, _kcc_modinit_present@@PAGEOFF
    ldr  x1, [x1]
    cbz  x1, .Lmf_seg_filesize
    adrp x0, _kcc_modinit_fileoff@@PAGE
    add  x0, x0, _kcc_modinit_fileoff@@PAGEOFF
    ldr x0, [x0]
    add x0, x0, #8               // end of the pointer
    sub x0, x0, x23              // relative to the segment's fileoff
.Lmf_seg_filesize:
    adrp x1, _kcc_rodata_const_present@@PAGE
    add  x1, x1, _kcc_rodata_const_present@@PAGEOFF
    ldr  x1, [x1]
    cbz  x1, .Lmf_seg_filesize_done
    adrp x1, _kcc_rodata_const_fileoff@@PAGE
    add  x1, x1, _kcc_rodata_const_fileoff@@PAGEOFF
    ldr x1, [x1]
    adrp x2, _kcc_rodata_const_size@@PAGE
    add  x2, x2, _kcc_rodata_const_size@@PAGEOFF
    ldr x2, [x2]
    add x1, x1, x2               // end of the const data (furthest file byte)
    sub x0, x1, x23              // relative to the segment's fileoff
.Lmf_seg_filesize_done:
    bl _kcc_macho_write64
    // maxprot = 7 (rwx)
    mov w0, #7
    bl _kcc_macho_write32
    // initprot = 7
    mov w0, #7
    bl _kcc_macho_write32
    // nsects = 2 + (__mod_init_func) + (__DATA_CONST,__const)
    mov w0, #2
    adrp x1, _kcc_modinit_present@@PAGE
    add  x1, x1, _kcc_modinit_present@@PAGEOFF
    ldr  x1, [x1]
    cbz  x1, .Lmf_nsects_nomod
    add  w0, w0, #1
.Lmf_nsects_nomod:
    adrp x1, _kcc_rodata_const_present@@PAGE
    add  x1, x1, _kcc_rodata_const_present@@PAGEOFF
    ldr  x1, [x1]
    cbz  x1, .Lmf_seg_nsects
    add  w0, w0, #1
.Lmf_seg_nsects:
    bl _kcc_macho_write32
    // flags = 0
    mov w0, #0
    bl _kcc_macho_write32
@}

\paragraph{Section Headers}

Each section within the segment gets an 80-byte
\texttt{section\_64} descriptor.  The \texttt{\_\_TEXT,\_\_text}
section carries the executable machine code: its \texttt{offset}
points to the raw bytes in the file, its \texttt{reloff}/\texttt{nreloc}
reference the relocation entries, and its flags mark it as containing
pure instructions.  The \texttt{\_\_DATA,\_\_common} section is a
\texttt{S\_ZEROFILL} region for uninitialized global variables; it
occupies virtual address space immediately after the text section but
requires no file storage---the \texttt{offset} and \texttt{reloff}
fields are both zero.  Section and segment names are written as
inline immediate constants to avoid linker dead-stripping issues.

\label{sec:macho-modinit}
A module-init unit (\S\ref{sec:global-inits}) contributes a third
section, \texttt{\_\_DATA,\_\_mod\_init\_func}, whose 8-byte body is a
single pointer to the local \texttt{kcc.module\_init} function.  Its
\texttt{S\_MOD\_INIT\_FUNC\_POINTERS} flag tells \texttt{dyld} to call
every pointer in the section before \texttt{main}.  Unlike
\texttt{\_\_common} it carries real file data, so it has a non-zero
\texttt{offset}; the pointer's value is supplied by a single
\texttt{ARM64\_RELOC\_UNSIGNED} relocation against the function symbol,
so the eight bytes on disk are zero.  This whole section header is
emitted only when \texttt{\_kcc\_modinit\_present} is set, leaving the
common two-section object byte-for-byte unchanged.

@d MachO: finalize @{
    // ---- Section: __text ----
    // sectname (16 bytes): "__text" + 10 null bytes
    // Little-endian: "__text\0\0" = 0x0000747865745F5F
    mov x0, #0x5F5F
    movk x0, #0x6574, lsl #16
    movk x0, #0x7478, lsl #32
    bl _kcc_macho_write64
    mov x0, #0
    bl _kcc_macho_write64
    // segname (16 bytes): "__TEXT" + 10 null bytes
    // Little-endian: "__TEXT\0\0" = 0x0000545845545F5F
    mov x0, #0x5F5F
    movk x0, #0x4554, lsl #16
    movk x0, #0x5458, lsl #32
    bl _kcc_macho_write64
    mov x0, #0
    bl _kcc_macho_write64
    // addr = 0
    mov x0, #0
    bl _kcc_macho_write64
    // size = code_size
    mov x0, x19
    bl _kcc_macho_write64
    // offset = text_offset
    mov w0, w23
    bl _kcc_macho_write32
    // align = 2 (4-byte aligned, log2(4)=2)
    mov w0, #2
    bl _kcc_macho_write32
    // reloff
    mov w0, w24
    bl _kcc_macho_write32
    // nreloc
    mov w0, w21
    bl _kcc_macho_write32
    // flags = S_REGULAR | S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS
    mov w0, #S_ATTR_SOME_INSTRUCTIONS
    movk w0, #0x8000, lsl #16     // S_ATTR_PURE_INSTRUCTIONS
    bl _kcc_macho_write32
    // reserved1, reserved2, reserved3 (padding to 80 bytes)
    mov w0, #0
    bl _kcc_macho_write32
    mov w0, #0
    bl _kcc_macho_write32
    mov w0, #0
    bl _kcc_macho_write32

    // ---- Section: __DATA,__common (S_ZEROFILL) ----
    // sectname (16 bytes): "__common" + 8 null bytes
    // Little-endian: "__common" = 0x6E6F6D6D6F635F5F
    mov x0, #0x5F5F
    movk x0, #0x6F63, lsl #16
    movk x0, #0x6D6D, lsl #32
    movk x0, #0x6E6F, lsl #48
    bl _kcc_macho_write64
    mov x0, #0
    bl _kcc_macho_write64
    // segname (16 bytes): "__DATA" + 10 null bytes
    // Little-endian halfwords: "__"=5F5F "DA"=4144 "TA"=4154
    mov x0, #0x5F5F
    movk x0, #0x4144, lsl #16
    movk x0, #0x4154, lsl #32
    bl _kcc_macho_write64
    mov x0, #0
    bl _kcc_macho_write64
    // addr = code_size (follows text in virtual memory)
    mov x0, x19
    bl _kcc_macho_write64
    // size = globals_size
    ldr x0, [sp, #112]
    bl _kcc_macho_write64
    // offset = 0 (S_ZEROFILL: no file data)
    mov w0, #0
    bl _kcc_macho_write32
    // align = 3 (8-byte aligned, log2(8)=3)
    mov w0, #3
    bl _kcc_macho_write32
    // reloff = 0
    mov w0, #0
    bl _kcc_macho_write32
    // nreloc = 0
    mov w0, #0
    bl _kcc_macho_write32
    // flags = S_ZEROFILL (type 1)
    mov w0, #1
    bl _kcc_macho_write32
    // reserved1, reserved2, reserved3
    mov w0, #0
    bl _kcc_macho_write32
    mov w0, #0
    bl _kcc_macho_write32
    mov w0, #0
    bl _kcc_macho_write32

    // ---- Section: __DATA_CONST,__const (const pointer tables, section 3) ----
    adrp x0, _kcc_rodata_const_present@@PAGE
    add  x0, x0, _kcc_rodata_const_present@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lmf_no_const_sect
    // sectname "__const\0..."
    mov x0, #0x5F5F
    movk x0, #0x6F63, lsl #16
    movk x0, #0x736E, lsl #32
    movk x0, #0x0074, lsl #48
    bl _kcc_macho_write64
    mov x0, #0
    bl _kcc_macho_write64
    // segname "__DATA_CONST"
    mov x0, #0x5F5F
    movk x0, #0x4144, lsl #16
    movk x0, #0x4154, lsl #32
    movk x0, #0x435F, lsl #48
    bl _kcc_macho_write64
    mov x0, #0x4E4F
    movk x0, #0x5453, lsl #16
    bl _kcc_macho_write64
    // addr = VM address after __common (and past the modinit pointer if any)
    ldr x0, [sp, #112]           // globals_size
    add x0, x0, x19              // + code_size
    adrp x1, _kcc_modinit_present@@PAGE
    add  x1, x1, _kcc_modinit_present@@PAGEOFF
    ldr  x1, [x1]
    cbz  x1, .Lmf_const_addr
    add x0, x0, #7
    bic x0, x0, #7
    add x0, x0, #8              // past the modinit pointer's VM region
.Lmf_const_addr:
    add x0, x0, #7
    bic x0, x0, #7             // 8-align the const section's VM address
    bl _kcc_macho_write64
    // size = const_size
    adrp x0, _kcc_rodata_const_size@@PAGE
    add  x0, x0, _kcc_rodata_const_size@@PAGEOFF
    ldr x0, [x0]
    bl _kcc_macho_write64
    // offset = const file offset
    adrp x0, _kcc_rodata_const_fileoff@@PAGE
    add  x0, x0, _kcc_rodata_const_fileoff@@PAGEOFF
    ldr w0, [x0]
    bl _kcc_macho_write32
    // align = 3 (8-byte aligned)
    mov w0, #3
    bl _kcc_macho_write32
    // reloff = reloc_offset + (nrelocs + modinit?1:0) * 8  (const relocs trail
    // the text relocs and the modinit reloc)
    mov x0, #RELOC_INFO_SIZE
    mul x0, x21, x0
    add x0, x24, x0
    adrp x1, _kcc_modinit_present@@PAGE
    add  x1, x1, _kcc_modinit_present@@PAGEOFF
    ldr  x1, [x1]
    cbz  x1, .Lmf_const_reloff
    add x0, x0, #RELOC_INFO_SIZE
.Lmf_const_reloff:
    bl _kcc_macho_write32
    // nreloc = const reloc count
    adrp x0, _kcc_rodata_const_relocs@@PAGE
    add  x0, x0, _kcc_rodata_const_relocs@@PAGEOFF
    ldr x0, [x0]
    ldr w0, [x0, #VEC_COUNT]
    bl _kcc_macho_write32
    // flags = S_REGULAR
    mov w0, #S_REGULAR
    bl _kcc_macho_write32
    mov w0, #0
    bl _kcc_macho_write32
    mov w0, #0
    bl _kcc_macho_write32
    mov w0, #0
    bl _kcc_macho_write32
.Lmf_no_const_sect:

    // ---- Section: __DATA,__mod_init_func (only for a module-init unit) ----
    adrp x0, _kcc_modinit_present@@PAGE
    add  x0, x0, _kcc_modinit_present@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lmf_no_modinit_sect
    // sectname (16 bytes): "__mod_init_func" (15 chars) + 1 NUL, fills all 16
    mov x0, #0x5F5F
    movk x0, #0x6F6D, lsl #16
    movk x0, #0x5F64, lsl #32
    movk x0, #0x6E69, lsl #48     // "__mod_in"
    bl _kcc_macho_write64
    mov x0, #0x7469
    movk x0, #0x665F, lsl #16
    movk x0, #0x6E75, lsl #32
    movk x0, #0x0063, lsl #48     // "it_func\0"
    bl _kcc_macho_write64
    // segname (16 bytes): "__DATA" + 10 null bytes
    mov x0, #0x5F5F
    movk x0, #0x4144, lsl #16
    movk x0, #0x4154, lsl #32
    bl _kcc_macho_write64
    mov x0, #0
    bl _kcc_macho_write64
    // addr = 8-aligned VM address after __common
    ldr x0, [sp, #112]           // globals_size
    add x0, x0, x19              // + code_size
    add x0, x0, #7
    bic x0, x0, #7
    bl _kcc_macho_write64
    // size = 8 (one pointer)
    mov x0, #8
    bl _kcc_macho_write64
    // offset = file offset of the pointer
    adrp x0, _kcc_modinit_fileoff@@PAGE
    add  x0, x0, _kcc_modinit_fileoff@@PAGEOFF
    ldr w0, [x0]
    bl _kcc_macho_write32
    // align = 3 (8-byte aligned)
    mov w0, #3
    bl _kcc_macho_write32
    // reloff = reloc_offset + nrelocs*8 (the modinit reloc trails the text relocs)
    mov x0, #RELOC_INFO_SIZE
    mul x0, x21, x0
    add x0, x24, x0
    bl _kcc_macho_write32
    // nreloc = 1
    mov w0, #1
    bl _kcc_macho_write32
    // flags = S_MOD_INIT_FUNC_POINTERS
    mov w0, #S_MOD_INIT_FUNC_POINTERS
    bl _kcc_macho_write32
    // reserved1, reserved2, reserved3
    mov w0, #0
    bl _kcc_macho_write32
    mov w0, #0
    bl _kcc_macho_write32
    mov w0, #0
    bl _kcc_macho_write32
.Lmf_no_modinit_sect:
@}

\paragraph{Auxiliary Load Commands}

Three more load commands follow the segment.
\texttt{LC\_BUILD\_VERSION} records the target platform (macOS) and
minimum OS version; without it Apple's linker emits a warning on every
link.  \texttt{LC\_SYMTAB} gives the file offsets and counts of the
symbol table (\texttt{nlist\_64} array at \texttt{x25}) and string
table (at \texttt{x26}, size \texttt{x27}).  \texttt{LC\_DYSYMTAB}
partitions symbols into local, defined-external, and
undefined-external ranges so the dynamic linker can resolve imports
efficiently---most of its 80~bytes are zero because our object file
has no indirect or module tables.

@d MachO: finalize @{
    // ---- LC_BUILD_VERSION ----
    // cmd = 0x32
    mov w0, #LC_BUILD_VERSION
    bl _kcc_macho_write32
    // cmdsize = 24
    mov w0, #24
    bl _kcc_macho_write32
    // platform = 1 (PLATFORM_MACOS)
    mov w0, #1
    bl _kcc_macho_write32
    // minos = 14.0.0 → (14<<16) = 0x000E0000
    mov w0, #0
    movk w0, #14, lsl #16
    bl _kcc_macho_write32
    // sdk = 14.0.0
    mov w0, #0
    movk w0, #14, lsl #16
    bl _kcc_macho_write32
    // ntools = 0
    mov w0, #0
    bl _kcc_macho_write32

    // ---- LC_SYMTAB ----
    // cmd
    mov w0, #LC_SYMTAB
    bl _kcc_macho_write32
    // cmdsize
    mov w0, #SYMTAB_CMD_SIZE
    bl _kcc_macho_write32
    // symoff
    mov w0, w25
    bl _kcc_macho_write32
    // nsyms
    mov w0, w20
    bl _kcc_macho_write32
    // stroff
    mov w0, w26
    bl _kcc_macho_write32
    // strsize
    mov w0, w27
    bl _kcc_macho_write32

    // ---- LC_DYSYMTAB ----
    // cmd
    mov w0, #LC_DYSYMTAB
    bl _kcc_macho_write32
    // cmdsize
    mov w0, #DYSYMTAB_CMD_SIZE
    bl _kcc_macho_write32
    // ilocalsym = 0
    mov w0, #0
    bl _kcc_macho_write32
    // nlocalsym = 0
    mov w0, #0
    bl _kcc_macho_write32
    // iextdefsym = 0
    mov w0, #0
    bl _kcc_macho_write32
    // nextdefsym = number of defined symbols
    mov w0, w28
    bl _kcc_macho_write32
    // iundefsym = nextdef
    mov w0, w28
    bl _kcc_macho_write32
    // nundefsym = total - defined
    sub w0, w20, w28
    bl _kcc_macho_write32
    // Rest of dysymtab fields are 0 (tocoff, ntoc, etc — 12 more uint32_t)
    mov w0, #0
    bl _kcc_macho_write32
    mov w0, #0
    bl _kcc_macho_write32
    mov w0, #0
    bl _kcc_macho_write32
    mov w0, #0
    bl _kcc_macho_write32
    mov w0, #0
    bl _kcc_macho_write32
    mov w0, #0
    bl _kcc_macho_write32
    mov w0, #0
    bl _kcc_macho_write32
    mov w0, #0
    bl _kcc_macho_write32
    mov w0, #0
    bl _kcc_macho_write32
    mov w0, #0
    bl _kcc_macho_write32
    mov w0, #0
    bl _kcc_macho_write32
    mov w0, #0
    bl _kcc_macho_write32
@}

\subsection{Code, Relocations, and Symbol Remapping}

After the load commands, we write the raw code bytes (the
\texttt{\_\_text} section content), pad to 4-byte alignment, and
then emit the relocation entries.

Before writing relocations, we must build a \emph{remap array}
that translates original symbol indices to their output positions.
The Mach-O convention requires defined symbols to appear before
undefined ones in the symbol table; since our linker adds symbols
in encounter order (which interleaves defined and undefined), we
sort them in two passes: first defined, then undefined.  Each
relocation's \texttt{r\_symbolnum} is translated through this
remap so the linker sees the correct index.

Each relocation packs into 8~bytes: a 32-bit \texttt{r\_address}
(section-relative), and a 32-bit info word containing the symbol
number (24~bits), \texttt{pcrel} flag, length code, extern flag,
and relocation type.

@d MachO: finalize @{
    // ---- __DWARF LC_SEGMENT_64 (under -g) ----
    // Still part of the load commands (fills x22's reserved 312 bytes so the
    // file position reaches text_offset).  The debug blob itself is laid down
    // right after the code bytes; its file base = text_offset + code_size.
    adrp x0, _kcc_dwarf_enabled@@PAGE
    add  x0, x0, _kcc_dwarf_enabled@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lmf_dw_seg_done
    add  x0, x23, x19             // dwarf file base = text_offset + code_size
    ldr  x1, [sp, #112]           // globals_size
    add  x1, x1, x19              // vmaddr = code_size + globals (past __TEXT)
    bl _kcc_dwarf_emit_macho
.Lmf_dw_seg_done:

    // ---- Write code bytes ----
    // Pad to text_offset if needed (should already be there)
    adrp x0, _kcc_code_buf@@PAGE
    add  x0, x0, _kcc_code_buf@@PAGEOFF
    ldr x0, [x0]
    mov x1, x19                    // code_size
    bl _kcc_macho_write_bytes

    // ---- Append the DWARF debug blob (under -g) ----
    // It sits between the code and the LINKEDIT region so relocs/symtab/strtab
    // stay last in the file, matching the offsets reserved in the layout above.
    adrp x0, _kcc_dwarf_enabled@@PAGE
    add  x0, x0, _kcc_dwarf_enabled@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lmf_dw_blob_done
    bl   _kcc_dwarf_append_blob
.Lmf_dw_blob_done:

    // ---- Write the __mod_init_func pointer (8 zero bytes; value from reloc) ----
    // Aligning to 8 lands the file position exactly on the reserved slot.
    adrp x0, _kcc_modinit_present@@PAGE
    add  x0, x0, _kcc_modinit_present@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lmf_no_modinit_data
    mov x0, #8
    bl _kcc_macho_pad_to
    mov x0, #0
    bl _kcc_macho_write64
.Lmf_no_modinit_data:

    // ---- Write the __const section data (const_size zero bytes; pointer values
    // come from the relocations) ----
    adrp x0, _kcc_rodata_const_present@@PAGE
    add  x0, x0, _kcc_rodata_const_present@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lmf_no_const_data
    mov x0, #8
    bl _kcc_macho_pad_to           // lands on the reserved 8-aligned const offset
    adrp x0, _kcc_rodata_const_size@@PAGE
    add  x0, x0, _kcc_rodata_const_size@@PAGEOFF
    ldr x28, [x0]                  // remaining bytes (a multiple of 8)
.Lmf_const_data_loop:
    cbz x28, .Lmf_no_const_data
    mov x0, #0
    bl _kcc_macho_write64
    sub x28, x28, #8
    b .Lmf_const_data_loop
.Lmf_no_const_data:

    // Pad to reloc_offset
    mov x0, #4
    bl _kcc_macho_pad_to

    // ---- Build symbol index remapping (original → sorted output) ----
    // Output order: defined first, then undefined. Need remap[old] = new.
    lsl x0, x20, #3               // nsyms * 8 bytes
    bl _kcc_arena_alloc
    str x0, [sp, #120]            // remap array ptr

    // Pass 1: assign output indices to defined symbols
    mov x28, #0                    // original index
    str xzr, [sp, #96]            // output index counter (on stack, survives calls)
.Lmf_remap_def:
    cmp x28, x20
    b.ge .Lmf_remap_undef_start
    adrp x0, _kcc_linker_syms@@PAGE
    add  x0, x0, _kcc_linker_syms@@PAGEOFF
    ldr x0, [x0]
    mov x1, x28
    bl _kcc_vec_get
    ldr x4, [x0, #SYM_SECTION]
    cbz x4, .Lmf_remap_def_skip   // skip undefined
    // Defined: remap[x28] = output_idx
    ldr x5, [sp, #120]
    ldr x3, [sp, #96]             // load output counter
    str x3, [x5, x28, lsl #3]
    add x3, x3, #1
    str x3, [sp, #96]             // store back
.Lmf_remap_def_skip:
    add x28, x28, #1
    b .Lmf_remap_def
.Lmf_remap_undef_start:

    // Pass 2: assign output indices to undefined symbols
    // output counter continues from where pass 1 left off
    mov x28, #0
.Lmf_remap_undef:
    cmp x28, x20
    b.ge .Lmf_remap_done
    adrp x0, _kcc_linker_syms@@PAGE
    add  x0, x0, _kcc_linker_syms@@PAGEOFF
    ldr x0, [x0]
    mov x1, x28
    bl _kcc_vec_get
    ldr x4, [x0, #SYM_SECTION]
    cbnz x4, .Lmf_remap_undef_skip // skip defined
    // Undefined: remap[x28] = output_idx
    ldr x5, [sp, #120]
    ldr x3, [sp, #96]             // load output counter
    str x3, [x5, x28, lsl #3]
    add x3, x3, #1
    str x3, [sp, #96]             // store back
.Lmf_remap_undef_skip:
    add x28, x28, #1
    b .Lmf_remap_undef
.Lmf_remap_done:
@}

\paragraph{Emitting Relocation Entries}

With the remap array in place, we iterate the linker's relocation
vector and write one 8-byte \texttt{relocation\_info} record per
entry.  The first word is the section-relative \texttt{r\_address};
the second packs the (remapped) symbol index into bits~0--23,
followed by the \texttt{r\_pcrel} flag (bit~24), \texttt{r\_length}
(bits~25--26, 2 for the 4-byte instruction fixups in this loop),
\texttt{r\_extern} (bit~27, always~1), and the relocation type
(bits~28--31).  \texttt{ARM64\_RELOC\_BRANCH26} and
\texttt{ARM64\_RELOC\_PAGE21} are PC-relative; \texttt{PAGEOFF12}
is not, so the \texttt{pcrel} bit is cleared for that case.  The
lone exception, emitted just after this loop, is the
\texttt{\_\_mod\_init\_func} pointer's \texttt{ARM64\_RELOC\_UNSIGNED}:
an 8-byte, non-PC-relative fixup (\texttt{r\_length}~=~3) against the
module-init function symbol.

@d MachO: finalize @{
    // ---- Write relocations ----
    // For each reloc: pack into relocation_info format
    // r_address (32 bits) | r_symbolnum(24)|r_pcrel(1)|r_length(2)|r_extern(1)|r_type(4)
    mov x28, #0
.Lmf_reloc_loop:
    cmp x28, x21
    b.ge .Lmf_reloc_done

    adrp x0, _kcc_linker_relocs@@PAGE
    add  x0, x0, _kcc_linker_relocs@@PAGEOFF
    ldr x0, [x0]
    mov x1, x28
    bl _kcc_vec_get
    str x0, [sp, #112]            // save reloc entry ptr

    // r_address = reloc.offset
    ldr w0, [x0, #RELOC_OFFSET]
    bl _kcc_macho_write32

    // r_info: sym_idx(24) | pcrel(1) | length(2) | extern(1) | type(4)
    ldr x2, [sp, #112]            // reload reloc entry ptr
    ldr x3, [x2, #RELOC_SYM]      // original sym_index
    ldr x4, [x2, #RELOC_TYPE]     // reloc type

    // Remap sym_index to sorted output index
    ldr x5, [sp, #120]            // remap array
    ldr x3, [x5, x3, lsl #3]     // x3 = remap[original_index]

    // Pack: (sym_idx & 0xFFFFFF) | (pcrel<<24) | (length<<25) | (extern<<27) | (type<<28)
    // pcrel: BRANCH26/PAGE21/GOT_LOAD_PAGE21=1, PAGEOFF12/GOT_LOAD_PAGEOFF12=0
    and w0, w3, #0xFFFFFF          // r_symbolnum (remapped)
    // Determine pcrel based on type: the two PAGEOFF12 forms are absolute
    cmp w4, #ARM64_RELOC_PAGEOFF12
    b.eq .Lmf_reloc_no_pcrel
    cmp w4, #ARM64_RELOC_GOT_LOAD_PAGEOFF12
    b.eq .Lmf_reloc_no_pcrel
    orr w0, w0, #(1 << 24)        // r_pcrel = 1
.Lmf_reloc_no_pcrel:
    orr w0, w0, #(2 << 25)        // r_length = 2 (4 bytes)
    orr w0, w0, #(1 << 27)        // r_extern = 1
    orr w0, w0, w4, lsl #28       // r_type
    bl _kcc_macho_write32

    add x28, x28, #1
    b .Lmf_reloc_loop
.Lmf_reloc_done:

    // ---- Module-init pointer relocation ----
    // One ARM64_RELOC_UNSIGNED (length 3 = 8 bytes, not pc-relative) binding the
    // __mod_init_func pointer to the local kcc.module_init symbol.  It trails the
    // text relocations, matching the reloff recorded in that section header.
    adrp x0, _kcc_modinit_present@@PAGE
    add  x0, x0, _kcc_modinit_present@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lmf_no_modinit_reloc_emit
    // r_address = 0 (pointer sits at the start of __mod_init_func)
    mov w0, #0
    bl _kcc_macho_write32
    // r_symbolnum = remap[modinit sym index]
    adrp x0, _kcc_modinit_sym@@PAGE
    add  x0, x0, _kcc_modinit_sym@@PAGEOFF
    ldr x0, [x0]
    sub x0, x0, #1               // stored index + 1 → original index
    ldr x5, [sp, #120]           // remap array
    ldr x3, [x5, x0, lsl #3]    // remapped output index
    and w0, w3, #0xFFFFFF          // r_symbolnum
    orr w0, w0, #(3 << 25)        // r_length = 3 (8-byte pointer)
    orr w0, w0, #(1 << 27)        // r_extern = 1
    // r_pcrel = 0, r_type = ARM64_RELOC_UNSIGNED (0)
    bl _kcc_macho_write32
.Lmf_no_modinit_reloc_emit:

    // ---- __const section relocations ----
    // One ARM64_RELOC_UNSIGNED (length 3, not pc-relative) per pointer slot,
    // binding it to its string-literal symbol.  They trail the modinit reloc,
    // matching the reloff recorded in the __const section header.
    adrp x0, _kcc_rodata_const_present@@PAGE
    add  x0, x0, _kcc_rodata_const_present@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lmf_no_const_reloc_emit
    mov x28, #0                    // reloc index
.Lmf_const_reloc_loop:
    adrp x0, _kcc_rodata_const_relocs@@PAGE
    add  x0, x0, _kcc_rodata_const_relocs@@PAGEOFF
    ldr x0, [x0]                  // relocs vec
    ldr x2, [x0, #VEC_COUNT]
    cmp x28, x2
    b.ge .Lmf_no_const_reloc_emit
    mov x1, x28
    bl _kcc_vec_get               // x0 = entry {slot_offset, sym_index}
    str x0, [sp, #96]             // stash entry ptr across write32
    ldr w0, [x0]                  // r_address = slot_offset
    bl _kcc_macho_write32
    ldr x0, [sp, #96]
    ldr x2, [x0, #8]             // original string-lit sym index
    ldr x5, [sp, #120]           // remap array
    ldr x3, [x5, x2, lsl #3]     // remapped output index
    and w0, w3, #0xFFFFFF          // r_symbolnum
    orr w0, w0, #(3 << 25)        // r_length = 3 (8-byte pointer)
    orr w0, w0, #(1 << 27)        // r_extern = 1
    bl _kcc_macho_write32
    add x28, x28, #1
    b .Lmf_const_reloc_loop
.Lmf_no_const_reloc_emit:
@}

\subsection{Symbol Table and String Table}

The symbol table consists of \texttt{nlist\_64} entries (16~bytes
each): a 32-bit string-table index, an 8-bit type, an 8-bit
section number, a 16-bit description, and a 64-bit value.  A defined
symbol's type is \texttt{N\_SECT} (\texttt{0x0E}) with the \texttt{N\_EXT}
bit added only when the symbol carries it---so an external function or
global is \texttt{0x0F} while a translation-unit-private symbol such as a
string literal stays \texttt{0x0E} and is not exported.  The bit is read
from the symbol's own flags rather than assumed, which is what keeps a
local \texttt{l\_.str.\textit{N}} from colliding with the same name in
another object.  A defined symbol's value is the offset within the
section.  Section~2
symbols (global variables in \texttt{\_\_DATA,\_\_common}) have
their value adjusted by adding \texttt{code\_size}---the
\texttt{S\_ZEROFILL} section's virtual start follows the text
section.

The string table starts with a null byte at index~0 (the
``empty string'' sentinel).  Symbol names are written in the same
defined-then-undefined order, and a running offset tracks each
symbol's \texttt{n\_strx} value.

Finally, the entire output buffer is flushed to the file
descriptor with a single \texttt{write} system call, and the
file is closed.

@d MachO: finalize @{
    // ---- Write symbol table (nlist_64 entries) ----
    // First: defined symbols, then undefined
    // We need to write in order: defined first, then undefined
    // Pass 1: defined symbols
    mov x28, #0
    mov x3, #1                     // strtab offset starts at 1 (skip leading NUL)
    str x3, [sp, #96]             // current strtab_pos
.Lmf_sym_def_loop:
    cmp x28, x20
    b.ge .Lmf_sym_def_done

    adrp x0, _kcc_linker_syms@@PAGE
    add  x0, x0, _kcc_linker_syms@@PAGEOFF
    ldr x0, [x0]
    mov x1, x28
    bl _kcc_vec_get
    str x0, [sp, #112]            // save sym entry ptr

    ldr x3, [x0, #SYM_SECTION]
    cbz x3, .Lmf_sym_def_skip     // skip undefined

    // nlist_64: n_strx(4), n_type(1), n_sect(1), n_desc(2), n_value(8)
    // n_strx = current strtab position
    ldr w0, [sp, #96]
    bl _kcc_macho_write32

    // n_type = N_SECT, plus N_EXT only for an external (non-local) symbol.
    // Local defined symbols (string literals) get 0x0E so they are not exported
    // and cannot collide across objects.
    ldr x2, [sp, #112]            // reload sym entry ptr
    ldr x3, [x2, #SYM_FLAGS]
    and w3, w3, #N_EXT
    orr w0, w3, #N_SECT
    bl _kcc_macho_write8

    // n_sect = section number from sym entry
    ldr x2, [sp, #112]            // reload sym entry ptr
    ldr w0, [x2, #SYM_SECTION]
    bl _kcc_macho_write8

    // n_desc = 0
    mov w0, #0
    bl _kcc_macho_write16

    // n_value = symbol value (offset in section) rebased to the section's VM
    // start.  Section 2 (__common) starts at code_size; section 3
    // (__DATA_CONST,__const) starts 8-aligned after __common (past the modinit
    // pointer when present), matching the addr written in its section header.
    ldr x2, [sp, #112]            // reload sym entry ptr
    ldr x0, [x2, #SYM_VALUE]
    ldr x3, [x2, #SYM_SECTION]
    cmp x3, #2
    b.eq .Lmf_sym_val_sec2
    cmp x3, #3
    b.eq .Lmf_sym_val_sec3
    b .Lmf_sym_val_ok
.Lmf_sym_val_sec2:
    adrp x3, _kcc_code_pos@@PAGE
    add  x3, x3, _kcc_code_pos@@PAGEOFF
    ldr x3, [x3]                  // code_size
    add x0, x0, x3
    b .Lmf_sym_val_ok
.Lmf_sym_val_sec3:
    adrp x3, _kcc_code_pos@@PAGE
    add  x3, x3, _kcc_code_pos@@PAGEOFF
    ldr x3, [x3]                  // code_size
    adrp x4, _kcc_globals_size@@PAGE
    add  x4, x4, _kcc_globals_size@@PAGEOFF
    ldr x4, [x4]
    add x3, x3, x4                // code_size + globals_size
    adrp x4, _kcc_modinit_present@@PAGE
    add  x4, x4, _kcc_modinit_present@@PAGEOFF
    ldr x4, [x4]
    cbz x4, .Lmf_sym_val_sec3_al
    add x3, x3, #7
    bic x3, x3, #7
    add x3, x3, #8               // past the modinit pointer
.Lmf_sym_val_sec3_al:
    add x3, x3, #7
    bic x3, x3, #7               // 8-align the const section start
    add x0, x0, x3
.Lmf_sym_val_ok:
    bl _kcc_macho_write64

    // Advance strtab_pos by strlen(name) + 1
    ldr x2, [sp, #112]            // reload sym entry ptr
    ldr x0, [x2, #SYM_NAME]
    bl _kcc_strlen
    add x0, x0, #1
    ldr x3, [sp, #96]
    add x3, x3, x0
    str x3, [sp, #96]

.Lmf_sym_def_skip:
    add x28, x28, #1
    b .Lmf_sym_def_loop
.Lmf_sym_def_done:
@}

\paragraph{Undefined Symbol Entries}

The second pass emits \texttt{nlist\_64} entries for symbols whose
\texttt{SYM\_SECTION} is zero---these are external references
(typically libc functions like \texttt{\_printf} or
\texttt{\_exit}).  Their \texttt{n\_type} is set to
\texttt{N\_UNDF\,|\,N\_EXT} (\texttt{0x01}), \texttt{n\_sect} is
\texttt{NO\_SECT} (0), and \texttt{n\_value} is zero since the
actual address will be resolved by the linker.  The string-table
offset counter \texttt{sp+96} continues from where the defined-symbol
pass left off, maintaining a consistent mapping between the symbol
table and the string table.

@d MachO: finalize @{
    // Pass 2: undefined symbols
    mov x28, #0
.Lmf_sym_undef_loop:
    cmp x28, x20
    b.ge .Lmf_sym_undef_done

    adrp x0, _kcc_linker_syms@@PAGE
    add  x0, x0, _kcc_linker_syms@@PAGEOFF
    ldr x0, [x0]
    mov x1, x28
    bl _kcc_vec_get
    str x0, [sp, #112]            // save sym entry ptr

    ldr x3, [x0, #SYM_SECTION]
    cbnz x3, .Lmf_sym_undef_skip  // skip defined

    // n_strx
    ldr w0, [sp, #96]
    bl _kcc_macho_write32

    // n_type = N_UNDF | N_EXT = 0x01
    mov w0, #0x01
    bl _kcc_macho_write8

    // n_sect = 0 (NO_SECT)
    mov w0, #0
    bl _kcc_macho_write8

    // n_desc = 0
    mov w0, #0
    bl _kcc_macho_write16

    // n_value = 0
    mov x0, #0
    bl _kcc_macho_write64

    // Advance strtab_pos
    ldr x2, [sp, #112]            // reload sym entry ptr
    ldr x0, [x2, #SYM_NAME]
    bl _kcc_strlen
    add x0, x0, #1
    ldr x3, [sp, #96]
    add x3, x3, x0
    str x3, [sp, #96]

.Lmf_sym_undef_skip:
    add x28, x28, #1
    b .Lmf_sym_undef_loop
.Lmf_sym_undef_done:
@}

\paragraph{String Table and File Flush}

The string table is a flat byte array referenced by the
\texttt{n\_strx} offsets in each \texttt{nlist\_64} entry.  It begins
with a single NUL byte at index~0 (the Mach-O ``empty string''
sentinel), followed by each symbol's name including its null
terminator, written in the same defined-then-undefined order as the
symbol table.  After the string table is complete, the entire output
buffer---from the Mach-O header through the last string byte---is
flushed to disk in one \texttt{write} system call, and the file
descriptor is closed.  The callee-saved registers are restored and
the function returns.

@d MachO: finalize @{
    // ---- Write string table ----
    // Leading NUL byte
    mov w0, #0
    bl _kcc_macho_write8

    // Write symbol names in same order (defined first, then undefined)
    // Pass 1: defined
    mov x28, #0
.Lmf_str_def_loop:
    cmp x28, x20
    b.ge .Lmf_str_def_done

    adrp x0, _kcc_linker_syms@@PAGE
    add  x0, x0, _kcc_linker_syms@@PAGEOFF
    ldr x0, [x0]
    mov x1, x28
    bl _kcc_vec_get
    str x0, [sp, #112]            // save sym entry ptr

    ldr x3, [x0, #SYM_SECTION]
    cbz x3, .Lmf_str_def_skip

    ldr x0, [x0, #SYM_NAME]
    str x0, [sp, #120]            // save name ptr
    bl _kcc_strlen
    add x1, x0, #1                // include null terminator
    ldr x0, [sp, #120]            // reload name ptr
    bl _kcc_macho_write_bytes

.Lmf_str_def_skip:
    add x28, x28, #1
    b .Lmf_str_def_loop
.Lmf_str_def_done:

    // Pass 2: undefined
    mov x28, #0
.Lmf_str_undef_loop:
    cmp x28, x20
    b.ge .Lmf_str_undef_done

    adrp x0, _kcc_linker_syms@@PAGE
    add  x0, x0, _kcc_linker_syms@@PAGEOFF
    ldr x0, [x0]
    mov x1, x28
    bl _kcc_vec_get
    str x0, [sp, #112]            // save sym entry ptr

    ldr x3, [x0, #SYM_SECTION]
    cbnz x3, .Lmf_str_undef_skip

    ldr x0, [x0, #SYM_NAME]
    str x0, [sp, #120]            // save name ptr
    bl _kcc_strlen
    add x1, x0, #1
    ldr x0, [sp, #120]            // reload name ptr
    bl _kcc_macho_write_bytes

.Lmf_str_undef_skip:
    add x28, x28, #1
    b .Lmf_str_undef_loop
.Lmf_str_undef_done:

    // ---- Flush to file ----
    adrp x0, _kcc_macho_fd@@PAGE
    add  x0, x0, _kcc_macho_fd@@PAGEOFF
    ldr x0, [x0]                   // fd
    adrp x1, _kcc_macho_buf@@PAGE
    add  x1, x1, _kcc_macho_buf@@PAGEOFF
    ldr x1, [x1]                   // buf
    adrp x2, _kcc_macho_pos@@PAGE
    add  x2, x2, _kcc_macho_pos@@PAGEOFF
    ldr x2, [x2]                   // len
    bl _kcc_sys_write

    // Close file
    adrp x0, _kcc_macho_fd@@PAGE
    add  x0, x0, _kcc_macho_fd@@PAGEOFF
    ldr x0, [x0]
    bl _kcc_sys_close

    ldp x27, x28, [sp, #80]
    ldp x25, x26, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #128
    ret
@}

\section{Mach-O Data}

Module state: the output file descriptor, the write buffer pointer,
and the current buffer position.  The error string lives in the
\texttt{\_\_cstring} section so it can be passed to
\texttt{kcc\_io\_err}.

@d MachO: data @{
// -- Mach-O module data -------------------------------------------------------
.data
.p2align 3
.globl _kcc_macho_fd
_kcc_macho_fd:       .quad 0     // output file descriptor
.globl _kcc_macho_buf
_kcc_macho_buf:      .quad 0     // output buffer pointer
.globl _kcc_macho_pos
_kcc_macho_pos:      .quad 0     // current write position
.globl _kcc_macho_cap
_kcc_macho_cap:      .quad 0     // allocated output buffer size (overflow guard)

.section __TEXT,__cstring,cstring_literals
_kcc_macho_err_open:
    .asciz "kcc: error: cannot open output file\n"
_kcc_macho_err_overflow:
    .asciz "kcc: error: object file exceeds output buffer\n"

// Section/segment names are now written as inline immediates in the emitter
// (avoids linker dead-stripping trailing null bytes from local atoms)
@| _kcc_macho_fd
@| _kcc_macho_buf
@| _kcc_macho_pos
@| _kcc_macho_cap
@}
