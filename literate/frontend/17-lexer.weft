@| _kcc_kw_s_tlocal
@}

The initialization function creates a hash table and populates it
by looping through the registration table.

@d Lexer: keyword init @{
.text
// -- kcc_lex_kw_init ------------------------------------------------
// void kcc_lex_kw_init(void)
// Builds the keyword hash table from the registration table.
.globl _kcc_lex_kw_init
.p2align 2
_kcc_lex_kw_init:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]

    // Create hash table with capacity 128 (power of 2, >2x keywords)
    mov x0, #128
    bl _kcc_ht_init
    mov x19, x0                  // x19 = hash table

    // Store in global
    adrp x1, _kcc_kw_table@@PAGE
    add  x1, x1, _kcc_kw_table@@PAGEOFF
    str  x19, [x1]

    // Loop through registration table
    adrp x20, _kcc_kw_reg_table@@PAGE
    add  x20, x20, _kcc_kw_reg_table@@PAGEOFF
    mov  x21, #0                 // counter
    mov  x22, #KW_COUNT

.Lkw_init_loop:
    cmp x21, x22
    b.hs .Lkw_init_done

    // Load entry: [string_ptr, string_len, token_type]
    ldr x1, [x20, #0]           // key = string ptr
    ldr x2, [x20, #8]           // keylen = string length
    ldr x3, [x20, #16]          // value = token type

    mov x0, x19                  // ht
    bl _kcc_ht_put

    add x20, x20, #KW_ENTRY_BYTES
    add x21, x21, #1
    b .Lkw_init_loop

.Lkw_init_done:
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_lex_kw_init
@}

\section{Lexer Global State}

The lexer maintains its state in global variables: the cursor position,
end of buffer, current line/column tracking, and the current token.

@d Lexer: data @{
// -- Lexer global state ---------------------------------------------
.data
.p2align 3
.globl _kcc_lex_cursor
_kcc_lex_cursor:     .quad 0  // current position in source buffer
.globl _kcc_lex_end
_kcc_lex_end:        .quad 0  // one past end of source buffer
.globl _kcc_lex_line
_kcc_lex_line:       .quad 1  // current line number (1-based)
.globl _kcc_lex_line_start
_kcc_lex_line_start: .quad 0  // pointer to start of current line

// Current token (exported for test harness access)
.globl _kcc_tok_type
_kcc_tok_type:       .quad 0  // token type code
.globl _kcc_tok_start
_kcc_tok_start:      .quad 0  // pointer to token text in source
.globl _kcc_tok_len
_kcc_tok_len:        .quad 0  // token text length
.globl _kcc_tok_line
_kcc_tok_line:       .quad 0  // line where token starts
.globl _kcc_tok_col
_kcc_tok_col:        .quad 0  // column where token starts

// Keyword hash table
.globl _kcc_kw_table
_kcc_kw_table:       .quad 0  // pointer to keyword hash table

// Error messages (bare text — diagnostic engine adds file:line:col prefix)
.section __TEXT,__cstring,cstring_literals
_kcc_err_unterm_string:  .asciz "unterminated string literal"
_kcc_err_unterm_char:    .asciz "unterminated character constant"
_kcc_err_unterm_comment: .asciz "unterminated block comment"
@| _kcc_lex_cursor
@| _kcc_lex_end
@| _kcc_lex_line
@| _kcc_lex_line_start
@| _kcc_tok_type
@| _kcc_tok_start
@| _kcc_tok_len
@| _kcc_tok_line
@| _kcc_tok_col
@| _kcc_kw_table
@| _kcc_err_unterm_string
@| _kcc_err_unterm_char
@| _kcc_err_unterm_comment
@}
