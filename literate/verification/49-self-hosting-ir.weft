\section{Initialisation and Node Allocation}

The IR module's global state is cleared per translation unit, and the three
node kinds---instruction, basic block, function---are arena-allocated and
zero-filled.  These mirror \S\ref{ch:ir-design} field for field.

@l c
@d Selfhost: ir design @{
void kcc_ir_init(void) {
    kcc_ir_cur_func = 0;
    kcc_ir_cur_bb = 0;
    /* clear per-TU module-init state so a later unit does not inherit a
       stale flag and emit a stray __mod_init_func pointer */
    kcc_modinit_present = 0;
    kcc_modinit_sym = 0;
    kcc_modinit_fileoff = 0;
    /* function list vector: 8-byte pointer elements, cap 16 */
    void *v = kcc_arena_alloc(VEC_SIZE);
    kcc_ir_funcs = v;
    IL(v, VEC_ELEMSIZE) = 8;
    IL(v, VEC_CAP) = 16;
    IL(v, VEC_COUNT) = 0;
    IL(v, VEC_DATA) = (unsigned long)kcc_arena_alloc(128);
    kcc_ir_locals = kcc_ht_init(64);
    kcc_ir_local_consts = kcc_ht_init(64);
    /* break/continue stack: pairs of pointers, 16 bytes each */
    v = kcc_arena_alloc(VEC_SIZE);
    kcc_ir_loop_stack = v;
    IL(v, VEC_ELEMSIZE) = 16;
    IL(v, VEC_CAP) = 8;
    IL(v, VEC_COUNT) = 0;
    IL(v, VEC_DATA) = (unsigned long)kcc_arena_alloc(128);
    kcc_ir_bb_counter = 0;
}

void *kcc_ir_alloc_instr(unsigned long op) {
    void *i = kcc_arena_alloc(IR_INSTR_SIZE);
    IL(i, IR_OP) = op;
    IL(i, IR_DEST) = 0;
    IL(i, IR_SRC1) = 0;
    IL(i, IR_SRC2) = 0;
    IL(i, IR_TYPE) = 0;
    IL(i, IR_NEXT) = 0;
    return i;
}

void *kcc_ir_alloc_bb(void) {
    void *b = kcc_arena_alloc(IR_BB_SIZE);
    IL(b, BB_ID) = kcc_ir_bb_counter;
    kcc_ir_bb_counter = kcc_ir_bb_counter + 1;
    IL(b, BB_FIRST) = 0;
    IL(b, BB_LAST) = 0;
    IL(b, BB_NEXT) = 0;
    IL(b, BB_FLAGS) = 0;
    return b;
}

void *kcc_ir_alloc_func(const char *name, void *ret_type) {
    void *f = kcc_arena_alloc(IR_FUNC_SIZE);
    IL(f, IRF_NAME) = (unsigned long)name;
    IL(f, IRF_RETTYPE) = (unsigned long)ret_type;
    IL(f, IRF_ENTRY) = 0;
    IL(f, IRF_VREG_N) = 0;
    IL(f, IRF_PARAMS) = 0;
    IL(f, IRF_PARAM_CLS) = 0;
    IL(f, IRF_LINE) = 0;
    IL(f, IRF_LOWPC) = 0;
    IL(f, IRF_STATIC) = 0;
    IL(f, IRF_SYMIDX) = 0;
    void *v = kcc_arena_alloc(VEC_SIZE);
    IL(f, IRF_BLOCKS) = (unsigned long)v;
    IL(v, VEC_ELEMSIZE) = 8;
    IL(v, VEC_CAP) = 16;
    IL(v, VEC_COUNT) = 0;
    IL(v, VEC_DATA) = (unsigned long)kcc_arena_alloc(128);
    return f;
}

void kcc_ir_emit(void *instr) {
    void *bb = kcc_ir_cur_bb;
    if (!bb) return;
    if (IL(bb, BB_FLAGS) & BB_FLAG_TERMINATED) return;
    void *last = (void *)IL(bb, BB_LAST);
    if (last) {
        IL(last, IR_NEXT) = (unsigned long)instr;
        IL(bb, BB_LAST) = (unsigned long)instr;
    } else {
        IL(bb, BB_FIRST) = (unsigned long)instr;
        IL(bb, BB_LAST) = (unsigned long)instr;
    }
}

void kcc_ir_emit_entry(void *instr) {
    void *fn = kcc_ir_cur_func;
    if (!fn) return;
    void *bb = (void *)IL(fn, IRF_ENTRY);
    if (!bb) return;
    IL(instr, IR_NEXT) = IL(bb, BB_FIRST);
    IL(bb, BB_FIRST) = (unsigned long)instr;
    if (!IL(bb, BB_LAST)) IL(bb, BB_LAST) = (unsigned long)instr;
}

unsigned long kcc_ir_next_vreg(void) {
    void *fn = kcc_ir_cur_func;
    if (!fn) return 0;
    unsigned long n = IL(fn, IRF_VREG_N);
    IL(fn, IRF_VREG_N) = n + 1;
    return n;
}

void kcc_ir_set_bb(void *bb) {
    kcc_ir_cur_bb = bb;
    void *fn = kcc_ir_cur_func;
    if (!fn) return;
    void *v = (void *)IL(fn, IRF_BLOCKS);
    kcc_vec_push(v, &bb);
}
@}

\section{The Builder Spine}

The spine holds the read-only-globals predicates (which decide whether a
\texttt{const} global can live as a fixed byte image), the global-initializer
emission that seeds file-scope and \texttt{static}-local storage at startup, the
per-function driver, parameter lowering, the label/goto helpers, the block-scope
shadowing journal, the statement dispatcher, and \texttt{return}.

Alongside the shadowing journal the spine keeps a second, x86-only table of
\emph{const-initialised locals}.  A kernel \texttt{WARN}/\texttt{BUG} entry
passes its flags word to an \verb|"i"| (immediate) inline-asm operand, but
through a macro-local variable: \verb|__auto_type __flags = BUGFLAG_WARNING|(flags);|
then \verb|"i"(__flags)|.  GCC constant-propagates \texttt{\_\_flags} into the
operand under optimisation; kcc does not run general constant propagation, so
without help it materialises the variable in a register and emits a nonsensical
\verb|.word %r8| (and a backwards \verb|.org|).  The fix records, at each scalar
integer declaration whose initialiser is an integer constant expression, a box
\texttt{\{lv, value\}} keyed by the variable's name---where \texttt{lv} is its
\texttt{kcc\_ir\_locals} handle (\texttt{base+1}, unique per variable instance and
reset per function).  An \verb|"i"| operand naming such a local then folds to its
recorded value.  Keying the match on \texttt{lv} rather than the name alone keeps
it sound: a stale box left by a departed inner scope, or one from a prior
function, carries a different \texttt{lv} and never matches a live local of the
same name.  Any later assignment, address-of, or \verb|++/--| of the variable
disables its box (the value is no longer a manifest constant at a subsequent asm
use)---and a well-formed \verb|"i"| operand can never name a variable modified
before that use anyway, so the textual-order kill is enough.

A constant that reaches an inline-asm operand is emitted immediately only when it
fits: an x86 ALU instruction encodes at most a sign-extended 32-bit immediate, so
when the folded value overflows that field and the constraint also admits a
register (the \verb|"re"| of the percpu \texttt{add}, whose
\texttt{PERCPU\_COUNT\_BIAS} is \(2^{63}\)), the operand is handed to the register
path instead and loaded with \texttt{movabsq}, matching GCC's choice of the
register alternative.

@l c
@d Selfhost: ir spine @{
/* -- entry point: walk the translation unit, build every function body -- */
void kcc_ir_build(void *tu) {
    kcc_ir_trans_unit = tu;
    void *d = (void *)IL(tu, AST_F0);
    while (d) {
        if (IL(d, AST_TAG) == AST_FUNC_DECL && IL(d, AST_F3)) {
            /* An always_inline function is expanded at each call, so it is not
               emitted standalone---which also keeps its body AST pristine, as a
               standalone build lowers the asm operands in place and inlining
               needs the original operand expressions to fold constants. */
            const char *nm = (const char *)IL(d, AST_F1);
            if (!(kcc_always_inline_fns && nm &&
                  kcc_ht_get(kcc_always_inline_fns, nm, kcc_strlen(nm))))
                kcc_ir_build_func(d);
        }
        d = (void *)IL(d, AST_F4);
    }
    /* decide whether this TU needs a module-init function: no main, but at
       least one file-scope or static-local initializer to run at startup */
    unsigned long has_main = 0, has_ginit = 0;
    d = (void *)IL(tu, AST_F0);
    while (d) {
        unsigned long tag = IL(d, AST_TAG);
        if (tag == AST_FUNC_DECL) {
            void *body = (void *)IL(d, AST_F3);
            if (body) {
                void *s = (void *)IL(body, AST_F0);
                while (s) {
                    if (IL(s, AST_TAG) == AST_VAR_DECL && IL(s, AST_F3) == 3 && IL(s, AST_F2)) {
                        has_ginit = 1;
                        break;
                    }
                    s = (void *)IL(s, AST_F4);
                }
                void *name = (void *)IL(d, AST_F1);
                if (name && kcc_strcmp((const char *)name, "main") == 0) has_main = 1;
            }
        } else if (tag == AST_VAR_DECL) {
            if (IL(d, AST_F2)) has_ginit = 1;
        }
        d = (void *)IL(d, AST_F4);
    }
    if (!has_main && has_ginit) kcc_ir_emit_modinit();
}

/* -- read-only const-global predicates (\S\ref{sec:global-inits}) -- */
unsigned long kcc_rodata_binop_ok(unsigned long op) {
    if (op == TOK_PLUS || op == TOK_MINUS || op == TOK_STAR || op == TOK_SLASH ||
        op == TOK_PERCENT || op == TOK_SHL || op == TOK_SHR || op == TOK_AMP ||
        op == TOK_PIPE || op == TOK_CARET) return 1;
    return 0;
}

unsigned long kcc_rodata_const_intexpr(void *n) {
    if (!n) return 0;
    unsigned long tag = IL(n, AST_TAG);
    if (tag == AST_INT_LIT || tag == AST_CHAR_LIT) return 1;
    if (tag == AST_TYPES_COMPAT) return 1;   /* folds to 0/1 */
    if (tag == AST_PAREN_EXPR) return kcc_rodata_const_intexpr((void *)IL(n, AST_F0));
    if (tag == AST_CAST_EXPR) return kcc_rodata_const_intexpr((void *)IL(n, AST_F1));
    if (tag == AST_UNARY_EXPR) {
        unsigned long op = IL(n, AST_F0);
        if (op != TOK_MINUS && op != TOK_TILDE && op != TOK_BANG) return 0;
        return kcc_rodata_const_intexpr((void *)IL(n, AST_F1));
    }
    if (tag == AST_BINARY_EXPR) {
        if (!kcc_rodata_binop_ok(IL(n, AST_F0))) return 0;
        if (!kcc_rodata_const_intexpr((void *)IL(n, AST_F1))) return 0;
        return kcc_rodata_const_intexpr((void *)IL(n, AST_F2));
    }
    if (tag == AST_IDENT_EXPR) {
        char *name = (char *)IL(n, AST_F0);
        if (!name) return 0;
        void *sym = kcc_symtab_lookup(name, kcc_strlen(name));
        if (!sym) return 0;
        if (IL(sym, SYM_KIND) != SYM_ENUM_CONST) return 0;
        return 1;
    }
    return 0;
}

unsigned long kcc_rodata_is_lit(void *n, unsigned long isfloat) {
    if (!isfloat) return kcc_rodata_const_intexpr(n);
    unsigned long tag = IL(n, AST_TAG);
    if (tag == AST_UNARY_EXPR) {
        if (IL(n, AST_F0) != TOK_MINUS) return 0;
        n = (void *)IL(n, AST_F1);
        if (!n) return 0;
        tag = IL(n, AST_TAG);
    }
    return tag == AST_FLOAT_LIT ? 1 : 0;
}

unsigned long kcc_rodata_struct_ok(void *sty, void *init) {
    if (IL(init, AST_TAG) != AST_INIT_LIST) return 0;
    void *elem = (void *)IL(init, AST_F0);
    kcc_type_layout(sty);
    void *sd = (void *)IL(sty, TY_F0);            /* AST_STRUCT_DECL */
    if (!sd) return 0;
    void *field = (void *)IL(sd, AST_F1);
    while (elem) {
        if (!field) return 0;                     /* more inits than fields */
        if (IL(field, AST_F2)) return 0;          /* reject bit-fields */
        if (IL(elem, AST_TAG) == AST_DESIGNATOR) return 0;
        void *ft = (void *)IL(field, AST_F0);
        if (!ft) return 0;
        ft = kcc_sema_resolve_type(ft);
        if (!ft) return 0;
        unsigned long k = IL(ft, TY_KIND);
        if (k < TY_BOOL || k > TY_DOUBLE) return 0;
        unsigned long isf = (k >= TY_FLOAT) ? 1 : 0;
        if (!kcc_rodata_is_lit(elem, isf)) return 0;
        field = (void *)IL(field, AST_F4);
        elem = (void *)IL(elem, AST_F4);
    }
    return 1;
}

unsigned long kcc_rodata_aos_ok(void *sty, void *outer) {
    if (IL(outer, AST_TAG) != AST_INIT_LIST) return 0;
    void *elem = (void *)IL(outer, AST_F0);
    while (elem) {
        if (IL(elem, AST_TAG) != AST_INIT_LIST) return 0;
        if (!kcc_rodata_struct_ok(sty, elem)) return 0;
        elem = (void *)IL(elem, AST_F4);
    }
    return 1;
}

unsigned long kcc_global_const_rodata(void *decl) {
    if (!IL(decl, AST_F2)) return 0;              /* needs an initializer */
    void *t = (void *)IL(decl, AST_F0);           /* declared type spec */
    unsigned long wrappers = 0;
    while (1) {
        if (!t) return 0;
        unsigned long tg = IL(t, AST_TAG);
        if (tg == AST_TYPE_ARRAY) { wrappers++; t = (void *)IL(t, AST_F0); continue; }
        if (tg != AST_TYPE_QUALS) return 0;
        if (!(IL(t, AST_F1) & 1)) return 0;       /* const bit */
        void *base = (void *)IL(t, AST_F0);
        if (!base) return 0;
        base = kcc_sema_resolve_type(base);
        if (!base) return 0;
        unsigned long k = IL(base, TY_KIND);
        if (k == TY_STRUCT) {
            if (wrappers == 0) return kcc_rodata_struct_ok(base, (void *)IL(decl, AST_F2));
            if (wrappers != 1) return 0;
            return kcc_rodata_aos_ok(base, (void *)IL(decl, AST_F2));
        }
        if (k < TY_BOOL) return 0;
        unsigned long isf;
        if (k <= TY_LLONG) isf = 0;
        else if (k <= TY_DOUBLE) isf = 1;
        else return 0;
        void *init = (void *)IL(decl, AST_F2);
        if (IL(init, AST_TAG) != AST_INIT_LIST) return kcc_rodata_is_lit(init, isf);
        void *e = (void *)IL(init, AST_F0);
        while (e) {
            if (!kcc_rodata_is_lit(e, isf)) return 0;
            e = (void *)IL(e, AST_F4);
        }
        return 1;
    }
}

unsigned long kcc_global_const_ptrarr(void *decl) {
    if (!IL(decl, AST_F2)) return 0;
    void *t = (void *)IL(decl, AST_F0);
    if (!t) return 0;
    if (IL(t, AST_TAG) != AST_TYPE_ARRAY) return 0;
    t = (void *)IL(t, AST_F0);                    /* element type: a pointer */
    if (!t) return 0;
    if (IL(t, AST_TAG) != AST_TYPE_PTR) return 0;
    if (!(IL(t, AST_F1) & 1)) return 0;           /* *const element */
    void *init = (void *)IL(decl, AST_F2);
    if (IL(init, AST_TAG) != AST_INIT_LIST) return 0;
    void *e = (void *)IL(init, AST_F0);
    while (e) {
        unsigned long tg = IL(e, AST_TAG);
        if (tg != AST_STR_LIT && tg != AST_INT_LIT) return 0;
        e = (void *)IL(e, AST_F4);
    }
    return 1;
}

/* -- global-initializer emission at the top of main / a module-init fn -- */
void kcc_ir_emit_global_inits(void) {
    void *tu = kcc_ir_trans_unit;
    if (!tu) return;
    void *d = (void *)IL(tu, AST_F0);
    while (d) {
        if (IL(d, AST_TAG) == AST_VAR_DECL && IL(d, AST_F2) && IL(d, AST_F1)) {
            void *name = (void *)IL(d, AST_F1);
            if (!kcc_global_const_rodata(d) && !kcc_global_const_ptrarr(d)) {
                void *g = kcc_ir_alloc_instr(IR_GLOBAL_REF);
                IL(g, IR_SRC1) = (unsigned long)name;
                IL(g, IR_TYPE) = (unsigned long)kcc_type_int_s;
                unsigned long addr = kcc_ir_next_vreg();
                IL(g, IR_DEST) = addr;
                kcc_ir_emit(g);
                kcc_ir_emit_init_stores(d, addr);
            }
        }
        d = (void *)IL(d, AST_F4);
    }
    /* second pass: one-time static-local initialisers, hoisted to globals */
    d = (void *)IL(tu, AST_F0);
    while (d) {
        if (IL(d, AST_TAG) == AST_FUNC_DECL) {
            void *body = (void *)IL(d, AST_F3);
            if (body) {
                /* Re-register this function's static-locals: emit_modinit reset
                   the mangled-name table, so an initializer that takes the
                   address of a sibling static (`static T *p[] = { other, ... }')
                   would otherwise resolve to the source name and link against an
                   undefined symbol.  Register before emitting any init store. */
                void *rs = (void *)IL(body, AST_F0);
                while (rs) {
                    if (IL(rs, AST_TAG) == AST_VAR_DECL && IL(rs, AST_F3) == 3 &&
                        IL(rs, AST_F1)) {
                        void *nm = (void *)IL(rs, AST_F1);
                        unsigned long kl = kcc_strlen((const char *)nm);
                        kcc_ht_put(kcc_ir_statics, nm, kl,
                                   (void *)kcc_ir_static_name(rs));
                        void *tn = (void *)IL(rs, AST_F0);
                        if (tn) {
                            void *rt = kcc_sema_resolve_type(tn);
                            if (rt) kcc_ht_put(kcc_ir_static_types, nm, kl, rt);
                        }
                    }
                    rs = (void *)IL(rs, AST_F4);
                }
                void *s = (void *)IL(body, AST_F0);
                while (s) {
                    if (IL(s, AST_TAG) == AST_VAR_DECL && IL(s, AST_F3) == 3 &&
                        IL(s, AST_F2) &&
                        !kcc_global_const_rodata(s) && !kcc_global_const_ptrarr(s)) {
                        const char *mangled = kcc_ir_static_name(s);
                        void *g = kcc_ir_alloc_instr(IR_GLOBAL_REF);
                        IL(g, IR_SRC1) = (unsigned long)mangled;
                        IL(g, IR_TYPE) = (unsigned long)kcc_type_int_s;
                        unsigned long addr = kcc_ir_next_vreg();
                        IL(g, IR_DEST) = addr;
                        kcc_ir_emit(g);
                        kcc_ir_emit_init_stores(s, addr);
                    }
                    s = (void *)IL(s, AST_F4);
                }
            }
        }
        d = (void *)IL(d, AST_F4);
    }
    /* Discard the static-local names seeded above: this runs at the top of
       main (or a module-init), and leaving other functions' statics in the
       table would let them shadow a like-named global in the body that
       follows (a static `c` masking the global `c`). */
    kcc_ir_statics = kcc_ht_init(16);
    kcc_ir_static_types = kcc_ht_init(16);
}

void kcc_ir_emit_aggregate_init(void *init_list, void *agg, unsigned long base) {
    void *head = (void *)IL(init_list, AST_F0);
    kcc_ir_fill_list(agg, base, 0, head);
}

void kcc_ir_emit_init_stores(void *decl, unsigned long base_vreg) {
    void *init = (void *)IL(decl, AST_F2);
    if (!init) return;
    unsigned long itag = IL(init, AST_TAG);
    if (itag == AST_INIT_LIST) {
        void *ty = kcc_sema_resolve_type((void *)IL(decl, AST_F0));
        if (!ty) ty = kcc_type_int_s;
        kcc_ir_emit_aggregate_init(init, ty, base_vreg);
        return;
    }
    if (itag == AST_STR_LIT) {
        void *ty = kcc_sema_resolve_type((void *)IL(decl, AST_F0));
        if (ty && IL(ty, TY_KIND) == TY_ARRAY) {
            unsigned long alen = IL(ty, TY_F1);
            const char *sp = (const char *)IL(init, AST_F0);
            unsigned long slen = IL(init, AST_F1);
            if (!alen) alen = slen + 1;
            kcc_ir_emit_string_init(base_vreg, sp, slen, alen, 0);
            return;
        }
        /* a char *g = "..." target is a scalar store of the address */
    }
    /* scalar (or whole-object struct copy) */
    void *rty = kcc_sema_resolve_type((void *)IL(decl, AST_F0));
    if (rty) {
        unsigned long k = IL(rty, TY_KIND);
        if (k == TY_STRUCT || k == TY_UNION) {
            unsigned long src = kcc_ir_build_struct_addr(init);
            unsigned long sz = kcc_type_layout(rty);
            kcc_ir_emit_struct_copy(src, base_vreg, sz);
            return;
        }
    }
    void *from = (void *)IL(init, AST_F3);        /* initializer's sema type */
    unsigned long val = kcc_ir_build_expr(init);
    void *to = kcc_sema_resolve_type((void *)IL(decl, AST_F0));
    if (to && from) val = kcc_ir_convert(val, from, to);
    if (to && IL(to, TY_KIND) == TY_BOOL) val = kcc_ir_emit_bool_norm(val);
    unsigned long size = kcc_ir_store_width(to);
    void *st = kcc_ir_alloc_instr(IR_STORE);
    IL(st, IR_TYPE) = to ? (unsigned long)to : (unsigned long)kcc_type_int_s;
    IL(st, IR_SRC1) = val;
    IL(st, IR_SRC2) = base_vreg;
    IL(st, IR_DEST) = size;
    kcc_ir_emit(st);
}

void kcc_ir_emit_modinit(void) {
    void *f = kcc_ir_alloc_func(kcc_str_modinit, kcc_type_int_s);
    kcc_ir_cur_func = f;
    kcc_ir_locals = kcc_ht_init(64);
    kcc_ir_local_consts = kcc_ht_init(64);
    kcc_ir_statics = kcc_ht_init(16);
    kcc_ir_static_types = kcc_ht_init(16);
    kcc_ir_labels = kcc_ht_init(16);
    kcc_ir_scope_jdepth = 0;
    kcc_ir_scope_sp = 0;
    void *bb = kcc_ir_alloc_bb();
    IL(f, IRF_ENTRY) = (unsigned long)bb;
    kcc_ir_set_bb(bb);
    kcc_ir_emit_global_inits();
    void *ret = kcc_ir_alloc_instr(IR_RET);
    IL(ret, IR_TYPE) = (unsigned long)kcc_type_int_s;
    kcc_ir_emit(ret);
    void *cur = kcc_ir_cur_bb;
    IL(cur, BB_FLAGS) = IL(cur, BB_FLAGS) | BB_FLAG_TERMINATED;
    kcc_vec_push(kcc_ir_funcs, &f);
    kcc_modinit_present = 1;
}

/* -- per-function driver -- */
void kcc_ir_build_func(void *fd) {
    void *name = (void *)IL(fd, AST_F1);
    void *ta = (void *)IL(fd, AST_F0);            /* type AST */
    void *ret = 0;
    if (ta) {
        if (IL(ta, AST_TAG) == AST_TYPE_FUNC) ta = (void *)IL(ta, AST_F0);
        if (ta) ret = kcc_sema_resolve_type(ta);
    }
    if (!ret) ret = kcc_type_int_s;

    void *f = kcc_ir_alloc_func(name, ret);
    IL(f, IRF_LINE) = IL(fd, AST_LINE);
    IL(f, IRF_STATIC) = (IL(fd, AST_F2) & 2) >> 1;
    kcc_ir_cur_func = f;
    kcc_ir_locals = kcc_ht_init(64);
    kcc_ir_local_consts = kcc_ht_init(64);
    kcc_ir_statics = kcc_ht_init(16);
    kcc_ir_static_types = kcc_ht_init(16);
    kcc_ir_labels = kcc_ht_init(16);

    void *entry = kcc_ir_alloc_bb();
    IL(f, IRF_ENTRY) = (unsigned long)entry;
    kcc_ir_set_bb(entry);

    /* count named parameters */
    void *p = (void *)(IL(fd, AST_F2) & ~3UL);
    unsigned long nparams = 0;
    while (p) {
        if (IL(p, AST_TAG) == AST_PARAM_DECL && IL(p, AST_F1)) nparams++;
        p = (void *)IL(p, AST_F4);
    }
    /* >16B struct return adds a hidden result-pointer parameter */
    if (kcc_ir_classify_type((void *)IL(f, IRF_RETTYPE)) == 4) nparams++;
    IL(f, IRF_PARAMS) = nparams;
    IL(f, IRF_VARIADIC) = IL(fd, AST_F2) & 1;

    kcc_ir_fill_param_classes(f, fd);

    /* reserve incoming-parameter vregs (an ST2 struct param takes two) */
    unsigned long width = 0;
    unsigned long i = 0;
    while (i < nparams) {
        void *cls = (void *)IL(f, IRF_PARAM_CLS);
        unsigned long c = cls ? IL(cls, i * 8) : 0;
        width += (c == 3) ? 2 : 1;
        i++;
    }
    i = 0;
    while (i < width) { kcc_ir_next_vreg(); i++; }

    /* build alloca + store for each parameter, tracking its vreg base */
    p = (void *)(IL(fd, AST_F2) & ~3UL);
    unsigned long pidx = 0;
    unsigned long vbase = 0;
    while (p) {
        if (IL(p, AST_TAG) == AST_PARAM_DECL && IL(p, AST_F1)) {
            kcc_ir_build_param(p, vbase);
            void *cls = (void *)IL(f, IRF_PARAM_CLS);
            unsigned long c = IL(cls, pidx * 8);
            vbase += (c == 3) ? 2 : 1;
            pidx++;
        }
        p = (void *)IL(p, AST_F4);
    }

    if (name && kcc_strcmp((const char *)name, "main") == 0)
        kcc_ir_emit_global_inits();

    kcc_ir_prescan_labels((void *)IL(fd, AST_F3));
    kcc_ir_build_stmt((void *)IL(fd, AST_F3));

    /* implicit return if the last block has no terminator */
    void *cur = kcc_ir_cur_bb;
    if (cur && !(IL(cur, BB_FLAGS) & BB_FLAG_TERMINATED)) {
        void *fname = (void *)IL(f, IRF_NAME);
        if (fname && kcc_strcmp((const char *)fname, "main") == 0) {
            unsigned long z = kcc_ir_emit_const(0);
            void *r = kcc_ir_alloc_instr(IR_RET);
            IL(r, IR_TYPE) = (unsigned long)ret;
            IL(r, IR_SRC1) = z;
            kcc_ir_emit(r);
        } else {
            void *r = kcc_ir_alloc_instr(IR_RET);
            IL(r, IR_TYPE) = 0;                   /* bare return: no value */
            kcc_ir_emit(r);
        }
        cur = kcc_ir_cur_bb;
        IL(cur, BB_FLAGS) = IL(cur, BB_FLAGS) | BB_FLAG_TERMINATED;
    }
    kcc_vec_push(kcc_ir_funcs, &f);
}

/* -- parameter lowering -- */
void kcc_ir_build_param(void *pd, unsigned long vreg_base) {
    void *t = (void *)IL(pd, AST_F0);
    if (!t) return;
    t = kcc_sema_resolve_type(t);
    t = kcc_type_param_adjust(t);
    if (!t) return;
    void *name = (void *)IL(pd, AST_F1);
    if (!name) return;

    unsigned long slots;
    if (IL(t, TY_KIND) == TY_STRUCT) slots = kcc_ir_type_slots(t);
    else slots = 1;

    void *a = kcc_ir_alloc_instr(IR_ALLOCA);
    IL(a, IR_TYPE) = (unsigned long)t;
    IL(a, IR_SRC1) = slots;
    unsigned long avreg = kcc_ir_next_vreg();
    IL(a, IR_DEST) = avreg;
    kcc_ir_emit(a);

    unsigned long k = IL(t, TY_KIND);
    if (k == TY_STRUCT || k == TY_UNION) {
        unsigned long sz = kcc_type_layout(t);
        if (sz <= 8) {
            goto scalar_store;
        } else if (sz <= 16) {
            kcc_ir_emit_indexed_store(avreg, 0, vreg_base, 0);
            kcc_ir_emit_indexed_store(avreg, 8, vreg_base + 1, 0);
        } else {
            kcc_ir_emit_struct_copy(vreg_base, avreg, sz);
        }
    } else {
    scalar_store: {
        void *st = kcc_ir_alloc_instr(IR_STORE);
        IL(st, IR_SRC1) = vreg_base;
        IL(st, IR_SRC2) = avreg;
        IL(st, IR_TYPE) = (unsigned long)t;
        IL(st, IR_DEST) = kcc_ir_store_width(t);
        kcc_ir_emit(st);
    }
    }
    /* record name -> alloca vreg+1 (bit 63 tags a pointer variable) */
    unsigned long v = avreg + 1;
    if (IL(t, TY_KIND) == TY_PTR) v = v | 0x8000000000000000UL;
    kcc_ht_put(kcc_ir_locals, name, kcc_strlen((const char *)name), (void *)v);
}

/* -- labels and goto -- */
void kcc_ir_branch_to(void *target) {
    void *cur = kcc_ir_cur_bb;
    if (!cur) return;
    if (IL(cur, BB_FLAGS) & BB_FLAG_TERMINATED) return;
    void *br = kcc_ir_alloc_instr(IR_BR);
    IL(br, IR_SRC1) = IL(target, BB_ID);
    kcc_ir_emit(br);
    cur = kcc_ir_cur_bb;
    IL(cur, BB_FLAGS) = IL(cur, BB_FLAGS) | BB_FLAG_TERMINATED;
}

void *kcc_ir_label_bb(const char *name) {
    if (!kcc_ir_labels) return 0;
    return kcc_ht_get(kcc_ir_labels, name, kcc_strlen(name));
}

void kcc_ir_prescan_labels(void *stmt) {
    if (!stmt) return;
    unsigned long tag = IL(stmt, AST_TAG);
    if (tag == AST_COMPOUND) {
        void *s = (void *)IL(stmt, AST_F0);
        while (s) { kcc_ir_prescan_labels(s); s = (void *)IL(s, AST_F4); }
    } else if (tag == AST_LABEL_STMT) {
        void *name = (void *)IL(stmt, AST_F0);
        void *bb = kcc_ir_alloc_bb();
        kcc_ht_put(kcc_ir_labels, name, kcc_strlen((const char *)name), bb);
        kcc_ir_prescan_labels((void *)IL(stmt, AST_F1));
    } else if (tag == AST_IF_STMT) {
        kcc_ir_prescan_labels((void *)IL(stmt, AST_F1));
        kcc_ir_prescan_labels((void *)IL(stmt, AST_F2));
    } else if (tag == AST_WHILE_STMT || tag == AST_SWITCH_STMT || tag == AST_CASE_STMT) {
        kcc_ir_prescan_labels((void *)IL(stmt, AST_F1));
    } else if (tag == AST_DO_STMT || tag == AST_DEFAULT_STMT) {
        kcc_ir_prescan_labels((void *)IL(stmt, AST_F0));
    } else if (tag == AST_FOR_STMT) {
        kcc_ir_prescan_labels((void *)IL(stmt, AST_F3));
    }
}

/* -- block-scope shadowing journal -- */
void kcc_ir_locals_put(const char *name, unsigned long keylen, unsigned long value) {
    unsigned long old = (unsigned long)kcc_ht_get(kcc_ir_locals, name, keylen);
    unsigned long j = kcc_ir_scope_jdepth;
    kcc_ir_scope_journal[j*3 + 0] = (unsigned long)name;
    kcc_ir_scope_journal[j*3 + 1] = keylen;
    kcc_ir_scope_journal[j*3 + 2] = old;
    kcc_ir_scope_jdepth = j + 1;
    kcc_ht_put(kcc_ir_locals, name, keylen, (void *)value);
}

void kcc_ir_scope_enter(void) {
    kcc_ir_scope_stack[kcc_ir_scope_sp] = kcc_ir_scope_jdepth;
    kcc_ir_scope_sp = kcc_ir_scope_sp + 1;
}

void kcc_ir_scope_leave(void) {
    kcc_ir_scope_sp = kcc_ir_scope_sp - 1;
    unsigned long floor = kcc_ir_scope_stack[kcc_ir_scope_sp];
    while (kcc_ir_scope_jdepth > floor) {
        unsigned long j = kcc_ir_scope_jdepth - 1;
        kcc_ir_scope_jdepth = j;
        kcc_ht_put(kcc_ir_locals,
                   (void *)kcc_ir_scope_journal[j*3 + 0],
                   kcc_ir_scope_journal[j*3 + 1],
                   (void *)kcc_ir_scope_journal[j*3 + 2]);
    }
}

/* -- const-initialised locals (x86 inline-asm "i"-operand folding) -- */
void kcc_ir_local_const_set(const char *name, unsigned long keylen,
                            unsigned long lv, unsigned long value) {
    unsigned long *box = (unsigned long *)kcc_arena_alloc(16);
    box[0] = lv;
    box[1] = value;
    kcc_ht_put(kcc_ir_local_consts, name, keylen, (void *)box);
}
void kcc_ir_local_const_kill(const char *name) {
    if (!kcc_target || !kcc_ir_local_consts || !name) return;
    unsigned long keylen = kcc_strlen(name);
    unsigned long lv = (unsigned long)kcc_ht_get(kcc_ir_locals, name, keylen);
    unsigned long *box = (unsigned long *)kcc_ht_get(kcc_ir_local_consts, name, keylen);
    if (box && box[0] == lv) box[0] = 0;   /* no longer a manifest constant */
}

/* -- statement dispatcher -- */
void kcc_ir_build_stmt(void *s) {
    if (!s) return;
    unsigned long tag = IL(s, AST_TAG);
    if (tag == AST_COMPOUND) {
        kcc_ir_scope_enter();
        void *it = (void *)IL(s, AST_F0);
        while (it) { kcc_ir_build_stmt(it); it = (void *)IL(it, AST_F4); }
        kcc_ir_scope_leave();
    } else if (tag == AST_EXPR_STMT) {
        kcc_ir_build_expr((void *)IL(s, AST_F0));
    } else if (tag == AST_RETURN_STMT) {
        kcc_ir_build_return(s);
    } else if (tag == AST_IF_STMT) {
        kcc_ir_build_if(s);
    } else if (tag == AST_WHILE_STMT) {
        kcc_ir_build_while(s);
    } else if (tag == AST_DO_STMT) {
        kcc_ir_build_do(s);
    } else if (tag == AST_FOR_STMT) {
        kcc_ir_build_for(s);
    } else if (tag == AST_VAR_DECL) {
        kcc_ir_build_var_decl(s);
    } else if (tag == AST_BREAK_STMT) {
        kcc_ir_build_break(s);
    } else if (tag == AST_CONTINUE_STMT) {
        kcc_ir_build_continue(s);
    } else if (tag == AST_SWITCH_STMT) {
        kcc_ir_build_switch(s);
    } else if (tag == AST_LABEL_STMT) {
        void *bb = kcc_ir_label_bb((const char *)IL(s, AST_F0));
        if (bb) { kcc_ir_branch_to(bb); kcc_ir_set_bb(bb); }
        kcc_ir_build_stmt((void *)IL(s, AST_F1));
    } else if (tag == AST_GOTO_STMT) {
        void *bb = kcc_ir_label_bb((const char *)IL(s, AST_F0));
        if (bb) { kcc_ir_branch_to(bb); kcc_ir_set_bb(kcc_ir_alloc_bb()); }
    } else if (tag == AST_CASE_STMT) {
        void *bb = (void *)IL(s, AST_F2);
        if (bb) { kcc_ir_branch_to(bb); kcc_ir_set_bb(bb); }
        kcc_ir_build_stmt((void *)IL(s, AST_F1));
    } else if (tag == AST_DEFAULT_STMT) {
        void *bb = (void *)IL(s, AST_F1);
        if (bb) { kcc_ir_branch_to(bb); kcc_ir_set_bb(bb); }
        kcc_ir_build_stmt((void *)IL(s, AST_F0));
    } else if (tag == AST_ASM_STMT) {
        kcc_ir_asm_lower_operands(s);
        /* `asm goto': resolve each target label (chained off AST_F3) to its
           block and stash the block in the label node's F2, so the back end
           can expand %lN to that block's assembly label.  F0 stays the name the
           template's %l[name] matches; an inlined label carries the renamed
           resolve-name in F1, so resolution follows F1 when present. */
        for (void *l = (void *)IL(s, AST_F3); l; l = (void *)IL(l, AST_F4)) {
            const char *rn = (const char *)IL(l, AST_F1);
            if (!rn) rn = (const char *)IL(l, AST_F0);
            void *bb = kcc_ir_label_bb(rn);
            IL(l, AST_F2) = (unsigned long)bb;
        }
        void *ai = kcc_ir_alloc_instr(IR_ASM);
        IL(ai, IR_SRC1) = IL(s, AST_F0);
        IL(ai, IR_SRC2) = IL(s, AST_F1);
        IL(ai, IR_TYPE) = (unsigned long)s;
        kcc_ir_emit(ai);
    }
    /* AST_NULL_STMT and anything unhandled: nothing to emit */
}

/* -- extended-asm operand lowering -- */
void kcc_ir_asm_addr_of(void *lvalue) {
    void *u = kcc_ast_alloc(AST_UNARY_EXPR);
    IL(u, AST_F0) = TOK_AMP;
    IL(u, AST_F1) = (unsigned long)lvalue;
    IL(u, AST_F2) = 1;                            /* prefix */
    kcc_ir_build_expr(u);                         /* returns address vreg */
}

/* Does the constraint permit an immediate operand?  Besides the generic 'i'
   (any constant), 'I'/'n' (small/known integer), x86 has the letter classes
   'e' (32-bit signed const), 'J'/'K'/'L'/'M'/'N'/'O'/'Z' (specific ranges), and
   'g' (general, which also admits a constant).  A constant operand under any of
   these is rendered as an immediate; a non-constant 'g' falls through to the
   register path. */
static unsigned long kcc_asm_cons_imm(const char *c) {
    for (const char *s = c; *s; s++)
        if (*s == 'i' || *s == 'I' || *s == 'n' || *s == 'e' || *s == 'g' ||
            *s == 'J' || *s == 'K' || *s == 'L' || *s == 'M' || *s == 'N' ||
            *s == 'O' || *s == 'Z') return 1;
    return 0;
}

/* Whether the constraint also admits a general or specific integer register, so
   a constant that will not fit an x86 ALU instruction's 32-bit immediate field
   can be materialised there instead---the register alternative of `"re"'/`"ri"'. */
static unsigned long kcc_asm_cons_reg(const char *c) {
    for (const char *s = c; *s; s++)
        if (*s == 'r' || *s == 'q' || *s == 'Q' || *s == 'a' || *s == 'b' ||
            *s == 'c' || *s == 'd' || *s == 'S' || *s == 'D' || *s == 'R' ||
            *s == 'l' || *s == 'A' || *s == 'U') return 1;
    return 0;
}

/* If an asm operand's expression names a function or file-scope object (or the
   address of one), return the symbol's emit-name.  The back end renders a `%P`
   reference to such an operand as the bare symbol (so `call %P[f]` becomes
   `call f`), which is what the kernel's ALTERNATIVE and percpu templates need.
   Returns 0 for a local or non-symbolic expression, which have no linker name;
   `%P` then falls back to the operand's materialised register. */
static const char *kcc_asm_operand_lval(void *lv);

/* A string-literal inline-asm operand (through casts/parens), or 0. */
static void *kcc_asm_operand_strlit(void *expr) {
    if (!expr) return 0;
    unsigned long tag = IL(expr, AST_TAG);
    while (tag == AST_PAREN_EXPR) { expr = (void *)IL(expr, AST_F0); if (!expr) return 0; tag = IL(expr, AST_TAG); }
    if (tag == AST_CAST_EXPR) return kcc_asm_operand_strlit((void *)IL(expr, AST_F1));
    if (tag == AST_STR_LIT) return expr;
    return 0;
}

/* Constant byte offset accumulated while resolving an inline-asm symbol operand
   like `&arr[3]' or `&s.field': the operand renders as `name+offset'. */
static long kcc_asm_sym_off = 0;

static const char *kcc_asm_operand_symname(void *expr) {
    if (!expr) return 0;
    unsigned long tag = IL(expr, AST_TAG);
    while (tag == AST_PAREN_EXPR) { expr = (void *)IL(expr, AST_F0); if (!expr) return 0; tag = IL(expr, AST_TAG); }
    if (tag == AST_CAST_EXPR) return kcc_asm_operand_symname((void *)IL(expr, AST_F1));
    if (tag == AST_UNARY_EXPR && IL(expr, AST_F0) == TOK_AMP)
        return kcc_asm_operand_lval((void *)IL(expr, AST_F1));      /* &lvalue */
    if (tag == AST_BINARY_EXPR) {                                    /* sym +/- const */
        unsigned long op = IL(expr, AST_F0);
        void *L = (void *)IL(expr, AST_F1), *R = (void *)IL(expr, AST_F2);
        if (op == TOK_PLUS || op == TOK_MINUS) {
            const char *s = kcc_asm_operand_symname(L);
            if (s && kcc_expr_is_ice(R)) {
                long o = (long)kcc_eval_const_int(R);
                kcc_asm_sym_off += (op == TOK_PLUS) ? o : -o;
                return s;
            }
            if (op == TOK_PLUS) {
                s = kcc_asm_operand_symname(R);
                if (s && kcc_expr_is_ice(L)) { kcc_asm_sym_off += (long)kcc_eval_const_int(L); return s; }
            }
        }
        return 0;
    }
    if (tag != AST_IDENT_EXPR) return 0;
    char *name = (char *)IL(expr, AST_F0);
    if (!name) return 0;
    unsigned long keylen = kcc_strlen(name);
    if (kcc_ir_locals && kcc_ht_get(kcc_ir_locals, name, keylen)) return 0;  /* a local */
    if (kcc_ir_statics) {
        void *mangled = kcc_ht_get(kcc_ir_statics, name, keylen);
        if (mangled) return (const char *)mangled;                 /* static: mangled name */
    }
    void *sym = kcc_symtab_lookup(name, keylen);
    if (sym && IL(sym, SYM_KIND) == SYM_ENUM_CONST) return 0;       /* an enum const is a value */
    return name;                                                    /* file-scope function/object */
}

/* Resolve the base symbol (and add the constant byte offset) of an lvalue whose
   address is taken: an object `x', an array element `a[k]' (k an ICE), or a
   struct member `s.field'.  Nested forms compose---the kernel's cpu-feature byte
   is `&((char *)boot_cpu_data.x86_capability)[bit >> 3]'. */
static const char *kcc_asm_operand_lval(void *lv) {
    if (!lv) return 0;
    unsigned long tag = IL(lv, AST_TAG);
    while (tag == AST_PAREN_EXPR) { lv = (void *)IL(lv, AST_F0); if (!lv) return 0; tag = IL(lv, AST_TAG); }
    if (tag == AST_CAST_EXPR) return kcc_asm_operand_lval((void *)IL(lv, AST_F1));
    if (tag == AST_IDENT_EXPR) return kcc_asm_operand_symname(lv);
    if (tag == AST_SUBSCRIPT) {
        void *idx = (void *)IL(lv, AST_F1);
        if (!kcc_expr_is_ice(idx)) return 0;
        void *et = (void *)IL(lv, AST_F3);            /* the element's (result) type */
        unsigned long esz = et ? kcc_type_layout(et) : 1;
        kcc_asm_sym_off += (long)kcc_eval_const_int(idx) * (long)esz;
        return kcc_asm_operand_lval((void *)IL(lv, AST_F0));
    }
    if (tag == AST_MEMBER) {
        void *obj = (void *)IL(lv, AST_F0);
        void *st = (void *)IL(obj, AST_F3);
        if (st && IL(st, TY_KIND) == TY_PTR) st = (void *)IL(st, TY_F0);
        if (st && (IL(st, TY_KIND) == TY_STRUCT || IL(st, TY_KIND) == TY_UNION)) {
            kcc_type_layout(st);
            struct kcc_member_res mr = kcc_type_find_member(st, (const char *)IL(lv, AST_F1));
            if (mr.field) kcc_asm_sym_off += (long)mr.off;
        }
        /* `s.m': the address is &s + offset.  `p->m': the address is p (a pointer
           value---a constant only when p is itself `&sym') + offset; the kernel's
           static_branch takes `&(&key)->key'. */
        if (IL(lv, AST_F2)) return kcc_asm_operand_symname(obj);
        return kcc_asm_operand_lval(obj);
    }
    return 0;
}

/* If an inline-asm operand expression (through casts/parens) names a scalar
   local that was recorded as a compile-time constant, store its value in *out
   and return 1.  Matched on the live `lv' so a stale box left by a departed
   inner scope or a prior function never folds.  x86 only. */
static int kcc_asm_operand_local_const(void *expr, unsigned long *out) {
    if (!kcc_target || !kcc_ir_local_consts || !expr) return 0;
    unsigned long tag = IL(expr, AST_TAG);
    if (tag == AST_PAREN_EXPR) return kcc_asm_operand_local_const((void *)IL(expr, AST_F0), out);
    if (tag == AST_CAST_EXPR) return kcc_asm_operand_local_const((void *)IL(expr, AST_F1), out);
    if (tag != AST_IDENT_EXPR) return 0;
    char *name = (char *)IL(expr, AST_F0);
    if (!name) return 0;
    unsigned long keylen = kcc_strlen(name);
    unsigned long lv = (unsigned long)kcc_ht_get(kcc_ir_locals, name, keylen);
    unsigned long *box = (unsigned long *)kcc_ht_get(kcc_ir_local_consts, name, keylen);
    if (box && lv && box[0] == lv) { *out = box[1]; return 1; }
    return 0;
}

void kcc_ir_asm_lower_operands(void *as) {
    void *op = (void *)IL(as, AST_F2);
    while (op) {
        void *expr = (void *)IL(op, AST_F2);
        unsigned long size = 8;
        void *ety = (void *)IL(expr, AST_F3);
        if (ety && IL(ety, TY_SIZE)) size = IL(ety, TY_SIZE);
        char *cons = (char *)IL(op, AST_F0);
        char c = cons[0];
        char cls = (c == '=' || c == '+') ? cons[1] : c;
        kcc_asm_sym_off = 0;
        const char *sym = kcc_target ? kcc_asm_operand_symname(expr) : 0;
        long symoff = kcc_asm_sym_off;
        void *strlit = kcc_target ? kcc_asm_operand_strlit(expr) : 0;
        /* An `"i"'-class immediate value: a genuine integer constant expression,
           or a scalar local recorded as const-initialised (the kernel's
           `__auto_type __flags = ...' behind WARN's `"i"(flags)'). */
        unsigned long asm_imm = 0;
        int asm_is_imm = 0;
        if (kcc_target && c != '=' && c != '+' && kcc_asm_cons_imm(cons)) {
            if (kcc_expr_is_ice(expr)) { asm_imm = kcc_eval_const_int(expr); asm_is_imm = 1; }
            else if (kcc_asm_operand_local_const(expr, &asm_imm)) asm_is_imm = 1;
        }
        /* An x86 ALU immediate encodes at most a sign-extended 32-bit field.  A
           wider constant---the percpu refcount's PERCPU_COUNT_BIAS = 1UL<<63 fed
           to `addq $val,mem'---does not fit; when the constraint also allows a
           register (`"re"'/`"ri"'), hand it to the register path so it is loaded
           with `movabsq' first, exactly as GCC picks the register alternative. */
        if (asm_is_imm && kcc_asm_cons_reg(cons)) {
            long sv = (long)asm_imm;
            if (sv < (long)0xFFFFFFFF80000000UL || sv > (long)0x7FFFFFFFUL)
                asm_is_imm = 0;
        }
        if (strlit && c != '=' && c != '+' && kcc_asm_cons_imm(cons)) {
            /* string-literal `"i"'/`"s"' operand: the back end emits the string
               to .rodata and references its label---the kernel's WARN/BUG entries
               store `"i"(__FILE__)' as `.long %c0 - .' in __bug_table.  Stash the
               bytes/length (COL/F3) under a string marker (F2 bit 61); no
               register is materialised. */
            IL(op, AST_COL) = IL(strlit, AST_F0);
            IL(op, AST_F3) = IL(strlit, AST_F1);
            IL(op, AST_F2) = (1UL << 61);
        } else if (asm_is_imm) {
            /* x86 immediate operand: a constant input the back end renders as
               $value.  Only on x86 (ARM64's asm path materialises it in a
               register instead); a matching register alternative ("Ir") on a
               non-constant value falls through to the register path below.  The
               value goes in F3, NOT F1: F1 must stay the operand's `[name]` so a
               `%[name]` reference (the kernel's `%[bitnum]`) still resolves---the
               marker bit alone tells the back end this operand is a constant. */
            IL(op, AST_F2) = (1UL << 63);        /* immediate marker */
            IL(op, AST_F3) = asm_imm;
        } else if (cls == 'm') {
            /* memory operand ("m"/"=m"/"+m"): the asm accesses the object
               through its address, so we only need that address---no register
               value is loaded and nothing is stored back.  The address goes in
               AST_F3, as for an output, and the back end tells the two apart by
               the constraint spelling. */
            void *u = kcc_ast_alloc(AST_UNARY_EXPR);
            IL(u, AST_F0) = TOK_AMP;
            IL(u, AST_F1) = IL(op, AST_F2);
            IL(u, AST_F2) = 1;
            unsigned long addr = kcc_ir_build_expr(u);
            IL(op, AST_F3) = ((addr + 1) | (size << 32));
            IL(op, AST_F2) = 0;
        } else if (c == '=') {
            /* output: address only. asm_addr_of returns the vreg via build_expr */
            void *u = kcc_ast_alloc(AST_UNARY_EXPR);
            IL(u, AST_F0) = TOK_AMP;
            IL(u, AST_F1) = IL(op, AST_F2);
            IL(u, AST_F2) = 1;
            unsigned long addr = kcc_ir_build_expr(u);
            IL(op, AST_F3) = ((addr + 1) | (size << 32));
            IL(op, AST_F2) = 0;
        } else if (c == '+') {
            unsigned long val = kcc_ir_build_expr((void *)IL(op, AST_F2));
            unsigned long vhalf = (val + 1) | (size << 32);
            void *u = kcc_ast_alloc(AST_UNARY_EXPR);
            IL(u, AST_F0) = TOK_AMP;
            IL(u, AST_F1) = IL(op, AST_F2);
            IL(u, AST_F2) = 1;
            unsigned long addr = kcc_ir_build_expr(u);
            IL(op, AST_F3) = ((addr + 1) | (size << 32));
            IL(op, AST_F2) = vhalf;
        } else {
            unsigned long val = kcc_ir_build_expr((void *)IL(op, AST_F2));
            IL(op, AST_F2) = ((val + 1) | (size << 32));
            IL(op, AST_F3) = 0;
        }
        /* Record a symbolic operand's emit-name for `%P` rendering, unless it
           took the immediate path (F2 bit 63).  The name goes in the unused COL
           field (the emitter never reads an operand's source column) with F2 bit
           62 flagging its presence---F1 must stay the operand's `[name]`, which
           the back end matches to resolve a `%[name]` reference. */
        if (sym && !((IL(op, AST_F2) >> 63) & 1)) {
            IL(op, AST_COL) = (unsigned long)sym;
            IL(op, AST_F2) = IL(op, AST_F2) | (1UL << 62);
            IL(op, AST_F3) = (unsigned long)symoff;   /* byte offset for name+off */
        }
        op = (void *)IL(op, AST_F4);
    }
}

/* -- return -- */
void kcc_ir_build_return(void *rs) {
    void *e = (void *)IL(rs, AST_F0);
    if (!e) {
        void *r = kcc_ir_alloc_instr(IR_RET);
        IL(r, IR_TYPE) = (unsigned long)kcc_type_void;
        kcc_ir_emit(r);
        goto terminate;
    }
    void *rettype = (void *)IL(kcc_ir_cur_func, IRF_RETTYPE);
    if (rettype) {
        unsigned long rk = IL(rettype, TY_KIND);
        if (rk == TY_STRUCT || rk == TY_UNION) {
            unsigned long src = kcc_ir_build_struct_addr(e);
            void *rty = (void *)IL(kcc_ir_cur_func, IRF_RETTYPE);
            if (kcc_ir_classify_type(rty) == 4) {
                unsigned long sz = kcc_type_layout(rty);
                /* hidden sret pointer = last reserved parameter vreg */
                void *fn = kcc_ir_cur_func;
                unsigned long np = IL(fn, IRF_PARAMS);
                void *cls = (void *)IL(fn, IRF_PARAM_CLS);
                unsigned long w = 0, ix = 0;
                while (ix < np) {
                    w += 1;
                    if (cls && IL(cls, ix * 8) == 3) w += 1;
                    ix++;
                }
                unsigned long dst = w - 1;
                kcc_ir_emit_struct_copy(src, dst, sz);
                void *r = kcc_ir_alloc_instr(IR_RET);
                if (kcc_target) {
                    /* x86-64 SysV returns a memory-class aggregate by placing
                       its address back in %rax; the caller reads the result
                       through that register, so the callee must hand the hidden
                       sret pointer (the last parameter vreg) back---not merely
                       write through it.  A non-void RET carrying that vreg makes
                       the emitter load it into %rax.  (AArch64's caller reads its
                       own x8 buffer, so its RET stays void: unchanged.) */
                    IL(r, IR_TYPE) = (unsigned long)rty;
                    IL(r, IR_SRC1) = dst;
                } else {
                    IL(r, IR_TYPE) = (unsigned long)kcc_type_void;
                }
                kcc_ir_emit(r);
            } else {
                void *r = kcc_ir_alloc_instr(IR_RET);
                IL(r, IR_TYPE) = (unsigned long)rty;
                IL(r, IR_SRC1) = src;
                kcc_ir_emit(r);
            }
            goto terminate;
        }
    }
    /* scalar return */
    {
        unsigned long v = kcc_ir_build_expr(e);
        void *to = (void *)IL(kcc_ir_cur_func, IRF_RETTYPE);
        void *from = (void *)IL(e, AST_F3);
        if (to && from) v = kcc_ir_convert(v, from, to);
        void *r = kcc_ir_alloc_instr(IR_RET);
        IL(r, IR_TYPE) = (unsigned long)IL(kcc_ir_cur_func, IRF_RETTYPE);
        IL(r, IR_SRC1) = v;
        kcc_ir_emit(r);
    }
terminate: {
    void *cur = kcc_ir_cur_bb;
    if (cur) IL(cur, BB_FLAGS) = IL(cur, BB_FLAGS) | BB_FLAG_TERMINATED;
    }
}
@}

\section{Expressions}

The expression dispatcher returns the vreg holding each subexpression's value,
so builders compose by feeding one result into another's operand slot.  This
first group covers the dispatcher itself, the literals, the int/float
conversions the assignment and return paths lean on, AAPCS64 parameter
classification, \texttt{sizeof}/\texttt{\_Alignof}, the access-width helpers, and
array/pointer subscripting.

@l c
@d Selfhost: ir exprs @{
unsigned long kcc_ir_build_expr(void *e) {
    if (!e) return 0;
    unsigned long tag = IL(e, AST_TAG);
    if (tag == AST_INT_LIT) return kcc_ir_build_int_lit(e);
    if (tag == AST_FLOAT_LIT) return kcc_ir_build_float_lit(e);
    if (tag == AST_CHAR_LIT) return kcc_ir_build_int_lit(e);
    if (tag == AST_IDENT_EXPR) return kcc_ir_build_ident(e);
    if (tag == AST_BINARY_EXPR) return kcc_ir_build_binary(e);
    if (tag == AST_UNARY_EXPR) return kcc_ir_build_unary(e);
    if (tag == AST_ASSIGN_EXPR) return kcc_ir_build_assign(e);
    if (tag == AST_CALL_EXPR) return kcc_ir_build_call(e);
    if (tag == AST_CAST_EXPR) return kcc_ir_build_cast(e);
    if (tag == AST_COMMA_EXPR) {
        kcc_ir_build_expr((void *)IL(e, AST_F0));
        return kcc_ir_build_expr((void *)IL(e, AST_F1));
    }
    if (tag == AST_COND_EXPR) return kcc_ir_build_cond_expr(e);
    if (tag == AST_PAREN_EXPR) return kcc_ir_build_expr((void *)IL(e, AST_F0));
    if (tag == AST_STR_LIT) return kcc_ir_build_string_lit(e);
    if (tag == AST_SIZEOF_EXPR) return kcc_ir_build_sizeof(e);
    if (tag == AST_ALIGNOF_EXPR) return kcc_ir_build_alignof(e);
    if (tag == AST_SUBSCRIPT) return kcc_ir_build_subscript(e);
    if (tag == AST_MEMBER) return kcc_ir_build_member(e);
    if (tag == AST_VA_ARG) return kcc_ir_build_va_arg(e);
    if (tag == AST_TYPES_COMPAT) return kcc_ir_emit_const(kcc_eval_const_int(e));
    if (tag == AST_GENERIC) return kcc_ir_build_expr((void *)IL(e, AST_F2));
    if (tag == AST_COMPOUND_LIT) {
        unsigned long addr = kcc_ir_build_compound_lit(e);
        void *ty = kcc_sema_resolve_type((void *)IL(e, AST_F0));
        if (ty) {
            unsigned long k = IL(ty, TY_KIND);
            if (k == TY_STRUCT || k == TY_UNION || k == TY_ARRAY) return addr;
            unsigned long sz = kcc_ir_store_width(ty);
            return kcc_ir_emit_load(addr, sz);
        }
        return addr;
    }
    if (tag == AST_STMT_EXPR) return kcc_ir_build_stmt_expr(e);
    return 0;
}

unsigned long kcc_ir_build_stmt_expr(void *se) {
    void *comp = (void *)IL(se, AST_F0);
    if (!comp) return 0;
    kcc_ir_scope_enter();
    /* Register the block's labels: the function-level prescan does not descend
       into a statement expression, so a goto inside it (the kernel FIND_*_BIT
       macros jump to `out:') would otherwise not resolve to the label's block. */
    kcc_ir_prescan_labels(comp);
    void *it = (void *)IL(comp, AST_F0);
    unsigned long val = 0;
    if (!it) { kcc_ir_scope_leave(); return 0; }
    while (it) {
        void *next = (void *)IL(it, AST_F4);
        if (!next) {
            /* The final item carries the statement-expression's value.  Peel
               off any labels first---emitting each label's block so a goto can
               still reach it---so a `label: expr;' tail (as the `out:' target
               inside the kernel's FIND_*_BIT macros) yields its expression's
               value rather than being discarded. */
            while (it && IL(it, AST_TAG) == AST_LABEL_STMT) {
                void *bb = kcc_ir_label_bb((const char *)IL(it, AST_F0));
                if (bb) { kcc_ir_branch_to(bb); kcc_ir_set_bb(bb); }
                it = (void *)IL(it, AST_F1);
            }
            if (it && IL(it, AST_TAG) == AST_EXPR_STMT)
                val = kcc_ir_build_expr((void *)IL(it, AST_F0));
            else if (it)
                kcc_ir_build_stmt(it);
            break;
        }
        kcc_ir_build_stmt(it);
        it = next;
    }
    kcc_ir_scope_leave();
    return val;
}

unsigned long kcc_ir_build_int_lit(void *lit) {
    unsigned long value = IL(lit, AST_F0);
    void *inst = kcc_ir_alloc_instr(IR_CONST);
    void *ty = (void *)IL(lit, AST_F3);
    if ((unsigned long)ty < 0x1000) ty = kcc_type_int_s;
    IL(inst, IR_TYPE) = (unsigned long)ty;
    IL(inst, IR_SRC1) = value;
    unsigned long v = kcc_ir_next_vreg();
    IL(inst, IR_DEST) = v;
    kcc_ir_emit(inst);
    return v;
}

unsigned long kcc_ir_build_float_lit(void *lit) {
    unsigned long bits = IL(lit, AST_F0);
    void *inst = kcc_ir_alloc_instr(IR_CONST);
    IL(inst, IR_TYPE) = (unsigned long)kcc_type_double;
    IL(inst, IR_SRC1) = bits;
    unsigned long v = kcc_ir_next_vreg();
    IL(inst, IR_DEST) = v;
    kcc_ir_emit(inst);
    return v;
}

unsigned long kcc_ir_type_is_fp(void *ty) {
    if (!ty) return 0;
    unsigned long k = IL(ty, TY_KIND);
    if (k == TY_FLOAT || k == TY_DOUBLE) return 1;
    return 0;
}

unsigned long kcc_ir_classify_type(void *ty) {
    if (!ty) return 0;
    if (kcc_ir_type_is_fp(ty)) return 1;
    unsigned long k = IL(ty, TY_KIND);
    if (k == TY_STRUCT || k == TY_UNION) {
        unsigned long sz = kcc_type_layout(ty);
        if (sz <= 8) return 2;
        if (sz <= 16) return 3;
        return 4;
    }
    return 0;
}

unsigned long kcc_ir_emit_sitofp(unsigned long src) {
    void *inst = kcc_ir_alloc_instr(IR_SITOFP);
    IL(inst, IR_TYPE) = (unsigned long)kcc_type_double;
    IL(inst, IR_SRC1) = src;
    unsigned long v = kcc_ir_next_vreg();
    IL(inst, IR_DEST) = v;
    kcc_ir_emit(inst);
    return v;
}

unsigned long kcc_ir_emit_uitofp(unsigned long src) {
    void *inst = kcc_ir_alloc_instr(IR_UITOFP);
    IL(inst, IR_TYPE) = (unsigned long)kcc_type_double;
    IL(inst, IR_SRC1) = src;
    unsigned long v = kcc_ir_next_vreg();
    IL(inst, IR_DEST) = v;
    kcc_ir_emit(inst);
    return v;
}

unsigned long kcc_ir_emit_int_to_fp(unsigned long src, void *it) {
    if (it && kcc_sema_int_signedness(it) == 0) return kcc_ir_emit_uitofp(src);
    return kcc_ir_emit_sitofp(src);
}

unsigned long kcc_ir_emit_fpround(unsigned long src) {
    void *inst = kcc_ir_alloc_instr(IR_FPROUND);
    IL(inst, IR_TYPE) = (unsigned long)kcc_type_float;
    IL(inst, IR_SRC1) = src;
    unsigned long v = kcc_ir_next_vreg();
    IL(inst, IR_DEST) = v;
    kcc_ir_emit(inst);
    return v;
}

unsigned long kcc_ir_emit_fptosi(unsigned long src) {
    void *inst = kcc_ir_alloc_instr(IR_FPTOSI);
    IL(inst, IR_TYPE) = (unsigned long)kcc_type_int_s;
    IL(inst, IR_SRC1) = src;
    unsigned long v = kcc_ir_next_vreg();
    IL(inst, IR_DEST) = v;
    kcc_ir_emit(inst);
    return v;
}

unsigned long kcc_ir_convert(unsigned long vreg, void *from, void *to) {
    unsigned long to_fp = kcc_ir_type_is_fp(to);
    unsigned long from_fp = kcc_ir_type_is_fp(from);
    if (from_fp != to_fp) {
        if (to_fp) vreg = kcc_ir_emit_int_to_fp(vreg, from);
        else vreg = kcc_ir_emit_fptosi(vreg);
    }
    /* to float: round to single precision */
    if (to && IL(to, TY_KIND) == TY_FLOAT) vreg = kcc_ir_emit_fpround(vreg);
    /* to _Bool: normalise non-zero to 1 */
    if (to && IL(to, TY_KIND) == TY_BOOL) return kcc_ir_emit_bool_norm(vreg);
    /* integer-to-integer implicit conversion: re-canonicalise width/signedness */
    if (to) {
        unsigned long tk = IL(to, TY_KIND);
        if (tk >= TY_BOOL && tk <= TY_LLONG && from) {
            unsigned long fk = IL(from, TY_KIND);
            if (fk >= TY_BOOL && fk <= TY_LLONG) {
                unsigned long ts = IL(to, TY_SIZE);
                unsigned long fs = IL(from, TY_SIZE);
                unsigned long resize = 0;
                if (ts != fs) resize = 1;
                else if (ts < 8 && IL(to, TY_F0) != IL(from, TY_F0)) resize = 1;
                if (resize) {
                    unsigned long op = IL(to, TY_F0) ? IR_SEXT : IR_ZEXT;
                    void *inst = kcc_ir_alloc_instr(op);
                    IL(inst, IR_TYPE) = (unsigned long)to;
                    IL(inst, IR_SRC1) = vreg;
                    IL(inst, IR_SRC2) = IL(to, TY_SIZE);
                    vreg = kcc_ir_next_vreg();
                    IL(inst, IR_DEST) = vreg;
                    kcc_ir_emit(inst);
                }
            }
        }
    }
    return vreg;
}

void kcc_ir_fill_param_classes(void *fn, void *fd) {
    unsigned long np = IL(fn, IRF_PARAMS);
    if (!np) return;
    void *arr = kcc_arena_alloc(np * 8);
    IL(fn, IRF_PARAM_CLS) = (unsigned long)arr;
    unsigned long i = 0;
    while (i < np) { IL(arr, i * 8) = 0; i++; }
    void *p = (void *)(IL(fd, AST_F2) & ~3UL);
    i = 0;
    while (p) {
        if (IL(p, AST_TAG) == AST_PARAM_DECL && IL(p, AST_F1)) {
            void *t = kcc_sema_resolve_type((void *)IL(p, AST_F0));
            t = kcc_type_param_adjust(t);
            IL(arr, i * 8) = kcc_ir_classify_type(t);
            i++;
        }
        p = (void *)IL(p, AST_F4);
    }
    /* >16B struct return: trailing hidden x8 pointer (class 5) */
    if (kcc_ir_classify_type((void *)IL(fn, IRF_RETTYPE)) == 4)
        IL(arr, (np - 1) * 8) = 5;
}

unsigned long kcc_ir_build_sizeof(void *e) {
    void *ty;
    if (IL(e, AST_F1))                            /* sizeof(type-name) */
        ty = kcc_sema_resolve_type((void *)IL(e, AST_F0));
    else                                          /* sizeof expr: operand's type */
        ty = (void *)IL((void *)IL(e, AST_F0), AST_F3);
    unsigned long sz = kcc_type_layout(ty);
    void *inst = kcc_ir_alloc_instr(IR_CONST);
    IL(inst, IR_TYPE) = (unsigned long)kcc_type_long_u;
    IL(inst, IR_SRC1) = sz;
    unsigned long v = kcc_ir_next_vreg();
    IL(inst, IR_DEST) = v;
    kcc_ir_emit(inst);
    return v;
}

unsigned long kcc_ir_build_alignof(void *e) {
    void *ty;
    if (IL(e, AST_F1))                            /* _Alignof(type-name) */
        ty = kcc_sema_resolve_type((void *)IL(e, AST_F0));
    else                                          /* __alignof__ expr: operand's type */
        ty = (void *)IL((void *)IL(e, AST_F0), AST_F3);
    kcc_type_layout(ty);
    unsigned long al = IL(ty, TY_ALIGN);
    void *inst = kcc_ir_alloc_instr(IR_CONST);
    IL(inst, IR_TYPE) = (unsigned long)kcc_type_long_u;
    IL(inst, IR_SRC1) = al;
    unsigned long v = kcc_ir_next_vreg();
    IL(inst, IR_DEST) = v;
    kcc_ir_emit(inst);
    return v;
}

unsigned long kcc_ir_type_slots(void *ty) {
    if (!ty) return 1;
    unsigned long sz = kcc_type_layout(ty);
    if (sz <= 8) return 1;
    return (sz + 7) >> 3;
}

unsigned long kcc_ir_store_width(void *ty) {
    if (!ty) return 0;
    unsigned long k = IL(ty, TY_KIND);
    if (k == TY_FLOAT) return 8;
    if (k == TY_BOOL) return 1;
    if (k != TY_ENUM) {
        if (k < TY_CHAR) return 0;
        if (k > TY_LLONG) return 0;
    }
    unsigned long sz = IL(ty, TY_SIZE);
    if (sz == 4 || sz == 2 || sz == 1) return sz;
    return 0;
}

unsigned long kcc_ir_load_width(void *ty) {
    if (!ty) return 0;
    unsigned long k = IL(ty, TY_KIND);
    unsigned long sz = IL(ty, TY_SIZE);
    if (k == TY_FLOAT) return 8;
    unsigned long signd;
    if (k == TY_BOOL) signd = 0;
    else if (k == TY_ENUM) signd = 1;
    else {
        if (k < TY_CHAR) return 0;
        if (k > TY_LLONG) return 0;
        signd = IL(ty, TY_F0) ? 1 : 0;
    }
    if (signd) {
        if (sz == 1) return 5;
        if (sz == 2) return 6;
        if (sz == 4) return 7;
        return 0;
    }
    if (sz == 1) return 1;
    if (sz == 2) return 2;
    if (sz == 4) return 4;
    return 0;
}
@}

@d Selfhost: ir exprs @{
/* Element address for e[i], shared by the read and write paths.  The gotos
   mirror the assembly's labels: `index` computes base+scaled-index via GEP,
   `ptr` loads a pointer then adds a scaled index. */
unsigned long kcc_ir_build_subscript_addr(void *sub) {
    unsigned long base_addr = 0;
    void *base = (void *)IL(sub, AST_F0);
    unsigned long btag = IL(base, AST_TAG);
    if (btag == AST_SUBSCRIPT) {
        void *it = (void *)IL(base, AST_F3);      /* inner subscript's type */
        if (it && IL(it, TY_KIND) != TY_ARRAY)
            base_addr = kcc_ir_build_expr(base);          /* pointer element: load */
        else
            base_addr = kcc_ir_build_subscript_addr(base); /* sub-array address */
        goto index;
    }
    if (btag == AST_MEMBER) {
        void *mt = (void *)IL(base, AST_F3);
        if (mt && IL(mt, TY_KIND) == TY_ARRAY) {
            base_addr = kcc_ir_build_member_addr(base);
            goto index;
        }
        goto ptr;
    }
    if (btag == AST_IDENT_EXPR) {
        char *name = (char *)IL(base, AST_F0);
        unsigned long v = (unsigned long)kcc_ht_get(kcc_ir_locals, name, kcc_strlen(name));
        if (v) {
            if (v & 0x8000000000000000UL) goto ptr;       /* pointer local */
            base_addr = v - 1;                            /* array/scalar alloca */
            goto index;
        }
    }
    /* expr fallback: an ident not in locals (static/global array), else ptr */
    base = (void *)IL(sub, AST_F0);
    if (IL(base, AST_TAG) != AST_IDENT_EXPR) goto ptr;
    {
        char *name = (char *)IL(base, AST_F0);
        unsigned long namelen = kcc_strlen(name);
        if (kcc_ir_statics) {
            void *mangled = kcc_ht_get(kcc_ir_statics, name, namelen);
            if (mangled) {
                void *stt = kcc_ir_static_types
                          ? kcc_ht_get(kcc_ir_static_types, name, namelen) : 0;
                if (!stt || IL(stt, TY_KIND) != TY_ARRAY) goto ptr;
                void *g = kcc_ir_alloc_instr(IR_GLOBAL_REF);
                IL(g, IR_SRC1) = (unsigned long)mangled;
                IL(g, IR_TYPE) = (unsigned long)kcc_type_int_s;
                base_addr = kcc_ir_next_vreg();
                IL(g, IR_DEST) = base_addr;
                kcc_ir_emit(g);
                goto index;
            }
        }
        void *sym = kcc_symtab_lookup(name, namelen);
        if (!sym) goto ptr;
        void *st = (void *)IL(sym, SYM_TYPE);
        if (!st || IL(st, TY_KIND) != TY_ARRAY) goto ptr;
        void *g = kcc_ir_alloc_instr(IR_GLOBAL_REF);
        IL(g, IR_SRC1) = (unsigned long)name;
        IL(g, IR_TYPE) = (unsigned long)kcc_type_int_s;
        base_addr = kcc_ir_next_vreg();
        IL(g, IR_DEST) = base_addr;
        kcc_ir_emit(g);
        goto index;
    }
index: {
    unsigned long idx = kcc_ir_build_expr((void *)IL(sub, AST_F1));
    void *et = (void *)IL(sub, AST_F3);           /* element type */
    if (et) {
        unsigned long esz = kcc_type_layout(et);
        if (esz > 1) {
            void *c = kcc_ir_alloc_instr(IR_CONST);
            IL(c, IR_TYPE) = (unsigned long)kcc_type_int_s;
            IL(c, IR_SRC1) = esz;
            unsigned long cv = kcc_ir_next_vreg();
            IL(c, IR_DEST) = cv;
            kcc_ir_emit(c);
            void *m = kcc_ir_alloc_instr(IR_MUL);
            IL(m, IR_TYPE) = (unsigned long)kcc_type_int_s;
            IL(m, IR_SRC1) = idx;
            IL(m, IR_SRC2) = cv;
            idx = kcc_ir_next_vreg();
            IL(m, IR_DEST) = idx;
            kcc_ir_emit(m);
        }
    }
    void *gep = kcc_ir_alloc_instr(IR_GEP);
    IL(gep, IR_TYPE) = (unsigned long)kcc_type_int_s;
    IL(gep, IR_SRC1) = base_addr;
    IL(gep, IR_SRC2) = idx;
    unsigned long gv = kcc_ir_next_vreg();
    IL(gep, IR_DEST) = gv;
    kcc_ir_emit(gep);
    return gv;
}
ptr: {
    unsigned long pv = kcc_ir_build_expr((void *)IL(sub, AST_F0));
    unsigned long idx = kcc_ir_build_expr((void *)IL(sub, AST_F1));
    void *pt = (void *)IL((void *)IL(sub, AST_F0), AST_F3);  /* base's TY_PTR */
    void *pointee = pt ? (void *)IL(pt, TY_F0) : 0;
    if (pointee) {
        unsigned long psz = kcc_type_layout(pointee);
        if (psz > 1) {
            void *c = kcc_ir_alloc_instr(IR_CONST);
            IL(c, IR_TYPE) = (unsigned long)kcc_type_int_s;
            IL(c, IR_SRC1) = psz;
            unsigned long cv = kcc_ir_next_vreg();
            IL(c, IR_DEST) = cv;
            kcc_ir_emit(c);
            void *m = kcc_ir_alloc_instr(IR_MUL);
            IL(m, IR_TYPE) = (unsigned long)kcc_type_int_s;
            IL(m, IR_SRC1) = idx;
            IL(m, IR_SRC2) = cv;
            idx = kcc_ir_next_vreg();
            IL(m, IR_DEST) = idx;
            kcc_ir_emit(m);
        }
    }
    void *add = kcc_ir_alloc_instr(IR_ADD);
    IL(add, IR_TYPE) = (unsigned long)kcc_type_int_s;
    IL(add, IR_SRC1) = pv;
    IL(add, IR_SRC2) = idx;
    unsigned long av = kcc_ir_next_vreg();
    IL(add, IR_DEST) = av;
    kcc_ir_emit(add);
    return av;
}
}

unsigned long kcc_ir_build_subscript(void *sub) {
    unsigned long addr = kcc_ir_build_subscript_addr(sub);
    void *et = (void *)IL(sub, AST_F3);           /* element type */
    if ((unsigned long)et >= 0x1000) {
        unsigned long k = IL(et, TY_KIND);
        if (k == TY_ARRAY || k == TY_FUNC) return addr;  /* array/func decay */
    }
    unsigned long width = kcc_ir_load_width(et);
    void *lty;
    if ((unsigned long)et >= 0x1000 && (IL(et, TY_QUALS) & 2)) lty = et;
    else lty = kcc_type_int_s;
    void *ld = kcc_ir_alloc_instr(IR_LOAD);
    IL(ld, IR_TYPE) = (unsigned long)lty;
    IL(ld, IR_SRC1) = addr;
    IL(ld, IR_SRC2) = width;
    unsigned long v = kcc_ir_next_vreg();
    IL(ld, IR_DEST) = v;
    kcc_ir_emit(ld);
    return v;
}
@}

\section{Member Access and Bit-fields}

Member address resolution (shared by reads and writes) peels parentheses, finds
the object's base address (loading through a pointer for arrow access), then
adds the field's byte offset via \texttt{kcc\_type\_find\_member}.  A bit-field
is synthesised from shifts and masks; a \texttt{volatile} bit-field carries a
volatile-qualified container type so the optimizer preserves every access.

@l c
@d Selfhost: ir exprs @{
unsigned long kcc_ir_build_member_addr(void *m) {
    unsigned long base_addr = 0;
    /* parentheses are transparent: peel them, rewriting the object in place */
    void *obj = (void *)IL(m, AST_F0);
    while (obj && IL(obj, AST_TAG) == AST_PAREN_EXPR) {
        obj = (void *)IL(obj, AST_F0);
        IL(m, AST_F0) = (unsigned long)obj;
    }
    obj = (void *)IL(m, AST_F0);
    if (IL(obj, AST_TAG) == AST_IDENT_EXPR) {
        char *name = (char *)IL(obj, AST_F0);
        unsigned long v = (unsigned long)kcc_ht_get(kcc_ir_locals, name, kcc_strlen(name));
        if (v) {
            unsigned long arrow = IL(m, AST_F2);
            if (arrow && (v & 0x8000000000000000UL)) {
                unsigned long alloca = (v & ~0x8000000000000000UL) - 1;
                void *ld = kcc_ir_alloc_instr(IR_LOAD);
                IL(ld, IR_TYPE) = (unsigned long)kcc_type_int_s;
                IL(ld, IR_SRC1) = alloca;
                base_addr = kcc_ir_next_vreg();
                IL(ld, IR_DEST) = base_addr;
                kcc_ir_emit(ld);
            } else {
                base_addr = (v & ~0x8000000000000000UL) - 1;
            }
            goto find_index;
        }
        /* global struct */
        void *g = kcc_ir_alloc_instr(IR_GLOBAL_REF);
        IL(g, IR_SRC1) = (unsigned long)name;
        IL(g, IR_TYPE) = (unsigned long)kcc_type_int_s;
        base_addr = kcc_ir_next_vreg();
        IL(g, IR_DEST) = base_addr;
        kcc_ir_emit(g);
        if (!IL(m, AST_F2)) goto find_index;      /* dot */
        void *sym = kcc_symtab_lookup(name, kcc_strlen(name));
        if (sym) {
            void *st = (void *)IL(sym, SYM_TYPE);
            if (st && IL(st, TY_KIND) == TY_ARRAY) goto find_index;
        }
        void *ld = kcc_ir_alloc_instr(IR_LOAD);   /* arrow on global pointer */
        IL(ld, IR_TYPE) = (unsigned long)kcc_type_int_s;
        IL(ld, IR_SRC1) = base_addr;
        base_addr = kcc_ir_next_vreg();
        IL(ld, IR_DEST) = base_addr;
        kcc_ir_emit(ld);
        goto find_index;
    }
    {
        unsigned long otag = IL(obj, AST_TAG);
        unsigned long arrow = IL(m, AST_F2);
        if (otag == AST_SUBSCRIPT && !arrow) {
            base_addr = kcc_ir_build_subscript_addr(obj);
            goto find_index;
        }
        if (otag == AST_MEMBER && !arrow) {
            base_addr = kcc_ir_build_member_addr(obj);
            goto find_index;
        }
        base_addr = kcc_ir_build_expr(obj);       /* arrow / other → value */
    }
find_index: {
    unsigned long off = 0;
    void *st = (void *)IL((void *)IL(m, AST_F0), AST_F3);
    unsigned long resolved = 0;
    if (st) {
        unsigned long k = IL(st, TY_KIND);
        if (k == TY_PTR) { st = (void *)IL(st, TY_F0); k = st ? IL(st, TY_KIND) : 0; }
        if (st && (k == TY_STRUCT || k == TY_UNION)) {
            kcc_type_layout(st);
            struct kcc_member_res mr = kcc_type_find_member(st, (const char *)IL(m, AST_F1));
            if (mr.field) {
                kcc_ir_member_field = mr.field;
                off = mr.off;
                resolved = 1;
            }
        }
    }
    if (!resolved) kcc_ir_member_field = 0;
    void *c = kcc_ir_alloc_instr(IR_CONST);
    IL(c, IR_SRC1) = off;
    IL(c, IR_TYPE) = (unsigned long)kcc_type_int_s;
    unsigned long ov = kcc_ir_next_vreg();
    IL(c, IR_DEST) = ov;
    kcc_ir_emit(c);
    void *gep = kcc_ir_alloc_instr(IR_GEP);
    IL(gep, IR_TYPE) = (unsigned long)kcc_type_int_s;
    IL(gep, IR_SRC1) = base_addr;
    IL(gep, IR_SRC2) = ov;
    unsigned long rv = kcc_ir_next_vreg();
    IL(gep, IR_DEST) = rv;
    kcc_ir_emit(gep);
    return rv;
}
}

unsigned long kcc_ir_build_member(void *m) {
    unsigned long addr = kcc_ir_build_member_addr(m);
    void *ft = (void *)IL(m, AST_F3);
    if ((unsigned long)ft >= 0x1000) {
        unsigned long k = IL(ft, TY_KIND);
        if (k == TY_ARRAY || k == TY_FUNC) return addr;   /* decay */
    }
    void *field = kcc_ir_member_field;
    if (field && IL(field, AST_F2)) return kcc_ir_bitfield_load(addr, field);
    /* scalar: load-type is the field's own descriptor when volatile or FP */
    void *lty;
    if ((unsigned long)ft >= 0x1000 &&
        ((IL(ft, TY_QUALS) & 2) || IL(ft, TY_KIND) == TY_FLOAT || IL(ft, TY_KIND) == TY_DOUBLE))
        lty = ft;
    else
        lty = kcc_type_int_s;
    unsigned long width = kcc_ir_load_width(ft);
    void *ld = kcc_ir_alloc_instr(IR_LOAD);
    IL(ld, IR_TYPE) = (unsigned long)lty;
    IL(ld, IR_SRC1) = addr;
    IL(ld, IR_SRC2) = width;
    unsigned long v = kcc_ir_next_vreg();
    IL(ld, IR_DEST) = v;
    kcc_ir_emit(ld);
    return v;
}
@}

@d Selfhost: ir exprs @{
/* tiny emitters shared by the bit-field synthesis and compound assignment */
unsigned long kcc_ir_emit_const(unsigned long value) {
    void *inst = kcc_ir_alloc_instr(IR_CONST);
    IL(inst, IR_SRC1) = value;
    IL(inst, IR_TYPE) = (unsigned long)kcc_type_long_u;
    unsigned long v = kcc_ir_next_vreg();
    IL(inst, IR_DEST) = v;
    kcc_ir_emit(inst);
    return v;
}

unsigned long kcc_ir_emit_binop_typed(unsigned long op, unsigned long a, unsigned long b, void *ty) {
    void *inst = kcc_ir_alloc_instr(op);
    IL(inst, IR_TYPE) = (unsigned long)ty;
    IL(inst, IR_SRC1) = a;
    IL(inst, IR_SRC2) = b;
    unsigned long v = kcc_ir_next_vreg();
    IL(inst, IR_DEST) = v;
    kcc_ir_emit(inst);
    return v;
}

unsigned long kcc_ir_emit_binop(unsigned long op, unsigned long a, unsigned long b) {
    return kcc_ir_emit_binop_typed(op, a, b, kcc_type_long_u);
}

unsigned long kcc_ir_compound_apply(unsigned long op, unsigned long old, void *L, unsigned long rhs, void *R) {
    if (op == IR_ADD || op == IR_SUB) {
        if ((unsigned long)L >= 0x1000 && IL(L, TY_KIND) == TY_PTR) {
            void *pointee = (void *)IL(L, TY_F0);
            if (pointee) {
                unsigned long sz = kcc_type_layout(pointee);
                if (sz > 1) {
                    unsigned long stride = kcc_ir_emit_const(sz);
                    rhs = kcc_ir_emit_binop(IR_MUL, rhs, stride);
                }
            }
        }
    }
    if (op == IR_ASHR || op == IR_SDIV || op == IR_SMOD) {
        void *ct = (op == IR_ASHR) ? kcc_conv_promote(L) : kcc_conv_usual(L, R);
        if (ct) {
            unsigned long k = IL(ct, TY_KIND);
            if (k >= TY_BOOL && k <= TY_LLONG && IL(ct, TY_F0) == 0) {
                if (op == IR_SDIV) op = IR_UDIV;
                else if (op == IR_SMOD) op = IR_UMOD;
                else op = IR_LSHR;
            }
        }
    }
    unsigned long lfp = kcc_ir_type_is_fp(L);
    unsigned long rfp = kcc_ir_type_is_fp(R);
    if (lfp || rfp) {
        void *C = lfp ? L : R;
        unsigned long old_c = kcc_ir_convert(old, L, C);
        unsigned long rhs_c = kcc_ir_convert(rhs, R, C);
        unsigned long res = kcc_ir_emit_binop_typed(op, old_c, rhs_c, C);
        return kcc_ir_convert(res, C, L);
    }
    unsigned long res = kcc_ir_emit_binop_typed(op, old, rhs, kcc_type_long_u);
    return kcc_ir_norm32(res, op, L, L);
}

unsigned long kcc_ir_bf_code(unsigned long container_bytes) {
    if (container_bytes == 4) return 4;
    if (container_bytes == 2) return 2;
    if (container_bytes == 1) return 1;
    return 0;
}

unsigned long kcc_ir_bf_mask(unsigned long width) {
    if (width >= 64) return (unsigned long)-1;
    return (1UL << width) - 1;
}

unsigned long kcc_ir_emit_load_t(unsigned long addr, unsigned long size, void *ty) {
    void *inst = kcc_ir_alloc_instr(IR_LOAD);
    IL(inst, IR_TYPE) = (unsigned long)ty;
    IL(inst, IR_SRC1) = addr;
    IL(inst, IR_SRC2) = size;
    unsigned long v = kcc_ir_next_vreg();
    IL(inst, IR_DEST) = v;
    kcc_ir_emit(inst);
    return v;
}

unsigned long kcc_ir_emit_load(unsigned long addr, unsigned long size) {
    return kcc_ir_emit_load_t(addr, size, kcc_type_long_u);
}

void kcc_ir_emit_store_t(unsigned long value, unsigned long addr, unsigned long size, void *ty) {
    void *inst = kcc_ir_alloc_instr(IR_STORE);
    IL(inst, IR_TYPE) = (unsigned long)ty;
    IL(inst, IR_SRC1) = value;
    IL(inst, IR_SRC2) = addr;
    IL(inst, IR_DEST) = size;
    kcc_ir_emit(inst);
}

void kcc_ir_emit_store(unsigned long value, unsigned long addr, unsigned long size) {
    kcc_ir_emit_store_t(value, addr, size, kcc_type_long_u);
}

void *kcc_ir_bf_container_type(void *field_type) {
    if (field_type && (IL(field_type, TY_QUALS) & 2)) {
        if (kcc_ir_vol_longu) return kcc_ir_vol_longu;
        void *nd = kcc_arena_alloc(TY_DESC_SIZE);
        void *src = kcc_type_long_u;
        IL(nd, 0) = IL(src, 0);
        IL(nd, 8) = IL(src, 8);
        IL(nd, 16) = IL(src, 16);
        IL(nd, 24) = IL(src, 24);
        IL(nd, 32) = IL(src, 32);
        IL(nd, 40) = IL(src, 40);
        IL(nd, TY_QUALS) = IL(nd, TY_QUALS) | 2;
        kcc_ir_vol_longu = nd;
        return nd;
    }
    return kcc_type_long_u;
}

unsigned long kcc_ir_type_layout_size(void *t) {
    if (!t) return 0;
    return kcc_type_layout(t);
}

unsigned long kcc_ir_bitfield_load(unsigned long addr, void *field) {
    unsigned long packed = IL(field, AST_F2);
    unsigned long width = packed & 0xffff;
    unsigned long lsb = packed >> 16;
    void *ft = kcc_sema_resolve_type((void *)IL(field, AST_F0));
    unsigned long code = kcc_ir_bf_code(kcc_ir_type_layout_size(ft));
    void *ct = kcc_ir_bf_container_type(ft);
    unsigned long val = kcc_ir_emit_load_t(addr, code, ct);
    if (lsb) {
        unsigned long c = kcc_ir_emit_const(lsb);
        val = kcc_ir_emit_binop(IR_LSHR, val, c);
    }
    unsigned long mc = kcc_ir_emit_const(kcc_ir_bf_mask(width));
    val = kcc_ir_emit_binop(IR_AND, val, mc);
    if (IL(ft, TY_KIND) == TY_ENUM) return val;
    if (kcc_sema_int_signedness(ft) != 1) return val;
    unsigned long s = 64 - width;
    unsigned long sc = kcc_ir_emit_const(s);
    val = kcc_ir_emit_binop(IR_SHL, val, sc);
    unsigned long sc2 = kcc_ir_emit_const(s);
    val = kcc_ir_emit_binop(IR_ASHR, val, sc2);
    return val;
}

unsigned long kcc_ir_bitfield_store(unsigned long addr, unsigned long value, void *field) {
    unsigned long packed = IL(field, AST_F2);
    unsigned long width = packed & 0xffff;
    unsigned long lsb = packed >> 16;
    void *ft = kcc_sema_resolve_type((void *)IL(field, AST_F0));
    unsigned long code = kcc_ir_bf_code(kcc_ir_type_layout_size(ft));
    void *ct = kcc_ir_bf_container_type(ft);
    unsigned long oldc = kcc_ir_emit_load_t(addr, code, ct);
    unsigned long mask = kcc_ir_bf_mask(width);
    unsigned long mc = kcc_ir_emit_const(mask);
    unsigned long vbits = kcc_ir_emit_binop(IR_AND, value, mc);
    if (lsb) {
        unsigned long lc = kcc_ir_emit_const(lsb);
        vbits = kcc_ir_emit_binop(IR_SHL, vbits, lc);
    }
    unsigned long clrc = kcc_ir_emit_const(~(mask << lsb));
    unsigned long cleared = kcc_ir_emit_binop(IR_AND, oldc, clrc);
    unsigned long newval = kcc_ir_emit_binop(IR_OR, cleared, vbits);
    void *ct2 = kcc_ir_bf_container_type(ft);
    kcc_ir_emit_store_t(newval, addr, code, ct2);
    return value;
}

unsigned long kcc_ir_emit_gep_const(unsigned long base, unsigned long off) {
    unsigned long ov = kcc_ir_emit_const(off);
    void *gep = kcc_ir_alloc_instr(IR_GEP);
    IL(gep, IR_TYPE) = (unsigned long)kcc_type_long_u;
    IL(gep, IR_SRC1) = base;
    IL(gep, IR_SRC2) = ov;
    unsigned long v = kcc_ir_next_vreg();
    IL(gep, IR_DEST) = v;
    kcc_ir_emit(gep);
    return v;
}

void kcc_ir_store_elem(unsigned long base, unsigned long off, unsigned long value, unsigned long width) {
    void *field = kcc_ir_member_field;
    if (field && IL(field, AST_F2)) {
        unsigned long caddr = kcc_ir_emit_gep_const(base, off);
        kcc_ir_bitfield_store(caddr, value, field);
    } else {
        kcc_ir_emit_indexed_store(base, off, value, width);
    }
}

void kcc_ir_emit_string_init(unsigned long base, const char *sp, unsigned long slen,
                             unsigned long alen, unsigned long zerofill) {
    if (zerofill) {
        unsigned long slots = (alen + 7) >> 3;
        unsigned long i = 0;
        while (i < slots) {
            unsigned long z = kcc_ir_emit_const(0);
            kcc_ir_emit_indexed_store(base, i << 3, z, 0);
            i++;
        }
    }
    unsigned long n = slen;
    if (alen < n) n = alen;
    unsigned long i = 0;
    while (i < n) {
        unsigned long b = kcc_ir_emit_const((unsigned char)sp[i]);
        kcc_ir_emit_indexed_store(base, i, b, 1);
        i++;
    }
}

unsigned long kcc_ir_emit_bool_norm(unsigned long vreg) {
    unsigned long z = kcc_ir_emit_const(0);
    return kcc_ir_emit_binop(IR_CMP_NE, vreg, z);
}

unsigned long kcc_ir_tok_to_binop(unsigned long tok) {
    if (tok == TOK_SUB_ASSIGN) return IR_SUB;
    if (tok == TOK_MUL_ASSIGN) return IR_MUL;
    if (tok == TOK_DIV_ASSIGN) return IR_SDIV;
    if (tok == TOK_MOD_ASSIGN) return IR_SMOD;
    if (tok == TOK_AND_ASSIGN) return IR_AND;
    if (tok == TOK_OR_ASSIGN) return IR_OR;
    if (tok == TOK_XOR_ASSIGN) return IR_XOR;
    if (tok == TOK_SHL_ASSIGN) return IR_SHL;
    if (tok == TOK_SHR_ASSIGN) return IR_ASHR;
    return IR_ADD;                                 /* TOK_ADD_ASSIGN and default */
}

unsigned long kcc_ir_bf_trunc_value(unsigned long value, void *field) {
    unsigned long width = IL(field, AST_F2) & 0xffff;
    void *ft = kcc_sema_resolve_type((void *)IL(field, AST_F0));
    unsigned long mc = kcc_ir_emit_const(kcc_ir_bf_mask(width));
    value = kcc_ir_emit_binop(IR_AND, value, mc);
    if (IL(ft, TY_KIND) == TY_ENUM) return value;
    if (kcc_sema_int_signedness(ft) != 1) return value;
    unsigned long s = 64 - width;
    unsigned long sc = kcc_ir_emit_const(s);
    value = kcc_ir_emit_binop(IR_SHL, value, sc);
    unsigned long sc2 = kcc_ir_emit_const(s);
    value = kcc_ir_emit_binop(IR_ASHR, value, sc2);
    return value;
}

unsigned long kcc_ir_assign_through(unsigned long addr, unsigned long rhs, unsigned long op_tok,
                                    void *field, void *ltype, void *rtype) {
    unsigned long is_bf = 0;
    if (field && IL(field, AST_F2)) is_bf = 1;
    if (op_tok == TOK_ASSIGN) {
        if (is_bf) {
            unsigned long stored = kcc_ir_bitfield_store(addr, rhs, field);
            (void)stored;
            return kcc_ir_bf_trunc_value(rhs, field);
        }
        unsigned long sz = kcc_ir_store_width(ltype);
        kcc_ir_emit_store(rhs, addr, sz);
        return rhs;
    }
    /* compound: load-modify-store */
    unsigned long old;
    if (is_bf) old = kcc_ir_bitfield_load(addr, field);
    else old = kcc_ir_emit_load(addr, kcc_ir_load_width(ltype));
    unsigned long op = kcc_ir_tok_to_binop(op_tok);
    unsigned long nv = kcc_ir_compound_apply(op, old, ltype, rhs, rtype);
    if (is_bf) {
        kcc_ir_bitfield_store(addr, nv, field);
        return kcc_ir_bf_trunc_value(nv, field);
    }
    kcc_ir_emit_store(nv, addr, kcc_ir_store_width(ltype));
    return nv;
}
@}

\section{Identifiers, Operators, and Unary Expressions}

Loading a variable resolves local (alloca), static-local (mangled global), and
file-scope cases, with arrays and functions decaying to their address rather
than loading.  Binary operators scale pointer arithmetic, remap signed opcodes
to unsigned by the operands' common type, take an FP path when any operand is
floating, and short-circuit \texttt{\&\&}/\texttt{||} through fresh blocks.
Unary handles negation, complement, logical-not, address-of (dispatched by
operand shape), and dereference.  Logical-not lowers to a compare against zero
typed at the operand's own width---\texttt{double} for a floating operand, a
64-bit compare for a \texttt{long} or pointer, else 32-bit---so that
\texttt{!x} on a wide value whose low 32 bits happen to be zero (the kernel's
\texttt{find\_bit} loop tests exactly such a masked word) still reports true only
when the whole word is zero.

\paragraph{\texttt{\_\_int128} arithmetic.}\label{sec:ir-int128}
A \texttt{\_\_int128} rvalue is materialised as the \emph{address of a
sixteen-byte stack slot} --- a two-eightbyte \texttt{IR\_ALLOCA} holding the
value little-endian, low half at offset~0 and high half at offset~8 --- exactly
the representation the aggregate paths already use for a two-word struct.  Two
operators are lowered, which together are precisely the kernel's
\texttt{math64.h} helpers \texttt{mul\_u64\_u32\_shr} and
\texttt{mul\_u64\_u64\_shr} (\texttt{(u64)(((unsigned \_\_int128)a * b) >>
s)}): an unsigned multiply and a logical right shift, both computed with
ordinary 64-bit IR operations on the two halves so no register-pair opcode or
back-end change is needed.  The multiply is the schoolbook
$64\times64\rightarrow128$ expansion (split each operand into 32-bit limbs, four
partial products, recombine with carries) plus the two cross terms
$a_{lo}b_{hi}+a_{hi}b_{lo}$ folded into the high word; its low 128 bits are
correct for signed and unsigned alike.  The shift is branchless: it forms the
within-a-word shift of the pair by $n\bmod 64$ (guarding the
$\text{hi}\ll(64-n)$ spill against the $n\equiv0$ case that would otherwise be
a shift by 64), then selects between that and the $\ge 64$ result with an
all-ones/zero mask derived from bit~6 of the count, since the IR has no select
opcode.  A widening cast zero- or sign-fills the high half; a narrowing cast
back to an integer simply loads the low half.  This is a self-hosting-port
(Linux/x86-64) capability: the assembly reference still rejects \texttt{\_\_int128}
arithmetic (Appendix~\ref{sec:lim-int128}), as it does the other kernel-only
builtins.

@l c
@d Selfhost: ir exprs @{
unsigned long kcc_ir_build_ident(void *e) {
    char *name = (char *)IL(e, AST_F0);
    if (!name) return 0;
    unsigned long keylen = kcc_strlen(name);
    unsigned long v = (unsigned long)kcc_ht_get(kcc_ir_locals, name, keylen);
    if (v) {
        unsigned long alloca;
        if (v & 0x8000000000000000UL) {
            alloca = (v & ~0x8000000000000000UL) - 1;
        } else {
            alloca = v - 1;
            void *ft = (void *)IL(e, AST_F3);
            if (ft) {
                unsigned long k = IL(ft, TY_KIND);
                if (k == TY_PTR || k == TY_ARRAY) return alloca;  /* array decay */
            }
        }
        void *ft = (void *)IL(e, AST_F3);
        unsigned long width = kcc_ir_load_width(ft);
        void *lty = ((unsigned long)ft >= 0x1000 && (IL(ft, TY_QUALS) & 2))
                    ? ft : kcc_type_int_s;
        void *ld = kcc_ir_alloc_instr(IR_LOAD);
        IL(ld, IR_TYPE) = (unsigned long)lty;
        IL(ld, IR_SRC1) = alloca;
        IL(ld, IR_SRC2) = width;
        unsigned long rv = kcc_ir_next_vreg();
        IL(ld, IR_DEST) = rv;
        kcc_ir_emit(ld);
        return rv;
    }
    /* global path */
    char *symname = name;
    unsigned long is_array = 0;
    unsigned long resolved = 0;
    if (kcc_ir_statics) {
        void *mangled = kcc_ht_get(kcc_ir_statics, name, keylen);
        if (mangled) {
            symname = (char *)mangled;
            resolved = 1;
            if (kcc_ir_static_types) {
                void *st = kcc_ht_get(kcc_ir_static_types, name, keylen);
                if (st) {
                    unsigned long k = IL(st, TY_KIND);
                    if (k == TY_ARRAY || k == TY_FUNC) is_array = 1;
                }
            }
        }
    }
    if (!resolved) {
        void *sym = kcc_symtab_lookup(name, keylen);
        if (sym) {
            if (IL(sym, SYM_KIND) == SYM_ENUM_CONST) {
                void *c = kcc_ir_alloc_instr(IR_CONST);
                IL(c, IR_TYPE) = (unsigned long)kcc_type_int_s;
                IL(c, IR_SRC1) = IL(sym, SYM_VALUE);
                unsigned long rv = kcc_ir_next_vreg();
                IL(c, IR_DEST) = rv;
                kcc_ir_emit(c);
                return rv;
            }
            void *st = (void *)IL(sym, SYM_TYPE);
            if (st) {
                unsigned long k = IL(st, TY_KIND);
                if (k == TY_ARRAY || k == TY_FUNC) is_array = 1;
            }
        }
    }
    if (is_array) {
        void *g = kcc_ir_alloc_instr(IR_GLOBAL_REF);
        IL(g, IR_SRC1) = (unsigned long)symname;
        IL(g, IR_TYPE) = (unsigned long)kcc_type_int_s;
        unsigned long rv = kcc_ir_next_vreg();
        IL(g, IR_DEST) = rv;
        kcc_ir_emit(g);
        return rv;
    }
    void *ft = (void *)IL(e, AST_F3);
    unsigned long width = kcc_ir_load_width(ft);
    void *lty;
    if ((unsigned long)ft >= 0x1000 &&
        ((IL(ft, TY_QUALS) & 2) || IL(ft, TY_KIND) == TY_FLOAT || IL(ft, TY_KIND) == TY_DOUBLE))
        lty = ft;
    else
        lty = kcc_type_int_s;
    void *g = kcc_ir_alloc_instr(IR_GLOBAL_REF);
    IL(g, IR_SRC1) = (unsigned long)symname;
    IL(g, IR_TYPE) = (unsigned long)kcc_type_int_s;
    unsigned long addr = kcc_ir_next_vreg();
    IL(g, IR_DEST) = addr;
    kcc_ir_emit(g);
    void *ld = kcc_ir_alloc_instr(IR_LOAD);
    IL(ld, IR_TYPE) = (unsigned long)lty;
    IL(ld, IR_SRC1) = addr;
    IL(ld, IR_SRC2) = width;
    unsigned long rv = kcc_ir_next_vreg();
    IL(ld, IR_DEST) = rv;
    kcc_ir_emit(ld);
    return rv;
}

/* 1 iff a relational comparison of these two operands is unsigned, applying
   the integer promotions then the usual arithmetic conversions' sign rule. */
unsigned long kcc_ir_cmp_unsigned(void *lhs_node, void *rhs_node) {
    if (!lhs_node) return 0;
    void *lt = (void *)IL(lhs_node, AST_F3);
    if (!lt) return 0;
    if (!rhs_node) return 0;
    void *rt = (void *)IL(rhs_node, AST_F3);
    if (!rt) return 0;
    if (IL(lt, TY_KIND) - 2 > 5) return 0;        /* not an integer kind */
    if (IL(rt, TY_KIND) - 2 > 5) return 0;
    unsigned long sl = IL(lt, TY_SIZE), gl = IL(lt, TY_F0);
    if (sl < 4) { sl = 4; gl = 1; }               /* promote to signed int */
    unsigned long sr = IL(rt, TY_SIZE), gr = IL(rt, TY_F0);
    if (sr < 4) { sr = 4; gr = 1; }
    if (sl > sr) return gl == 0 ? 1 : 0;          /* wider operand's sign wins */
    if (sl < sr) return gr == 0 ? 1 : 0;
    if (gl == 0 || gr == 0) return 1;             /* equal rank: unsigned if either is */
    return 0;
}

/* Re-canonicalise a width-growing op's result to 32 bits when both operands
   are <=int-width integers (SEXT for a signed result, ZEXT for unsigned). */
unsigned long kcc_ir_norm32(unsigned long vreg, unsigned long op, void *ltype, void *rtype) {
    if (!(op == IR_ADD || op == IR_SUB || op == IR_MUL || op == IR_SHL ||
          op == IR_NEG || op == IR_NOT || op == IR_AND || op == IR_OR || op == IR_XOR))
        return vreg;
    if (!ltype) return vreg;
    if (IL(ltype, TY_KIND) - 2 > 3) return vreg;  /* lhs not <=32-bit integer */
    if (!rtype) return vreg;
    if (IL(rtype, TY_KIND) - 2 > 3) return vreg;
    unsigned long ext;                            /* IR_SEXT or IR_ZEXT */
    if (IL(ltype, TY_F0) == 0 && IL(ltype, TY_SIZE) >= 4) {
        ext = IR_ZEXT;
    } else if (op == IR_SHL) {
        ext = IR_SEXT;                            /* shift: left operand alone decides */
    } else if (IL(rtype, TY_F0)) {
        ext = IR_SEXT;
    } else if (IL(rtype, TY_SIZE) >= 4) {
        ext = IR_ZEXT;
    } else {
        ext = IR_SEXT;
    }
    void *inst = kcc_ir_alloc_instr(ext);
    IL(inst, IR_TYPE) = (unsigned long)kcc_type_int_s;
    IL(inst, IR_SRC1) = vreg;
    IL(inst, IR_SRC2) = 4;                        /* source width 32-bit */
    unsigned long r = kcc_ir_next_vreg();
    IL(inst, IR_DEST) = r;
    kcc_ir_emit(inst);
    return r;
}

/* scale a vreg by an element size: const(int) + mul(int) */
static unsigned long bin_scale(unsigned long v, unsigned long size) {
    void *c = kcc_ir_alloc_instr(IR_CONST);
    IL(c, IR_TYPE) = (unsigned long)kcc_type_int_s;
    IL(c, IR_SRC1) = size;
    unsigned long cv = kcc_ir_next_vreg();
    IL(c, IR_DEST) = cv;
    kcc_ir_emit(c);
    void *m = kcc_ir_alloc_instr(IR_MUL);
    IL(m, IR_TYPE) = (unsigned long)kcc_type_int_s;
    IL(m, IR_SRC1) = v;
    IL(m, IR_SRC2) = cv;
    unsigned long r = kcc_ir_next_vreg();
    IL(m, IR_DEST) = r;
    kcc_ir_emit(m);
    return r;
}

/* (a - b) / sizeof(*lhs), all in signed long */
static unsigned long bin_ptr_diff(void *e, unsigned long a, unsigned long b) {
    void *lt = (void *)IL((void *)IL(e, AST_F1), AST_F3);
    void *pointee = lt ? (void *)IL(lt, TY_F0) : 0;
    unsigned long stride = 1;
    if (pointee) { unsigned long s = kcc_type_layout(pointee); if (s) stride = s; }
    void *sub = kcc_ir_alloc_instr(IR_SUB);
    IL(sub, IR_TYPE) = (unsigned long)kcc_type_long_s;
    IL(sub, IR_SRC1) = a;
    IL(sub, IR_SRC2) = b;
    unsigned long diff = kcc_ir_next_vreg();
    IL(sub, IR_DEST) = diff;
    kcc_ir_emit(sub);
    void *c = kcc_ir_alloc_instr(IR_CONST);
    IL(c, IR_TYPE) = (unsigned long)kcc_type_long_s;
    IL(c, IR_SRC1) = stride;
    unsigned long sv = kcc_ir_next_vreg();
    IL(c, IR_DEST) = sv;
    kcc_ir_emit(c);
    void *d = kcc_ir_alloc_instr(IR_SDIV);
    IL(d, IR_TYPE) = (unsigned long)kcc_type_long_s;
    IL(d, IR_SRC1) = diff;
    IL(d, IR_SRC2) = sv;
    unsigned long r = kcc_ir_next_vreg();
    IL(d, IR_DEST) = r;
    kcc_ir_emit(d);
    return r;
}

/* floating operation: promote integer operands to double (rounding to single
   when the other operand is float), emit typed double, round result if float */
static unsigned long bin_fp_emit(void *e, unsigned long op, unsigned long a, unsigned long b) {
    void *lt = (void *)IL((void *)IL(e, AST_F1), AST_F3);
    void *rt = (void *)IL((void *)IL(e, AST_F2), AST_F3);
    if (!kcc_ir_type_is_fp(lt)) {
        a = kcc_ir_emit_int_to_fp(a, lt);
        if (rt && IL(rt, TY_KIND) == TY_FLOAT) a = kcc_ir_emit_fpround(a);
    }
    if (!kcc_ir_type_is_fp(rt)) {
        b = kcc_ir_emit_int_to_fp(b, rt);
        if (lt && IL(lt, TY_KIND) == TY_FLOAT) b = kcc_ir_emit_fpround(b);
    }
    void *inst = kcc_ir_alloc_instr(op);
    IL(inst, IR_TYPE) = (unsigned long)kcc_type_double;
    IL(inst, IR_SRC1) = a;
    IL(inst, IR_SRC2) = b;
    unsigned long res = kcc_ir_next_vreg();
    IL(inst, IR_DEST) = res;
    kcc_ir_emit(inst);
    void *rty = (void *)IL(e, AST_F3);
    if (rty && IL(rty, TY_KIND) == TY_FLOAT) res = kcc_ir_emit_fpround(res);
    return res;
}

static unsigned long bin_short_and(void *e) {
    void *tmp = kcc_ir_alloc_instr(IR_ALLOCA);
    IL(tmp, IR_TYPE) = (unsigned long)kcc_type_int_s;
    unsigned long tmpv = kcc_ir_next_vreg();
    IL(tmp, IR_DEST) = tmpv;
    kcc_ir_emit(tmp);
    unsigned long lhs = kcc_ir_build_expr((void *)IL(e, AST_F1));
    void *rhs_bb = kcc_ir_alloc_bb();
    void *short_bb = kcc_ir_alloc_bb();
    void *merge_bb = kcc_ir_alloc_bb();
    void *bc = kcc_ir_alloc_instr(IR_BR_COND);
    IL(bc, IR_DEST) = lhs;
    IL(bc, IR_SRC1) = IL(rhs_bb, BB_ID);
    IL(bc, IR_SRC2) = IL(short_bb, BB_ID);
    kcc_ir_emit(bc);
    IL(kcc_ir_cur_bb, BB_FLAGS) = IL(kcc_ir_cur_bb, BB_FLAGS) | BB_FLAG_TERMINATED;
    kcc_ir_set_bb(short_bb);
    void *c0 = kcc_ir_alloc_instr(IR_CONST);
    IL(c0, IR_SRC1) = 0;
    IL(c0, IR_TYPE) = (unsigned long)kcc_type_int_s;
    unsigned long zv = kcc_ir_next_vreg();
    IL(c0, IR_DEST) = zv;
    kcc_ir_emit(c0);
    void *st0 = kcc_ir_alloc_instr(IR_STORE);
    IL(st0, IR_SRC1) = zv;
    IL(st0, IR_SRC2) = tmpv;
    kcc_ir_emit(st0);
    void *br0 = kcc_ir_alloc_instr(IR_BR);
    IL(br0, IR_SRC1) = IL(merge_bb, BB_ID);
    kcc_ir_emit(br0);
    IL(kcc_ir_cur_bb, BB_FLAGS) = IL(kcc_ir_cur_bb, BB_FLAGS) | BB_FLAG_TERMINATED;
    kcc_ir_set_bb(rhs_bb);
    unsigned long rv = kcc_ir_build_expr((void *)IL(e, AST_F2));
    rv = kcc_ir_emit_bool_norm(rv);
    void *st1 = kcc_ir_alloc_instr(IR_STORE);
    IL(st1, IR_SRC1) = rv;
    IL(st1, IR_SRC2) = tmpv;
    kcc_ir_emit(st1);
    void *br1 = kcc_ir_alloc_instr(IR_BR);
    IL(br1, IR_SRC1) = IL(merge_bb, BB_ID);
    kcc_ir_emit(br1);
    IL(kcc_ir_cur_bb, BB_FLAGS) = IL(kcc_ir_cur_bb, BB_FLAGS) | BB_FLAG_TERMINATED;
    kcc_ir_set_bb(merge_bb);
    void *ld = kcc_ir_alloc_instr(IR_LOAD);
    IL(ld, IR_TYPE) = (unsigned long)kcc_type_int_s;
    IL(ld, IR_SRC1) = tmpv;
    unsigned long res = kcc_ir_next_vreg();
    IL(ld, IR_DEST) = res;
    kcc_ir_emit(ld);
    return res;
}

static unsigned long bin_short_or(void *e) {
    void *tmp = kcc_ir_alloc_instr(IR_ALLOCA);
    IL(tmp, IR_TYPE) = (unsigned long)kcc_type_int_s;
    unsigned long tmpv = kcc_ir_next_vreg();
    IL(tmp, IR_DEST) = tmpv;
    kcc_ir_emit(tmp);
    unsigned long lhs = kcc_ir_build_expr((void *)IL(e, AST_F1));
    void *short_bb = kcc_ir_alloc_bb();
    void *rhs_bb = kcc_ir_alloc_bb();
    void *merge_bb = kcc_ir_alloc_bb();
    void *bc = kcc_ir_alloc_instr(IR_BR_COND);
    IL(bc, IR_DEST) = lhs;
    IL(bc, IR_SRC1) = IL(short_bb, BB_ID);
    IL(bc, IR_SRC2) = IL(rhs_bb, BB_ID);
    kcc_ir_emit(bc);
    IL(kcc_ir_cur_bb, BB_FLAGS) = IL(kcc_ir_cur_bb, BB_FLAGS) | BB_FLAG_TERMINATED;
    kcc_ir_set_bb(short_bb);
    void *c1 = kcc_ir_alloc_instr(IR_CONST);
    IL(c1, IR_SRC1) = 1;
    IL(c1, IR_TYPE) = (unsigned long)kcc_type_int_s;
    unsigned long ov = kcc_ir_next_vreg();
    IL(c1, IR_DEST) = ov;
    kcc_ir_emit(c1);
    void *st0 = kcc_ir_alloc_instr(IR_STORE);
    IL(st0, IR_SRC1) = ov;
    IL(st0, IR_SRC2) = tmpv;
    kcc_ir_emit(st0);
    void *br0 = kcc_ir_alloc_instr(IR_BR);
    IL(br0, IR_SRC1) = IL(merge_bb, BB_ID);
    kcc_ir_emit(br0);
    IL(kcc_ir_cur_bb, BB_FLAGS) = IL(kcc_ir_cur_bb, BB_FLAGS) | BB_FLAG_TERMINATED;
    kcc_ir_set_bb(rhs_bb);
    unsigned long rv = kcc_ir_build_expr((void *)IL(e, AST_F2));
    rv = kcc_ir_emit_bool_norm(rv);
    void *st1 = kcc_ir_alloc_instr(IR_STORE);
    IL(st1, IR_SRC1) = rv;
    IL(st1, IR_SRC2) = tmpv;
    kcc_ir_emit(st1);
    void *br1 = kcc_ir_alloc_instr(IR_BR);
    IL(br1, IR_SRC1) = IL(merge_bb, BB_ID);
    kcc_ir_emit(br1);
    IL(kcc_ir_cur_bb, BB_FLAGS) = IL(kcc_ir_cur_bb, BB_FLAGS) | BB_FLAG_TERMINATED;
    kcc_ir_set_bb(merge_bb);
    void *ld = kcc_ir_alloc_instr(IR_LOAD);
    IL(ld, IR_TYPE) = (unsigned long)kcc_type_int_s;
    IL(ld, IR_SRC1) = tmpv;
    unsigned long res = kcc_ir_next_vreg();
    IL(ld, IR_DEST) = res;
    kcc_ir_emit(ld);
    return res;
}

/* --- __int128 arithmetic ------------------------------------------------
   A 128-bit value is the address of a fresh two-slot (16-byte) alloca, low
   half at offset 0 and high half at offset 8.  All arithmetic below is built
   from ordinary 64-bit IR ops on the two halves. */
static unsigned long kcc_ir_i128_slot(void) {
    void *a = kcc_ir_alloc_instr(IR_ALLOCA);
    IL(a, IR_TYPE) = (unsigned long)kcc_type_int128_u;
    IL(a, IR_SRC1) = 2;                       /* two eight-byte slots */
    unsigned long avreg = kcc_ir_next_vreg();
    IL(a, IR_DEST) = avreg;
    kcc_ir_emit(a);
    return avreg;
}
static void kcc_ir_i128_set(unsigned long slot, unsigned long lo, unsigned long hi) {
    kcc_ir_emit_indexed_store(slot, 0, lo, 0);
    kcc_ir_emit_indexed_store(slot, 8, hi, 0);
}
/* Width code 0 is a plain 8-byte integer load (kcc_ir_load_width); a literal
   8 would instead select the single-float form in the back ends. */
static unsigned long kcc_ir_i128_lo(unsigned long addr) { return kcc_ir_emit_load(addr, 0); }
static unsigned long kcc_ir_i128_hi(unsigned long addr) {
    return kcc_ir_emit_load(kcc_ir_emit_gep_const(addr, 8), 0);
}
/* The 128-bit slot address of a value already typed __int128.  An lvalue (an
   identifier, member, subscript, or dereference---possibly parenthesised) is its
   own slot, so we take its address; only an rvalue (a cast, or a 128-bit
   arithmetic result) is built directly, since those already yield a slot address
   and building `kcc_ir_build_expr' on an lvalue would instead load its low half
   as a scalar and then dereference that value as if it were the slot pointer. */
static unsigned long kcc_ir_i128_addr(void *node) {
    void *n = node;
    while (n && IL(n, AST_TAG) == AST_PAREN_EXPR) n = (void *)IL(n, AST_F0);
    unsigned long tag = n ? IL(n, AST_TAG) : 0;
    if (tag == AST_IDENT_EXPR || tag == AST_MEMBER || tag == AST_SUBSCRIPT ||
        (tag == AST_UNARY_EXPR && IL(n, AST_F0) == TOK_STAR)) {
        void *u = kcc_ast_alloc(AST_UNARY_EXPR);
        IL(u, AST_F0) = TOK_AMP;
        IL(u, AST_F1) = (unsigned long)n;
        IL(u, AST_F2) = 1;
        return kcc_ir_build_expr(u);
    }
    return kcc_ir_build_expr(node);
}
/* Build a subexpression as a 128-bit slot address: a value already typed
   __int128 yields the slot directly; a narrower integer is widened (zero- or
   sign-filled high half) into a fresh slot. */
static unsigned long kcc_ir_i128_operand(void *node) {
    void *ty = (void *)IL(node, AST_F3);
    if (ty && (unsigned long)ty >= 0x1000 && IL(ty, TY_KIND) == TY_INT128)
        return kcc_ir_i128_addr(node);
    unsigned long v = kcc_ir_build_expr(node);
    unsigned long slot = kcc_ir_i128_slot();
    unsigned long hi = kcc_ir_emit_const(0);
    if (ty && (unsigned long)ty >= 0x1000 && IL(ty, TY_KIND) != TY_PTR && IL(ty, TY_F0) != 0)
        hi = kcc_ir_emit_binop(IR_ASHR, v, kcc_ir_emit_const(63));
    kcc_ir_i128_set(slot, v, hi);
    return slot;
}
/* Low 128 bits of A*B (correct for signed and unsigned operands). */
static unsigned long kcc_ir_i128_mul(unsigned long A, unsigned long B) {
    unsigned long a_lo = kcc_ir_i128_lo(A), a_hi = kcc_ir_i128_hi(A);
    unsigned long b_lo = kcc_ir_i128_lo(B), b_hi = kcc_ir_i128_hi(B);
    unsigned long M   = kcc_ir_emit_const(0xFFFFFFFF);
    unsigned long c32 = kcc_ir_emit_const(32);
    unsigned long alo = kcc_ir_emit_binop(IR_AND, a_lo, M);
    unsigned long ahi = kcc_ir_emit_binop(IR_LSHR, a_lo, c32);
    unsigned long blo = kcc_ir_emit_binop(IR_AND, b_lo, M);
    unsigned long bhi = kcc_ir_emit_binop(IR_LSHR, b_lo, c32);
    unsigned long ll = kcc_ir_emit_binop(IR_MUL, alo, blo);
    unsigned long lh = kcc_ir_emit_binop(IR_MUL, alo, bhi);
    unsigned long hl = kcc_ir_emit_binop(IR_MUL, ahi, blo);
    unsigned long hh = kcc_ir_emit_binop(IR_MUL, ahi, bhi);
    /* mid = (ll>>32) + (lh & M) + (hl & M) */
    unsigned long mid = kcc_ir_emit_binop(IR_ADD,
        kcc_ir_emit_binop(IR_ADD, kcc_ir_emit_binop(IR_LSHR, ll, c32),
                                  kcc_ir_emit_binop(IR_AND, lh, M)),
        kcc_ir_emit_binop(IR_AND, hl, M));
    unsigned long res_lo = kcc_ir_emit_binop(IR_OR,
        kcc_ir_emit_binop(IR_AND, ll, M),
        kcc_ir_emit_binop(IR_SHL, mid, c32));
    /* high 64 of a_lo*b_lo */
    unsigned long hi_ll = kcc_ir_emit_binop(IR_ADD,
        kcc_ir_emit_binop(IR_ADD, hh, kcc_ir_emit_binop(IR_LSHR, lh, c32)),
        kcc_ir_emit_binop(IR_ADD, kcc_ir_emit_binop(IR_LSHR, hl, c32),
                                  kcc_ir_emit_binop(IR_LSHR, mid, c32)));
    unsigned long cross = kcc_ir_emit_binop(IR_ADD,
        kcc_ir_emit_binop(IR_MUL, a_lo, b_hi),
        kcc_ir_emit_binop(IR_MUL, a_hi, b_lo));
    unsigned long res_hi = kcc_ir_emit_binop(IR_ADD, hi_ll, cross);
    unsigned long slot = kcc_ir_i128_slot();
    kcc_ir_i128_set(slot, res_lo, res_hi);
    return slot;
}
/* Logical right shift of the 128-bit value at A by the 64-bit count n, for
   n in [0,127].  Branchless: no select opcode exists. */
static unsigned long kcc_ir_i128_lshr(unsigned long A, unsigned long n) {
    unsigned long lo = kcc_ir_i128_lo(A), hi = kcc_ir_i128_hi(A);
    unsigned long c0 = kcc_ir_emit_const(0);
    unsigned long c63 = kcc_ir_emit_const(63);
    unsigned long c64 = kcc_ir_emit_const(64);
    unsigned long ones = kcc_ir_emit_const(0xFFFFFFFFFFFFFFFFUL);
    unsigned long n6 = kcc_ir_emit_binop(IR_AND, n, c63);         /* n & 63 */
    /* spill = (n6!=0) ? (hi << (64-n6)) : 0  — avoids a shift by 64 */
    unsigned long sh = kcc_ir_emit_binop(IR_AND, kcc_ir_emit_binop(IR_SUB, c64, n6), c63);
    unsigned long spill_raw = kcc_ir_emit_binop(IR_SHL, hi, sh);
    unsigned long ne = kcc_ir_emit_binop(IR_CMP_NE, n6, c0);      /* 0/1 */
    unsigned long nzmask = kcc_ir_emit_binop(IR_SUB, c0, ne);     /* 0 or all-ones */
    unsigned long spill = kcc_ir_emit_binop(IR_AND, spill_raw, nzmask);
    unsigned long s_lo = kcc_ir_emit_binop(IR_OR, kcc_ir_emit_binop(IR_LSHR, lo, n6), spill);
    unsigned long s_hi = kcc_ir_emit_binop(IR_LSHR, hi, n6);
    /* select the >=64 result (lo=hi>>n6, hi=0) via a mask from bit 6 of n */
    unsigned long ge = kcc_ir_emit_binop(IR_AND, kcc_ir_emit_binop(IR_LSHR, n, kcc_ir_emit_const(6)),
                                                 kcc_ir_emit_const(1));
    unsigned long gemask = kcc_ir_emit_binop(IR_SUB, c0, ge);     /* all-ones if n>=64 */
    unsigned long notmask = kcc_ir_emit_binop(IR_XOR, gemask, ones);
    unsigned long r_lo = kcc_ir_emit_binop(IR_OR,
        kcc_ir_emit_binop(IR_AND, s_hi, gemask),
        kcc_ir_emit_binop(IR_AND, s_lo, notmask));
    unsigned long r_hi = kcc_ir_emit_binop(IR_AND, s_hi, notmask);
    unsigned long slot = kcc_ir_i128_slot();
    kcc_ir_i128_set(slot, r_lo, r_hi);
    return slot;
}
/* Dispatch a binary operator whose result type is __int128.  sema has already
   restricted these to unsigned multiply and logical right shift. */
static unsigned long kcc_ir_i128_binary(void *e) {
    unsigned long op_tok = IL(e, AST_F0);
    unsigned long A = kcc_ir_i128_operand((void *)IL(e, AST_F1));
    if (op_tok == TOK_SHR) {
        unsigned long nsh = kcc_ir_build_expr((void *)IL(e, AST_F2));
        return kcc_ir_i128_lshr(A, nsh);
    }
    /* TOK_STAR */
    unsigned long B = kcc_ir_i128_operand((void *)IL(e, AST_F2));
    return kcc_ir_i128_mul(A, B);
}
/* Equality of two 128-bit values: both halves must match.  The result is an
   ordinary `int' (0/1), so the caller dispatches on the operands' type, not the
   result's.  `!=' is the complement. */
static unsigned long kcc_ir_i128_cmp(void *e, unsigned long op_tok) {
    unsigned long A = kcc_ir_i128_operand((void *)IL(e, AST_F1));
    unsigned long B = kcc_ir_i128_operand((void *)IL(e, AST_F2));
    unsigned long lo_eq = kcc_ir_emit_binop(IR_CMP_EQ, kcc_ir_i128_lo(A), kcc_ir_i128_lo(B));
    unsigned long hi_eq = kcc_ir_emit_binop(IR_CMP_EQ, kcc_ir_i128_hi(A), kcc_ir_i128_hi(B));
    unsigned long eq = kcc_ir_emit_binop(IR_AND, lo_eq, hi_eq);
    if (op_tok == TOK_NE) return kcc_ir_emit_binop(IR_XOR, eq, kcc_ir_emit_const(1));
    return eq;
}
/* Whether an expression node's static type is __int128. */
static unsigned long kcc_ir_is_i128(void *node) {
    void *ty = (void *)IL(node, AST_F3);
    return ty && (unsigned long)ty >= 0x1000 && IL(ty, TY_KIND) == TY_INT128;
}

unsigned long kcc_ir_build_binary(void *e) {
    unsigned long op_tok = IL(e, AST_F0);
    { void *rty0 = (void *)IL(e, AST_F3);
      if (rty0 && (unsigned long)rty0 >= 0x1000 && IL(rty0, TY_KIND) == TY_INT128)
          return kcc_ir_i128_binary(e); }
    /* A 128-bit equality test yields a plain int, so it is not caught above;
       detect it from the operands (the kernel's try_cmpxchg128). */
    if ((op_tok == TOK_EQ || op_tok == TOK_NE) &&
        (kcc_ir_is_i128((void *)IL(e, AST_F1)) || kcc_ir_is_i128((void *)IL(e, AST_F2))))
        return kcc_ir_i128_cmp(e, op_tok);
    if (op_tok == TOK_AND) return bin_short_and(e);
    if (op_tok == TOK_OR) return bin_short_or(e);
    unsigned long a = kcc_ir_build_expr((void *)IL(e, AST_F1));
    unsigned long b = kcc_ir_build_expr((void *)IL(e, AST_F2));
    unsigned long op;
    unsigned long addsub = 0;
    if (op_tok == TOK_PLUS) { op = IR_ADD; addsub = 1; }
    else if (op_tok == TOK_MINUS) { op = IR_SUB; addsub = 1; }
    else if (op_tok == TOK_STAR) op = IR_MUL;
    else if (op_tok == TOK_SLASH) op = IR_SDIV;
    else if (op_tok == TOK_PERCENT) op = IR_SMOD;
    else if (op_tok == TOK_AMP) op = IR_AND;
    else if (op_tok == TOK_PIPE) op = IR_OR;
    else if (op_tok == TOK_CARET) op = IR_XOR;
    else if (op_tok == TOK_SHL) op = IR_SHL;
    else if (op_tok == TOK_SHR) op = IR_ASHR;
    else if (op_tok == TOK_EQ) op = IR_CMP_EQ;
    else if (op_tok == TOK_NE) op = IR_CMP_NE;
    else if (op_tok == TOK_LT) op = IR_CMP_SLT;
    else if (op_tok == TOK_LE) op = IR_CMP_SLE;
    else if (op_tok == TOK_GT) op = IR_CMP_SGT;
    else if (op_tok == TOK_GE) op = IR_CMP_SGE;
    else { op = IR_ADD; addsub = 1; }

    if (addsub) {
        void *lt = (void *)IL((void *)IL(e, AST_F1), AST_F3);
        unsigned long lhs_ptr = 0;
        if (lt) { unsigned long k = IL(lt, TY_KIND); if (k == TY_PTR || k == TY_ARRAY) lhs_ptr = 1; }
        if (lhs_ptr) {
            if (op == IR_SUB) {
                void *rt = (void *)IL((void *)IL(e, AST_F2), AST_F3);
                if (rt) { unsigned long rk = IL(rt, TY_KIND);
                    if (rk == TY_PTR || rk == TY_ARRAY) return bin_ptr_diff(e, a, b); }
            }
            void *pointee = (void *)IL(lt, TY_F0);
            if (pointee) { unsigned long sz = kcc_type_layout(pointee); if (sz > 1) b = bin_scale(b, sz); }
        } else {
            void *rt = (void *)IL((void *)IL(e, AST_F2), AST_F3);
            if (rt && (IL(rt, TY_KIND) == TY_PTR || IL(rt, TY_KIND) == TY_ARRAY)) {
                void *pointee = (void *)IL(rt, TY_F0);
                if (pointee) { unsigned long sz = kcc_type_layout(pointee); if (sz > 1) a = bin_scale(a, sz); }
            }
        }
    }

    /* FP path if the result or either operand is floating */
    void *rty = (void *)IL(e, AST_F3);
    unsigned long fp = kcc_ir_type_is_fp(rty);
    if (!fp) fp = kcc_ir_type_is_fp((void *)IL((void *)IL(e, AST_F1), AST_F3));
    if (!fp) fp = kcc_ir_type_is_fp((void *)IL((void *)IL(e, AST_F2), AST_F3));
    if (fp) return bin_fp_emit(e, op, a, b);

    /* integer opcode signedness remap */
    if (op >= IR_CMP_SLT && op <= IR_CMP_SGE) {
        if (kcc_ir_cmp_unsigned((void *)IL(e, AST_F1), (void *)IL(e, AST_F2))) {
            if (op == IR_CMP_SLT) op = IR_CMP_ULT;
            else if (op == IR_CMP_SLE) op = IR_CMP_ULE;
            else if (op == IR_CMP_SGT) { unsigned long t = a; a = b; b = t; op = IR_CMP_ULT; }
            else { unsigned long t = a; a = b; b = t; op = IR_CMP_ULE; }
        }
    } else if (op == IR_SDIV || op == IR_SMOD || op == IR_ASHR) {
        void *rt = (void *)IL(e, AST_F3);
        if (rt && IL(rt, TY_F0) == 0) {
            if (op == IR_SDIV) op = IR_UDIV;
            else if (op == IR_SMOD) op = IR_UMOD;
            else op = IR_LSHR;
        }
    }

    void *inst = kcc_ir_alloc_instr(op);
    IL(inst, IR_TYPE) = (unsigned long)kcc_type_int_s;
    IL(inst, IR_SRC1) = a;
    IL(inst, IR_SRC2) = b;
    unsigned long is_cmp = (op >= IR_CMP_EQ && op <= IR_CMP_ULE);
    unsigned long is_divmod = (op >= IR_SDIV && op <= IR_UMOD);
    if (is_cmp || is_divmod) {
        unsigned long lw = 8, rw = 8;
        void *lt = (void *)IL((void *)IL(e, AST_F1), AST_F3);
        if (lt) lw = IL(lt, TY_SIZE);
        void *rt = (void *)IL((void *)IL(e, AST_F2), AST_F3);
        if (rt) rw = IL(rt, TY_SIZE);
        unsigned long w = (rw > lw) ? rw : lw;
        if (w > 4) IL(inst, IR_TYPE) = (unsigned long)kcc_type_long_s;
    }
    unsigned long r = kcc_ir_next_vreg();
    IL(inst, IR_DEST) = r;
    kcc_ir_emit(inst);
    void *lt = (void *)IL((void *)IL(e, AST_F1), AST_F3);
    void *rt = (void *)IL((void *)IL(e, AST_F2), AST_F3);
    return kcc_ir_norm32(r, op, lt, rt);
}

unsigned long kcc_ir_build_unary(void *e) {
    unsigned long op = IL(e, AST_F0);
    if (op == TOK_INC || op == TOK_DEC) return kcc_ir_build_inc_dec(e);
    if (op == TOK_AMP) {
        void *operand = (void *)IL(e, AST_F1);
        if (!operand) return 0;
        while (operand && IL(operand, AST_TAG) == AST_PAREN_EXPR)
            operand = (void *)IL(operand, AST_F0);
        if (!operand) return 0;
        unsigned long otag = IL(operand, AST_TAG);
        if (otag == AST_SUBSCRIPT) return kcc_ir_build_subscript_addr(operand);
        if (otag == AST_MEMBER) return kcc_ir_build_member_addr(operand);
        if (otag == AST_COMPOUND_LIT) return kcc_ir_build_compound_lit(operand);
        /* &(*p) is just p---the address-of and dereference cancel.  Needed by
           memory-constraint asm operands (`"m"(*addr)`), where the address of
           the pointed-to object is the pointer value itself. */
        if (otag == AST_UNARY_EXPR && IL(operand, AST_F0) == TOK_STAR)
            return kcc_ir_build_expr((void *)IL(operand, AST_F1));
        if (otag != AST_IDENT_EXPR) return 0;
        char *name = (char *)IL(operand, AST_F0);
        if (!name) return 0;
        kcc_ir_local_const_kill(name);   /* &x may alias-modify x */
        unsigned long keylen = kcc_strlen(name);
        unsigned long v = (unsigned long)kcc_ht_get(kcc_ir_locals, name, keylen);
        if (v) return (v & ~0x8000000000000000UL) - 1;
        /* global (or static-local hoisted to a mangled global) */
        char *symname = name;
        if (kcc_ir_statics) {
            void *mangled = kcc_ht_get(kcc_ir_statics, name, keylen);
            if (mangled) symname = (char *)mangled;
        }
        void *g = kcc_ir_alloc_instr(IR_GLOBAL_REF);
        IL(g, IR_SRC1) = (unsigned long)symname;
        IL(g, IR_TYPE) = (unsigned long)kcc_type_int_s;
        unsigned long rv = kcc_ir_next_vreg();
        IL(g, IR_DEST) = rv;
        kcc_ir_emit(g);
        return rv;
    }
    unsigned long v = kcc_ir_build_expr((void *)IL(e, AST_F1));
    if (op == TOK_MINUS) {
        void *operand = (void *)IL(e, AST_F1);
        unsigned long is_fp = 0;
        void *fpty = 0;
        if (operand && IL(operand, AST_TAG) == AST_FLOAT_LIT) { is_fp = 1; fpty = kcc_type_double; }
        else if (operand) {
            void *ot = (void *)IL(operand, AST_F3);
            if ((unsigned long)ot >= 0x1000) {
                unsigned long k = IL(ot, TY_KIND);
                if (k >= TY_FLOAT && k <= TY_LDOUBLE) { is_fp = 1; fpty = ot; }
            }
        }
        if (is_fp) {
            void *inst = kcc_ir_alloc_instr(IR_NEG);
            IL(inst, IR_SRC1) = v;
            IL(inst, IR_TYPE) = (unsigned long)fpty;
            unsigned long r = kcc_ir_next_vreg();
            IL(inst, IR_DEST) = r;
            kcc_ir_emit(inst);
            return r;
        }
        void *inst = kcc_ir_alloc_instr(IR_NEG);
        IL(inst, IR_TYPE) = (unsigned long)kcc_type_int_s;
        IL(inst, IR_SRC1) = v;
        unsigned long r = kcc_ir_next_vreg();
        IL(inst, IR_DEST) = r;
        kcc_ir_emit(inst);
        void *ot = (void *)IL(operand, AST_F3);
        return kcc_ir_norm32(r, IR_NEG, ot, ot);
    }
    if (op == TOK_TILDE) {
        void *inst = kcc_ir_alloc_instr(IR_NOT);
        IL(inst, IR_TYPE) = (unsigned long)kcc_type_int_s;
        IL(inst, IR_SRC1) = v;
        unsigned long r = kcc_ir_next_vreg();
        IL(inst, IR_DEST) = r;
        kcc_ir_emit(inst);
        void *ot = (void *)IL((void *)IL(e, AST_F1), AST_F3);
        return kcc_ir_norm32(r, IR_NOT, ot, ot);
    }
    if (op == TOK_BANG) {
        void *operand = (void *)IL(e, AST_F1);
        void *cty = kcc_type_int_s;
        if (operand) {
            void *ot = (void *)IL(operand, AST_F3);
            if (ot) {
                unsigned long k = IL(ot, TY_KIND);
                /* Compare against zero at the operand's own width: a 64-bit
                   value (long or pointer) whose low 32 bits happen to be zero
                   must still test true only when the whole word is zero. */
                if (k >= TY_FLOAT && k <= TY_LDOUBLE) cty = kcc_type_double;
                else if (IL(ot, TY_SIZE) > 4) cty = kcc_type_long_s;
            }
        }
        void *c = kcc_ir_alloc_instr(IR_CONST);
        IL(c, IR_TYPE) = (unsigned long)cty;
        IL(c, IR_SRC1) = 0;
        unsigned long zv = kcc_ir_next_vreg();
        IL(c, IR_DEST) = zv;
        kcc_ir_emit(c);
        void *cmp = kcc_ir_alloc_instr(IR_CMP_EQ);
        IL(cmp, IR_TYPE) = (unsigned long)cty;
        IL(cmp, IR_SRC1) = v;
        IL(cmp, IR_SRC2) = zv;
        unsigned long r = kcc_ir_next_vreg();
        IL(cmp, IR_DEST) = r;
        kcc_ir_emit(cmp);
        return r;
    }
    if (op == TOK_STAR) {
        void *inst = kcc_ir_alloc_instr(IR_LOAD);
        void *pt = (void *)IL(e, AST_F3);
        if (pt) {
            IL(inst, IR_TYPE) = (unsigned long)pt;
            IL(inst, IR_SRC2) = kcc_ir_load_width(pt);
        } else {
            IL(inst, IR_TYPE) = (unsigned long)kcc_type_int_s;
            IL(inst, IR_SRC2) = 0;
        }
        IL(inst, IR_SRC1) = v;
        unsigned long r = kcc_ir_next_vreg();
        IL(inst, IR_DEST) = r;
        kcc_ir_emit(inst);
        return r;
    }
    return v;                                     /* default: operand as-is */
}
@}

@d Selfhost: ir exprs @{
/* ++/-- : load-modify-store in the operand's own type; postfix returns the
   old value, prefix the new.  Bit-fields go through the masked RMW. */
unsigned long kcc_ir_build_inc_dec(void *e) {
    void *operand = (void *)IL(e, AST_F1);
    while (operand && IL(operand, AST_TAG) == AST_PAREN_EXPR) {
        operand = (void *)IL(operand, AST_F0);
        IL(e, AST_F1) = (unsigned long)operand;
    }
    unsigned long op = IL(e, AST_F0);
    unsigned long prefix = IL(e, AST_F2);
    operand = (void *)IL(e, AST_F1);
    if (!operand) return 0;
    unsigned long tag = IL(operand, AST_TAG);
    unsigned long addr;
    void *bf = 0;
    if (tag == AST_MEMBER) {
        addr = kcc_ir_build_member_addr(operand);
        void *field = kcc_ir_member_field;
        if (field && IL(field, AST_F2)) bf = field;
    } else if (tag == AST_SUBSCRIPT) {
        addr = kcc_ir_build_subscript_addr(operand);
    } else if (tag == AST_UNARY_EXPR) {
        if (IL(operand, AST_F0) != TOK_STAR) return 0;
        addr = kcc_ir_build_expr((void *)IL(operand, AST_F1));
    } else if (tag == AST_IDENT_EXPR) {
        char *name = (char *)IL(operand, AST_F0);
        if (!name) return 0;
        kcc_ir_local_const_kill(name);   /* ++/-- changes the value */
        unsigned long keylen = kcc_strlen(name);
        unsigned long v = (unsigned long)kcc_ht_get(kcc_ir_locals, name, keylen);
        if (v) {
            addr = (v & ~0x8000000000000000UL) - 1;
        } else {
            char *symname = name;
            if (kcc_ir_statics) {
                void *mangled = kcc_ht_get(kcc_ir_statics, name, keylen);
                if (mangled) symname = (char *)mangled;
            }
            void *g = kcc_ir_alloc_instr(IR_GLOBAL_REF);
            IL(g, IR_SRC1) = (unsigned long)symname;
            IL(g, IR_TYPE) = (unsigned long)kcc_type_int_s;
            addr = kcc_ir_next_vreg();
            IL(g, IR_DEST) = addr;
            kcc_ir_emit(g);
        }
    } else {
        return 0;
    }
    if (bf) {
        unsigned long old = kcc_ir_bitfield_load(addr, bf);
        unsigned long one = kcc_ir_emit_const(1);
        unsigned long nw = kcc_ir_emit_binop(op == TOK_INC ? IR_ADD : IR_SUB, old, one);
        kcc_ir_bitfield_store(addr, nw, bf);
        return prefix ? nw : old;
    }
    void *wt = kcc_type_int_s;
    unsigned long step = 1;
    unsigned long is_fp = 0;
    void *ot = (void *)IL(operand, AST_F3);
    if ((unsigned long)ot >= 0x1000) {
        unsigned long k = IL(ot, TY_KIND);
        if (k == TY_PTR) {
            wt = ot;
            void *pointee = (void *)IL(ot, TY_F0);
            if (pointee) { unsigned long s = kcc_type_layout(pointee); if (s) step = s; }
        } else if ((k >= TY_BOOL && k <= TY_LLONG) || k == TY_ENUM) {
            wt = ot;
        } else if (k == TY_FLOAT || k == TY_DOUBLE) {
            wt = ot; is_fp = 1;
        }
    }
    void *ld = kcc_ir_alloc_instr(IR_LOAD);
    IL(ld, IR_TYPE) = (unsigned long)wt;
    IL(ld, IR_SRC1) = addr;
    IL(ld, IR_SRC2) = kcc_ir_load_width(wt);
    unsigned long old = kcc_ir_next_vreg();
    IL(ld, IR_DEST) = old;
    kcc_ir_emit(ld);
    unsigned long stepv;
    if (is_fp) {
        unsigned long one = kcc_ir_emit_const(1);
        stepv = kcc_ir_convert(one, kcc_type_int_s, wt);
    } else {
        void *c = kcc_ir_alloc_instr(IR_CONST);
        IL(c, IR_TYPE) = (unsigned long)wt;
        IL(c, IR_SRC1) = step;
        stepv = kcc_ir_next_vreg();
        IL(c, IR_DEST) = stepv;
        kcc_ir_emit(c);
    }
    void *bop = kcc_ir_alloc_instr(op == TOK_INC ? IR_ADD : IR_SUB);
    IL(bop, IR_TYPE) = (unsigned long)wt;
    IL(bop, IR_SRC1) = old;
    IL(bop, IR_SRC2) = stepv;
    unsigned long nw = kcc_ir_next_vreg();
    IL(bop, IR_DEST) = nw;
    kcc_ir_emit(bop);
    unsigned long k = IL(wt, TY_KIND);
    if (k >= TY_BOOL && k <= TY_LLONG) {
        unsigned long sz = IL(wt, TY_SIZE);
        if (sz < 8) {
            unsigned long ext = IL(wt, TY_F0) ? IR_SEXT : IR_ZEXT;
            void *ei = kcc_ir_alloc_instr(ext);
            IL(ei, IR_TYPE) = (unsigned long)wt;
            IL(ei, IR_SRC1) = nw;
            IL(ei, IR_SRC2) = sz;
            nw = kcc_ir_next_vreg();
            IL(ei, IR_DEST) = nw;
            kcc_ir_emit(ei);
        }
    }
    void *st = kcc_ir_alloc_instr(IR_STORE);
    IL(st, IR_TYPE) = (unsigned long)wt;
    IL(st, IR_SRC1) = nw;
    IL(st, IR_SRC2) = addr;
    IL(st, IR_DEST) = kcc_ir_store_width(wt);
    kcc_ir_emit(st);
    return prefix ? nw : old;
}
@}

\section{Aggregates and Declarations}

Struct copies walk the object in descending power-of-two chunks for exactly
\texttt{TY\_SIZE} bytes; \texttt{build\_struct\_addr} yields the address of a
struct-valued expression for by-value passing and return.  The recursive
initializer descends nested aggregates, honouring designator chains and brace
elision, over a zero-filled region.

@l c
@d Selfhost: ir aggregates @{
void kcc_ir_emit_struct_copy(unsigned long src, unsigned long dst, unsigned long size) {
    unsigned long off = 0;
    while ((long)(size - off) > 0) {
        unsigned long rem = size - off;
        unsigned long chunk, code;
        if (rem >= 8) { chunk = 8; code = 0; }
        else if (rem >= 4) { chunk = 4; code = 4; }
        else if (rem >= 2) { chunk = 2; code = 2; }
        else { chunk = 1; code = 1; }
        void *c = kcc_ir_alloc_instr(IR_CONST);
        IL(c, IR_TYPE) = (unsigned long)kcc_type_int_s;
        IL(c, IR_SRC1) = off;
        unsigned long idx = kcc_ir_next_vreg();
        IL(c, IR_DEST) = idx;
        kcc_ir_emit(c);
        void *g1 = kcc_ir_alloc_instr(IR_GEP);
        IL(g1, IR_TYPE) = (unsigned long)kcc_type_int_s;
        IL(g1, IR_SRC1) = src;
        IL(g1, IR_SRC2) = idx;
        unsigned long se = kcc_ir_next_vreg();
        IL(g1, IR_DEST) = se;
        kcc_ir_emit(g1);
        void *ld = kcc_ir_alloc_instr(IR_LOAD);
        IL(ld, IR_TYPE) = (unsigned long)kcc_type_int_s;
        IL(ld, IR_SRC1) = se;
        IL(ld, IR_SRC2) = code;
        unsigned long val = kcc_ir_next_vreg();
        IL(ld, IR_DEST) = val;
        kcc_ir_emit(ld);
        void *g2 = kcc_ir_alloc_instr(IR_GEP);
        IL(g2, IR_TYPE) = (unsigned long)kcc_type_int_s;
        IL(g2, IR_SRC1) = dst;
        IL(g2, IR_SRC2) = idx;
        unsigned long de = kcc_ir_next_vreg();
        IL(g2, IR_DEST) = de;
        kcc_ir_emit(g2);
        void *st = kcc_ir_alloc_instr(IR_STORE);
        IL(st, IR_TYPE) = (unsigned long)kcc_type_int_s;
        IL(st, IR_SRC1) = val;
        IL(st, IR_SRC2) = de;
        IL(st, IR_DEST) = code;
        kcc_ir_emit(st);
        off += chunk;
    }
}

unsigned long kcc_ir_build_struct_addr(void *e) {
    if (!e) return 0;
    if (IL(e, AST_TAG) == AST_PAREN_EXPR) {
        e = (void *)IL(e, AST_F0);
        if (!e) return 0;
    }
    unsigned long tag = IL(e, AST_TAG);
    if (tag == AST_IDENT_EXPR) {
        char *name = (char *)IL(e, AST_F0);
        unsigned long v = (unsigned long)kcc_ht_get(kcc_ir_locals, name, kcc_strlen(name));
        if (v) return (v & ~0x8000000000000000UL) - 1;
        void *g = kcc_ir_alloc_instr(IR_GLOBAL_REF);
        IL(g, IR_SRC1) = (unsigned long)name;
        IL(g, IR_TYPE) = (unsigned long)kcc_type_int_s;
        unsigned long rv = kcc_ir_next_vreg();
        IL(g, IR_DEST) = rv;
        kcc_ir_emit(g);
        return rv;
    }
    if (tag == AST_CALL_EXPR) return kcc_ir_build_call(e);
    if (tag == AST_MEMBER) return kcc_ir_build_member_addr(e);
    if (tag == AST_SUBSCRIPT) return kcc_ir_build_subscript_addr(e);
    if (tag == AST_COMPOUND_LIT) return kcc_ir_build_compound_lit(e);
    if (tag == AST_COMMA_EXPR) {
        kcc_ir_build_expr((void *)IL(e, AST_F0));
        return kcc_ir_build_struct_addr((void *)IL(e, AST_F1));
    }
    if (tag == AST_ASSIGN_EXPR) return kcc_ir_build_assign(e);
    if (tag == AST_UNARY_EXPR) {
        if (IL(e, AST_F0) == TOK_STAR) return kcc_ir_build_expr((void *)IL(e, AST_F1));
        return kcc_ir_build_expr(e);
    }
    return kcc_ir_build_expr(e);                  /* pointer operand → address */
}

unsigned long kcc_ir_initlist_count(void *list) {
    void *el = (void *)IL(list, AST_F0);
    unsigned long idx = 0, max = 0;
    while (el) {
        if (IL(el, AST_TAG) == AST_DESIGNATOR && !IL(el, AST_F1))
            idx = kcc_eval_const_int((void *)IL(el, AST_F0)); /* [i]= : evaluate the index expr */
        idx++;
        if (idx > max) max = idx;
        el = (void *)IL(el, AST_F4);
    }
    return max;
}

void kcc_ir_emit_indexed_store(unsigned long base, unsigned long off, unsigned long value, unsigned long width) {
    void *c = kcc_ir_alloc_instr(IR_CONST);
    IL(c, IR_TYPE) = (unsigned long)kcc_type_int_s;
    IL(c, IR_SRC1) = off;
    unsigned long ov = kcc_ir_next_vreg();
    IL(c, IR_DEST) = ov;
    kcc_ir_emit(c);
    void *g = kcc_ir_alloc_instr(IR_GEP);
    IL(g, IR_TYPE) = (unsigned long)kcc_type_int_s;
    IL(g, IR_SRC1) = base;
    IL(g, IR_SRC2) = ov;
    unsigned long av = kcc_ir_next_vreg();
    IL(g, IR_DEST) = av;
    kcc_ir_emit(g);
    void *st = kcc_ir_alloc_instr(IR_STORE);
    IL(st, IR_TYPE) = (unsigned long)kcc_type_int_s;
    IL(st, IR_SRC1) = value;
    IL(st, IR_SRC2) = av;
    IL(st, IR_DEST) = width;
    kcc_ir_emit(st);
}
@}

A designated initializer names its target member with \texttt{kcc\_ir\_field\_index},
which walks a struct or union's field list and returns the zero-based position
of the named member (so the positional offset machinery of
\texttt{kcc\_ir\_subobj} can be reused), or $-1$.  An \emph{anonymous} member---an
unnamed \texttt{struct}/\texttt{union} whose own members are promoted into the
enclosing type (C17 6.7.2.1p13)---carries a \texttt{NULL} name, so the
by-name scan must skip it rather than hand \texttt{NULL} to
\texttt{kcc\_strcmp}.  Skipping alone would lose the promoted names, so
\texttt{kcc\_ir\_type\_has\_member} answers, recursively, whether a name is
reachable through a type's anonymous members, and \texttt{kcc\_ir\_anon\_containing}
returns the position of the anonymous member that holds it.
\texttt{kcc\_ir\_resolve\_designator} uses the pair to \emph{descend}: when a
\texttt{.name} is not a direct field it steps into the anonymous member that
contains it---accumulating that member's byte offset and continuing from its
type---until the name resolves to a direct field.  The first anonymous member
entered is recorded as \texttt{first\_pos} so the positional cursor resumes at
the right outer slot after the designated element.  A name that is genuinely
absent still yields $-1$ and the legacy out-of-range path, unchanged.

@l c
@d Selfhost: ir aggregates @{
long kcc_ir_field_index(void *agg, const char *name) {
    void *sd = (void *)IL(agg, TY_F0);
    if (!sd) return -1;
    void *field = (void *)IL(sd, AST_F1);
    long idx = 0;
    while (field) {
        const char *fn = (const char *)IL(field, AST_F1);
        if (fn && kcc_strcmp(fn, name) == 0) return idx;
        field = (void *)IL(field, AST_F4);
        idx++;
    }
    return -1;
}

unsigned long kcc_ir_type_has_member(void *ty, const char *name) {
    if (!ty) return 0;
    unsigned long k = IL(ty, TY_KIND);
    if (k != TY_STRUCT && k != TY_UNION) return 0;
    void *sd = (void *)IL(ty, TY_F0);
    if (!sd) return 0;
    void *field = (void *)IL(sd, AST_F1);
    while (field) {
        const char *fn = (const char *)IL(field, AST_F1);
        if (fn) {
            if (kcc_strcmp(fn, name) == 0) return 1;
        } else {
            void *fts = (void *)IL(field, AST_F0);
            void *aty = fts ? kcc_sema_resolve_type(fts) : 0;
            if (kcc_ir_type_has_member(aty, name)) return 1;
        }
        field = (void *)IL(field, AST_F4);
    }
    return 0;
}

long kcc_ir_anon_containing(void *agg, const char *name) {
    void *sd = (void *)IL(agg, TY_F0);
    if (!sd) return -1;
    void *field = (void *)IL(sd, AST_F1);
    long idx = 0;
    while (field) {
        const char *fn = (const char *)IL(field, AST_F1);
        if (!fn) {
            void *fts = (void *)IL(field, AST_F0);
            void *aty = fts ? kcc_sema_resolve_type(fts) : 0;
            if (kcc_ir_type_has_member(aty, name)) return idx;
        }
        field = (void *)IL(field, AST_F4);
        idx++;
    }
    return -1;
}

void *kcc_ir_subobj(void *agg, unsigned long idx, unsigned long *out_off) {
    kcc_ir_member_field = 0;
    if (!agg) { *out_off = idx << 3; return 0; }
    unsigned long k = IL(agg, TY_KIND);
    if (k == TY_ARRAY) {
        void *et = (void *)IL(agg, TY_F0);
        *out_off = idx * kcc_type_layout(et);
        return et;
    }
    if (k == TY_STRUCT || k == TY_UNION) {
        kcc_type_layout(agg);
        void *sd = (void *)IL(agg, TY_F0);
        if (!sd) { *out_off = 0; return 0; }
        void *field = (void *)IL(sd, AST_F1);
        while (field && idx) { field = (void *)IL(field, AST_F4); idx--; }
        if (!field) { *out_off = 0; return 0; }
        kcc_ir_member_field = field;
        *out_off = IL(field, AST_F3);
        void *fts = (void *)IL(field, AST_F0);
        return fts ? kcc_sema_resolve_type(fts) : 0;
    }
    *out_off = idx * kcc_type_layout(agg);
    return agg;                                   /* scalar sub-object is itself */
}

struct desig_res kcc_ir_resolve_designator(void *agg, unsigned long base_off, void *desig) {
    void *cur_type = agg;
    unsigned long cur_off = base_off;
    unsigned long first_pos = (unsigned long)-1;
    void *leaf_field = 0;
    while (desig) {
        unsigned long pos;
        unsigned long outer_pos;
        if (IL(desig, AST_F1)) {
            const char *nm = (const char *)IL(desig, AST_F0);
            long p = kcc_ir_field_index(cur_type, nm);
            /* A `.name` that is not a direct member of cur_type but lives inside
               an unnamed struct/union member is reached by first stepping into
               that member (C17 6.7.2.1p13): descend, accumulating its offset,
               until the name resolves to a direct field. */
            while (p < 0) {
                long ap = kcc_ir_anon_containing(cur_type, nm);
                if (ap < 0) break;
                unsigned long aoff;
                void *asub = kcc_ir_subobj(cur_type, (unsigned long)ap, &aoff);
                cur_off += aoff;
                cur_type = asub;
                if (first_pos == (unsigned long)-1) first_pos = (unsigned long)ap;
                p = kcc_ir_field_index(cur_type, nm);
            }
            pos = (unsigned long)p;
            outer_pos = pos;
        } else {
            pos = kcc_eval_const_int((void *)IL(desig, AST_F0)); /* [i] index expr */
            outer_pos = pos;
        }
        unsigned long off;
        void *sub = kcc_ir_subobj(cur_type, pos, &off);
        cur_off += off;
        cur_type = sub;
        leaf_field = kcc_ir_member_field;
        if (first_pos == (unsigned long)-1) first_pos = outer_pos;
        desig = (void *)IL(desig, AST_F2);
    }
    struct desig_res r;
    r.off = cur_off; r.sub_type = cur_type; r.first_pos = first_pos; r.field = leaf_field;
    return r;
}

unsigned long kcc_ir_agg_count(void *ty) {
    if (!ty) return 1;
    unsigned long k = IL(ty, TY_KIND);
    if (k == TY_ARRAY) return IL(ty, TY_F1);
    if (k == TY_STRUCT) {
        void *sd = (void *)IL(ty, TY_F0);
        if (!sd) return 1;
        void *field = (void *)IL(sd, AST_F1);
        unsigned long n = 0;
        while (field) { n++; field = (void *)IL(field, AST_F4); }
        return n;
    }
    return 1;
}

void kcc_ir_elem_off_width(void *ty, unsigned long idx, unsigned long *out_off, unsigned long *out_width) {
    kcc_ir_member_field = 0;
    if (!ty) { *out_off = idx << 3; *out_width = 0; return; }
    unsigned long k = IL(ty, TY_KIND);
    if (k == TY_STRUCT || k == TY_UNION) {
        kcc_type_layout(ty);
        void *sd = (void *)IL(ty, TY_F0);
        if (!sd) { *out_off = 0; *out_width = 0; return; }
        void *field = (void *)IL(sd, AST_F1);
        while (field && idx) { field = (void *)IL(field, AST_F4); idx--; }
        if (!field) { *out_off = 0; *out_width = 0; return; }
        kcc_ir_member_field = field;
        *out_off = IL(field, AST_F3);
        void *fts = (void *)IL(field, AST_F0);
        *out_width = fts ? kcc_ir_store_width(kcc_sema_resolve_type(fts)) : 0;
        return;
    }
    *out_off = idx * kcc_type_layout(ty);
    *out_width = kcc_ir_store_width(ty);
}

void kcc_ir_fill_one(void *ty, unsigned long base, unsigned long off, void *node, void *field) {
    if (!node) return;
    if (IL(node, AST_TAG) == AST_INIT_LIST) {
        kcc_ir_fill_list(ty, base, off, (void *)IL(node, AST_F0));
        return;
    }
    if (ty) {
        unsigned long k = IL(ty, TY_KIND);
        if (k == TY_STRUCT || k == TY_UNION || k == TY_ARRAY) {
            kcc_ir_fill(ty, base, off, node);
            return;
        }
    }
    unsigned long val = kcc_ir_build_expr(node);
    void *from = (void *)IL(node, AST_F3);
    if (from && ty) val = kcc_ir_convert(val, from, ty);
    kcc_ir_member_field = field;
    kcc_ir_store_elem(base, off, val, kcc_ir_store_width(ty));
}

void *kcc_ir_fill(void *ty, unsigned long base, unsigned long off, void *elem) {
    if (!elem) return elem;
    unsigned long agg = 0;
    if (ty) {
        unsigned long k = IL(ty, TY_KIND);
        if (k == TY_STRUCT || k == TY_UNION || k == TY_ARRAY) agg = 1;
    }
    if (!agg) {
        kcc_ir_fill_one(ty, base, off, elem, 0);
        return (void *)IL(elem, AST_F4);
    }
    unsigned long etag = IL(elem, AST_TAG);
    if (etag != AST_INIT_LIST) {
        if (etag == AST_STR_LIT && IL(ty, TY_KIND) == TY_ARRAY) {
            unsigned long cap = kcc_type_layout(ty);
            const char *sp = (const char *)IL(elem, AST_F0);
            unsigned long len = IL(elem, AST_F1);
            if (cap && len > cap) len = cap;
            unsigned long i = 0;
            while (i < len) {
                unsigned long c = kcc_ir_emit_const((unsigned char)sp[i]);
                kcc_ir_emit_indexed_store(base, off + i, c, 1);
                i++;
            }
            return (void *)IL(elem, AST_F4);
        }
        if (!kcc_type_layout(ty)) {               /* zero-size aggregate element */
            kcc_ir_build_struct_addr(elem);       /* evaluate for side effects */
            return (void *)IL(elem, AST_F4);
        }
        void *et = (void *)IL(elem, AST_F3);
        if (et) {
            unsigned long ek = IL(et, TY_KIND);
            if (ek == TY_STRUCT || ek == TY_UNION) {
                unsigned long dst = kcc_ir_emit_gep_const(base, off);
                unsigned long src = kcc_ir_build_struct_addr(elem);
                kcc_ir_emit_struct_copy(src, dst, kcc_type_layout(ty));
                return (void *)IL(elem, AST_F4);
            }
        }
    }
    unsigned long count = kcc_ir_agg_count(ty);
    unsigned long cursor = 0;
    while (elem && cursor < count) {
        unsigned long so;
        void *sub = kcc_ir_subobj(ty, cursor, &so);
        elem = kcc_ir_fill(sub, base, off + so, elem);
        cursor++;
    }
    return elem;
}

void kcc_ir_fill_list(void *ty, unsigned long base, unsigned long base_off, void *head) {
    void *elem = head;
    unsigned long cursor = 0;
    while (elem) {
        if (IL(elem, AST_TAG) == AST_DESIGNATOR) {
            if (IL(elem, AST_F1) == 2) {          /* GNU array range [lo ... hi] = v */
                unsigned long lo = kcc_eval_const_int((void *)IL(elem, AST_F0));
                unsigned long hi = kcc_eval_const_int((void *)IL(elem, AST_F2));
                void *val = (void *)IL(elem, AST_F3);
                for (unsigned long pos = lo; pos <= hi; pos++) {
                    unsigned long off;
                    void *sub = kcc_ir_subobj(ty, pos, &off);
                    kcc_ir_fill_one(sub, base, base_off + off, val, kcc_ir_member_field);
                }
                cursor = hi + 1;
                elem = (void *)IL(elem, AST_F4);
                continue;
            }
            struct desig_res dr = kcc_ir_resolve_designator(ty, base_off, elem);
            cursor = dr.first_pos;
            kcc_ir_fill_one(dr.sub_type, base, dr.off, (void *)IL(elem, AST_F3), dr.field);
            cursor++;
            elem = (void *)IL(elem, AST_F4);
            continue;
        }
        unsigned long off;
        void *sub = kcc_ir_subobj(ty, cursor, &off);
        unsigned long abs = base_off + off;
        void *field = kcc_ir_member_field;
        if (field && !IL(field, AST_F1) && IL(field, AST_F2)) {   /* unnamed bit-field */
            cursor++;
            continue;
        }
        if (!sub) {                               /* past the aggregate */
            elem = (void *)IL(elem, AST_F4);
            cursor++;
            continue;
        }
        unsigned long elide = 0;
        if (IL(elem, AST_TAG) != AST_INIT_LIST) {
            unsigned long k = IL(sub, TY_KIND);
            if (k == TY_STRUCT || k == TY_UNION || k == TY_ARRAY) elide = 1;
        }
        if (elide) {
            elem = kcc_ir_fill(sub, base, abs, elem);
        } else {
            kcc_ir_fill_one(sub, base, abs, elem, field);
            elem = (void *)IL(elem, AST_F4);
        }
        cursor++;
    }
}

unsigned long kcc_ir_build_compound_lit(void *cl) {
    void *ty = kcc_sema_resolve_type((void *)IL(cl, AST_F0));
    if (!ty) return 0;
    unsigned long slots = (kcc_type_layout(ty) + 7) >> 3;
    if (!slots) slots = 1;
    void *a = kcc_ir_alloc_instr(IR_ALLOCA);
    IL(a, IR_TYPE) = (unsigned long)ty;
    IL(a, IR_SRC1) = slots;
    unsigned long base = kcc_ir_next_vreg();
    IL(a, IR_DEST) = base;
    kcc_ir_emit(a);
    void *c = kcc_ir_alloc_instr(IR_CONST);
    IL(c, IR_TYPE) = (unsigned long)kcc_type_int_s;
    IL(c, IR_SRC1) = 0;
    unsigned long zv = kcc_ir_next_vreg();
    IL(c, IR_DEST) = zv;
    kcc_ir_emit(c);
    unsigned long i = 0;
    while (i < slots) { kcc_ir_emit_indexed_store(base, i << 3, zv, 0); i++; }
    void *init = (void *)IL(cl, AST_F1);
    if (init) {
        if (IL(init, AST_TAG) == AST_INIT_LIST)
            kcc_ir_fill_list(ty, base, 0, (void *)IL(init, AST_F0));
        else
            kcc_ir_fill_one(ty, base, 0, init, 0);
    }
    return base;
}

const char *kcc_ir_static_name(void *decl) {
    char *b = kcc_arena_alloc(24);
    b[0] = 's'; b[1] = 'l'; b[2] = '_';
    unsigned long v = (unsigned long)decl;
    char *p = b + 3;
    long shift = 60;
    while (shift >= 0) {
        unsigned long nib = (v >> shift) & 0xf;
        *p = (nib < 10) ? (char)('0' + nib) : (char)('a' + (nib - 10));
        p++;
        shift -= 4;
    }
    *p = 0;
    return b;
}

void kcc_ir_build_var_decl(void *decl) {
    void *name = (void *)IL(decl, AST_F1);
    if (!name) return;
    unsigned long sc = IL(decl, AST_F3);
    unsigned long keylen = kcc_strlen((const char *)name);
    if (sc == 3) {                                /* static: hoist to a global */
        const char *mangled = kcc_ir_static_name(decl);
        kcc_ht_put(kcc_ir_statics, name, keylen, (void *)mangled);
        void *tn = (void *)IL(decl, AST_F0);
        if (!tn) return;
        void *rt = kcc_sema_resolve_type(tn);
        if (!rt) return;
        kcc_ht_put(kcc_ir_static_types, name, keylen, rt);
        return;
    }
    if (sc == 2) {                                /* block-scope extern */
        kcc_ir_locals_put((const char *)name, keylen, 0);
        return;
    }
    void *tn = (void *)IL(decl, AST_F0);
    void *ty = tn ? kcc_sema_resolve_type(tn) : 0;
    if (!ty) ty = kcc_type_int_s;
    unsigned long ptrflag = (IL(ty, TY_KIND) == TY_PTR) ? 1 : 0;
    unsigned long slots = 1;
    void *alloca_type = ty;
    unsigned long k = IL(ty, TY_KIND);
    if (k == TY_ARRAY) {
        unsigned long len = IL(ty, TY_F1);
        void *et = (void *)IL(ty, TY_F0);
        if (!len) {
            void *init = (void *)IL(decl, AST_F2);
            if (init && IL(init, AST_TAG) == AST_INIT_LIST) len = kcc_ir_initlist_count(init);
        }
        alloca_type = et;
        if (len) slots = (len * kcc_type_layout(et) + 7) >> 3;
        else slots = 0;
    } else if (k == TY_STRUCT || k == TY_UNION) {
        slots = kcc_ir_type_slots(ty);
    }
    void *a = kcc_ir_alloc_instr(IR_ALLOCA);
    IL(a, IR_TYPE) = (unsigned long)alloca_type;
    IL(a, IR_SRC1) = slots;
    unsigned long base = kcc_ir_next_vreg();
    IL(a, IR_DEST) = base;
    kcc_ir_emit_entry(a);
    unsigned long lv = base + 1;
    if (ptrflag) lv = lv | 0x8000000000000000UL;
    kcc_ir_locals_put((const char *)name, keylen, lv);
    void *init = (void *)IL(decl, AST_F2);
    if (!init) return;
    unsigned long itag = IL(init, AST_TAG);
    if (itag == AST_INIT_LIST) {
        void *aggty = kcc_sema_resolve_type((void *)IL(decl, AST_F0));
        void *c = kcc_ir_alloc_instr(IR_CONST);
        IL(c, IR_TYPE) = (unsigned long)kcc_type_int_s;
        IL(c, IR_SRC1) = 0;
        unsigned long zv = kcc_ir_next_vreg();
        IL(c, IR_DEST) = zv;
        kcc_ir_emit(c);
        unsigned long i = 0;
        while (i < slots) { kcc_ir_emit_indexed_store(base, i << 3, zv, 0); i++; }
        kcc_ir_fill_list(aggty, base, 0, (void *)IL(init, AST_F0));
        return;
    }
    if (itag == AST_STR_LIT) {
        void *rt = kcc_sema_resolve_type((void *)IL(decl, AST_F0));
        if (rt && IL(rt, TY_KIND) == TY_ARRAY) {
            const char *sp = (const char *)IL(init, AST_F0);
            unsigned long slen = IL(init, AST_F1);
            unsigned long alen = IL(rt, TY_F1);
            if (!alen) alen = slen + 1;
            kcc_ir_emit_string_init(base, sp, slen, alen, 1);
            return;
        }
    }
    if (k == TY_STRUCT || k == TY_UNION) {
        unsigned long src = kcc_ir_build_struct_addr(init);
        kcc_ir_emit_struct_copy(src, base, kcc_type_layout(ty));
        return;
    }
    void *from = (void *)IL(init, AST_F3);
    unsigned long val = kcc_ir_build_expr(init);
    val = kcc_ir_convert(val, from, ty);
    void *st = kcc_ir_alloc_instr(IR_STORE);
    IL(st, IR_TYPE) = (unsigned long)ty;
    IL(st, IR_SRC1) = val;
    IL(st, IR_SRC2) = base;
    IL(st, IR_DEST) = kcc_ir_store_width(ty);
    kcc_ir_emit(st);
    /* Record a scalar-integer local whose initialiser is an integer constant
       expression, so an `"i"' inline-asm operand naming it (the kernel's
       `__auto_type __flags = ...' passed to WARN's `"i"(flags)') folds to the
       constant instead of being materialised in a register.  x86 only. */
    if (kcc_target) {
        unsigned long kk = IL(ty, TY_KIND);
        if (((kk >= TY_BOOL && kk <= TY_LLONG) || kk == TY_ENUM) &&
            kcc_expr_is_ice(init))
            kcc_ir_local_const_set((const char *)name, keylen, lv,
                                   (unsigned long)kcc_eval_const_int(init));
    }
}
@}

\section{Control Flow}

Each control-flow builder allocates fresh blocks and wires them with
\texttt{IR\_BR}/\texttt{IR\_BR\_COND}, marking a block terminated after its
terminator so nothing is appended past a branch.  \texttt{switch} scans its body
twice (allocate label blocks, emit the dispatch chain) then builds the body once
so \texttt{case}/\texttt{default} labels place themselves.  A case whose label
carries a high bound in \texttt{f3} is a GNU range and dispatches through two
signed comparisons (\texttt{>=~LOW} then \texttt{<=~HIGH}) with a middle block,
rather than the single equality test of an ordinary case.  The constant
evaluator folds integer constant expressions for case values and array bounds,
including \texttt{offsetof}-style null-based address constants: \texttt{is\_ice}
accepts \verb|&(((T*)0)->m)| and \texttt{eval\_const\_int} reduces it to the
member's byte offset (via \texttt{eval\_addr}), so a bound such as
\verb|char b[sizeof(P)-offsetof(P,tail)]| lays out at its true size rather than
being rejected as a variable-length array.  It also folds the bit-counting
builtins---\texttt{\_\_builtin\_clz}/\texttt{ctz}/\texttt{popcount}/\texttt{ffs}
and their \texttt{l}/\texttt{ll} widths---and the \texttt{?:} operator, because
the kernel derives array bounds through \texttt{ilog2} and \texttt{BITS\_TO\_LONGS},
which expand to \verb|__builtin_constant_p(n) ? (63 - __builtin_clzll(n)) : ...|;
without folding the clz call and the ternary, such a bound looks variable and the
array is wrongly rejected as a VLA.

When the controlling expression is itself an integer constant expression, the
whole dispatch is dead weight: only one arm can ever run, yet emitting every
arm is exactly what forces kcc to lower the kernel's size-dispatched inline
asm.  \texttt{\_\_raw\_cmpxchg} switches on a compile-time-constant
\texttt{sizeof} and each arm carries a differently-sized \texttt{cmpxchg}; GCC
inlines with a literal size, folds the switch, and emits only the live arm,
whereas kcc---not inlining---would render the whole switch including the
byte-wide \texttt{cmpxchgb} on a wider register.  So \texttt{build\_switch}
folds a constant switch the way \texttt{build\_if} folds a constant condition:
it evaluates the control value, finds the matching \texttt{case} (or
\texttt{default}, or nothing), and builds only that arm as straight-line code,
honouring fall-through into later arms and stopping at the first \texttt{break}.

The fold applies only when the body is a single compound whose \texttt{case} and
\texttt{default} labels are all direct children---\texttt{is\_flat} confirms a
deep scan finds no label nested inside an arm---so that fall-through is a simple
walk of the sibling list and no nested label is ever built without its
dispatch block.  Anything more intricate falls back to the ordinary two-scan
lowering, which is always correct.

@l c
@d Selfhost: ir control @{
static void ir_brcond(unsigned long cond, void *tb, void *fb) {
    void *bc = kcc_ir_alloc_instr(IR_BR_COND);
    IL(bc, IR_DEST) = cond;
    IL(bc, IR_SRC1) = IL(tb, BB_ID);
    IL(bc, IR_SRC2) = IL(fb, BB_ID);
    kcc_ir_emit(bc);
    IL(kcc_ir_cur_bb, BB_FLAGS) = IL(kcc_ir_cur_bb, BB_FLAGS) | BB_FLAG_TERMINATED;
}

void kcc_ir_build_if(void *s) {
    /* A compile-time-constant condition selects one branch; build only that
       one and drop the other entirely.  The kernel's size-dispatched inline
       asm depends on this: the untaken branch (e.g. a byte `cmpxchgb` reached
       only when `size==1`) would otherwise be lowered and emit an assembler
       error even though it can never run. */
    void *cond_e = (void *)IL(s, AST_F0);
    if (kcc_expr_is_ice(cond_e)) {
        void *taken = kcc_eval_const_int(cond_e) ? (void *)IL(s, AST_F1)
                                                 : (void *)IL(s, AST_F2);
        if (taken) kcc_ir_build_stmt(taken);
        return;
    }
    unsigned long cond = kcc_ir_build_expr(cond_e);
    void *then_bb = kcc_ir_alloc_bb();
    void *else_node = (void *)IL(s, AST_F2);
    if (else_node) {
        void *else_bb = kcc_ir_alloc_bb();
        void *merge_bb = kcc_ir_alloc_bb();
        ir_brcond(cond, then_bb, else_bb);
        kcc_ir_set_bb(then_bb);
        kcc_ir_build_stmt((void *)IL(s, AST_F1));
        kcc_ir_branch_to(merge_bb);
        kcc_ir_set_bb(else_bb);
        kcc_ir_build_stmt(else_node);
        kcc_ir_branch_to(merge_bb);
        kcc_ir_set_bb(merge_bb);
    } else {
        void *merge_bb = kcc_ir_alloc_bb();
        ir_brcond(cond, then_bb, merge_bb);
        kcc_ir_set_bb(then_bb);
        kcc_ir_build_stmt((void *)IL(s, AST_F1));
        kcc_ir_branch_to(merge_bb);
        kcc_ir_set_bb(merge_bb);
    }
}

void kcc_ir_build_while(void *s) {
    void *cond_bb = kcc_ir_alloc_bb();
    void *body_bb = kcc_ir_alloc_bb();
    void *exit_bb = kcc_ir_alloc_bb();
    kcc_ir_branch_to(cond_bb);
    kcc_ir_set_bb(cond_bb);
    unsigned long cond = kcc_ir_build_expr((void *)IL(s, AST_F0));
    ir_brcond(cond, body_bb, exit_bb);
    kcc_loop_push(IL(exit_bb, BB_ID), IL(cond_bb, BB_ID));
    kcc_ir_set_bb(body_bb);
    kcc_ir_build_stmt((void *)IL(s, AST_F1));
    kcc_loop_pop();
    kcc_ir_branch_to(cond_bb);
    kcc_ir_set_bb(exit_bb);
}

void kcc_ir_build_do(void *s) {
    void *body_bb = kcc_ir_alloc_bb();
    void *cond_bb = kcc_ir_alloc_bb();
    void *exit_bb = kcc_ir_alloc_bb();
    kcc_ir_branch_to(body_bb);
    kcc_loop_push(IL(exit_bb, BB_ID), IL(cond_bb, BB_ID));
    kcc_ir_set_bb(body_bb);
    kcc_ir_build_stmt((void *)IL(s, AST_F0));
    kcc_loop_pop();
    kcc_ir_branch_to(cond_bb);
    kcc_ir_set_bb(cond_bb);
    unsigned long cond = kcc_ir_build_expr((void *)IL(s, AST_F1));
    ir_brcond(cond, body_bb, exit_bb);
    kcc_ir_set_bb(exit_bb);
}

void kcc_ir_build_for(void *s) {
    void *init = (void *)IL(s, AST_F0);
    if (init) kcc_ir_build_stmt(init);
    void *cond_bb = kcc_ir_alloc_bb();
    void *body_bb = kcc_ir_alloc_bb();
    void *incr_bb = kcc_ir_alloc_bb();
    void *exit_bb = kcc_ir_alloc_bb();
    kcc_ir_branch_to(cond_bb);
    kcc_ir_set_bb(cond_bb);
    void *cnode = (void *)IL(s, AST_F1);
    if (cnode) {
        unsigned long cond = kcc_ir_build_expr(cnode);
        ir_brcond(cond, body_bb, exit_bb);
    } else {
        kcc_ir_branch_to(body_bb);
    }
    kcc_loop_push(IL(exit_bb, BB_ID), IL(incr_bb, BB_ID));
    kcc_ir_set_bb(body_bb);
    void *body = (void *)IL(s, AST_F3);
    if (body) kcc_ir_build_stmt(body);
    kcc_loop_pop();
    kcc_ir_branch_to(incr_bb);
    kcc_ir_set_bb(incr_bb);
    void *incr = (void *)IL(s, AST_F2);
    if (incr) kcc_ir_build_expr(incr);
    kcc_ir_branch_to(cond_bb);
    kcc_ir_set_bb(exit_bb);
}

/* The kernel computes array bounds (ilog2/const_ilog2/BITS_TO_LONGS, hash
   orders) through the bit-counting builtins, so they must fold in a constant
   expression.  kcc_call_foldable_builtin recognises the call; kcc_call_builtin_value
   evaluates it from the constant argument. */
static unsigned long kcc_clz_w(unsigned long x, unsigned long width) {
    x &= (width >= 64) ? ~0UL : ((1UL << width) - 1);
    if (x == 0) return width;
    unsigned long n = 0;
    while (!(x & (1UL << (width - 1)))) { x <<= 1; n++; }
    return n;
}
static unsigned long kcc_ctz_w(unsigned long x, unsigned long width) {
    x &= (width >= 64) ? ~0UL : ((1UL << width) - 1);
    if (x == 0) return width;
    unsigned long n = 0;
    while (!(x & 1UL)) { x >>= 1; n++; }
    return n;
}
static unsigned long kcc_popcount_w(unsigned long x) {
    unsigned long n = 0;
    while (x) { n += x & 1UL; x >>= 1; }
    return n;
}
unsigned long kcc_call_foldable_builtin(void *n) {
    void *callee = (void *)IL(n, AST_F0);
    if (!callee || IL(callee, AST_TAG) != AST_IDENT_EXPR) return 0;
    const char *m = (const char *)IL(callee, AST_F0);
    if (!m) return 0;
    if (kcc_strcmp(m, "__builtin_clz") == 0 || kcc_strcmp(m, "__builtin_clzl") == 0 ||
        kcc_strcmp(m, "__builtin_clzll") == 0 || kcc_strcmp(m, "__builtin_ctz") == 0 ||
        kcc_strcmp(m, "__builtin_ctzl") == 0 || kcc_strcmp(m, "__builtin_ctzll") == 0 ||
        kcc_strcmp(m, "__builtin_popcount") == 0 || kcc_strcmp(m, "__builtin_popcountl") == 0 ||
        kcc_strcmp(m, "__builtin_popcountll") == 0 || kcc_strcmp(m, "__builtin_ffs") == 0 ||
        kcc_strcmp(m, "__builtin_ffsl") == 0 || kcc_strcmp(m, "__builtin_ffsll") == 0)
        return 1;
    return 0;
}
unsigned long kcc_call_builtin_value(void *n) {
    const char *m = (const char *)IL((void *)IL(n, AST_F0), AST_F0);  /* "__builtin_..." */
    unsigned long x = kcc_eval_const_int((void *)IL(n, AST_F1));
    unsigned long len = kcc_strlen(m);
    unsigned long w = (m[len - 1] == 'l') ? 64 : 32;   /* an l/ll suffix widens to long */
    if (m[10] == 'c' && m[11] == 'l') return kcc_clz_w(x, w);           /* __builtin_clz*  */
    if (m[10] == 'c' && m[11] == 't') return kcc_ctz_w(x, w);           /* __builtin_ctz*  */
    if (m[10] == 'p') return kcc_popcount_w(x);                         /* __builtin_popcount* */
    return x ? kcc_ctz_w(x, w) + 1 : 0;                                 /* __builtin_ffs*  */
}

unsigned long kcc_eval_const_int(void *n) {
    if (!n) return 0;
    unsigned long tag = IL(n, AST_TAG);
    if (tag == AST_INT_LIT || tag == AST_CHAR_LIT) return IL(n, AST_F0);
    if (tag == AST_CALL_EXPR && kcc_call_is_bcp(n))
        return kcc_expr_is_ice((void *)IL(n, AST_F1)) ? 1 : 0;   /* __builtin_constant_p(x) */
    if (tag == AST_CALL_EXPR && kcc_call_foldable_builtin(n))
        return kcc_call_builtin_value(n);                        /* __builtin_clz/ctz/popcount/ffs */
    if (tag == AST_COND_EXPR)
        return kcc_eval_const_int((void *)IL(n, AST_F0))
               ? kcc_eval_const_int((void *)IL(n, AST_F1))
               : kcc_eval_const_int((void *)IL(n, AST_F2));
    if (tag == AST_PAREN_EXPR) return kcc_eval_const_int((void *)IL(n, AST_F0));
    if (tag == AST_CAST_EXPR) return kcc_eval_const_int((void *)IL(n, AST_F1));
    if (tag == AST_SIZEOF_EXPR) {
        void *op = (void *)IL(n, AST_F0);
        if (!op) return 0;
        void *ty;
        if (IL(n, AST_F1)) ty = kcc_sema_resolve_type(op);
        else { ty = (void *)IL(op, AST_F3); if (!ty) ty = kcc_sema_expr(op); }
        if (!ty) return 0;
        return kcc_type_layout(ty);
    }
    if (tag == AST_TYPES_COMPAT) {
        void *t1 = kcc_sema_resolve_type((void *)IL(n, AST_F0));
        void *t2 = kcc_sema_resolve_type((void *)IL(n, AST_F1));
        return kcc_type_compatible(t1, t2);
    }
    if (tag == AST_IDENT_EXPR) {
        char *name = (char *)IL(n, AST_F0);
        if (!name) return 0;
        void *sym = kcc_symtab_lookup(name, kcc_strlen(name));
        if (!sym) return 0;
        if (IL(sym, SYM_KIND) != SYM_ENUM_CONST) return 0;
        return IL(sym, SYM_VALUE);
    }
    if (tag == AST_UNARY_EXPR) {
        unsigned long op = IL(n, AST_F0);
        if (op == TOK_AMP) return kcc_eval_addr((void *)IL(n, AST_F1));  /* offsetof */
        long v = (long)kcc_eval_const_int((void *)IL(n, AST_F1));
        if (op == TOK_MINUS) return (unsigned long)(-v);
        if (op == TOK_TILDE) return (unsigned long)(~v);
        if (op == TOK_BANG) return v == 0 ? 1 : 0;
        return (unsigned long)v;
    }
    if (tag == AST_BINARY_EXPR) {
        unsigned long op = IL(n, AST_F0);
        long a = (long)kcc_eval_const_int((void *)IL(n, AST_F1));
        long b = (long)kcc_eval_const_int((void *)IL(n, AST_F2));
        if (op == TOK_PLUS) return (unsigned long)(a + b);
        if (op == TOK_MINUS) return (unsigned long)(a - b);
        if (op == TOK_STAR) return (unsigned long)(a * b);
        if (op == TOK_SLASH) return b ? (unsigned long)(a / b) : 0;
        if (op == TOK_PERCENT) return b ? (unsigned long)(a % b) : 0;
        /* Left-shift in the unsigned domain: a left shift of a negative signed
           value is undefined behaviour (\stdref{6.5.7}), and computing on the
           two's-complement bit pattern yields the value every target actually
           wants without tripping a sanitiser or inviting a miscompile.  The
           right shift stays signed---an arithmetic shift is well defined and is
           what a constant like `x >> 1' on a negative bound intends. */
        if (op == TOK_SHL) return (unsigned long)a << (b & 63);
        if (op == TOK_SHR) return (unsigned long)(a >> b);
        if (op == TOK_AMP) return (unsigned long)(a & b);
        if (op == TOK_PIPE) return (unsigned long)(a | b);
        if (op == TOK_CARET) return (unsigned long)(a ^ b);
        /* Relational and logical operators yield 0/1.  Comparisons are done
           signed (the common `int' case, and what a constant `if (x < 0)' or a
           GNU array-range bound relies on); without these the evaluator returned
           0 for every comparison, folding a true constant condition to false. */
        if (op == TOK_LT) return (long)a <  (long)b ? 1 : 0;
        if (op == TOK_GT) return (long)a >  (long)b ? 1 : 0;
        if (op == TOK_LE) return (long)a <= (long)b ? 1 : 0;
        if (op == TOK_GE) return (long)a >= (long)b ? 1 : 0;
        if (op == TOK_EQ) return a == b ? 1 : 0;
        if (op == TOK_NE) return a != b ? 1 : 0;
        if (op == TOK_AND) return (a && b) ? 1 : 0;
        if (op == TOK_OR)  return (a || b) ? 1 : 0;
        return 0;
    }
    return 0;
}

/* The integer value of the address of an lvalue whose base is a compile-time
   integer (an `offsetof`-style null-based address constant).  For `p->m` the
   base pointer's value is added to the member's byte offset; for `s.m` the
   address of `s` is; `&*p` collapses to the value of `p`. */
unsigned long kcc_eval_addr(void *n) {
    if (!n) return 0;
    unsigned long tag = IL(n, AST_TAG);
    if (tag == AST_PAREN_EXPR) return kcc_eval_addr((void *)IL(n, AST_F0));
    if (tag == AST_MEMBER) {
        void *obj = (void *)IL(n, AST_F0);
        unsigned long base = IL(n, AST_F2) ? kcc_eval_const_int(obj)  /* p->m */
                                           : kcc_eval_addr(obj);       /* s.m  */
        void *st = (void *)IL(obj, AST_F3);
        if (!st) st = kcc_sema_expr(obj);  /* base may be untyped during array-bound eval */
        if (st && IL(st, TY_KIND) == TY_PTR) st = (void *)IL(st, TY_F0);
        unsigned long off = 0;
        if (st && (IL(st, TY_KIND) == TY_STRUCT || IL(st, TY_KIND) == TY_UNION)) {
            kcc_type_layout(st);
            struct kcc_member_res mr = kcc_type_find_member(st, (const char *)IL(n, AST_F1));
            if (mr.field) off = mr.off;
        }
        return base + off;
    }
    if (tag == AST_UNARY_EXPR && IL(n, AST_F0) == TOK_STAR)
        return kcc_eval_const_int((void *)IL(n, AST_F1));
    return 0;
}

/* Whether the address of an lvalue reduces to an integer constant expression:
   its ultimate base must be a constant pointer, as in `&(((T*)0)->m)`. */
unsigned long kcc_addr_is_iconst(void *n) {
    if (!n) return 0;
    unsigned long tag = IL(n, AST_TAG);
    if (tag == AST_PAREN_EXPR) return kcc_addr_is_iconst((void *)IL(n, AST_F0));
    if (tag == AST_MEMBER)
        return IL(n, AST_F2) ? kcc_expr_is_ice((void *)IL(n, AST_F0))    /* p->m */
                             : kcc_addr_is_iconst((void *)IL(n, AST_F0)); /* s.m  */
    if (tag == AST_UNARY_EXPR && IL(n, AST_F0) == TOK_STAR)
        return kcc_expr_is_ice((void *)IL(n, AST_F1));
    return 0;
}

unsigned long kcc_expr_is_ice(void *n) {
    if (!n) return 1;
    unsigned long tag = IL(n, AST_TAG);
    if (tag == AST_INT_LIT || tag == AST_CHAR_LIT ||
        tag == AST_SIZEOF_EXPR || tag == AST_ALIGNOF_EXPR) return 1;
    if (tag == AST_PAREN_EXPR) return kcc_expr_is_ice((void *)IL(n, AST_F0));
    if (tag == AST_CAST_EXPR) return kcc_expr_is_ice((void *)IL(n, AST_F1));
    if (tag == AST_UNARY_EXPR) {
        unsigned long op = IL(n, AST_F0);
        if (op == TOK_AMP) return kcc_addr_is_iconst((void *)IL(n, AST_F1));  /* offsetof */
        if (op == TOK_STAR) return 0;                                        /* deref */
        return kcc_expr_is_ice((void *)IL(n, AST_F1));
    }
    if (tag == AST_BINARY_EXPR) {
        if (!kcc_expr_is_ice((void *)IL(n, AST_F1))) return 0;
        return kcc_expr_is_ice((void *)IL(n, AST_F2));
    }
    if (tag == AST_COND_EXPR) {
        void *cond = (void *)IL(n, AST_F0);
        if (!kcc_expr_is_ice(cond)) return 0;
        /* A constant condition selects one branch; only that branch need be a
           constant expression (\stdref{6.6}), so the kernel's
           `__builtin_constant_p(n) ? <const> : __ilog2_u32(n)` is constant even
           though its else branch is a function call. */
        return kcc_eval_const_int(cond) ? kcc_expr_is_ice((void *)IL(n, AST_F1))
                                        : kcc_expr_is_ice((void *)IL(n, AST_F2));
    }
    if (tag == AST_IDENT_EXPR) {
        char *name = (char *)IL(n, AST_F0);
        if (!name) return 0;
        void *sym = kcc_symtab_lookup(name, kcc_strlen(name));
        if (!sym) return 0;
        if (IL(sym, SYM_KIND) == SYM_ENUM_CONST) return 1;
        return 0;
    }
    /* __builtin_constant_p(x) is itself a constant (0 or 1), so it is an
       integer constant expression regardless of x.  The kernel gates whole
       code paths on it (`__builtin_constant_p(nr) ? ... : ...`). */
    if (tag == AST_CALL_EXPR && kcc_call_is_bcp(n)) return 1;
    /* A foldable bit-counting builtin is an integer constant expression when its
       argument is (the kernel's ilog2/BITS_TO_LONGS array bounds). */
    if (tag == AST_CALL_EXPR && kcc_call_foldable_builtin(n))
        return kcc_expr_is_ice((void *)IL(n, AST_F1));
    return 0;
}

/* True when n is a call to __builtin_constant_p. */
unsigned long kcc_call_is_bcp(void *n) {
    void *callee = (void *)IL(n, AST_F0);
    if (!callee || IL(callee, AST_TAG) != AST_IDENT_EXPR) return 0;
    char *cn = (char *)IL(callee, AST_F0);
    return cn && kcc_strcmp(cn, "__builtin_constant_p") == 0;
}

/* Allocate a block for every case/default label reachable in a switch body. */
void kcc_ir_sw_scan(void *stmt) {
    if (!stmt) return;
    unsigned long tag = IL(stmt, AST_TAG);
    if (tag == AST_CASE_STMT) {
        IL(stmt, AST_F2) = (unsigned long)kcc_ir_alloc_bb();
        kcc_ir_sw_scan((void *)IL(stmt, AST_F1));
    } else if (tag == AST_DEFAULT_STMT) {
        void *bb = kcc_ir_alloc_bb();
        IL(stmt, AST_F1) = (unsigned long)bb;
        kcc_sw_default_bb = bb;
        kcc_ir_sw_scan((void *)IL(stmt, AST_F0));
    } else if (tag == AST_COMPOUND) {
        void *it = (void *)IL(stmt, AST_F0);
        while (it) { kcc_ir_sw_scan(it); it = (void *)IL(it, AST_F4); }
    } else if (tag == AST_IF_STMT) {
        kcc_ir_sw_scan((void *)IL(stmt, AST_F1));
        kcc_ir_sw_scan((void *)IL(stmt, AST_F2));
    } else if (tag == AST_WHILE_STMT || tag == AST_LABEL_STMT) {
        kcc_ir_sw_scan((void *)IL(stmt, AST_F1));
    } else if (tag == AST_DO_STMT) {
        kcc_ir_sw_scan((void *)IL(stmt, AST_F0));
    } else if (tag == AST_FOR_STMT) {
        kcc_ir_sw_scan((void *)IL(stmt, AST_F3));
    }
}

/* Emit the dispatch comparison for every case, in source order. */
void kcc_ir_sw_disp(void *stmt) {
    if (!stmt) return;
    unsigned long tag = IL(stmt, AST_TAG);
    if (tag == AST_CASE_STMT && IL(stmt, AST_F3)) {
        /* GNU case range `case LO ... HI:` — take the case body iff the switch
           value is in [LO, HI] (signed): dispatch as cond>=LO then cond<=HI,
           with a middle block between the two comparisons. */
        unsigned long lo = kcc_eval_const_int((void *)IL(stmt, AST_F0));
        unsigned long hi = kcc_eval_const_int((void *)IL(stmt, AST_F3));
        void *lc = kcc_ir_alloc_instr(IR_CONST);
        IL(lc, IR_TYPE) = (unsigned long)kcc_type_int_s;
        IL(lc, IR_SRC1) = lo;
        unsigned long lcv = kcc_ir_next_vreg();
        IL(lc, IR_DEST) = lcv;
        kcc_ir_emit(lc);
        void *ge = kcc_ir_alloc_instr(IR_CMP_SGE);
        IL(ge, IR_TYPE) = (unsigned long)kcc_type_int_s;
        IL(ge, IR_SRC1) = kcc_sw_cond_vreg;
        IL(ge, IR_SRC2) = lcv;
        unsigned long gev = kcc_ir_next_vreg();
        IL(ge, IR_DEST) = gev;
        kcc_ir_emit(ge);
        void *mid_bb = kcc_ir_alloc_bb();
        void *next_bb = kcc_ir_alloc_bb();
        void *bc1 = kcc_ir_alloc_instr(IR_BR_COND);
        IL(bc1, IR_DEST) = gev;
        IL(bc1, IR_SRC1) = IL(mid_bb, BB_ID);
        IL(bc1, IR_SRC2) = IL(next_bb, BB_ID);
        kcc_ir_emit(bc1);
        IL(kcc_ir_cur_bb, BB_FLAGS) = IL(kcc_ir_cur_bb, BB_FLAGS) | BB_FLAG_TERMINATED;
        kcc_ir_set_bb(mid_bb);
        void *hc = kcc_ir_alloc_instr(IR_CONST);
        IL(hc, IR_TYPE) = (unsigned long)kcc_type_int_s;
        IL(hc, IR_SRC1) = hi;
        unsigned long hcv = kcc_ir_next_vreg();
        IL(hc, IR_DEST) = hcv;
        kcc_ir_emit(hc);
        void *le = kcc_ir_alloc_instr(IR_CMP_SLE);
        IL(le, IR_TYPE) = (unsigned long)kcc_type_int_s;
        IL(le, IR_SRC1) = kcc_sw_cond_vreg;
        IL(le, IR_SRC2) = hcv;
        unsigned long lev = kcc_ir_next_vreg();
        IL(le, IR_DEST) = lev;
        kcc_ir_emit(le);
        void *bc2 = kcc_ir_alloc_instr(IR_BR_COND);
        IL(bc2, IR_DEST) = lev;
        IL(bc2, IR_SRC1) = IL((void *)IL(stmt, AST_F2), BB_ID);  /* case bb */
        IL(bc2, IR_SRC2) = IL(next_bb, BB_ID);
        kcc_ir_emit(bc2);
        IL(kcc_ir_cur_bb, BB_FLAGS) = IL(kcc_ir_cur_bb, BB_FLAGS) | BB_FLAG_TERMINATED;
        kcc_ir_set_bb(next_bb);
        kcc_ir_sw_disp((void *)IL(stmt, AST_F1));
    } else if (tag == AST_CASE_STMT) {
        unsigned long cv = kcc_eval_const_int((void *)IL(stmt, AST_F0));
        void *c = kcc_ir_alloc_instr(IR_CONST);
        IL(c, IR_TYPE) = (unsigned long)kcc_type_int_s;
        IL(c, IR_SRC1) = cv;
        unsigned long cvreg = kcc_ir_next_vreg();
        IL(c, IR_DEST) = cvreg;
        kcc_ir_emit(c);
        void *cmp = kcc_ir_alloc_instr(IR_CMP_EQ);
        IL(cmp, IR_TYPE) = (unsigned long)kcc_type_int_s;
        IL(cmp, IR_SRC1) = kcc_sw_cond_vreg;
        IL(cmp, IR_SRC2) = cvreg;
        unsigned long cmpv = kcc_ir_next_vreg();
        IL(cmp, IR_DEST) = cmpv;
        kcc_ir_emit(cmp);
        void *next_bb = kcc_ir_alloc_bb();
        void *bc = kcc_ir_alloc_instr(IR_BR_COND);
        IL(bc, IR_DEST) = cmpv;
        IL(bc, IR_SRC1) = IL((void *)IL(stmt, AST_F2), BB_ID);   /* case bb */
        IL(bc, IR_SRC2) = IL(next_bb, BB_ID);
        kcc_ir_emit(bc);
        IL(kcc_ir_cur_bb, BB_FLAGS) = IL(kcc_ir_cur_bb, BB_FLAGS) | BB_FLAG_TERMINATED;
        kcc_ir_set_bb(next_bb);
        kcc_ir_sw_disp((void *)IL(stmt, AST_F1));
    } else if (tag == AST_DEFAULT_STMT) {
        kcc_ir_sw_disp((void *)IL(stmt, AST_F0));
    } else if (tag == AST_COMPOUND) {
        void *it = (void *)IL(stmt, AST_F0);
        while (it) { kcc_ir_sw_disp(it); it = (void *)IL(it, AST_F4); }
    } else if (tag == AST_IF_STMT) {
        kcc_ir_sw_disp((void *)IL(stmt, AST_F1));
        kcc_ir_sw_disp((void *)IL(stmt, AST_F2));
    } else if (tag == AST_WHILE_STMT || tag == AST_LABEL_STMT) {
        kcc_ir_sw_disp((void *)IL(stmt, AST_F1));
    } else if (tag == AST_DO_STMT) {
        kcc_ir_sw_disp((void *)IL(stmt, AST_F0));
    } else if (tag == AST_FOR_STMT) {
        kcc_ir_sw_disp((void *)IL(stmt, AST_F3));
    }
}

/* Deep count of case/default labels in a switch body, recursing exactly where
   kcc_ir_sw_scan does (and, like it, NOT into a nested switch, whose labels
   belong to that switch).  Used to detect labels buried inside an arm. */
static unsigned long kcc_sw_count_labels(void *stmt) {
    if (!stmt) return 0;
    unsigned long tag = IL(stmt, AST_TAG);
    if (tag == AST_CASE_STMT)
        return 1 + kcc_sw_count_labels((void *)IL(stmt, AST_F1));
    if (tag == AST_DEFAULT_STMT)
        return 1 + kcc_sw_count_labels((void *)IL(stmt, AST_F0));
    if (tag == AST_COMPOUND) {
        unsigned long n = 0;
        for (void *it = (void *)IL(stmt, AST_F0); it; it = (void *)IL(it, AST_F4))
            n += kcc_sw_count_labels(it);
        return n;
    }
    if (tag == AST_IF_STMT)
        return kcc_sw_count_labels((void *)IL(stmt, AST_F1))
             + kcc_sw_count_labels((void *)IL(stmt, AST_F2));
    if (tag == AST_WHILE_STMT || tag == AST_LABEL_STMT)
        return kcc_sw_count_labels((void *)IL(stmt, AST_F1));
    if (tag == AST_DO_STMT)
        return kcc_sw_count_labels((void *)IL(stmt, AST_F0));
    if (tag == AST_FOR_STMT)
        return kcc_sw_count_labels((void *)IL(stmt, AST_F3));
    return 0;
}

/* A switch body is foldable when it is a compound whose case/default labels are
   all top-level label chains (so fall-through is a walk of the sibling list),
   whose first item is a label (no statement precedes the first arm), and which
   declares no variable directly in the switch scope (only inside an arm's own
   braces)---the last guard means skipping an earlier arm can never omit a
   declaration a built arm relies on. */
static int kcc_sw_foldable_body(void *body) {
    if (!body || IL(body, AST_TAG) != AST_COMPOUND) return 0;
    void *first = (void *)IL(body, AST_F0);
    if (!first) return 0;
    unsigned long ft = IL(first, AST_TAG);
    if (ft != AST_CASE_STMT && ft != AST_DEFAULT_STMT) return 0;
    unsigned long chain_total = 0;
    for (void *it = first; it; it = (void *)IL(it, AST_F4)) {
        void *node = it;
        while (node) {
            unsigned long nt = IL(node, AST_TAG);
            if (nt == AST_CASE_STMT) { chain_total++; node = (void *)IL(node, AST_F1); }
            else if (nt == AST_DEFAULT_STMT) { chain_total++; node = (void *)IL(node, AST_F0); }
            else break;
        }
        if (node && IL(node, AST_TAG) == AST_VAR_DECL) return 0;  /* bare decl in switch scope */
    }
    return chain_total == kcc_sw_count_labels(body);  /* else a label is buried in an arm */
}

/* Fold a switch whose control value is a constant: build only the arm that
   value selects (or default, or nothing), as straight-line code with the
   ordinary case/default label handling---no dispatch, so the unselected arms
   (and their differently-sized inline asm) are never emitted.  Returns 1 when
   it folded, 0 to fall back to the general two-scan lowering. */
static int kcc_ir_try_fold_switch(void *s) {
    void *cond = (void *)IL(s, AST_F0);
    if (!kcc_expr_is_ice(cond)) return 0;
    void *body = (void *)IL(s, AST_F1);
    if (!kcc_sw_foldable_body(body)) return 0;
    long v = (long)kcc_eval_const_int(cond);
    void *start = 0;
    void *deflt = 0;
    for (void *it = (void *)IL(body, AST_F0); it && !start; it = (void *)IL(it, AST_F4)) {
        void *node = it;
        while (node) {
            unsigned long nt = IL(node, AST_TAG);
            if (nt == AST_CASE_STMT) {
                long lo = (long)kcc_eval_const_int((void *)IL(node, AST_F0));
                if (IL(node, AST_F3)) {
                    long hi = (long)kcc_eval_const_int((void *)IL(node, AST_F3));
                    if (v >= lo && v <= hi) { start = it; break; }
                } else if (v == lo) { start = it; break; }
                node = (void *)IL(node, AST_F1);
            } else if (nt == AST_DEFAULT_STMT) {
                if (!deflt) deflt = it;
                node = (void *)IL(node, AST_F0);
            } else break;
        }
    }
    if (!start) start = deflt;                 /* no case matched: default, or nothing */
    void *exit_bb = kcc_ir_alloc_bb();
    unsigned long cont = 0;
    if (kcc_loop_depth) cont = kcc_loop_stack[(kcc_loop_depth - 1) * 2 + 1];
    kcc_loop_push(IL(exit_bb, BB_ID), cont);    /* break targets the switch exit */
    for (void *it = start; it; it = (void *)IL(it, AST_F4)) {
        kcc_ir_build_stmt(it);                  /* label f2/f1 are 0: builds transparently */
        if (IL(kcc_ir_cur_bb, BB_FLAGS) & BB_FLAG_TERMINATED) break;  /* a break/return ended the arm */
    }
    kcc_loop_pop();
    kcc_ir_branch_to(exit_bb);
    kcc_ir_set_bb(exit_bb);
    return 1;
}

void kcc_ir_build_switch(void *s) {
    if (kcc_ir_try_fold_switch(s)) return;
    kcc_sw_cond_vreg = kcc_ir_build_expr((void *)IL(s, AST_F0));
    void *exit_bb = kcc_ir_alloc_bb();
    kcc_sw_default_bb = 0;
    kcc_ir_sw_scan((void *)IL(s, AST_F1));
    void *default_bb = kcc_sw_default_bb;
    kcc_ir_sw_disp((void *)IL(s, AST_F1));
    kcc_ir_branch_to(default_bb ? default_bb : exit_bb);
    unsigned long cont = 0;
    if (kcc_loop_depth) cont = kcc_loop_stack[(kcc_loop_depth - 1) * 2 + 1];
    kcc_loop_push(IL(exit_bb, BB_ID), cont);
    kcc_ir_build_stmt((void *)IL(s, AST_F1));
    kcc_loop_pop();
    kcc_ir_branch_to(exit_bb);
    kcc_ir_set_bb(exit_bb);
}

void kcc_loop_push(unsigned long break_id, unsigned long continue_id) {
    unsigned long d = kcc_loop_depth;
    kcc_loop_stack[d * 2] = break_id;
    kcc_loop_stack[d * 2 + 1] = continue_id;
    kcc_loop_depth = d + 1;
}

void kcc_loop_pop(void) {
    kcc_loop_depth = kcc_loop_depth - 1;
}

void kcc_ir_build_break(void *s) {
    (void)s;
    unsigned long tgt = kcc_loop_stack[(kcc_loop_depth - 1) * 2];
    void *br = kcc_ir_alloc_instr(IR_BR);
    IL(br, IR_SRC1) = tgt;
    kcc_ir_emit(br);
    IL(kcc_ir_cur_bb, BB_FLAGS) = IL(kcc_ir_cur_bb, BB_FLAGS) | BB_FLAG_TERMINATED;
}

void kcc_ir_build_continue(void *s) {
    (void)s;
    unsigned long tgt = kcc_loop_stack[(kcc_loop_depth - 1) * 2 + 1];
    void *br = kcc_ir_alloc_instr(IR_BR);
    IL(br, IR_SRC1) = tgt;
    kcc_ir_emit(br);
    IL(kcc_ir_cur_bb, BB_FLAGS) = IL(kcc_ir_cur_bb, BB_FLAGS) | BB_FLAG_TERMINATED;
}
@}

\section{Assignment, Calls, Casts}

Assignment stores through an lvalue (variable, member, subscript, dereference),
using the shared \texttt{assign\_through} for address-based targets and a
whole-object copy for aggregates.  \texttt{build\_call} classifies each argument
for AAPCS64, reserves a hidden result buffer for an aggregate return, and
dispatches direct or indirect.  The cast builder delegates FP conversions to
\texttt{convert} and re-canonicalises integer width and signedness.

Before any of that, \texttt{build\_call} intercepts the GNU builtins the kernel
relies on.  \texttt{\_\_builtin\_expect} is a branch hint that reduces to its
value; \texttt{\_\_builtin\_constant\_p} is a compile-time predicate;
\texttt{\_\_builtin\_unreachable} annotates a dead point and---since kcc does not
exploit undefined behaviour---collapses to a harmless dummy value.  The
\texttt{\_\_builtin\_bswap16/32/64} family reverses byte order through a
portable IR gather (\texttt{kcc\_ir\_bswap}), so no new opcode or per-target
support is needed and the low $n$ bytes carry the answer.  The bit-scan family---\texttt{\_\_builtin\_clz}, \texttt{ctz}, \texttt{popcount},
and \texttt{ffs} (each with 32-bit and 64-bit \texttt{l}/\texttt{ll} widths)---
also lowers to portable bit-twiddling rather than a per-target intrinsic, so it
stays freestanding-correct with no new opcode.  Population count is the classic
SWAR fold; trailing zeros is the population count of the mask below the lowest
set bit ($x \,\&\, -x$, minus one); leading zeros smears the top set bit
downward and subtracts its population count from the width; and \texttt{ffs} is
one past the trailing-zero count, multiplied by a nonzero predicate so a zero
input yields zero without a branch.  The remaining names have an exact library
counterpart---\texttt{\_\_builtin\_trap} to \texttt{abort} and
\texttt{\_\_builtin\_abs/labs/llabs} to their unprefixed forms---which is
correct while the milestone links against a C library.

Variadic access has two lowerings; \texttt{build\_call} reaches them by name,
accepting both the short \texttt{va\_start}/\texttt{va\_end} operators and their
GNU \texttt{\_\_builtin\_va\_start}/\texttt{\_\_builtin\_va\_end} spellings (a
freestanding \texttt{<stdarg.h>} expands the \texttt{va\_*} macros to the
\texttt{\_\_builtin\_} forms).  On ARM64 a \texttt{va\_list} is a bare
pointer that walks the homogeneous save area, so \texttt{va\_start} records the
frame base and \texttt{va\_arg} bumps the cursor by eight.  On x86-64 the System~V
ABI splits arguments across the integer and vector banks, so \texttt{va\_start}
materialises the four-field \texttt{va\_list} struct (\texttt{gp\_offset},
\texttt{fp\_offset}, overflow pointer, register-save pointer) and \texttt{va\_arg}
selects register-versus-overflow \emph{branchlessly}
(\texttt{addr = overflow + c\,(reg\_addr - overflow)}, where \texttt{c} is the
in-range predicate) and advances the matching counter.  Because the requested
type governs which bank to read, \texttt{va\_arg} resolves the unresolved
type-name node to a \texttt{Type} first, so a \texttt{double} takes the
vector-bank path rather than being misread from the integer save area.

@l c
@d Selfhost: ir assigncall @{
unsigned long kcc_ir_build_assign(void *e) {
    /* parentheses transparent on the target */
    void *lhs = (void *)IL(e, AST_F1);
    while (lhs && IL(lhs, AST_TAG) == AST_PAREN_EXPR) {
        lhs = (void *)IL(lhs, AST_F0);
        IL(e, AST_F1) = (unsigned long)lhs;
    }
    void *ltype = (void *)IL(e, AST_F3);
    unsigned long op = IL(e, AST_F0);

    /* aggregate simple assignment → whole-object copy */
    if (op == TOK_ASSIGN && lhs) {
        void *lt = (void *)IL(lhs, AST_F3);
        if (lt && (IL(lt, TY_KIND) == TY_STRUCT || IL(lt, TY_KIND) == TY_UNION)) {
            void *aggty = lt;
            /* destination address */
            unsigned long dst;
            unsigned long dtag = IL(lhs, AST_TAG);
            if (dtag == AST_MEMBER) dst = kcc_ir_build_member_addr(lhs);
            else if (dtag == AST_SUBSCRIPT) dst = kcc_ir_build_subscript_addr(lhs);
            else if (dtag == AST_UNARY_EXPR) {
                if (IL(lhs, AST_F0) != TOK_STAR) return 0;
                dst = kcc_ir_build_expr((void *)IL(lhs, AST_F1));
            } else if (dtag == AST_IDENT_EXPR) {
                char *name = (char *)IL(lhs, AST_F0);
                unsigned long v = (unsigned long)kcc_ht_get(kcc_ir_locals, name, kcc_strlen(name));
                if (v) dst = (v & ~0x8000000000000000UL) - 1;
                else {
                    void *g = kcc_ir_alloc_instr(IR_GLOBAL_REF);
                    IL(g, IR_SRC1) = (unsigned long)name;
                    IL(g, IR_TYPE) = (unsigned long)kcc_type_int_s;
                    dst = kcc_ir_next_vreg();
                    IL(g, IR_DEST) = dst;
                    kcc_ir_emit(g);
                }
            } else return 0;
            /* source address (peel parens, evaluate comma LHS) */
            void *src_node = (void *)IL(e, AST_F2);
            if (!src_node) return 0;
            while (1) {
                unsigned long st = IL(src_node, AST_TAG);
                if (st == AST_PAREN_EXPR) { src_node = (void *)IL(src_node, AST_F0); if (!src_node) return 0; continue; }
                if (st == AST_COMMA_EXPR) {
                    kcc_ir_build_expr((void *)IL(src_node, AST_F0));
                    src_node = (void *)IL(src_node, AST_F1);
                    if (!src_node) return 0;
                    continue;
                }
                break;
            }
            unsigned long src;
            unsigned long st = IL(src_node, AST_TAG);
            if (st == AST_ASSIGN_EXPR) src = kcc_ir_build_assign(src_node);
            else if (st == AST_CALL_EXPR) src = kcc_ir_build_call(src_node);
            else if (st == AST_MEMBER) src = kcc_ir_build_member_addr(src_node);
            else if (st == AST_SUBSCRIPT) src = kcc_ir_build_subscript_addr(src_node);
            else if (st == AST_VA_ARG) src = kcc_ir_build_va_arg(src_node);
            else if (st == AST_UNARY_EXPR) {
                if (IL(src_node, AST_F0) != TOK_STAR) return 0;
                src = kcc_ir_build_expr((void *)IL(src_node, AST_F1));
            } else if (st == AST_IDENT_EXPR) {
                char *name = (char *)IL(src_node, AST_F0);
                unsigned long v = (unsigned long)kcc_ht_get(kcc_ir_locals, name, kcc_strlen(name));
                if (v) src = (v & ~0x8000000000000000UL) - 1;
                else {
                    void *g = kcc_ir_alloc_instr(IR_GLOBAL_REF);
                    IL(g, IR_SRC1) = (unsigned long)name;
                    IL(g, IR_TYPE) = (unsigned long)kcc_type_int_s;
                    src = kcc_ir_next_vreg();
                    IL(g, IR_DEST) = src;
                    kcc_ir_emit(g);
                }
            } else return 0;
            kcc_ir_emit_struct_copy(src, dst, kcc_type_layout(aggty));
            return dst;
        }
    }

    /* scalar RHS */
    void *rhs_node = (void *)IL(e, AST_F2);
    void *rtype = (void *)IL(rhs_node, AST_F3);
    unsigned long rhs = kcc_ir_build_expr(rhs_node);
    if (op == TOK_ASSIGN) rhs = kcc_ir_convert(rhs, rtype, ltype);

    if (!lhs) return rhs;
    unsigned long tag = IL(lhs, AST_TAG);
    if (tag == AST_SUBSCRIPT) {
        unsigned long addr = kcc_ir_build_subscript_addr(lhs);
        return kcc_ir_assign_through(addr, rhs, op, 0, (void *)IL(lhs, AST_F3), rtype);
    }
    if (tag == AST_MEMBER) {
        unsigned long addr = kcc_ir_build_member_addr(lhs);
        void *field = kcc_ir_member_field;
        return kcc_ir_assign_through(addr, rhs, op, field, (void *)IL(lhs, AST_F3), rtype);
    }
    if (tag == AST_UNARY_EXPR) {
        if (IL(lhs, AST_F0) != TOK_STAR) return rhs;
        void *pty = (void *)IL(lhs, AST_F3);          /* type of *expr */
        unsigned long addr = kcc_ir_build_expr((void *)IL(lhs, AST_F1));
        return kcc_ir_assign_through(addr, rhs, op, 0, pty, rtype);
    }
    if (tag != AST_IDENT_EXPR) return rhs;

    char *name = (char *)IL(lhs, AST_F0);
    if (!name) return rhs;
    kcc_ir_local_const_kill(name);   /* reassigned: value no longer constant */
    unsigned long v = (unsigned long)kcc_ht_get(kcc_ir_locals, name, kcc_strlen(name));
    unsigned long addr;
    if (v) {
        addr = (v & ~0x8000000000000000UL) - 1;
    } else {
        char *symname = name;
        if (kcc_ir_statics) {
            void *mangled = kcc_ht_get(kcc_ir_statics, name, kcc_strlen(name));
            if (mangled) symname = (char *)mangled;
        }
        void *g = kcc_ir_alloc_instr(IR_GLOBAL_REF);
        IL(g, IR_SRC1) = (unsigned long)symname;
        IL(g, IR_TYPE) = (unsigned long)kcc_type_int_s;
        addr = kcc_ir_next_vreg();
        IL(g, IR_DEST) = addr;
        kcc_ir_emit(g);
    }
    unsigned long value = rhs;
    if (op != TOK_ASSIGN) {
        void *ld = kcc_ir_alloc_instr(IR_LOAD);
        IL(ld, IR_TYPE) = (unsigned long)ltype;
        IL(ld, IR_SRC1) = addr;
        IL(ld, IR_SRC2) = kcc_ir_load_width(ltype);
        unsigned long old = kcc_ir_next_vreg();
        IL(ld, IR_DEST) = old;
        kcc_ir_emit(ld);
        unsigned long bop = kcc_ir_tok_to_binop(op);
        value = kcc_ir_compound_apply(bop, old, ltype, rhs, rtype);
    }
    void *st = kcc_ir_alloc_instr(IR_STORE);
    IL(st, IR_TYPE) = (unsigned long)kcc_type_int_s;
    IL(st, IR_SRC1) = value;
    IL(st, IR_SRC2) = addr;
    IL(st, IR_DEST) = kcc_ir_store_width(ltype);
    kcc_ir_emit(st);
    return value;
}

/* __builtin_bswapN reverses the byte order of an n-byte value.  It lowers to a
   target-independent gather: byte i of the input (isolated with a shift and an
   AND) is deposited at position n-1-i, and the n terms are OR-ed together.  The
   result occupies the low n bytes with zero above, so a narrower result type
   truncates correctly without extra work. */
static unsigned long kcc_ir_bswap(unsigned long val, unsigned long nbytes) {
    unsigned long result = 0;
    unsigned long have = 0;
    for (unsigned long i = 0; i < nbytes; i++) {
        unsigned long term = val;
        if (i) {
            unsigned long sh = kcc_ir_emit_const(i * 8);
            term = kcc_ir_emit_binop(IR_LSHR, term, sh);
        }
        unsigned long m = kcc_ir_emit_const(0xff);
        term = kcc_ir_emit_binop(IR_AND, term, m);
        unsigned long outpos = (nbytes - 1 - i) * 8;
        if (outpos) {
            unsigned long sh2 = kcc_ir_emit_const(outpos);
            term = kcc_ir_emit_binop(IR_SHL, term, sh2);
        }
        if (!have) { result = term; have = 1; }
        else result = kcc_ir_emit_binop(IR_OR, result, term);
    }
    return result;
}

/* Population count of the low nbits of a value, SWAR-style: pairwise sums fold
   up through 1/2/4-bit fields, then a multiply by 0x01..01 broadcasts the byte
   sums into the top byte, which a final shift brings down.  Everything is a
   plain binop, so it needs no new opcode and lowers identically on every
   target.  The width mask keeps a 32-bit count from seeing stray high bits. */
static unsigned long kcc_ir_popcount(unsigned long val, unsigned long nbits) {
    unsigned long full = (nbits >= 64) ? 0xffffffffffffffffUL
                                       : ((1UL << nbits) - 1);
    if (nbits < 64) {
        unsigned long fm = kcc_ir_emit_const(full);
        val = kcc_ir_emit_binop(IR_AND, val, fm);
    }
    unsigned long m1 = kcc_ir_emit_const(0x5555555555555555UL & full);
    unsigned long m2 = kcc_ir_emit_const(0x3333333333333333UL & full);
    unsigned long m4 = kcc_ir_emit_const(0x0f0f0f0f0f0f0f0fUL & full);
    unsigned long h01 = kcc_ir_emit_const(0x0101010101010101UL & full);
    unsigned long c1 = kcc_ir_emit_const(1);
    unsigned long t = kcc_ir_emit_binop(IR_LSHR, val, c1);
    t = kcc_ir_emit_binop(IR_AND, t, m1);
    val = kcc_ir_emit_binop(IR_SUB, val, t);
    unsigned long a = kcc_ir_emit_binop(IR_AND, val, m2);
    unsigned long c2 = kcc_ir_emit_const(2);
    unsigned long b = kcc_ir_emit_binop(IR_LSHR, val, c2);
    b = kcc_ir_emit_binop(IR_AND, b, m2);
    val = kcc_ir_emit_binop(IR_ADD, a, b);
    unsigned long c4 = kcc_ir_emit_const(4);
    unsigned long s = kcc_ir_emit_binop(IR_LSHR, val, c4);
    val = kcc_ir_emit_binop(IR_ADD, val, s);
    val = kcc_ir_emit_binop(IR_AND, val, m4);
    val = kcc_ir_emit_binop(IR_MUL, val, h01);
    unsigned long sh = kcc_ir_emit_const(nbits - 8);
    val = kcc_ir_emit_binop(IR_LSHR, val, sh);
    unsigned long ff = kcc_ir_emit_const(0xff);
    return kcc_ir_emit_binop(IR_AND, val, ff);
}

/* Count trailing zeros = popcount of the mask below the lowest set bit.
   val & -val isolates that bit; subtracting one turns the zeros beneath it into
   ones.  Undefined at zero (as the builtin is), where it yields nbits. */
static unsigned long kcc_ir_ctz(unsigned long val, unsigned long nbits) {
    if (nbits < 64) {
        unsigned long fm = kcc_ir_emit_const((1UL << nbits) - 1);
        val = kcc_ir_emit_binop(IR_AND, val, fm);
    }
    unsigned long zero = kcc_ir_emit_const(0);
    unsigned long neg = kcc_ir_emit_binop(IR_SUB, zero, val);
    unsigned long low = kcc_ir_emit_binop(IR_AND, val, neg);
    unsigned long one = kcc_ir_emit_const(1);
    unsigned long m = kcc_ir_emit_binop(IR_SUB, low, one);
    return kcc_ir_popcount(m, nbits);
}

/* Count leading zeros: smear the highest set bit down to fill every lower bit,
   so popcount then gives one past the top bit's index; nbits minus that is the
   leading-zero count.  Undefined at zero, where it yields nbits. */
static unsigned long kcc_ir_clz(unsigned long val, unsigned long nbits) {
    if (nbits < 64) {
        unsigned long fm = kcc_ir_emit_const((1UL << nbits) - 1);
        val = kcc_ir_emit_binop(IR_AND, val, fm);
    }
    for (unsigned long s = 1; s < nbits; s <<= 1) {
        unsigned long sh = kcc_ir_emit_const(s);
        unsigned long r = kcc_ir_emit_binop(IR_LSHR, val, sh);
        val = kcc_ir_emit_binop(IR_OR, val, r);
    }
    unsigned long pc = kcc_ir_popcount(val, nbits);
    unsigned long nb = kcc_ir_emit_const(nbits);
    return kcc_ir_emit_binop(IR_SUB, nb, pc);
}

/* Find first set = one past the trailing-zero count, or zero for a zero input.
   Multiplying by the (nonzero?) predicate folds the zero case in branchlessly. */
static unsigned long kcc_ir_ffs(unsigned long val, unsigned long nbits) {
    if (nbits < 64) {
        unsigned long fm = kcc_ir_emit_const((1UL << nbits) - 1);
        val = kcc_ir_emit_binop(IR_AND, val, fm);
    }
    unsigned long t = kcc_ir_ctz(val, nbits);
    unsigned long one = kcc_ir_emit_const(1);
    unsigned long tp1 = kcc_ir_emit_binop(IR_ADD, t, one);
    unsigned long zero = kcc_ir_emit_const(0);
    unsigned long nz = kcc_ir_emit_binop(IR_CMP_NE, val, zero);
    return kcc_ir_emit_binop(IR_MUL, tp1, nz);
}

/* --- always_inline expansion ------------------------------------------------
   An `always_inline` function is inlined at each call by building a clone of its
   body with the parameters replaced by the call's arguments.  This is what makes
   a constant the CALLER knows fold through the callee---the kernel's
   `static_cpu_has(FEATURE)` needs the constant feature bit substituted into a
   `1 << (bit & 7)` `"i"` inline-asm operand, which GCC only accepts once it is a
   compile-time constant.  The registry is filled by the parser as each
   always_inline definition closes (kcc_register_always_inline).  This first
   phase handles a `{ return EXPR; }` body; the clone declines (returns 0) for
   any construct it does not model, so an unhandled callee simply falls back to a
   real call and can never be miscompiled. */
void kcc_register_always_inline(const char *name, void *fndecl) {
    if (!kcc_always_inline_fns) kcc_always_inline_fns = kcc_ht_init(64);
    kcc_ht_put(kcc_always_inline_fns, name, kcc_strlen(name), fndecl);
}

/* Labels are function-scoped, so every label the inlined body defines is renamed
   with a per-inline-instance suffix, or two expansions of the same callee in one
   caller would collide.  The renamed name is only ever an internal hash-table key
   (blocks emit as numbered .Lkccbb labels), so the suffix need not be a legal C
   identifier.  The return conversion targets (`__r'/`__end') live in these two
   globals for the duration of one body clone. */
static unsigned long kcc_inl_inst = 0;
static const char *kcc_inl_ret_name = 0;   /* the __r variable's name, 0 if void */
static const char *kcc_inl_end_name = 0;   /* the __end label's name */

static const char *kcc_inl_lbl(const char *name) {
    unsigned long nl = kcc_strlen(name);
    char *buf = (char *)kcc_arena_alloc(nl + 24);
    unsigned long i = 0;
    while (i < nl) { buf[i] = name[i]; i++; }
    buf[i++] = '$';
    unsigned long v = kcc_inl_inst;
    char tmp[20]; unsigned long tn = 0;
    if (v == 0) tmp[tn++] = '0';
    while (v) { tmp[tn++] = (char)('0' + (v % 10)); v /= 10; }
    while (tn) buf[i++] = tmp[--tn];
    buf[i] = 0;
    return (const char *)kcc_strtab_intern(buf, i);
}

/* An argument may be substituted into the body more than once (kept as an
   expression so a constant folds through), so it must be free of side effects. */
static int kcc_inl_arg_safe(void *a) {
    if (!a) return 1;
    unsigned long tag = IL(a, AST_TAG);
    if (tag == AST_INT_LIT || tag == AST_CHAR_LIT || tag == AST_FLOAT_LIT ||
        tag == AST_STR_LIT || tag == AST_IDENT_EXPR)
        return 1;
    if (tag == AST_PAREN_EXPR)
        return kcc_inl_arg_safe((void *)IL(a, AST_F0));
    if (tag == AST_CAST_EXPR)
        return kcc_inl_arg_safe((void *)IL(a, AST_F1));
    if (tag == AST_UNARY_EXPR) {
        unsigned long op = IL(a, AST_F0);
        if (op == TOK_INC || op == TOK_DEC) return 0;
        return kcc_inl_arg_safe((void *)IL(a, AST_F1));
    }
    if (tag == AST_BINARY_EXPR)
        return kcc_inl_arg_safe((void *)IL(a, AST_F1)) &&
               kcc_inl_arg_safe((void *)IL(a, AST_F2));
    if (tag == AST_SUBSCRIPT)
        return kcc_inl_arg_safe((void *)IL(a, AST_F0)) &&
               kcc_inl_arg_safe((void *)IL(a, AST_F1));
    if (tag == AST_MEMBER)
        return kcc_inl_arg_safe((void *)IL(a, AST_F0));
    if (tag == AST_COND_EXPR)
        return kcc_inl_arg_safe((void *)IL(a, AST_F0)) &&
               kcc_inl_arg_safe((void *)IL(a, AST_F1)) &&
               kcc_inl_arg_safe((void *)IL(a, AST_F2));
    return 0;                                   /* calls, assignments, comma: assume unsafe */
}

/* Shallow node copy: same tag and all five fields, no sibling link. */
static void *kcc_inl_dup(void *node) {
    void *d = kcc_ast_alloc(IL(node, AST_TAG));
    IL(d, AST_LINE) = IL(node, AST_LINE); IL(d, AST_COL) = IL(node, AST_COL);
    IL(d, AST_F0) = IL(node, AST_F0); IL(d, AST_F1) = IL(node, AST_F1);
    IL(d, AST_F2) = IL(node, AST_F2); IL(d, AST_F3) = IL(node, AST_F3);
    IL(d, AST_F4) = 0;
    return d;
}

static void *kcc_inl_clone(void *node, void *params, void *args);

/* Clone an f4-linked argument list; (void *)-1 signals an unclonable element. */
static void *kcc_inl_clone_list(void *head, void *params, void *args) {
    void *first = 0, *last = 0;
    for (void *el = head; el; el = (void *)IL(el, AST_F4)) {
        void *c = kcc_inl_clone(el, params, args);
        if (!c) return (void *)-1;
        if (!first) { first = c; last = c; }
        else { IL(last, AST_F4) = (unsigned long)c; last = c; }
    }
    return first;
}

static void *kcc_inl_clone(void *node, void *params, void *args) {
    if (!node) return 0;
    unsigned long tag = IL(node, AST_TAG);
    if (tag == AST_INT_LIT || tag == AST_CHAR_LIT || tag == AST_FLOAT_LIT ||
        tag == AST_STR_LIT)
        return kcc_inl_dup(node);
    if (tag == AST_IDENT_EXPR) {
        const char *nm = (const char *)IL(node, AST_F0);
        void *p = params, *a = args;
        while (p && a) {
            const char *pn = (const char *)IL(p, AST_F1);
            if (pn && kcc_strcmp(pn, nm) == 0) {
                void *ac = kcc_inl_clone(a, 0, 0);   /* clone the argument */
                if (!ac) return 0;
                /* Bind through the parameter's type: an argument of a narrower
                   type would otherwise give the operand the wrong width (a `long'
                   bit number materialised as %r9d clashes with a `btrq').  A cast
                   of a constant is still a constant, so this preserves folding. */
                void *pty = (void *)IL(p, AST_F0);
                if (!pty) return ac;
                void *cst = kcc_ast_alloc(AST_CAST_EXPR);
                IL(cst, AST_F0) = (unsigned long)pty;
                IL(cst, AST_F1) = (unsigned long)ac;
                IL(cst, AST_F3) = (unsigned long)kcc_sema_resolve_type(pty);
                return cst;
            }
            p = (void *)IL(p, AST_F4); a = (void *)IL(a, AST_F4);
        }
        return kcc_inl_dup(node);                   /* a global / enum reference */
    }
    if (tag == AST_BINARY_EXPR || tag == AST_ASSIGN_EXPR || tag == AST_COMMA_EXPR) {
        void *l = kcc_inl_clone((void *)IL(node, AST_F1), params, args);
        void *r = kcc_inl_clone((void *)IL(node, AST_F2), params, args);
        if (!l || !r) return 0;
        void *d = kcc_inl_dup(node);
        IL(d, AST_F1) = (unsigned long)l; IL(d, AST_F2) = (unsigned long)r;
        return d;
    }
    if (tag == AST_UNARY_EXPR || tag == AST_PAREN_EXPR) {
        unsigned long fld = (tag == AST_UNARY_EXPR) ? AST_F1 : AST_F0;
        void *o = kcc_inl_clone((void *)IL(node, fld), params, args);
        if (!o) return 0;
        void *d = kcc_inl_dup(node);
        IL(d, fld) = (unsigned long)o;
        return d;
    }
    if (tag == AST_CAST_EXPR) {                     /* F0 = type (shared), F1 = expr */
        void *o = kcc_inl_clone((void *)IL(node, AST_F1), params, args);
        if (!o) return 0;
        void *d = kcc_inl_dup(node);
        IL(d, AST_F1) = (unsigned long)o;
        return d;
    }
    if (tag == AST_COND_EXPR) {
        void *c = kcc_inl_clone((void *)IL(node, AST_F0), params, args);
        void *t = kcc_inl_clone((void *)IL(node, AST_F1), params, args);
        void *f = kcc_inl_clone((void *)IL(node, AST_F2), params, args);
        if (!c || !t || !f) return 0;
        void *d = kcc_inl_dup(node);
        IL(d, AST_F0) = (unsigned long)c; IL(d, AST_F1) = (unsigned long)t;
        IL(d, AST_F2) = (unsigned long)f;
        return d;
    }
    if (tag == AST_SUBSCRIPT) {
        void *b = kcc_inl_clone((void *)IL(node, AST_F0), params, args);
        void *i = kcc_inl_clone((void *)IL(node, AST_F1), params, args);
        if (!b || !i) return 0;
        void *d = kcc_inl_dup(node);
        IL(d, AST_F0) = (unsigned long)b; IL(d, AST_F1) = (unsigned long)i;
        return d;
    }
    if (tag == AST_MEMBER) {                        /* F0 = obj, F1 = name, F2 = arrow */
        void *o = kcc_inl_clone((void *)IL(node, AST_F0), params, args);
        if (!o) return 0;
        void *d = kcc_inl_dup(node);
        IL(d, AST_F0) = (unsigned long)o;
        return d;
    }
    if (tag == AST_SIZEOF_EXPR || tag == AST_ALIGNOF_EXPR) {
        void *d = kcc_inl_dup(node);
        if (!IL(node, AST_F1)) {                    /* F1 set = a type operand (kept) */
            void *o = kcc_inl_clone((void *)IL(node, AST_F0), params, args);
            if (!o) return 0;
            IL(d, AST_F0) = (unsigned long)o;
        }
        return d;
    }
    if (tag == AST_CALL_EXPR) {
        void *cal = kcc_inl_clone((void *)IL(node, AST_F0), params, args);
        if (!cal) return 0;
        void *al = kcc_inl_clone_list((void *)IL(node, AST_F1), params, args);
        if (al == (void *)-1) return 0;
        void *d = kcc_inl_dup(node);
        IL(d, AST_F0) = (unsigned long)cal; IL(d, AST_F1) = (unsigned long)al;
        return d;
    }
    /* --- statements (the general body path) --- */
    if (tag == AST_EXPR_STMT || tag == AST_STMT_EXPR) {
        void *o = kcc_inl_clone((void *)IL(node, AST_F0), params, args);
        if (!o) return 0;
        void *d = kcc_inl_dup(node);
        IL(d, AST_F0) = (unsigned long)o;
        return d;
    }
    if (tag == AST_COMPOUND) {
        void *lst = kcc_inl_clone_list((void *)IL(node, AST_F0), params, args);
        if (lst == (void *)-1) return 0;
        void *d = kcc_inl_dup(node);
        IL(d, AST_F0) = (unsigned long)lst;
        return d;
    }
    if (tag == AST_RETURN_STMT) {
        /* `return X;' -> `{ __r = X; goto __end; }' (or just the goto for void). */
        void *g = kcc_ast_alloc(AST_GOTO_STMT);
        IL(g, AST_F0) = (unsigned long)kcc_inl_end_name;
        void *seq = g;
        void *xe = (void *)IL(node, AST_F0);
        if (xe && kcc_inl_ret_name) {
            void *xc = kcc_inl_clone(xe, params, args);
            if (!xc) return 0;
            void *lhs = kcc_ast_alloc(AST_IDENT_EXPR);
            IL(lhs, AST_F0) = (unsigned long)kcc_inl_ret_name;
            void *asn = kcc_ast_alloc(AST_ASSIGN_EXPR);
            IL(asn, AST_F0) = TOK_ASSIGN;
            IL(asn, AST_F1) = (unsigned long)lhs;
            IL(asn, AST_F2) = (unsigned long)xc;
            void *es = kcc_ast_alloc(AST_EXPR_STMT);
            IL(es, AST_F0) = (unsigned long)asn;
            IL(es, AST_F4) = (unsigned long)g;
            seq = es;
        }
        void *comp = kcc_ast_alloc(AST_COMPOUND);
        IL(comp, AST_F0) = (unsigned long)seq;
        return comp;
    }
    if (tag == AST_IF_STMT) {
        void *c = kcc_inl_clone((void *)IL(node, AST_F0), params, args);
        void *t = kcc_inl_clone((void *)IL(node, AST_F1), params, args);
        if (!c || !t) return 0;
        void *el = 0;
        if (IL(node, AST_F2)) {
            el = kcc_inl_clone((void *)IL(node, AST_F2), params, args);
            if (!el) return 0;
        }
        void *d = kcc_inl_dup(node);
        IL(d, AST_F0) = (unsigned long)c; IL(d, AST_F1) = (unsigned long)t;
        IL(d, AST_F2) = (unsigned long)el;
        return d;
    }
    if (tag == AST_WHILE_STMT || tag == AST_DO_STMT ||
        tag == AST_SWITCH_STMT || tag == AST_CASE_STMT) {
        void *a0 = kcc_inl_clone((void *)IL(node, AST_F0), params, args);
        void *a1 = kcc_inl_clone((void *)IL(node, AST_F1), params, args);
        if (!a0 || !a1) return 0;
        void *d = kcc_inl_dup(node);
        IL(d, AST_F0) = (unsigned long)a0; IL(d, AST_F1) = (unsigned long)a1;
        return d;
    }
    if (tag == AST_FOR_STMT) {
        void *c[4]; unsigned long fld[4] = {AST_F0, AST_F1, AST_F2, AST_F3};
        for (int k = 0; k < 4; k++) {
            void *src = (void *)IL(node, fld[k]);
            c[k] = src ? kcc_inl_clone(src, params, args) : 0;
            if (src && !c[k]) return 0;
        }
        void *d = kcc_inl_dup(node);
        for (int k = 0; k < 4; k++) IL(d, fld[k]) = (unsigned long)c[k];
        return d;
    }
    if (tag == AST_DEFAULT_STMT) {
        void *a1 = kcc_inl_clone((void *)IL(node, AST_F1), params, args);
        if (!a1) return 0;
        void *d = kcc_inl_dup(node);
        IL(d, AST_F1) = (unsigned long)a1;
        return d;
    }
    if (tag == AST_LABEL_STMT) {                    /* rename the label per instance */
        void *a1 = kcc_inl_clone((void *)IL(node, AST_F1), params, args);
        if (!a1) return 0;
        void *d = kcc_inl_dup(node);
        IL(d, AST_F0) = (unsigned long)kcc_inl_lbl((const char *)IL(node, AST_F0));
        IL(d, AST_F1) = (unsigned long)a1;
        return d;
    }
    if (tag == AST_GOTO_STMT) {
        void *d = kcc_inl_dup(node);
        IL(d, AST_F0) = (unsigned long)kcc_inl_lbl((const char *)IL(node, AST_F0));
        return d;
    }
    if (tag == AST_BREAK_STMT || tag == AST_CONTINUE_STMT || tag == AST_NULL_STMT)
        return kcc_inl_dup(node);
    if (tag == AST_VAR_DECL) {                       /* a local: block-scoped, name kept */
        void *d = kcc_inl_dup(node);
        if (IL(node, AST_F2)) {
            void *ini = kcc_inl_clone((void *)IL(node, AST_F2), params, args);
            if (!ini) return 0;
            IL(d, AST_F2) = (unsigned long)ini;
        }
        return d;
    }
    if (tag == AST_ASM_STMT) {
        void *d = kcc_inl_dup(node);                 /* f0 template, f1 length kept */
        void *ops = 0, *last = 0;
        for (void *op = (void *)IL(node, AST_F2); op; op = (void *)IL(op, AST_F4)) {
            void *ve = kcc_inl_clone((void *)IL(op, AST_F2), params, args);
            if (!ve) return 0;
            void *oc = kcc_inl_dup(op);              /* f0 constraint, f1 [name] kept */
            IL(oc, AST_F2) = (unsigned long)ve;
            if (!ops) { ops = oc; last = oc; }
            else { IL(last, AST_F4) = (unsigned long)oc; last = oc; }
        }
        IL(d, AST_F2) = (unsigned long)ops;
        /* goto labels: keep F0 (the template-match name for %l[name]) but resolve
           through the renamed label via the F1 alias, so no template surgery. */
        void *gls = 0; last = 0;
        for (void *l = (void *)IL(node, AST_F3); l; l = (void *)IL(l, AST_F4)) {
            void *lc = kcc_inl_dup(l);
            IL(lc, AST_F1) = (unsigned long)kcc_inl_lbl((const char *)IL(l, AST_F0));
            IL(lc, AST_F2) = 0;
            if (!gls) { gls = lc; last = lc; }
            else { IL(last, AST_F4) = (unsigned long)lc; last = lc; }
        }
        IL(d, AST_F3) = (unsigned long)gls;
        return d;
    }
    return 0;                                       /* unhandled: decline to inline */
}

/* If `name` is a registered always_inline function with a `{ return E; }` body
   and a matching argument count, build E with parameters replaced by the call
   arguments and report its value; return 0 to fall back to a real call. */
static int kcc_ir_try_inline(void *call, const char *name, unsigned long *out) {
    if (!kcc_always_inline_fns) return 0;
    void *fn = (void *)kcc_ht_get(kcc_always_inline_fns, name, kcc_strlen(name));
    if (!fn) return 0;
    void *body = (void *)IL(fn, AST_F3);
    if (!body || IL(body, AST_TAG) != AST_COMPOUND) return 0;
    void *params = (void *)(IL(fn, AST_F2) & ~3UL); /* strip variadic + linkage flags */
    void *args = (void *)IL(call, AST_F1);
    unsigned long np = 0, na = 0;
    for (void *p = params; p; p = (void *)IL(p, AST_F4)) np++;
    for (void *a = args; a; a = (void *)IL(a, AST_F4)) na++;
    if (np != na) return 0;                          /* no variadic inlining */
    for (void *a = args; a; a = (void *)IL(a, AST_F4))
        if (!kcc_inl_arg_safe(a)) return 0;          /* args may re-evaluate */

    kcc_inl_inst++;
    /* Fast path: a lone `return EXPR;' body inlines to EXPR with no wrapper. */
    void *s0 = (void *)IL(body, AST_F0);
    if (s0 && !IL(s0, AST_F4) && IL(s0, AST_TAG) == AST_RETURN_STMT && IL(s0, AST_F0)) {
        void *clone = kcc_inl_clone((void *)IL(s0, AST_F0), params, args);
        if (!clone) return 0;
        *out = kcc_ir_build_expr(clone);
        return 1;
    }

    /* General path: clone the body, turning each `return X' into an assignment to
       a fresh __r plus `goto __end', and evaluate it as
       `({ RETTYPE __r; <body>; __end: ; __r; })'.  build_stmt_expr registers the
       labels and takes the value from the trailing __r. */
    void *rettype = (void *)IL(fn, AST_F0);
    const char *retn = kcc_inl_lbl("__inl_r");
    const char *endn = kcc_inl_lbl("__inl_end");
    kcc_inl_ret_name = rettype ? retn : 0;
    kcc_inl_end_name = endn;
    void *bclone = kcc_inl_clone(body, params, args);
    kcc_inl_ret_name = 0; kcc_inl_end_name = 0;
    if (!bclone) return 0;

    void *first = (void *)IL(bclone, AST_F0);
    /* `__end: ;' followed by the value item */
    void *lbl = kcc_ast_alloc(AST_LABEL_STMT);
    IL(lbl, AST_F0) = (unsigned long)endn;
    IL(lbl, AST_F1) = (unsigned long)kcc_ast_alloc(AST_NULL_STMT);
    void *valstmt = 0;
    if (rettype) {
        void *rid = kcc_ast_alloc(AST_IDENT_EXPR);
        IL(rid, AST_F0) = (unsigned long)retn;
        valstmt = kcc_ast_alloc(AST_EXPR_STMT);
        IL(valstmt, AST_F0) = (unsigned long)rid;
    }
    IL(lbl, AST_F4) = (unsigned long)valstmt;
    if (first) {
        void *t = first;
        while (IL(t, AST_F4)) t = (void *)IL(t, AST_F4);
        IL(t, AST_F4) = (unsigned long)lbl;
    } else {
        first = lbl;
    }
    if (rettype) {                                   /* prepend `RETTYPE __r;' */
        void *rdecl = kcc_ast_alloc(AST_VAR_DECL);
        IL(rdecl, AST_F0) = (unsigned long)rettype;
        IL(rdecl, AST_F1) = (unsigned long)retn;
        IL(rdecl, AST_F4) = (unsigned long)first;
        first = rdecl;
    }
    IL(bclone, AST_F0) = (unsigned long)first;
    void *se = kcc_ast_alloc(AST_STMT_EXPR);
    IL(se, AST_F0) = (unsigned long)bclone;
    *out = kcc_ir_build_stmt_expr(se);
    return 1;
}

unsigned long kcc_ir_build_call(void *e) {
    void *callee = (void *)IL(e, AST_F0);
    if (!callee) return 0;
    unsigned long indirect = 0;
    const char *name = 0;
    if (IL(callee, AST_TAG) == AST_IDENT_EXPR) {
        name = (const char *)IL(callee, AST_F0);
        if (kcc_strcmp(name, "va_start") == 0 ||
            kcc_strcmp(name, "__builtin_va_start") == 0) return kcc_ir_build_va_start(e);
        if (kcc_strcmp(name, "va_end") == 0 ||
            kcc_strcmp(name, "__builtin_va_end") == 0) return 0;
        /* Common GNU builtins the kernel leans on pervasively:
           __builtin_expect(x,c) is a branch hint -> just x; constant_p is a
           compile-time predicate; the mem* builtins are the libc entry points. */
        if (kcc_strcmp(name, "__builtin_expect") == 0)
            return kcc_ir_build_expr((void *)IL(e, AST_F1));
        if (kcc_strcmp(name, "__builtin_constant_p") == 0)
            return kcc_ir_emit_const(kcc_expr_is_ice((void *)IL(e, AST_F1)) ? 1 : 0);
        /* __builtin_bswapN: reverse byte order with a portable IR gather. */
        if (kcc_strcmp(name, "__builtin_bswap16") == 0)
            return kcc_ir_bswap(kcc_ir_build_expr((void *)IL(e, AST_F1)), 2);
        if (kcc_strcmp(name, "__builtin_bswap32") == 0)
            return kcc_ir_bswap(kcc_ir_build_expr((void *)IL(e, AST_F1)), 4);
        if (kcc_strcmp(name, "__builtin_bswap64") == 0)
            return kcc_ir_bswap(kcc_ir_build_expr((void *)IL(e, AST_F1)), 8);
        /* __builtin_unreachable() marks a point control never reaches; with no
           undefined-behaviour exploitation a plain fall-through is safe, so it
           yields a dummy value and emits nothing. */
        if (kcc_strcmp(name, "__builtin_unreachable") == 0)
            return kcc_ir_emit_const(0);
        /* Bit-scan builtins lower to portable bit-twiddling (like bswap), so
           they stay freestanding-correct without a new opcode. clz/ctz on the
           `l`/`ll` widths operate on 64 bits, the plain form on 32. */
        if (kcc_strcmp(name, "__builtin_clz") == 0)
            return kcc_ir_clz(kcc_ir_build_expr((void *)IL(e, AST_F1)), 32);
        if (kcc_strcmp(name, "__builtin_clzl") == 0 ||
            kcc_strcmp(name, "__builtin_clzll") == 0)
            return kcc_ir_clz(kcc_ir_build_expr((void *)IL(e, AST_F1)), 64);
        if (kcc_strcmp(name, "__builtin_ctz") == 0)
            return kcc_ir_ctz(kcc_ir_build_expr((void *)IL(e, AST_F1)), 32);
        if (kcc_strcmp(name, "__builtin_ctzl") == 0 ||
            kcc_strcmp(name, "__builtin_ctzll") == 0)
            return kcc_ir_ctz(kcc_ir_build_expr((void *)IL(e, AST_F1)), 64);
        if (kcc_strcmp(name, "__builtin_popcount") == 0)
            return kcc_ir_popcount(kcc_ir_build_expr((void *)IL(e, AST_F1)), 32);
        if (kcc_strcmp(name, "__builtin_popcountl") == 0 ||
            kcc_strcmp(name, "__builtin_popcountll") == 0)
            return kcc_ir_popcount(kcc_ir_build_expr((void *)IL(e, AST_F1)), 64);
        if (kcc_strcmp(name, "__builtin_ffs") == 0)
            return kcc_ir_ffs(kcc_ir_build_expr((void *)IL(e, AST_F1)), 32);
        if (kcc_strcmp(name, "__builtin_ffsl") == 0 ||
            kcc_strcmp(name, "__builtin_ffsll") == 0)
            return kcc_ir_ffs(kcc_ir_build_expr((void *)IL(e, AST_F1)), 64);
        /* __builtin_trap() must terminate; lower it to a call to abort. */
        if (kcc_strcmp(name, "__builtin_trap") == 0) name = "abort";
        /* abs family has an exact libc counterpart (valid while the milestone
           links against a C library). */
        else if (kcc_strcmp(name, "__builtin_abs") == 0) name = "abs";
        else if (kcc_strcmp(name, "__builtin_labs") == 0) name = "labs";
        else if (kcc_strcmp(name, "__builtin_llabs") == 0) name = "llabs";
        else if (kcc_strcmp(name, "__builtin_memcpy") == 0) name = "memcpy";
        else if (kcc_strcmp(name, "__builtin_memmove") == 0) name = "memmove";
        else if (kcc_strcmp(name, "__builtin_memset") == 0) name = "memset";
        else if (kcc_strcmp(name, "__builtin_strlen") == 0) name = "strlen";
        else if (kcc_strcmp(name, "__builtin_strcpy") == 0) name = "strcpy";
        else if (kcc_strcmp(name, "__builtin_strcmp") == 0) name = "strcmp";
        unsigned long v = (unsigned long)kcc_ht_get(kcc_ir_locals, name, kcc_strlen(name));
        /* An always_inline callee (not shadowed by a local of the same name) is
           expanded in place rather than called. */
        if (!v) {
            unsigned long inl;
            if (kcc_ir_try_inline(e, name, &inl)) return inl;
        }
        if (v) indirect = 1;
        else {
            void *ct = (void *)IL(callee, AST_F3);
            if (ct && IL(ct, TY_KIND) == TY_PTR) indirect = 1;
        }
    } else {
        indirect = 1;
    }

    /* count args */
    unsigned long argc = 0;
    void *a = (void *)IL(e, AST_F1);
    while (a) { argc++; a = (void *)IL(a, AST_F4); }

    /* aggregate return-by-value: reserve a result buffer */
    unsigned long sret = 0;                          /* buffer vreg + 1, 0 = none */
    void *rt = (void *)IL(e, AST_F3);
    if (rt && (IL(rt, TY_KIND) == TY_STRUCT || IL(rt, TY_KIND) == TY_UNION)) {
        unsigned long slots = kcc_ir_type_slots(rt);
        void *al = kcc_ir_alloc_instr(IR_ALLOCA);
        IL(al, IR_TYPE) = (unsigned long)rt;
        IL(al, IR_SRC1) = slots;
        unsigned long bv = kcc_ir_next_vreg();
        IL(al, IR_DEST) = bv;
        kcc_ir_emit(al);
        sret = bv + 1;
    }

    unsigned long total = argc + (sret ? 1 : 0);
    unsigned long *args = kcc_arena_alloc((1 + total * 2) * 8);

    /* first_stack_idx */
    unsigned long fsi = 1;
    void *ct = (void *)IL(callee, AST_F3);
    if (ct) {
        unsigned long k = IL(ct, TY_KIND);
        void *ft = 0;
        if (k == TY_PTR) { ft = (void *)IL(ct, TY_F0); }
        else if (k == TY_FUNC) ft = ct;
        if (ft && IL(ft, TY_KIND) == TY_FUNC) {
            unsigned long nfixed = IL(ft, TY_QUALS);
            if (nfixed) { fsi = nfixed; if (fsi > 8) fsi = 8; }
        }
    }
    args[0] = total | (fsi << 32);

    /* parameter cursor for prototyped conversion/classification */
    void *pcur = 0;
    if (ct) {
        unsigned long k = IL(ct, TY_KIND);
        void *ft = 0;
        if (k == TY_FUNC) ft = ct;
        else if (k == TY_PTR) { void *p = (void *)IL(ct, TY_F0); if (p && IL(p, TY_KIND) == TY_FUNC) ft = p; }
        if (ft) pcur = (void *)IL(ft, TY_F1);
    }

    a = (void *)IL(e, AST_F1);
    unsigned long i = 0;
    while (i < argc) {
        void *ptype = 0;
        if (pcur) {
            void *ptn = (void *)IL(pcur, AST_F0);
            if (ptn) ptype = kcc_sema_resolve_type(ptn);
            pcur = (void *)IL(pcur, AST_F4);
        }
        void *cls_type = ptype ? ptype : (void *)IL(a, AST_F3);
        unsigned long cls = kcc_ir_classify_type(cls_type);
        unsigned long vreg;
        if (cls >= 2) {
            vreg = kcc_ir_build_struct_addr(a);
        } else {
            vreg = kcc_ir_build_expr(a);
            if (ptype) vreg = kcc_ir_convert(vreg, (void *)IL(a, AST_F3), ptype);
        }
        args[1 + i * 2] = vreg;
        args[2 + i * 2] = cls;
        a = (void *)IL(a, AST_F4);
        i++;
    }
    if (sret) {
        args[1 + argc * 2] = sret - 1;
        args[2 + argc * 2] = 5;                      /* class X8 */
    }

    void *inst;
    if (indirect) {
        /* peel parens and a dereference of a function pointer */
        void *ce = callee;
        while (1) {
            unsigned long t = IL(ce, AST_TAG);
            if (t == AST_PAREN_EXPR) { void *in = (void *)IL(ce, AST_F0); if (!in) break; ce = in; continue; }
            if (t == AST_UNARY_EXPR && IL(ce, AST_F0) == TOK_STAR) {
                void *dt = (void *)IL(ce, AST_F3);
                if (dt && IL(dt, TY_KIND) == TY_FUNC) {
                    void *op = (void *)IL(ce, AST_F1);
                    if (!op) break;
                    ce = op; continue;
                }
            }
            break;
        }
        unsigned long fnptr = kcc_ir_build_expr(ce);
        inst = kcc_ir_alloc_instr(IR_CALL_IND);
        IL(inst, IR_SRC1) = fnptr;
    } else {
        inst = kcc_ir_alloc_instr(IR_CALL);
        IL(inst, IR_SRC1) = (unsigned long)name;
    }
    IL(inst, IR_SRC2) = (unsigned long)args;
    IL(inst, IR_TYPE) = rt ? (unsigned long)rt : (unsigned long)kcc_type_int_s;
    if (sret) IL(inst, IR_DEST) = sret - 1;
    else IL(inst, IR_DEST) = kcc_ir_next_vreg();
    kcc_ir_emit(inst);
    if (sret) return sret - 1;
    return IL(inst, IR_DEST);
}

unsigned long kcc_ir_ident_alloca(void *ident) {
    if (!ident) return (unsigned long)-1;
    unsigned long tag = IL(ident, AST_TAG);
    if (tag == AST_SUBSCRIPT) return kcc_ir_build_subscript_addr(ident);
    if (tag == AST_MEMBER) return kcc_ir_build_member_addr(ident);
    if (tag != AST_IDENT_EXPR) return (unsigned long)-1;
    char *name = (char *)IL(ident, AST_F0);
    if (!name) return (unsigned long)-1;
    unsigned long v = (unsigned long)kcc_ht_get(kcc_ir_locals, name, kcc_strlen(name));
    if (v) return (v & ~0x8000000000000000UL) - 1;
    /* file-scope va_list: its global-ref address */
    void *g = kcc_ir_alloc_instr(IR_GLOBAL_REF);
    IL(g, IR_SRC1) = (unsigned long)name;
    IL(g, IR_TYPE) = (unsigned long)kcc_type_int_s;
    unsigned long rv = kcc_ir_next_vreg();
    IL(g, IR_DEST) = rv;
    kcc_ir_emit(g);
    return rv;
}

/* small IR emitters for the x86-64 System V va_list lowering */
static unsigned long ir_vc(unsigned long v) {
    void *n = kcc_ir_alloc_instr(IR_CONST);
    IL(n, IR_TYPE) = (unsigned long)kcc_type_long_s;
    IL(n, IR_SRC1) = v;
    unsigned long d = kcc_ir_next_vreg(); IL(n, IR_DEST) = d; kcc_ir_emit(n);
    return d;
}
static unsigned long ir_v2(unsigned long op, unsigned long a, unsigned long b) {
    void *n = kcc_ir_alloc_instr(op);
    IL(n, IR_TYPE) = (unsigned long)kcc_type_long_s;
    IL(n, IR_SRC1) = a; IL(n, IR_SRC2) = b;
    unsigned long d = kcc_ir_next_vreg(); IL(n, IR_DEST) = d; kcc_ir_emit(n);
    return d;
}
static unsigned long ir_vload(unsigned long addr, void *ty) {
    void *n = kcc_ir_alloc_instr(IR_LOAD);
    IL(n, IR_TYPE) = (unsigned long)ty;
    IL(n, IR_SRC1) = addr;
    unsigned long d = kcc_ir_next_vreg(); IL(n, IR_DEST) = d; kcc_ir_emit(n);
    return d;
}
static void ir_vstore(unsigned long val, unsigned long addr, void *ty) {
    void *n = kcc_ir_alloc_instr(IR_STORE);
    IL(n, IR_TYPE) = (unsigned long)ty;
    IL(n, IR_SRC1) = val; IL(n, IR_SRC2) = addr;
    kcc_ir_emit(n);
}

/* Branchless System V va_arg: the register-save area (rdi-r9 at +0, xmm0-7 at
   +48) and the stack overflow area are picked without a jump ---
   addr = overflow + c*(reg_addr - overflow), c = (offset < limit). */
static unsigned long ir_va_arg_sysv(unsigned long ap, int fp) {
    unsigned long off_field = fp ? 8 : 0;
    unsigned long base_off  = fp ? 48 : 0;
    unsigned long limit     = fp ? 128 : 48;
    unsigned long reg_adv   = fp ? 16 : 8;
    unsigned long S      = ir_vload(ap, kcc_type_long_s);              /* &va_list */
    unsigned long S_off  = ir_v2(IR_ADD, S, ir_vc(off_field));
    unsigned long off    = ir_vload(S_off, kcc_type_long_s);
    unsigned long c      = ir_v2(IR_CMP_ULT, off, ir_vc(limit));       /* 0/1 */
    unsigned long rs     = ir_vload(ir_v2(IR_ADD, S, ir_vc(24)), kcc_type_long_s);
    unsigned long ra     = ir_v2(IR_ADD, ir_v2(IR_ADD, rs, ir_vc(base_off)), off);
    unsigned long S_ov   = ir_v2(IR_ADD, S, ir_vc(16));
    unsigned long ov     = ir_vload(S_ov, kcc_type_long_s);
    unsigned long diff   = ir_v2(IR_SUB, ra, ov);
    unsigned long addr   = ir_v2(IR_ADD, ov, ir_v2(IR_MUL, c, diff));
    unsigned long val    = ir_vload(addr, fp ? kcc_type_double : kcc_type_long_s);
    ir_vstore(ir_v2(IR_ADD, off, ir_v2(IR_MUL, c, ir_vc(reg_adv))), S_off, kcc_type_long_s);
    ir_vstore(ir_v2(IR_ADD, ov, ir_v2(IR_MUL, ir_v2(IR_SUB, ir_vc(1), c), ir_vc(8))), S_ov, kcc_type_long_s);
    return val;
}

unsigned long kcc_ir_build_va_start(void *call) {
    unsigned long ap = kcc_ir_ident_alloca((void *)IL(call, AST_F1));
    if (kcc_target) {                    /* x86-64: build the System V va_list struct */
        unsigned long np = IL(kcc_ir_cur_func, IRF_PARAMS);
        void *cls = (void *)IL(kcc_ir_cur_func, IRF_PARAM_CLS);
        unsigned long ngp = 0, nfp = 0;
        for (unsigned long p = 0; p < np; p++) {
            unsigned long cl = cls ? ((unsigned long *)cls)[p] : 0;
            if (cl == 1) nfp++; else ngp++;
        }
        if (ngp > 6) ngp = 6;
        if (nfp > 8) nfp = 8;
        void *a = kcc_ir_alloc_instr(IR_ALLOCA);       /* 32-byte struct (4 slots) */
        IL(a, IR_TYPE) = (unsigned long)kcc_type_long_s;
        IL(a, IR_SRC1) = 4;
        unsigned long S = kcc_ir_next_vreg();
        IL(a, IR_DEST) = S;
        kcc_ir_emit(a);
        void *vs = kcc_ir_alloc_instr(IR_VA_START);
        IL(vs, IR_TYPE) = (unsigned long)kcc_type_int_s;
        IL(vs, IR_SRC1) = S;
        IL(vs, IR_SRC2) = (nfp << 8) | ngp;
        unsigned long d = kcc_ir_next_vreg();
        IL(vs, IR_DEST) = d;
        kcc_ir_emit(vs);
        ir_vstore(S, ap, kcc_type_long_s);
        return S;
    }
    unsigned long F = IL(kcc_ir_cur_func, IRF_PARAMS);
    void *vs = kcc_ir_alloc_instr(IR_VA_START);
    IL(vs, IR_TYPE) = (unsigned long)kcc_type_int_s;
    IL(vs, IR_SRC2) = F;
    unsigned long base = kcc_ir_next_vreg();
    IL(vs, IR_DEST) = base;
    kcc_ir_emit(vs);
    void *st = kcc_ir_alloc_instr(IR_STORE);
    IL(st, IR_TYPE) = (unsigned long)kcc_type_int_s;
    IL(st, IR_SRC1) = base;
    IL(st, IR_SRC2) = ap;
    kcc_ir_emit(st);
    return base;
}

unsigned long kcc_ir_build_va_arg(void *va) {
    unsigned long ap = kcc_ir_ident_alloca((void *)IL(va, AST_F0));
    if (kcc_target) {                    /* x86-64 System V */
        /* AST_F1 is the unresolved type-name node; resolve it to a Type before
           reading its kind, so float/double arguments take the %xmm path. */
        void *ty = kcc_sema_resolve_type((void *)IL(va, AST_F1));
        int fp = ty && (IL(ty, TY_KIND) >= TY_FLOAT && IL(ty, TY_KIND) <= TY_LDOUBLE);
        return ir_va_arg_sysv(ap, fp);
    }
    void *ld1 = kcc_ir_alloc_instr(IR_LOAD);
    IL(ld1, IR_TYPE) = (unsigned long)kcc_type_int_s;
    IL(ld1, IR_SRC1) = ap;
    unsigned long p = kcc_ir_next_vreg();
    IL(ld1, IR_DEST) = p;
    kcc_ir_emit(ld1);
    void *ld2 = kcc_ir_alloc_instr(IR_LOAD);
    IL(ld2, IR_TYPE) = (unsigned long)kcc_type_int_s;
    IL(ld2, IR_SRC1) = p;
    unsigned long val = kcc_ir_next_vreg();
    IL(ld2, IR_DEST) = val;
    kcc_ir_emit(ld2);
    void *c = kcc_ir_alloc_instr(IR_CONST);
    IL(c, IR_TYPE) = (unsigned long)kcc_type_int_s;
    IL(c, IR_SRC1) = 8;
    unsigned long c8 = kcc_ir_next_vreg();
    IL(c, IR_DEST) = c8;
    kcc_ir_emit(c);
    void *add = kcc_ir_alloc_instr(IR_ADD);
    IL(add, IR_TYPE) = (unsigned long)kcc_type_int_s;
    IL(add, IR_SRC1) = p;
    IL(add, IR_SRC2) = c8;
    unsigned long p2 = kcc_ir_next_vreg();
    IL(add, IR_DEST) = p2;
    kcc_ir_emit(add);
    void *st = kcc_ir_alloc_instr(IR_STORE);
    IL(st, IR_TYPE) = (unsigned long)kcc_type_int_s;
    IL(st, IR_SRC1) = p2;
    IL(st, IR_SRC2) = ap;
    kcc_ir_emit(st);
    return val;
}

unsigned long kcc_ir_build_string_lit(void *lit) {
    void *inst = kcc_ir_alloc_instr(IR_STRING_LIT);
    IL(inst, IR_SRC1) = IL(lit, AST_F0);
    IL(inst, IR_SRC2) = IL(lit, AST_F1);
    IL(inst, IR_TYPE) = (unsigned long)kcc_type_int_s;
    unsigned long v = kcc_ir_next_vreg();
    IL(inst, IR_DEST) = v;
    kcc_ir_emit(inst);
    return v;
}

unsigned long kcc_ir_build_cond_expr(void *e) {
    /* Constant condition: evaluate only the taken arm (and lower only it).
       The kernel's `__builtin_constant_p(nr) ? constant_test_bit(nr,a)
       : variable_test_bit(nr,a)` folds here — for a runtime `nr` the predicate
       is 0, so the constant-only arm (whose asm needs an immediate) is dropped. */
    void *cc = (void *)IL(e, AST_F0);
    if (kcc_expr_is_ice(cc)) {
        if (kcc_eval_const_int(cc)) {
            void *ta = (void *)IL(e, AST_F1);
            return ta ? kcc_ir_build_expr(ta) : kcc_ir_build_expr(cc);
        }
        return kcc_ir_build_expr((void *)IL(e, AST_F2));
    }
    void *tmp = kcc_ir_alloc_instr(IR_ALLOCA);
    IL(tmp, IR_TYPE) = (unsigned long)kcc_type_int_s;
    unsigned long slot = kcc_ir_next_vreg();
    IL(tmp, IR_DEST) = slot;
    kcc_ir_emit(tmp);
    unsigned long cond = kcc_ir_build_expr((void *)IL(e, AST_F0));
    void *then_bb = kcc_ir_alloc_bb();
    void *else_bb = kcc_ir_alloc_bb();
    void *merge_bb = kcc_ir_alloc_bb();
    ir_brcond(cond, then_bb, else_bb);
    kcc_ir_set_bb(then_bb);
    /* GNU `a ?: b': the omitted middle operand (AST_F1 == 0) reuses the
       already-computed condition value, so `a' is evaluated exactly once. */
    void *then_ast = (void *)IL(e, AST_F1);
    unsigned long tv = then_ast ? kcc_ir_build_expr(then_ast) : cond;
    void *st1 = kcc_ir_alloc_instr(IR_STORE);
    IL(st1, IR_TYPE) = (unsigned long)kcc_type_int_s;
    IL(st1, IR_SRC1) = tv;
    IL(st1, IR_SRC2) = slot;
    kcc_ir_emit(st1);
    kcc_ir_branch_to(merge_bb);
    kcc_ir_set_bb(else_bb);
    unsigned long ev = kcc_ir_build_expr((void *)IL(e, AST_F2));
    void *st2 = kcc_ir_alloc_instr(IR_STORE);
    IL(st2, IR_TYPE) = (unsigned long)kcc_type_int_s;
    IL(st2, IR_SRC1) = ev;
    IL(st2, IR_SRC2) = slot;
    kcc_ir_emit(st2);
    kcc_ir_branch_to(merge_bb);
    kcc_ir_set_bb(merge_bb);
    void *ld = kcc_ir_alloc_instr(IR_LOAD);
    IL(ld, IR_TYPE) = (unsigned long)kcc_type_int_s;
    IL(ld, IR_SRC1) = slot;
    unsigned long res = kcc_ir_next_vreg();
    IL(ld, IR_DEST) = res;
    kcc_ir_emit(ld);
    return res;
}

unsigned long kcc_ir_build_cast(void *cast) {
    void *inner = (void *)IL(cast, AST_F1);
    unsigned long src = kcc_ir_build_expr(inner);
    void *to = (void *)IL(cast, AST_F3);
    if (!to) return src;
    void *from = (void *)IL(inner, AST_F3);
    if (!from) return src;
    /* __int128 casts.  Widening an integer into a __int128 fills a fresh
       16-byte slot (low half = src, high half zero- or sign-extended) and
       yields the slot address.  Narrowing a __int128 back to an integer loads
       its low half, then resizes if the target is under 8 bytes. */
    if (IL(to, TY_KIND) == TY_INT128) {
        if (IL(from, TY_KIND) == TY_INT128) return src;   /* already a slot */
        unsigned long slot = kcc_ir_i128_slot();
        unsigned long hi = kcc_ir_emit_const(0);
        if (IL(from, TY_KIND) != TY_PTR && IL(from, TY_F0) != 0)
            hi = kcc_ir_emit_binop(IR_ASHR, src, kcc_ir_emit_const(63));
        kcc_ir_i128_set(slot, src, hi);
        return slot;
    }
    if (IL(from, TY_KIND) == TY_INT128) {
        unsigned long lo = kcc_ir_emit_load(src, 0);   /* 0 = 8-byte integer load */
        unsigned long ts0 = IL(to, TY_SIZE);
        if (ts0 >= 8) return lo;
        void *inst = kcc_ir_alloc_instr(IL(to, TY_F0) ? IR_SEXT : IR_ZEXT);
        IL(inst, IR_TYPE) = (unsigned long)to;
        IL(inst, IR_SRC1) = lo;
        IL(inst, IR_SRC2) = ts0;
        unsigned long r0 = kcc_ir_next_vreg();
        IL(inst, IR_DEST) = r0;
        kcc_ir_emit(inst);
        return r0;
    }
    if (kcc_ir_type_is_fp(to) || kcc_ir_type_is_fp(from))
        return kcc_ir_convert(src, from, to);
    /* integer resize */
    if (IL(to, TY_KIND) == TY_BOOL) return kcc_ir_emit_bool_norm(src);
    unsigned long ts = IL(to, TY_SIZE);
    unsigned long fs = IL(from, TY_SIZE);
    if (ts == fs) {
        if (ts >= 8) return src;
        unsigned long tsign = IL(to, TY_F0);
        if (tsign == IL(from, TY_F0)) return src;    /* same width & sign */
        void *inst = kcc_ir_alloc_instr(tsign ? IR_SEXT : IR_ZEXT);
        IL(inst, IR_TYPE) = (unsigned long)to;
        IL(inst, IR_SRC1) = src;
        IL(inst, IR_SRC2) = ts;
        unsigned long r = kcc_ir_next_vreg();
        IL(inst, IR_DEST) = r;
        kcc_ir_emit(inst);
        return r;
    }
    /* different width: re-canonicalise to target width and signedness */
    void *inst = kcc_ir_alloc_instr(IL(to, TY_F0) ? IR_SEXT : IR_ZEXT);
    IL(inst, IR_TYPE) = (unsigned long)to;
    IL(inst, IR_SRC1) = src;
    IL(inst, IR_SRC2) = ts;
    unsigned long r = kcc_ir_next_vreg();
    IL(inst, IR_DEST) = r;
    kcc_ir_emit(inst);
    return r;
}
@}

\section{Dump and Validation}

The \texttt{--dump-ir} printer and the structural validator round out the
module.  Neither is exercised by \texttt{difftest} (the dump runs only under a
debug flag, and the validator returns 0 for well-formed IR), but both are
exported symbols the driver links against, so the port must define them.

@l c
@d Selfhost: ir dump @{
static const char *ir_op_name(unsigned long op) {
    if (op == IR_ADD) return "add";
    if (op == IR_SUB) return "sub";
    if (op == IR_MUL) return "mul";
    if (op == IR_SDIV) return "sdiv";
    if (op == IR_UDIV) return "udiv";
    if (op == IR_SMOD) return "smod";
    if (op == IR_UMOD) return "umod";
    if (op == IR_NEG) return "neg";
    if (op == IR_AND) return "and";
    if (op == IR_OR) return "or";
    if (op == IR_XOR) return "xor";
    if (op == IR_SHL) return "shl";
    if (op == IR_LSHR) return "lshr";
    if (op == IR_ASHR) return "ashr";
    if (op == IR_NOT) return "not";
    if (op == IR_CMP_EQ) return "cmp_eq";
    if (op == IR_CMP_NE) return "cmp_ne";
    if (op == IR_CMP_SLT) return "cmp_slt";
    if (op == IR_CMP_SLE) return "cmp_sle";
    if (op == IR_CMP_SGT) return "cmp_sgt";
    if (op == IR_CMP_SGE) return "cmp_sge";
    if (op == IR_CMP_ULT) return "cmp_ult";
    if (op == IR_CMP_ULE) return "cmp_ule";
    if (op == IR_SEXT) return "sext";
    if (op == IR_ZEXT) return "zext";
    if (op == IR_TRUNC) return "trunc";
    if (op == IR_BITCAST) return "bitcast";
    if (op == IR_SITOFP) return "sitofp";
    if (op == IR_UITOFP) return "uitofp";
    if (op == IR_FPTOSI) return "fptosi";
    return "???";
}

void kcc_ir_dump_type_short(void *t) {
    if ((unsigned long)t < 0x1000) { kcc_io_puts("?type"); return; }
    if (IL(t, TY_QUALS) & 2) kcc_io_puts("volatile ");
    unsigned long k = IL(t, TY_KIND);
    const char *s;
    if (k == TY_VOID) s = "void";
    else if (k == TY_BOOL) s = "i1";
    else if (k == TY_CHAR) s = "i8";
    else if (k == TY_SHORT) s = "i16";
    else if (k == TY_INT || k == TY_ENUM) s = "i32";
    else if (k == TY_LONG || k == TY_LLONG) s = "i64";
    else if (k == TY_FLOAT) s = "f32";
    else if (k == TY_DOUBLE) s = "f64";
    else if (k == TY_PTR || k == TY_ARRAY || k == TY_FUNC) s = "ptr";
    else if (k == TY_STRUCT || k == TY_UNION) s = "struct";
    else s = "?type";
    kcc_io_puts(s);
}

void kcc_ir_dump_instr(void *i) {
    unsigned long op = IL(i, IR_OP);
    kcc_io_puts("    ");
    if (!(op == IR_STORE || op == IR_BR || op == IR_BR_COND || op == IR_RET || op == IR_NOP)) {
        kcc_io_putc('%'); kcc_io_putu(IL(i, IR_DEST)); kcc_io_puts(" = ");
    }
    void *ty = (void *)IL(i, IR_TYPE);
    unsigned long s1 = IL(i, IR_SRC1), s2 = IL(i, IR_SRC2);
    if (op == IR_LOAD) {
        kcc_io_puts("load "); kcc_ir_dump_type_short(ty); kcc_io_puts(", ptr %"); kcc_io_putu(s1);
    } else if (op == IR_STORE) {
        kcc_io_puts("store "); kcc_ir_dump_type_short(ty);
        kcc_io_puts(" %"); kcc_io_putu(s1); kcc_io_puts(", ptr %"); kcc_io_putu(s2);
    } else if (op == IR_ALLOCA) {
        kcc_io_puts("alloca "); kcc_ir_dump_type_short(ty);
    } else if (op == IR_GEP) {
        kcc_io_puts("gep %"); kcc_io_putu(s1); kcc_io_puts(", %"); kcc_io_putu(s2);
    } else if (op == IR_BR) {
        kcc_io_puts("br bb"); kcc_io_putu(s1);
    } else if (op == IR_BR_COND) {
        kcc_io_puts("br_cond %"); kcc_io_putu(IL(i, IR_DEST));
        kcc_io_puts(", bb"); kcc_io_putu(s1); kcc_io_puts(", bb"); kcc_io_putu(s2);
    } else if (op == IR_RET) {
        kcc_io_puts("ret "); kcc_ir_dump_type_short(ty);
        if (ty && IL(ty, TY_KIND) != TY_VOID) { kcc_io_puts(" %"); kcc_io_putu(s1); }
    } else if (op == IR_CALL) {
        kcc_io_puts("call "); kcc_ir_dump_type_short(ty);
        kcc_io_puts(" @@"); if (s1) kcc_io_puts((const char *)s1);
    } else if (op == IR_CALL_IND) {
        kcc_io_puts("call_ind "); kcc_ir_dump_type_short(ty); kcc_io_puts(" %"); kcc_io_putu(s1);
    } else if (op == IR_CONST) {
        kcc_io_puts("const "); kcc_ir_dump_type_short(ty); kcc_io_putc(' '); kcc_io_putu(s1);
    } else if (op == IR_NOP) {
        kcc_io_puts("nop");
    } else if (op == IR_GLOBAL_REF) {
        kcc_io_puts("global_ref "); kcc_ir_dump_type_short(ty);
        kcc_io_puts(" @@"); if (s1) kcc_io_puts((const char *)s1);
    } else if (op == IR_STRING_LIT) {
        kcc_io_putc('"');
        const char *d = (const char *)s1;
        unsigned long j = 0;
        while (j < s2) { kcc_io_putc((unsigned char)d[j]); j++; }
        kcc_io_putc('"');
    } else if (op == IR_NEG || op == IR_NOT || op == IR_SEXT || op == IR_ZEXT ||
               op == IR_TRUNC || op == IR_BITCAST || op == IR_SITOFP ||
               op == IR_UITOFP || op == IR_FPTOSI) {
        kcc_io_puts(ir_op_name(op)); kcc_io_putc(' ');
        kcc_ir_dump_type_short(ty); kcc_io_puts(" %"); kcc_io_putu(s1);
    } else {
        kcc_io_puts(ir_op_name(op)); kcc_io_putc(' ');
        kcc_ir_dump_type_short(ty);
        kcc_io_puts(" %"); kcc_io_putu(s1); kcc_io_puts(", %"); kcc_io_putu(s2);
    }
    kcc_io_putc('\n');
}

void kcc_ir_dump(void) {
    void *vec = kcc_ir_funcs;
    if (!vec) return;
    unsigned long n = IL(vec, VEC_COUNT);
    unsigned long i = 0;
    while (i < n) {
        void **slot = kcc_vec_get(vec, i);
        void *f = *slot;
        kcc_io_puts("func @@");
        kcc_io_puts((const char *)IL(f, IRF_NAME));
        kcc_io_puts("() -> ");
        kcc_ir_dump_type_short((void *)IL(f, IRF_RETTYPE));
        kcc_io_puts(":\n");
        void *bvec = (void *)IL(f, IRF_BLOCKS);
        if (bvec) {
            unsigned long bn = IL(bvec, VEC_COUNT);
            unsigned long j = 0;
            while (j < bn) {
                void **bslot = kcc_vec_get(bvec, j);
                void *bb = *bslot;
                kcc_io_puts("  bb"); kcc_io_putu(IL(bb, BB_ID)); kcc_io_puts(":\n");
                void *ins = (void *)IL(bb, BB_FIRST);
                while (ins) { kcc_ir_dump_instr(ins); ins = (void *)IL(ins, IR_NEXT); }
                j++;
            }
            kcc_io_putc('\n');
        }
        i++;
    }
    kcc_io_flush();
}

unsigned long kcc_ir_validate(void) {
    void *vec = kcc_ir_funcs;
    if (!vec) return 0;
    unsigned long n = IL(vec, VEC_COUNT);
    unsigned long i = 0;
    while (i < n) {
        void **slot = kcc_vec_get(vec, i);
        void *f = *slot;
        const char *msg = 0;
        void *bb = (void *)IL(f, IRF_ENTRY);
        while (bb && !msg) {
            void *ins = (void *)IL(bb, BB_FIRST);
            unsigned long cnt = 0;
            while (ins) {
                cnt++;
                if (cnt > 0x100000) { msg = "kcc: internal error: cyclic instruction list in function "; break; }
                unsigned long op = IL(ins, IR_OP);
                if (op == 0 || op > IR_ASM) { msg = "kcc: internal error: invalid IR opcode in function "; break; }
                ins = (void *)IL(ins, IR_NEXT);
            }
            if (!msg && IL(bb, BB_FIRST) && !(IL(bb, BB_FLAGS) & BB_FLAG_TERMINATED))
                msg = "kcc: internal error: unterminated basic block in function ";
            bb = (void *)IL(bb, BB_NEXT);
        }
        if (msg) {
            kcc_io_puts(msg);
            void *nm = (void *)IL(f, IRF_NAME);
            if (nm) kcc_io_puts((const char *)nm);
            kcc_io_puts("\n");
            return 1;
        }
        i++;
    }
    return 0;
}
@}

\section{Composition and Verification}

The complete C module assembles the fragments in dependency order; the verify
script compiles it with \kcc{}, links it in place of the assembly \texttt{ir.o},
and runs the byte-exact \texttt{difftest} plus \texttt{diagtest} and the
code-generation suite.

@d Selfhost: ir @{
@<Selfhost: ir preamble@>
@<Selfhost: ir design@>
@<Selfhost: ir spine@>
@<Selfhost: ir exprs@>
@<Selfhost: ir aggregates@>
@<Selfhost: ir control@>
@<Selfhost: ir assigncall@>
@<Selfhost: ir dump@>
@}

@d Selfhost: ir verify @{
#!/usr/bin/env bash
# make selfhost-ir — compile kcc's IR builder in C with kcc, relink, run
# difftest + diagtest + codegen.  The IR determines every downstream byte, so
# difftest byte-comparing against clang is the strongest possible oracle.
set -euo pipefail
SDK=$(xcrun --show-sdk-path)
SH=tmp/selfhost
sources="main syscalls arena strings io hashtab vec strtab source lexer \
lexer_tables diag preprocessor parser expressions statements declarations \
types symtab conversions sema ir opt emit_arm64 emit_x86 linker codegen emit_macho dwarf driver"
echo "[1/4] compiling tmp/selfhost/ir.c with kcc"
tmp/kcc -c "$SH/ir.c" -o "$SH/ir_c.o" >/dev/null
echo "[2/4] linking tmp/kcc_selfhost_ir (ir.o -> C)"
OBJ=""
for f in $sources; do
    if [ "$f" = "ir" ]; then OBJ="$OBJ $SH/ir_c.o"; else OBJ="$OBJ tmp/src/${f}.o"; fi
done
ld -o tmp/kcc_selfhost_ir $OBJ -lSystem -syslibroot "$SDK" -e _main -arch arm64
cp tmp/kcc "$SH/kcc_asm_backup_ir"
cp tmp/kcc_selfhost_ir tmp/kcc
echo "[3/4] difftest (byte-compare) + diagtest"
set +e
bash tmp/tests/difftest.sh >/tmp/ir_difftest.log 2>&1; dstatus=$?
tail -1 /tmp/ir_difftest.log
bash tmp/tests/diagtest.sh >/tmp/ir_diag.log 2>&1; diagst=$?
tail -1 /tmp/ir_diag.log
set -e
if [ $dstatus -ne 0 ] || [ $diagst -ne 0 ]; then cp "$SH/kcc_asm_backup_ir" tmp/kcc; exit 1; fi
echo "[4/4] codegen suite with the self-hosted IR builder"
set +e
bash tmp/tests/test_codegen.sh
status=$?
cp "$SH/kcc_asm_backup_ir" tmp/kcc
exit $status
@}
