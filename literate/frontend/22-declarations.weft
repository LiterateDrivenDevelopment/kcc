% 22-declarations.weft — Declaration Parsing
%
% This chapter implements declaration parsing for the C17 recursive-descent
% parser.  Declarations are the most complex part of C syntax: a declaration
% consists of declaration specifiers (storage class, type specifiers,
% qualifiers) followed by a declarator that introduces a name.
%
% The key challenge is typedef disambiguation: the parser must know which
% identifiers are typedef names to correctly parse declarations.  This is
% handled by the typedef table from Chapter~\ref{ch:parser}.
%
% The grammar follows ISO 9899:2018 section 6.7.

\chapter{Declaration Parsing}
\label{ch:declarations}

Declarations are the most syntactically complex part of C: a declaration combines storage-class specifiers, type specifiers, qualifiers, and declarators into a form that introduces names into scope (\stdref{6.7}).  The central difficulty is typedef disambiguation---the parser must consult the typedef table to decide whether an identifier begins a new declaration or an expression.  This chapter walks through the full declaration grammar, from top-level specifiers and nested declarators to struct/union/enum definitions, initializers, and \texttt{\_Static\_assert}.

\section{Declaration}

A declaration (\stdref{6.7}) has the form:
\begin{center}
\textit{declaration-specifiers} \textit{init-declarator-list}\texttt{?} \texttt{;}
\end{center}

The specifiers include storage class (\texttt{typedef}, \texttt{static},
\texttt{extern}, etc.), type specifiers (\texttt{int}, \texttt{char},
struct/union/enum, typedef names), and qualifiers (\texttt{const},
\texttt{volatile}, \texttt{restrict}, \texttt{\_Atomic}).

@d Decl: parse declaration @{
// -- kcc_parse_decl ----------------------------------------------------
// node *kcc_parse_decl(void)
// Parses a declaration or function definition.
// Returns AST node (VarDecl, FuncDecl, TypedefDecl, StructDecl, etc.)
.text
.globl _kcc_parse_decl
.p2align 2
_kcc_parse_decl:
    stp x29, x30, [sp, #-80]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    str x25, [sp, #64]

    // Check for _Static_assert
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK__STATIC_ASSERT
    b.eq .Ldecl_static_assert

    // Parse declaration specifiers
    // Returns: x0 = type node, x1 = storage class flags
    bl _kcc_parse_decl_specs
    mov x19, x0                  // x19 = type node
    mov x20, x1                  // x20 = storage class (0=none,1=typedef,2=extern,3=static,4=auto,5=register)

    // Check for bare ';' (struct/union/enum declaration without declarator)
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_SEMI
    b.eq .Ldecl_bare_type

    // Parse declarator
    mov x0, x19                  // base type
    bl _kcc_parse_declarator
    // Returns: x0 = decl node (partially filled)
    mov x21, x0                  // x21 = declarator result node
    cbz x21, .Ldecl_error_recovery

    // Check what kind of declaration this is
    ldr x22, [x21, #AST_TAG]    // x22 = node tag

    // If it's a function declarator and next token is '{', it's a definition
    cmp x22, #AST_FUNC_DECL
    b.ne .Ldecl_not_func

    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_LBRACE
    b.ne .Ldecl_func_proto

    // Function definition: parse body
    bl _kcc_parse_compound
    str x0, [x21, #AST_F3]      // body
    // Record internal linkage.  A FuncDecl packs its params pointer in F2 with
    // the variadic flag in bit 0; we reuse the next free low bit (bit 1) for the
    // `static` storage class so the emitter can give the symbol local linkage.
    cmp x20, #3                  // storage class 3 = static
    b.ne .Ldecl_func_def_done
    ldr x0, [x21, #AST_F2]
    orr x0, x0, #2               // set bit 1 = static
    str x0, [x21, #AST_F2]
.Ldecl_func_def_done:
    mov x0, x21
    b .Ldecl_done

.Ldecl_func_proto:
    // Function prototype (declaration without body).  A prototype may head a
    // comma-separated declarator list that shares the base type, as in
    // \texttt{int f(int), g(int), a;} --- a following ',' therefore continues
    // into the same multi-declarator loop the variable path uses, with the
    // prototype node as the first link of the chain.
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_COMMA
    b.eq .Ldecl_more_vars
    mov x0, #TOK_SEMI
    bl _kcc_parse_expect
    mov x0, x21
    b .Ldecl_done
@| _kcc_parse_decl
@}

\paragraph{Variable and typedef declarations.}
When the declarator is not a function (or is a function prototype without a
body), the parser falls through to variable and typedef handling.  A regular
variable declaration stores its storage class in \texttt{AST\_F3} and
optionally parses an initializer after \texttt{=}.  Multiple declarators
sharing the same specifiers are supported via comma-separated lists, where
each subsequent declarator is parsed against the original base type in
\texttt{x19} and linked through \texttt{AST\_F4} into a chain rooted at the
first declaration node.  The first declarator in such a list may itself be a
function prototype (\texttt{int f(int), g(int), a;}): the prototype path joins
the very same loop when it sees a comma, so a mixture of prototypes and
objects under one set of specifiers parses into one chain.

@d Decl: parse declaration @{
.Ldecl_not_func:
    // Variable or typedef declaration
    // Check for typedef
    cmp x20, #1
    b.eq .Ldecl_typedef

    // Regular variable declaration
    // Store storage class
    str x20, [x21, #AST_F3]     // storage_class

    // Check for initializer
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_ASSIGN
    b.ne .Ldecl_var_no_init

    // Consume '='
    bl _kcc_pp_next

    // Parse initializer
    bl _kcc_parse_initializer
    str x0, [x21, #AST_F2]      // init

.Ldecl_var_no_init:
    // Check for more declarators (comma-separated)
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_COMMA
    b.eq .Ldecl_more_vars

    mov x0, #TOK_SEMI
    bl _kcc_parse_expect
    mov x0, x21
    b .Ldecl_done

.Ldecl_more_vars:
    // Multiple declarators: link via F4
    mov x23, x21                 // x23 = first decl
    mov x24, x21                 // x24 = last decl

.Ldecl_var_loop:
    bl _kcc_pp_next               // consume ','

    // Parse next declarator with same base type
    mov x0, x19
    bl _kcc_parse_declarator
    mov x25, x0                  // x25 = new decl
    cbz x25, .Ldecl_var_loop_end

    str x20, [x25, #AST_F3]     // storage_class

    // Check for initializer
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_ASSIGN
    b.ne .Ldecl_var_no_init2

    bl _kcc_pp_next               // consume '='
    bl _kcc_parse_initializer
    str x0, [x25, #AST_F2]      // init

.Ldecl_var_no_init2:
    // Link
    str x25, [x24, #AST_F4]
    mov x24, x25

    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_COMMA
    b.eq .Ldecl_var_loop

.Ldecl_var_loop_end:
    mov x0, #TOK_SEMI
    bl _kcc_parse_expect
    mov x0, x23                  // return first decl
    b .Ldecl_done
@}

\paragraph{Typedef registration and special forms.}
A typedef declaration (\texttt{storage\_class == 1}) registers the declared
name in the typedef table so the lexer can disambiguate identifiers from type
names in subsequent parsing.  The node tag is rewritten to
\texttt{AST\_TYPEDEF\_DECL}.  This block also handles bare type declarations
such as \texttt{struct S \{~\ldots~\};} where no declarator follows the
specifiers, as well as \texttt{\_Static\_assert} forwarding and error
recovery with synchronisation to the next semicolon.

@d Decl: parse declaration @{
.Ldecl_typedef:
    // Typedef declaration: register the name
    ldr x0, [x21, #AST_F1]      // name_ptr
    cbz x0, .Ldecl_typedef_done
    // Get name length via strlen
    mov x23, x0                  // save name
    bl _kcc_strlen
    mov x1, x0                   // len
    mov x0, x23                  // name
    bl _kcc_typedef_add

.Ldecl_typedef_done:
    // Change tag to TYPEDEF_DECL
    mov x0, #AST_TYPEDEF_DECL
    str x0, [x21, #AST_TAG]
    mov x0, #TOK_SEMI
    bl _kcc_parse_expect
    mov x0, x21
    b .Ldecl_done

.Ldecl_bare_type:
    // Just a type followed by ';' (e.g., "struct S { ... };")
    bl _kcc_pp_next               // consume ';'
    // Return the type node itself (struct/union/enum decl)
    mov x0, x19
    b .Ldecl_done

.Ldecl_static_assert:
    bl _kcc_parse_static_assert
    b .Ldecl_done

.Ldecl_error_recovery:
    bl _kcc_parse_sync
    mov x0, #0

.Ldecl_done:
    ldr x25, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #80
    ret
@}

\section{Declaration Specifiers}

\texttt{kcc\_parse\_decl\_specs} parses the type specifiers, qualifiers,
and storage class keywords that precede a declarator.  It accumulates
type information and returns both the type node and the storage class.

The alignment specifier \verb|_Alignas| (\stdref{6.7.5}) may also appear
here.  It takes a parenthesised argument---either a constant expression or a
type name---so, unlike the bare function specifiers, the loop cannot simply
consume a single token.  \texttt{.Ldecl\_alignas} accepts the keyword, then
skips its argument by counting parentheses (\texttt{x24}, a callee-saved
register the loop leaves free, holds the nesting depth across the intervening
calls) until the matching close paren.  The requested alignment is thus
accepted syntactically---which is what makes \verb|<stdalign.h>|'s
\verb|alignas| usable---but honouring an over-alignment beyond the frame's
natural guarantee would require aligning the affected stack slot and, for
alignments past sixteen, dynamically realigning the stack pointer; that
refinement is deferred.

@d Decl: parse specifiers @{
// -- kcc_parse_decl_specs ----------------------------------------------
// (node*, uint64_t) kcc_parse_decl_specs(void)
// Parses declaration specifiers.
// Returns: x0 = type node, x1 = storage class
//   storage class: 0=none, 1=typedef, 2=extern, 3=static, 4=auto, 5=register
.globl _kcc_parse_decl_specs
.p2align 2
_kcc_parse_decl_specs:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]

    mov x19, #0                  // x19 = storage class (0=none)
    mov x20, #0                  // x20 = type node (built incrementally)
    mov x21, #0                  // x21 = qualifier flags
    mov x22, #0                  // x22 = count of type specifiers seen
    mov x23, #0                  // x23 = base type token (for builtins)

.Ldecl_specs_loop:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]

    // Storage class specifiers
    cmp x0, #TOK_TYPEDEF
    b.eq .Ldecl_sc_typedef
    cmp x0, #TOK_EXTERN
    b.eq .Ldecl_sc_extern
    cmp x0, #TOK_STATIC
    b.eq .Ldecl_sc_static
    cmp x0, #TOK_AUTO
    b.eq .Ldecl_sc_auto
    cmp x0, #TOK_REGISTER
    b.eq .Ldecl_sc_register

    // Type qualifiers
    cmp x0, #TOK_CONST
    b.eq .Ldecl_qual_const
    cmp x0, #TOK_VOLATILE
    b.eq .Ldecl_qual_volatile
    cmp x0, #TOK_RESTRICT
    b.eq .Ldecl_qual_restrict
    cmp x0, #TOK__ATOMIC
    b.eq .Ldecl_qual_atomic

    // Function specifier
    cmp x0, #TOK_INLINE
    b.eq .Ldecl_skip_spec
    cmp x0, #TOK__NORETURN
    b.eq .Ldecl_skip_spec

    // Alignment specifier: _Alignas ( constant-expr | type-name )
    cmp x0, #TOK__ALIGNAS
    b.eq .Ldecl_alignas

    // Type specifiers
    cmp x0, #TOK_VOID
    b.eq .Ldecl_type_builtin
    cmp x0, #TOK_CHAR
    b.eq .Ldecl_type_builtin
    cmp x0, #TOK_SHORT
    b.eq .Ldecl_type_builtin
    cmp x0, #TOK_INT
    b.eq .Ldecl_type_builtin
    cmp x0, #TOK_LONG
    b.eq .Ldecl_type_builtin
    cmp x0, #TOK_FLOAT
    b.eq .Ldecl_type_builtin
    cmp x0, #TOK_DOUBLE
    b.eq .Ldecl_type_builtin
    cmp x0, #TOK_SIGNED
    b.eq .Ldecl_type_builtin
    cmp x0, #TOK_UNSIGNED
    b.eq .Ldecl_type_builtin
    cmp x0, #TOK__BOOL
    b.eq .Ldecl_type_builtin
    cmp x0, #TOK__COMPLEX
    b.eq .Ldecl_type_builtin

    // struct/union/enum
    cmp x0, #TOK_STRUCT
    b.eq .Ldecl_type_struct
    cmp x0, #TOK_UNION
    b.eq .Ldecl_type_union
    cmp x0, #TOK_ENUM
    b.eq .Ldecl_type_enum

    // Typedef name (identifier that is a typedef)
    cmp x0, #TOK_IDENT
    b.eq .Ldecl_check_typedef_name

    // _Thread_local (storage class like)
    cmp x0, #TOK__THREAD_LOCAL
    b.eq .Ldecl_skip_spec

    // Not a specifier, done
    b .Ldecl_specs_done

.Ldecl_sc_typedef:
    mov x19, #1
    bl _kcc_pp_next
    b .Ldecl_specs_loop

.Ldecl_sc_extern:
    mov x19, #2
    bl _kcc_pp_next
    b .Ldecl_specs_loop

.Ldecl_sc_static:
    mov x19, #3
    bl _kcc_pp_next
    b .Ldecl_specs_loop

.Ldecl_sc_auto:
    mov x19, #4
    bl _kcc_pp_next
    b .Ldecl_specs_loop

.Ldecl_sc_register:
    mov x19, #5
    bl _kcc_pp_next
    b .Ldecl_specs_loop

.Ldecl_qual_const:
    orr x21, x21, #1
    bl _kcc_pp_next
    b .Ldecl_specs_loop

.Ldecl_qual_volatile:
    orr x21, x21, #2
    bl _kcc_pp_next
    b .Ldecl_specs_loop

.Ldecl_qual_restrict:
    orr x21, x21, #4
    bl _kcc_pp_next
    b .Ldecl_specs_loop

.Ldecl_qual_atomic:
    orr x21, x21, #8
    bl _kcc_pp_next
    b .Ldecl_specs_loop

.Ldecl_skip_spec:
    // Consume and ignore (inline, _Noreturn, _Thread_local)
    bl _kcc_pp_next
    b .Ldecl_specs_loop

.Ldecl_alignas:
    // _Alignas ( constant-expr | type-name ): accept the specifier and consume
    // its parenthesised argument by skipping balanced tokens (x24 = paren
    // depth; x24 is unused by the loop and preserved across the calls below).
    // The requested alignment is accepted syntactically; enforcing over-aligned
    // storage beyond the frame's natural guarantee is a separate refinement.
    bl _kcc_pp_next               // consume '_Alignas'
    mov x0, #TOK_LPAREN
    bl _kcc_parse_expect          // consume '('
    mov x24, #1                   // paren depth
.Ldecl_alignas_skip:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Ldecl_specs_loop    // TOK_EOF (0): malformed → bail to the loop
    cmp  x0, #TOK_LPAREN
    b.ne .Ldecl_alignas_notlp
    add  x24, x24, #1
    b    .Ldecl_alignas_adv
.Ldecl_alignas_notlp:
    cmp  x0, #TOK_RPAREN
    b.ne .Ldecl_alignas_adv
    subs x24, x24, #1
    b.eq .Ldecl_alignas_close
.Ldecl_alignas_adv:
    bl _kcc_pp_next
    b .Ldecl_alignas_skip
.Ldecl_alignas_close:
    bl _kcc_pp_next               // consume the matching ')'
    b .Ldecl_specs_loop
@| _kcc_parse_decl_specs
@}

\paragraph{Type specifier bitmask accumulation.}
When the main loop dispatches to a builtin type keyword such as \texttt{int},
\texttt{char}, or \texttt{long}, the parser does not build a type node
immediately.  Instead, each keyword sets a corresponding bit in the
accumulator register~\texttt{x23}.  This approach handles multi-keyword types
like \texttt{unsigned long long int} correctly: once all specifiers have been
consumed, the final bitmask encodes the full type.  The special case of two
successive \texttt{long} keywords is detected by checking whether bit~4 is
already set before promoting to bit~5 (\texttt{long long}).  Struct, union,
and enum specifiers build their own type nodes via dedicated sub-parsers,
while typedef names are looked up in the typedef table and interned.

@d Decl: parse specifiers @{
.Ldecl_type_builtin:
    // Accumulate specifier bitmask in x23
    // Each type keyword ORs its bit into x23
    cmp x0, #TOK_VOID
    b.eq .Ldecl_bit_void
    cmp x0, #TOK_CHAR
    b.eq .Ldecl_bit_char
    cmp x0, #TOK_SHORT
    b.eq .Ldecl_bit_short
    cmp x0, #TOK_INT
    b.eq .Ldecl_bit_int
    cmp x0, #TOK_LONG
    b.eq .Ldecl_bit_long
    cmp x0, #TOK_FLOAT
    b.eq .Ldecl_bit_float
    cmp x0, #TOK_DOUBLE
    b.eq .Ldecl_bit_double
    cmp x0, #TOK_SIGNED
    b.eq .Ldecl_bit_signed
    cmp x0, #TOK_UNSIGNED
    b.eq .Ldecl_bit_unsigned
    cmp x0, #TOK__BOOL
    b.eq .Ldecl_bit_bool
    cmp x0, #TOK__COMPLEX
    b.eq .Ldecl_bit_complex
    b .Ldecl_bit_done

.Ldecl_bit_void:
    orr x23, x23, #(1 << 0)
    b .Ldecl_bit_done
.Ldecl_bit_char:
    orr x23, x23, #(1 << 1)
    b .Ldecl_bit_done
.Ldecl_bit_short:
    orr x23, x23, #(1 << 2)
    b .Ldecl_bit_done
.Ldecl_bit_int:
    orr x23, x23, #(1 << 3)
    b .Ldecl_bit_done
.Ldecl_bit_long:
    // Check if long already set (bit 4) -> set long long (bit 5)
    tst x23, #(1 << 4)
    b.ne .Ldecl_bit_llong
    orr x23, x23, #(1 << 4)
    b .Ldecl_bit_done
.Ldecl_bit_llong:
    orr x23, x23, #(1 << 5)
    b .Ldecl_bit_done
.Ldecl_bit_float:
    orr x23, x23, #(1 << 6)
    b .Ldecl_bit_done
.Ldecl_bit_double:
    orr x23, x23, #(1 << 7)
    b .Ldecl_bit_done
.Ldecl_bit_signed:
    orr x23, x23, #(1 << 8)
    b .Ldecl_bit_done
.Ldecl_bit_unsigned:
    orr x23, x23, #(1 << 9)
    b .Ldecl_bit_done
.Ldecl_bit_bool:
    orr x23, x23, #(1 << 10)
    b .Ldecl_bit_done
.Ldecl_bit_complex:
    orr x23, x23, #(1 << 11)

.Ldecl_bit_done:
    add x22, x22, #1            // count++
    bl _kcc_pp_next
    b .Ldecl_specs_loop

.Ldecl_type_struct:
    bl _kcc_parse_struct_or_union
    mov x20, x0
    add x22, x22, #1
    b .Ldecl_specs_loop

.Ldecl_type_union:
    bl _kcc_parse_struct_or_union
    mov x20, x0
    add x22, x22, #1
    b .Ldecl_specs_loop

.Ldecl_type_enum:
    bl _kcc_parse_enum
    mov x20, x0
    add x22, x22, #1
    b .Ldecl_specs_loop

.Ldecl_check_typedef_name:
    // Only treat as typedef name if no type specifier seen yet
    cbnz x22, .Ldecl_specs_done

    // Check if this identifier is a typedef name
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_tok_len@@PAGE
    add  x1, x1, _kcc_tok_len@@PAGEOFF
    ldr  x1, [x1]
    bl _kcc_typedef_lookup
    cbz x0, .Ldecl_specs_done   // not a typedef name

    // It's a typedef name: intern it and create TYPE_NAME node
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_tok_len@@PAGE
    add  x1, x1, _kcc_tok_len@@PAGEOFF
    ldr  x1, [x1]
    bl _kcc_strtab_intern
    mov x24, x0                  // x24 = interned name

    bl _kcc_pp_next               // consume the typedef name

    mov x0, #AST_TYPE_NAME
    bl _kcc_ast_alloc
    str x24, [x0, #AST_F0]      // name_ptr
    mov x20, x0
    add x22, x22, #1

    b .Ldecl_specs_loop
@}

\paragraph{Assembling the final type.}
After the specifier loop terminates --- because the current token no longer
matches any specifier --- the accumulated state is resolved into a type node.
If the loop consumed a struct, union, enum, or typedef name, the type is
already stored in~\texttt{x20}.  Otherwise a \texttt{TYPE\_BUILTIN} node is
allocated whose \texttt{AST\_F0} field holds the bitmask from~\texttt{x23}.
When no specifiers appeared at all, the default type is \texttt{int} (the
implicit-int rule).  Finally, if any qualifiers were collected in~\texttt{x21},
the type is wrapped in a \texttt{TYPE\_QUALS} node before returning.

@d Decl: parse specifiers @{
.Ldecl_specs_done:
    // Build the final type node
    // If we have a builtin type and no struct/union/enum type already
    cbz x20, .Ldecl_build_builtin
    b .Ldecl_apply_quals

.Ldecl_build_builtin:
    // Create builtin type node from accumulated specifier bitmask
    // If no type specifiers at all, default to int (bit 3)
    cbz x22, .Ldecl_default_int
    mov x0, #AST_TYPE_BUILTIN
    bl _kcc_ast_alloc
    str x23, [x0, #AST_F0]      // specifier bitmask
    mov x20, x0
    b .Ldecl_apply_quals

.Ldecl_default_int:
    mov x0, #AST_TYPE_BUILTIN
    bl _kcc_ast_alloc
    mov x1, #(1 << 3)           // SPEC_INT bitmask
    str x1, [x0, #AST_F0]
    mov x20, x0

.Ldecl_apply_quals:
    // If qualifiers present, wrap in TYPE_QUALS
    cbz x21, .Ldecl_specs_return

    mov x24, x20                 // save base type
    mov x0, #AST_TYPE_QUALS
    bl _kcc_ast_alloc
    str x24, [x0, #AST_F0]      // base_type
    str x21, [x0, #AST_F1]      // qualifiers
    mov x20, x0

.Ldecl_specs_return:
    mov x0, x20                  // type node
    mov x1, x19                  // storage class

    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@}

\section{Declarator}

The declarator (\stdref{6.7.6}) introduces a name and modifies the
base type with pointer, array, and function type constructors.  The
syntax is:
\begin{center}
\textit{pointer}\texttt{?} \textit{direct-declarator}
\end{center}
where a pointer is one or more \texttt{*} optionally followed by
type qualifiers.

@d Decl: parse declarator @{
// -- kcc_parse_declarator ----------------------------------------------
// node *kcc_parse_declarator(node *base_type)
//   x0 = base type node
// Parses a declarator and returns a declaration node
// (VAR_DECL or FUNC_DECL) with the type and name filled in.
.globl _kcc_parse_declarator
.p2align 2
_kcc_parse_declarator:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    mov x19, x0                  // x19 = current type

    // Parse pointer(s)
.Ldeclr_ptr_loop:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_STAR
    b.ne .Ldeclr_direct

    // Consume '*'
    bl _kcc_pp_next

    // Parse optional qualifiers after *
    mov x20, #0                  // qualifier flags
.Ldeclr_ptr_quals:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp x0, #TOK_CONST
    b.eq .Ldeclr_pq_const
    cmp x0, #TOK_VOLATILE
    b.eq .Ldeclr_pq_volatile
    cmp x0, #TOK_RESTRICT
    b.eq .Ldeclr_pq_restrict
    cmp x0, #TOK__ATOMIC
    b.eq .Ldeclr_pq_atomic
    b .Ldeclr_ptr_build

.Ldeclr_pq_const:
    orr x20, x20, #1
    bl _kcc_pp_next
    b .Ldeclr_ptr_quals
.Ldeclr_pq_volatile:
    orr x20, x20, #2
    bl _kcc_pp_next
    b .Ldeclr_ptr_quals
.Ldeclr_pq_restrict:
    orr x20, x20, #4
    bl _kcc_pp_next
    b .Ldeclr_ptr_quals
.Ldeclr_pq_atomic:
    orr x20, x20, #8
    bl _kcc_pp_next
    b .Ldeclr_ptr_quals

.Ldeclr_ptr_build:
    // Build pointer type node
    mov x0, #AST_TYPE_PTR
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]      // pointee type
    str x20, [x0, #AST_F1]      // qualifiers
    mov x19, x0                  // new current type
    b .Ldeclr_ptr_loop

.Ldeclr_direct:
    // Parse direct declarator
    mov x0, x19
    bl _kcc_parse_direct_declarator

    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_parse_declarator
@}

\section{Direct Declarator}

The direct declarator is where the name lives, along with array
dimensions and function parameter lists.  Inside a bracketed array
dimension the parser also tolerates the parameter-only ornaments of
\stdref{6.7.6.3} --- a leading type-qualifier list, a \texttt{static}
keyword, and a \texttt{*} standing for an unspecified variable-length
bound.  Because kcc decays an array parameter to a pointer regardless,
these are parsed and discarded rather than modelled, so declarations like
\texttt{int x[static 5]} or \texttt{int x[const *]} are accepted.

@d Decl: parse direct declarator @{
// -- kcc_parse_direct_declarator ---------------------------------------
// node *kcc_parse_direct_declarator(node *type)
//   x0 = type built so far
// Returns a VarDecl or FuncDecl node.
.globl _kcc_parse_direct_declarator
.p2align 2
_kcc_parse_direct_declarator:
    stp x29, x30, [sp, #-80]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]

    mov x19, x0                  // x19 = type
    mov x20, #0                  // x20 = name_ptr

    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]

    // Check for '(' — grouped declarator like (*fp)
    cmp x0, #TOK_LPAREN
    b.eq .Lddecl_grouped

    // Must be an identifier
    cmp x0, #TOK_IDENT
    b.ne .Lddecl_no_name

    // Intern the name
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_tok_len@@PAGE
    add  x1, x1, _kcc_tok_len@@PAGEOFF
    ldr  x1, [x1]
    bl _kcc_strtab_intern
    mov x20, x0                  // x20 = interned name

    // Consume identifier
    bl _kcc_pp_next

.Lddecl_no_name:
    // Check for array/function suffixes
    mov x24, #0                  // innermost array node so far (multi-dim chain)
.Lddecl_suffix_loop:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]

    cmp x0, #TOK_LBRACKET
    b.eq .Lddecl_array

    cmp x0, #TOK_LPAREN
    b.eq .Lddecl_function

    // No more suffixes — build the declaration node
    b .Lddecl_build_var

.Lddecl_array:
    // Array: [ qualifiers? static? size? ]
    bl _kcc_pp_next               // consume '['

    // A parameter's outermost array may carry type-qualifiers, a `static`
    // keyword, or a `*` for an unspecified VLA bound (\stdref{6.7.6.3}).  These
    // affect only the parameter-as-pointer, which kcc already decays, so we
    // parse and discard them here rather than modelling them.
.Lddecl_array_quals:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_CONST
    b.eq .Lddecl_array_skip_qual
    cmp  x0, #TOK_VOLATILE
    b.eq .Lddecl_array_skip_qual
    cmp  x0, #TOK_RESTRICT
    b.eq .Lddecl_array_skip_qual
    cmp  x0, #TOK_STATIC
    b.eq .Lddecl_array_skip_qual
    b .Lddecl_array_after_quals
.Lddecl_array_skip_qual:
    bl _kcc_pp_next               // consume qualifier / static
    b .Lddecl_array_quals

.Lddecl_array_after_quals:
    mov x21, #0                  // size expr (default null)
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_RBRACKET
    b.eq .Lddecl_array_close
    // `[*]`: unspecified VLA size in a prototype behaves as an empty bound.
    cmp  x0, #TOK_STAR
    b.ne .Lddecl_array_size
    bl _kcc_pp_next               // consume '*'
    b .Lddecl_array_close

.Lddecl_array_size:
    // Parse size expression
    bl _kcc_parse_assign_expr
    mov x21, x0

.Lddecl_array_close:
    mov x0, #TOK_RBRACKET
    bl _kcc_parse_expect

    // Build array type.  For `a[N][M]` the FIRST bracket is the outermost
    // array (\stdref{6.7.6.2}: array N of array M of T).  Reading brackets
    // left-to-right, each later dimension must nest \emph{inside} the current
    // innermost array (as its element), not wrap the whole type---otherwise the
    // dimensions reverse and \texttt{a[i][j]} strides by the wrong extent.
    mov x0, #AST_TYPE_ARRAY
    bl _kcc_ast_alloc
    str x21, [x0, #AST_F1]      // size expr
    cbz x24, .Lddecl_array_first
    // Later dimension: element = the base element (held in the innermost's F0),
    // then splice this array in as that innermost array's element.
    ldr x1, [x24, #AST_F0]      // base element type
    str x1, [x0, #AST_F0]
    str x0, [x24, #AST_F0]      // innermost.element = new inner array
    mov x24, x0                  // new innermost
    b .Lddecl_suffix_loop
.Lddecl_array_first:
    str x19, [x0, #AST_F0]      // first bracket: element = the declared type
    mov x19, x0                  // top-level type = this array
    mov x24, x0                  // innermost = this array
    b .Lddecl_suffix_loop
@| _kcc_parse_direct_declarator
@}

\paragraph{Function parameter lists and grouped declarators.}
When the suffix loop encounters an opening parenthesis, the parser must
distinguish between a function parameter list and a grouped (parenthesised)
declarator such as \texttt{int (*fp)(int)}.  Grouped declarators are detected
at the start of direct-declarator parsing; by the time the suffix loop runs,
any remaining parenthesis introduces a parameter list.  The parser builds a
\texttt{TYPE\_FUNC} node, iterates over comma-separated parameter declarations,
and handles the variadic \texttt{...} marker.  A \texttt{FUNC\_DECL} or
\texttt{VAR\_DECL} node is then constructed to carry the name and type.
The variadic flag rides in \emph{bit~0} of the \texttt{FUNC\_DECL}'s params
pointer: parameter nodes are eight-byte aligned, so the low bit is free, and
tagging it there avoids growing the node.  Every consumer that walks the
parameter list---sema and the IR builder---masks the bit off first; sema
also reads it to record the fixed-parameter count that the variadic calling
convention needs (\S\ref{sec:variadic-defs}).

The grouped declarator handler at \texttt{.Lddecl\_grouped} first parses
the inner declarator (e.g.\ \texttt{*fp}), then checks whether a
parenthesised parameter list follows the closing~\texttt{)}.  When one is
present, the handler parses it into a \texttt{TYPE\_FUNC} node and walks
the inner declarator's type chain to replace the base type with the function
type---implementing C's inside-out declarator semantics.  For instance,
\texttt{int (*fp)(int, int)} produces a \texttt{VAR\_DECL} whose type is
\texttt{ptr(func(int,int)->int)}.  An array suffix \texttt{[N]} after the
group is handled the same way: the brackets build an array chain whose
element is the base type, which is then spliced in place of the base, so
\texttt{char (*p)[4]} becomes \texttt{ptr(array 4 of char)} --- a pointer to
an array rather than an array of pointers.

@d Decl: parse direct declarator @{
.Lddecl_function:
    // Function: ( param-list ).  A function suffix ends any array chain, so a
    // subsequent bracket begins a fresh outermost array.
    mov x24, #0
    bl _kcc_pp_next               // consume '('

    // Build function type
    mov x0, #AST_TYPE_FUNC
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]      // return type
    mov x21, x0                  // x21 = func type node

    // Check for empty params or 'void'
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_RPAREN
    b.eq .Lddecl_func_close

    // Check for 'void)'
    cmp  x0, #TOK_VOID
    b.ne .Lddecl_parse_params

    // Could be 'void)' or 'void *name'
    // For now, if void followed by ')', treat as no params
    // This is a simplification; full C17 requires lookahead
    // We'll handle it by checking: if void and next is ')', consume both
    // Otherwise fall through to param parsing

    // Peek: we can't easily look ahead, so just try parsing params
    b .Lddecl_parse_params

.Lddecl_parse_params:
    // Parse parameter list
    mov x22, #0                  // x22 = first param
    mov x23, #0                  // x23 = last param

.Lddecl_param_loop:
    // Check for '...'
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_ELLIPSIS
    b.eq .Lddecl_variadic

    // Parse parameter declaration
    bl _kcc_parse_param_decl
    mov x0, x0                   // param node

    cbz x22, .Lddecl_param_first
    str x0, [x23, #AST_F4]      // last->next = new
    mov x23, x0
    b .Lddecl_param_comma

.Lddecl_param_first:
    mov x22, x0
    mov x23, x0

.Lddecl_param_comma:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_COMMA
    b.ne .Lddecl_func_store_params

    bl _kcc_pp_next               // consume ','

    // Check for '...' after comma
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_ELLIPSIS
    b.eq .Lddecl_variadic

    b .Lddecl_param_loop

.Lddecl_variadic:
    bl _kcc_pp_next               // consume '...'
    mov x0, #1
    str x0, [x21, #AST_F2]      // variadic = 1

.Lddecl_func_store_params:
    str x22, [x21, #AST_F1]     // params

.Lddecl_func_close:
    mov x0, #TOK_RPAREN
    bl _kcc_parse_expect

    // Build FuncDecl node
    mov x0, #AST_FUNC_DECL
    bl _kcc_ast_alloc
    ldr x1, [x21, #AST_F0]      // return type from func type
    str x1, [x0, #AST_F0]       // type (return type)
    str x20, [x0, #AST_F1]      // name
    ldr x1, [x21, #AST_F1]      // params
    ldr x2, [x21, #AST_F2]      // variadic (0/1)
    orr x1, x1, x2              // tag bit 0 (see prose)
    str x1, [x0, #AST_F2]       // params | variadic

    b .Lddecl_done

.Lddecl_grouped:
    // Grouped declarator: ( declarator )
    // Handles function pointers like: int (*fp)(int, int)
    bl _kcc_pp_next               // consume '('
    mov x0, x19
    bl _kcc_parse_declarator
    mov x21, x0                  // x21 = inner result (VAR_DECL)
    mov x0, #TOK_RPAREN
    bl _kcc_parse_expect

    // A grouped declarator may be followed by a function suffix (params)
    // making it a function pointer, or by an array suffix [N] making it a
    // pointer to (or array of) array --- e.g. char (*p)[4].
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_LBRACKET
    b.eq .Lddecl_grouped_array
    cmp  x0, #TOK_LPAREN
    b.ne .Lddecl_grouped_done

    // Function pointer: parse parameter list
    bl _kcc_pp_next               // consume '('

    // Build TYPE_FUNC node
    mov x0, #AST_TYPE_FUNC
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]      // return type = base type
    mov x24, x0                  // x24 = func type node

    // Check for empty params ')' or void
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_RPAREN
    b.eq .Lddecl_gfunc_close

    // Parse parameters
    mov x22, #0                  // first param
    mov x23, #0                  // last param
.Lddecl_gfunc_param_loop:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_ELLIPSIS
    b.eq .Lddecl_gfunc_variadic

    bl _kcc_parse_param_decl
    cbz x22, .Lddecl_gfunc_first
    str x0, [x23, #AST_F4]
    mov x23, x0
    b .Lddecl_gfunc_comma

.Lddecl_gfunc_first:
    mov x22, x0
    mov x23, x0

.Lddecl_gfunc_comma:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_COMMA
    b.ne .Lddecl_gfunc_store_params
    bl _kcc_pp_next
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_ELLIPSIS
    b.eq .Lddecl_gfunc_variadic
    b .Lddecl_gfunc_param_loop

.Lddecl_gfunc_variadic:
    bl _kcc_pp_next               // consume '...'
    mov x0, #1
    str x0, [x24, #AST_F2]      // variadic = 1

.Lddecl_gfunc_store_params:
    str x22, [x24, #AST_F1]     // store params in func type

.Lddecl_gfunc_close:
    mov x0, #TOK_RPAREN
    bl _kcc_parse_expect

    // Patch inner declarator's type chain:
    // Walk from x21.F0 to find where base_type (x19) is stored,
    // replace it with the func type (x24).
    ldr x0, [x21, #AST_F0]      // type chain root
    cmp x0, x19                  // directly the base type?
    b.ne .Lddecl_gfunc_walk
    // No pointer: store func type directly
    str x24, [x21, #AST_F0]
    b .Lddecl_grouped_done

.Lddecl_gfunc_walk:
    // Walk type chain: each pointer's F0 → pointee
    mov x1, x0
.Lddecl_gfunc_walk_loop:
    ldr x0, [x1, #AST_F0]
    cmp x0, x19
    b.ne .Lddecl_gfunc_walk_next
    // Found: replace this node's F0 with func type
    str x24, [x1, #AST_F0]
    b .Lddecl_grouped_done
.Lddecl_gfunc_walk_next:
    mov x1, x0
    b .Lddecl_gfunc_walk_loop

.Lddecl_grouped_array:
    // Parse one or more [N] suffixes into an array chain whose element is the
    // base type, then splice that chain into the inner declarator's type in
    // place of the base --- inside-out declarator semantics (\stdref{6.7.6}).
    // For char (*p)[4] the inner declarator is ptr→char; splicing array[4] for
    // the char yields ptr→array[4]→char, i.e. p is a pointer to an array of 4.
    mov x24, #0                  // innermost array so far
    mov x22, #0                  // outermost array (the splice target)
.Lddecl_ga_loop:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_LBRACKET
    b.ne .Lddecl_ga_splice
    bl _kcc_pp_next               // consume '['
    mov x23, #0                  // size expr (default null)
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_RBRACKET
    b.eq .Lddecl_ga_rb
    bl _kcc_parse_assign_expr
    mov x23, x0
.Lddecl_ga_rb:
    mov x0, #TOK_RBRACKET
    bl _kcc_parse_expect
    mov x0, #AST_TYPE_ARRAY
    bl _kcc_ast_alloc
    str x23, [x0, #AST_F1]        // size
    cbz x24, .Lddecl_ga_first
    // Nest as the current innermost array's element (later dimension).
    ldr x1, [x24, #AST_F0]        // base element
    str x1, [x0, #AST_F0]
    str x0, [x24, #AST_F0]
    mov x24, x0
    b .Lddecl_ga_loop
.Lddecl_ga_first:
    str x19, [x0, #AST_F0]        // first dimension: element = base type
    mov x24, x0                   // innermost
    mov x22, x0                   // outermost
    b .Lddecl_ga_loop
.Lddecl_ga_splice:
    cbz x22, .Lddecl_grouped_done
    ldr x0, [x21, #AST_F0]        // inner declarator's type chain root
    cmp x0, x19
    b.ne .Lddecl_ga_walk
    str x22, [x21, #AST_F0]       // base was the root: replace directly
    b .Lddecl_grouped_done
.Lddecl_ga_walk:
    mov x1, x0
.Lddecl_ga_walk_loop:
    ldr x0, [x1, #AST_F0]
    cmp x0, x19
    b.ne .Lddecl_ga_walk_next
    str x22, [x1, #AST_F0]        // replace base within the chain
    b .Lddecl_grouped_done
.Lddecl_ga_walk_next:
    mov x1, x0
    b .Lddecl_ga_walk_loop

.Lddecl_grouped_done:
    mov x0, x21
    b .Lddecl_done

.Lddecl_build_var:
    // Build VarDecl
    mov x0, #AST_VAR_DECL
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]      // type
    str x20, [x0, #AST_F1]      // name_ptr

.Lddecl_done:
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #80
    ret
@}

\paragraph{Parameter declarations.}
Each parameter in a function prototype is parsed as a miniature declaration:
specifiers followed by a declarator.  The storage class returned by
\texttt{kcc\_parse\_decl\_specs} is ignored since storage class specifiers
are not meaningful for parameters.  If the next token after the specifiers
is a closing parenthesis, comma, or ellipsis, the parameter is unnamed ---
an abstract parameter consisting of a type alone.

@d Decl: parse direct declarator @{
// -- kcc_parse_param_decl ----------------------------------------------
// node *kcc_parse_param_decl(void)
// Parses a parameter declaration.
.globl _kcc_parse_param_decl
.p2align 2
_kcc_parse_param_decl:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    // Parse specifiers (ignore storage class for params)
    bl _kcc_parse_decl_specs
    mov x19, x0                  // x19 = type
    // x1 = storage class (ignored)

    // Check if there's a declarator or abstract declarator
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]

    // If ')' or ',' follows, it's an unnamed parameter
    cmp  x0, #TOK_RPAREN
    b.eq .Lparam_unnamed
    cmp  x0, #TOK_COMMA
    b.eq .Lparam_unnamed
    cmp  x0, #TOK_ELLIPSIS
    b.eq .Lparam_unnamed

    // Try to parse a declarator
    mov x0, x19
    bl _kcc_parse_declarator
    mov x20, x0                  // x20 = decl node

    // Convert to PARAM_DECL
    mov x0, #AST_PARAM_DECL
    bl _kcc_ast_alloc
    ldr x1, [x20, #AST_F0]      // type from declarator
    str x1, [x0, #AST_F0]
    ldr x1, [x20, #AST_F1]      // name from declarator
    str x1, [x0, #AST_F1]

    b .Lparam_done

.Lparam_unnamed:
    // Unnamed parameter
    mov x0, #AST_PARAM_DECL
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]      // type
    // F1 (name) stays null

.Lparam_done:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_parse_param_decl
@}

\section{Abstract Declarator}

An abstract declarator is used in casts and \texttt{sizeof(type)}.
It is like a regular declarator but without a name.

@d Decl: parse abstract @{
// -- kcc_parse_abstract_declarator -------------------------------------
// node *kcc_parse_abstract_declarator(node *base_type)
//   x0 = base type
// Returns a type node (possibly wrapped in pointers/arrays).
.globl _kcc_parse_abstract_declarator
.p2align 2
_kcc_parse_abstract_declarator:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    mov x19, x0                  // x19 = type

    // Parse pointer(s)
.Labst_ptr_loop:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_STAR
    b.ne .Labst_done

    bl _kcc_pp_next               // consume '*'

    // Parse qualifiers
    mov x20, #0
.Labst_quals:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp x0, #TOK_CONST
    b.ne .Labst_q2
    orr x20, x20, #1
    bl _kcc_pp_next
    b .Labst_quals
.Labst_q2:
    cmp x0, #TOK_VOLATILE
    b.ne .Labst_q3
    orr x20, x20, #2
    bl _kcc_pp_next
    b .Labst_quals
.Labst_q3:
    cmp x0, #TOK_RESTRICT
    b.ne .Labst_q4
    orr x20, x20, #4
    bl _kcc_pp_next
    b .Labst_quals
.Labst_q4:
    cmp x0, #TOK__ATOMIC
    b.ne .Labst_build_ptr
    orr x20, x20, #8
    bl _kcc_pp_next
    b .Labst_quals

.Labst_build_ptr:
    mov x0, #AST_TYPE_PTR
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]
    str x20, [x0, #AST_F1]
    mov x19, x0
    b .Labst_ptr_loop

.Labst_done:
    // Check for array suffix [N]
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_LBRACKET
    b.ne .Labst_check_func

    bl _kcc_pp_next               // consume '['
    mov x20, #0
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_RBRACKET
    b.eq .Labst_arr_close
    bl _kcc_parse_assign_expr
    mov x20, x0
.Labst_arr_close:
    mov x0, #TOK_RBRACKET
    bl _kcc_parse_expect
    mov x0, #AST_TYPE_ARRAY
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]
    str x20, [x0, #AST_F1]
    mov x19, x0
    b .Labst_done

.Labst_check_func:
    // Check for function suffix (params)
    cmp  x0, #TOK_LPAREN
    b.ne .Labst_return

    // For abstract declarators, '(' could be grouping or function
    // Simple heuristic: if next after '(' is a type token, it's function params
    // Otherwise treat as done (no grouping in abstract declarators for casts)
    mov x0, x19
    b .Labst_return

.Labst_return:
    mov x0, x19

    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_parse_abstract_declarator
@}

\section{Struct and Union}

Struct and union type specifiers (\stdref{6.7.2.1}) share the same parsing
logic since their syntax is identical apart from the leading keyword.  The
parser consumes \texttt{struct} or \texttt{union}, records the appropriate
AST tag, then looks for an optional tag name and an optional brace-enclosed
member list.  Each member is parsed as a declaration specifier followed by a
declarator, with support for bitfield widths via the \texttt{:} syntax and
anonymous struct/union members.  The result is wrapped in a
\texttt{TYPE\_STRUCT} or \texttt{TYPE\_UNION} node that the declaration
specifier loop can accumulate.

@d Decl: parse struct @{
// -- kcc_parse_struct_or_union -----------------------------------------
// node *kcc_parse_struct_or_union(void)
// Parses: struct/union [ident] [{ field-list }]
.globl _kcc_parse_struct_or_union
.p2align 2
_kcc_parse_struct_or_union:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]

    // Determine struct vs union
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_STRUCT
    b.eq .Lstruct_tag
    mov x19, #AST_UNION_DECL
    b .Lstruct_consume
.Lstruct_tag:
    mov x19, #AST_UNION_DECL
    cmp  x0, #TOK_STRUCT
    mov  x19, #AST_STRUCT_DECL

.Lstruct_consume:
    // Check actual token to set correct tag
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_STRUCT
    b.eq .Lstruct_is_struct
    mov  x19, #AST_UNION_DECL
    b .Lstruct_after_tag
.Lstruct_is_struct:
    mov  x19, #AST_STRUCT_DECL

.Lstruct_after_tag:
    bl _kcc_pp_next               // consume 'struct' or 'union'

    // Optional tag name
    mov x20, #0                  // x20 = name_ptr (default null)
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_IDENT
    b.ne .Lstruct_check_brace

    // Intern tag name
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_tok_len@@PAGE
    add  x1, x1, _kcc_tok_len@@PAGEOFF
    ldr  x1, [x1]
    bl _kcc_strtab_intern
    mov x20, x0

    bl _kcc_pp_next               // consume tag name

.Lstruct_check_brace:
    // Check for '{'
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_LBRACE
    b.ne .Lstruct_no_body

    bl _kcc_pp_next               // consume '{'

    // Parse field declarations
    mov x21, #0                  // first field
    mov x22, #0                  // last field
@| _kcc_parse_struct_or_union
@}

\paragraph{Member list parsing.}
With the tag determined and the opening brace consumed, the parser enters
a loop over the struct or union members.  Each member consists of declaration
specifiers followed by a declarator and an optional bitfield width introduced
by a colon.  Rather than re-implement declarator parsing, the member loop
calls the full \texttt{\_kcc\_parse\_declarator} on the base specifiers---the
same routine used for ordinary declarations---so a field may carry any
declarator the language allows: pointers, arrays, and crucially the grouped
\emph{function-pointer} form \texttt{int (*f)(int)}.  The node it returns
already holds the field's full type in \texttt{AST\_F0} and its name in
\texttt{AST\_F1}, so the loop simply retags it as an \texttt{AST\_FIELD\_DECL}
and records the bitfield width, if any, in \texttt{AST\_F2}.  Parsing each
comma-separated declarator against the \emph{original} base type also fixes a
latent bug where \texttt{int *a, b;} wrongly made \texttt{b} a pointer.
Anonymous members (a bare specifier followed immediately by a semicolon) are
still supported, allowing anonymous inner structs and unions as described in
\stdref{6.7.2.1}~p13.  Members are linked through \texttt{AST\_F4} into a
singly-linked list anchored by the first field node.

@d Decl: parse struct @{
.Lstruct_field_loop:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_RBRACE
    b.eq .Lstruct_close
    cbz  x0, .Lstruct_close      // EOF

    // Parse field: specifiers + declarator
    bl _kcc_parse_decl_specs
    mov x23, x0                  // x23 = field type
    // Ignore storage class for fields

    // Check for anonymous struct/union field (no declarator)
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_SEMI
    b.eq .Lstruct_anon_field

    // Parse the full field declarator (pointers, grouped function-pointer
    // declarators, arrays) against the base type, then reuse the returned
    // node as the field by retagging it.
.Lstruct_field_decl:
    mov x0, x23                  // base type specifiers
    bl _kcc_parse_declarator
    mov x24, x0                  // x24 = field node (VAR_DECL / FUNC_DECL shape)
    cbz x24, .Lstruct_field_semi
    mov x0, #AST_FIELD_DECL
    str x0, [x24, #AST_TAG]      // retag as a struct/union field
    str xzr, [x24, #AST_F2]      // bitwidth default 0
    str xzr, [x24, #AST_F4]      // no sibling yet

    // Optional bitfield ': width'
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_COLON
    b.ne .Lstruct_field_append
    bl _kcc_pp_next               // consume ':'
    bl _kcc_parse_cond_expr       // bitwidth expr
    str x0, [x24, #AST_F2]

.Lstruct_field_append:
    cbz x21, .Lstruct_field_first
    str x24, [x22, #AST_F4]
    mov x22, x24
    b .Lstruct_field_more

.Lstruct_field_first:
    mov x21, x24
    mov x22, x24

.Lstruct_field_more:
    // Check for ',' (more declarators with same type)
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_COMMA
    b.ne .Lstruct_field_semi

    bl _kcc_pp_next               // consume ','
    mov x24, #0                  // reset field name
    b .Lstruct_field_decl

.Lstruct_field_semi:
    mov x0, #TOK_SEMI
    bl _kcc_parse_expect
    b .Lstruct_field_loop

.Lstruct_anon_field:
    // Anonymous field (e.g., anonymous struct/union member)
    mov x0, #AST_FIELD_DECL
    bl _kcc_ast_alloc
    str x23, [x0, #AST_F0]      // type
    cbz x21, .Lstruct_anon_first
    str x0, [x22, #AST_F4]
    mov x22, x0
    b .Lstruct_anon_semi
.Lstruct_anon_first:
    mov x21, x0
    mov x22, x0
.Lstruct_anon_semi:
    mov x0, #TOK_SEMI
    bl _kcc_parse_expect
    b .Lstruct_field_loop
@}

\paragraph{Struct/union node construction.}
After the closing brace terminates the member list, the parser allocates the
aggregate declaration node with tag \texttt{AST\_STRUCT\_DECL} or
\texttt{AST\_UNION\_DECL}, storing the tag name in \texttt{AST\_F0} and the
field chain in \texttt{AST\_F1}.  The declaration is then wrapped in a
\texttt{TYPE\_STRUCT} or \texttt{TYPE\_UNION} node so it can be consumed by
the specifier accumulator.  Forward declarations (a tag without a body) follow
the same wrapping logic but produce an empty node with no field list.

@d Decl: parse struct @{
.Lstruct_close:
    mov x0, #TOK_RBRACE
    bl _kcc_parse_expect

    // Build struct/union node
    mov x0, x19                  // tag (AST_STRUCT_DECL or AST_UNION_DECL)
    bl _kcc_ast_alloc
    str x20, [x0, #AST_F0]      // name_ptr
    str x21, [x0, #AST_F1]      // fields

    // Wrap in TYPE_STRUCT or TYPE_UNION
    mov x23, x0                  // save decl node
    cmp x19, #AST_STRUCT_DECL
    b.eq .Lstruct_wrap_struct
    mov x0, #AST_TYPE_UNION
    b .Lstruct_wrap
.Lstruct_wrap_struct:
    mov x0, #AST_TYPE_STRUCT
.Lstruct_wrap:
    bl _kcc_ast_alloc
    str x23, [x0, #AST_F0]      // struct/union decl

    b .Lstruct_done

.Lstruct_no_body:
    // Forward declaration or reference: struct tag (no body)
    mov x0, x19
    bl _kcc_ast_alloc
    str x20, [x0, #AST_F0]      // name_ptr

    // Wrap in type
    mov x23, x0
    cmp x19, #AST_STRUCT_DECL
    b.eq .Lstruct_fwd_struct
    mov x0, #AST_TYPE_UNION
    b .Lstruct_fwd_wrap
.Lstruct_fwd_struct:
    mov x0, #AST_TYPE_STRUCT
.Lstruct_fwd_wrap:
    bl _kcc_ast_alloc
    str x23, [x0, #AST_F0]

.Lstruct_done:
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@}

\section{Enum}

An enumeration type specifier (\stdref{6.7.2.2}) introduces a set of named
integer constants.  The parser consumes the \texttt{enum} keyword, reads an
optional tag name, and if an opening brace follows, iterates over the
enumerator list.  Each enumerator is an identifier with an optional
\texttt{= constant-expression} initializer; a trailing comma before the
closing brace is permitted.  The resulting \texttt{AST\_ENUM\_DECL} node is
wrapped in a \texttt{TYPE\_ENUM} wrapper so it can be returned as a type
specifier to the declaration specifier loop.

@d Decl: parse enum @{
// -- kcc_parse_enum ----------------------------------------------------
// node *kcc_parse_enum(void)
// Parses: enum [ident] [{ enumerator-list }]
.globl _kcc_parse_enum
.p2align 2
_kcc_parse_enum:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    str x23, [sp, #48]

    // Consume 'enum'
    bl _kcc_pp_next

    // Optional tag name
    mov x19, #0                  // x19 = name_ptr
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_IDENT
    b.ne .Lenum_check_brace

    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_tok_len@@PAGE
    add  x1, x1, _kcc_tok_len@@PAGEOFF
    ldr  x1, [x1]
    bl _kcc_strtab_intern
    mov x19, x0

    bl _kcc_pp_next               // consume tag name

.Lenum_check_brace:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_LBRACE
    b.ne .Lenum_no_body

    bl _kcc_pp_next               // consume '{'

    mov x20, #0                  // first enumerator
    mov x21, #0                  // last enumerator

.Lenum_loop:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_RBRACE
    b.eq .Lenum_close

    // Parse enumerator: ident [= expr]
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_tok_len@@PAGE
    add  x1, x1, _kcc_tok_len@@PAGEOFF
    ldr  x1, [x1]
    bl _kcc_strtab_intern
    mov x22, x0                  // x22 = enumerator name

    bl _kcc_pp_next               // consume name

    mov x23, #0                  // value expr (default null)
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_ASSIGN
    b.ne .Lenum_build

    bl _kcc_pp_next               // consume '='
    bl _kcc_parse_cond_expr
    mov x23, x0

.Lenum_build:
    mov x0, #AST_ENUMERATOR
    bl _kcc_ast_alloc
    str x22, [x0, #AST_F0]      // name
    str x23, [x0, #AST_F1]      // value expr

    cbz x20, .Lenum_first
    str x0, [x21, #AST_F4]
    mov x21, x0
    b .Lenum_comma

.Lenum_first:
    mov x20, x0
    mov x21, x0

.Lenum_comma:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_COMMA
    b.ne .Lenum_close

    bl _kcc_pp_next               // consume ','

    // Allow trailing comma before '}'
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_RBRACE
    b.ne .Lenum_loop

.Lenum_close:
    mov x0, #TOK_RBRACE
    bl _kcc_parse_expect

    mov x0, #AST_ENUM_DECL
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]      // name
    str x20, [x0, #AST_F1]      // enumerators

    // Wrap in TYPE_ENUM
    mov x22, x0
    mov x0, #AST_TYPE_ENUM
    bl _kcc_ast_alloc
    str x22, [x0, #AST_F0]

    b .Lenum_done

.Lenum_no_body:
    // Forward reference
    mov x0, #AST_ENUM_DECL
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]

    mov x22, x0
    mov x0, #AST_TYPE_ENUM
    bl _kcc_ast_alloc
    str x22, [x0, #AST_F0]

.Lenum_done:
    ldr x23, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@| _kcc_parse_enum
@}

\section{Type Name}

A type name (\stdref{6.7.7}) appears in casts and \texttt{sizeof}.
It consists of specifier-qualifiers followed by an optional abstract
declarator (which can include pointers and array brackets but no name).

@d Decl: parse type name @{
// -- kcc_parse_type_name -----------------------------------------------
// node *kcc_parse_type_name(void)
// Parses a type-name (for casts, sizeof, _Alignof).
// Returns a type node.
.globl _kcc_parse_type_name
.p2align 2
_kcc_parse_type_name:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    // Parse specifiers (ignore storage class)
    bl _kcc_parse_decl_specs
    mov x19, x0                  // x19 = base type

    // Check for abstract declarator (pointer, array)
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_STAR
    b.eq .Ltname_abstract
    cmp  x0, #TOK_LBRACKET
    b.eq .Ltname_abstract
    // No abstract declarator
    mov x0, x19
    b .Ltname_done

.Ltname_abstract:
    mov x0, x19
    bl _kcc_parse_abstract_declarator

.Ltname_done:
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_parse_type_name
@}

\section{Is Type Token}

This predicate checks whether the current token can start a type
specifier.  It returns 1 for type keywords (char, int, etc.), type
qualifiers (const, volatile, etc.), and typedef names.

@d Decl: is type token @{
// -- kcc_parse_is_type_token -------------------------------------------
// int kcc_parse_is_type_token(void)
// Returns 1 if the current token can start a type specifier.
.globl _kcc_parse_is_type_token
.p2align 2
_kcc_parse_is_type_token:
    stp x29, x30, [sp, #-16]!
    mov x29, sp

    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]

    // Type specifier keywords: void(41), char(13), short(32), int(27),
    // long(28), float(22), double(18), signed(33), unsigned(40),
    // _Bool(47), _Complex(48)
    cmp x0, #TOK_VOID
    b.eq .Lis_type_yes
    cmp x0, #TOK_CHAR
    b.eq .Lis_type_yes
    cmp x0, #TOK_SHORT
    b.eq .Lis_type_yes
    cmp x0, #TOK_INT
    b.eq .Lis_type_yes
    cmp x0, #TOK_LONG
    b.eq .Lis_type_yes
    cmp x0, #TOK_FLOAT
    b.eq .Lis_type_yes
    cmp x0, #TOK_DOUBLE
    b.eq .Lis_type_yes
    cmp x0, #TOK_SIGNED
    b.eq .Lis_type_yes
    cmp x0, #TOK_UNSIGNED
    b.eq .Lis_type_yes
    cmp x0, #TOK__BOOL
    b.eq .Lis_type_yes
    cmp x0, #TOK__COMPLEX
    b.eq .Lis_type_yes

    // struct, union, enum
    cmp x0, #TOK_STRUCT
    b.eq .Lis_type_yes
    cmp x0, #TOK_UNION
    b.eq .Lis_type_yes
    cmp x0, #TOK_ENUM
    b.eq .Lis_type_yes

    // Type qualifiers (can start a type specifier list)
    cmp x0, #TOK_CONST
    b.eq .Lis_type_yes
    cmp x0, #TOK_VOLATILE
    b.eq .Lis_type_yes
    cmp x0, #TOK_RESTRICT
    b.eq .Lis_type_yes
    cmp x0, #TOK__ATOMIC
    b.eq .Lis_type_yes

    // _Alignas can appear in specifier-qualifier list
    cmp x0, #TOK__ALIGNAS
    b.eq .Lis_type_yes

    // Check for typedef name (identifier that is registered as typedef)
    cmp x0, #TOK_IDENT
    b.ne .Lis_type_no

    // Lookup in typedef table
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_tok_len@@PAGE
    add  x1, x1, _kcc_tok_len@@PAGEOFF
    ldr  x1, [x1]
    bl _kcc_typedef_lookup
    // x0 = 1 if typedef, 0 otherwise
    ldp x29, x30, [sp], #16
    ret

.Lis_type_yes:
    mov x0, #1
    ldp x29, x30, [sp], #16
    ret

.Lis_type_no:
    mov x0, #0
    ldp x29, x30, [sp], #16
    ret
@| _kcc_parse_is_type_token
@}

\section{Initializer}

An initializer (\stdref{6.7.9}) is either an assignment expression or
a brace-enclosed initializer list.  Within a list, an element may be
preceded by a \emph{designator} (\stdref{6.7.9p6}): \texttt{.member} to
name a struct or union member, or \texttt{[constant]} to name an array
element.  A designator makes an initializer list sparse and
order-independent---\texttt{\{ [2] = 5, [0] = 1 \}} or
\texttt{\{ .y = 2, .x = 1 \}}---and it resets the ``current object'' so
that any plain elements that follow continue from the designated
position.  A designation may also be a \emph{chain}
(\stdref{6.7.9p6}: \texttt{designator-list '='})---\texttt{.a.b},
\texttt{.arr[1]}, \texttt{[0].x}---naming a sub-object several aggregate
levels deep.  The parser collects the whole run of \texttt{.member} and
\texttt{[index]} designators into a linked list of \texttt{AST\_DESIGNATOR}
nodes before the \texttt{=}; the IR builder (\S\ref{sec:ir-aggregates})
then walks that chain to the leaf.  A single designator is simply a chain
of length one.

@d Decl: parse init @{
// -- kcc_parse_initializer ---------------------------------------------
// node *kcc_parse_initializer(void)
// Parses an initializer: assignment-expr or { init-list }
.globl _kcc_parse_initializer
.p2align 2
_kcc_parse_initializer:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_LBRACE
    b.ne .Linit_expr

    // Brace-enclosed initializer list
    bl _kcc_pp_next               // consume '{'

    mov x0, #AST_INIT_LIST
    bl _kcc_ast_alloc
    mov x19, x0                  // x19 = init_list node

    mov x20, #0                  // first init
    mov x21, #0                  // last init

.Linit_list_loop:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_RBRACE
    b.eq .Linit_list_close

    // Parse one initializer element, honouring a leading designator
    bl _kcc_parse_designated_element
    mov x0, x0                   // new init

    cbz x20, .Linit_list_first
    str x0, [x21, #AST_F4]
    mov x21, x0
    b .Linit_list_comma

.Linit_list_first:
    mov x20, x0
    mov x21, x0

.Linit_list_comma:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_COMMA
    b.ne .Linit_list_close

    bl _kcc_pp_next               // consume ','

    // Allow trailing comma
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_RBRACE
    b.ne .Linit_list_loop

.Linit_list_close:
    mov x0, #TOK_RBRACE
    bl _kcc_parse_expect

    str x20, [x19, #AST_F0]     // first init
    mov x0, x19
    b .Linit_done

.Linit_expr:
    // Simple expression initializer
    bl _kcc_parse_assign_expr

.Linit_done:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

// -- kcc_parse_designated_element --------------------------------------
// node *kcc_parse_designated_element(void)
// One initializer-list element.  If it starts with a designation---a
// *sequence* of `.member` and `[index]` designators (\stdref{6.7.9p6}:
// `designator-list '='`)---parse the whole chain followed by `=` and the
// value initializer.  Each designator is one AST_DESIGNATOR node
// (F0 = interned member name or integer index, F1 = 1 for a field / 0 for
// an index); the nodes are linked head-to-tail through AST_F2, and the
// value initializer is stored on the *head* node's AST_F3.  A single
// designator is just a chain of length one, so `.x = v` is unchanged.
// Anything not starting with `.`/`[` is a plain positional initializer.
.p2align 2
_kcc_parse_designated_element:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_DOT
    b.eq .Lde_chain
    cmp  x0, #TOK_LBRACKET
    b.eq .Lde_chain
    bl _kcc_parse_initializer
    b .Lde_ret

.Lde_chain:
    mov x19, #0                   // chain head
    mov x20, #0                   // chain tail
.Lde_desig_loop:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_DOT
    b.eq .Lde_field
    cmp  x0, #TOK_LBRACKET
    b.eq .Lde_index
    b .Lde_desig_end

.Lde_field:
    bl _kcc_pp_next               // consume '.'
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_tok_len@@PAGE
    add  x1, x1, _kcc_tok_len@@PAGEOFF
    ldr  x1, [x1]
    bl _kcc_strtab_intern
    mov x21, x0                   // interned member name (survives ast_alloc)
    bl _kcc_pp_next               // consume member identifier
    mov x0, #AST_DESIGNATOR
    bl _kcc_ast_alloc
    str x21, [x0, #AST_F0]       // name
    mov x2, #1
    str x2, [x0, #AST_F1]        // is_field
    b .Lde_link

.Lde_index:
    bl _kcc_pp_next               // consume '['
    bl _kcc_parse_assign_expr     // index expression
    bl _kcc_parse_const_index     // fold to an integer
    mov x21, x0                   // index value (survives ast_alloc)
    mov x0, #TOK_RBRACKET
    bl _kcc_parse_expect          // consume ']'
    mov x0, #AST_DESIGNATOR
    bl _kcc_ast_alloc
    str x21, [x0, #AST_F0]       // index value
    str xzr, [x0, #AST_F1]       // is_field = 0

.Lde_link:
    // Append the new designator node (in x0) to the chain via AST_F2.
    cbnz x19, .Lde_link_tail
    mov x19, x0                   // first node → head and tail
    mov x20, x0
    b .Lde_desig_loop
.Lde_link_tail:
    str x0, [x20, #AST_F2]       // previous tail → this node
    mov x20, x0
    b .Lde_desig_loop

.Lde_desig_end:
    mov x0, #TOK_ASSIGN
    bl _kcc_parse_expect
    bl _kcc_parse_initializer
    str x0, [x19, #AST_F3]      // value on the head node
    mov x0, x19

.Lde_ret:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

// -- kcc_parse_const_index ---------------------------------------------
// uint64_t kcc_parse_const_index(node *e)
// Extracts the integer value of a constant array-index designator.  A
// literal (after unwrapping parentheses) is used directly; anything else
// folds to 0 (non-constant designator indices are not yet supported).
.p2align 2
_kcc_parse_const_index:
    cbz x0, .Lpci_zero
.Lpci_unwrap:
    ldr x1, [x0, #AST_TAG]
    cmp x1, #AST_PAREN_EXPR
    b.ne .Lpci_check
    ldr x0, [x0, #AST_F0]
    cbz x0, .Lpci_zero
    b .Lpci_unwrap
.Lpci_check:
    cmp x1, #AST_INT_LIT
    b.eq .Lpci_val
    cmp x1, #AST_CHAR_LIT
    b.eq .Lpci_val
    mov x0, #0
    ret
.Lpci_val:
    ldr x0, [x0, #AST_F0]
    ret
.Lpci_zero:
    mov x0, #0
    ret
@| _kcc_parse_initializer
@| _kcc_parse_designated_element
@| _kcc_parse_const_index
@}

\section{Static Assert}

The \texttt{\_Static\_assert} declaration (\stdref{6.7.10}) provides
compile-time assertion checking.  It takes the form
\texttt{\_Static\_assert(constant-expression, string-literal);} and produces
an \texttt{AST\_STATIC\_ASSERT} node carrying the condition expression and
the diagnostic message string.  The assertion is evaluated during semantic
analysis; at parse time we only need to extract the two operands.

@d Decl: parse static assert @{
// -- kcc_parse_static_assert -------------------------------------------
// node *kcc_parse_static_assert(void)
// Parses: _Static_assert ( expr , string ) ;
.globl _kcc_parse_static_assert
.p2align 2
_kcc_parse_static_assert:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    // Consume '_Static_assert'
    bl _kcc_pp_next

    // Expect '('
    mov x0, #TOK_LPAREN
    bl _kcc_parse_expect

    // Parse expression
    bl _kcc_parse_cond_expr
    mov x19, x0                  // x19 = expr

    // Expect ','
    mov x0, #TOK_COMMA
    bl _kcc_parse_expect

    // Get message string
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x0, [x0]
    bl _kcc_strtab_intern
    mov x20, x0                  // x20 = message

    bl _kcc_pp_next               // consume string

    // Expect ')'
    mov x0, #TOK_RPAREN
    bl _kcc_parse_expect

    // Expect ';'
    mov x0, #TOK_SEMI
    bl _kcc_parse_expect

    mov x0, #AST_STATIC_ASSERT
    bl _kcc_ast_alloc
    str x19, [x0, #AST_F0]      // expr
    str x20, [x0, #AST_F1]      // message

    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_parse_static_assert
@}

\section{Declaration Data}

This fragment reserves a place for any static data the declaration parser
might need, such as error message strings or lookup tables.  Currently no
additional data is required beyond what the individual parsing functions use
locally.

@d Decl: data @{
// -- Declaration parser data (reserved) --------------------------------
// No additional data needed for declaration parsing.
@}
