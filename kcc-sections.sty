% kcc-sections.sty — Section decoration for the kcc literate compiler
% Uses KOMA-Script facilities for chapter/section styling.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{kcc-sections}[2025/01/01 kcc section decoration]

% Require KOMA-Script class
\@ifundefined{KOMAClassName}{%
  \PackageError{kcc-sections}{Requires a KOMA-Script class (scrbook, scrreprt, etc.)}{}%
}{}

% Section numbering depth
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{2}

% Chapter style: plain with a rule
\RedeclareSectionCommand[
  beforeskip=2\baselineskip,
  afterskip=1.5\baselineskip,
]{chapter}

% Section style
\RedeclareSectionCommand[
  beforeskip=1.5\baselineskip,
  afterskip=1\baselineskip,
]{section}

% Subsection style
\RedeclareSectionCommand[
  beforeskip=1\baselineskip,
  afterskip=0.5\baselineskip,
]{subsection}

\endinput
