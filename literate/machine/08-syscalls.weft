% 08-syscalls.weft — macOS System Call Wrappers
%
% kcc uses no C library.  Every interaction with the operating system
% goes through the macOS ARM64 syscall interface: place the syscall
% number in x16, arguments in x0–x5, and execute svc #0x80.
%
% This chapter provides thin wrappers that establish proper frame
% records and present a clean calling convention to the rest of kcc.

\chapter{System Calls}
\label{ch:syscalls}

Because \kcc{} links against no C library, every interaction with the operating system must go through the Darwin kernel's \texttt{svc \#0x80} interface directly.
This chapter provides thin, AAPCS64-conforming wrappers for the seven syscalls the compiler requires: process termination, file I/O (\texttt{open}, \texttt{read}, \texttt{write}, \texttt{close}), memory mapping (\texttt{mmap}), and file seeking (\texttt{lseek}).
Each wrapper establishes a proper frame record and translates the kernel convention---number in \reg{x16}, arguments in \reg{x0}--\reg{x5}---into ordinary function calls.

\section{Syscall Number Constants}

These constants come from the macOS/XNU kernel headers
(\texttt{<sys/syscall.h>}).  On ARM64, syscall numbers are placed
in \reg{x16} before the \texttt{svc} instruction.

@d Syscall: constants @{
// -- macOS ARM64 syscall numbers ------------------------------------
// Source: XNU bsd/kern/syscalls.master
.equ SYS_exit,     1
.equ SYS_fork,     2
.equ SYS_read,     3
.equ SYS_write,    4
.equ SYS_open,     5
.equ SYS_close,    6
.equ SYS_wait4,    7
.equ SYS_unlink,  10
.equ SYS_execve,  59
.equ SYS_mmap,   197          // 0xC5
.equ SYS_munmap,  73          // 0x49
.equ SYS_lseek,  199          // 0xC7

// lseek whence constants
.equ SEEK_SET,     0
.equ SEEK_CUR,     1
.equ SEEK_END,     2

// mmap constants for file mapping
.equ PROT_READ,    0x1       // PROT_READ only
.equ MAP_PRIVATE,  0x2       // MAP_PRIVATE (no MAP_ANON)
@}

\section{Process Control}

The simplest syscall: terminate the process.  \texttt{SYS\_exit}
takes a single argument in \reg{x0} (the exit status) and does
not return.

@d Syscall: exit @{
// -- SYS_exit ---------------------------------------------------
// void kcc_sys_exit(int status)
//   x0 = exit status
// Does not return.
FUNC kcc_sys_exit
    SYSCALL SYS_exit
    brk #1                    // unreachable; trap if kernel returns
ENDFUNC
@}

\section{File I/O}

The core I/O syscalls.  Each wrapper preserves the AAPCS64 calling
convention: arguments arrive in \reg{x0}--\reg{x5}, the result is
returned in \reg{x0}, and the carry flag indicates an error (in which
case \reg{x0} holds the \texttt{errno} value).

\subsection{write}

Write bytes to a file descriptor.  This is the fundamental output
primitive; all formatted output in \kcc{} ultimately reduces to
calls to \texttt{kcc\_sys\_write}.

@d Syscall: write @{
// -- SYS_write --------------------------------------------------
// ssize_t kcc_sys_write(int fd, const void *buf, size_t len)
//   x0 = file descriptor
//   x1 = buffer pointer
//   x2 = byte count
// Returns bytes written in x0, or (uint64_t)-1 with carry set.
FUNC kcc_sys_write
    SYSCALL SYS_write
ENDFUNC
@}

\subsection{read}

Read bytes from a file descriptor.  Used by the source manager to read source files when
\texttt{mmap} is unsuitable.

@d Syscall: read @{
// -- SYS_read ---------------------------------------------------
// ssize_t kcc_sys_read(int fd, void *buf, size_t len)
//   x0 = file descriptor
//   x1 = buffer pointer
//   x2 = maximum bytes to read
// Returns bytes read in x0, 0 at EOF, or -1 on error.
FUNC kcc_sys_read
    SYSCALL SYS_read
ENDFUNC
@}

\subsection{open}

Open a file by pathname.  Returns a file descriptor or $-1$ on error.

Unlike the other wrappers, \texttt{open} inspects the carry flag the
kernel sets on failure and collapses the raw \texttt{errno} it leaves
in \reg{x0} to a uniform $-1$.  Callers---\texttt{source\_open} and the
preprocessor's include probing---test for $-1$, and a bare
\texttt{errno} (a small positive integer) would otherwise be mistaken
for a valid descriptor, so this normalisation is what lets a missing
\texttt{\#include} surface as a clean diagnostic instead of a later
crash on a bogus file descriptor.

@d Syscall: open @{
// -- SYS_open ---------------------------------------------------
// int kcc_sys_open(const char *path, int flags, mode_t mode)
//   x0 = path (null-terminated)
//   x1 = flags (O_RDONLY=0, O_WRONLY=1, O_RDWR=2, ...)
//   x2 = mode (permissions, used with O_CREAT)
// Returns fd in x0, or -1 on error.
FUNC kcc_sys_open
    SYSCALL SYS_open
    b.cs .Lsys_open_err          // carry set → errno in x0, normalise to -1
    ldp x29, x30, [sp], #16
    ret
.Lsys_open_err:
    mov x0, #-1
    ldp x29, x30, [sp], #16
    ret
@}

\subsection{close}

Close a file descriptor.

@d Syscall: close @{
// -- SYS_close --------------------------------------------------
// int kcc_sys_close(int fd)
//   x0 = file descriptor
// Returns 0 on success, -1 on error.
FUNC kcc_sys_close
    SYSCALL SYS_close
ENDFUNC
@}

\section{Memory Management}

\subsection{mmap}

Map pages of memory.  This is how \kcc{} obtains all dynamic memory:
the arena allocator (Chapter~\ref{ch:arena}) calls \texttt{mmap}
with \texttt{MAP\_PRIVATE | MAP\_ANON} to get fresh pages from the
kernel.

@d Syscall: mmap @{
// -- SYS_mmap ---------------------------------------------------
// void *kcc_sys_mmap(void *addr, size_t len, int prot,
//                    int flags, int fd, off_t offset)
//   x0 = requested address (0 for kernel choice)
//   x1 = length in bytes
//   x2 = protection (PROT_READ|PROT_WRITE = 0x3)
//   x3 = flags (MAP_PRIVATE|MAP_ANON = 0x1002)
//   x4 = file descriptor (-1 for anonymous)
//   x5 = offset
// Returns mapped address in x0, or MAP_FAILED ((void *)-1).
FUNC kcc_sys_mmap
    SYSCALL SYS_mmap
ENDFUNC
@}

\subsection{lseek}

Reposition the file offset.  Used by the source manager to determine
file size before \texttt{mmap}: \texttt{lseek(fd, 0, SEEK\_END)}
returns the file length.

@d Syscall: lseek @{
// -- SYS_lseek --------------------------------------------------
// off_t kcc_sys_lseek(int fd, off_t offset, int whence)
//   x0 = file descriptor
//   x1 = offset
//   x2 = whence (SEEK_SET=0, SEEK_CUR=1, SEEK_END=2)
// Returns new file offset in x0, or -1 on error.
FUNC kcc_sys_lseek
    SYSCALL SYS_lseek
ENDFUNC
@}

\section{Process Creation}

Automatic linking (Chapter~\ref{ch:driver}) requires \kcc{} to run the system
linker as a child process.  Three syscalls suffice: \texttt{fork} duplicates
the process, \texttt{execve} replaces the child's image with \texttt{/usr/bin/ld},
and \texttt{wait4} lets the parent collect the linker's exit status.
\texttt{unlink} removes the temporary object files afterwards.

On Darwin ARM64 the \texttt{fork} syscall has an unusual convention: it returns
in \emph{both} processes at the instruction after \texttt{svc}, with \reg{x1}
set to~1 in the child and~0 in the parent (and \reg{x0} holding the child's PID
in the parent).  The wrapper normalises this to the POSIX contract---the child
sees a return value of~0, the parent sees the child PID, and $-1$ signals an
error (carry set).

@d Syscall: process @{
// -- SYS_fork ---------------------------------------------------
// pid_t kcc_sys_fork(void)
// Returns 0 in the child, the child PID in the parent, or -1 on error.
FUNC kcc_sys_fork
    SYSCALL SYS_fork
    b.cs .Lfork_err
    cmp x1, #1                 // Darwin: x1 == 1 in the child
    b.ne .Lfork_ret
    mov x0, #0                 // child → 0
    b .Lfork_ret
.Lfork_err:
    mov x0, #-1
.Lfork_ret:
ENDFUNC

// -- SYS_execve -------------------------------------------------
// int kcc_sys_execve(const char *path, char *const argv[], char *const envp[])
//   x0 = path, x1 = argv, x2 = envp
// Only returns on failure; then returns -1.
FUNC kcc_sys_execve
    SYSCALL SYS_execve
    mov x0, #-1
ENDFUNC

// -- SYS_wait4 --------------------------------------------------
// pid_t kcc_sys_wait4(pid_t pid, int *status, int options, void *rusage)
//   x0 = pid, x1 = status ptr, x2 = options, x3 = rusage ptr
// Returns the reaped PID in x0.
FUNC kcc_sys_wait4
    SYSCALL SYS_wait4
ENDFUNC

// -- SYS_unlink -------------------------------------------------
// int kcc_sys_unlink(const char *path)
//   x0 = path
FUNC kcc_sys_unlink
    SYSCALL SYS_unlink
ENDFUNC
@}
