_kcc_tn_pipeequal:    .asciz "pipeequal"
_kcc_tn_hash:         .asciz "hash"
_kcc_tn_hashhash:     .asciz "hashhash"
_kcc_tn_ellipsis:     .asciz "ellipsis"
@| _kcc_tn_lparen
@| _kcc_tn_rparen
@| _kcc_tn_lbrace
@| _kcc_tn_rbrace
@| _kcc_tn_lbracket
@| _kcc_tn_rbracket
