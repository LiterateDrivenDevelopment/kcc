S(s_negq, "\tnegq\t"); S(s_notq, "\tnotq\t"); S(s_shlq, "\tshlq\t");
S(s_sarq, "\tsarq\t"); S(s_shrq, "\tshrq\t"); S(s_cqto, "\tcqto\n");
S(s_xor_rdx, "\txorq\t%rdx, %rdx\n"); S(s_idiv_rcx, "\tidivq\t%rcx\n");
S(s_div_rcx, "\tdivq\t%rcx\n");
S(s_r10, "%r10"); S(s_r11, "%r11"); S(s_rax, "%rax"); S(s_rcx, "%rcx");
S(s_rdx, "%rdx"); S(s_r11_r10, "%r11, %r10\n"); S(s_r10_nl, "%r10\n");
S(s_rbx, "%rbx"); S(s_push_rbx, "\tpushq\t%rbx\n"); S(s_pop_rbx, "\tpopq\t%rbx\n");
S(s_setcc, "\tset"); S(s_tab_al, "\t%al\n"); S(s_movzx_al, "\tmovzbl\t%al, %eax\n");
