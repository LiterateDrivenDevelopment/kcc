\bigskip
\noindent\textbf{include/*.h} --- hosted library header bridges.  Unlike every
other \texttt{@@o} target these are not assembly: they are C headers tangled to
\texttt{gen/include/} beside the compiler binary, where the default include
directory finds them (\S\ref{sec:hosted-headers}).  Section markers are
suppressed (\texttt{-s}) so the shipped headers read cleanly:

@o include/stdio.h -s @{
@<Header: stdio@>
@}

@o include/stdlib.h -s @{
@<Header: stdlib@>
@}

@o include/string.h -s @{
@<Header: string@>
@}

@o include/ctype.h -s @{
@<Header: ctype@>
@}

@o include/math.h -s @{
@<Header: math@>
@}

@o include/assert.h -s @{
