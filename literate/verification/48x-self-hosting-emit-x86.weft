static struct AttrRec *x86_attr(const char *name) {
    if (!kcc_attr_ht || !name) return 0;
    return (struct AttrRec *)kcc_ht_get(kcc_attr_ht, name, kcc_strlen(name));
}

extern void *kcc_ir_funcs;           /* vec of IR function pointers */
extern char kcc_str_modinit[];       /* "kcc.module_init" */
extern unsigned long kcc_modinit_present;

/* IR instruction / block / function / type / vec / AST field offsets */
#define IR_OP 0
#define IR_DEST 8
#define IR_SRC1 16
#define IR_SRC2 24
#define IR_TYPE 32
#define IR_NEXT 40
#define BB_ID 0
#define BB_FIRST 8
#define IRF_NAME 0
#define IRF_BLOCKS 16
#define IRF_VREG_N 24
#define IRF_PARAMS 40
#define IRF_PARAM_CLS 48
#define IRF_STATIC 72
#define IRF_VARIADIC 88
#define VEC_COUNT 8
#define TY_KIND 0
#define TY_SIZE 8
#define TY_F0 32
#define TY_VOID 1
#define TY_STRUCT 14
#define TY_ARRAY 12
#define TY_PTR 11
#define TY_FLOAT 8
#define TY_DOUBLE 9
#define AST_TAG 0
#define AST_F0 24
#define AST_F1 32
#define AST_F2 40
#define AST_F3 48
#define AST_F4 56

/* IR opcodes */
enum {
    IR_ADD=1, IR_SUB=2, IR_MUL=3, IR_SDIV=4, IR_UDIV=5, IR_SMOD=6, IR_UMOD=7,
    IR_NEG=8, IR_AND=10, IR_OR=11, IR_XOR=12, IR_SHL=13, IR_LSHR=14, IR_ASHR=15,
    IR_NOT=16, IR_CMP_EQ=20, IR_CMP_NE=21, IR_CMP_SLT=22, IR_CMP_SLE=23,
    IR_CMP_SGT=24, IR_CMP_SGE=25, IR_CMP_ULT=26, IR_CMP_ULE=27,
    IR_LOAD=30, IR_STORE=31, IR_ALLOCA=32, IR_GEP=33, IR_BR=40, IR_BR_COND=41,
    IR_RET=42, IR_CALL=43, IR_CALL_IND=44, IR_SEXT=50, IR_ZEXT=51, IR_TRUNC=52,
    IR_BITCAST=53, IR_SITOFP=54, IR_FPTOSI=55, IR_VA_START=56, IR_FPROUND=57, IR_UITOFP=58,
    IR_CONST=60, IR_NOP=61, IR_GLOBAL_REF=63, IR_STRING_LIT=64, IR_ASM=65
};
/* AST tags used by the data/static walks */
enum {
    AST_VAR_DECL=10, AST_FUNC_DECL=11, AST_STR_LIT=52, AST_ASM_STMT=74, AST_COMPOUND=30, AST_IF_STMT=32,
    AST_SWITCH_STMT=33, AST_WHILE_STMT=34, AST_DO_STMT=35, AST_FOR_STMT=36,
    AST_CASE_STMT=42, AST_LABEL_STMT=41, AST_DEFAULT_STMT=43, AST_INIT_LIST=65
};

/* exported target-selection state (the driver sets these) */
unsigned long kcc_target = 0;        /* 0 = arm64/Mach-O, 1 = x86-64 */
void *kcc_x86_tu = 0;                /* AST translation unit (data emission) */
unsigned long kcc_x86_os = 0;        /* 0 = Darwin/Mach-O, 1 = Linux/ELF */
static unsigned long kcc_x86_vreg_n = 0;
static void *kcc_x86_strs = 0;
static unsigned long kcc_x86_rsa_top = 0;   /* rbp-relative top of the variadic register-save area */

#define S(name, str) static const char name[] = str
S(s_text, ".text\n"); S(s_globl, ".globl "); S(s_us, "_");
S(s_weak, ".weak "); S(s_section, ".section "); S(s_set, "\t.set "); S(s_prev, "\t.previous\n");
S(s_bss, ".bss\n"); S(s_ax, ",\"ax\",@@progbits\n");
S(s_rodata, ".section .rodata\n"); S(s_comm, "\t.comm "); S(s_comm_a8, ",8\n");
S(s_local, "\t.local ");
S(s_modinit_d, ".section __DATA,__mod_init_func,mod_init_funcs\n\t.p2align 3\n\t.quad ");
S(s_modinit_l, ".section .init_array,\"aw\"\n\t.p2align 3\n\t.quad ");
S(s_modinitnm, "kcc.module_init");
S(s_constsect, ".section __TEXT,__const\n"); S(s_p2align3, "\t.p2align 3\n");
S(s_d_byte, "\t.byte "); S(s_d_short, "\t.short "); S(s_d_long, "\t.long ");
S(s_d_quad, "\t.quad "); S(s_zerodir, "\t.zero "); S(s_colon_nl, ":\n");
S(s_minus, "-"); S(s_rbp, "(%rbp)"); S(s_comma, ", ");
S(s_push_rbp, "\tpushq\t%rbp\n"); S(s_mov_sp, "\tmovq\t%rsp, %rbp\n");
S(s_sub_sp, "\tsubq\t$"); S(s_sp_nl, ", %rsp\n"); S(s_leave, "\tleave\n");
S(s_retq, "\tretq\n"); S(s_movq, "\tmovq\t"); S(s_movabsq, "\tmovabsq\t$");
S(s_movl, "\tmovl\t"); S(s_movb, "\tmovb\t"); S(s_movw, "\tmovw\t");
S(s_movslq, "\tmovslq\t"); S(s_movsbq, "\tmovsbq\t"); S(s_movswq, "\tmovswq\t");
S(s_movzbq, "\tmovzbq\t"); S(s_movzwq, "\tmovzwq\t"); S(s_leaq, "\tleaq\t");
S(s_addq, "\taddq\t"); S(s_subq, "\tsubq\t"); S(s_imulq, "\timulq\t");
S(s_andq, "\tandq\t"); S(s_orq, "\torq\t"); S(s_xorq, "\txorq\t");
S(s_negq, "\tnegq\t"); S(s_notq, "\tnotq\t"); S(s_shlq, "\tshlq\t");
S(s_sarq, "\tsarq\t"); S(s_shrq, "\tshrq\t"); S(s_cqto, "\tcqto\n");
S(s_xor_rdx, "\txorq\t%rdx, %rdx\n"); S(s_idiv_rcx, "\tidivq\t%rcx\n");
S(s_div_rcx, "\tdivq\t%rcx\n");
S(s_r10, "%r10"); S(s_r11, "%r11"); S(s_rax, "%rax"); S(s_rcx, "%rcx");
S(s_rdx, "%rdx"); S(s_r11_r10, "%r11, %r10\n"); S(s_r10_nl, "%r10\n");
S(s_cl_r10, "%cl, %r10\n"); S(s_c_r10, ", %r10\n"); S(s_c_r10d, ", %r10d\n");
S(s_pr11_r10, "(%r11), %r10\n"); S(s_pr11_r10d, "(%r11), %r10d\n");
S(s_pr11, "(%r11)");
S(s_r10_pr11, "%r10, (%r11)\n"); S(s_r10b_pr11, "%r10b, (%r11)\n");
S(s_r10w_pr11, "%r10w, (%r11)\n"); S(s_r10d_pr11, "%r10d, (%r11)\n");
S(s_cmpl, "\tcmpl\t%r11d, %r10d\n"); S(s_cmpq, "\tcmpq\t%r11, %r10\n");
S(s_movzbl_al, "\tmovzbl\t%al, %r10d\n"); S(s_sete, "\tsete\t%al\n");
S(s_setne, "\tsetne\t%al\n"); S(s_setl, "\tsetl\t%al\n"); S(s_setle, "\tsetle\t%al\n");
S(s_setg, "\tsetg\t%al\n"); S(s_setge, "\tsetge\t%al\n"); S(s_setb, "\tsetb\t%al\n");
S(s_setbe, "\tsetbe\t%al\n"); S(s_bb, ".Lkccbb"); S(s_label_nl, ":\n");
