@<Test: lex numbers@>
@<Test: lex strings@>
@<Test: lex punctuators@>
@<Test: lex comments@>
@<Test: lex trigraphs@>
@<Test: lex line splice@>
@<Test: registration@>
@<Test: lex data@>
@}
