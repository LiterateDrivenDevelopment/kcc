// -- Loop stack (break/continue targets) --
.data
.p2align 3
.globl _kcc_loop_depth
_kcc_loop_depth: .quad 0
.globl _kcc_loop_stack
_kcc_loop_stack: .space 256   // 16 levels * 16 bytes (break_bb, continue_bb)
.globl _kcc_ir_trans_unit
_kcc_ir_trans_unit: .quad 0

