S(s_setne, "\tsetne\t%al\n"); S(s_setl, "\tsetl\t%al\n"); S(s_setle, "\tsetle\t%al\n");
S(s_setg, "\tsetg\t%al\n"); S(s_setge, "\tsetge\t%al\n"); S(s_setb, "\tsetb\t%al\n");
S(s_setbe, "\tsetbe\t%al\n"); S(s_bb, ".Lkccbb"); S(s_label_nl, ":\n");
S(s_jmp, "\tjmp\t"); S(s_jne, "\tjne\t"); S(s_test_r10, "\ttestq\t%r10, %r10\n");
S(s_jmp_ind_r10, "\tjmp\t*%r10\n");
S(s_rdi, "%rdi"); S(s_rsi, "%rsi"); S(s_r8, "%r8"); S(s_r9, "%r9");
S(s_call, "\tcall\t"); S(s_call_r11, "\tcall\t*%r11\n"); S(s_zero_al, "\tmovb\t$0, %al\n");
S(s_movb_d, "\tmovb\t$"); S(s_al_nl, ", %al\n");
S(s_add_rsp, "\taddq\t$"); S(s_paren_rsp, "(%rsp)"); S(s_rip_r10, "(%rip), %r10\n");
S(s_rip, "(%rip)");
S(s_got_r10, "@@GOTPCREL(%rip), %r10\n");
S(s_zerofill, "\t.zerofill __DATA,__common,_"); S(s_zf_a3, ",3\n"); S(s_comma1, ",");
S(s_unsup, "kcc: --target=x86_64: unsupported operation (floating point, inline asm, or by-value aggregate not yet implemented for the x86-64 back end)\n");
S(s_strlbl, ".Lx86str"); S(s_cstrsect, ".section __TEXT,__cstring,cstring_literals\n");
S(s_zero_nl, "0\n");
/* Floating point (rung 4): SSE moves, arithmetic, and conversions.  A value
   lives in the same 8-byte slot as an integer (the IEEE double bit pattern);
   %xmm0/%xmm1 are the scratch pair, single precision only at the memory edge. */
S(s_movsd, "\tmovsd\t"); S(s_movss, "\tmovss\t");
S(s_cx0_nl, ", %xmm0\n"); S(s_cx1_nl, ", %xmm1\n"); S(s_x0_c, "%xmm0, "); S(s_nl, "\n");
S(s_addsd, "\taddsd\t"); S(s_subsd, "\tsubsd\t"); S(s_mulsd, "\tmulsd\t");
S(s_divsd, "\tdivsd\t"); S(s_x1_x0, "%xmm1, %xmm0\n");
S(s_cvtsi2sd, "\tcvtsi2sdq\t%r10, %xmm0\n"); S(s_cvttsd2si, "\tcvttsd2si\t%xmm0, %r10\n");
S(s_cvtsd2ss, "\tcvtsd2ss\t%xmm0, %xmm0\n"); S(s_cvtss2sd, "\tcvtss2sd\t%xmm0, %xmm0\n");
S(s_px11_x0, "(%r11), %xmm0\n"); S(s_x0_px11, "%xmm0, (%r11)\n");
static const char *const argregs[6] = { s_rdi, s_rsi, s_rdx, s_rcx, s_r8, s_r9 };
S(s_xmm0, "%xmm0"); S(s_xmm1, "%xmm1"); S(s_xmm2, "%xmm2"); S(s_xmm3, "%xmm3");
S(s_xmm4, "%xmm4"); S(s_xmm5, "%xmm5"); S(s_xmm6, "%xmm6"); S(s_xmm7, "%xmm7");
static const char *const xmmregs[8] = { s_xmm0, s_xmm1, s_xmm2, s_xmm3, s_xmm4, s_xmm5, s_xmm6, s_xmm7 };

#define IL(i,off) (*(unsigned long *)((char *)(i) + (off)))
struct Type { unsigned long kind, size, align, quals, f0, f1; };
struct Node { unsigned long tag, line, col, f0, f1, f2, f3, f4; };

/* forward decls */
static void x86_emit_rodata_global(void *decl, const char *name);
static void x86_emit_rodata_ptrarr(void *decl, const char *name);
static void x86_emit_zero(unsigned long n);
static void x86_emit_value(unsigned long bits, unsigned long size);
static void x86_prereg_stmt(void *stmt);
@}

\section{Symbol and Operand Helpers}

\texttt{x86\_sym} prefixes a symbol with an underscore on Darwin only.
\texttt{x86\_disp}/\texttt{x86\_slot} print a frame displacement and a vreg's
slot operand; \texttt{x86\_load}/\texttt{x86\_store} move a slot to or from a
named register.

@l c
@d Selfhost: emit_x86 helpers @{
static void x86_sym(const char *name) {
    if (!kcc_x86_os) kcc_as_str(s_us);          /* Darwin underscore */
    kcc_as_str(name);
}
static void x86_disp(unsigned long d) {
    kcc_as_str(s_minus); kcc_as_dec(d); kcc_as_str(s_rbp);
}
static void x86_slot(unsigned long v) { x86_disp((v + 1) * 8); }
static void x86_load(unsigned long v, const char *reg) {
    kcc_as_str(s_movq); x86_slot(v); kcc_as_str(s_comma); kcc_as_str(reg); kcc_as_ch('\n');
}
static void x86_store(unsigned long v, const char *reg) {
    kcc_as_str(s_movq); kcc_as_str(reg); kcc_as_str(s_comma); x86_slot(v); kcc_as_ch('\n');
}
@}

\section{Instruction Shapes}

The ALU, shift, division, conversion, memory, comparison, and call shapes each
lower one IR instruction to its x86-64 form, leaving the result in
\texttt{DEST}'s slot.

@l c
@d Selfhost: emit_x86 shapes @{
static void x86_binop(void *i, const char *mnem) {
    x86_load(IL(i, IR_SRC1), s_r10);
    x86_load(IL(i, IR_SRC2), s_r11);
    kcc_as_str(mnem); kcc_as_str(s_r11_r10);
    x86_store(IL(i, IR_DEST), s_r10);
}
static void x86_unop(void *i, const char *mnem) {
    x86_load(IL(i, IR_SRC1), s_r10);
    kcc_as_str(mnem); kcc_as_str(s_r10_nl);
    x86_store(IL(i, IR_DEST), s_r10);
}
static void x86_shift(void *i, const char *mnem) {
    x86_load(IL(i, IR_SRC1), s_r10);
    x86_load(IL(i, IR_SRC2), s_rcx);
    kcc_as_str(mnem); kcc_as_str(s_cl_r10);
    x86_store(IL(i, IR_DEST), s_r10);
}
static void x86_divop(void *i, int is_signed, int want_rem) {
    x86_load(IL(i, IR_SRC1), s_rax);
    kcc_as_str(is_signed ? s_cqto : s_xor_rdx);
    x86_load(IL(i, IR_SRC2), s_rcx);
    kcc_as_str(is_signed ? s_idiv_rcx : s_div_rcx);
    x86_store(IL(i, IR_DEST), want_rem ? s_rdx : s_rax);
}
static void x86_extend(void *i, const char *mnem, const char *tail) {
    kcc_as_str(mnem); x86_slot(IL(i, IR_SRC1)); kcc_as_str(tail);
    x86_store(IL(i, IR_DEST), s_r10);
}
static void x86_conv(void *i, unsigned long width, int is_signed) {
    if (width == 1) x86_extend(i, is_signed ? s_movsbq : s_movzbq, s_c_r10);
    else if (width == 2) x86_extend(i, is_signed ? s_movswq : s_movzwq, s_c_r10);
    else if (width == 4) {
        if (is_signed) x86_extend(i, s_movslq, s_c_r10);
        else x86_extend(i, s_movl, s_c_r10d);
    } else x86_extend(i, s_movq, s_c_r10);       /* 8 / unknown: plain copy */
}
static void x86_memload(void *i, const char *mnem, const char *tail) {
    x86_load(IL(i, IR_SRC1), s_r11);
    kcc_as_str(mnem); kcc_as_str(tail);
    x86_store(IL(i, IR_DEST), s_r10);
}
static void x86_memstore(void *i, const char *mnem, const char *valtail) {
    x86_load(IL(i, IR_SRC1), s_r10);
    x86_load(IL(i, IR_SRC2), s_r11);
    kcc_as_str(mnem); kcc_as_str(valtail);
}
static void x86_cmp(void *i, const char *setcc) {
    x86_load(IL(i, IR_SRC1), s_r10);
    x86_load(IL(i, IR_SRC2), s_r11);
    struct Type *ty = (struct Type *)IL(i, IR_TYPE);
    if (!ty || ty->size == 8) kcc_as_str(s_cmpq);
    else kcc_as_str(s_cmpl);
    kcc_as_str(setcc); kcc_as_str(s_movzbl_al);
    x86_store(IL(i, IR_DEST), s_r10);
}
static int is_fp_type(void *ty) {
    if (!ty) return 0;
    unsigned long k = IL(ty, TY_KIND);
    return k == TY_FLOAT || k == TY_DOUBLE;
}
static void x86_fpload(unsigned long v, const char *tail) {
    kcc_as_str(s_movsd); x86_slot(v); kcc_as_str(tail);
}
static void x86_fpstore(unsigned long v) {
    kcc_as_str(s_movsd); kcc_as_str(s_x0_c); x86_slot(v); kcc_as_str(s_nl);
}
static void x86_fpbinop(void *i, const char *mnem) {
    x86_fpload(IL(i, IR_SRC1), s_cx0_nl);
    x86_fpload(IL(i, IR_SRC2), s_cx1_nl);
    kcc_as_str(mnem); kcc_as_str(s_x1_x0);
    x86_fpstore(IL(i, IR_DEST));
}
static void x86_bblabel(unsigned long id) { kcc_as_str(s_bb); kcc_as_dec(id); }

static unsigned long kcc_x86_call_nfp = 0;
/* `movq %r10, off(%rsp)` — copy a scratch word to the outgoing stack area. */
static void x86_push_r10(unsigned long off) {
    kcc_as_str(s_movq); kcc_as_str(s_r10); kcc_as_str(s_comma);
    kcc_as_dec(off); kcc_as_str(s_paren_rsp); kcc_as_ch('\n');
}
/* `movq disp(%r11), dst` — load one word of a by-value aggregate (r11 = its
   address) into a GP argument register or scratch. */
static void x86_load_word(unsigned long disp, const char *dst) {
    kcc_as_str(s_movq); kcc_as_dec(disp); kcc_as_str(s_pr11);
    kcc_as_str(s_comma); kcc_as_str(dst); kcc_as_ch('\n');
}
static unsigned long x86_marshal(unsigned long *args, unsigned long count) {
    kcc_x86_call_nfp = 0;
    if (!count) return 0;
    /* System~V argument classification: class~1 (float/double) → %xmm0-7;
       class~2/3 aggregates travel by VALUE in one/two GP registers loaded from
       their address vreg; everything else in %rdi..%r9.  Whatever overflows a
       bank is copied to the outgoing stack in argument order. */
    unsigned long ngp = 0, nfp = 0, nstk = 0;
    for (unsigned long k = 0; k < count; k++) {
        unsigned long c = args[2 + 2 * k];
        if (c == 1)      { if (nfp < 8) nfp++; else nstk++; }
        else if (c == 3) { if (ngp + 1 < 6) ngp += 2; else nstk += 2; }
        else             { if (ngp < 6) ngp++; else nstk++; }
    }
    unsigned long stack_adj = 0;
    if (nstk) {
        stack_adj = ((nstk * 8) + 15) & ~15UL;
        kcc_as_str(s_sub_sp); kcc_as_dec(stack_adj); kcc_as_str(s_sp_nl);
    }
    kcc_x86_call_nfp = nfp;
    ngp = 0; nfp = 0;
    unsigned long soff = 0;
    for (unsigned long k = 0; k < count; k++) {
        unsigned long v = args[1 + 2 * k];
        unsigned long c = args[2 + 2 * k];
        if (c == 1) {
            if (nfp < 8) {
                kcc_as_str(s_movsd); x86_slot(v); kcc_as_str(s_comma);
                kcc_as_str(xmmregs[nfp]); kcc_as_ch('\n'); nfp++;
            } else { x86_load(v, s_r10); x86_push_r10(soff); soff += 8; }
        } else if (c == 3) {
            if (ngp + 1 < 6) {
                x86_load(v, s_r11);
                x86_load_word(0, argregs[ngp]); x86_load_word(8, argregs[ngp + 1]);
                ngp += 2;
            } else {
                x86_load(v, s_r11);
                x86_load_word(0, s_r10); x86_push_r10(soff); soff += 8;
                x86_load_word(8, s_r10); x86_push_r10(soff); soff += 8;
            }
        } else if (c == 2) {
            if (ngp < 6) { x86_load(v, s_r11); x86_load_word(0, argregs[ngp]); ngp++; }
            else { x86_load(v, s_r11); x86_load_word(0, s_r10); x86_push_r10(soff); soff += 8; }
        } else {
            if (ngp < 6) { x86_load(v, argregs[ngp]); ngp++; }
            else { x86_load(v, s_r10); x86_push_r10(soff); soff += 8; }
        }
    }
    return stack_adj;
}
/* System~V requires %al to hold the number of vector registers used when
   calling a variadic (or unprototyped) function; benign for the rest. */
static void x86_set_al(void) {
    kcc_as_str(s_movb_d); kcc_as_dec(kcc_x86_call_nfp); kcc_as_str(s_al_nl);
}
static unsigned long x86_call_args(unsigned long *args) {
    if (!args) return 0;
    return x86_marshal(args, args[0] & 0xffffffff);
}
@}

\section{The Dispatch}

\texttt{x86\_sel} routes one IR instruction to its shape.  \texttt{IR\_CONST},
\texttt{IR\_ALLOCA}, \texttt{IR\_RET}, loads, stores, branches, calls, global
references, string literals, and extended inline asm are lowered inline; the
ALU/shift/div/conv and floating-point opcodes go through the shape helpers.  A
genuine \texttt{IR\_NOP} emits nothing; an unrecognised opcode (a by-value
aggregate the marshaller cannot classify) is refused cleanly rather than
miscompiled.

Extended inline asm (\texttt{IR\_ASM}) is where the kernel's word-at-a-time and
atomic idioms live, so \texttt{x86\_emit\_asm} renders it directly.  Register
constraints (\verb|"r"|, \verb|"=r"|, \verb|"+r"|, an early-clobber \verb|&|
ignored)---together with \verb|"g"| (general: reg/mem/imm), \verb|"q"|
(byte-addressable register, which on x86-64 is any register), and \verb|"p"|
(address), all of which kcc materialises into a register just like \verb|"r"|,
and which dominate the kernel's inline asm---and matching constraints
(\verb|"0"|, \verb|"1"|, \ldots) are honoured.  An operand may
also be named, and \verb|%[name]| in the template resolves to it the same way
\verb|%N| does.  The six physical registers
\texttt{\%r8}, \texttt{\%r9}, \texttt{\%r10}, \texttt{\%r12}, \texttt{\%r13},
\texttt{\%r14}---the first three
caller-saved, so the surrounding all-spill code survives the asm untouched, and
\texttt{\%r12}--\texttt{\%r14}, callee-saved, bracketed with \texttt{pushq}/%
\texttt{popq} when the operand count spills into them---are handed out from a
\emph{compact} pool (\texttt{nphys}) drawn only by operands that actually need
one: an \texttt{r}/\texttt{g}/\texttt{q}/\texttt{p} register operand or an
\texttt{m} memory operand.  An immediate, a symbolic \verb|%P| operand, a string
literal, and a condition-code \verb|=@@cc| output all render inline and consume
no register, so a template may name well more than six operands as long as at
most six of them require a register.  (Earlier the sixteen-entry operand arrays
were indexed one-to-one with the physical registers, capping the \emph{total}
operand count at six; the kernel's \texttt{const\_ilog2}/\texttt{test\_bit}
sites routinely name eight or more, most of them immediates, and were refused on
the operand count alone.)  Only when the register-needing operands themselves
exceed six---or the array holds more than sixteen operands total---is the asm
refused rather than silently mis-substituted.  \texttt{\%r11} stays reserved as
the scratch that carries an output operand's address.
Beyond the positional \texttt{r} registers, an operand may be pinned to a
specific register---\texttt{a}/\texttt{b}/\texttt{c}/\texttt{d} for
\texttt{\%rax}/\texttt{\%rbx}/\texttt{\%rcx}/\texttt{\%rdx} and \texttt{S}/%
\texttt{D} for \texttt{\%rsi}/\texttt{\%rdi}---as \texttt{mul}/\texttt{div}
(\texttt{a}/\texttt{d}), \texttt{cpuid}, \texttt{rdtsc}, and shift-by-\texttt{cl}
(\texttt{c}) require; its value is moved in and out of that register and the
template renders it at the operand's width (\texttt{\%eax}, \texttt{\%cl}, \ldots).
Because \texttt{\%rbx} is callee-saved, an asm that pins an operand to it is
bracketed with \texttt{pushq}/\texttt{popq \%rbx} so the caller's value survives;
the others are caller-saved and need no save.  A specific register can also be
the register \emph{alternative} of a multi-alternative constraint whose other
alternative is an immediate: the \texttt{in}/\texttt{out} port constraint
\texttt{"Nd"} means an immediate port or \texttt{\%dx}, so a non-constant port
must land in \texttt{\%dx}, not a positional register.  When the constraint that
reached the register path carries no general-register letter
(\texttt{r}/\texttt{q}/\texttt{g}/\texttt{p}) but does name a specific one, that
specific register is used.  A condition-code output
(\texttt{"=@@cc\meta{cond}"}, as \texttt{test\_and\_set\_bit}'s \texttt{"=@@ccc"})
takes no register and is not named in the template: after the body a
\texttt{set\meta{cond}} captures the still-live flag into \texttt{\%al}, which is
zero-extended and stored---the condition suffix maps straight onto the
\texttt{setCC} mnemonic (\texttt{c}, \texttt{z}, \texttt{l}, \ldots).  Register
outputs are stored first, with plain \texttt{mov}s that leave the flags intact
for these.  A matching constraint does not
take a register of its own: it \emph{aliases} the tied operand's register
(specific one included), which is exactly the register-tie GCC guarantees so a
value seeded through one operand can be read or written as another---as in
\texttt{arch/x86}'s \texttt{variable\_ffs},
\verb|bsfl %1,%0 : "=r"(r) : "rm"(x), "0"(-1)|, where \texttt{-1} is loaded into
the output's register so a zero input leaves it unchanged.  Each input value is
loaded into its assigned register first; then the template is pasted verbatim except that
\verb|%%| collapses to a literal \texttt{\%} and \verb|%N| (optionally
size-prefixed \verb|%bN/%wN/%kN/%qN|) expands to operand $N$'s register at the
operand's own byte width, so an \texttt{int} operand emits \texttt{\%r8d} while a
\texttt{long} emits \texttt{\%r8}; finally each output register is stored back
through \texttt{\%r11} to the operand's address at that width.  Because those
operand registers live in the AST node's operand list rather than in the IR
instruction's source fields, the optimiser must renumber and mark them
explicitly (see the optimiser's CSE and dead-code passes)---otherwise
store-to-load forwarding would leave an input reading a swept load's slot.

A related modifier is \verb|%V| (and its lowercase \verb|%v|): it prints a
\emph{register} operand's name without the leading \texttt{\%}, so that a
register can be spliced into a symbol name.  The kernel's retpoline
\texttt{CALL\_NOSPEC} uses \verb|call __x86_indirect_thunk_%V[thunk_target]| with
\verb|[thunk_target] "rm"(addr)|: kcc holds \texttt{addr} in a general register
\texttt{rN}, and \verb|%V| renders it as the bare \texttt{rN}, forming
\texttt{\_\_x86\_indirect\_thunk\_r11}---a real per-register thunk symbol---rather
than the un-substituted \verb|%V[thunk_target]| the assembler rejects.  A single
\texttt{bare} flag, set when the modifier is seen, tells the register printer to
drop the \texttt{\%}.

The \verb|%p|, \verb|%P| and \verb|%c| operand modifiers print an operand
\emph{bare}: a symbol or constant without the \texttt{\$}/register decoration, so
\verb|call %P[func]| becomes a direct \texttt{call func}, \verb|movq %P[var], %r8|
loads the object's address by name, and \verb|.4byte %c[feature]| emits the bare
feature number.  The lowercase \verb|%p| is GCC's spelling for the same
raw-operand print and is what the kernel's RIP-relative accessors use---\verb|_ASM_RIP|
expands to \verb|%p[sym](%%rip)|, which must render as \texttt{sym(\%rip)}, not a
register---so it is treated identically here.  The kernel leans on these in
\texttt{ALTERNATIVE} (\verb|call %P[old]| /
\verb|call %P[new]|) and percpu templates, where the operand is a
\texttt{"i"}-constrained function or a memory object, not a plain value.  kcc
materialises every asm operand into a register or immediate and so would
otherwise have lost the name; to support \verb|%P| the operand lowering records
the emit-name of a symbolic operand (a function or file-scope object, or the
address of one) alongside the materialised register---\texttt{F1} holds the
name and a marker bit in \texttt{F2} flags its presence.  Rendering a
\verb|%P| reference then emits that bare symbol; for a \verb|%P| operand with no
symbol it falls back to the bare value (a constant), a memory reference
\verb|(%reg)| (a memory operand, as in the percpu read
\verb|movq %%gs:%P[var], %0| \(\rightarrow\) \verb|movq %gs:(%r9), ...|), or the
raw address register (anything else).  This makes the
\texttt{ALTERNATIVE}/percpu translation units assemble; note that kcc does not
emit the \texttt{.altinstructions} metadata that would patch the alternative at
run time, so only the default (\texttt{oldinstr}) path is exercised.

A \emph{plain} (non-modifier) \verb|%N| on a symbolic memory operand needs the
same by-name treatment.  The commonest percpu read spells its access
\verb|%%gs:%1| with \verb|"m"(var)|---no \verb|%p| modifier and no literal
\verb|(%%rip)| in the template---so \verb|%1| must itself expand to the object
RIP-relative, \texttt{var(\%rip)}, giving \texttt{\%gs:var(\%rip)} exactly as GCC
renders an \texttt{"m"} operand.  The lowering already recorded the operand's
symbol (its \texttt{"m"} address register is left unmaterialised), so a symbolic
\texttt{"m"} operand keeps its \texttt{ismem} flag and, ahead of the generic
\verb|(%reg)| memory case, a plain reference prints \texttt{sym+off(\%rip)}
rather than an empty-register \verb|(%r8)|.  This is what lets the many
\texttt{lib/}, \texttt{kernel/}, and \texttt{mm/} translation units whose percpu
and \texttt{this\_cpu} idioms name a file-scope object through \texttt{"m"}
assemble once the operand count no longer caps them.

Floating point is a first-class citizen of both the call boundary and the return
path.  \texttt{x86\_marshal} classifies each outgoing argument the System~V
way---class-1 (\texttt{float}/\texttt{double}) values into \texttt{\%xmm0-7};
a small aggregate travelling by value into one (class~2, $\le$8~bytes) or two
(class~3, 9--16~bytes) integer registers, its words loaded from the address
vreg; everything else into \texttt{\%rdi..\%r9}; and the overflow of a bank onto
the outgoing stack in argument order---and records the vector-register count so
the call site can load \texttt{\%al} (mandatory when the callee is variadic).
Because a class-3 aggregate occupies two parameter vregs (matching the IR
builder's width count), \texttt{x86\_spill\_params} advances a separate
\texttt{base} vreg cursor and spills two registers for it---getting this wrong
dropped the sixth register of SQLite's \texttt{yy\_reduce} (its trailing
\texttt{Parse~*} after a 16-byte \texttt{Token} argument), leaving a garbage
pointer.  Both \texttt{IR\_RET} and the call-result store route a
floating-point value through
\texttt{\%xmm0} rather than \texttt{\%rax}.

@l c
@d Selfhost: emit_x86 dispatch @{
/* Extended inline asm: operand k is materialised in %r8+k (all caller-saved);
   %r11 stays free as the scratch that carries an output operand's address. The
   supported subset is `r`/`=r`/`+r` operands, up to three of them. */
/* Up to six positional register operands: r8-r10 are caller-saved; r12-r14 are
   callee-saved and get a push/pop bracket when used.  r11 stays scratch. */
static const char *const asmregs[6] = { s_r8, s_r9, s_r10, s_r12, s_r13, s_r14 };
static const unsigned long asmregnum[6] = { 8, 9, 10, 12, 13, 14 };
/* Emit operand k's register at the requested byte width: %r8 / %r8d / %r8w /
   %r8b for 8 / 4 / 2 / 1. */
static void x86_asm_wreg_b(unsigned long k, unsigned long size, int bare) {
    if (!bare) kcc_as_ch('%');                    /* %V modifier prints the bare name */
    kcc_as_ch('r'); kcc_as_dec(k < 6 ? asmregnum[k] : 8 + k);
    if (size == 4) kcc_as_ch('d');
    else if (size == 2) kcc_as_ch('w');
    else if (size == 1) kcc_as_ch('b');
}
static void x86_asm_wreg(unsigned long k, unsigned long size) {
    x86_asm_wreg_b(k, size, 0);
}
static unsigned long x86_asm_opsize(void *node, unsigned long num) {
    void *op = (void *)IL(node, AST_F2);
    for (unsigned long j = 0; op && j < num; j++) op = (void *)IL(op, AST_F4);
    if (!op) return 8;
    /* mask off the top-two marker bits (63 = immediate, 62 = symbolic) so they
       neither flip the F2-vs-F3 selection nor bleed into the size in bits 32+ */
    unsigned long f2 = IL(op, AST_F2) & ~(7UL << 61);
    unsigned long e = f2 ? f2 : (IL(op, AST_F3) & ~(7UL << 61));
    unsigned long sz = e >> 32;
    return sz ? sz : 8;
}
/* The 64-bit name of a specific-register constraint (a/b/c/d/S/D), used to
   move an operand's value in or out of that register. */
static const char *x86_spec64(char rc) {
    if (rc == 'a') return s_rax;
    if (rc == 'b') return s_rbx;
    if (rc == 'c') return s_rcx;
    if (rc == 'd') return s_rdx;
    if (rc == 'S') return s_rsi;
    return s_rdi;                                 /* 'D' */
}
/* Emit a specific register at the requested byte width, e.g. 'a'/4 -> %eax,
   'c'/1 -> %cl, 'S'/2 -> %si. */
static void x86_spec_reg_b(char rc, unsigned long size, int bare) {
    if (!bare) kcc_as_ch('%');                    /* %V: bare name (rax, not %rax) */
    if (rc == 'a' || rc == 'b' || rc == 'c' || rc == 'd') {
        if (size == 1) { kcc_as_ch(rc); kcc_as_ch('l'); return; }
        if (size == 8) kcc_as_ch('r');
        else if (size == 4) kcc_as_ch('e');
        kcc_as_ch(rc); kcc_as_ch('x');
    } else {                                      /* S -> si, D -> di */
        if (size == 8) kcc_as_ch('r');
        else if (size == 4) kcc_as_ch('e');
        kcc_as_ch(rc == 'S' ? 's' : 'd'); kcc_as_ch('i');
        if (size == 1) kcc_as_ch('l');
    }
}
static void x86_spec_reg(char rc, unsigned long size) {
    x86_spec_reg_b(rc, size, 0);
}
/* An `asm goto' label reference (%lN or %l[name]) expands to the target
   block's assembly label.  The goto labels hang off the AST node's F3 chain,
   each carrying its resolved block in F2. */
static void x86_asm_gotobb(void *bb) {
    if (bb) { kcc_as_str(s_bb); kcc_as_dec(IL(bb, BB_ID)); }
}
static void x86_asm_label_idx(void *node, unsigned long idx) {
    void *l = (void *)IL(node, AST_F3);
    for (unsigned long j = 0; l && j < idx; j++) l = (void *)IL(l, AST_F4);
    if (l) x86_asm_gotobb((void *)IL(l, AST_F2));
}
static void x86_asm_label_name(void *node, const char *nm, unsigned long nlen) {
    for (void *l = (void *)IL(node, AST_F3); l; l = (void *)IL(l, AST_F4)) {
        const char *ln = (const char *)IL(l, AST_F0);
        unsigned long j = 0;
        while (j < nlen && ln[j] && ln[j] == nm[j]) j++;
        if (j == nlen && ln[j] == 0) { x86_asm_gotobb((void *)IL(l, AST_F2)); return; }
    }
}
/* Resolve a symbolic operand reference %[name] to its operand index.  The
   parser stores each operand's `[name]' in the operand node's F1 (a field the
   constraint length no longer needs, since the string is NUL-terminated).  An
   immediate keeps its name in F1 too (its value lives in F3), so a named
   immediate like the kernel's `%[bitnum]` resolves here just like any other. */
static unsigned long x86_asm_opnum(void *node, const char *nm, unsigned long nlen) {
    unsigned long k = 0;
    for (void *op = (void *)IL(node, AST_F2); op; op = (void *)IL(op, AST_F4), k++) {
        const char *on = (const char *)IL(op, AST_F1);
        if (!on) continue;
        unsigned long j = 0;
        while (j < nlen && on[j] && on[j] == nm[j]) j++;
        if (j == nlen && on[j] == 0) return k;
    }
    return k;                                          /* not found: out of range */
}
static void x86_emit_asm(void *i) {
    void *node = (void *)IL(i, IR_TYPE);         /* the AST_ASM_STMT */
    /* regof[k] is the compact physical-register slot (0..5, indexing asmregnum)
       that operand k occupies: the next free slot for an ordinary register or
       memory operand, or the tied operand's slot for a matching constraint
       ("0", "1", ...), which shares that operand's register (the register-alias
       GCC guarantees so arch code can seed a register through one operand and
       read/write it as another, e.g. `bsfl %1,%0 : "=r"(r) : "rm"(x), "0"(-1)`).
       Operands that render inline---immediates, %P symbols, string literals,
       condition-code outputs---draw no slot, so nphys (not the operand index)
       measures how many of the six physical registers are in use. */
    unsigned long regof[16];
    unsigned long ismem[16];                       /* operand k is a memory ref */
    unsigned long isimm[16];                        /* operand k is an immediate */
    unsigned long immval[16];                        /* its constant value */
    unsigned long issym[16];                         /* operand k names a symbol (for %P) */
    const char *symname[16];                         /* its emit-name */
    long symoff[16];                                 /* +byte offset for name+off */
    unsigned long isstr[16];                         /* operand k is a string literal */
    const char *strbytes[16];                        /* its bytes */
    unsigned long strlen_[16];                        /* its length */
    unsigned long isaddr[16];                         /* operand k is an address ("p"): %P -> (%reg) */
    char spec[16];                                  /* specific-register letter or 0 */
    char isflag[16];                                /* condition-code output (=@@cc) */
    const char *flagcond[16];                        /* its setCC suffix */
    unsigned long uses_rbx = 0;                    /* any operand pinned to %rbx */
    unsigned long max_areg = 0;                    /* highest compact register slot used */
    unsigned long nphys = 0;                        /* next free physical asm register (0..5) */
    unsigned long nop = 0;
    for (void *op = (void *)IL(node, AST_F2); op; op = (void *)IL(op, AST_F4)) {
        if (nop >= 16) { kcc_io_err(s_unsup); kcc_io_flush(); kcc_sys_exit(1); }
        const char *c = (const char *)IL(op, AST_F0);
        char ch = c[0]; if (ch == '=' || ch == '+') ch = c[1];
        if (ch == '&') ch = c[2];                  /* early-clobber: ignored (each
                                                      operand already has its own reg) */
        ismem[nop] = 0;
        isaddr[nop] = (ch == 'p');                 /* "p": an address held in a register */
        spec[nop] = 0;
        isflag[nop] = 0;
        /* `=@@cc<cond>`: a condition-code output.  It takes no register and is
           not named in the template; after the asm a setCC captures the flag. */
        if (c[0] == '=' && c[1] == '@@' && c[2] == 'c' && c[3] == 'c') {
            isflag[nop] = 1;
            isimm[nop] = 0;
            flagcond[nop] = c + 4;
            regof[nop] = nop;
            nop++;
            continue;
        }
        /* the IR marks a resolved immediate with the top bit of AST_F2 and puts
           the value in AST_F1; that decision (constant vs register) already
           accounts for `Ir`-style alternatives. */
        isimm[nop] = (IL(op, AST_F2) >> 63) & 1;
        immval[nop] = IL(op, AST_F3);          /* the constant value (F1 stays the name) */
        issym[nop] = (IL(op, AST_F2) >> 62) & 1;    /* symbolic operand: name in COL (for %P) */
        symname[nop] = issym[nop] ? (const char *)IL(op, AST_COL) : 0;
        symoff[nop] = issym[nop] ? (long)IL(op, AST_F3) : 0;
        isstr[nop] = (IL(op, AST_F2) >> 61) & 1;    /* string-literal operand: bytes in COL */
        strbytes[nop] = isstr[nop] ? (const char *)IL(op, AST_COL) : 0;
        strlen_[nop] = isstr[nop] ? IL(op, AST_F3) : 0;
        regof[nop] = 0;
        /* Only operands that occupy one of the six physical asm registers
           (asmregnum) draw from the compact pool; an immediate/symbolic/string
           operand renders as `$value'/`name'/`.Lstr' and takes none, so a
           template may name far more than six operands as long as at most six
           need a register. */
        unsigned long wants_reg = 0;
        if (isimm[nop] || issym[nop] || isstr[nop]) {
            /* rendered inline; no register of its own.  A symbolic *memory*
               operand ("m"(sym)) still records ismem so a plain `%N' reference
               prints the object RIP-relative (`sym(%rip)') the way GCC does---
               the percpu read `%%gs:%1' with `"m"(var)' becomes `%gs:var(%rip)'
               rather than dereferencing a register kcc never loaded. */
            if (issym[nop] && ch == 'm') ismem[nop] = 1;
        } else if (ch >= '0' && ch <= '9') {
            unsigned long tied = (unsigned long)(ch - '0');
            if (tied >= nop) { kcc_io_err(s_unsup); kcc_io_flush(); kcc_sys_exit(1); }
            regof[nop] = regof[tied];            /* alias the tied operand's reg */
            spec[nop] = spec[tied];              /* ...including a specific one */
        } else if (ch == 'r' || ch == 'i' || ch == 'I' || ch == 'n' ||
                   ch == 'g' || ch == 'q' || ch == 'p' || ch == 'e' ||
                   ch == 'J' || ch == 'K' || ch == 'L' || ch == 'M' ||
                   ch == 'N' || ch == 'O' || ch == 'Z') {
            /* register.  An immediate-class letter that reached here (the IR did
               not mark the operand a constant) means a multi-alternative
               constraint like `"er"` or `"Ir"` whose register alternative is
               taken for a non-constant value.  `g` (general: reg/mem/imm) and
               `p` (address) admit a register, which is what kcc materialises the
               operand into; `q` (byte-addressable register) is any register on
               x86-64.  All are handled exactly like `r`.

               But a constraint whose only register alternative is a *specific*
               register---the x86 in/out port `"Nd"` (immediate or %dx)---must use
               that register for a non-constant value, not a positional one. */
            unsigned long has_gen = 0; char sp = 0;
            for (const char *cc = c; *cc; cc++) {
                if (*cc == 'r' || *cc == 'q' || *cc == 'g' || *cc == 'p') has_gen = 1;
                else if (!sp && (*cc == 'a' || *cc == 'b' || *cc == 'c' ||
                                 *cc == 'd' || *cc == 'S' || *cc == 'D')) sp = *cc;
            }
            if (!has_gen && sp) { spec[nop] = sp; if (sp == 'b') uses_rbx = 1; }
            else wants_reg = 1;                  /* a general register from the pool */
        } else if (ch == 'a' || ch == 'b' || ch == 'c' || ch == 'd' ||
                   ch == 'S' || ch == 'D') {
            /* pinned to a specific register (mul/div use a/d, cpuid a/b/c/d,
               shift-by-cl uses c, string ops S/D). */
            spec[nop] = ch;
            if (ch == 'b') uses_rbx = 1;          /* callee-saved: save around */
        } else if (ch == 'm') {
            /* memory operand: its register holds the object's *address*, and
               the template references it as %r8+k in parentheses. */
            ismem[nop] = 1;
            wants_reg = 1;
        } else { kcc_io_err(s_unsup); kcc_io_flush(); kcc_sys_exit(1); }
        if (wants_reg) {                          /* draw the next physical register */
            if (nphys >= 6) { kcc_io_err(s_unsup); kcc_io_flush(); kcc_sys_exit(1); }
            regof[nop] = nphys++;
        }
        /* track the highest register slot used (for callee-save push/pop) */
        if (!spec[nop] && !isimm[nop] && !isflag[nop] && regof[nop] > max_areg)
            max_areg = regof[nop];
        nop++;
    }
    /* Callee-saved registers used as asm operands (rbx, and r12-r14 once the
       positional operands spill past r10) are preserved around the body. */
    if (uses_rbx) kcc_as_str(s_push_rbx);
    if (max_areg >= 3) kcc_as_str(s_push_r12);
    if (max_areg >= 4) kcc_as_str(s_push_r13);
    if (max_areg >= 5) kcc_as_str(s_push_r14);
    /* load each operand's register: an input's value, or a memory operand's
       address (held in AST_F3 exactly like an output's address).  Immediates
       need no register. */
    unsigned long k = 0;
    for (void *op = (void *)IL(node, AST_F2); op; op = (void *)IL(op, AST_F4), k++) {
        if (isimm[k] || isflag[k] || issym[k] || isstr[k]) continue;
        const char *dst = spec[k] ? x86_spec64(spec[k]) : asmregs[regof[k]];
        if (ismem[k]) {
            unsigned long a = IL(op, AST_F3) & 0xffffffff;
            if (a) x86_load(a - 1, dst);
        } else {
            unsigned long v = IL(op, AST_F2) & 0xffffffff;
            if (v) x86_load(v - 1, dst);
        }
    }
    /* paste the template, rewriting %% -> % and %[bwkq]N -> operand register */
    const char *t = (const char *)IL(i, IR_SRC1);
    unsigned long len = IL(i, IR_SRC2);
    kcc_as_ch('\t');
    for (unsigned long p = 0; p < len; p++) {
        char c = t[p];
        if (c != '%') { kcc_as_ch(c); continue; }
        if (p + 1 >= len) { kcc_as_ch('%'); break; }
        char nx = t[p + 1];
        if (nx == '%') { kcc_as_ch('%'); p++; continue; }
        if (nx == 'l') {                         /* asm-goto label: %lN or %l[name] */
            p++;                                 /* consume 'l' */
            if (p + 1 < len && t[p + 1] == '[') {
                p++;                             /* consume '[' */
                unsigned long ns = p + 1;
                while (p + 1 < len && t[p + 1] != ']') p++;
                x86_asm_label_name(node, t + ns, (p + 1) - ns);
                if (p + 1 < len) p++;            /* consume ']' */
            } else {
                unsigned long lnum = 0;
                while (p + 1 < len && t[p + 1] >= '0' && t[p + 1] <= '9') {
                    lnum = lnum * 10 + (t[p + 1] - '0'); p++;
                }
                /* label numbers continue from the input/output operands */
                x86_asm_label_idx(node, lnum >= nop ? lnum - nop : lnum);
            }
            continue;
        }
        unsigned long sz = 0;                    /* 0 = the operand's own size */
        unsigned long raw = 0;                   /* %p/%P/%c: render the operand bare (symbol/const) */
        unsigned long bare = 0;                  /* %V/%v: a register's name without the `%' */
        if (nx == 'p' || nx == 'P' || nx == 'c') { raw = 1; p++; nx = t[p + 1]; }
        else if (nx == 'V' || nx == 'v') { bare = 1; p++; nx = t[p + 1]; }
        else if (nx == 'b') { sz = 1; p++; nx = t[p + 1]; }
        else if (nx == 'w') { sz = 2; p++; nx = t[p + 1]; }
        else if (nx == 'k') { sz = 4; p++; nx = t[p + 1]; }
        else if (nx == 'q') { sz = 8; p++; nx = t[p + 1]; }
        /* An operand reference: a number (%0) or a symbolic name (%[name]). */
        long num = -1;
        if (nx >= '0' && nx <= '9') {
            unsigned long n = 0;
            while (p + 1 < len && t[p + 1] >= '0' && t[p + 1] <= '9') { n = n * 10 + (t[p + 1] - '0'); p++; }
            num = (long)n;
        } else if (nx == '[') {
            p++;                                 /* consume '[' */
            unsigned long ns = p + 1;
            while (p + 1 < len && t[p + 1] != ']') p++;
            num = (long)x86_asm_opnum(node, t + ns, (p + 1) - ns);
            if (p + 1 < len) p++;                /* consume ']' */
        }
        if (num < 0) { kcc_as_ch('%'); continue; }
        unsigned long unum = (unsigned long)num;
        unsigned long reg = (unum < nop) ? regof[unum] : unum;
        unsigned long owidth = sz ? sz : x86_asm_opsize(node, unum);
        if (unum < nop && isstr[unum]) {
            /* string literal: emit it to .rodata and reference the label, both for
               a bare `%c[f]' (a __bug_table `.long %c0 - .') and a plain `%0'. */
            unsigned long sid = IL(kcc_x86_strs, VEC_COUNT);
            unsigned long entry[2];
            entry[0] = (unsigned long)strbytes[unum];
            entry[1] = strlen_[unum];
            kcc_vec_push(kcc_x86_strs, entry);
            kcc_as_str(s_strlbl); kcc_as_dec(sid);
        } else if (raw && unum < nop && issym[unum]) {
            x86_sym(symname[unum]);                     /* %P[f] -> bare symbol: call f */
            if (symoff[unum] > 0) {                     /* &arr[k] / &s.field -> name+off */
                kcc_as_ch('+'); kcc_as_dec((unsigned long)symoff[unum]);
            } else if (symoff[unum] < 0) {
                kcc_as_ch('-'); kcc_as_dec((unsigned long)(-symoff[unum]));
            }
        } else if (raw && unum < nop && isimm[unum]) {
            kcc_as_dec(immval[unum]);                   /* %P on a constant -> bare value, no $ */
        } else if (raw && unum < nop && (ismem[unum] || isaddr[unum])) {
            /* %P on a memory ("m") or address ("p") operand---the kernel's percpu
               read `%%gs:%P[var]` with `[var] "p"(&var)`: kcc holds the object's
               address in a register, so a memory reference `(%reg)` is the
               bare-pointer form.  `%gs:(%r9)` assembles and, like GCC's
               `%gs:var`, dereferences the object. */
            kcc_as_ch('('); x86_asm_wreg(reg, 8); kcc_as_ch(')');
        } else if (raw && unum < nop) {
            x86_asm_wreg(reg, 8);                       /* %P without a symbol -> bare address register */
        } else if (unum < nop && isimm[unum]) {
            kcc_as_ch('$'); kcc_as_dec(immval[unum]);   /* $value */
        } else if (unum < nop && issym[unum]) {
            /* plain `%N' on a symbolic memory operand ("m"(var)): the object
               itself, RIP-relative, exactly as GCC renders an "m" operand.  With
               the template's literal `%%gs:' this yields the kernel percpu form
               `%gs:var(%rip)'.  No register was loaded for it (it renders inline),
               so this must precede the generic memory case, which would emit an
               empty-register `(%r8)'. */
            x86_sym(symname[unum]);
            if (symoff[unum] > 0) { kcc_as_ch('+'); kcc_as_dec((unsigned long)symoff[unum]); }
            else if (symoff[unum] < 0) { kcc_as_ch('-'); kcc_as_dec((unsigned long)(-symoff[unum])); }
            kcc_as_str(s_rip);
        } else if (unum < nop && ismem[unum]) {
            kcc_as_ch('('); x86_asm_wreg(reg, 8); kcc_as_ch(')');  /* (%reg) */
        } else if (unum < nop && spec[unum]) {
            x86_spec_reg_b(spec[unum], owidth, (int)bare);
        } else {
            x86_asm_wreg_b(reg, owidth, (int)bare);  /* %V -> bare name, for
                `__x86_indirect_thunk_%V[target]' (retpoline CALL_NOSPEC) */
        }
    }
    kcc_as_ch('\n');
    /* Store the register outputs first; these are all mov instructions, which
       leave the flags the asm set intact for the condition-code outputs below
       (and store any %rax result before setCC would overwrite %al). */
    k = 0;
    for (void *op = (void *)IL(node, AST_F2); op; op = (void *)IL(op, AST_F4), k++) {
        if (ismem[k] || isimm[k] || isflag[k] || issym[k] || isstr[k]) continue;
        unsigned long ah = IL(op, AST_F3);
        unsigned long a = ah & 0xffffffff;
        if (!a) continue;
        x86_load(a - 1, s_r11);                  /* r11 = &output */
        unsigned long sz = ah >> 32; if (!sz) sz = 8;
        kcc_as_str(sz == 1 ? s_movb : sz == 2 ? s_movw : sz == 4 ? s_movl : s_movq);
        if (spec[k]) x86_spec_reg(spec[k], sz);
        else x86_asm_wreg(regof[k], sz);
        kcc_as_str(s_comma); kcc_as_str(s_pr11); kcc_as_ch('\n');
    }
    /* Condition-code outputs: setCC captures the still-live flag into %al,
       zero-extend, and store it at the destination's width. */
    k = 0;
    for (void *op = (void *)IL(node, AST_F2); op; op = (void *)IL(op, AST_F4), k++) {
        if (!isflag[k]) continue;
        unsigned long ah = IL(op, AST_F3);
        unsigned long a = ah & 0xffffffff;
        if (!a) continue;
        kcc_as_str(s_setcc); kcc_as_str(flagcond[k]); kcc_as_str(s_tab_al);
        kcc_as_str(s_movzx_al);
        unsigned long sz = ah >> 32; if (!sz) sz = 4;
        x86_load(a - 1, s_r11);
        kcc_as_str(sz == 1 ? s_movb : sz == 2 ? s_movw : sz == 4 ? s_movl : s_movq);
        x86_spec_reg('a', sz); kcc_as_str(s_comma); kcc_as_str(s_pr11); kcc_as_ch('\n');
    }
    if (max_areg >= 5) kcc_as_str(s_pop_r14);
    if (max_areg >= 4) kcc_as_str(s_pop_r13);
    if (max_areg >= 3) kcc_as_str(s_pop_r12);
    if (uses_rbx) kcc_as_str(s_pop_rbx);
}
void kcc_x86_sel(void *i) {
    unsigned long op = IL(i, IR_OP);
    switch (op) {
    case IR_CONST:
        kcc_as_str(s_movabsq); kcc_as_dec(IL(i, IR_SRC1)); kcc_as_str(s_c_r10);
        x86_store(IL(i, IR_DEST), s_r10);
        return;
    case IR_ALLOCA: {
        unsigned long off = IL(i, IR_SRC2);
        unsigned long size = IL(i, IR_SRC1);
        if (!size) size = 1;
        unsigned long d = (kcc_x86_vreg_n + off + size) * 8;
        kcc_as_str(s_leaq); x86_disp(d); kcc_as_str(s_c_r10);
        x86_store(IL(i, IR_DEST), s_r10);
        return;
    }
    case IR_RET: {
        struct Type *ty = (struct Type *)IL(i, IR_TYPE);
        if (ty && is_fp_type(ty)) x86_fpload(IL(i, IR_SRC1), s_cx0_nl);
        else if (ty && ty->kind != TY_VOID) x86_load(IL(i, IR_SRC1), s_rax);
        kcc_as_str(s_leave); kcc_as_str(s_retq);
        return;
    }
    case IR_LOAD: {
        unsigned long sz = IL(i, IR_SRC2);
        if (sz == 1) x86_memload(i, s_movzbq, s_pr11_r10);
        else if (sz == 2) x86_memload(i, s_movzwq, s_pr11_r10);
        else if (sz == 4) x86_memload(i, s_movl, s_pr11_r10d);
        else if (sz == 5) x86_memload(i, s_movsbq, s_pr11_r10);
        else if (sz == 6) x86_memload(i, s_movswq, s_pr11_r10);
        else if (sz == 7) x86_memload(i, s_movslq, s_pr11_r10);
        else if (sz == 8) {                      /* single float: movss + widen */
            x86_load(IL(i, IR_SRC1), s_r11);
            kcc_as_str(s_movss); kcc_as_str(s_px11_x0);
            kcc_as_str(s_cvtss2sd);
            x86_fpstore(IL(i, IR_DEST));
        }
        else x86_memload(i, s_movq, s_pr11_r10);
        return;
    }
    case IR_STORE: {
        unsigned long sz = IL(i, IR_DEST);
        if (sz == 1) x86_memstore(i, s_movb, s_r10b_pr11);
        else if (sz == 2) x86_memstore(i, s_movw, s_r10w_pr11);
        else if (sz == 4) x86_memstore(i, s_movl, s_r10d_pr11);
        else if (sz == 8) {                      /* single float: narrow + movss */
            x86_fpload(IL(i, IR_SRC1), s_cx0_nl);
            kcc_as_str(s_cvtsd2ss);
            x86_load(IL(i, IR_SRC2), s_r11);
            kcc_as_str(s_movss); kcc_as_str(s_x0_px11);
        }
        else x86_memstore(i, s_movq, s_r10_pr11);
        return;
    }
    /* A floating ADD/SUB/MUL/DIV (typed float/double) uses SSE; the shared
       IR_GEP that also lands on IR_ADD is integer address arithmetic. */
    case IR_ADD:
        if (is_fp_type((void *)IL(i, IR_TYPE))) x86_fpbinop(i, s_addsd);
        else x86_binop(i, s_addq);
        return;
    case IR_GEP: x86_binop(i, s_addq); return;
    case IR_SUB:
        if (is_fp_type((void *)IL(i, IR_TYPE))) x86_fpbinop(i, s_subsd);
        else x86_binop(i, s_subq);
        return;
    case IR_MUL:
        if (is_fp_type((void *)IL(i, IR_TYPE))) x86_fpbinop(i, s_mulsd);
        else x86_binop(i, s_imulq);
        return;
    case IR_AND: x86_binop(i, s_andq); return;
    case IR_OR: x86_binop(i, s_orq); return;
    case IR_XOR: x86_binop(i, s_xorq); return;
    case IR_NEG: x86_unop(i, s_negq); return;
    case IR_NOT: x86_unop(i, s_notq); return;
    case IR_SHL: x86_shift(i, s_shlq); return;
    case IR_LSHR: x86_shift(i, s_shrq); return;
    case IR_ASHR: x86_shift(i, s_sarq); return;
    case IR_SDIV:
        if (is_fp_type((void *)IL(i, IR_TYPE))) x86_fpbinop(i, s_divsd);
        else x86_divop(i, 1, 0);
        return;
    /* Floating-point conversions (rung 4); UITOFP shares the signed cvtsi2sd,
       as kcc's own source only converts signed integers to floating. */
    case IR_SITOFP: case IR_UITOFP:
        x86_load(IL(i, IR_SRC1), s_r10);
        kcc_as_str(s_cvtsi2sd);
        x86_fpstore(IL(i, IR_DEST));
        return;
    case IR_FPTOSI:
        x86_fpload(IL(i, IR_SRC1), s_cx0_nl);
        kcc_as_str(s_cvttsd2si);
        x86_store(IL(i, IR_DEST), s_r10);
        return;
    case IR_FPROUND:
        x86_fpload(IL(i, IR_SRC1), s_cx0_nl);
        kcc_as_str(s_cvtsd2ss);
        kcc_as_str(s_cvtss2sd);
        x86_fpstore(IL(i, IR_DEST));
        return;
    case IR_UDIV: x86_divop(i, 0, 0); return;
    case IR_SMOD: x86_divop(i, 1, 1); return;
    case IR_UMOD: x86_divop(i, 0, 1); return;
    case IR_SEXT: x86_conv(i, IL(i, IR_SRC2), 1); return;
    case IR_ZEXT: x86_conv(i, IL(i, IR_SRC2), 0); return;
    case IR_TRUNC: {
        struct Type *ty = (struct Type *)IL(i, IR_TYPE);
        x86_conv(i, ty ? ty->size : 8, 0);
        return;
    }
    case IR_BITCAST: x86_conv(i, 8, 0); return;
    case IR_CMP_EQ: x86_cmp(i, s_sete); return;
    case IR_CMP_NE: x86_cmp(i, s_setne); return;
    case IR_CMP_SLT: x86_cmp(i, s_setl); return;
    case IR_CMP_SLE: x86_cmp(i, s_setle); return;
    case IR_CMP_SGT: x86_cmp(i, s_setg); return;
    case IR_CMP_SGE: x86_cmp(i, s_setge); return;
    case IR_CMP_ULT: x86_cmp(i, s_setb); return;
    case IR_CMP_ULE: x86_cmp(i, s_setbe); return;
    case IR_BR:
        kcc_as_str(s_jmp); x86_bblabel(IL(i, IR_SRC1)); kcc_as_ch('\n');
        return;
    case IR_LADDR:                               /* &&label → leaq .LkccbbN(%rip) */
        kcc_as_str(s_leaq); x86_bblabel(IL(i, IR_SRC1)); kcc_as_str(s_rip_r10);
        x86_store(IL(i, IR_DEST), s_r10);
        return;
    case IR_BR_IND:                              /* goto *reg → jmp *%r10 */
        x86_load(IL(i, IR_SRC1), s_r10);
        kcc_as_str(s_jmp_ind_r10);
        return;
    case IR_BR_COND:
        x86_load(IL(i, IR_DEST), s_r10);
        kcc_as_str(s_test_r10);
        kcc_as_str(s_jne); x86_bblabel(IL(i, IR_SRC1)); kcc_as_ch('\n');
        kcc_as_str(s_jmp); x86_bblabel(IL(i, IR_SRC2)); kcc_as_ch('\n');
        return;
    case IR_GLOBAL_REF:
        if (kcc_x86_os) {                        /* Linux: leaq name(%rip) */
            kcc_as_str(s_leaq); x86_sym((const char *)IL(i, IR_SRC1)); kcc_as_str(s_rip_r10);
        } else {                                 /* Darwin: movq name@@GOTPCREL(%rip) */
            kcc_as_str(s_movq); x86_sym((const char *)IL(i, IR_SRC1)); kcc_as_str(s_got_r10);
        }
        x86_store(IL(i, IR_DEST), s_r10);
        return;
    case IR_STRING_LIT: {
        unsigned long id = IL(kcc_x86_strs, VEC_COUNT);
        unsigned long entry[2];
        entry[0] = IL(i, IR_SRC1);
        entry[1] = IL(i, IR_SRC2);
        kcc_vec_push(kcc_x86_strs, entry);
        kcc_as_str(s_leaq); kcc_as_str(s_strlbl); kcc_as_dec(id); kcc_as_str(s_rip_r10);
        x86_store(IL(i, IR_DEST), s_r10);
        return;
    }
    case IR_CALL: {
        unsigned long adj = x86_call_args((unsigned long *)IL(i, IR_SRC2));
        x86_set_al();
        kcc_as_str(s_call); x86_sym((const char *)IL(i, IR_SRC1)); kcc_as_ch('\n');
        if (adj) { kcc_as_str(s_add_rsp); kcc_as_dec(adj); kcc_as_str(s_sp_nl); }
        {
            struct Type *ty = (struct Type *)IL(i, IR_TYPE);
            if (ty && is_fp_type(ty)) x86_fpstore(IL(i, IR_DEST));
            else if (ty && ty->kind != TY_VOID) x86_store(IL(i, IR_DEST), s_rax);
        }
        return;
    }
    case IR_CALL_IND: {
        unsigned long adj = x86_call_args((unsigned long *)IL(i, IR_SRC2));
        x86_load(IL(i, IR_SRC1), s_r11);
        x86_set_al();
        kcc_as_str(s_call_r11);
        if (adj) { kcc_as_str(s_add_rsp); kcc_as_dec(adj); kcc_as_str(s_sp_nl); }
        {
            struct Type *ty = (struct Type *)IL(i, IR_TYPE);
            if (ty && is_fp_type(ty)) x86_fpstore(IL(i, IR_DEST));
            else if (ty && ty->kind != TY_VOID) x86_store(IL(i, IR_DEST), s_rax);
        }
        return;
    }
    case IR_VA_START: {
        /* Build the System V va_list at SRC1 (its address).  SRC2 packs the
           named-argument counts: (named_fp << 8) | named_gp.  Layout (kcc-
           internal, 8-byte fields): [0] gp_offset, [8] fp_offset, [16]
           overflow_arg_area, [24] reg_save_area. */
        unsigned long named = IL(i, IR_SRC2);
        unsigned long ngp = named & 0xff, nfp = (named >> 8) & 0xff;
        x86_load(IL(i, IR_SRC1), s_r11);                  /* r11 = &va_list */
        kcc_as_str(s_movabsq); kcc_as_dec(ngp * 8); kcc_as_str(s_c_r10);
        kcc_as_str(s_movq); kcc_as_str(s_r10); kcc_as_str(s_comma); kcc_as_dec(0); kcc_as_str(s_pr11); kcc_as_ch('\n');
        kcc_as_str(s_movabsq); kcc_as_dec(nfp * 16); kcc_as_str(s_c_r10);
        kcc_as_str(s_movq); kcc_as_str(s_r10); kcc_as_str(s_comma); kcc_as_dec(8); kcc_as_str(s_pr11); kcc_as_ch('\n');
        kcc_as_str(s_leaq); kcc_as_dec(16); kcc_as_str(s_rbp); kcc_as_str(s_c_r10);   /* overflow = rbp+16 */
        kcc_as_str(s_movq); kcc_as_str(s_r10); kcc_as_str(s_comma); kcc_as_dec(16); kcc_as_str(s_pr11); kcc_as_ch('\n');
        kcc_as_str(s_leaq); x86_disp(kcc_x86_rsa_top); kcc_as_str(s_c_r10);           /* reg_save = rbp-rsa_top */
        kcc_as_str(s_movq); kcc_as_str(s_r10); kcc_as_str(s_comma); kcc_as_dec(24); kcc_as_str(s_pr11); kcc_as_ch('\n');
        return;
    }
    case IR_ASM:
        x86_emit_asm(i);
        return;
    case IR_NOP:
        return;
    default:
        kcc_io_err(s_unsup);
        kcc_io_flush();
        kcc_sys_exit(1);
    }
}
@}

\section{Frame, Parameters, and the Function Walk}

\texttt{x86\_prescan} assigns each \texttt{IR\_ALLOCA} its slot offset and returns
the total; \texttt{x86\_spill\_params} copies the incoming System~V registers
into their parameter vreg slots; \texttt{x86\_render\_text} walks the function
list, emitting the label, prologue, and each block's instructions.

The GNU linkage attributes the parser stashed in \texttt{kcc\_attr\_ht}
(Chapter~\ref{ch:self-hosting-declarations}) are honoured here.
\texttt{x86\_attr} looks a symbol up by name; a function so annotated is wrapped
in \verb|.section name,"ax",@@progbits| … \verb|.text| for
\texttt{\_\_attribute\_\_((section))} and headed by \verb|.weak| instead of
\verb|.globl| for \texttt{\_\_weak}.  A \texttt{\_\_weak} global takes a real
\texttt{.bss} definition rather than a \verb|.comm| (a common symbol may not
also be weak), and an \texttt{alias} target---whose declaration is bodiless and
so never reaches the IR---is emitted as a \verb|.set| by a separate walk of the
translation unit.

\subsection{Dead static-function elimination}

The kernel's bit and \texttt{cmpxchg} helpers are \texttt{static
\_\_always\_inline} functions that dispatch on a compile-time-constant operand
and emit a byte-sized inline-asm instruction only on the constant path---for
example \texttt{arch\_test\_bit} evaluates
\verb|__builtin_constant_p(nr) ? constant_test_bit(...) : variable_test_bit(...)|,
where \texttt{constant\_test\_bit} contains a \verb|testb %2,%1| valid only when
its operand folds to an immediate.  GCC always inlines these into a caller that
supplies a literal, so \texttt{nr} is constant, the ternary collapses to the
constant arm, and the byte instruction is emitted with a genuine immediate.

kcc does not inline, so it emits \texttt{arch\_test\_bit} as a stand-alone body
in which \texttt{nr} is a runtime parameter.  There the constant-condition fold
(Chapter~\ref{ch:self-hosting-ir}) is what saves us:
\verb|__builtin_constant_p(nr)| is an integer constant expression whose value is
$0$ because \texttt{nr} is not itself constant, so the ternary folds to the
\emph{variable} arm and no call to \texttt{constant\_test\_bit} is emitted.
\texttt{constant\_test\_bit} thereby becomes unreferenced---and, being
\texttt{static}, GCC would never emit it either.  We match that: before the
function walk we compute the set of \emph{referenced} names and skip any
\texttt{static} function whose name is absent from it, so its offending
\verb|testb| is never rendered.

The reference set is deliberately over-approximated for safety, because a
dropped-but-needed function would surface only at final link, which the
per-object sweep never reaches.  A name is referenced if it appears as the
callee of an \texttt{IR\_CALL} or the target of an \texttt{IR\_GLOBAL\_REF}
anywhere in \emph{any} function's IR (this captures both direct calls and
address-of-function), or as an identifier inside any file-scope initializer, or
as the target of an \texttt{alias} attribute.  A function is additionally kept
whenever it carries any linkage attribute (\texttt{section}, \texttt{weak},
\texttt{alias}), since such a function is placed or exported deliberately.  The
compiler's own self-host is the correctness gate: it uses many static helpers
and function-pointer tables, so the three-way byte-identical fixpoint would
break instantly if the analysis dropped a live function.

@l c
@d Selfhost: emit_x86 frame @{
static unsigned long x86_prescan(void *f) {
    unsigned long off = 0;
    void *blocks = (void *)IL(f, IRF_BLOCKS);
    if (!blocks) return 0;
    unsigned long nbb = IL(blocks, VEC_COUNT);
    for (unsigned long b = 0; b < nbb; b++) {
        void *bb = *(void **)kcc_vec_get(blocks, b);
        void *ins = (void *)IL(bb, BB_FIRST);
        while (ins) {
            if (IL(ins, IR_OP) == IR_ALLOCA) {
                IL(ins, IR_SRC2) = off;
                unsigned long sz = IL(ins, IR_SRC1);
                off += sz ? sz : 1;
            }
            ins = (void *)IL(ins, IR_NEXT);
        }
    }
    return off;
}

static void x86_spill_params(void *f) {
    unsigned long np = IL(f, IRF_PARAMS);
    void *cls = (void *)IL(f, IRF_PARAM_CLS);
    /* Mirror the caller's System~V classification into the parameter vreg slots.
       `base` is the vreg index (a class-3 aggregate occupies TWO consecutive
       vregs, matching the IR builder's width count); `ngp`/`nfp` track the
       register banks; overflow sits above the return address at 16(%rbp),
       24(%rbp), ... in parameter order. */
    unsigned long ngp = 0, nfp = 0, base = 0, soff = 16;
    for (unsigned long k = 0; k < np; k++) {
        unsigned long cl = cls ? ((unsigned long *)cls)[k] : 0;
        if (cl == 1) {                                  /* float/double → %xmm */
            if (nfp < 8) {
                kcc_as_str(s_movsd); kcc_as_str(xmmregs[nfp]); kcc_as_str(s_comma);
                x86_slot(base); kcc_as_ch('\n'); nfp++; base++; continue;
            }
        } else if (cl == 3) {                           /* 9-16B aggregate → 2 GP */
            if (ngp + 1 < 6) {
                x86_store(base, argregs[ngp]); x86_store(base + 1, argregs[ngp + 1]);
                ngp += 2; base += 2; continue;
            }
        } else if (ngp < 6) {                           /* GP / ptr / ≤8B aggregate */
            x86_store(base, argregs[ngp]); ngp++; base++; continue;
        }
        /* overflow: read from the caller's stack image */
        kcc_as_str(s_movq); kcc_as_dec(soff); kcc_as_str(s_rbp);
        kcc_as_str(s_comma); kcc_as_str(s_r10); kcc_as_ch('\n');
        x86_store(base, s_r10); soff += 8; base++;
        if (cl == 3) {
            kcc_as_str(s_movq); kcc_as_dec(soff); kcc_as_str(s_rbp);
            kcc_as_str(s_comma); kcc_as_str(s_r10); kcc_as_ch('\n');
            x86_store(base, s_r10); soff += 8; base++;
        }
    }
}

/* Reference set for dead static-function elimination: names that must not be
   dropped even when static.  Marked liberally (over-approximate) so a live
   function is never elided; see the prose above. */
static void *kcc_x86_refset = 0;
static void x86_ref_mark(const char *name) {
    if (name && *name)
        kcc_ht_put(kcc_x86_refset, name, kcc_strlen(name), 1);
}
static int x86_is_referenced(const char *name) {
    return name && kcc_ht_get(kcc_x86_refset, name, kcc_strlen(name)) != 0;
}
/* Walk an initializer AST subtree, marking every identifier it names (a
   function whose address a file-scope initializer takes must be kept).  The
   walk is tag-directed rather than blindly recursive: literal nodes store raw
   values (not pointers) in their fields, so it only descends into fields known
   to hold child nodes---an init-list's element chain and a unary operand. */
static void x86_ref_scan_init(struct Node *n) {
    if (!n) return;
    if (n->tag == AST_IDENT_EXPR) {
        x86_ref_mark((const char *)n->f0);
    } else if (n->tag == AST_UNARY_EXPR) {          /* e.g. &func */
        x86_ref_scan_init((struct Node *)n->f1);
    } else if (n->tag == AST_INIT_LIST) {
        for (struct Node *e = (struct Node *)n->f0; e; e = (struct Node *)e->f4)
            x86_ref_scan_init(e);
    }
}
static void x86_build_refset(void) {
    kcc_x86_refset = kcc_ht_init(256);
    void *funcs = kcc_ir_funcs;
    if (funcs) {
        unsigned long nf = IL(funcs, VEC_COUNT);
        for (unsigned long fi = 0; fi < nf; fi++) {
            void *f = *(void **)kcc_vec_get(funcs, fi);
            void *blocks = (void *)IL(f, IRF_BLOCKS);
            if (!blocks) continue;
            unsigned long nbb = IL(blocks, VEC_COUNT);
            for (unsigned long b = 0; b < nbb; b++) {
                void *bb = *(void **)kcc_vec_get(blocks, b);
                for (void *ins = (void *)IL(bb, BB_FIRST); ins;
                     ins = (void *)IL(ins, IR_NEXT)) {
                    unsigned long op = IL(ins, IR_OP);
                    if (op == IR_CALL || op == IR_GLOBAL_REF)
                        x86_ref_mark((const char *)IL(ins, IR_SRC1));
                }
            }
        }
    }
    struct Node *tu = (struct Node *)kcc_x86_tu;
    if (tu) {
        for (struct Node *d = (struct Node *)tu->f0; d; d = (struct Node *)d->f4) {
            /* Only VAR_DECL/FUNC_DECL carry a name pointer in f1; other decls
               (e.g. a file-scope asm statement) store unrelated data there, so
               reading it as a string would fault. */
            if (d->tag != AST_VAR_DECL && d->tag != AST_FUNC_DECL) continue;
            if (d->tag == AST_VAR_DECL && d->f2)   /* f2 = initializer */
                x86_ref_scan_init((struct Node *)d->f2);
            struct AttrRec *ar = x86_attr((const char *)d->f1);
            if (ar && ar->alias) x86_ref_mark(ar->alias);  /* alias .set target */
        }
    }
}

static void x86_render_text(void) {
    kcc_as_str(s_text);
    void *funcs = kcc_ir_funcs;
    if (!funcs) return;
    x86_build_refset();
    unsigned long nf = IL(funcs, VEC_COUNT);
    for (unsigned long fi = 0; fi < nf; fi++) {
        void *f = *(void **)kcc_vec_get(funcs, fi);
        const char *name = (const char *)IL(f, IRF_NAME);
        struct AttrRec *ar = x86_attr(name);
        /* Drop a static function unreferenced across all IR and initializers,
           unless it carries a placement/export attribute. */
        if (IL(f, IRF_STATIC) && !x86_is_referenced(name)
            && kcc_strcmp(name, kcc_str_modinit) != 0
            && !(ar && (ar->section || ar->weak || ar->alias)))
            continue;
        if (ar && ar->section) {                 /* __attribute__((section("..."))): code section */
            kcc_as_str(s_section); kcc_as_str(ar->section); kcc_as_str(s_ax);
        }
        if (!IL(f, IRF_STATIC) && kcc_strcmp(name, kcc_str_modinit) != 0) {
            kcc_as_str(ar && ar->weak ? s_weak : s_globl);   /* __weak → .weak */
            x86_sym(name); kcc_as_ch('\n');
        }
        x86_sym(name); kcc_as_str(s_colon_nl);
        unsigned long vn = IL(f, IRF_VREG_N);
        kcc_x86_vreg_n = vn;
        unsigned long allocas = x86_prescan(f);
        unsigned long save_base = (vn + allocas) * 8;
        unsigned long variadic = IL(f, IRF_VARIADIC);
        kcc_x86_rsa_top = 0;
        if (variadic) {              /* reserve a System V register-save area: 6 GP + 8 XMM */
            save_base += 176;
            kcc_x86_rsa_top = save_base;
        }
        unsigned long frame = ((save_base) + 15) & ~15UL;
        kcc_as_str(s_push_rbp); kcc_as_str(s_mov_sp);
        if (frame) { kcc_as_str(s_sub_sp); kcc_as_dec(frame); kcc_as_str(s_sp_nl); }
        x86_spill_params(f);
        if (variadic) {              /* spill the incoming argument registers for va_arg */
            for (unsigned long k = 0; k < 6; k++) {
                kcc_as_str(s_movq); kcc_as_str(argregs[k]); kcc_as_str(s_comma);
                x86_disp(kcc_x86_rsa_top - k * 8); kcc_as_ch('\n');
            }
            for (unsigned long k = 0; k < 8; k++) {
                kcc_as_str(s_movsd); kcc_as_str(xmmregs[k]); kcc_as_str(s_comma);
                x86_disp(kcc_x86_rsa_top - 48 - k * 16); kcc_as_ch('\n');
            }
        }
        void *blocks = (void *)IL(f, IRF_BLOCKS);
        if (blocks) {
            unsigned long nbb = IL(blocks, VEC_COUNT);
            for (unsigned long b = 0; b < nbb; b++) {
                void *bb = *(void **)kcc_vec_get(blocks, b);
                x86_bblabel(IL(bb, BB_ID)); kcc_as_str(s_label_nl);
                void *ins = (void *)IL(bb, BB_FIRST);
                while (ins) { kcc_x86_sel(ins); ins = (void *)IL(ins, IR_NEXT); }
            }
        }
        if (ar && ar->section) kcc_as_str(s_text);  /* leave the custom section */
    }
}
@}

\section{Global, Static, and Read-Only Data}

Mutable file-scope globals become zeroed common storage (their initialisers run
as code); \texttt{const} scalars, arrays of scalars, structs of scalars, and
arrays of such structs become read-only value directives; static locals are
recovered by walking every function body---and, for those a spine walk cannot
reach, by a decl list the IR builder keeps (below).  A declarator whose type resolves to a
\emph{function} type is not an object at all---it declares a function and gets no
storage---so the data pass skips it: the kernel's
\texttt{INDIRECT\_CALLABLE\_DECLARE} spells a prototype as
\verb|inet_ehashfn_t udp_ehashfn;| through a function-type typedef, and a
\verb|.comm| for that name would collide with the real definition.

A common symbol emitted with \verb|.comm| has \emph{external} linkage: the
linker coalesces same-named commons from different objects into one.  A
file-scope \texttt{static} has \emph{internal} linkage and must stay private to
its translation unit, so for a static we first mark the name \verb|.local|.
Without it two units that each name a static the same---say both back ends'
\texttt{s\_globl}---would share one storage cell and their initialisers would
overwrite each other.

A \texttt{\_\_attribute\_\_((section("...")))} on a defining declaration is the
one case where a zero-storage global must \emph{not} become a common symbol.  A
common lives in \texttt{.bss}; the section attribute demands the cell appear in a
\emph{specific} named section instead.  The kernel's per-cpu machinery depends on
this: \texttt{DEFINE\_PER\_CPU\_FIRST} lands \texttt{fixed\_percpu\_data} in
\verb|.data..percpu..first|, which \texttt{vmlinux.lds} orders first in the
per-cpu output and then asserts sits at offset~0.  Emitted as a \verb|.comm| the
symbol would drift into \texttt{.bss} and the link would fail the assert, so a
section-attributed definition is written out longhand---\verb|.section name,"aw"|,
the label, and a \verb|.zero| of its size---exactly as \texttt{gcc} does.  (The
attribute record carries no alignment, so the cell takes the default 8-byte
\texttt{.p2align}; being the sole and first symbol of its section it still resolves
to offset~0.)

@l c
@d Selfhost: emit_x86 data @{
/* A single file-scope object may be spelled by both a tentative declaration
   (\verb|u32 x;|) and a defining one (\verb|u32 x = 0;|); C makes that one
   object, but each reaches the emitter separately.  Emitting the zero-storage
   cell twice is harmless as a Mach-O common (the linker coalesces them) yet a
   hard error for a GNU-assembler \verb|.local .comm| pair, so the set of names
   already given storage is remembered and re-emission is skipped. */
static void *kcc_x86_emitted = 0;
static void x86_emit_zerofill(const char *name, unsigned long size, int is_static) {
    if (kcc_x86_emitted && name) {
        unsigned long kl = kcc_strlen(name);
        if (kcc_ht_get(kcc_x86_emitted, name, kl)) return;
        kcc_ht_put(kcc_x86_emitted, name, kl, 1);
    }
    struct AttrRec *ar = x86_attr(name);
    int weak = !is_static && ar && ar->weak;     /* __weak global */
    const char *sec = ar ? ar->section : 0;      /* __attribute__((section("..."))) */
    if (!is_static) { kcc_as_str(weak ? s_weak : s_globl); x86_sym(name); kcc_as_ch('\n'); }
    if (sec && kcc_x86_os) {
        /* A section attribute on a definition forces a real, zero-filled cell
           in the named section --- never a common symbol. This matters for the
           kernel per-cpu area: DEFINE_PER_CPU_FIRST places fixed_percpu_data in
           .data..percpu..first, and vmlinux.lds asserts it sits at offset 0 of
           the per-cpu output. Emitted as a `.comm`, it would land in .bss and
           never reach the per-cpu section, tripping that assert. */
        kcc_as_str(s_section); kcc_as_str(sec); kcc_as_str(s_aw);
        kcc_as_str(s_p2align3);
        x86_sym(name); kcc_as_str(s_colon_nl);
        kcc_as_str(s_zerodir); kcc_as_dec(size); kcc_as_ch('\n');
        kcc_as_str(s_text);
    } else if (weak && kcc_x86_os) {
        /* a common symbol cannot also be weak; give it a real weak definition
           in .bss instead of a `.comm`. */
        kcc_as_str(s_bss); kcc_as_str(s_p2align3);
        x86_sym(name); kcc_as_str(s_colon_nl);
        kcc_as_str(s_zerodir); kcc_as_dec(size); kcc_as_ch('\n');
        kcc_as_str(s_text);
    } else if (kcc_x86_os) {                     /* Linux .comm name,size,8 */
        if (is_static) { kcc_as_str(s_local); kcc_as_str(name); kcc_as_ch('\n'); }
        kcc_as_str(s_comm); kcc_as_str(name); kcc_as_str(s_comma1);
        kcc_as_dec(size); kcc_as_str(s_comm_a8);
    } else {                                     /* Darwin .zerofill (prefix carries _) */
        kcc_as_str(s_zerofill); kcc_as_str(name); kcc_as_str(s_comma1);
        kcc_as_dec(size); kcc_as_str(s_zf_a3);
    }
}
static unsigned long round8_min8(unsigned long n) {
    if (n < 8) n = 8;
    return (n + 7) & ~7UL;
}

void kcc_x86_emit_data(void) {
    struct Node *tu = (struct Node *)kcc_x86_tu;
    if (!tu) return;
    kcc_x86_emitted = kcc_ht_init(256);    /* fresh per translation unit */
    struct Node *d = (struct Node *)tu->f0;
    for (; d; d = (struct Node *)d->f4) {
        if (d->tag != AST_VAR_DECL) continue;
        void *name = (void *)d->f1;
        if (!name) continue;
        unsigned long sc = d->f3;                /* storage class */
        if (sc == 2 || sc == 1) continue;        /* extern / typedef: no storage */
        if (kcc_global_const_rodata(d)) {
            x86_emit_rodata_global(d, name);
            continue;
        }
        if (kcc_global_const_ptrarr(d)) { x86_emit_rodata_ptrarr(d, name); continue; }
        void *ty = kcc_sema_resolve_type((void *)d->f0);
        if (!ty) continue;
        /* A declarator whose type is a function type declares a function, not an
           object---`fntype name;' through a function-type typedef is a prototype
           with no storage, exactly like `u32 name(args);'.  The kernel writes
           these through INDIRECT_CALLABLE_DECLARE (under CONFIG_RETPOLINE it is a
           bare `inet_ehashfn_t udp_ehashfn;'); emitting a `.comm' for it would
           collide with the real function definition---"symbol already defined". */
        if (IL(ty, TY_KIND) == TY_FUNC) continue;
        unsigned long size = round8_min8(kcc_type_layout(ty));
        x86_emit_zerofill(name, size, sc == 3);
    }
}

static void x86_emit_one_static(void *decl) {
    struct Node *d = (struct Node *)decl;
    const char *name = kcc_ir_static_name(d);
    /* Emit each static's storage once.  Check only here---do NOT claim the name,
       or x86_emit_zerofill's own guard would see it already taken and emit
       nothing.  The rodata paths have no such guard, so they are marked below. */
    unsigned long kl = name ? kcc_strlen(name) : 0;
    if (kcc_x86_emitted && name && kcc_ht_get(kcc_x86_emitted, name, kl)) return;
    if (kcc_global_const_rodata(d)) {
        x86_emit_rodata_global(d, name);
        if (kcc_x86_emitted && name) kcc_ht_put(kcc_x86_emitted, name, kl, 1);
        return;
    }
    if (kcc_global_const_ptrarr(d)) {
        x86_emit_rodata_ptrarr(d, name);
        if (kcc_x86_emitted && name) kcc_ht_put(kcc_x86_emitted, name, kl, 1);
        return;
    }
    void *ty = kcc_sema_resolve_type((void *)d->f0);
    if (!ty) return;
    unsigned long size = round8_min8(kcc_type_layout(ty));
    x86_emit_zerofill(name, size, 1);
}

static void x86_prereg_stmt(void *stmt) {
    struct Node *s = (struct Node *)stmt;
    for (; s; s = (struct Node *)s->f4) {
        unsigned long tag = s->tag;
        if (tag == AST_VAR_DECL) {
            if (s->f3 == 3) x86_emit_one_static(s);
            continue;
        }
        switch (tag) {
        case AST_COMPOUND: case AST_DO_STMT: case AST_DEFAULT_STMT:
            x86_prereg_stmt((void *)s->f0); break;
        case AST_SWITCH_STMT: case AST_WHILE_STMT: case AST_CASE_STMT:
        case AST_LABEL_STMT:
            x86_prereg_stmt((void *)s->f1); break;
        case AST_IF_STMT:
            x86_prereg_stmt((void *)s->f1);
            x86_prereg_stmt((void *)s->f2);
            break;
        case AST_FOR_STMT:
            x86_prereg_stmt((void *)s->f0);
            x86_prereg_stmt((void *)s->f3);
            break;
        default: break;
        }
    }
}

void kcc_x86_emit_statics(void) {
    struct Node *tu = (struct Node *)kcc_x86_tu;
    if (!tu) return;
    struct Node *d = (struct Node *)tu->f0;
    for (; d; d = (struct Node *)d->f4)
        if (d->tag == AST_FUNC_DECL && d->f3)
            x86_prereg_stmt((void *)d->f3);
    @<Selfhost: emit_x86 stmt-expr static storage@>
}
@}

The function-body walk finds every static local that sits on a statement spine,
but a static declared inside a GNU statement-expression \verb|({ ... })| hides
from it: the \texttt{printk\_once}/\texttt{WARN\_ONCE}/\texttt{DO\_ONCE} family
each expands to \verb|({ static bool __c; ... })|, and the once-flag lives in an
expression the spine walk never descends into.  The IR builder does reach it---it
registers the static and its references resolve to an \verb|sl_| name---but the
name's storage was never emitted, so a whole-kernel link left thousands of
\verb|sl_| symbols undefined.  The remedy is a belt-and-braces list: the builder
records \emph{every} static-local declaration it registers in
\texttt{kcc\_ir\_static\_decls}, and after the spine walk we emit storage for any
entry not already given a cell.  The shared \texttt{kcc\_x86\_emitted} guard (now
consulted at the top of \texttt{x86\_emit\_one\_static} as well) means a static
found by both routes is emitted once; a stmt-expr static, found only by the list,
still gets its definition.  This gives every stmt-expr static a \emph{storage}
cell, which is what the whole-kernel link needs.  Its \emph{initialiser} is a
separate matter: the once-flag families initialise to zero, and a common lands in
zeroed \texttt{.bss}, so no init code is required and the value is already
correct.  A stmt-expr static with a \emph{non-zero} initialiser would need that
initialiser hoisted to module-init code, which the spine-only
\texttt{kcc\_ir\_emit\_global\_inits} does not do for statics nested in
expressions---a documented limitation the kernel's zero-valued once-flags never
exercise.

One hazard remains.  \texttt{kcc\_ir\_static\_name} mangles a static to
\verb|sl_| plus the hex of its declaration node's address---an arena offset that
\emph{resets} every compilation, so two unrelated files' statics can mangle to
the same name.  While those names were undefined this was invisible; once we
define them, the linker sees two objects each defining \verb|sl_0000...| and
rejects the second.  The driver therefore seeds a per-file salt
(\texttt{kcc\_tu\_salt}, a hash of the source path) that
\texttt{kcc\_ir\_static\_name} exclusive-ors into the address before hex, making
the name unique across the tree yet stable within one file---so the reference and
its definition still agree.

@l c
@d Selfhost: emit_x86 stmt-expr static storage @{
if (kcc_ir_static_decls) {
    unsigned long n = IL(kcc_ir_static_decls, VEC_COUNT);
    for (unsigned long i = 0; i < n; i++)
        x86_emit_one_static(*(void **)kcc_vec_get(kcc_ir_static_decls, i));
}
@}

\section{Read-Only Byte Images}

@l c
@d Selfhost: emit_x86 rodata @{
static void x86_emit_zero(unsigned long n) {
    if (!n) return;
    kcc_as_str(s_zerodir); kcc_as_dec(n); kcc_as_ch('\n');
}
static void x86_emit_value(unsigned long bits, unsigned long size) {
    if (size == 1) { kcc_as_str(s_d_byte); bits &= 0xff; }
    else if (size == 2) { kcc_as_str(s_d_short); bits &= 0xffff; }
    else if (size == 8) { kcc_as_str(s_d_quad); }
    else { kcc_as_str(s_d_long); bits &= 0xffffffff; }
    kcc_as_dec(bits); kcc_as_ch('\n');
}
static void x86_emit_struct_bytes(void *sty, void *init, unsigned long total) {
    struct Node *decl = (struct Node *)((struct Type *)sty)->f0;
    struct Node *field = (struct Node *)decl->f1;
    struct Node *elem = init ? (struct Node *)((struct Node *)init)->f0 : 0;
    unsigned long cursor = 0;
    while (field) {
        struct Type *ft = (struct Type *)kcc_sema_resolve_type((void *)field->f0);
        if (!ft) break;
        unsigned long fsize = ft->size, fkind = ft->kind;
        unsigned long foff = field->f3;
        if (foff > cursor) { x86_emit_zero(foff - cursor); cursor = foff; }
        unsigned long bits;
        if (elem) { bits = kcc_rodata_leaf_bits(elem, fkind); elem = (struct Node *)elem->f4; }
        else bits = 0;
        x86_emit_value(bits, fsize);
        cursor += fsize;
        field = (struct Node *)field->f4;
    }
    if (cursor < total) x86_emit_zero(total - cursor);
}

static void x86_emit_rodata_global(void *decl, const char *name) {
    struct Node *d = (struct Node *)decl;
    if (!name) return;
    struct Type *full = (struct Type *)kcc_sema_resolve_type((void *)d->f0);
    if (!full) return;
    unsigned long shape, count = 0, elemsize, elemkind;
    struct Type *elemtype;
    unsigned long fk = full->kind;
    if (fk == TY_STRUCT) { shape = 2; elemtype = full; }
    else if (fk == TY_ARRAY) {
        elemtype = (struct Type *)full->f0;
        shape = (elemtype->kind == TY_STRUCT) ? 3 : 1;
        elemsize = elemtype->size;
        if (!elemsize) return;
        count = kcc_type_layout(full) / elemsize;
    } else { shape = 0; elemtype = full; count = 1; }
    elemsize = elemtype->size;
    elemkind = elemtype->kind;

    kcc_as_str(kcc_x86_os ? s_rodata : s_constsect);
    kcc_as_str(s_p2align3);
    if (d->f3 != 3) { kcc_as_str(s_globl); x86_sym(name); kcc_as_ch('\n'); }
    x86_sym(name); kcc_as_str(s_colon_nl);

    if (shape == 2) {
        unsigned long total = kcc_type_layout(full);
        x86_emit_struct_bytes(full, (void *)d->f2, total);
        return;
    }
    if (shape == 3) {
        unsigned long emitted = 0;
        struct Node *arr = (struct Node *)d->f2;
        struct Node *e = arr ? (struct Node *)arr->f0 : 0;
        while (e && emitted < count) {
            x86_emit_struct_bytes(elemtype, e, elemsize);
            emitted++;
            e = (struct Node *)e->f4;
        }
        if (emitted < count) x86_emit_zero((count - emitted) * elemsize);
        return;
    }
    /* scalar / array-of-scalar */
    unsigned long emitted = 0;
    struct Node *init = (struct Node *)d->f2;
    if (init) {
        if (init->tag == AST_INIT_LIST) {
            struct Node *e = (struct Node *)init->f0;
            while (e) {
                x86_emit_value(kcc_rodata_leaf_bits(e, elemkind), elemsize);
                emitted++;
                e = (struct Node *)e->f4;
            }
        } else {
            x86_emit_value(kcc_rodata_leaf_bits(init, elemkind), elemsize);
            emitted = 1;
        }
    }
    if (emitted < count) x86_emit_zero((count - emitted) * elemsize);
}

/* A const array of pointers whose initialisers are string literals: emit one
   `.quad .Lx86str<id>` per element, registering each string so the render
   entry lays it down with a matching label.  (Not emitting `.globl` for a
   static leaves the symbol local to the translation unit.) */
static void x86_emit_rodata_ptrarr(void *decl, const char *name) {
    struct Node *d = (struct Node *)decl;
    if (!name) return;
    struct Type *full = (struct Type *)kcc_sema_resolve_type((void *)d->f0);
    if (!full) return;
    unsigned long total = kcc_type_layout(full);
    kcc_as_str(kcc_x86_os ? s_rodata : s_constsect);
    kcc_as_str(s_p2align3);
    if (d->f3 != 3) { kcc_as_str(s_globl); x86_sym(name); kcc_as_ch('\n'); }
    x86_sym(name); kcc_as_str(s_colon_nl);
    struct Node *init = (struct Node *)d->f2;
    struct Node *e = init ? (struct Node *)init->f0 : 0;
    unsigned long emitted = 0;
    for (; e; e = (struct Node *)e->f4) {
        if (e->tag == AST_STR_LIT) {
            unsigned long id = IL(kcc_x86_strs, VEC_COUNT);
            unsigned long entry[2]; entry[0] = e->f0; entry[1] = e->f1;
            kcc_vec_push(kcc_x86_strs, entry);
            kcc_as_str(s_d_quad); kcc_as_str(s_strlbl); kcc_as_dec(id); kcc_as_ch('\n');
        } else {
            kcc_as_str(s_d_quad); kcc_as_dec(kcc_rodata_leaf_bits(e, TY_PTR)); kcc_as_ch('\n');
        }
        emitted++;
    }
    if (emitted * 8 < total) x86_emit_zero(total - emitted * 8);
}
@}

\section{Module Init, String Literals, and the Render Entry}

@l c
@d Selfhost: emit_x86 render @{
void kcc_x86_emit_modinit(void) {
    if (!kcc_modinit_present) return;
    kcc_as_str(kcc_x86_os ? s_modinit_l : s_modinit_d);
    x86_sym(s_modinitnm);
    kcc_as_ch('\n');
}

void kcc_x86_emit_strings(void) {
    void *strs = kcc_x86_strs;
    if (!strs) return;
    unsigned long n = IL(strs, VEC_COUNT);
    if (!n) return;
    kcc_as_str(kcc_x86_os ? s_rodata : s_cstrsect);
    for (unsigned long i = 0; i < n; i++) {
        kcc_as_str(s_strlbl); kcc_as_dec(i); kcc_as_str(s_label_nl);
        unsigned long *e = (unsigned long *)kcc_vec_get(strs, i);
        unsigned char *data = (unsigned char *)e[0];
        unsigned long len = e[1];
        kcc_as_str(s_d_byte);
        for (unsigned long b = 0; b < len; b++) { kcc_as_dec(data[b]); kcc_as_str(s_comma1); }
        kcc_as_str(s_zero_nl);
    }
}

/* A file-scope \verb|asm("...")| (e.g. every \texttt{EXPORT_SYMBOL}) carries a
   raw assembler template with its own \verb|.section|/\verb|.previous|
   directives; paste each one verbatim into the text stream. */
static void kcc_x86_emit_toplevel_asm(void) {
    struct Node *tu = (struct Node *)kcc_x86_tu;
    if (!tu) return;
    for (struct Node *d = (struct Node *)tu->f0; d; d = (struct Node *)d->f4) {
        if (d->tag != AST_ASM_STMT) continue;
        const char *t = (const char *)d->f0;
        unsigned long n = d->f1;
        for (unsigned long i = 0; i < n; i++) kcc_as_ch((unsigned char)t[i]);
        kcc_as_ch('\n');
    }
}
/* `int foo(void) __attribute__((alias("bar")));` is a bodiless declaration, so
   it never reaches the IR function list; walk the translation unit and emit a
   `.set` for each name the parser recorded an alias target for. */
static void kcc_x86_emit_aliases(void) {
    struct Node *tu = (struct Node *)kcc_x86_tu;
    if (!tu) return;
    for (struct Node *d = (struct Node *)tu->f0; d; d = (struct Node *)d->f4) {
        if (d->tag != AST_FUNC_DECL && d->tag != AST_VAR_DECL) continue;
        const char *name = (const char *)d->f1;
        struct AttrRec *ar = x86_attr(name);
        if (!ar || !ar->alias) continue;
        /* A `weak, alias(...)' pair---the kernel's CPU_SHOW_VULN_FALLBACK
           defaults are `__weak' aliases of cpu_show_not_affected---must head the
           alias with `.weak', not `.globl'.  Emitted global, the fallback would
           be a strong second definition and collide at the vmlinux link with the
           arch's real cpu_show_* override. */
        kcc_as_str(ar->weak ? s_weak : s_globl); x86_sym(name); kcc_as_ch('\n');
        kcc_as_str(s_set); x86_sym(name); kcc_as_str(s_comma);
        x86_sym(ar->alias); kcc_as_ch('\n');
    }
}
int kcc_x86_render(const char *path) {
    kcc_as_init();
    kcc_x86_strs = kcc_vec_init(16);
    x86_render_text();
    kcc_x86_emit_toplevel_asm();
    kcc_x86_emit_aliases();
    kcc_x86_emit_data();
    kcc_x86_emit_statics();
    kcc_x86_emit_strings();
    kcc_x86_emit_modinit();
    return kcc_as_write_file(path);
}
@}

@l c
@d Selfhost: emit_x86 @{
@<Selfhost: emit_x86 preamble@>
@<Selfhost: emit_x86 helpers@>
@<Selfhost: emit_x86 shapes@>
@<Selfhost: emit_x86 dispatch@>
@<Selfhost: emit_x86 frame@>
@<Selfhost: emit_x86 data@>
@<Selfhost: emit_x86 rodata@>
@<Selfhost: emit_x86 render@>
@}

\section{Verification}
\label{sec:selfhost-emit-x86-verify}

\texttt{make selfhost-emit-x86} first confirms the drop-in links and the ARM64
path is untouched (codegen 226), then verifies the x86 emitter functionally: a
probe suite spanning the integer ALU, division, shifts, comparisons, control
flow, recursion, many-argument calls, pointers, arrays, structs, globals, and
string handling is compiled with \texttt{--target=x86\_64} by the C emitter, run
under Rosetta, and its exit status compared against the ARM64 reference built by
the assembly compiler.  Matching exits across the suite mean the C emitter
lowers the whole implemented opcode set correctly.

@d Selfhost: emit_x86 verify @{
#!/usr/bin/env bash
# make selfhost-emit-x86 — compile kcc's x86-64 back end in C with kcc, relink,
# and verify functionally (arm64 codegen unbroken + x86 programs run correctly).
set -euo pipefail

SDK=$(xcrun --show-sdk-path)
SH=tmp/selfhost
sources="main syscalls arena strings io hashtab vec strtab source lexer \
lexer_tables diag preprocessor parser expressions statements declarations \
types symtab conversions sema ir opt emit_arm64 emit_x86 linker codegen emit_macho dwarf driver"

echo "[1/4] compiling tmp/selfhost/emit_x86.c with kcc"
tmp/kcc -c "$SH/emit_x86.c" -o "$SH/emit_x86_c.o" >/dev/null

echo "[2/4] linking tmp/kcc_selfhost_emit_x86 (emit_x86.o -> C)"
OBJ=""
for f in $sources; do
    if [ "$f" = "emit_x86" ]; then OBJ="$OBJ $SH/emit_x86_c.o"; else OBJ="$OBJ tmp/src/${f}.o"; fi
done
ld -o tmp/kcc_selfhost_emit_x86 $OBJ -lSystem -syslibroot "$SDK" -e _main -arch arm64

cp tmp/kcc "$SH/kcc_asm_backup_emit_x86"

echo "[3/4] x86-64 functional check: C emitter -> as -> Rosetta run vs reference"
mkdir -p "$SH/x86probes"
# A probe suite spanning the implemented opcode set.
cat > "$SH/x86probes/p1.c" <<'P1'
int g; static int add(int a,int b){return a+b;}
int fib(int n){ if(n<2) return n; return fib(n-1)+fib(n-2); }
int main(void){ g=7; int s=0; for(int i=0;i<5;i++) s+=add(i,g); return (s+fib(6))%100; }
P1
cat > "$SH/x86probes/p2.c" <<'P2'
unsigned uf(unsigned x){ return (x*3u + 7u) / 2u; }
int main(void){ int a=100,b=7; long r=0; r+=a/b; r+=a%b; r+=(a<<2); r+=(a>>1);
  r+=(a&0x3c); r+=(a|1); r+=(a^5); r+=(-a); r+=(~b); r+=uf(41); return (int)(r%97); }
P2
cat > "$SH/x86probes/p3.c" <<'P3'
struct P{ int x; char c; long z; }; int arr[5];
int sum6(int a,int b,int c,int d,int e,int f){ return a+b+c+d+e+f; }
int main(void){ struct P p; p.x=10; p.c=3; p.z=100; for(int i=0;i<5;i++) arr[i]=i*i;
  int t=0; for(int i=0;i<5;i++) t+=arr[i];
  return (p.x+p.c+(int)p.z+t+sum6(1,2,3,4,5,6))%100; }
P3
cat > "$SH/x86probes/p4.c" <<'P4'
const char *msg="hello"; const int tbl[4]={11,22,33,44};
int slen(const char*s){int n=0;while(*s){n++;s++;}return n;}
int cnt(void){ static int k; k++; return k; }
int main(void){ int r=slen(msg); for(int i=0;i<4;i++) r+=tbl[i];
  r+=cnt(); r+=cnt(); r+=cnt(); return r%100; }
P4

status=0
for p in p1 p2 p3 p4; do
    src="$SH/x86probes/$p.c"
    # ARM64 reference (assembly compiler, native default target).
    cp "$SH/kcc_asm_backup_emit_x86" tmp/kcc
    tmp/kcc "$src" -o "$SH/x86probes/${p}_ref" >/dev/null 2>&1
    set +e; "$SH/x86probes/${p}_ref"; ref=$?; set -e
    # x86-64 via the C emitter, run under Rosetta.
    cp tmp/kcc_selfhost_emit_x86 tmp/kcc
    tmp/kcc --target=x86_64 "$src" -o "$SH/x86probes/${p}_x86" >/dev/null 2>&1
    set +e; "$SH/x86probes/${p}_x86"; got=$?; set -e
    if [ "$ref" != "$got" ]; then
        echo "  FAIL $p: x86(C emitter) exit $got != arm64 reference $ref"; status=1
    else
        echo "  ok   $p: exit $got (x86 C emitter == arm64 reference)"
    fi
done
cp "$SH/kcc_asm_backup_emit_x86" tmp/kcc
if [ $status -ne 0 ]; then exit 1; fi

echo "[4/4] codegen suite with the self-hosted x86 back end linked in (arm64 path)"
cp tmp/kcc_selfhost_emit_x86 tmp/kcc
set +e
bash tmp/tests/test_codegen.sh
status=$?
cp "$SH/kcc_asm_backup_emit_x86" tmp/kcc
exit $status
@}
