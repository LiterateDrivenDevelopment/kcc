% 18b-pp-conditionals.weft — conditional compilation (#if family)
%
% Split from 18-preprocessor.weft (structural refactor, no content changes):
% #if/#ifdef/#elif/#else/#endif handling and the #if constant-expression
% evaluator.

\section{Conditional Compilation}

The conditional directives \texttt{\#ifdef}, \texttt{\#ifndef},
\texttt{\#if}, \texttt{\#elif}, \texttt{\#else}, and
\texttt{\#endif} control which sections of the source are processed.

A conditional stack records the state of each nested group.  States
are \texttt{ACTIVE} (processing tokens), \texttt{SKIP} (discarding
tokens), and \texttt{DONE} (active branch already seen, skip rest).

@d PP: conditional @{
.text
// -- _kcc_pp_do_ifdef -----------------------------------------------
// x0 = negate (0 for ifdef, 1 for ifndef)
.p2align 2
_kcc_pp_do_ifdef:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    mov x19, x0               // x19 = negate flag

    // Read macro name
    bl _kcc_lex_next
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_IDENT
    b.ne .Lifdef_err

    // Look up in macro table
    adrp x0, _kcc_pp_macros@@PAGE
    add  x0, x0, _kcc_pp_macros@@PAGEOFF
    ldr  x0, [x0]

    adrp x1, _kcc_tok_start@@PAGE
    add  x1, x1, _kcc_tok_start@@PAGEOFF
    ldr  x1, [x1]

    adrp x2, _kcc_tok_len@@PAGE
    add  x2, x2, _kcc_tok_len@@PAGEOFF
    ldr  x2, [x2]

    bl _kcc_ht_get             // x0 = value (0 if not found)

    // Determine condition: ifdef → (value != 0), ifndef → (value == 0)
    cmp  x0, #0
    cset x0, ne                // x0 = 1 if defined, 0 if not
    eor  x0, x0, x19          // negate if ifndef

    // Push conditional: ACTIVE if true, SKIP if false
    cmp  x0, #0
    mov  x0, #PP_COND_SKIP
    mov  x1, #PP_COND_ACTIVE
    csel x0, x1, x0, ne       // x0 = state

    bl _kcc_pp_cond_push
    bl _kcc_pp_skip_line

    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

.Lifdef_err:
    adrp x0, _kcc_pp_dir_line@@PAGE
    add  x0, x0, _kcc_pp_dir_line@@PAGEOFF
    ldr  x0, [x0]
    mov  x1, #1
    adrp x2, _kcc_pp_err_ifdef_name@@PAGE
    add  x2, x2, _kcc_pp_err_ifdef_name@@PAGEOFF
    bl _kcc_diag_error
    // Push SKIP so we don't process the body
    mov x0, #PP_COND_SKIP
    bl _kcc_pp_cond_push
    bl _kcc_pp_skip_line
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@}

The \texttt{\#if} and \texttt{\#elif} directives evaluate a constant
integer expression to decide whether to process the enclosed source.
\stdref{6.10.1}/4 requires the controlling line to undergo \emph{full
macro replacement}---after the \texttt{defined} operator is resolved---%
before it is parsed as an expression.  \texttt{\_kcc\_pp\_do\_if}
extracts the rest of the directive line, hands it to
\texttt{\_kcc\_pp\_prepare\_cond} (which expands it, described next),
temporarily redirects the lexer to scan the resulting text, calls the
recursive-descent evaluator, and pushes an \texttt{ACTIVE} or
\texttt{SKIP} state accordingly.  \texttt{\_kcc\_pp\_do\_elif} follows
the same pattern but must also account for whether a previous branch
in the same group was already taken---if so, the state becomes
\texttt{DONE} regardless of the expression's value.

\paragraph{Expanding the controlling line.}
The recursive-descent evaluator reads raw lexer tokens and looks up each
bare identifier as a macro on the fly.  That shortcut is correct for an
object-like macro or a chain of them, but it cannot bind the parameters
of a \emph{function-like} macro: evaluating the body of
\texttt{L\_INTHASBITS(b)} directly leaves \texttt{b} unbound (hence~0),
so a real header's \texttt{\#if L\_INTHASBITS(SIZE\_Bx)} collapses to
\texttt{((UINT\_MAX >{}> -1) >= 1)}, takes the wrong branch, and silently
mis-sizes a bit-field constant.  The cure is to obey the standard
literally: fully expand the line first, then evaluate a stream that holds
only numbers and operators.  \texttt{\_kcc\_pp\_prepare\_cond} does this
in two passes.  \texttt{\_kcc\_pp\_protect\_defined} raw-scans the line
and rewrites each \texttt{defined NAME} / \texttt{defined(NAME)} to the
literal \texttt{1} or \texttt{0}---looking the operand up \emph{without}
expanding it, as \stdref{6.10.1} demands---while copying every other
token verbatim.  The result is then run through
\texttt{\_kcc\_pp\_expand\_arg}, the same argument-prescan engine the
macro expander already uses, which performs a complete macro replacement
(function-like invocations included) and returns re-lexable text.

@d PP: conditional @{
// -- _kcc_pp_protect_defined ----------------------------------------
// (const char *src, uint64_t len) -> x0 = buf, x1 = len
// Raw-scans one #if/#elif controlling line, copying every token verbatim
// EXCEPT `defined NAME` / `defined(NAME)`, which become the literal 1 or 0.
// The operand is looked up but never expanded (6.10.1): expansion happens
// only afterwards, on the rewritten line.  Output is at most 2*len bytes
// (each token plus one separating space; `defined` only ever shrinks), so
// the buffer never needs to grow.
.p2align 2
_kcc_pp_protect_defined:
    stp x29, x30, [sp, #-96]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    stp x25, x26, [sp, #64]
    str x27, [sp, #80]
    mov x23, x0                  // src
    mov x24, x1                  // len

    // Save lexer state, then aim it at the controlling text.
    adrp x0, _kcc_lex_cursor@@PAGE
    add  x0, x0, _kcc_lex_cursor@@PAGEOFF
    ldr  x21, [x0]
    adrp x0, _kcc_lex_end@@PAGE
    add  x0, x0, _kcc_lex_end@@PAGEOFF
    ldr  x22, [x0]
    adrp x0, _kcc_lex_cursor@@PAGE
    add  x0, x0, _kcc_lex_cursor@@PAGEOFF
    str  x23, [x0]
    adrp x0, _kcc_lex_end@@PAGE
    add  x0, x0, _kcc_lex_end@@PAGEOFF
    add  x1, x23, x24
    str  x1, [x0]

    // Output buffer: 2*len + 64 bytes (never grows; see header note).
    lsl  x0, x24, #1
    add  x0, x0, #64
    bl _kcc_arena_alloc
    mov  x19, x0                 // out_buf
    mov  x20, #0                 // out_len

    bl _kcc_lex_next
.Lpd_loop:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lpd_done           // TOK_EOF

    // Is this token the identifier `defined` (length 7, exact match)?
    cmp  x0, #TOK_IDENT
    b.ne .Lpd_copy
    adrp x0, _kcc_tok_len@@PAGE
    add  x0, x0, _kcc_tok_len@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #7
    b.ne .Lpd_copy
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_pp_s_defined@@PAGE
    add  x1, x1, _kcc_pp_s_defined@@PAGEOFF
    mov  x2, #7
    bl _kcc_memcmp
    cbnz x0, .Lpd_copy

    // `defined` seen.  Next token is either `(` (parenthesised form) or the
    // operand name itself.  Record which, and land on the name token.
    bl _kcc_lex_next
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_LPAREN
    cset w27, eq                 // w27 = 1 if parenthesised
    cbz  w27, .Lpd_have_name
    bl _kcc_lex_next             // step onto the name inside the parens
.Lpd_have_name:
    // Look the operand up in the macro table WITHOUT expanding it.
    adrp x0, _kcc_pp_macros@@PAGE
    add  x0, x0, _kcc_pp_macros@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_tok_start@@PAGE
    add  x1, x1, _kcc_tok_start@@PAGEOFF
    ldr  x1, [x1]
    adrp x2, _kcc_tok_len@@PAGE
    add  x2, x2, _kcc_tok_len@@PAGEOFF
    ldr  x2, [x2]
    bl _kcc_ht_get
    cmp  x0, #0
    cset x25, ne                 // x25 = 1 if defined, else 0

    // Advance past the name; for the parenthesised form also past the `)`.
    bl _kcc_lex_next
    cbz  w27, .Lpd_emit_bit
    bl _kcc_lex_next             // consume `)`
.Lpd_emit_bit:
    cbz  x20, .Lpd_bit_nosep
    mov  w0, #0x20               // space separator
    strb w0, [x19, x20]
    add  x20, x20, #1
.Lpd_bit_nosep:
    add  w1, w25, #0x30          // '0' + bit
    strb w1, [x19, x20]
    add  x20, x20, #1
    b .Lpd_loop

.Lpd_copy:
    // Copy the current token verbatim, space-separated from the previous one.
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x25, [x0]               // tok_start
    adrp x0, _kcc_tok_len@@PAGE
    add  x0, x0, _kcc_tok_len@@PAGEOFF
    ldr  x26, [x0]               // tok_len
    cbz  x20, .Lpd_copy_nosep
    mov  w0, #0x20
    strb w0, [x19, x20]
    add  x20, x20, #1
.Lpd_copy_nosep:
    add  x0, x19, x20
    mov  x1, x25
    mov  x2, x26
    bl _kcc_memcpy
    add  x20, x20, x26
    bl _kcc_lex_next
    b .Lpd_loop

.Lpd_done:
    adrp x0, _kcc_lex_cursor@@PAGE
    add  x0, x0, _kcc_lex_cursor@@PAGEOFF
    str  x21, [x0]
    adrp x0, _kcc_lex_end@@PAGE
    add  x0, x0, _kcc_lex_end@@PAGEOFF
    str  x22, [x0]
    mov  x0, x19
    mov  x1, x20
    ldr  x27, [sp, #80]
    ldp  x25, x26, [sp, #64]
    ldp  x23, x24, [sp, #48]
    ldp  x21, x22, [sp, #32]
    ldp  x19, x20, [sp, #16]
    ldp  x29, x30, [sp], #96
    ret

// -- _kcc_pp_prepare_cond -------------------------------------------
// (const char *src, uint64_t len) -> x0 = buf, x1 = len
// Resolves `defined`, then fully macro-expands the controlling line, so the
// evaluator downstream sees only literals and operators.
//
// The expansion pass drives _kcc_pp_next, which normally suppresses tokens
// while the current conditional branch is being skipped.  A `#elif` is
// evaluated with its group's state still SKIP, so that suppression would
// silently swallow the whole (correct) expansion and make every `#elif`
// read as false.  We therefore zero the conditional depth across the
// expansion---the pushed expand context is self-contained, so treating it
// as unconditionally active is exactly right---and restore it afterwards.
.p2align 2
_kcc_pp_prepare_cond:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]

    bl _kcc_pp_protect_defined   // (src,len) -> (bufA,lenA)
    mov x19, x0
    mov x20, x1
    cbz x20, .Lpc_ret            // nothing to expand

    // Suspend conditional skipping for the duration of the expansion.
    adrp x21, _kcc_pp_cond_depth@@PAGE
    add  x21, x21, _kcc_pp_cond_depth@@PAGEOFF
    ldr  x22, [x21]              // saved cond_depth
    str  xzr, [x21]

    mov x0, x19
    mov x1, x20
    bl _kcc_pp_expand_arg        // full macro replacement -> (bufB,lenB)
    mov x19, x0
    mov x20, x1

    str  x22, [x21]             // restore cond_depth
.Lpc_ret:
    mov x0, x19
    mov x1, x20
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

// -- _kcc_pp_do_if --------------------------------------------------
// Handles #if with basic expression evaluation.
.p2align 2
_kcc_pp_do_if:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]

    // Get rest of line as expression text, then fully expand it (resolving
    // `defined` and every macro, including function-like ones) so the
    // evaluator below sees only literals and operators.
    bl _kcc_pp_rest_of_line
    bl _kcc_pp_prepare_cond
    mov x19, x0               // x19 = expanded expr text
    mov x20, x1               // x20 = expanded expr len

    // Save lexer state
    adrp x0, _kcc_lex_cursor@@PAGE
    add  x0, x0, _kcc_lex_cursor@@PAGEOFF
    ldr  x21, [x0]
    adrp x0, _kcc_lex_end@@PAGE
    add  x0, x0, _kcc_lex_end@@PAGEOFF
    ldr  x22, [x0]

    // Point lexer at expression text
    adrp x0, _kcc_lex_cursor@@PAGE
    add  x0, x0, _kcc_lex_cursor@@PAGEOFF
    str  x19, [x0]
    adrp x0, _kcc_lex_end@@PAGE
    add  x0, x0, _kcc_lex_end@@PAGEOFF
    add  x1, x19, x20
    str  x1, [x0]

    // Evaluate
    bl _kcc_lex_next           // get first token
    bl _kcc_pp_eval_expr       // x0 = result
    mov x19, x0                // save result

    // Restore lexer state
    adrp x0, _kcc_lex_cursor@@PAGE
    add  x0, x0, _kcc_lex_cursor@@PAGEOFF
    str  x21, [x0]
    adrp x0, _kcc_lex_end@@PAGE
    add  x0, x0, _kcc_lex_end@@PAGEOFF
    str  x22, [x0]

    // Push conditional
    cmp  x19, #0
    mov  x0, #PP_COND_SKIP
    mov  x1, #PP_COND_ACTIVE
    csel x0, x1, x0, ne

    bl _kcc_pp_cond_push

    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@}

\paragraph{The \texttt{\#elif} directive.}
The \texttt{\#elif} handler must determine whether a previous branch in
the same conditional group was already taken.  If the current state is
\texttt{ACTIVE}, the branch just processed was chosen, so the state
transitions to \texttt{DONE} and the rest of the group is skipped.  If
the state is already \texttt{DONE}, the directive line is consumed
without evaluation.  Only when the state is \texttt{SKIP}---meaning no
branch has yet matched---does the handler evaluate the expression and
potentially activate the branch.

@d PP: conditional @{
// -- _kcc_pp_do_elif ------------------------------------------------
.p2align 2
_kcc_pp_do_elif:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]

    // Check conditional depth
    adrp x0, _kcc_pp_cond_depth@@PAGE
    add  x0, x0, _kcc_pp_cond_depth@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lelif_stray

    // Check current state
    sub  x1, x0, #1
    adrp x2, _kcc_pp_cond_stack@@PAGE
    add  x2, x2, _kcc_pp_cond_stack@@PAGEOFF
    ldrb w3, [x2, x1]

    cmp  w3, #PP_COND_ACTIVE
    b.eq .Lelif_was_active     // previous branch was active → DONE
    cmp  w3, #PP_COND_DONE
    b.eq .Lelif_done_skip      // already found active → stay DONE

    // State is SKIP: evaluate expression to see if this branch is active.
    // Expand the controlling line first (see _kcc_pp_do_if).
    bl _kcc_pp_rest_of_line
    bl _kcc_pp_prepare_cond
    mov x19, x0
    mov x20, x1

    // Save/restore lexer, evaluate
    adrp x0, _kcc_lex_cursor@@PAGE
    add  x0, x0, _kcc_lex_cursor@@PAGEOFF
    ldr  x21, [x0]
    adrp x0, _kcc_lex_end@@PAGE
    add  x0, x0, _kcc_lex_end@@PAGEOFF
    ldr  x22, [x0]

    adrp x0, _kcc_lex_cursor@@PAGE
    add  x0, x0, _kcc_lex_cursor@@PAGEOFF
    str  x19, [x0]
    adrp x0, _kcc_lex_end@@PAGE
    add  x0, x0, _kcc_lex_end@@PAGEOFF
    add  x1, x19, x20
    str  x1, [x0]

    bl _kcc_lex_next
    bl _kcc_pp_eval_expr
    mov x19, x0

    adrp x0, _kcc_lex_cursor@@PAGE
    add  x0, x0, _kcc_lex_cursor@@PAGEOFF
    str  x21, [x0]
    adrp x0, _kcc_lex_end@@PAGE
    add  x0, x0, _kcc_lex_end@@PAGEOFF
    str  x22, [x0]

    // Update conditional stack top
    adrp x0, _kcc_pp_cond_depth@@PAGE
    add  x0, x0, _kcc_pp_cond_depth@@PAGEOFF
    ldr  x0, [x0]
    sub  x1, x0, #1
    adrp x2, _kcc_pp_cond_stack@@PAGE
    add  x2, x2, _kcc_pp_cond_stack@@PAGEOFF

    cmp  x19, #0
    mov  w3, #PP_COND_SKIP
    mov  w4, #PP_COND_ACTIVE
    csel w3, w4, w3, ne
    strb w3, [x2, x1]

    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

.Lelif_was_active:
    // Previous branch was active → mark DONE, skip rest
    adrp x0, _kcc_pp_cond_depth@@PAGE
    add  x0, x0, _kcc_pp_cond_depth@@PAGEOFF
    ldr  x0, [x0]
    sub  x1, x0, #1
    adrp x2, _kcc_pp_cond_stack@@PAGE
    add  x2, x2, _kcc_pp_cond_stack@@PAGEOFF
    mov  w3, #PP_COND_DONE
    strb w3, [x2, x1]
    bl _kcc_pp_skip_line
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

.Lelif_done_skip:
    bl _kcc_pp_skip_line
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

.Lelif_stray:
    adrp x0, _kcc_pp_dir_line@@PAGE
    add  x0, x0, _kcc_pp_dir_line@@PAGEOFF
    ldr  x0, [x0]
    mov  x1, #1
    adrp x2, _kcc_pp_err_stray_elif@@PAGE
    add  x2, x2, _kcc_pp_err_stray_elif@@PAGEOFF
    bl _kcc_diag_error
    bl _kcc_pp_skip_line
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@}

\paragraph{\texttt{\#else}, \texttt{\#endif}, and the conditional push helper.}
The \texttt{\#else} directive toggles the conditional stack: if the
current branch was \texttt{ACTIVE} it becomes \texttt{DONE}, and if
it was \texttt{SKIP} it becomes \texttt{ACTIVE}.  \texttt{\#endif}
simply pops the stack by decrementing the depth counter.
\texttt{\_kcc\_pp\_cond\_push} is the shared helper that stores a new
state byte onto the stack and increments the depth.

@d PP: conditional @{
// -- _kcc_pp_do_else ------------------------------------------------
.p2align 2
_kcc_pp_do_else:
    stp x29, x30, [sp, #-16]!
    mov x29, sp

    adrp x0, _kcc_pp_cond_depth@@PAGE
    add  x0, x0, _kcc_pp_cond_depth@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lelse_stray

    sub  x1, x0, #1
    adrp x2, _kcc_pp_cond_stack@@PAGE
    add  x2, x2, _kcc_pp_cond_stack@@PAGEOFF
    ldrb w3, [x2, x1]

    cmp  w3, #PP_COND_ACTIVE
    b.eq .Lelse_was_active
    cmp  w3, #PP_COND_DONE
    b.eq .Lelse_keep_done

    // Was SKIP → now ACTIVE
    mov  w3, #PP_COND_ACTIVE
    strb w3, [x2, x1]
    bl _kcc_pp_skip_line
    ldp x29, x30, [sp], #16
    ret

.Lelse_was_active:
    mov  w3, #PP_COND_DONE
    strb w3, [x2, x1]
    bl _kcc_pp_skip_line
    ldp x29, x30, [sp], #16
    ret

.Lelse_keep_done:
    bl _kcc_pp_skip_line
    ldp x29, x30, [sp], #16
    ret

.Lelse_stray:
    adrp x0, _kcc_pp_dir_line@@PAGE
    add  x0, x0, _kcc_pp_dir_line@@PAGEOFF
    ldr  x0, [x0]
    mov  x1, #1
    adrp x2, _kcc_pp_err_stray_else@@PAGE
    add  x2, x2, _kcc_pp_err_stray_else@@PAGEOFF
    bl _kcc_diag_error
    bl _kcc_pp_skip_line
    ldp x29, x30, [sp], #16
    ret

// -- _kcc_pp_do_endif -----------------------------------------------
.p2align 2
_kcc_pp_do_endif:
    stp x29, x30, [sp, #-16]!
    mov x29, sp

    adrp x0, _kcc_pp_cond_depth@@PAGE
    add  x0, x0, _kcc_pp_cond_depth@@PAGEOFF
    ldr  x1, [x0]
    cbz  x1, .Lendif_stray

    sub  x1, x1, #1
    str  x1, [x0]
    bl _kcc_pp_skip_line
    ldp x29, x30, [sp], #16
    ret

.Lendif_stray:
    adrp x0, _kcc_pp_dir_line@@PAGE
    add  x0, x0, _kcc_pp_dir_line@@PAGEOFF
    ldr  x0, [x0]
    mov  x1, #1
    adrp x2, _kcc_pp_err_stray_endif@@PAGE
    add  x2, x2, _kcc_pp_err_stray_endif@@PAGEOFF
    bl _kcc_diag_error
    bl _kcc_pp_skip_line
    ldp x29, x30, [sp], #16
    ret

// -- _kcc_pp_cond_push ----------------------------------------------
// x0 = state to push
.p2align 2
_kcc_pp_cond_push:
    adrp x1, _kcc_pp_cond_depth@@PAGE
    add  x1, x1, _kcc_pp_cond_depth@@PAGEOFF
    ldr  x2, [x1]
    cmp  x2, #PP_MAX_COND
    b.hs .Lcpush_overflow
    adrp x3, _kcc_pp_cond_stack@@PAGE
    add  x3, x3, _kcc_pp_cond_stack@@PAGEOFF
    strb w0, [x3, x2]
    add  x2, x2, #1
    str  x2, [x1]
    ret
.Lcpush_overflow:
    ret                        // silently cap depth
@}

When the preprocessor is skipping tokens inside a false conditional
branch, it must still track nested \texttt{\#if}/\texttt{\#endif}
pairs so that a matching \texttt{\#endif} pops the correct level.
\texttt{\_kcc\_pp\_skip\_directive} examines directives encountered
during skipping: \texttt{\#if}, \texttt{\#ifdef}, and
\texttt{\#ifndef} push a new \texttt{DONE} state, \texttt{\#endif}
pops a level, and \texttt{\#elif}/\texttt{\#else} toggle the top of
the conditional stack when the depth matches.  The pushed state is
\texttt{DONE} rather than \texttt{SKIP} precisely because the nested
conditional is already dead: \texttt{DONE} keeps every one of its
branches skipped, whereas \texttt{SKIP} would treat a nested
\texttt{\#else} as the branch to take and wrongly resume compilation
inside the dead region.

@d PP: conditional @{
// -- _kcc_pp_skip_directive -----------------------------------------
// Handle directives encountered while skipping (conditional false).
// Only #if/#ifdef/#ifndef (push), #elif/#else (toggle), #endif (pop)
// are meaningful; all others are ignored.
.p2align 2
_kcc_pp_skip_directive:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    // Save directive line
    adrp x0, _kcc_tok_line@@PAGE
    add  x0, x0, _kcc_tok_line@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_pp_dir_line@@PAGE
    add  x1, x1, _kcc_pp_dir_line@@PAGEOFF
    str  x0, [x1]

    // Read directive name
    bl _kcc_lex_next
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    // Directive name can be TOK_IDENT(1) or a keyword(10-53)
    cmp  x0, #TOK_IDENT
    b.eq .Lskipd_has_name
    cmp  x0, #10
    b.lt .Lskipd_done
    cmp  x0, #53
    b.gt .Lskipd_done
.Lskipd_has_name:

    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x19, [x0]
    adrp x0, _kcc_tok_len@@PAGE
    add  x0, x0, _kcc_tok_len@@PAGEOFF
    ldr  x20, [x0]

    // Check for "if" (2), "ifdef" (5), "ifndef" (6) → push SKIP
    cmp x20, #2
    b.ne .Lskipd_not2
    mov x0, x19
    adrp x1, _kcc_pp_s_if@@PAGE
    add  x1, x1, _kcc_pp_s_if@@PAGEOFF
    mov x2, #2
    bl _kcc_memcmp
    cbz x0, .Lskipd_push
    b .Lskipd_done
.Lskipd_not2:

    cmp x20, #5
    b.ne .Lskipd_not5
    mov x0, x19
    adrp x1, _kcc_pp_s_ifdef@@PAGE
    add  x1, x1, _kcc_pp_s_ifdef@@PAGEOFF
    mov x2, #5
    bl _kcc_memcmp
    cbz x0, .Lskipd_push
    mov x0, x19
    adrp x1, _kcc_pp_s_endif@@PAGE
    add  x1, x1, _kcc_pp_s_endif@@PAGEOFF
    mov x2, #5
    bl _kcc_memcmp
    cbz x0, .Lskipd_endif
    b .Lskipd_done
.Lskipd_not5:

    cmp x20, #6
    b.ne .Lskipd_not6
    mov x0, x19
    adrp x1, _kcc_pp_s_ifndef@@PAGE
    add  x1, x1, _kcc_pp_s_ifndef@@PAGEOFF
    mov x2, #6
    bl _kcc_memcmp
    cbz x0, .Lskipd_push
    b .Lskipd_check46
.Lskipd_not6:

.Lskipd_check46:
    // Check "elif" (4), "else" (4)
    cmp x20, #4
    b.ne .Lskipd_done
    mov x0, x19
    adrp x1, _kcc_pp_s_elif@@PAGE
    add  x1, x1, _kcc_pp_s_elif@@PAGEOFF
    mov x2, #4
    bl _kcc_memcmp
    cbz x0, .Lskipd_elif
    mov x0, x19
    adrp x1, _kcc_pp_s_else@@PAGE
    add  x1, x1, _kcc_pp_s_else@@PAGEOFF
    mov x2, #4
    bl _kcc_memcmp
    cbz x0, .Lskipd_else
    b .Lskipd_done

.Lskipd_push:
    // Nested #if/#ifdef/#ifndef while skipping: the whole nested conditional
    // lies in a dead region, so push DONE, not SKIP.  DONE makes a nested
    // #else/#elif keep skipping; SKIP would let a nested #else \emph{activate}
    // and resume processing code inside the dead branch (the bug that made a
    // 64-bit build wrongly compile Lua's 32-bit `#else` fallback).
    mov x0, #PP_COND_DONE
    bl _kcc_pp_cond_push
    b .Lskipd_done

.Lskipd_endif:
    bl _kcc_pp_do_endif
    b .Lskipd_ret

.Lskipd_elif:
    bl _kcc_pp_do_elif
    b .Lskipd_ret

.Lskipd_else:
    bl _kcc_pp_do_else
    b .Lskipd_ret

.Lskipd_done:
    bl _kcc_pp_skip_line
.Lskipd_ret:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@}

\section{Expression Evaluation for \texttt{\#if}}

The \texttt{\#if} and \texttt{\#elif} directives require evaluating
a constant integer expression (\stdref{6.6}).  We implement the full
integer operator set as a recursive-descent cascade, one function per
precedence level: logical \texttt{||}, \texttt{\&\&}; bitwise \texttt{|},
\texttt{\^{}}, \texttt{\&}; equality and relational comparisons; the
shifts \texttt{<<}, \texttt{>>}; additive \texttt{+}, \texttt{-};
multiplicative \texttt{*}, \texttt{/}, \texttt{\%}; the unary operators
\texttt{!}, \texttt{\~{}}, \texttt{-}, \texttt{+}; and primaries---integer
literals, parenthesised sub-expressions, \texttt{defined(NAME)}, and macro
names (fully expanded, then~0 for any identifier left undefined).

Any identifier not recognized as a macro evaluates to~0 per
\stdref{6.10.1} paragraph~4.

@d PP: eval @{
.text
// -- _kcc_pp_eval_expr ----------------------------------------------
// Evaluates #if expression. Token stream already set up.
// Returns x0 = integer result.
.globl _kcc_pp_eval_expr
.p2align 2
_kcc_pp_eval_expr:
    // Entry point: delegate to the conditional (ternary) operator
    b _kcc_pp_eval_ternary

// -- Conditional: cond ? then : else  (right-associative, lowest precedence)
.p2align 2
_kcc_pp_eval_ternary:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    bl _kcc_pp_eval_lor
    mov x19, x0                // condition

    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_QUESTION
    b.ne .Leval_ter_done

    bl _kcc_lex_next           // consume ?
    bl _kcc_pp_eval_expr       // then-branch (runs up to the :)
    mov x20, x0                // then value

    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_COLON
    b.ne .Leval_ter_noelse
    bl _kcc_lex_next           // consume :
.Leval_ter_noelse:
    bl _kcc_pp_eval_ternary    // else-branch (right-associative)

    // Both branches are side-effect-free constant expressions, so evaluating
    // both to advance the token stream and selecting is safe.
    cmp  x19, #0
    csel x0, x20, x0, ne       // cond nonzero → then, else → else
    ldp  x19, x20, [sp, #16]
    ldp  x29, x30, [sp], #32
    ret

.Leval_ter_done:
    mov  x0, x19
    ldp  x19, x20, [sp, #16]
    ldp  x29, x30, [sp], #32
    ret

// -- Logical OR: expr || expr
.p2align 2
_kcc_pp_eval_lor:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    bl _kcc_pp_eval_land
    mov x19, x0

.Leval_lor_loop:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_OR           // ||
    b.ne .Leval_lor_done

    bl _kcc_lex_next           // consume ||
    bl _kcc_pp_eval_land
    orr  x19, x19, x0
    cmp  x19, #0
    cset x19, ne
    b .Leval_lor_loop

.Leval_lor_done:
    mov  x0, x19
    ldr  x19, [sp, #16]
    ldp  x29, x30, [sp], #32
    ret

// -- Logical AND: expr && expr
.p2align 2
_kcc_pp_eval_land:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    bl _kcc_pp_eval_bor
    mov x19, x0

.Leval_land_loop:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_AND          // &&
    b.ne .Leval_land_done

    bl _kcc_lex_next
    bl _kcc_pp_eval_bor
    and  x0, x19, x0
    cmp  x0, #0
    cset x19, ne
    b .Leval_land_loop

.Leval_land_done:
    mov  x0, x19
    ldr  x19, [sp, #16]
    ldp  x29, x30, [sp], #32
    ret
@| _kcc_pp_eval_expr _kcc_pp_eval_ternary
@}

Below the logical operators sit the three bitwise levels---%
\texttt{|}, then \texttt{\^{}}, then \texttt{\&}---each a left-associative
fold over the level beneath it.  A preprocessor constant expression is a
full integer constant expression (\stdref{6.6}), so these are the same
operators C allows outside \texttt{\#if}; real headers use them to test
feature bitmasks (\texttt{\#if (FLAGS \& X)}).

@d PP: eval @{
// -- Bitwise OR: expr | expr
.p2align 2
_kcc_pp_eval_bor:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]
    bl _kcc_pp_eval_bxor
    mov x19, x0
.Leval_bor_loop:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_PIPE
    b.ne .Leval_bor_done
    bl _kcc_lex_next
    bl _kcc_pp_eval_bxor
    orr  x19, x19, x0
    b .Leval_bor_loop
.Leval_bor_done:
    mov  x0, x19
    ldr  x19, [sp, #16]
    ldp  x29, x30, [sp], #32
    ret

// -- Bitwise XOR: expr ^ expr
.p2align 2
_kcc_pp_eval_bxor:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]
    bl _kcc_pp_eval_band
    mov x19, x0
.Leval_bxor_loop:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_CARET
    b.ne .Leval_bxor_done
    bl _kcc_lex_next
    bl _kcc_pp_eval_band
    eor  x19, x19, x0
    b .Leval_bxor_loop
.Leval_bxor_done:
    mov  x0, x19
    ldr  x19, [sp, #16]
    ldp  x29, x30, [sp], #32
    ret

// -- Bitwise AND: expr & expr
.p2align 2
_kcc_pp_eval_band:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]
    bl _kcc_pp_eval_eq
    mov x19, x0
.Leval_band_loop:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_AMP
    b.ne .Leval_band_done
    bl _kcc_lex_next
    bl _kcc_pp_eval_eq
    and  x19, x19, x0
    b .Leval_band_loop
.Leval_band_done:
    mov  x0, x19
    ldr  x19, [sp, #16]
    ldp  x29, x30, [sp], #32
    ret
@| _kcc_pp_eval_bor _kcc_pp_eval_bxor _kcc_pp_eval_band
@}

The equality and relational operators form the next two precedence
levels.  \texttt{\_kcc\_pp\_eval\_eq} handles \texttt{==} and
\texttt{!=} by comparing the integer values returned from
\texttt{\_kcc\_pp\_eval\_rel}, which in turn handles \texttt{<},
\texttt{>}, \texttt{<=}, and \texttt{>=}.  All comparisons yield
either~0 or~1 using the ARM64 \texttt{cset} instruction with the
appropriate condition code.

@d PP: eval @{
// -- Equality: expr == expr, expr != expr
.p2align 2
_kcc_pp_eval_eq:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    bl _kcc_pp_eval_rel
    mov x19, x0

.Leval_eq_loop:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x20, [x0]
    cmp  x20, #TOK_EQ
    b.eq .Leval_eq_op
    cmp  x20, #TOK_NE
    b.eq .Leval_eq_op
    b .Leval_eq_done

.Leval_eq_op:
    bl _kcc_lex_next
    bl _kcc_pp_eval_rel
    cmp  x20, #TOK_EQ
    b.eq .Leval_do_eq
    // !=
    cmp  x19, x0
    cset x19, ne
    b .Leval_eq_loop
.Leval_do_eq:
    cmp  x19, x0
    cset x19, eq
    b .Leval_eq_loop

.Leval_eq_done:
    mov  x0, x19
    ldp  x19, x20, [sp, #16]
    ldp  x29, x30, [sp], #32
    ret

// -- Relational: < > <= >=
.p2align 2
_kcc_pp_eval_rel:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    bl _kcc_pp_eval_shift
    mov x19, x0

.Leval_rel_loop:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x20, [x0]
    cmp  x20, #TOK_LT
    b.eq .Leval_rel_op
    cmp  x20, #TOK_GT
    b.eq .Leval_rel_op
    cmp  x20, #TOK_LE
    b.eq .Leval_rel_op
    cmp  x20, #TOK_GE
    b.eq .Leval_rel_op
    b .Leval_rel_done

.Leval_rel_op:
    bl _kcc_lex_next
    bl _kcc_pp_eval_shift
    cmp  x20, #TOK_LT
    b.eq .Leval_do_lt
    cmp  x20, #TOK_GT
    b.eq .Leval_do_gt
    cmp  x20, #TOK_LE
    b.eq .Leval_do_le
    // >=
    cmp  x19, x0
    cset x19, ge
    b .Leval_rel_loop
.Leval_do_lt:
    cmp  x19, x0
    cset x19, lt
    b .Leval_rel_loop
.Leval_do_gt:
    cmp  x19, x0
    cset x19, gt
    b .Leval_rel_loop
.Leval_do_le:
    cmp  x19, x0
    cset x19, le
    b .Leval_rel_loop

.Leval_rel_done:
    mov  x0, x19
    ldp  x19, x20, [sp, #16]
    ldp  x29, x30, [sp], #32
    ret
@}

Beneath the relational operators come the shift, additive, and
multiplicative levels---the arithmetic a real configuration header relies
on (\texttt{\#if VERSION >= 5 * 100 + 4}, \texttt{\#if (N >> 3) == 1}).
Each is a left-associative fold; division and remainder use signed
\texttt{sdiv}, and because ARM64 \texttt{sdiv} yields zero rather than
trapping on a zero divisor, an ill-formed \texttt{\#if X / 0} degrades to
zero instead of crashing the compiler.  Right shift uses the \emph{logical}
\texttt{lsr}: preprocessor \texttt{\#if} shifts are practically always
bit-width probes of an unsigned maximum---\texttt{\#if ((ULONG\_MAX >> 31)
>> 31) >= 3}, the idiom by which a header asks ``is this type at least 64
bits?''---where an arithmetic shift of the all-ones \texttt{ULONG\_MAX}
(which reads as \texttt{-1}) would stay \texttt{-1} and pick the wrong
branch.  Logical shift is also correct for any non-negative signed operand;
only a negative signed operand would differ, and that is both rare and
implementation-defined.

@d PP: eval @{
// -- Shift: expr << expr, expr >> expr
.p2align 2
_kcc_pp_eval_shift:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    bl _kcc_pp_eval_add
    mov x19, x0
.Leval_shift_loop:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x20, [x0]
    cmp  x20, #TOK_SHL
    b.eq .Leval_shift_op
    cmp  x20, #TOK_SHR
    b.eq .Leval_shift_op
    b .Leval_shift_done
.Leval_shift_op:
    bl _kcc_lex_next
    bl _kcc_pp_eval_add
    cmp  x20, #TOK_SHL
    b.ne .Leval_do_shr
    lsl  x19, x19, x0
    b .Leval_shift_loop
.Leval_do_shr:
    lsr  x19, x19, x0          // logical: correct for unsigned (and non-negative
                               // signed) operands, which is every real #if use
    b .Leval_shift_loop
.Leval_shift_done:
    mov  x0, x19
    ldp  x19, x20, [sp, #16]
    ldp  x29, x30, [sp], #32
    ret

// -- Additive: expr + expr, expr - expr
.p2align 2
_kcc_pp_eval_add:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    bl _kcc_pp_eval_mul
    mov x19, x0
.Leval_add_loop:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x20, [x0]
    cmp  x20, #TOK_PLUS
    b.eq .Leval_add_op
    cmp  x20, #TOK_MINUS
    b.eq .Leval_add_op
    b .Leval_add_done
.Leval_add_op:
    bl _kcc_lex_next
    bl _kcc_pp_eval_mul
    cmp  x20, #TOK_PLUS
    b.ne .Leval_do_sub
    add  x19, x19, x0
    b .Leval_add_loop
.Leval_do_sub:
    sub  x19, x19, x0
    b .Leval_add_loop
.Leval_add_done:
    mov  x0, x19
    ldp  x19, x20, [sp, #16]
    ldp  x29, x30, [sp], #32
    ret

// -- Multiplicative: expr * expr, expr / expr, expr % expr
.p2align 2
_kcc_pp_eval_mul:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    bl _kcc_pp_eval_unary
    mov x19, x0
.Leval_mul_loop:
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x20, [x0]
    cmp  x20, #TOK_STAR
    b.eq .Leval_mul_op
    cmp  x20, #TOK_SLASH
    b.eq .Leval_mul_op
    cmp  x20, #TOK_PERCENT
    b.eq .Leval_mul_op
    b .Leval_mul_done
.Leval_mul_op:
    bl _kcc_lex_next
    bl _kcc_pp_eval_unary
    cmp  x20, #TOK_STAR
    b.eq .Leval_do_mul
    cmp  x20, #TOK_SLASH
    b.eq .Leval_do_div
    // %  → x19 - (x19 / x0) * x0
    sdiv x1, x19, x0
    msub x19, x1, x0, x19
    b .Leval_mul_loop
.Leval_do_mul:
    mul  x19, x19, x0
    b .Leval_mul_loop
.Leval_do_div:
    sdiv x19, x19, x0
    b .Leval_mul_loop
.Leval_mul_done:
    mov  x0, x19
    ldp  x19, x20, [sp, #16]
    ldp  x29, x30, [sp], #32
    ret
@| _kcc_pp_eval_shift _kcc_pp_eval_add _kcc_pp_eval_mul
@}

At the lowest precedence tier sit the unary and primary expressions.
\texttt{\_kcc\_pp\_eval\_unary} handles the unary operators
\texttt{!}, \texttt{\~{}}, \texttt{-}, and \texttt{+} by recursing and
then applying the corresponding operation (a leading \texttt{+} is a
no-op).
\texttt{\_kcc\_pp\_eval\_primary} recognizes four forms: integer
literals (parsed via \texttt{\_kcc\_pp\_atoi}), parenthesized
sub-expressions, the \texttt{defined} operator (with or without
parentheses), and bare identifiers---which evaluate to their macro
body as an integer, or to~0 if undefined per \stdref{6.10.1}/4.

@d PP: eval @{
// -- Unary: !expr, primary
.p2align 2
_kcc_pp_eval_unary:
    stp x29, x30, [sp, #-16]!
    mov x29, sp

    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_BANG
    b.eq .Leval_un_not
    cmp  x0, #TOK_TILDE
    b.eq .Leval_un_bnot
    cmp  x0, #TOK_MINUS
    b.eq .Leval_un_neg
    cmp  x0, #TOK_PLUS
    b.eq .Leval_un_pos
    b .Leval_primary

.Leval_un_not:
    bl _kcc_lex_next
    bl _kcc_pp_eval_unary
    cmp  x0, #0
    cset x0, eq                // !x
    ldp  x29, x30, [sp], #16
    ret

.Leval_un_bnot:
    bl _kcc_lex_next
    bl _kcc_pp_eval_unary
    mvn  x0, x0                // ~x
    ldp  x29, x30, [sp], #16
    ret

.Leval_un_neg:
    bl _kcc_lex_next
    bl _kcc_pp_eval_unary
    neg  x0, x0                // -x
    ldp  x29, x30, [sp], #16
    ret

.Leval_un_pos:
    bl _kcc_lex_next
    bl _kcc_pp_eval_unary      // +x is a no-op
    ldp  x29, x30, [sp], #16
    ret

.Leval_primary:
    bl _kcc_pp_eval_primary
    ldp  x29, x30, [sp], #16
    ret
@}

\paragraph{Primary expressions and integer parsing.}
A primary expression in a preprocessor \texttt{\#if} context is one
of four forms: an integer literal, a parenthesized sub-expression,
the \texttt{defined} operator (with or without parentheses around the
macro name), or a bare identifier that is looked up as a macro and
converted to an integer---defaulting to~0 for undefined names per
\stdref{6.10.1} paragraph~4.  The helper \texttt{\_kcc\_pp\_atoi}
performs simple decimal ASCII-to-integer conversion.

@d PP: eval @{
// -- Primary: number, defined(X), defined X, (expr), ident→0
.p2align 2
_kcc_pp_eval_primary:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]

    // Number literal
    cmp  x0, #TOK_NUMBER
    b.eq .Leval_number

    // Parenthesized expression
    cmp  x0, #TOK_LPAREN
    b.eq .Leval_paren

    // Identifier
    cmp  x0, #TOK_IDENT
    b.eq .Leval_ident

    // EOF or unknown → 0
    mov  x0, #0
    ldr  x19, [sp, #16]
    ldp  x29, x30, [sp], #32
    ret

.Leval_number:
    // Parse integer from token text
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_tok_len@@PAGE
    add  x1, x1, _kcc_tok_len@@PAGEOFF
    ldr  x1, [x1]
    bl _kcc_pp_atoi
    mov  x19, x0
    bl _kcc_lex_next
    mov  x0, x19
    ldr  x19, [sp, #16]
    ldp  x29, x30, [sp], #32
    ret

.Leval_paren:
    bl _kcc_lex_next           // consume (
    bl _kcc_pp_eval_expr
    mov  x19, x0
    // Expect )
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_RPAREN
    b.ne .Leval_paren_done
    bl _kcc_lex_next           // consume )
.Leval_paren_done:
    mov  x0, x19
    ldr  x19, [sp, #16]
    ldp  x29, x30, [sp], #32
    ret
@}

\paragraph{Identifier and \texttt{defined} operator handling.}
Identifiers in a preprocessor constant expression require special
treatment.  The \texttt{defined} operator tests whether a macro name
exists in the macro table, returning~1 or~0 without expanding it; both
\texttt{defined(NAME)} and \texttt{defined NAME} forms are accepted per
\stdref{6.10.1}.  Any other identifier is looked up as a macro and its
body parsed as an integer; undefined names evaluate to~0.

@d PP: eval @{
.Leval_ident:
    // Check for "defined"
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_tok_len@@PAGE
    add  x1, x1, _kcc_tok_len@@PAGEOFF
    ldr  x1, [x1]
    cmp  x1, #7
    b.ne .Leval_ident_macro

    adrp x1, _kcc_pp_s_defined@@PAGE
    add  x1, x1, _kcc_pp_s_defined@@PAGEOFF
    mov  x2, #7
    bl _kcc_memcmp
    cbnz x0, .Leval_ident_macro

    // "defined" operator
    bl _kcc_lex_next
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_LPAREN
    b.eq .Leval_defined_paren

    // defined IDENT (without parens)
    cmp  x0, #TOK_IDENT
    b.ne .Leval_defined_zero
    b .Leval_defined_check

.Leval_defined_paren:
    bl _kcc_lex_next           // get IDENT
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_IDENT
    b.ne .Leval_defined_zero

.Leval_defined_check:
    // Look up macro
    adrp x0, _kcc_pp_macros@@PAGE
    add  x0, x0, _kcc_pp_macros@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_tok_start@@PAGE
    add  x1, x1, _kcc_tok_start@@PAGEOFF
    ldr  x1, [x1]
    adrp x2, _kcc_tok_len@@PAGE
    add  x2, x2, _kcc_tok_len@@PAGEOFF
    ldr  x2, [x2]
    bl _kcc_ht_get
    cmp  x0, #0
    cset x19, ne               // 1 if defined, 0 if not

    // Skip closing ) if present
    bl _kcc_lex_next
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_RPAREN
    b.ne .Leval_defined_noparen
    bl _kcc_lex_next
.Leval_defined_noparen:
    mov  x0, x19
    ldr  x19, [sp, #16]
    ldp  x29, x30, [sp], #32
    ret

.Leval_defined_zero:
    mov  x0, #0
    bl _kcc_lex_next
    ldr  x19, [sp, #16]
    ldp  x29, x30, [sp], #32
    ret

.Leval_ident_macro:
    // Regular identifier → look up as macro, expand to 0 if not found
    // Per §6.10.1p4: remaining identifiers → 0
    adrp x0, _kcc_pp_macros@@PAGE
    add  x0, x0, _kcc_pp_macros@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_tok_start@@PAGE
    add  x1, x1, _kcc_tok_start@@PAGEOFF
    ldr  x1, [x1]
    adrp x2, _kcc_tok_len@@PAGE
    add  x2, x2, _kcc_tok_len@@PAGEOFF
    ldr  x2, [x2]
    bl _kcc_ht_get
    cbz  x0, .Leval_ident_zero

    // Found macro: fully expand and evaluate its body (handles macro chains
    // and expression bodies, per §6.10.1's full macro replacement).
    bl _kcc_pp_eval_macro
    mov  x19, x0
    bl _kcc_lex_next
    mov  x0, x19
    ldr  x19, [sp, #16]
    ldp  x29, x30, [sp], #32
    ret

.Leval_ident_zero:
    mov  x0, #0
    bl _kcc_lex_next
    ldr  x19, [sp, #16]
    ldp  x29, x30, [sp], #32
    ret
@}

\paragraph{Recursively evaluating a macro body.}
A one-token object-like macro whose body is a number, such as
\texttt{\#define LUA\_FLOAT\_DOUBLE 2}, could be handled by parsing the
body as an integer.  But real headers chain macros---%
\texttt{\#define LUA\_FLOAT\_TYPE LUA\_FLOAT\_DOUBLE}---and give them
parenthesised expression bodies, and \stdref{6.10.1} requires the whole
controlling expression to undergo full macro replacement before it is
evaluated.  Rather than parse the body as a flat integer, we re-point the
lexer at the macro's replacement text and evaluate it with the same
recursive-descent parser.  A body that is itself a macro name recurses
back through this routine until it bottoms out at a number or an
undefined identifier (which is~0), so an arbitrarily long chain resolves
correctly; a parenthesised or arithmetic body is evaluated as the
expression it is.  A depth counter guards against a macro that expands to
itself, which \stdref{6.10.3.4} forbids from re-expanding but which we
must at least not loop on.

@d PP: eval @{
// -- _kcc_pp_eval_macro ---------------------------------------------
// int64_t _kcc_pp_eval_macro(pp_macro *m)
//   x0 = macro entry.  Returns the integer value of its expanded body.
// Saves the lexer over the #if line, evaluates the body, and restores it
// so the caller resumes at the token after the macro identifier.
.p2align 2
_kcc_pp_eval_macro:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]
    mov x19, x0                  // macro entry

    // Depth guard: bail to 0 rather than loop on a self-referential macro.
    adrp x2, _kcc_pp_eval_depth@@PAGE
    add  x2, x2, _kcc_pp_eval_depth@@PAGEOFF
    ldr  x1, [x2]
    cmp  x1, #64
    b.ge .Lem_zero
    add  x1, x1, #1
    str  x1, [x2]

    // Save the current lexer position (cursor sits just past the identifier).
    adrp x0, _kcc_lex_cursor@@PAGE
    add  x0, x0, _kcc_lex_cursor@@PAGEOFF
    ldr  x20, [x0]
    adrp x0, _kcc_lex_end@@PAGE
    add  x0, x0, _kcc_lex_end@@PAGEOFF
    ldr  x21, [x0]

    // Point the lexer at the macro body and evaluate it as an expression.
    ldr  x0, [x19, #PP_MACRO_BODY]
    ldr  x1, [x19, #PP_MACRO_BODYLEN]
    adrp x2, _kcc_lex_cursor@@PAGE
    add  x2, x2, _kcc_lex_cursor@@PAGEOFF
    str  x0, [x2]
    add  x1, x0, x1
    adrp x2, _kcc_lex_end@@PAGE
    add  x2, x2, _kcc_lex_end@@PAGEOFF
    str  x1, [x2]

    bl _kcc_lex_next
    bl _kcc_pp_eval_expr
    mov  x19, x0                 // result

    // Restore the lexer to the #if line.
    adrp x0, _kcc_lex_cursor@@PAGE
    add  x0, x0, _kcc_lex_cursor@@PAGEOFF
    str  x20, [x0]
    adrp x0, _kcc_lex_end@@PAGE
    add  x0, x0, _kcc_lex_end@@PAGEOFF
    str  x21, [x0]

    // Decrement the depth guard.
    adrp x2, _kcc_pp_eval_depth@@PAGE
    add  x2, x2, _kcc_pp_eval_depth@@PAGEOFF
    ldr  x1, [x2]
    sub  x1, x1, #1
    str  x1, [x2]

    mov  x0, x19
    ldr  x21, [sp, #32]
    ldp  x19, x20, [sp, #16]
    ldp  x29, x30, [sp], #48
    ret

.Lem_zero:
    mov  x0, #0
    ldr  x21, [sp, #32]
    ldp  x19, x20, [sp, #16]
    ldp  x29, x30, [sp], #48
    ret
@}

\paragraph{Integer-constant parsing.}
The helper \texttt{\_kcc\_pp\_atoi} converts an integer-constant token to a
64-bit value, honouring the three C bases: a \texttt{0x}/\texttt{0X} prefix
selects hexadecimal, a bare leading \texttt{0} selects octal, and anything
else is decimal.  This matters because real headers gate on hex feature
masks (\texttt{\#if (FLAGS \& 0x04)}); a decimal-only reader would see
\texttt{0x04} as~0 and mis-evaluate every such test.  Each base accumulates
by its radix and stops at the first character that is not a digit of that
base---which also discards any \texttt{u}/\texttt{l} suffix---so no explicit
suffix handling is needed.  Constants here are non-negative; unary minus is
applied one precedence level up.

@d PP: eval @{
// -- _kcc_pp_atoi ---------------------------------------------------
// Integer-constant to value (hex/octal/decimal): x0=ptr, x1=len → x0=value
.p2align 2
_kcc_pp_atoi:
    mov  x2, #0                // accumulator
    mov  x3, #0                // index
    // Detect a 0x / 0X (hex) or bare-0 (octal) prefix.
    cmp  x1, #2
    b.lo .Latoi_dec            // too short for a prefix → decimal
    ldrb w4, [x0]
    cmp  w4, #'0'
    b.ne .Latoi_dec
    ldrb w4, [x0, #1]
    orr  w4, w4, #0x20         // fold case
    cmp  w4, #'x'
    b.eq .Latoi_hex
    b .Latoi_oct               // leading 0, not x → octal

.Latoi_dec:
    cmp  x3, x1
    b.hs .Latoi_done
    ldrb w4, [x0, x3]
    cmp  w4, #'0'
    b.lo .Latoi_done
    cmp  w4, #'9'
    b.hi .Latoi_done
    sub  w4, w4, #'0'
    mov  x5, #10
    mul  x2, x2, x5
    add  x2, x2, x4
    add  x3, x3, #1
    b .Latoi_dec

.Latoi_hex:
    mov  x3, #2                // skip "0x"
.Latoi_hex_loop:
    cmp  x3, x1
    b.hs .Latoi_done
    ldrb w4, [x0, x3]
    cmp  w4, #'0'
    b.lo .Latoi_done
    cmp  w4, #'9'
    b.hi .Latoi_hex_af
    sub  w4, w4, #'0'
    b .Latoi_hex_acc
.Latoi_hex_af:
    orr  w4, w4, #0x20         // fold case
    cmp  w4, #'a'
    b.lo .Latoi_done
    cmp  w4, #'f'
    b.hi .Latoi_done
    sub  w4, w4, #'a'
    add  w4, w4, #10
.Latoi_hex_acc:
    lsl  x2, x2, #4
    add  x2, x2, x4
    add  x3, x3, #1
    b .Latoi_hex_loop

.Latoi_oct:
    mov  x3, #1                // skip leading 0
.Latoi_oct_loop:
    cmp  x3, x1
    b.hs .Latoi_done
    ldrb w4, [x0, x3]
    cmp  w4, #'0'
    b.lo .Latoi_done
    cmp  w4, #'7'
    b.hi .Latoi_done
    sub  w4, w4, #'0'
    lsl  x2, x2, #3
    add  x2, x2, x4
    add  x3, x3, #1
    b .Latoi_oct_loop

.Latoi_done:
    mov  x0, x2
    ret
@}

