% 37b-codegen-frame.weft — function prologue/epilogue, frame, and ABI marshaling
%
% Split from 37-codegen.weft (structural refactor, no content changes):
% compile-function driver, vreg stack-slot offsets, and AAPCS64 argument
% marshaling.

\section{Compile Function}

Compiling one IR function proceeds in nine steps:
\begin{enumerate}
\item \textbf{Frame size.}  Pre-scan all \texttt{IR\_ALLOCA}
      instructions, sum their slot counts, then compute
      $\mathrm{align16}(16 + \mathit{vreg\_count} \times 8
      + \mathit{alloca\_slots} \times 8)$.
\item \textbf{Function start.}  Record the current code-buffer
      offset so the linker symbol gets the correct value.
\item \textbf{BB label table.}  Allocate a hash table that maps
      BB~IDs to code offsets, used by branch instructions.  The table
      is open-addressed and never resizes, so it must be sized to the
      function up front: its capacity is the next power of two at or
      above four times the block count (never below~64).  A fixed
      capacity would spin forever in \texttt{ht\_put} once a large
      function---a real tokenizer's \texttt{lex\_next}, say---exceeded
      it; sizing to the block count keeps the load factor low and the
      insertion loop bounded.
\item \textbf{Patch vector.}  A vector of
      $(\mathit{code\_offset}, \mathit{target\_bb\_id})$ pairs
      for forward branches that need back-patching.
\item \textbf{Prologue.}  For small frames ($\leq 504$ bytes),
      emit \texttt{STP\;x29,\;x30,\;[sp,\;\#-frame\_size]!};
      for larger frames, emit \texttt{SUB\;sp,\;sp,\;\#frame\_size}
      followed by \texttt{STP\;x29,\;x30,\;[sp]} using the
      signed-offset form, because the signed 7-bit \textsc{stp}/\textsc{ldp}
      immediate (scaled by~8) only covers $-512$
      to~$+504$; the epilogue's positive post-index hits the
      limit first.  Both paths finish with \texttt{MOV\;x29,\;sp}.
\item \textbf{Store arguments.}  Copy \texttt{x0}--\texttt{x7}
      to their corresponding vreg stack slots.
\item \textbf{Walk BBs.}  For each basic block, record its label
      offset in the hash table, then generate code for each
      instruction.
\item \textbf{Patch.}  Resolve all forward branch placeholders.
\item \textbf{Symbol.}  Register the function as a defined
      \texttt{N\_SECT\textbar N\_EXT} symbol with the Mach-O
      underscore prefix.
\end{enumerate}

@d CodeGen: compile function @{
// -- kcc_codegen_func ---
// void kcc_codegen_func(ir_func *func)
//   x0 = pointer to IR function
.text
.globl _kcc_codegen_func
.p2align 2
_kcc_codegen_func:
    stp x29, x30, [sp, #-112]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    stp x25, x26, [sp, #64]
    stp x27, x28, [sp, #80]

    mov x19, x0                    // x19 = ir_func

    // 1. Compute frame size via alloca pre-scan.
    //    Value slots: vreg_count * 8 (one 8-byte slot per vreg).
    //    Alloca storage: sum of all IR_ALLOCA.SRC1 values * 8.
    //    Each alloca records its running offset in SRC2.
    ldr x20, [x19, #IRF_VREG_N]   // vreg_count (temporary)

    // Store vreg_count (the alloca address computation reads it) and run
    // register allocation FIRST.  Allocation publishes _kcc_cg_promoted, so the
    // pre-scan below can leave every promoted scalar local out of the frame:
    // a local that lives in a register needs no stack slot.
    adrp x1, _kcc_cg_vreg_count@@PAGE
    add  x1, x1, _kcc_cg_vreg_count@@PAGEOFF
    str x20, [x1]
    mov x0, x19
    bl _kcc_cg_regalloc

    // Pre-scan: walk all BBs/instructions, find allocas, assign offsets
    mov x0, #0                     // running alloca slot offset
    ldr x1, [x19, #IRF_BLOCKS]    // blocks vec
    ldr x2, [x1, #VEC_COUNT]      // num BBs
    mov x3, #0                     // BB index
.Lcgf_alloca_scan_bb:
    cmp x3, x2
    b.ge .Lcgf_alloca_scan_done
    // save loop state to stack temp area [sp, #96..104]
    str x0, [sp, #96]
    str x2, [sp, #104]
    stp x1, x3, [sp, #88]         // x1=blocks_vec, x3=bb_idx overlapping — use 88,96 is taken
    // Actually use dedicated temp save
    stp x3, x2, [sp, #88]         // save bb_idx, bb_count
    str x0, [sp, #104]            // save running offset
    mov x0, x1                     // blocks vec
    mov x1, x3                     // index
    bl _kcc_vec_get
    ldr x4, [x0]                   // x4 = BB ptr
    ldr x4, [x4, #BB_FIRST]       // first instr
.Lcgf_alloca_scan_instr:
    cbz x4, .Lcgf_alloca_scan_next_bb
    ldr x5, [x4, #IR_OP]
    cmp x5, #IR_ALLOCA
    b.ne .Lcgf_alloca_scan_skip
    // A promoted scalar local lives in a register — give it no frame storage.
    adrp x5, _kcc_cg_promoted@@PAGE
    add  x5, x5, _kcc_cg_promoted@@PAGEOFF
    ldr x5, [x5]
    cbz x5, .Lcgf_alloca_store
    ldr x6, [x4, #IR_DEST]
    ldr x5, [x5, x6, lsl #3]
    cbnz x5, .Lcgf_alloca_scan_skip
.Lcgf_alloca_store:
    // Found alloca: store running offset in SRC2, advance by SRC1
    ldr x0, [sp, #104]            // running offset
    str x0, [x4, #IR_SRC2]        // record offset for this alloca
    ldr x5, [x4, #IR_SRC1]        // slot count
    cbz x5, .Lcgf_alloca_one
    add x0, x0, x5                // advance by slot count
    b .Lcgf_alloca_save
.Lcgf_alloca_one:
    add x0, x0, #1                // default: 1 slot
.Lcgf_alloca_save:
    str x0, [sp, #104]
.Lcgf_alloca_scan_skip:
    ldr x4, [x4, #IR_NEXT]
    b .Lcgf_alloca_scan_instr
.Lcgf_alloca_scan_next_bb:
    ldp x3, x2, [sp, #88]         // restore bb_idx, bb_count
    ldr x0, [sp, #104]            // running offset
    ldr x1, [x19, #IRF_BLOCKS]    // blocks vec (reload)
    add x3, x3, #1
    b .Lcgf_alloca_scan_bb
.Lcgf_alloca_scan_done:
    // x0 = total alloca slots (promoted locals excluded)
    mov x24, x0                    // total_alloca_slots
    // The vreg value area is sized by the colouring pass's slot count
    // (_kcc_cg_max_slot), which reuses one slot for many non-overlapping
    // spilled vregs; it equals the raw vreg count when colouring is inactive.
    adrp x1, _kcc_cg_max_slot@@PAGE
    add  x1, x1, _kcc_cg_max_slot@@PAGEOFF
    ldr x25, [x1]                  // max_slot (vreg value-slot count)

    // save_base = 16 + max_slot*8 + total_alloca*8 — the callee-save area
    // sits above the vreg slots and alloca storage, so those offsets (and the
    // frame-relative va_arg/stack-argument reads) are unaffected.
    lsl x1, x25, #3               // max_slot * 8
    lsl x0, x24, #3               // total_alloca_slots * 8
    add x0, x0, x1
    add x0, x0, #16                // + fp/lr
    adrp x1, _kcc_cg_save_base@@PAGE
    add  x1, x1, _kcc_cg_save_base@@PAGEOFF
    str x0, [x1]
    mov x2, x0                     // save_base

    // fp_save_base = save_base + gp_save_count*8 — the callee-saved d-registers
    // are spilled just above the general callee-saved area.
    adrp x1, _kcc_cg_save_count@@PAGE
    add  x1, x1, _kcc_cg_save_count@@PAGEOFF
    ldr x1, [x1]
    add x2, x2, x1, lsl #3        // x2 = fp_save_base = save_base + gp_saves*8
    adrp x1, _kcc_cg_fp_save_base@@PAGE
    add  x1, x1, _kcc_cg_fp_save_base@@PAGEOFF
    str x2, [x1]

    // frame_size = align16(fp_save_base + fp_save_count*8)
    adrp x1, _kcc_cg_fp_save_count@@PAGE
    add  x1, x1, _kcc_cg_fp_save_count@@PAGEOFF
    ldr x1, [x1]
    add x0, x2, x1, lsl #3
    add x0, x0, #15
    and x0, x0, #~15              // align to 16
    mov x20, x0                    // x20 = frame_size

    adrp x1, _kcc_cg_frame_size@@PAGE
    add  x1, x1, _kcc_cg_frame_size@@PAGEOFF
    str x20, [x1]

    // 2. Record function start offset
    bl _kcc_code_current_pos
    mov x21, x0                    // x21 = func_start_offset
    str x21, [x19, #IRF_LOWPC]     // low_pc for DWARF debug info

    // 3. Initialize BB label hash table (bb_id → code_offset), sized to
    //    the function's BB count: next power of two >= 4*bb_count, min 64.
    ldr x0, [x19, #IRF_BLOCKS]
    ldr x0, [x0, #VEC_COUNT]      // bb_count
    lsl x0, x0, #2                // 4 * bb_count (keeps load factor low)
    cmp x0, #64
    b.ls .Lcgf_bbcap_min
    sub x0, x0, #1
    clz x1, x0
    mov x2, #64
    sub x1, x2, x1                // 64 - clz(x-1)
    mov x2, #1
    lsl x0, x2, x1               // next power of two
    b .Lcgf_bbcap_done
.Lcgf_bbcap_min:
    mov x0, #64
.Lcgf_bbcap_done:
    bl _kcc_ht_init
    mov x22, x0                    // x22 = bb_labels ht

    // 4. Initialize forward-branch patch vec
    mov x0, #VEC_SIZE
    bl _kcc_arena_alloc
    mov x23, x0                    // x23 = patch vec
    mov x1, #PATCH_SIZE
    str x1, [x23, #VEC_ELEMSIZE]
    mov x1, #32
    str x1, [x23, #VEC_CAP]
    str xzr, [x23, #VEC_COUNT]

    mov x0, #512                   // 32 * 16
    bl _kcc_arena_alloc
    str x0, [x23, #VEC_DATA]

    // 5. Emit prologue
    cmp x20, #504
    b.hi .Lcgf_large_prologue

    // Small frame: stp x29, x30, [sp, #-frame_size]!
    mov x0, #29
    mov x1, #30
    mov x2, #31
    neg x3, x20
    asr x3, x3, #3
    bl _kcc_enc_stp_pre
    bl _kcc_code_emit32
    b .Lcgf_prologue_mov

.Lcgf_large_prologue:
    // Large frame: sub sp, sp, #frame_size (split when >4095) then stp x29,x30,[sp]
    mov x0, #31                    // rd = sp
    mov x1, #31                    // rn = sp
    mov x2, x20                    // frame_size
    bl _kcc_cg_emit_sub_imm
    // stp x29, x30, [sp, #0] — signed-offset form: 0xA9007BFD
    movz w0, #0x7BFD
    movk w0, #0xA900, lsl #16
    bl _kcc_code_emit32

.Lcgf_prologue_mov:
    // mov x29, sp → ADD x29, sp, #0
    mov x0, #29
    mov x1, #31
    mov x2, #0
    mov x3, #1
    bl _kcc_enc_add_imm
    bl _kcc_code_emit32

    // Save the callee-saved registers the allocator claimed.
    mov x0, #0
    bl _kcc_cg_callee_transfer
@| _kcc_codegen_func
@}

\paragraph{Adjusting a register by a large immediate}
A subtlety that surfaces on large functions is that \texttt{add}/\texttt{sub}
with an immediate encode it as a \emph{12-bit} unsigned field---a maximum of
4095.  Three sites can exceed that: the large-frame prologue
(\texttt{sub sp, sp, \#frame\_size}), the matching epilogue
(\texttt{add sp, sp, \#frame\_size}), and the address of a stack slot
(\texttt{add rd, x29, \#offset} for an \texttt{alloca} or a taken address).
A function with hundreds of locals or temporaries---a large \texttt{switch},
a deeply nested block, machine-generated code---pushes any of these past
4095, and a naive encoder silently overflows the immediate into the adjacent
\texttt{shift} bit, producing a tagged \textsc{addg}/\textsc{subg}
instruction that faults with an illegal-instruction trap at run time.

The ARM64 add/subtract-immediate format anticipates this: a \texttt{shift}
bit multiplies the 12-bit immediate by 4096, so any value up to $2^{24}-1$
splits into a \emph{high} part (bits 12--23, shifted) plus a \emph{low} part
(bits 0--11).  The first two helpers below emit exactly that---one instruction
when the value fits in 12 bits, otherwise the shifted high part followed by
the low part---for an arbitrary destination and source register.  All three
add/sub sites route through them, so frames and slot addresses of any
realistic size are computed correctly.  When the second instruction runs it
adds into the destination register (not the original source), so the two
parts accumulate.

The same 12-bit ceiling limits the \emph{other} frame instruction, the
\textsc{ldr}/\textsc{str} that reads or writes a stack slot: its immediate is
scaled by the access size, so an 8-byte load or store reaches only
$4095\times 8 = 32760$ bytes from \texttt{x29}.  A function whose frame
exceeds that---thousands of spilled temporaries, a callee-saved area high in a
large frame, an incoming stack argument above a big local region---cannot
address its upper slots with the scaled form.  The third helper,
\texttt{\_kcc\_cg\_emit\_frame\_ldst}, closes this: for an in-range offset it
emits the plain scaled instruction (so ordinary functions are unchanged), and
for a larger one it materialises the slot address in the scratch register
\texttt{x17} (through the add helper above, itself split when necessary) and
transfers through \texttt{[x17,\,\#0]}.  Every spill path---the integer and
floating vreg transfers, the callee-saved save/restore, and the incoming
stack-parameter spill---routes its load and store through it, so a frame of
any size is addressed correctly.

@d CodeGen: large immediate adjust @{
.text
// -- _kcc_cg_emit_add_imm ---
// void _kcc_cg_emit_add_imm(uint64_t rd, uint64_t rn, uint64_t imm)
// Emit `add rd, rn, #imm`, splitting into shifted-high + low when imm
// exceeds the 12-bit immediate (4095).  imm==0 emits a single `add rd,rn,#0`.
.p2align 2
_kcc_cg_emit_add_imm:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]
    mov x19, x0                    // rd
    mov x20, x1                    // rn (running source)
    mov x21, x2                    // imm
    lsr x9, x21, #12               // high = imm >> 12
    cbz x9, .Leai_low
    mov x0, x19
    mov x1, x20
    mov x2, x9
    mov x3, #1
    bl _kcc_enc_add_imm
    orr w0, w0, #0x400000          // set sh=1 → immediate shifted left by 12
    bl _kcc_code_emit32
    mov x20, x19                   // low part accumulates into rd
.Leai_low:
    and x2, x21, #0xFFF            // low = imm & 0xFFF
    lsr x9, x21, #12               // recompute high (x9 clobbered by emit)
    cbnz x2, .Leai_emit_low        // low nonzero → emit it
    cbnz x9, .Leai_done            // low zero but high already emitted → done
.Leai_emit_low:
    mov x0, x19
    mov x1, x20
    mov x3, #1
    bl _kcc_enc_add_imm
    bl _kcc_code_emit32
.Leai_done:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

// -- _kcc_cg_emit_sub_imm ---
// void _kcc_cg_emit_sub_imm(uint64_t rd, uint64_t rn, uint64_t imm)
// Emit `sub rd, rn, #imm`, splitting the same way as the add helper.
.p2align 2
_kcc_cg_emit_sub_imm:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]
    mov x19, x0                    // rd
    mov x20, x1                    // rn
    mov x21, x2                    // imm
    lsr x9, x21, #12
    cbz x9, .Lesi_low
    mov x0, x19
    mov x1, x20
    mov x2, x9
    mov x3, #1
    bl _kcc_enc_sub_imm
    orr w0, w0, #0x400000          // sh=1
    bl _kcc_code_emit32
    mov x20, x19
.Lesi_low:
    and x2, x21, #0xFFF
    lsr x9, x21, #12
    cbnz x2, .Lesi_emit_low
    cbnz x9, .Lesi_done
.Lesi_emit_low:
    mov x0, x19
    mov x1, x20
    mov x3, #1
    bl _kcc_enc_sub_imm
    bl _kcc_code_emit32
.Lesi_done:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

// -- _kcc_cg_emit_frame_ldst ---
// void _kcc_cg_emit_frame_ldst(uint64_t rt, uint64_t byte_off, uint64_t kind)
//   kind: 0 = LDR int, 1 = STR int, 2 = LDR fp, 3 = STR fp
// Emit a transfer between register rt and [x29 + byte_off].  A frame-relative
// unsigned-offset ldr/str scales its 12-bit immediate by the access size, so
// an 8-byte access can only reach 32760 bytes; beyond that the immediate would
// overflow.  For a larger offset the helper materialises the address in the
// intra-procedure scratch register x17 (add x17, x29, #byte_off, itself split
// when needed) and uses [x17, #0].  For an in-range offset it emits the plain
// scaled form, so small frames stay byte-for-byte identical to before.
.p2align 2
_kcc_cg_emit_frame_ldst:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]
    mov x19, x0                    // rt
    mov x20, x1                    // byte_off
    mov x21, x2                    // kind
    mov x0, x19                    // rt (for encoder)
    mov x9, #0x7FF8                // 32760 = 4095 * 8 (max scaled 8-byte reach)
    cmp x20, x9
    b.hi .Lefl_large
    // In range: rn = x29, imm12 = byte_off >> 3
    mov x1, #29
    lsr x2, x20, #3
    b .Lefl_encode
.Lefl_large:
    // Out of range: x17 = x29 + byte_off, then [x17, #0]
    mov x0, #17
    mov x1, #29
    mov x2, x20
    bl _kcc_cg_emit_add_imm
    mov x0, x19                    // rt
    mov x1, #17                    // rn = x17
    mov x2, #0                     // imm12 = 0
.Lefl_encode:
    // x0 = rt, x1 = rn, x2 = imm12; dispatch by kind
    cbz x21, .Lefl_ldr_int
    cmp x21, #1
    b.eq .Lefl_str_int
    cmp x21, #2
    b.eq .Lefl_ldr_fp
    bl _kcc_enc_str_fp             // kind == 3
    b .Lefl_emit
.Lefl_ldr_int:
    mov x3, #1
    bl _kcc_enc_ldr_imm
    b .Lefl_emit
.Lefl_str_int:
    mov x3, #1
    bl _kcc_enc_str_imm
    b .Lefl_emit
.Lefl_ldr_fp:
    bl _kcc_enc_ldr_fp
.Lefl_emit:
    bl _kcc_code_emit32
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_cg_emit_add_imm
@| _kcc_cg_emit_sub_imm
@| _kcc_cg_emit_frame_ldst
@}

\paragraph{Storing Register Arguments}
After the prologue, the compiler copies each register argument
(\texttt{x0}--\texttt{x7}) into its corresponding vreg stack slot.
The ARM64 calling convention passes the first eight integer
arguments in registers, so parameter~$k$ lands in register~$k$ and
must be spilled to \texttt{[x29,\;\#16\;+\;k\,*\,8]}.  The scaled
immediate for the unsigned-offset \textsc{str} is simply
$k + 2$, reusing the same slot-offset formula as the rest of the
all-spill backend.

Parameters beyond the eighth do not arrive in registers---the caller
places them on the stack (see the call lowering below).  Because the
caller pushes argument~$k$ at offset $(k-1)\times 8$ below its pre-call
stack pointer, and this callee's prologue subtracts \texttt{frame\_size}
from that same pointer, incoming parameter~$k$ ($k \ge 8$) is found at
\texttt{[x29,\;\#frame\_size\;+\;(k-1)\times 8]}.  The spill loop reads
each such parameter through scratch \texttt{x9} and stores it into its
own vreg slot, so from that point on a stack parameter is indistinguishable
from a register one.  This is \kcc{}'s own uniform slot convention rather
than the exact AAPCS64 stack-slot ordering; it is self-consistent for
\kcc{}-to-\kcc{} calls, which is what the corpus needs.

@d CodeGen: compile function @{
    // 6. Spill incoming parameters (AAPCS64) to their vreg stack slots.
    // Walk the parameters keeping NGRN (x26), NSRN (x27), and a running vreg
    // base ([sp,#96]) that advances by two for a 9..16-byte struct (which
    // occupies two vregs) and by one otherwise.  Each parameter is spilled
    // from x<ngrn>, d<nsrn>, or (a 9..16B struct) two general registers, per
    // its class in IRF_PARAM_CLS; a parameter that exhausts its register file
    // is read from the caller's stack image at [x29 + frame_size + (base-1)*8].
    ldr x24, [x19, #IRF_PARAMS]   // param count
    ldr x28, [x19, #IRF_PARAM_CLS] // per-param class array (may be 0)
    mov x25, #0                    // param index
    mov x26, #0                    // NGRN
    mov x27, #0                    // NSRN
    str xzr, [sp, #96]            // vreg base

.Lcgf_store_args:
    cmp x25, x24
    b.ge .Lcgf_walk_bbs
    mov x0, #0                     // class (default GP)
    cbz x28, .Lcgf_sa_have_cls
    ldr x0, [x28, x25, lsl #3]
.Lcgf_sa_have_cls:
    cmp x0, #1                     // FP?
    b.eq .Lcgf_sa_fp
    cmp x0, #5                     // hidden sret pointer (x8)?
    b.eq .Lcgf_sa_x8
    cmp x0, #3                     // ST2 (9..16B struct)?
    b.eq .Lcgf_sa_st2

    // GP / ST1 / REF: spill x<ngrn> into slot(base); base += 1
    cmp x26, #8
    b.ge .Lcgf_sa_stack
    ldr x0, [sp, #96]            // base vreg → colored slot immediate
    bl _kcc_cg_slot_offset
    mov x2, x0                   // imm12_scaled = slot(base) + 2
    mov x0, x26                    // rt = x<ngrn>
    mov x1, #29
    mov x3, #1
    bl _kcc_enc_str_imm
    bl _kcc_code_emit32
    add x26, x26, #1
    ldr x2, [sp, #96]
    add x2, x2, #1
    str x2, [sp, #96]
    b .Lcgf_sa_next

.Lcgf_sa_fp:
    cmp x27, #8
    b.ge .Lcgf_sa_stack
    ldr x0, [sp, #96]            // vreg = base
    mov x1, x27                    // fp reg = nsrn
    bl _kcc_cg_store_vreg_fp
    add x27, x27, #1
    ldr x2, [sp, #96]
    add x2, x2, #1
    str x2, [sp, #96]
    b .Lcgf_sa_next

.Lcgf_sa_x8:
    // Hidden result pointer: spill x8 into the sret vreg slot (no NGRN/NSRN).
    ldr x0, [sp, #96]            // base vreg → colored slot immediate
    bl _kcc_cg_slot_offset
    mov x2, x0
    mov x0, #8
    mov x1, #29
    mov x3, #1
    bl _kcc_enc_str_imm
    bl _kcc_code_emit32
    ldr x2, [sp, #96]
    add x2, x2, #1
    str x2, [sp, #96]
    b .Lcgf_sa_next

.Lcgf_sa_st2:
    // 9..16B struct in two registers: spill x<ngrn>→slot(base),
    // x<ngrn+1>→slot(base+1); base += 2.  The two vregs may map to
    // non-adjacent colored slots, so each is resolved separately.
    cmp x26, #6
    b.gt .Lcgf_sa_stack
    ldr x0, [sp, #96]            // base → slot(base)+2
    bl _kcc_cg_slot_offset
    mov x2, x0
    mov x0, x26
    mov x1, #29
    mov x3, #1
    bl _kcc_enc_str_imm
    bl _kcc_code_emit32
    ldr x0, [sp, #96]
    add x0, x0, #1               // base+1 → slot(base+1)+2
    bl _kcc_cg_slot_offset
    mov x2, x0
    add x0, x26, #1
    mov x1, #29
    mov x3, #1
    bl _kcc_enc_str_imm
    bl _kcc_code_emit32
    add x26, x26, #2
    ldr x2, [sp, #96]
    add x2, x2, #2
    str x2, [sp, #96]
    b .Lcgf_sa_next

.Lcgf_sa_stack:
    // Overflow: read from [x29 + frame_size + (base-S)*8] into x9, store to
    // slot(base); base += 1.  S is the caller's first-stack index: 1 for a
    // normal call, but 8 for a variadic callee, whose caller placed the
    // register-overflow fixed parameters at [sp,#(base-8)*8] (before the
    // variadic tail).  Both offsets can exceed the scaled immediate on a large
    // frame, so they route through the frame-ldst helper.
    ldr x0, [x19, #IRF_VARIADIC]
    cbz x0, .Lcgf_sa_s1
    ldr x1, [sp, #96]           // base
    sub x1, x1, #8               // variadic: (base-8)*8
    b .Lcgf_sa_soff
.Lcgf_sa_s1:
    // Normal call: the caller keyed its stack image by ARGUMENT index (arg k at
    // slot k-1), so the overflow read must use the parameter index, not the
    // running register-slot base.  They differ only when a by-value struct
    // precedes this parameter: an ST2 struct consumes two registers (base += 2)
    // but occupies one argument slot, so a base-relative offset read the arg one
    // slot too high (a 16B struct + enough ints to spill the last read the wrong
    // stack word).
    sub x1, x25, #1              // normal: (arg_index - 1)*8
.Lcgf_sa_soff:
    lsl x1, x1, #3
    add x1, x1, x20              // + frame_size  (x20 = frame_size) = byte offset
    mov x0, #9                   // rt = x9
    mov x2, #0                   // kind = LDR int
    bl _kcc_cg_emit_frame_ldst
    ldr x0, [sp, #96]           // base vreg → colored slot immediate
    bl _kcc_cg_slot_offset
    lsl x1, x0, #3               // byte offset from x29
    mov x0, #9                   // rt = x9
    mov x2, #1                   // kind = STR int
    bl _kcc_cg_emit_frame_ldst
    ldr x2, [sp, #96]
    add x2, x2, #1
    str x2, [sp, #96]

.Lcgf_sa_next:
    add x25, x25, #1
    b .Lcgf_store_args
@}

\paragraph{Walking Basic Blocks}
With the prologue in place and arguments spilled, the compiler
enters the main loop over basic blocks.  For each BB it records
the current code-buffer offset in the label hash table (keyed by
BB~ID) so that backward branches can compute their displacement
immediately.  It then walks the linked list of IR instructions
and delegates each one to \texttt{kcc\_codegen\_instr}, passing
the label table and patch vector as context.

@d CodeGen: compile function @{
.Lcgf_walk_bbs:
    // 7. Walk all BBs: get blocks vec from function
    ldr x24, [x19, #IRF_BLOCKS]   // blocks vec
    ldr x25, [x24, #VEC_COUNT]    // number of BBs
    mov x26, #0                    // BB index

.Lcgf_bb_loop:
    cmp x26, x25
    b.ge .Lcgf_patch

    // Get BB pointer
    mov x0, x24
    mov x1, x26
    bl _kcc_vec_get
    ldr x27, [x0]                  // x27 = current BB

    // Record BB label: bb_id → current code offset
    // Allocate persistent key buffer (8 bytes) so ht stores a unique pointer
    // (All entries must have distinct key pointers for memcmp during lookup)
    mov x0, #8
    bl _kcc_arena_alloc
    mov x28, x0                    // x28 = persistent key buffer
    ldr x1, [x27, #BB_ID]
    str x1, [x28]                  // store bb_id in arena-allocated memory

    // ht_put(bb_labels, key_ptr, 8, code_offset+1)
    bl _kcc_code_current_pos
    add x3, x0, #1                // value = offset + 1 (distinguish from 0)
    mov x0, x22                    // ht
    mov x1, x28                    // key = arena-allocated pointer to bb_id
    mov x2, #8                     // keylen = 8 bytes
    bl _kcc_ht_put

    // Walk instructions in this BB
    ldr x27, [x27, #BB_FIRST]     // first instruction

.Lcgf_instr_loop:
    cbz x27, .Lcgf_next_bb

    // Generate code for this instruction
    mov x0, x27                    // instruction
    mov x1, x22                    // bb_labels ht
    mov x2, x23                    // patch vec
    bl _kcc_codegen_instr

    // Next instruction
    ldr x27, [x27, #IR_NEXT]
    b .Lcgf_instr_loop

.Lcgf_next_bb:
    add x26, x26, #1
    b .Lcgf_bb_loop
@}

\paragraph{Patching Forward Branches and the Symbol Value}
Once every basic block has been lowered, two bookkeeping tasks
remain.  First, the forward-branch patch pass resolves all
placeholder \textsc{b} and \textsc{cbnz} instructions whose
targets were not yet known at emission time.  Second, the function's
linker symbol---already created by the pre-pass
(\S\ref{sec:preregister-globals}) with the correct underscore-prefixed
name, linkage, and extern-table entry, but a placeholder value of
zero---has its \texttt{SYM\_VALUE} patched to the code offset where the
function now begins.  Registering the symbol earlier (rather than here)
is what lets a call to a not-yet-compiled callee resolve to the
definition instead of a fresh undefined external; that mattered
especially for \texttt{static} callees, whose local symbols the linker
cannot coalesce a stray undefined reference against.  The linkage
itself is decided in the pre-pass: external
(\texttt{N\_SECT $\vert$ N\_EXT}) by default, local (\texttt{N\_SECT}
alone) for a \texttt{static} function or the synthesised
\texttt{kcc.module\_init}, so two units that each define a private
helper of the same name (for instance zlib's per-file
\texttt{fixedtables}) do not collide.

@d CodeGen: compile function @{
.Lcgf_patch:
    // 8. Patch forward branches
    mov x0, x22                    // bb_labels ht
    mov x1, x23                    // patch vec
    bl _kcc_codegen_patch_branches

    // 9. Patch the pre-registered function symbol's value to the code offset.
    // The symbol itself (with correct linkage and extern-table entry) was
    // created by _kcc_cg_preregister_funcs before any body was compiled, so
    // forward references have already resolved to it; here we only fill in the
    // value that was unknown until the function was laid out.
    ldr x26, [x19, #IRF_SYMIDX]   // pre-registered symbol index
    adrp x0, _kcc_linker_syms@@PAGE
    add  x0, x0, _kcc_linker_syms@@PAGEOFF
    ldr x0, [x0]
    ldr x0, [x0, #VEC_DATA]       // symbol entry array
    mov x1, #SYM_ENTRY_SIZE
    mul x1, x26, x1
    add x0, x0, x1                // &syms[idx]
    str x21, [x0, #SYM_VALUE]     // value = func_start_offset

.Lcgf_sym_done:
    ldp x27, x28, [sp, #80]
    ldp x25, x26, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #112
    ret
@}

\section{Vreg Slot Offset}

The ``all-spill'' strategy means every virtual register lives at a
fixed stack offset.  The frame layout (with x29 pointing to its
base) is:
\begin{verbatim}
  [x29 + 0]  : saved x29
  [x29 + 8]  : saved x30
  [x29 + 16] : vreg 0
  [x29 + 24] : vreg 1
  ...
  [x29 + 16 + N*8] : vreg N
\end{verbatim}

ARM64 unsigned-offset loads and stores encode the immediate as
\texttt{imm12\_scaled} = byte\_offset / access\_size.  For 64-bit
accesses the divisor is~8, so the slot at frame index~$S$ has
$\mathit{imm12\_scaled} = (16 + S \times 8)/8 = S + 2$.

The frame index~$S$ is \emph{not} the vreg number in general: the slot
colouring pass (\S\ref{sec:slotcolour}) reuses one slot for many spilled
vregs whose live ranges do not overlap, and publishes the mapping in
\texttt{\_kcc\_cg\_slotmap}.  \texttt{slot\_offset} is the single point that
turns a vreg into its scaled slot immediate: it applies the map (falling back
to the identity $S = \mathit{vreg}$ when no map is published, so the all-spill
model is unchanged), then adds the constant~2.  Every spill site---the
\texttt{load\_vreg}/\texttt{store\_vreg} family and the incoming-argument
spill---routes through it, so no caller ever assumes slot~$=$~vreg.

@d CodeGen: vreg slot offset @{
// -- kcc_cg_slot_offset ---
// uint64_t kcc_cg_slot_offset(uint64_t vreg)
// Returns the scaled imm12 value for a 64-bit LDR/STR to the vreg's spill slot:
// imm12_scaled = slotmap[vreg] + 2 (or vreg + 2 when no colouring map exists).
// Clobbers x0 (return) and x1 (scratch) only.
.text
.globl _kcc_cg_slot_offset
.p2align 2
_kcc_cg_slot_offset:
    adrp x1, _kcc_cg_slotmap@@PAGE
    add  x1, x1, _kcc_cg_slotmap@@PAGEOFF
    ldr x1, [x1]
    cbz x1, .Lso_ident
    ldr x0, [x1, x0, lsl #3]      // x0 = slotmap[vreg]
.Lso_ident:
    add x0, x0, #2                // imm12_scaled = slot + 2
    ret
@| _kcc_cg_slot_offset
@}

\paragraph{Register Transfers.}
With the offset calculation factored out, loading and storing virtual
registers becomes a thin wrapper around the ARM64 \textsc{ldr}/\textsc{str}
encoding helpers.  \texttt{\_kcc\_cg\_load\_vreg} emits a 64-bit
\texttt{LDR} from the vreg's stack slot into a scratch register
(\texttt{x9}--\texttt{x11}), while \texttt{\_kcc\_cg\_store\_vreg}
emits the corresponding \texttt{STR} to spill a scratch register back
to the slot.  Both use \texttt{x29} as the base register and the
scaled immediate computed by \texttt{\_kcc\_cg\_slot\_offset}.

@d CodeGen: vreg slot offset @{
// -- kcc_cg_load_vreg ---
// void kcc_cg_load_vreg(uint64_t vreg, uint64_t reg)
//   x0 = vreg number, x1 = target register number (9, 10, or 11)
// If the vreg is register-allocated (see the allocation map), emits a
// register move; otherwise a LDR from the vreg's stack slot.
.text
.globl _kcc_cg_load_vreg
.p2align 2
_kcc_cg_load_vreg:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    mov x19, x0                    // vreg
    mov x20, x1                    // target reg

    // A floating vreg lives in a d-register; move its 64-bit pattern into the
    // requested general register with FMOV so the integer paths (a double
    // stored to memory, say) see the right bits.
    adrp x0, _kcc_cg_fpregmap@@PAGE
    add  x0, x0, _kcc_cg_fpregmap@@PAGEOFF
    ldr x0, [x0]
    cbz x0, .Llv_gp
    ldr x0, [x0, x19, lsl #3]      // home d-reg (0 = not FP-allocated)
    cbz x0, .Llv_gp
    mov x1, x0                     // Rn = home d-reg
    mov x0, x20                    // Rd = target general reg
    bl _kcc_enc_fmov_x_d           // FMOV x<target>, d<home>
    bl _kcc_code_emit32
    b .Llv_done
.Llv_gp:
    adrp x0, _kcc_cg_regmap@@PAGE
    add  x0, x0, _kcc_cg_regmap@@PAGEOFF
    ldr x0, [x0]
    cbz x0, .Llv_spill
    ldr x0, [x0, x19, lsl #3]      // preg = map[vreg] (0 = spilled)
    cbz x0, .Llv_spill
    cmp x20, x0
    b.eq .Llv_done                 // already in the target register
    mov x1, x0                     // rm = preg
    mov x0, x20                    // rd = target reg
    mov x2, #1                     // sf = 64-bit
    bl _kcc_enc_mov_reg
    bl _kcc_code_emit32
    b .Llv_done
.Llv_spill:
    mov x0, x19                    // vreg → colored slot immediate
    bl _kcc_cg_slot_offset
    lsl x1, x0, #3                 // byte offset from x29
    mov x0, x20                    // rt = target reg
    mov x2, #0                     // kind = LDR int
    bl _kcc_cg_emit_frame_ldst
.Llv_done:
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- kcc_cg_store_vreg ---
// void kcc_cg_store_vreg(uint64_t vreg, uint64_t reg)
//   x0 = vreg number, x1 = source register number
// If the vreg is register-allocated, emits a register move into its physical
// register; otherwise a STR to the vreg's stack slot.
.text
.globl _kcc_cg_store_vreg
.p2align 2
_kcc_cg_store_vreg:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    mov x19, x0                    // vreg
    mov x20, x1                    // source reg

    // A floating vreg lives in a d-register; write the general-register value
    // (e.g. a materialised double constant, or a double loaded from memory)
    // into its home d-register with FMOV.
    adrp x0, _kcc_cg_fpregmap@@PAGE
    add  x0, x0, _kcc_cg_fpregmap@@PAGEOFF
    ldr x0, [x0]
    cbz x0, .Lsv_gp
    ldr x0, [x0, x19, lsl #3]      // home d-reg (0 = not FP-allocated)
    cbz x0, .Lsv_gp
    mov x1, x20                    // Rn = source general reg
    // x0 = home d-reg = Rd
    bl _kcc_enc_fmov_d_x           // FMOV d<home>, x<source>
    bl _kcc_code_emit32
    b .Lsv_done
.Lsv_gp:
    adrp x0, _kcc_cg_regmap@@PAGE
    add  x0, x0, _kcc_cg_regmap@@PAGEOFF
    ldr x0, [x0]
    cbz x0, .Lsv_spill
    ldr x0, [x0, x19, lsl #3]      // preg = map[vreg] (0 = spilled)
    cbz x0, .Lsv_spill
    cmp x20, x0
    b.eq .Lsv_done                 // value already in its physical register
    mov x1, x20                    // rm = source reg
    // x0 already = preg = rd
    mov x2, #1                     // sf = 64-bit
    bl _kcc_enc_mov_reg
    bl _kcc_code_emit32
    b .Lsv_done
.Lsv_spill:
    mov x0, x19                    // vreg → colored slot immediate
    bl _kcc_cg_slot_offset
    lsl x1, x0, #3                 // byte offset from x29
    mov x0, x20                    // rt = source reg
    mov x2, #1                     // kind = STR int
    bl _kcc_cg_emit_frame_ldst
.Lsv_done:
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- kcc_cg_promoted_reg ---
// uint64_t kcc_cg_promoted_reg(uint64_t vreg)
//   x0 = vreg number
// Returns the physical register holding a promoted scalar local's contents
// (mem2reg), or 0 if the vreg is not a promoted alloca.  The load/store/alloca
// handlers consult this to route a local's accesses to its register instead of
// memory.
.text
.globl _kcc_cg_promoted_reg
.p2align 2
_kcc_cg_promoted_reg:
    adrp x1, _kcc_cg_promoted@@PAGE
    add  x1, x1, _kcc_cg_promoted@@PAGEOFF
    ldr x1, [x1]
    cbz x1, .Lcpr_zero
    ldr x0, [x1, x0, lsl #3]
    ret
.Lcpr_zero:
    mov x0, #0
    ret

// -- kcc_cg_load_vreg_fp / kcc_cg_store_vreg_fp ---
// Move a double between a vreg and a floating-point register.
//   x0 = vreg number, x1 = FP register number (0, 1, or 2)
// A register-allocated vreg lives in a general register even when its value
// is a double (its slot is never written), so the fp paths bridge with FMOV;
// otherwise a double round-trips through the vreg's 8-byte stack slot.
.text
.globl _kcc_cg_load_vreg_fp
.p2align 2
_kcc_cg_load_vreg_fp:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    mov x19, x0                    // vreg
    mov x20, x1                    // fp reg

    // Allocated to a d-register?  The value already lives in the FP bank; move
    // it d-to-d (or nothing when it is already the target register).
    adrp x0, _kcc_cg_fpregmap@@PAGE
    add  x0, x0, _kcc_cg_fpregmap@@PAGEOFF
    ldr x0, [x0]
    cbz x0, .Llvf_gp
    ldr x0, [x0, x19, lsl #3]      // home d-reg (0 = not FP-allocated)
    cbz x0, .Llvf_gp
    cmp x20, x0
    b.eq .Llvf_done               // already in the target d-register
    mov x1, x0                     // Rn = home d-reg
    mov x0, x20                    // Rd = target d-reg
    bl _kcc_enc_fmov_d_d
    bl _kcc_code_emit32
    b .Llvf_done
.Llvf_gp:
    adrp x0, _kcc_cg_regmap@@PAGE
    add  x0, x0, _kcc_cg_regmap@@PAGEOFF
    ldr x0, [x0]
    cbz x0, .Llvf_spill
    ldr x0, [x0, x19, lsl #3]      // preg = map[vreg]
    cbz x0, .Llvf_spill
    mov x1, x0                     // Rn = preg (general)
    mov x0, x20                    // Rd = fp reg
    bl _kcc_enc_fmov_d_x           // FMOV d<reg>, x<preg>
    bl _kcc_code_emit32
    b .Llvf_done
.Llvf_spill:
    mov x0, x19                    // vreg → colored slot immediate
    bl _kcc_cg_slot_offset
    lsl x1, x0, #3                 // byte offset from x29
    mov x0, x20                    // Rt = fp reg
    mov x2, #2                     // kind = LDR fp
    bl _kcc_cg_emit_frame_ldst
.Llvf_done:
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

.text
.globl _kcc_cg_store_vreg_fp
.p2align 2
_kcc_cg_store_vreg_fp:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    mov x19, x0                    // vreg
    mov x20, x1                    // fp reg

    // Allocated to a d-register?  Write the value into its home d-register.
    adrp x0, _kcc_cg_fpregmap@@PAGE
    add  x0, x0, _kcc_cg_fpregmap@@PAGEOFF
    ldr x0, [x0]
    cbz x0, .Lsvf_gp
    ldr x0, [x0, x19, lsl #3]      // home d-reg (0 = not FP-allocated)
    cbz x0, .Lsvf_gp
    cmp x20, x0
    b.eq .Lsvf_done               // source already is the home d-register
    mov x1, x20                    // Rn = source d-reg
    // x0 = home d-reg = Rd
    bl _kcc_enc_fmov_d_d
    bl _kcc_code_emit32
    b .Lsvf_done
.Lsvf_gp:
    adrp x0, _kcc_cg_regmap@@PAGE
    add  x0, x0, _kcc_cg_regmap@@PAGEOFF
    ldr x0, [x0]
    cbz x0, .Lsvf_spill
    ldr x0, [x0, x19, lsl #3]      // preg = map[vreg]
    cbz x0, .Lsvf_spill
    mov x1, x20                    // Rn = fp reg
    // x0 already = preg = Rd (general)
    bl _kcc_enc_fmov_x_d           // FMOV x<preg>, d<reg>
    bl _kcc_code_emit32
    b .Lsvf_done
.Lsvf_spill:
    mov x0, x19                    // vreg → colored slot immediate
    bl _kcc_cg_slot_offset
    lsl x1, x0, #3                 // byte offset from x29
    mov x0, x20                    // Rt = fp reg
    mov x2, #3                     // kind = STR fp
    bl _kcc_cg_emit_frame_ldst
.Lsvf_done:
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- kcc_cg_callee_transfer ---
// void kcc_cg_callee_transfer(uint64_t restore)
//   x0 = 0 → save (STR), non-zero → restore (LDR).  Walks _kcc_cg_callee_mask
//   and emits one transfer per used callee-saved register (x19..x28) at
//   [x29, #save_base + k*8]; k counts the registers actually saved.
.text
.globl _kcc_cg_callee_transfer
.p2align 2
_kcc_cg_callee_transfer:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    mov x19, x0                    // restore flag

    adrp x0, _kcc_cg_callee_mask@@PAGE
    add  x0, x0, _kcc_cg_callee_mask@@PAGEOFF
    ldr x20, [x0]                  // mask
    cbz x20, .Lct_fp
    adrp x0, _kcc_cg_save_base@@PAGE
    add  x0, x0, _kcc_cg_save_base@@PAGEOFF
    ldr x0, [x0]
    lsr x21, x0, #3               // save_base as an imm12 (scaled by 8)
    mov x22, #19                   // current register number
    mov x23, #0                    // k = save-slot index
.Lct_loop:
    cmp x22, #29
    b.ge .Lct_fp
    sub x0, x22, #19
    lsr x1, x20, x0
    tst x1, #1
    b.eq .Lct_next
    add x1, x21, x23              // slot index = save_base_scaled + k
    lsl x1, x1, #3                // byte offset from x29
    mov x0, x22                   // rt = register
    mov x2, #0                    // kind = LDR int (restore)
    cbnz x19, .Lct_kind_ready     // restore → LDR
    mov x2, #1                    // save → STR int
.Lct_kind_ready:
    bl _kcc_cg_emit_frame_ldst
    add x23, x23, #1
.Lct_next:
    add x22, x22, #1
    b .Lct_loop
.Lct_fp:
    // Save/restore the callee-saved d-registers (d8..d15) the FP scan claimed,
    // at [x29, #fp_save_base + k*8], with the FP transfer kinds (LDR/STR fp).
    adrp x0, _kcc_cg_fp_callee_mask@@PAGE
    add  x0, x0, _kcc_cg_fp_callee_mask@@PAGEOFF
    ldr x20, [x0]                  // fp mask
    cbz x20, .Lct_done
    adrp x0, _kcc_cg_fp_save_base@@PAGE
    add  x0, x0, _kcc_cg_fp_save_base@@PAGEOFF
    ldr x0, [x0]
    lsr x21, x0, #3               // fp_save_base scaled by 8
    mov x22, #8                    // current d-register number
    mov x23, #0                    // k = fp-save-slot index
.Lct_fp_loop:
    cmp x22, #16
    b.ge .Lct_done
    sub x0, x22, #8
    lsr x1, x20, x0
    tst x1, #1
    b.eq .Lct_fp_next
    add x1, x21, x23
    lsl x1, x1, #3
    mov x0, x22                   // rt = d-register
    mov x2, #2                    // kind = LDR fp (restore)
    cbnz x19, .Lct_fp_kind
    mov x2, #3                    // kind = STR fp (save)
.Lct_fp_kind:
    bl _kcc_cg_emit_frame_ldst
    add x23, x23, #1
.Lct_fp_next:
    add x22, x22, #1
    b .Lct_fp_loop
.Lct_done:
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@| _kcc_cg_load_vreg _kcc_cg_store_vreg _kcc_cg_load_vreg_fp _kcc_cg_store_vreg_fp _kcc_cg_callee_transfer
@}

\section{AAPCS64 Argument Marshaling}
\label{sec:aapcs64-marshal}

Both the direct and indirect call paths share \texttt{\_kcc\_cg\_marshal\_args},
which realises the AAPCS64 argument-passing rules.  The argument array carries,
per argument, a vreg and a class (Section~\ref{sec:variadic-defs} lists the
class codes: GP, FP, ST1, ST2, REF).  The routine walks the arguments keeping
two counters---\textsc{ngrn}, the next general register, and \textsc{nsrn}, the
next SIMD/floating register---and loads each argument into \texttt{x[ngrn]} or
\texttt{d[nsrn]} accordingly; an integer, pointer, or (for now)
by-reference/by-address aggregate takes one general register, a
\texttt{double} takes one floating register.  After the register phase it also
writes a stack image---the arguments from the first-stack index \texttt{fsi}
onward, argument $k$ at \texttt{[sp,\,\#(k-fsi)*8]}---so that a variadic Apple
callee, which reads its variadic tail from \texttt{[sp,\,\#0]} regardless of
registers, finds it in place; the caller restores \texttt{sp} with the
returned \texttt{stack\_adj} once the call returns.  \texttt{fsi} is the
callee's fixed-parameter count for a variadic prototype and one otherwise
(which also covers the $>$eight-argument overflow).  Because the stack image
loads each value from its vreg slot (not from a register), it carries the
correct bits for floating arguments even though those now travel in
\texttt{d} registers.

@d CodeGen: marshal args @{
// -- kcc_cg_marshal_args ---
// uint64_t kcc_cg_marshal_args(uint64_t *args, uint64_t count, uint64_t fsi)
//   args = [count, vreg0, class0, ...]; returns the stack_adj subtracted from sp.
.text
.globl _kcc_cg_marshal_args
.p2align 2
_kcc_cg_marshal_args:
    stp x29, x30, [sp, #-80]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    stp x25, x26, [sp, #64]
    mov x19, x0                  // args array
    mov x20, x1                  // arg count
    mov x25, x2                  // first_stack_idx
    cbnz x25, .Lma_fsi_ok
    mov x25, #1
.Lma_fsi_ok:
    mov x24, #0                  // stack_adj (return value)
    cbz x20, .Lma_done

    // --- register phase: NGRN (x22) / NSRN (x23) ---
    mov x21, #0                  // arg index
    mov x22, #0                  // NGRN
    mov x23, #0                  // NSRN
.Lma_reg_loop:
    cmp x21, x20
    b.ge .Lma_stack
    lsl x0, x21, #1
    add x1, x0, #2
    ldr x1, [x19, x1, lsl #3]    // class
    add x0, x0, #1
    ldr x0, [x19, x0, lsl #3]    // vreg
    cmp x1, #1                   // FP?
    b.eq .Lma_fp
    cmp x1, #5                   // X8 (indirect result pointer)?
    b.eq .Lma_x8
    cmp x1, #2                   // ST1: struct <=8B, one register
    b.eq .Lma_st1
    cmp x1, #3                   // ST2: struct 9..16B, two registers
    b.eq .Lma_st2
    // GP / REF: load vreg (value or address) into x[ngrn]
    cmp x22, #8
    b.ge .Lma_reg_next
    mov x1, x22
    bl _kcc_cg_load_vreg
    add x22, x22, #1
    b .Lma_reg_next
.Lma_st1:
    cmp x22, #8
    b.ge .Lma_reg_next
    // x0 = struct address vreg → x9 = address, then x[ngrn] = [x9]
    mov x1, #9
    bl _kcc_cg_load_vreg
    mov x0, x22
    mov x1, #9
    mov x2, #0
    mov x3, #1
    bl _kcc_enc_ldr_imm
    bl _kcc_code_emit32
    add x22, x22, #1
    b .Lma_reg_next
.Lma_st2:
    // Two consecutive general registers; if fewer than two remain, overflow.
    cmp x22, #6
    b.gt .Lma_reg_next
    mov x1, #9
    bl _kcc_cg_load_vreg          // x9 = struct address
    mov x0, x22                    // x[ngrn] = [x9]
    mov x1, #9
    mov x2, #0
    mov x3, #1
    bl _kcc_enc_ldr_imm
    bl _kcc_code_emit32
    add x0, x22, #1               // x[ngrn+1] = [x9, #8]
    mov x1, #9
    mov x2, #1
    mov x3, #1
    bl _kcc_enc_ldr_imm
    bl _kcc_code_emit32
    add x22, x22, #2
    b .Lma_reg_next
.Lma_fp:
    cmp x23, #8
    b.ge .Lma_reg_next
    mov x1, x23
    bl _kcc_cg_load_vreg_fp
    add x23, x23, #1
    b .Lma_reg_next
.Lma_x8:
    // The indirect result pointer travels in x8 and consumes no NGRN/NSRN.
    mov x1, #8
    bl _kcc_cg_load_vreg
.Lma_reg_next:
    add x21, x21, #1
    b .Lma_reg_loop

.Lma_stack:
    // --- stack image: args[fsi..count-1] at [sp,#(k-fsi)*8] ---
    cmp x20, x25
    b.le .Lma_done
    sub x0, x20, x25
    lsl x0, x0, #3
    add x0, x0, #15
    bic x24, x0, #15            // stack_adj = align16((count-fsi)*8)
    mov x0, #31
    mov x1, #31
    mov x2, x24
    mov x3, #1
    bl _kcc_enc_sub_imm
    bl _kcc_code_emit32
    mov x21, x25                 // k = fsi
.Lma_stack_loop:
    cmp x21, x20
    b.ge .Lma_done
    lsl x0, x21, #1
    add x0, x0, #1
    ldr x0, [x19, x0, lsl #3]    // vreg
    mov x1, #9
    bl _kcc_cg_load_vreg
    mov x0, #9
    mov x1, #31
    sub x2, x21, x25            // slot = k - fsi
    mov x3, #1
    bl _kcc_enc_str_imm
    bl _kcc_code_emit32
    add x21, x21, #1
    b .Lma_stack_loop

.Lma_done:
    mov x0, x24                  // return stack_adj
    ldp x25, x26, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #80
    ret
@| _kcc_cg_marshal_args
@}

