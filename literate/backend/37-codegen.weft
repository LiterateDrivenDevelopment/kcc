% 37-codegen.weft — IR to ARM64 Code Generation
%
% This chapter implements the core code generator.  It walks the IR
% produced by the frontend and emits ARM64 machine code using the
% ``all-spill'' strategy: every virtual register is assigned a stack
% slot.  Instructions load sources into scratch registers (x9, x10),
% compute the result in x11, and store it back.  This produces correct
% (if unoptimized) code and allows us to get a working compiler before
% implementing register allocation.

\chapter{Code Generation}
\label{ch:codegen}

This chapter is where the compiler's abstract IR meets the target machine.  The code generator walks each IR function and emits ARM64 machine code using a simple ``all-spill'' strategy: every virtual register is assigned a stack slot, and each instruction loads its sources from the stack into scratch registers (x9, x10), computes the result in x11, and stores it back.  This avoids the complexity of register allocation while producing correct code.  The chapter covers the stack-frame layout, initialization of the cstring buffer for string literals, the main instruction-lowering loop, and the post-codegen fixup pass that patches string-literal symbol values.

\section{Strategy}

The stack frame for a generated function has three regions:
\begin{verbatim}
  [x29+0]               saved x29/x30 (16 bytes)
  [x29+16]              vreg value slots (vreg_count * 8)
  [x29+16+vc*8]         alloca storage  (total_alloca_slots * 8)
\end{verbatim}

The total frame size is
$\mathit{align16}(16 + \text{vreg\_count}\times 8
+ \text{alloca\_slots}\times 8)$.
A pre-scan pass walks all \texttt{IR\_ALLOCA} instructions before
code generation, sums their slot counts, and assigns each alloca a
running offset (stored in \texttt{SRC2}).  This lets
\texttt{IR\_ALLOCA} compute its storage address at emit time
and ensures alloca storage does not overlap vreg slots.
We use x9 for source~1, x10 for source~2, x11 as the destination
scratch register, and x12 as an additional scratch for
\texttt{IR\_GEP} address arithmetic.

\section{Constants}

The code generator's fixed parameters---slot size, scratch register assignments, and patch-entry layout---are defined here as assembler equates so they can be referenced symbolically throughout the backend.

@d CodeGen: constants @{
// -- CodeGen constants --------------------------------------------------------
.equ CG_SLOT_SIZE,   8           // each vreg occupies 8 bytes on stack
.equ CG_REG_SRC1,   9           // x9 = first source scratch
.equ CG_REG_SRC2,  10           // x10 = second source scratch
.equ CG_REG_DST,   11           // x11 = destination scratch

// Forward-branch patch entry: {code_offset(8), target_bb_id(8)} = 16 bytes
.equ PATCH_OFFSET,   0
.equ PATCH_TARGET,   8
.equ PATCH_SIZE,    16
@}

\section{Initialization}

Initialization zeroes the frame-size state and prepares the
infrastructure for string literals.  We allocate a 4\,KB
\emph{cstring buffer} where literal bytes will accumulate during
code generation, a counter for naming symbols
(\texttt{l\_.str.0}, \texttt{l\_.str.1}, \ldots), and a
\emph{fixup vector} whose elements are pairs
$(\mathit{sym\_index}, \mathit{cstr\_offset})$.  After all
instructions have been lowered, the fixup pass
(\S\ref{sec:emit-strings}) patches each symbol's value and
appends the raw string data to the code section.

@d CodeGen: init @{
// -- kcc_codegen_init ---------------------------------------------------------
.text
.globl _kcc_codegen_init
.p2align 2
_kcc_codegen_init:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    // Zero state
    adrp x0, _kcc_cg_frame_size@@PAGE
    add  x0, x0, _kcc_cg_frame_size@@PAGEOFF
    str xzr, [x0]

    // Allocate cstring buffer (4KB initial) and record its capacity so it can
    // grow: the buffer holds not only string literals but (M5) the byte images
    // of read-only const globals, which can exceed the old fixed 4KB.
    mov x0, #4096
    bl _kcc_arena_alloc
    adrp x1, _kcc_cstr_buf@@PAGE
    add  x1, x1, _kcc_cstr_buf@@PAGEOFF
    str x0, [x1]
    mov x0, #4096
    adrp x1, _kcc_cstr_cap@@PAGE
    add  x1, x1, _kcc_cstr_cap@@PAGEOFF
    str x0, [x1]

    adrp x1, _kcc_cstr_pos@@PAGE
    add  x1, x1, _kcc_cstr_pos@@PAGEOFF
    str xzr, [x1]

    adrp x1, _kcc_cstr_count@@PAGE
    add  x1, x1, _kcc_cstr_count@@PAGEOFF
    str xzr, [x1]

    // Allocate fixup vec (elem=16: {sym_index, cstr_offset})
    mov x0, #VEC_SIZE
    bl _kcc_arena_alloc
    adrp x1, _kcc_cstr_fixups@@PAGE
    add  x1, x1, _kcc_cstr_fixups@@PAGEOFF
    str x0, [x1]
    mov x1, #16
    str x1, [x0, #VEC_ELEMSIZE]
    mov x1, #32
    str x1, [x0, #VEC_CAP]
    str xzr, [x0, #VEC_COUNT]
    mov x19, x0

    mov x0, #512                   // 32 * 16
    bl _kcc_arena_alloc
    str x0, [x19, #VEC_DATA]

    // __DATA_CONST,__const state: absent until a const pointer array needs it.
    adrp x1, _kcc_rodata_const_present@@PAGE
    add  x1, x1, _kcc_rodata_const_present@@PAGEOFF
    str xzr, [x1]
    adrp x1, _kcc_rodata_const_size@@PAGE
    add  x1, x1, _kcc_rodata_const_size@@PAGEOFF
    str xzr, [x1]
    mov x0, #VEC_SIZE              // relocs vec: {slot_offset, sym_index}
    bl _kcc_arena_alloc
    adrp x1, _kcc_rodata_const_relocs@@PAGE
    add  x1, x1, _kcc_rodata_const_relocs@@PAGEOFF
    str x0, [x1]
    mov x1, #16
    str x1, [x0, #VEC_ELEMSIZE]
    mov x1, #32
    str x1, [x0, #VEC_CAP]
    str xzr, [x0, #VEC_COUNT]
    mov x19, x0
    mov x0, #512                  // 32 * 16
    bl _kcc_arena_alloc
    str x0, [x19, #VEC_DATA]

    // Fresh set of globals defined in this translation unit
    mov x0, #32
    bl _kcc_ht_init
    adrp x1, _kcc_cg_defined_globals@@PAGE
    add  x1, x1, _kcc_cg_defined_globals@@PAGEOFF
    str x0, [x1]

    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_codegen_init
@}

\section{Pre-register Global Sizes}
\label{sec:preregister-globals}

Before code generation begins, the driver calls
\texttt{kcc\_preregister\_globals} to walk the AST translation unit and
pre-register every global variable in the linker with its correct
allocation size.  Scalar and pointer globals need eight bytes, while
struct globals need $n \times 8$ bytes (one eight-byte slot per field).
Because \texttt{kcc\_linker\_global\_sym} deduplicates---returning
immediately when a symbol is already defined---subsequent references
during code generation are no-ops with respect to allocation.

A global declared \texttt{extern} is a \emph{declaration}, not a
definition: its storage lives in another translation unit, so this pass
skips it and reserves no bytes.  The names it does define are recorded
in a per-unit \texttt{defined\_globals} set.  This set is what lets the
\texttt{IR\_GLOBAL\_REF} handler decide, for each reference, between a
locally defined symbol and an undefined external one: a name absent
from the set is emitted through \texttt{kcc\_linker\_extern} so the
linker resolves it against whichever object supplies the definition.
Without the set, every reference would define its own copy and two
objects naming the same global would collide.

A second pass reserves storage for \texttt{static} locals, which are hoisted
to globals under a mangled \texttt{sl\_}\meta{node} name
(\S\ref{sec:ir-static-locals}).  Two subtleties matter here.  Its size must
be the declared type's real byte count---an aggregate \texttt{static}
(\texttt{static const char *evs[] = \{\ldots\}}) needs $n\times 8$ bytes, not
the eight-byte scalar fallback, or it under-allocates and overlaps whatever
symbol the linker packs next.  And the reserved symbol must carry the Mach-O
leading underscore, since an \texttt{IR\_GLOBAL\_REF} to the static is emitted
as an underscore-prefixed reference; a bare reservation would split into two
symbols, the reference binding to an unsized stand-in.  Both bite hardest
across translation units: a file-scope aggregate in a non-\texttt{main} unit
is initialised from \texttt{kcc.module\_init}, and a mis-sized or mis-named
static there scribbles over its neighbours---the failure that corrupted Lua's
\texttt{luaT\_eventname} metamethod-name table.

The two cases also differ in \emph{how} the address is formed.  A locally
defined global has an address inside the image, reachable with a direct
\textsc{adrp}+\textsc{add} page/offset pair.  An external one may be
defined in another object---or imported from a dynamic library, like the
standard streams \texttt{stdin}/\texttt{stdout}/\texttt{stderr} (which are
the \texttt{libSystem} data symbols \texttt{\_\_stdinp} and friends).  A
dylib datum has no fixed image address; it is reached only through the
global offset table, so the handler emits \textsc{adrp}\;\texttt{GOTPAGE}
followed by an \textsc{ldr}\;\texttt{GOTPAGEOFF} that loads the symbol's
resolved address from a GOT slot the linker binds.  The same GOT form works
for an ordinary cross-object extern (the linker simply points the slot at
the local definition), so all external references take it uniformly; only
the load, not the code generator, pays for the extra indirection.

One wrinkle in sizing a global's storage is the \emph{flexible array member}
(\stdref{6.7.2.1}): \texttt{struct \{ char c; char p[]; \} a = \{'o', "wx"\}}
occupies more than the struct's nominal size, because the trailing \texttt{p[]}
is laid out with length zero but its initializer supplies real bytes.  Before
reserving storage, \texttt{\_kcc\_cg\_fam\_extra} inspects the declaration: if
the type is a struct whose last member is an unsized \texttt{[]} array and a
matching initializer element supplies its contents, it returns those bytes (a
string's length plus its NUL, or a brace list's element count times the member
size), which the pre-registration adds to the reserved size.  The initializer
itself is copied by the shared aggregate-fill machinery
(\S\ref{sec:ir-aggregate-init}), which now recognises a string landing on the
flexible member.

@d CodeGen: preregister globals @{
// -- kcc_cg_fam_extra ---------------------------------------------------------
// uint64_t kcc_cg_fam_extra(node *decl, type *ty)
// The extra storage bytes an initialized trailing flexible array member needs
// beyond the struct's nominal size.  Returns 0 unless `ty` is a struct, `decl`
// has a brace initializer, the struct's last member is an unsized `[]` array,
// and a matching initializer element supplies its contents.  A string element
// contributes its length + 1 (the NUL); a brace list contributes its element
// count times the member's element size.
.text
.p2align 2
_kcc_cg_fam_extra:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    str x23, [sp, #48]
    mov x19, x0                    // decl
    mov x21, #0                    // result
    ldr x0, [x1, #TY_KIND]
    cmp x0, #TY_STRUCT
    b.ne .Lfam_ret
    ldr x22, [x19, #AST_F2]        // initializer
    cbz x22, .Lfam_ret
    ldr x0, [x22, #AST_TAG]
    cmp x0, #AST_INIT_LIST
    b.ne .Lfam_ret
    ldr x0, [x1, #TY_F0]           // struct decl AST
    cbz x0, .Lfam_ret
    ldr x23, [x0, #AST_F1]         // first field
    cbz x23, .Lfam_ret
    mov x20, #1                    // field count
.Lfam_lastf:
    ldr x0, [x23, #AST_F4]
    cbz x0, .Lfam_havef
    mov x23, x0
    add x20, x20, #1
    b .Lfam_lastf
.Lfam_havef:
    // Last field must be an unsized array (a flexible array member).
    ldr x0, [x23, #AST_F0]
    bl _kcc_sema_resolve_type
    cbz x0, .Lfam_ret
    ldr x1, [x0, #TY_KIND]
    cmp x1, #TY_ARRAY
    b.ne .Lfam_ret
    ldr x1, [x0, #TY_F1]           // declared length
    cbnz x1, .Lfam_ret             // sized array: not flexible
    ldr x0, [x0, #TY_F0]           // element type
    bl _kcc_type_layout            // element byte size
    mov x23, x0
    // Seek the initializer element at the FAM's position (field count - 1).
    ldr x0, [x22, #AST_F0]         // first element
    sub x1, x20, #1
.Lfam_seek:
    cbz x0, .Lfam_ret              // fewer elements than fields: FAM uninitialized
    cbz x1, .Lfam_gote
    ldr x0, [x0, #AST_F4]
    sub x1, x1, #1
    b .Lfam_seek
.Lfam_gote:
    ldr x1, [x0, #AST_TAG]
    cmp x1, #AST_STR_LIT
    b.ne .Lfam_list
    ldr x21, [x0, #AST_F1]         // string length
    add x21, x21, #1               // + NUL
    b .Lfam_ret
.Lfam_list:
    cmp x1, #AST_INIT_LIST
    b.ne .Lfam_ret                 // other FAM init forms: conservatively 0
    ldr x0, [x0, #AST_F0]          // first sub-element
    mov x1, #0
.Lfam_cnt:
    cbz x0, .Lfam_cntd
    add x1, x1, #1
    ldr x0, [x0, #AST_F4]
    b .Lfam_cnt
.Lfam_cntd:
    mul x21, x1, x23               // element count * element size
.Lfam_ret:
    mov x0, x21
    ldr x23, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret

// -- kcc_preregister_globals --------------------------------------------------
// void kcc_preregister_globals(node *trans_unit)
//   x0 = AST_TRANS_UNIT node
// Walks top-level variable declarations, resolves their types, and
// pre-registers each global with the linker at the correct byte size.
.text
.globl _kcc_preregister_globals
.p2align 2
_kcc_preregister_globals:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    str x23, [sp, #48]

    ldr x23, [x0, #AST_F0]      // first declaration (kept for the static pass)
    mov x19, x23

.Lprg_loop:
    cbz x19, .Lprg_statics

    ldr x0, [x19, #AST_TAG]
    cmp x0, #AST_VAR_DECL
    b.ne .Lprg_next

    ldr x20, [x19, #AST_F1]     // name
    cbz x20, .Lprg_next

    // extern globals are declarations, not definitions: emit no storage
    ldr x0, [x19, #AST_F3]      // storage class (2 = extern)
    cmp x0, #2
    b.eq .Lprg_next

    // Resolve the declared type
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_resolve_type
    cbz x0, .Lprg_next

    // Reserve the type's real byte size, floored at 8 and rounded up to a
    // whole 8-byte slot.  Rounding keeps slot-granular struct copies (which
    // move ceil(size/8) eight-byte chunks) inside the reserved storage.  An
    // initialized trailing flexible array member extends the object past its
    // nominal size, so its initializer's bytes are added here.
    mov x22, x0                // resolved type (survives type_layout)
    bl _kcc_type_layout        // x0 = real TY_SIZE
    mov x21, x0
    mov x0, x19                // decl
    mov x1, x22                // type
    bl _kcc_cg_fam_extra       // x0 = flexible-array-member init bytes (0 if none)
    add x21, x21, x0
    cmp x21, #8
    b.ge .Lprg_round
    mov x21, #8
.Lprg_round:
    add x21, x21, #7
    bic x21, x21, #7           // round up to a multiple of 8
.Lprg_have_size:

    // Build "_" + name
    mov x0, x20
    bl _kcc_strlen
    add x0, x0, #2
    bl _kcc_arena_alloc
    mov x22, x0
    mov w1, #'_'
    strb w1, [x22]
    mov x0, x20
    bl _kcc_strlen
    add x2, x0, #1
    add x0, x22, #1
    mov x1, x20
    bl _kcc_memcpy

    // A const scalar/aggregate becomes read-only __TEXT bytes; a const pointer
    // array goes to __DATA_CONST,__const; otherwise, __common storage.
    mov x0, x19
    bl _kcc_global_const_rodata
    cbz x0, .Lprg_try_ptrarr
    mov x0, x19                  // decl
    mov x1, x22                  // "_"+name
    bl _kcc_emit_rodata_global
    b .Lprg_defined
.Lprg_try_ptrarr:
    mov x0, x19
    bl _kcc_global_const_ptrarr
    cbz x0, .Lprg_common
    mov x0, x19
    mov x1, x22
    bl _kcc_emit_rodata_ptrarr
    b .Lprg_defined
.Lprg_common:
    mov x0, x22
    mov x1, x21
    bl _kcc_linker_global_sym
.Lprg_defined:

    // Remember the source name as defined-in-this-TU
    mov x0, x20
    bl _kcc_strlen
    mov x2, x0                   // keylen
    adrp x0, _kcc_cg_defined_globals@@PAGE
    add  x0, x0, _kcc_cg_defined_globals@@PAGEOFF
    ldr x0, [x0]
    mov x1, x20                  // key = source name
    mov x3, #1                   // present
    bl _kcc_ht_put

.Lprg_next:
    ldr x19, [x19, #AST_F4]     // next sibling
    b .Lprg_loop

.Lprg_statics:
    // Second pass: static locals are defined here too, under their mangled
    // names.  Record each so IR_GLOBAL_REF treats it as locally defined.
    mov x19, x23
.Lprg_fn_loop:
    cbz x19, .Lprg_done
    ldr x0, [x19, #AST_TAG]
    cmp x0, #AST_FUNC_DECL
    b.ne .Lprg_fn_next
    ldr x0, [x19, #AST_F3]      // function body (compound statement)
    cbz x0, .Lprg_fn_next
    bl _kcc_cg_prereg_stmt       // recurse the whole body, at any block depth
    b .Lprg_fn_next

// -- kcc_cg_prereg_static -------------------------------------------------
// void kcc_cg_prereg_static(node *decl)
//   Reserve backing storage for one `static` local (block-scoped, static
//   storage duration) and record it as defined in this TU.
.globl _kcc_cg_prereg_static
.p2align 2
_kcc_cg_prereg_static:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    str x23, [sp, #48]
    mov x20, x0                  // decl (the reservation body below uses x20)

    mov x0, x20
    bl _kcc_ir_static_name
    mov x21, x0                  // mangled name

    // Reserve the static's backing storage at its real type size (floored at 8,
    // rounded to a whole 8-byte slot), as the file-scope pass does; otherwise
    // the IR_GLOBAL_REF handler falls back to a scalar 8 bytes and a static
    // array or struct larger than that is under-allocated.
    ldr x0, [x20, #AST_F0]       // declared type node
    cbz x0, .Lprg_st_size8
    bl _kcc_sema_resolve_type
    cbz x0, .Lprg_st_size8
    bl _kcc_type_layout          // x0 = real TY_SIZE (arrays/structs included)
    mov x22, x0
    cmp x22, #8
    b.lt .Lprg_st_size8
    add x22, x22, #7
    bic x22, x22, #7             // round up to a whole 8-byte slot
    b .Lprg_st_reserve
.Lprg_st_size8:
    mov x22, #8
.Lprg_st_reserve:
    // The linker symbol must carry the Mach-O leading underscore, exactly as
    // the file-scope pass builds "_"+name: an IR_GLOBAL_REF to this static is
    // emitted as an underscore-prefixed reference, so a bare reservation and
    // the prefixed reference would split into two symbols---the reference then
    // binding to an unsized, overlapping stand-in.  Build "_"+mangled for the
    // reservation; the bare mangled name still keys defined_globals below,
    // matching how the reference handler looks the name up.
    mov x0, x21
    bl _kcc_strlen
    add x0, x0, #2               // '_' + name + NUL
    bl _kcc_arena_alloc
    mov x23, x0                  // x23 = "_"+mangled
    mov w1, #'_'
    strb w1, [x23]
    mov x0, x21
    bl _kcc_strlen
    add x2, x0, #1              // copy name + NUL
    add x0, x23, #1
    mov x1, x21
    bl _kcc_memcpy

    // Read-only const static locals go to __TEXT (scalars/aggregates) or
    // __DATA_CONST,__const (pointer arrays), like file-scope const globals.
    mov x0, x20                  // static decl
    bl _kcc_global_const_rodata
    cbz x0, .Lprg_st_try_ptrarr
    mov x0, x20
    mov x1, x23                  // "_"+mangled name
    bl _kcc_emit_rodata_global
    b .Lprg_st_defined
.Lprg_st_try_ptrarr:
    mov x0, x20
    bl _kcc_global_const_ptrarr
    cbz x0, .Lprg_st_common
    mov x0, x20
    mov x1, x23                  // "_"+mangled name
    bl _kcc_emit_rodata_ptrarr
    b .Lprg_st_defined
.Lprg_st_common:
    mov x0, x23                  // "_"+mangled name
    mov x1, x22                  // byte size
    bl _kcc_linker_global_sym
.Lprg_st_defined:

    mov x0, x21
    bl _kcc_strlen
    mov x2, x0                   // keylen
    adrp x0, _kcc_cg_defined_globals@@PAGE
    add  x0, x0, _kcc_cg_defined_globals@@PAGEOFF
    ldr x0, [x0]
    mov x1, x21                  // key = mangled name
    mov x3, #1
    bl _kcc_ht_put

    ldr x23, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret

.Lprg_fn_next:
    ldr x19, [x19, #AST_F4]
    b .Lprg_fn_loop

.Lprg_done:
    ldr x23, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret

// -- kcc_cg_prereg_stmt ---------------------------------------------------
// void kcc_cg_prereg_stmt(node *stmt)
//   Walk a statement (and its AST_F4 sibling chain) and reserve storage for
//   every `static` local declaration at any block depth, descending into
//   compound blocks, if/switch/while/do/for bodies, and case/default/label
//   statements.  Without descending, a static declared inside a nested block
//   -- e.g. SQLite's `static const struct EncName encnames[]` inside a switch
//   case -- got an IR_GLOBAL_REF but no storage, leaving the symbol undefined.
.globl _kcc_cg_prereg_stmt
.p2align 2
_kcc_cg_prereg_stmt:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    mov x19, x0                    // stmt cursor
.Lprs_loop:
    cbz x19, .Lprs_ret
    ldr x20, [x19, #AST_TAG]
    cmp x20, #AST_VAR_DECL
    b.ne .Lprs_notvar
    ldr x0, [x19, #AST_F3]         // storage class (3 = static)
    cmp x0, #3
    b.ne .Lprs_next
    mov x0, x19
    bl _kcc_cg_prereg_static
    b .Lprs_next
.Lprs_notvar:
    cmp x20, #AST_COMPOUND
    b.eq .Lprs_body_f0
    cmp x20, #AST_IF_STMT
    b.eq .Lprs_if
    cmp x20, #AST_SWITCH_STMT
    b.eq .Lprs_body_f1
    cmp x20, #AST_WHILE_STMT
    b.eq .Lprs_body_f1
    cmp x20, #AST_DO_STMT
    b.eq .Lprs_body_f0
    cmp x20, #AST_FOR_STMT
    b.eq .Lprs_for
    cmp x20, #AST_CASE_STMT
    b.eq .Lprs_body_f1
    cmp x20, #AST_LABEL_STMT
    b.eq .Lprs_body_f1
    cmp x20, #AST_DEFAULT_STMT
    b.eq .Lprs_body_f0
    b .Lprs_next
.Lprs_if:
    ldr x0, [x19, #AST_F1]         // then branch
    bl _kcc_cg_prereg_stmt
    ldr x0, [x19, #AST_F2]         // else branch
    bl _kcc_cg_prereg_stmt
    b .Lprs_next
.Lprs_for:
    ldr x0, [x19, #AST_F0]         // init clause
    bl _kcc_cg_prereg_stmt
    ldr x0, [x19, #AST_F3]         // body
    bl _kcc_cg_prereg_stmt
    b .Lprs_next
.Lprs_body_f1:
    ldr x0, [x19, #AST_F1]
    bl _kcc_cg_prereg_stmt
    b .Lprs_next
.Lprs_body_f0:
    ldr x0, [x19, #AST_F0]
    bl _kcc_cg_prereg_stmt
.Lprs_next:
    ldr x19, [x19, #AST_F4]        // next sibling in the statement list
    b .Lprs_loop
.Lprs_ret:
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_preregister_globals _kcc_cg_prereg_static _kcc_cg_prereg_stmt
@}

\subsection{Read-Only Const Globals}
\label{sec:codegen-rodata}

When \texttt{\_kcc\_global\_const\_rodata} (\S\ref{sec:global-inits}) accepts a
declaration, pre-registration routes it here instead of reserving
\texttt{\_\_common} storage.  \texttt{\_kcc\_emit\_rodata\_global} evaluates the
initialiser to a byte image directly---an integer or character literal's value
lives in its \texttt{AST\_F0}, and a floating literal's is the IEEE-754 double
bit pattern there (narrowed to single precision for a \texttt{float} element by
a compile-time \texttt{fcvt}), so no expression lowering is needed---and appends
it to the same growable buffer that holds string literals, which
\texttt{\_kcc\_codegen\_emit\_strings} concatenates onto the read-only
\texttt{\_\_text} tail.  Three bookkeeping steps make the object linkable and
referenceable: a \emph{section-1} symbol at the object's buffer offset (external
unless the object is a \texttt{static} local); a \texttt{\_kcc\_cstr\_fixups}
entry so the symbol's value is patched to $\mathit{code\_size}+\mathit{offset}$
alongside the string literals; and a \texttt{\_kcc\_linker\_extern\_ht} entry so
that every \texttt{IR\_GLOBAL\_REF}---which dedups through
\texttt{\_kcc\_linker\_global\_sym}---resolves to this read-only symbol rather
than allocating a fresh writable slot.  For a scalar or array the reservation spans
$\max(\mathit{layout},\ \mathit{count}\times\mathit{elem})$ so a type whose
inferred array length lags its initialiser cannot under-allocate, and the tail is
zero-filled to match C's default initialisation of the unmentioned elements.  A
\texttt{struct} takes a parallel branch: it zeroes its whole \texttt{layout}
span first (so inter-field padding and any unmentioned trailing fields are zero)
and then writes each initialiser element at its member's recorded byte offset
(\texttt{AST\_F3}), with that member's own kind driving the width and the
\texttt{float} narrowing---so a mixed \texttt{\{int,\ double,\ char\}} record is
laid out byte-accurately.

@d CodeGen: preregister globals @{
// -- kcc_rodata_leaf_bits -----------------------------------------------------
// uint64_t kcc_rodata_leaf_bits(node *n, uint64_t kind)
// Raw initializer bits for a leaf.  An integer element is a symtab-free constant
// expression (kcc_rodata_const_intexpr accepted it), so it folds through
// _kcc_eval_const_int -- literals, negation, and arithmetic alike.  A floating
// element is a literal or a unary minus of one; its double bit pattern comes
// straight from AST_F0, negation being a sign-bit flip.
.text
.globl _kcc_rodata_leaf_bits
.p2align 2
_kcc_rodata_leaf_bits:
    cmp x1, #TY_FLOAT               // integer kinds are < TY_FLOAT
    b.ge .Lrlb_fp
    b _kcc_eval_const_int           // integer: tail-call the constant folder
.Lrlb_fp:
    ldr x2, [x0, #AST_TAG]
    cmp x2, #AST_UNARY_EXPR
    b.ne .Lrlb_flit
    ldr x2, [x0, #AST_F1]           // operand literal
    ldr x0, [x2, #AST_F0]           // its double bit pattern
    mov x3, #1
    lsl x3, x3, #63
    eor x0, x0, x3                  // flip the sign bit
    ret
.Lrlb_flit:
    ldr x0, [x0, #AST_F0]
    ret
@| _kcc_rodata_leaf_bits
@}

@d CodeGen: rodata write LE @{
    // A floating literal always carries the IEEE-754 *double* bit pattern in
    // AST_F0.  For a float element, narrow it to single precision (the value
    // model is double, but its 4-byte memory image is single) with a hardware
    // fcvt on the literal itself; a double element keeps all 8 bytes, an integer
    // element writes its value verbatim.
    ldr x11, [x23, #TY_KIND]
    cmp x11, #TY_FLOAT
    b.ne 3f
    fmov d0, x6
    fcvt s0, d0
    fmov w6, s0                    // x6 = single-precision bits (upper 32 = 0)
3:
    // Write x24 little-endian bytes of the value in x6 at x25[x26].
    mov x8, x6                     // value
    mov x9, #0                     // byte index
1:  cmp x9, x24
    b.ge 2f
    add x10, x26, x9
    strb w8, [x25, x10]
    lsr x8, x8, #8
    add x9, x9, #1
    b 1b
2:
@}

@d CodeGen: preregister globals @{
// -- kcc_emit_struct_fields ---------------------------------------------------
// void kcc_emit_struct_fields(type *sty, node *init, char *buf, uint64_t base)
// Lay one struct's fields into buf at byte offset `base`, positionally from the
// brace list `init`.  The region is assumed already zeroed, so a short list
// leaves its trailing fields zero.  Shared by the scalar-struct and
// array-of-struct emit paths.  Preserves x19-x24/x27/x28; uses x25/x26 (the
// write fragment's buffer and cursor) as scratch.
.text
.globl _kcc_emit_struct_fields
.p2align 2
_kcc_emit_struct_fields:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    mov x25, x2                    // buffer (for the write fragment)
    mov x22, x3                    // base byte offset
    ldr x0, [x0, #TY_F0]           // AST_STRUCT_DECL
    ldr x19, [x0, #AST_F1]         // x19 = field cursor
    ldr x20, [x1, #AST_F0]         // x20 = init element cursor
.Lesf_loop:
    cbz x19, .Lesf_done            // no more fields
    cbz x20, .Lesf_done            // initializer exhausted: rest stays zero
    ldr x0, [x19, #AST_F0]         // field type
    bl _kcc_sema_resolve_type
    mov x23, x0                    // field type (for the write fragment's fcvt)
    ldr x24, [x23, #TY_SIZE]       // field size
    ldr x1, [x23, #TY_KIND]        // field kind
    mov x0, x20                    // element node
    bl _kcc_rodata_leaf_bits
    mov x6, x0                     // field bits
    ldr x9, [x19, #AST_F3]         // field byte offset
    add x26, x22, x9              // write cursor = base + field offset
    @<CodeGen: rodata write LE@>
    ldr x19, [x19, #AST_F4]        // next field
    ldr x20, [x20, #AST_F4]        // next element
    b .Lesf_loop
.Lesf_done:
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret

// -- kcc_emit_rodata_global ---------------------------------------------------
// void kcc_emit_rodata_global(node *decl, char *uname)
//   decl  = AST_VAR_DECL accepted by kcc_global_const_rodata
//   uname = linker symbol name ("_"+source or "_"+mangled), arena-owned
// Lays the initializer's byte image into the read-only cstring buffer and mints
// a section-1 symbol at that offset, with a fixup (value patched to
// code_size+offset) and an extern-table dedup entry so IR_GLOBAL_REF resolves
// here instead of allocating __common storage.
.text
.globl _kcc_emit_rodata_global
.p2align 2
_kcc_emit_rodata_global:
    stp x29, x30, [sp, #-112]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    stp x25, x26, [sp, #64]
    stp x27, x28, [sp, #80]
    mov x19, x0                    // decl
    mov x20, x1                    // uname

    // Resolve type; total byte size; element type and size.
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_resolve_type
    mov x21, x0                    // full type
    bl _kcc_type_layout            // x0 = total size
    mov x22, x0                    // x22 = total (becomes span)
    ldr x0, [x21, #TY_KIND]
    cmp x0, #TY_STRUCT             // a struct is laid out field-by-field
    b.eq .Lerg_struct
    cmp x0, #TY_ARRAY
    b.ne .Lerg_scalar_ty
    ldr x23, [x21, #TY_F0]         // element type
    ldr x0, [x23, #TY_KIND]
    cmp x0, #TY_STRUCT             // array of structs: lay each element out
    b.eq .Lerg_aos
    b .Lerg_have_ty
.Lerg_scalar_ty:
    mov x23, x21                   // scalar: element is the type itself
.Lerg_have_ty:
    ldr x24, [x23, #TY_SIZE]       // element size

    // Count elements; span = max(total, count*elem) guards a type whose
    // inferred array length lags the initializer.
    mov x9, #0
    ldr x0, [x19, #AST_F2]
    ldr x1, [x0, #AST_TAG]
    cmp x1, #AST_INIT_LIST
    b.ne .Lerg_scalar_cnt
    ldr x2, [x0, #AST_F0]
.Lerg_cnt_loop:
    cbz x2, .Lerg_cnt_done
    add x9, x9, #1
    ldr x2, [x2, #AST_F4]
    b .Lerg_cnt_loop
.Lerg_scalar_cnt:
    mov x9, #1
.Lerg_cnt_done:
    mul x10, x9, x24
    cmp x10, x22
    csel x22, x10, x22, gt         // x22 = span

    // Align the buffer position up to the element alignment (remember pos).
    adrp x0, _kcc_cstr_pos@@PAGE
    add  x0, x0, _kcc_cstr_pos@@PAGEOFF
    ldr x26, [x0]                  // x26 = pos
    ldr x9, [x23, #TY_ALIGN]
    sub x11, x9, #1
    add x8, x26, x11
    bic x27, x8, x11              // x27 = O (aligned start)

    // Reserve O+span; the buffer may relocate, so re-read it afterwards.
    add x0, x27, x22
    bl _kcc_cstr_reserve
    adrp x0, _kcc_cstr_buf@@PAGE
    add  x0, x0, _kcc_cstr_buf@@PAGEOFF
    ldr x25, [x0]                  // x25 = buffer (stable after reserve)

    // Zero the alignment padding [pos, O).
    mov x1, x26
.Lerg_pad:
    cmp x1, x27
    b.ge .Lerg_write
    strb wzr, [x25, x1]
    add x1, x1, #1
    b .Lerg_pad

.Lerg_write:
    mov x26, x27                   // x26 = w (write cursor), from O
    ldr x0, [x19, #AST_F2]
    ldr x1, [x0, #AST_TAG]
    cmp x1, #AST_INIT_LIST
    b.ne .Lerg_scalar_wr
    ldr x28, [x0, #AST_F0]         // first element
.Lerg_wr_loop:
    cbz x28, .Lerg_zero
    mov x0, x28
    ldr x1, [x23, #TY_KIND]        // element kind (for negation / narrowing)
    bl _kcc_rodata_leaf_bits
    mov x6, x0                     // literal bits (negated if unary minus)
    @<CodeGen: rodata write LE@>
    add x26, x26, x24
    ldr x28, [x28, #AST_F4]
    b .Lerg_wr_loop
.Lerg_scalar_wr:
    ldr x1, [x23, #TY_KIND]        // x0 already = init node
    bl _kcc_rodata_leaf_bits
    mov x6, x0                     // scalar literal bits
    @<CodeGen: rodata write LE@>
    add x26, x26, x24

.Lerg_zero:
    // Zero-fill the tail [w, O+span).
    add x7, x27, x22
.Lerg_zf:
    cmp x26, x7
    b.ge .Lerg_sym
    strb wzr, [x25, x26]
    add x26, x26, #1
    b .Lerg_zf

.Lerg_struct:
    // Scalar struct: x21 = type, x22 = total size.  Align, reserve, zero the
    // whole region (so padding gaps and unmentioned fields are zero), then lay
    // out the fields with the shared helper.
    adrp x0, _kcc_cstr_pos@@PAGE
    add  x0, x0, _kcc_cstr_pos@@PAGEOFF
    ldr x26, [x0]                  // pos
    ldr x9, [x21, #TY_ALIGN]
    sub x11, x9, #1
    add x8, x26, x11
    bic x27, x8, x11              // O (aligned start)
    add x0, x27, x22
    bl _kcc_cstr_reserve
    adrp x0, _kcc_cstr_buf@@PAGE
    add  x0, x0, _kcc_cstr_buf@@PAGEOFF
    ldr x25, [x0]                  // buffer
    add x7, x27, x22             // zero [pos, O+total)
    mov x1, x26
.Lerg_st_zero:
    cmp x1, x7
    b.ge .Lerg_st_lay
    strb wzr, [x25, x1]
    add x1, x1, #1
    b .Lerg_st_zero
.Lerg_st_lay:
    mov x0, x21                    // struct type
    ldr x1, [x19, #AST_F2]         // init list
    mov x2, x25                    // buffer
    mov x3, x27                    // base = O
    bl _kcc_emit_struct_fields
    b .Lerg_sym

.Lerg_aos:
    // Array of structs: x21 = array type, x23 = element struct type, x22 = total
    // size.  Reserve and zero, then lay each element out at O + i*stride, where
    // the stride is the element struct's (already padded) size.
    ldr x24, [x23, #TY_SIZE]       // stride
    // span = max(layout, count*stride) guards a lagging inferred array length.
    mov x9, #0
    ldr x0, [x19, #AST_F2]
    ldr x0, [x0, #AST_F0]          // first outer element
.Lerg_aos_cnt:
    cbz x0, .Lerg_aos_cnt_done
    add x9, x9, #1
    ldr x0, [x0, #AST_F4]
    b .Lerg_aos_cnt
.Lerg_aos_cnt_done:
    mul x10, x9, x24
    cmp x10, x22
    csel x22, x10, x22, gt         // x22 = span
    adrp x0, _kcc_cstr_pos@@PAGE
    add  x0, x0, _kcc_cstr_pos@@PAGEOFF
    ldr x26, [x0]                  // pos
    ldr x9, [x23, #TY_ALIGN]
    sub x11, x9, #1
    add x8, x26, x11
    bic x27, x8, x11              // O
    add x0, x27, x22
    bl _kcc_cstr_reserve
    adrp x0, _kcc_cstr_buf@@PAGE
    add  x0, x0, _kcc_cstr_buf@@PAGEOFF
    ldr x28, [x0]                  // x28 = buffer (survives the helper)
    add x7, x27, x22             // zero [pos, O+total)
    mov x1, x26
.Lerg_aos_zero:
    cmp x1, x7
    b.ge .Lerg_aos_lay
    strb wzr, [x28, x1]
    add x1, x1, #1
    b .Lerg_aos_zero
.Lerg_aos_lay:
    ldr x0, [x19, #AST_F2]        // outer init list
    ldr x0, [x0, #AST_F0]         // first element (a struct brace)
    str x0, [sp, #96]            // element cursor
    str x27, [sp, #104]          // running base offset = O
.Lerg_aos_loop:
    ldr x0, [sp, #96]
    cbz x0, .Lerg_sym             // initializer exhausted: remaining structs zero
    mov x0, x23                   // element struct type
    ldr x1, [sp, #96]             // element init (brace list)
    mov x2, x28                   // buffer
    ldr x3, [sp, #104]           // base for this element
    bl _kcc_emit_struct_fields
    ldr x0, [sp, #104]
    add x0, x0, x24              // base += stride
    str x0, [sp, #104]
    ldr x0, [sp, #96]
    ldr x0, [x0, #AST_F4]         // next element
    str x0, [sp, #96]
    b .Lerg_aos_loop

.Lerg_sym:
    // Advance cstr_pos past this object.
    add x0, x27, x22
    adrp x1, _kcc_cstr_pos@@PAGE
    add  x1, x1, _kcc_cstr_pos@@PAGEOFF
    str x0, [x1]

    // Mint symbol: section 1 (__text), value 0 (patched later).  External
    // unless the object is a static local (storage class 3).
    ldr x0, [x19, #AST_F3]
    mov x3, #N_SECT
    cmp x0, #3
    b.eq .Lerg_flags
    orr x3, x3, #N_EXT
.Lerg_flags:
    mov x0, x20                    // name
    mov x1, #1                     // section 1
    mov x2, #0                     // value placeholder
    bl _kcc_linker_add_sym
    mov x21, x0                    // sym_index

    // Fixup {sym_index, O}: emit_strings patches value to code_size + O.
    str x21, [sp, #96]
    str x27, [sp, #104]
    adrp x0, _kcc_cstr_fixups@@PAGE
    add  x0, x0, _kcc_cstr_fixups@@PAGEOFF
    ldr x0, [x0]
    add x1, sp, #96
    bl _kcc_vec_push

    // Dedup entry: IR_GLOBAL_REF via kcc_linker_global_sym resolves here.
    mov x0, x20
    bl _kcc_strlen
    mov x2, x0                     // keylen
    adrp x0, _kcc_linker_extern_ht@@PAGE
    add  x0, x0, _kcc_linker_extern_ht@@PAGEOFF
    ldr x0, [x0]
    mov x1, x20
    add x3, x21, #1               // value = sym_index + 1
    bl _kcc_ht_put

    ldp x27, x28, [sp, #80]
    ldp x25, x26, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #112
    ret

// -- kcc_emit_rodata_ptrarr ---------------------------------------------------
// void kcc_emit_rodata_ptrarr(node *decl, char *uname)
//   decl accepted by kcc_global_const_ptrarr (a const array of const pointers
//        initialised with string literals / NULL)
//   uname = linker symbol name
// Reserves the array's pointer slots in the __DATA_CONST,__const section, emits
// each string element into the read-only cstring buffer and records an UNSIGNED
// relocation binding its slot to the string symbol (NULL slots stay zero), and
// mints a section-3 symbol at the array's offset.  Marks the __const section
// present so the emitter lays it out.
.text
.globl _kcc_emit_rodata_ptrarr
.p2align 2
_kcc_emit_rodata_ptrarr:
    stp x29, x30, [sp, #-96]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    str x25, [sp, #64]
    mov x19, x0                    // decl
    mov x20, x1                    // uname

    // The object now needs a __DATA_CONST,__const section.
    adrp x0, _kcc_rodata_const_present@@PAGE
    add  x0, x0, _kcc_rodata_const_present@@PAGEOFF
    mov x1, #1
    str x1, [x0]

    // Total array bytes (declared length * 8).
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_resolve_type
    bl _kcc_type_layout            // x0 = total size
    mov x25, x0                    // x25 = total

    // O = current const size, aligned to 8 (pointer alignment).
    adrp x0, _kcc_rodata_const_size@@PAGE
    add  x0, x0, _kcc_rodata_const_size@@PAGEOFF
    ldr x21, [x0]
    add x21, x21, #7
    bic x21, x21, #7               // x21 = O (array's offset in __const)

    ldr x0, [x19, #AST_F2]         // init list
    ldr x22, [x0, #AST_F0]         // x22 = element cursor
    mov x23, #0                    // x23 = slot index
.Lerp_loop:
    cbz x22, .Lerp_done
    ldr x0, [x22, #AST_TAG]
    cmp x0, #AST_STR_LIT
    b.ne .Lerp_next                // NULL / non-string leaves the slot zero
    ldr x0, [x22, #AST_F0]         // string data
    ldr x1, [x22, #AST_F1]         // string length
    bl _kcc_emit_cstring           // x0 = string symbol index
    mov x24, x0
    lsl x1, x23, #3                // slot offset = O + i*8
    add x1, x21, x1
    str x1, [sp, #72]             // reloc {slot_offset, sym_index}
    str x24, [sp, #80]
    adrp x0, _kcc_rodata_const_relocs@@PAGE
    add  x0, x0, _kcc_rodata_const_relocs@@PAGEOFF
    ldr x0, [x0]
    add x1, sp, #72
    bl _kcc_vec_push
.Lerp_next:
    add x23, x23, #1
    ldr x22, [x22, #AST_F4]
    b .Lerp_loop
.Lerp_done:
    // span = max(total, slot_count*8) guards a lagging inferred array length.
    lsl x0, x23, #3
    cmp x0, x25
    csel x25, x0, x25, gt
    add x0, x21, x25               // new const size = O + span
    adrp x1, _kcc_rodata_const_size@@PAGE
    add  x1, x1, _kcc_rodata_const_size@@PAGEOFF
    str x0, [x1]

    // Mint the section-3 symbol at offset O; external unless static local.
    ldr x0, [x19, #AST_F3]
    mov x3, #N_SECT
    cmp x0, #3
    b.eq .Lerp_flags
    orr x3, x3, #N_EXT
.Lerp_flags:
    mov x0, x20                    // name
    mov x1, #3                     // section 3 (__DATA_CONST,__const)
    mov x2, x21                    // value = offset in section
    bl _kcc_linker_add_sym
    mov x24, x0                    // sym index

    // Dedup entry so IR_GLOBAL_REF resolves to this symbol.
    mov x0, x20
    bl _kcc_strlen
    mov x2, x0
    adrp x0, _kcc_linker_extern_ht@@PAGE
    add  x0, x0, _kcc_linker_extern_ht@@PAGEOFF
    ldr x0, [x0]
    mov x1, x20
    add x3, x24, #1
    bl _kcc_ht_put

    ldr x25, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #96
    ret
@| _kcc_emit_struct_fields _kcc_emit_rodata_global _kcc_emit_rodata_ptrarr
@}

\section{Compile All Functions}

The top-level entry point iterates the IR function vector and calls
\texttt{kcc\_codegen\_func} for each one.  After this loop completes,
the code buffer contains the machine code for every function but
string literal data has not yet been appended---that is a separate
finalization step (\S\ref{sec:emit-strings}).

\paragraph{Pre-registering function symbols.}
Before compiling any body, a first pass registers a defined linker symbol
for every function, with a placeholder value of zero, and records its index
in \texttt{IRF\_SYMIDX}.  Non-\texttt{static} functions are external
(\texttt{N\_SECT $\vert$ N\_EXT}); \texttt{static} functions and the
synthesised module-init are local (\texttt{N\_SECT}).  This ordering is what
makes a forward reference resolve correctly: when \texttt{deflate} calls the
\texttt{static} helper \texttt{deflate\_stored} that is defined \emph{later}
in the file, the call site's \texttt{kcc\_linker\_extern} lookup finds the
already-registered \emph{defined} symbol rather than minting a fresh
undefined external.  Without the pre-pass, that forward reference produced an
\texttt{N\_UNDF $\vert$ N\_EXT} symbol which the linker could coalesce with a
global definition but never with a local one---so a \texttt{static} callee
referenced before its definition failed to link.  The subsequent
\texttt{kcc\_codegen\_func} then only patches the pre-registered symbol's
\texttt{SYM\_VALUE} to the real code offset.

@d CodeGen: compile all @{
// -- kcc_cg_preregister_funcs -------------------------------------------------
// void kcc_cg_preregister_funcs(void)
// Registers a defined (value=0) linker symbol for every IR function, records
// the index in IRF_SYMIDX, and enters non-modinit functions into the extern
// hash table so forward call sites resolve to the definition.
.text
.globl _kcc_cg_preregister_funcs
.p2align 2
_kcc_cg_preregister_funcs:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]

    adrp x0, _kcc_ir_funcs@@PAGE
    add  x0, x0, _kcc_ir_funcs@@PAGEOFF
    ldr x0, [x0]
    cbz x0, .Lcpf_done
    ldr x19, [x0, #VEC_COUNT]      // function count
    mov x20, #0                    // index

.Lcpf_loop:
    cmp x20, x19
    b.ge .Lcpf_done
    adrp x0, _kcc_ir_funcs@@PAGE
    add  x0, x0, _kcc_ir_funcs@@PAGEOFF
    ldr x0, [x0]
    mov x1, x20
    bl _kcc_vec_get
    ldr x21, [x0]                  // x21 = ir_func
    ldr x22, [x21, #IRF_NAME]      // x22 = name

    // is_modinit = (name == "kcc.module_init")
    mov x0, x22
    adrp x1, _kcc_str_modinit@@PAGE
    add  x1, x1, _kcc_str_modinit@@PAGEOFF
    bl _kcc_strcmp
    cmp x0, #0
    cset x23, eq                   // x23 = is_modinit

    // Build "_" + name
    mov x0, x22
    bl _kcc_strlen
    add x0, x0, #2
    bl _kcc_arena_alloc
    mov x24, x0                    // x24 = mangled name buffer
    mov w1, #'_'
    strb w1, [x24]
    mov x0, x22
    bl _kcc_strlen
    add x2, x0, #1                 // len incl. null
    add x0, x24, #1
    mov x1, x22
    bl _kcc_memcpy

    // Linkage flags: external unless modinit or static
    mov x3, #(N_SECT | N_EXT)
    cbnz x23, .Lcpf_local
    ldr x4, [x21, #IRF_STATIC]
    cbz x4, .Lcpf_flags
.Lcpf_local:
    mov x3, #N_SECT
.Lcpf_flags:
    mov x0, x24                    // name
    mov x1, #1                     // section 1 (__text)
    mov x2, #0                     // value placeholder (patched by codegen_func)
    bl _kcc_linker_add_sym
    str x0, [x21, #IRF_SYMIDX]     // record index on the IR function

    // modinit: record its symbol index and stay out of the extern table.
    cbz x23, .Lcpf_extern
    adrp x1, _kcc_modinit_sym@@PAGE
    add  x1, x1, _kcc_modinit_sym@@PAGEOFF
    add x2, x0, #1                 // index + 1 (0 = none)
    str x2, [x1]
    b .Lcpf_next

.Lcpf_extern:
    // Enter into the extern hash table so calls by name find this definition.
    mov x22, x0                    // save sym index
    mov x0, x24
    bl _kcc_strlen
    mov x2, x0                     // keylen
    adrp x0, _kcc_linker_extern_ht@@PAGE
    add  x0, x0, _kcc_linker_extern_ht@@PAGEOFF
    ldr x0, [x0]
    mov x1, x24                    // key = mangled name
    add x3, x22, #1               // value = index + 1
    bl _kcc_ht_put

.Lcpf_next:
    add x20, x20, #1
    b .Lcpf_loop

.Lcpf_done:
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@| _kcc_cg_preregister_funcs
@}

@d CodeGen: compile all @{
// -- kcc_codegen_all ----------------------------------------------------------
// void kcc_codegen_all(void)
// Iterates all IR functions and generates code for each.
.text
.globl _kcc_codegen_all
.p2align 2
_kcc_codegen_all:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    // Pre-register every function symbol so forward references resolve.
    bl _kcc_cg_preregister_funcs

    // Get IR functions vec
    adrp x0, _kcc_ir_funcs@@PAGE
    add  x0, x0, _kcc_ir_funcs@@PAGEOFF
    ldr x0, [x0]
    cbz x0, .Lcga_done

    ldr x19, [x0, #VEC_COUNT]     // number of functions
    mov x20, #0                    // index

.Lcga_loop:
    cmp x20, x19
    b.ge .Lcga_done

    // Get function pointer: vec_get(funcs_vec, index)
    adrp x0, _kcc_ir_funcs@@PAGE
    add  x0, x0, _kcc_ir_funcs@@PAGEOFF
    ldr x0, [x0]
    mov x1, x20
    bl _kcc_vec_get
    ldr x0, [x0]                  // dereference: vec stores pointers

    bl _kcc_codegen_func

    add x20, x20, #1
    b .Lcga_loop

.Lcga_done:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_codegen_all
@}

\section{Branch Patching}

After all basic blocks have been emitted, we resolve forward branch
references.  Each entry in the patch vector contains a code offset
and a target BB~ID.  We look up the target in the label hash table,
compute the signed byte offset, and call \texttt{code\_patch32} to
overwrite the placeholder.  Two instruction formats need handling:
\textsc{b} (where the offset occupies the low 26~bits) and
\textsc{cbnz} (where the 19-bit offset sits at bits [23:5]).
We distinguish the two by reading the existing instruction and
checking bit~24.

@d CodeGen: patch branches @{
// -- kcc_codegen_patch_branches -----------------------------------------------
// void kcc_codegen_patch_branches(ht *bb_labels, vec *patches)
//   x0 = bb_labels hash table
//   x1 = patch vec
.text
.globl _kcc_codegen_patch_branches
.p2align 2
_kcc_codegen_patch_branches:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    str x23, [sp, #48]

    mov x19, x0                    // bb_labels ht
    mov x20, x1                    // patch vec
    ldr x21, [x20, #VEC_COUNT]    // patch count
    mov x22, #0                    // index

.Lcpb_loop:
    cmp x22, x21
    b.ge .Lcpb_done

    // Get patch entry
    mov x0, x20
    mov x1, x22
    bl _kcc_vec_get
    mov x23, x0                    // pointer to patch entry

    ldr x0, [x23, #PATCH_OFFSET]  // code offset of branch instr
    ldr x1, [x23, #PATCH_TARGET]  // target BB_ID

    // Look up target BB offset
    str x1, [sp, #56]             // store bb_id as key
    mov x0, x19                    // ht
    add x1, sp, #56               // key
    mov x2, #8                     // keylen
    bl _kcc_ht_get
    cbz x0, .Lcpb_next            // target not found (shouldn't happen)
    sub x0, x0, #1                // undo +1 encoding → target_offset

    // Read original instruction to determine type
    ldr x1, [x23, #PATCH_OFFSET]  // branch_offset
    adrp x2, _kcc_code_buf@@PAGE
    add  x2, x2, _kcc_code_buf@@PAGEOFF
    ldr x2, [x2]
    ldr w3, [x2, x1]              // original instruction

    // Compute offset in bytes: target - branch_pos
    sub x4, x0, x1                // offset_bytes = target_offset - branch_offset

    // Check instruction type: B (0x14) vs CBNZ (0xB5) vs CBZ (0xB4)
    lsr w5, w3, #24
    cmp w5, #0x14                  // B?
    b.eq .Lcpb_patch_b
    cmp w5, #0xB5                  // CBNZ 64-bit?
    b.eq .Lcpb_patch_cbnz
    cmp w5, #0x35                  // CBNZ 32-bit?
    b.eq .Lcpb_patch_cbnz
    // Default: treat as B
    b .Lcpb_patch_b

.Lcpb_patch_b:
    // Re-encode B with correct offset
    mov x0, x4                     // offset_bytes
    bl _kcc_enc_b
    // Patch
    ldr x1, [x23, #PATCH_OFFSET]
    mov x1, x1
    mov w1, w0                     // new instruction in w1... wait
    // kcc_code_patch32(offset, word): x0=offset, x1=word
    mov w2, w0                     // save encoded instruction
    ldr x0, [x23, #PATCH_OFFSET]
    mov w1, w2
    bl _kcc_code_patch32
    b .Lcpb_next

.Lcpb_patch_cbnz:
    // Re-encode CBNZ: keep rt and sf from original, update imm19
    and w5, w3, #0x1F              // extract Rt
    asr x6, x4, #2                // offset in instructions
    and w6, w6, #0x7FFFF          // imm19
    mov w7, #0xB5000000            // CBNZ 64-bit base
    orr w7, w7, w6, lsl #5        // imm19
    orr w7, w7, w5                // Rt
    // Patch
    ldr x0, [x23, #PATCH_OFFSET]
    mov w1, w7
    bl _kcc_code_patch32
    b .Lcpb_next

.Lcpb_next:
    add x22, x22, #1
    b .Lcpb_loop

.Lcpb_done:
    ldr x23, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@| _kcc_codegen_patch_branches
@}

\section{String Literal Codegen}
\label{sec:emit-strings}

String literals require two things that no other IR instruction
needs: persistent data that outlives the instruction, and a
PC-relative pointer to that data.  Our approach avoids adding a
separate Mach-O section (which would change section counts,
segment sizes, and symbol numbering): we append the raw string
bytes to the \emph{end} of the \texttt{\_\_text} section, after
all machine code.

The scheme works in two phases:

\paragraph{Phase~1: per-instruction (\texttt{kcc\_codegen\_string\_lit}).}
Each \texttt{IR\_STRING\_LIT} instruction triggers the following
steps:
\begin{enumerate}
\item Copy the string bytes (already escape-processed by the
      parser) into the \emph{cstring buffer}, a 4\,KB arena
      allocation, and append a null terminator.
\item Mint a local symbol name \texttt{l\_.str.\textit{N}} using
      a monotonically increasing counter.  Because the final
      offset is not yet known, the symbol is created with
      \texttt{value\,=\,0}.
\item Record a fixup entry $(\mathit{sym\_index},
      \mathit{cstr\_offset})$ so the value can be patched later.
\item Emit an \textsc{adrp}\,+\,\textsc{add} pair with
      \texttt{PAGE21} and \texttt{PAGEOFF12} relocations.
      The linker will resolve these to the symbol's final
      address.
\item Store the resulting pointer (in~x11) to the destination
      vreg's stack slot.
\end{enumerate}

\paragraph{Phase~2: finalization (\texttt{kcc\_codegen\_emit\_strings}).}
Called from the driver after \texttt{kcc\_codegen\_all} and before
\texttt{kcc\_macho\_init}:
\begin{enumerate}
\item Record the current code position as the boundary between
      machine code and string data.
\item Walk the fixup vector and set each symbol's value to
      $\mathit{code\_size} + \mathit{cstr\_offset}$.
\item Copy the entire cstring buffer to the end of the code
      buffer (growing it if necessary).
\end{enumerate}

The result is a single contiguous \texttt{\_\_text} section where
the first part is executable instructions and the tail is read-only
string data—exactly the layout that Apple's linker expects.

Because that read-only tail now carries more than string literals---under
M5 it also holds the byte images of \texttt{const} globals
(\S\ref{sec:mt-m5})---the buffer can no longer be a fixed 4\,KB block.
\texttt{\_kcc\_cstr\_reserve} ensures the buffer can hold a requested end
offset, doubling (allocate-and-copy, mirroring the code buffer's growth) when
it would overflow.  Every writer calls it before appending and re-reads
\texttt{\_kcc\_cstr\_buf} afterwards, so a relocation of the buffer is
transparent.  This also closes a latent overflow: a translation unit with more
than 4\,KB of string data previously wrote past the block.

@d CodeGen: emit strings @{
// -- kcc_cstr_reserve ---------------------------------------------------------
// void kcc_cstr_reserve(uint64_t need)
// Ensure the cstring buffer holds at least `need` bytes; grow (allocate 2x or
// `need`, whichever is larger, and copy the live prefix) otherwise.  Preserves
// x19-x28 so callers holding state across it are safe.
.text
.globl _kcc_cstr_reserve
.p2align 2
_kcc_cstr_reserve:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    mov x19, x0                    // need (required end offset)
    adrp x0, _kcc_cstr_cap@@PAGE
    add  x0, x0, _kcc_cstr_cap@@PAGEOFF
    ldr x0, [x0]                   // current capacity
    cmp x19, x0
    b.le .Lcrsv_done               // already fits

    lsl x20, x0, #1                // candidate new cap = cap*2
    cmp x20, x19
    b.ge .Lcrsv_alloc
    mov x20, x19                   // ...but at least `need`
.Lcrsv_alloc:
    mov x0, x20
    bl _kcc_arena_alloc            // x0 = new buffer
    mov x21, x0                    // x21 = new buffer

    // Copy the live prefix (cstr_pos bytes) from old buffer to new.
    adrp x0, _kcc_cstr_pos@@PAGE
    add  x0, x0, _kcc_cstr_pos@@PAGEOFF
    ldr x2, [x0]                   // n = live bytes
    adrp x0, _kcc_cstr_buf@@PAGE
    add  x0, x0, _kcc_cstr_buf@@PAGEOFF
    ldr x1, [x0]                   // src = old buffer
    mov x0, x21                    // dst = new buffer
    bl _kcc_memcpy

    adrp x0, _kcc_cstr_buf@@PAGE
    add  x0, x0, _kcc_cstr_buf@@PAGEOFF
    str x21, [x0]                  // publish new buffer
    adrp x0, _kcc_cstr_cap@@PAGE
    add  x0, x0, _kcc_cstr_cap@@PAGEOFF
    str x20, [x0]                  // publish new capacity

.Lcrsv_done:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_cstr_reserve
@}

@d CodeGen: emit strings @{
// -- kcc_emit_cstring ---------------------------------------------------------
// uint64_t kcc_emit_cstring(const char *data, uint64_t len)
// Copy a string into the read-only cstring buffer (NUL-terminated), mint a
// local l_.str.N symbol at its offset with a fixup (value patched to
// code_size+offset alongside the other string literals), and return the symbol
// index.  This is the string-materialisation half of kcc_codegen_string_lit,
// used to build the string elements of a const pointer table (M5 Stage 2).
.text
.globl _kcc_emit_cstring
.p2align 2
_kcc_emit_cstring:
    stp x29, x30, [sp, #-96]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    stp x25, x26, [sp, #64]
    mov x20, x0                    // data
    mov x21, x1                    // len

    adrp x0, _kcc_cstr_pos@@PAGE
    add  x0, x0, _kcc_cstr_pos@@PAGEOFF
    ldr x23, [x0]                  // x23 = cstr_offset
    add x0, x23, x21
    add x0, x0, #1
    bl _kcc_cstr_reserve
    adrp x0, _kcc_cstr_buf@@PAGE
    add  x0, x0, _kcc_cstr_buf@@PAGEOFF
    ldr x0, [x0]
    add x0, x0, x23
    mov x1, x20
    mov x2, x21
    cbz x2, .Lecs_nullterm
    bl _kcc_memcpy
.Lecs_nullterm:
    adrp x0, _kcc_cstr_buf@@PAGE
    add  x0, x0, _kcc_cstr_buf@@PAGEOFF
    ldr x0, [x0]
    add x1, x23, x21
    strb wzr, [x0, x1]
    add x24, x23, x21
    add x24, x24, #1
    adrp x0, _kcc_cstr_pos@@PAGE
    add  x0, x0, _kcc_cstr_pos@@PAGEOFF
    str x24, [x0]

    // Mint a local l_.str.N symbol.
    adrp x0, _kcc_cstr_count@@PAGE
    add  x0, x0, _kcc_cstr_count@@PAGEOFF
    ldr x24, [x0]
    add x1, x24, #1
    str x1, [x0]
    mov x0, #20
    bl _kcc_arena_alloc
    mov x25, x0
    mov w1, #'l'
    strb w1, [x25, #0]
    mov w1, #'_'
    strb w1, [x25, #1]
    mov w1, #'.'
    strb w1, [x25, #2]
    mov w1, #'s'
    strb w1, [x25, #3]
    mov w1, #'t'
    strb w1, [x25, #4]
    mov w1, #'r'
    strb w1, [x25, #5]
    mov w1, #'.'
    strb w1, [x25, #6]
    add x0, x25, #7
    mov x1, x24
    cbz x1, .Lecs_zero
    mov x2, x0
.Lecs_cvt:
    cbz x1, .Lecs_rev
    mov x3, #10
    udiv x4, x1, x3
    msub x5, x4, x3, x1
    add w5, w5, #'0'
    strb w5, [x0], #1
    mov x1, x4
    b .Lecs_cvt
.Lecs_rev:
    strb wzr, [x0]
    sub x3, x0, #1
.Lecs_rvlp:
    cmp x2, x3
    b.ge .Lecs_named
    ldrb w4, [x2]
    ldrb w5, [x3]
    strb w5, [x2], #1
    strb w4, [x3], #-1
    b .Lecs_rvlp
.Lecs_zero:
    mov w1, #'0'
    strb w1, [x0]
    strb wzr, [x0, #1]
.Lecs_named:
    mov x0, x25
    mov x1, #1                     // section 1 (__text)
    mov x2, #0                     // value placeholder
    mov x3, #N_SECT
    bl _kcc_linker_add_sym
    mov x26, x0                    // sym index
    str x26, [sp, #80]
    str x23, [sp, #88]
    adrp x0, _kcc_cstr_fixups@@PAGE
    add  x0, x0, _kcc_cstr_fixups@@PAGEOFF
    ldr x0, [x0]
    add x1, sp, #80
    bl _kcc_vec_push
    mov x0, x26                    // return the symbol index

    ldp x25, x26, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #96
    ret
@| _kcc_emit_cstring
@}

@d CodeGen: emit strings @{
// -- kcc_codegen_string_lit ---------------------------------------------------
// void kcc_codegen_string_lit(ir_instr *instr)
// Handles IR_STRING_LIT: copies string to cstring buffer, creates a
// local symbol with ADRP+ADD relocations, stores pointer to dest vreg.
.text
.globl _kcc_codegen_string_lit
.p2align 2
_kcc_codegen_string_lit:
    stp x29, x30, [sp, #-96]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    stp x25, x26, [sp, #64]

    mov x19, x0                    // instr
    ldr x20, [x19, #IR_SRC1]      // string data ptr
    ldr x21, [x19, #IR_SRC2]      // string length
    ldr x22, [x19, #IR_DEST]      // dest vreg

    // 1. Get current cstring buffer position
    adrp x0, _kcc_cstr_pos@@PAGE
    add  x0, x0, _kcc_cstr_pos@@PAGEOFF
    ldr x23, [x0]                  // x23 = cstr_offset

    // 1a. Ensure room for len+1 bytes (data + NUL) at cstr_offset; the buffer
    // may relocate, so every later access re-reads _kcc_cstr_buf.
    add x0, x23, x21
    add x0, x0, #1
    bl _kcc_cstr_reserve

    // 2. Copy string data to cstring buffer
    adrp x0, _kcc_cstr_buf@@PAGE
    add  x0, x0, _kcc_cstr_buf@@PAGEOFF
    ldr x0, [x0]
    add x0, x0, x23                // dest = buf + offset
    mov x1, x20                    // src = string data
    mov x2, x21                    // len
    cbz x2, .Lcgsl_nullterm
    bl _kcc_memcpy

.Lcgsl_nullterm:
    // 3. Null-terminate
    adrp x0, _kcc_cstr_buf@@PAGE
    add  x0, x0, _kcc_cstr_buf@@PAGEOFF
    ldr x0, [x0]
    add x1, x23, x21
    strb wzr, [x0, x1]

    // 4. Advance cstr_pos
    add x24, x23, x21
    add x24, x24, #1
    adrp x0, _kcc_cstr_pos@@PAGE
    add  x0, x0, _kcc_cstr_pos@@PAGEOFF
    str x24, [x0]
@| _kcc_codegen_string_lit
@}

\paragraph{Symbol Name Construction and Relocation Emission}
With the string bytes safely buffered, the next step is to give
the literal a linker-visible identity.  The code mints a local
symbol name of the form \texttt{l\_.str.\textit{N}} by
incrementing a monotonic counter and converting it to decimal
with a digit-reversal loop.  It then registers the symbol as
\emph{local} (\texttt{N\_SECT} without \texttt{N\_EXT}: a string literal
belongs to its own translation unit, so it must not be exported---else two
objects that each mint \texttt{l\_.str.0} collide at link time), in
section~1 with value~0 as a placeholder, records a fixup pair
$(\mathit{sym\_index}, \mathit{cstr\_offset})$, and emits the
\textsc{adrp}\,+\,\textsc{add} relocation sequence that will let
the linker resolve the pointer at link time.

@d CodeGen: emit strings @{
    // 5. Build symbol name "l_.str.N"
    adrp x0, _kcc_cstr_count@@PAGE
    add  x0, x0, _kcc_cstr_count@@PAGEOFF
    ldr x24, [x0]                  // x24 = N
    add x1, x24, #1
    str x1, [x0]                   // count++

    mov x0, #20
    bl _kcc_arena_alloc
    mov x25, x0                    // x25 = name buffer

    // Write "l_.str." prefix (7 bytes)
    mov w1, #'l'
    strb w1, [x25, #0]
    mov w1, #'_'
    strb w1, [x25, #1]
    mov w1, #'.'
    strb w1, [x25, #2]
    mov w1, #'s'
    strb w1, [x25, #3]
    mov w1, #'t'
    strb w1, [x25, #4]
    mov w1, #'r'
    strb w1, [x25, #5]
    mov w1, #'.'
    strb w1, [x25, #6]

    // Convert N to decimal at offset 7
    add x0, x25, #7
    mov x1, x24
    cbz x1, .Lcgsl_zero

    mov x2, x0
.Lcgsl_cvt:
    cbz x1, .Lcgsl_rev
    mov x3, #10
    udiv x4, x1, x3
    msub x5, x4, x3, x1
    add w5, w5, #'0'
    strb w5, [x0], #1
    mov x1, x4
    b .Lcgsl_cvt

.Lcgsl_rev:
    strb wzr, [x0]
    sub x3, x0, #1
.Lcgsl_rvlp:
    cmp x2, x3
    b.ge .Lcgsl_named
    ldrb w4, [x2]
    ldrb w5, [x3]
    strb w5, [x2], #1
    strb w4, [x3], #-1
    b .Lcgsl_rvlp

.Lcgsl_zero:
    mov w1, #'0'
    strb w1, [x0]
    strb wzr, [x0, #1]

.Lcgsl_named:
    // 6. Add symbol: section 1, value 0 (fixed up later).  A string literal is
    // private to its translation unit, so its symbol is LOCAL (N_SECT, no
    // N_EXT); otherwise two objects that both mint `l_.str.0` collide at link.
    mov x0, x25
    mov x1, #1                    // section = 1 (__text)
    mov x2, #0                    // value = 0 (placeholder)
    mov x3, #N_SECT
    bl _kcc_linker_add_sym
    mov x26, x0                    // x26 = sym_index

    // 7. Record fixup {sym_index, cstr_offset}
    str x26, [sp, #80]
    str x23, [sp, #88]
    adrp x0, _kcc_cstr_fixups@@PAGE
    add  x0, x0, _kcc_cstr_fixups@@PAGEOFF
    ldr x0, [x0]
    add x1, sp, #80
    bl _kcc_vec_push

    // 8. Emit ADRP x11, sym@@PAGE
    bl _kcc_code_current_pos
    mov x1, #ARM64_RELOC_PAGE21
    mov x2, x26
    bl _kcc_linker_add_reloc

    mov x0, #CG_REG_DST
    mov x1, #0
    bl _kcc_enc_adrp
    bl _kcc_code_emit32

    // 9. Emit ADD x11, x11, sym@@PAGEOFF
    bl _kcc_code_current_pos
    mov x1, #ARM64_RELOC_PAGEOFF12
    mov x2, x26
    bl _kcc_linker_add_reloc

    mov x0, #CG_REG_DST
    mov x1, #CG_REG_DST
    mov x2, #0
    mov x3, #1
    bl _kcc_enc_add_imm
    bl _kcc_code_emit32

    // 10. Store x11 to dest vreg
    mov x0, x22
    mov x1, #CG_REG_DST
    bl _kcc_cg_store_vreg

    ldp x25, x26, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #96
    ret
@}

\paragraph{String Data Finalization}
After all functions have been compiled, the string data must be
appended to the code buffer so that the \textsc{adrp}\,+\,\textsc{add}
relocations resolve to valid addresses within the \texttt{\_\_text}
section.  The finalization pass first records the current code
position as the boundary between executable instructions and
read-only data.  It then walks the fixup vector and patches each
string symbol's value to $\mathit{code\_size} +
\mathit{cstr\_offset}$.  Finally, it copies the accumulated
cstring buffer to the tail of the code buffer, growing the
buffer if the combined size exceeds its capacity.

@d CodeGen: emit strings @{
// -- kcc_codegen_emit_strings -------------------------------------------------
// void kcc_codegen_emit_strings(void)
// Fixes up string symbol values and appends cstring data to code buffer.
// Must be called after kcc_codegen_all() and before kcc_macho_init().
.text
.globl _kcc_codegen_emit_strings
.p2align 2
_kcc_codegen_emit_strings:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]

    // Check if any strings were emitted
    adrp x0, _kcc_cstr_pos@@PAGE
    add  x0, x0, _kcc_cstr_pos@@PAGEOFF
    ldr x0, [x0]
    cbz x0, .Lces_done

    // 1. Boundary between code and cstring data
    bl _kcc_code_current_pos
    mov x19, x0                    // x19 = code_size

    // 2. Patch each string symbol's value
    adrp x0, _kcc_cstr_fixups@@PAGE
    add  x0, x0, _kcc_cstr_fixups@@PAGEOFF
    ldr x20, [x0]                  // fixup vec
    ldr x21, [x20, #VEC_COUNT]
    mov x22, #0

.Lces_fixup_loop:
    cmp x22, x21
    b.ge .Lces_append

    mov x0, x20
    mov x1, x22
    bl _kcc_vec_get
    ldr x23, [x0]                  // sym_index
    ldr x24, [x0, #8]             // cstr_offset

    // value = code_size + cstr_offset
    add x24, x19, x24

    // Update symbol entry
    adrp x0, _kcc_linker_syms@@PAGE
    add  x0, x0, _kcc_linker_syms@@PAGEOFF
    ldr x0, [x0]
    ldr x0, [x0, #VEC_DATA]
    mov x1, #SYM_ENTRY_SIZE
    mul x1, x23, x1
    add x0, x0, x1
    str x24, [x0, #SYM_VALUE]

    add x22, x22, #1
    b .Lces_fixup_loop

.Lces_append:
    // 3. Append cstring data to code buffer
    adrp x0, _kcc_cstr_pos@@PAGE
    add  x0, x0, _kcc_cstr_pos@@PAGEOFF
    ldr x23, [x0]                  // cstr total size

    adrp x0, _kcc_code_pos@@PAGE
    add  x0, x0, _kcc_code_pos@@PAGEOFF
    ldr x20, [x0]                  // code_pos

    adrp x0, _kcc_code_cap@@PAGE
    add  x0, x0, _kcc_code_cap@@PAGEOFF
    ldr x21, [x0]                  // code_cap

    // Grow if needed
    add x24, x20, x23
    cmp x24, x21
    b.le .Lces_copy

    lsl x0, x24, #1
    adrp x1, _kcc_code_cap@@PAGE
    add  x1, x1, _kcc_code_cap@@PAGEOFF
    str x0, [x1]
    bl _kcc_arena_alloc
    mov x21, x0

    adrp x0, _kcc_code_buf@@PAGE
    add  x0, x0, _kcc_code_buf@@PAGEOFF
    ldr x1, [x0]
    str x21, [x0]

    mov x0, x21
    mov x2, x20
    bl _kcc_memcpy

.Lces_copy:
    adrp x0, _kcc_code_buf@@PAGE
    add  x0, x0, _kcc_code_buf@@PAGEOFF
    ldr x0, [x0]
    add x0, x0, x20

    adrp x1, _kcc_cstr_buf@@PAGE
    add  x1, x1, _kcc_cstr_buf@@PAGEOFF
    ldr x1, [x1]

    mov x2, x23
    bl _kcc_memcpy

    // Update code_pos
    add x20, x20, x23
    adrp x0, _kcc_code_pos@@PAGE
    add  x0, x0, _kcc_code_pos@@PAGEOFF
    str x20, [x0]

.Lces_done:
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@| _kcc_codegen_emit_strings
@}

\section{CodeGen Data}

Module-level mutable state for the code generator: the current
function's frame size (set per-function, read by the instruction
dispatcher for alloca and epilogue emission) and four words for
the cstring subsystem---the data buffer, write position, literal
counter, and fixup vector pointer.

@d CodeGen: data @{
// -- CodeGen data -------------------------------------------------------------
.data
.p2align 3
.globl _kcc_cg_frame_size
_kcc_cg_frame_size:  .quad 0     // current function's frame size
.globl _kcc_cg_vreg_count
_kcc_cg_vreg_count:  .quad 0     // current function's vreg count
.globl _kcc_cg_slotmap
_kcc_cg_slotmap:     .quad 0     // per-function vreg→compacted spill-slot map
                                 // (0 = identity: slot index == vreg number)
.globl _kcc_cg_max_slot
_kcc_cg_max_slot:    .quad 0     // number of vreg value slots reserved in the frame
.globl _kcc_cstr_buf
_kcc_cstr_buf:       .quad 0     // cstring data buffer
.globl _kcc_cstr_cap
_kcc_cstr_cap:       .quad 0     // capacity (bytes) of the cstring buffer
.globl _kcc_cstr_pos
_kcc_cstr_pos:       .quad 0     // write position in cstring buffer
.globl _kcc_cstr_count
_kcc_cstr_count:     .quad 0     // string literal counter (for naming)
.globl _kcc_cstr_fixups
_kcc_cstr_fixups:    .quad 0     // vec of {sym_index, cstr_offset} fixups
.globl _kcc_rodata_const_present
_kcc_rodata_const_present: .quad 0 // 1 if a __DATA_CONST,__const section is needed
.globl _kcc_rodata_const_size
_kcc_rodata_const_size: .quad 0  // running byte size of the __const section
.globl _kcc_rodata_const_relocs
_kcc_rodata_const_relocs: .quad 0 // vec of {slot_offset, sym_index} for __const
.globl _kcc_rodata_const_fileoff
_kcc_rodata_const_fileoff: .quad 0 // file offset of __const data (set in finalize)
.globl _kcc_cg_defined_globals
_kcc_cg_defined_globals: .quad 0 // hash set: globals defined in this TU
.globl _kcc_cg_regmap
_kcc_cg_regmap:      .quad 0     // per-function vreg→physreg map (0 = all-spill)
.globl _kcc_cg_promoted
_kcc_cg_promoted:    .quad 0     // per-function map: alloca vreg → physreg holding
                                 // its CONTENTS (mem2reg), or 0 if not promoted
.globl _kcc_cg_callee_mask
_kcc_cg_callee_mask: .quad 0     // bitmask of callee-saved regs used (bit r-19)
.globl _kcc_cg_save_count
_kcc_cg_save_count:  .quad 0     // number of callee-saved regs to save
.globl _kcc_cg_save_base
_kcc_cg_save_base:   .quad 0     // byte offset of the callee-save area from x29
.globl _kcc_cg_fpregmap
_kcc_cg_fpregmap:    .quad 0     // per-function FP vreg→d-register map (0 = spill)
.globl _kcc_cg_fp_callee_mask
_kcc_cg_fp_callee_mask: .quad 0  // bitmask of callee-saved d-regs used (bit d-8)
.globl _kcc_cg_fp_save_count
_kcc_cg_fp_save_count:  .quad 0  // number of callee-saved d-regs to save
.globl _kcc_cg_fp_save_base
_kcc_cg_fp_save_base:   .quad 0  // byte offset of the FP callee-save area from x29
@| _kcc_cg_frame_size
@| _kcc_cg_promoted
@| _kcc_cg_fpregmap
@| _kcc_cg_fp_callee_mask
@| _kcc_cg_fp_save_count
@| _kcc_cg_fp_save_base
@| _kcc_cg_vreg_count
@| _kcc_cg_slotmap
@| _kcc_cg_max_slot
@| _kcc_cstr_buf
@| _kcc_cstr_pos
@| _kcc_cstr_count
@| _kcc_cstr_fixups
@| _kcc_rodata_const_present
@| _kcc_rodata_const_size
@| _kcc_rodata_const_relocs
@| _kcc_rodata_const_fileoff
@| _kcc_cg_defined_globals
@| _kcc_cg_regmap
@| _kcc_cg_callee_mask
@| _kcc_cg_save_count
@| _kcc_cg_save_base
@}
