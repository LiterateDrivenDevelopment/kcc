% kcc.weft — Master file for kcc: A Formal C17 Compiler in ARM64 Assembly
%
% This is a literate program in the tradition of Donald Knuth.
% The .weft source files are the ONLY source of truth.
% All assembly (.s) files are generated by tangling.
%
% Build:  just build        (tangle + assemble + link)
% Weave:  just doc          (generate LaTeX documentation)

@W tex

\documentclass[11pt,a4paper,twoside,openright,DIV=15]{scrbook}

% Page layout: DIV=15 gives a wider/taller type area suited to
% code-heavy literate programs.  KOMA-Script computes margins from
% DIV; 15 keeps readable margins while accommodating long code scraps.

% Engine-agnostic encoding and fonts
\usepackage{iftex}
\ifPDFTeX
  \usepackage[utf8]{inputenc}
  \usepackage[T1]{fontenc}
  \usepackage{lmodern}
\else
  \usepackage{fontspec}
\fi

% Mathematics
\usepackage{amsmath,amssymb,amsthm}

% Code listings
\usepackage{listings}
\usepackage{xcolor}

% Cross-references and links
\usepackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=blue!60!black,
  citecolor=green!50!black,
  urlcolor=blue!70!black,
  pdftitle={kcc --- A Formal C17 Compiler in ARM64 Assembly},
  pdfauthor={kcc project},
}

% Section styling
\usepackage{kcc-sections}

% weft weave emits old font commands that KOMA-Script disables by default:
\DeclareOldFontCommand{\tt}{\normalfont\ttfamily}{\mathtt}
\DeclareOldFontCommand{\bf}{\normalfont\bfseries}{\mathbf}
\DeclareOldFontCommand{\rm}{\normalfont\rmfamily}{\mathrm}
\DeclareOldFontCommand{\it}{\normalfont\itshape}{\mathit}
\DeclareOldFontCommand{\sf}{\normalfont\sffamily}{\mathsf}
\DeclareOldFontCommand{\sc}{\normalfont\scshape}{\mathsc}

% Listings configuration for ARM64 assembly
\lstdefinelanguage{aarch64}{
  morekeywords={mov,add,sub,stp,ldp,ldr,str,ldrb,strb,adrp,adr,
    bl,b,ret,svc,cbz,cbnz,cmp,tst,and,orr,eor,lsl,lsr,asr,
    mul,udiv,sdiv,madd,msub,neg,mvn,bic,
    b.eq,b.ne,b.lt,b.le,b.gt,b.ge,b.lo,b.hi,b.hs,b.ls,b.cc,b.cs,
    sxtw,uxtw,sxth,uxth,sxtb,uxtb,
    nop,brk,mrs,msr},
  morekeywords=[2]{x0,x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,
    x13,x14,x15,x16,x17,x18,x19,x20,x21,x22,x23,x24,x25,x26,
    x27,x28,x29,x30,sp,xzr,wzr,
    w0,w1,w2,w3,w4,w5,w6,w7,w8,w9,w10,w11,w12,w13,w14,w15,
    w16,w17,w18,w19,w20,w21,w22,w23,w24,w25,w26,w27,w28,w29,w30},
  morekeywords=[3]{.globl,.p2align,.text,.data,.bss,.equ,.asciz,
    .ascii,.quad,.long,.short,.byte,.space,.zerofill,.macro,.endm,
    .section,.comm,.if,.else,.endif},
  sensitive=true,
  morecomment=[l]{//},
  morestring=[b]",
}
\lstset{
  language=aarch64,
  basicstyle=\ttfamily\small,
  keywordstyle=\color{blue!70!black}\bfseries,
  keywordstyle=[2]\color{red!60!black},
  keywordstyle=[3]\color{green!40!black}\bfseries,
  commentstyle=\color{gray}\itshape,
  stringstyle=\color{orange!80!black},
  numbers=left,
  numberstyle=\tiny\color{gray},
  numbersep=8pt,
  tabsize=4,
  showstringspaces=false,
  breaklines=true,
  frame=single,
  rulecolor=\color{gray!30},
  xleftmargin=1.5em,
  framexleftmargin=1.5em,
}

% Theorem environments for formal semantics
\theoremstyle{definition}
\newtheorem{definition}{Definition}[chapter]
\newtheorem{requirement}{Requirement}[chapter]
\theoremstyle{plain}
\newtheorem{theorem}{Theorem}[chapter]
\newtheorem{lemma}[theorem]{Lemma}
\theoremstyle{remark}
\newtheorem{remark}{Remark}[chapter]

% Custom commands
\newcommand{\iso}[1]{\textsc{iso\,#1}}
\newcommand{\ub}{\textsc{ub}}
\newcommand{\idb}{\textsc{ib}}
\newcommand{\stdref}[1]{\S\,#1}
\newcommand{\kcc}{\textsf{kcc}}
\newcommand{\reg}[1]{\texttt{#1}}

% Title
\title{\kcc\\[0.5em]
  \Large A Formal C17 Compiler in ARM64 Assembly\\[0.3em]
  \large A Literate Program}
\author{The \kcc{} Project}
\date{\today}

\begin{document}
\maketitle
\tableofcontents

% Tolerate uneven page fills — weft scraps are unbreakable blocks
% that frequently leave partial pages. Without this, LaTeX forces
% equal-height columns and produces overfull/underfull vbox warnings.
\raggedbottom

% Forward-reference placeholders for chapters not yet implemented.
% Remove each line when the real chapter is added.
\makeatletter
\newcommand{\forwardlabel}[1]{\immediate\write\@@auxout{\string\newlabel{#1}{{??}{??}{}{}{}}}}
\makeatother
