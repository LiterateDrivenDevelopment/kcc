% 48h-self-hosting-diag.weft — Stage 8i: the diagnostic engine, written in C,
% compiled by kcc itself, and linked back into the compiler.

\chapter{Self-Hosting: The Diagnostic Engine in C}
\label{ch:self-hosting-diag}

The diagnostic engine of Chapter~\ref{ch:diagnostics} is the first ported
subsystem whose \emph{output} is itself under test.  It formats every error,
warning, and note the compiler emits---the \texttt{file:line:col: severity:
message} line, the offending source line, and a caret under the column---and
the \texttt{diagtest} and \texttt{warntest} suites check those bytes exactly.
A byte-compatible C port therefore has a second, independent verifier beyond
the code-generation suite: it must reproduce not just correct behaviour on
valid programs but the precise presentation of every rejection.

\section{State and Dependencies}

The engine owns two counters and one policy flag under their exact names:
\texttt{kcc\_diag\_error\_count}, \texttt{kcc\_diag\_warn\_count}, and the
exported \texttt{kcc\_warn\_all} (the \texttt{-Wall} switch the driver sets and
semantic analysis reads).  It writes through \texttt{kcc\_io\_err} and the raw
\texttt{kcc\_sys\_write}, and it reads the live source buffer
(\texttt{kcc\_src\_base}/\texttt{kcc\_src\_size}/\texttt{kcc\_src\_path}) that
the now-C source manager exports---so a diagnostic renders the true offending
line.  Two file-local helpers stay internal: \texttt{diag\_putu} prints a
decimal to stderr, and \texttt{diag\_caret} draws the snippet.

@l c
@d Selfhost: diag preamble @{
long kcc_sys_write(long fd, const void *buf, unsigned long n);
void kcc_sys_exit(int status);
void kcc_io_err(const char *s);

extern void *kcc_src_base;
extern unsigned long kcc_src_size;
extern const char *kcc_src_path;

unsigned long kcc_diag_error_count = 0;
unsigned long kcc_diag_warn_count = 0;
unsigned long kcc_warn_all = 0;

static void diag_putu(unsigned long n) {
    char buf[24];
    int i = 24;
    if (n == 0) {
        i = i - 1;
        buf[i] = '0';
    } else {
        while (n) {
            i = i - 1;
            buf[i] = (char)('0' + (n % 10));
            n = n / 10;
        }
    }
    kcc_sys_write(2, &buf[i], (unsigned long)(24 - i));
}
@}

\section{The Caret}

\texttt{diag\_caret} walks the source to the target line, writes it, then
assembles the caret line: \texttt{col$-$1} indent characters (a tab copied from
the source where the source has one, so the terminal's tab stops keep the caret
aligned; a space otherwise), clamped to 500, then the caret and a newline.  It
is unfailing---a null buffer, a zero line, or a line past the end simply
suppresses the snippet.

@l c
@d Selfhost: diag caret @{
static void diag_caret(unsigned long line, unsigned long col) {
    unsigned char *base = (unsigned char *)kcc_src_base;
    if (base == 0) return;
    if (line == 0) return;
    unsigned char *end = base + kcc_src_size;
    unsigned char *p = base;
    unsigned long cur = 1;
    while (cur < line) {
        if (p >= end) return;
        unsigned char c = *p;
        p = p + 1;
        if (c == 10) cur = cur + 1;
    }
    unsigned char *lstart = p;
    unsigned char *lend = p;
    while (lend < end && *lend != 10) lend = lend + 1;
    kcc_sys_write(2, lstart, (unsigned long)(lend - lstart));
    kcc_io_err("\n");

    char buf[512];
    unsigned long k = 0;
    unsigned long indent = (col > 1) ? (col - 1) : 0;
    unsigned char *sc = lstart;
    while (indent > 0 && k < 500) {
        char ch = 32;
        if (sc < lend && *sc == 9) ch = 9;
        buf[k] = ch;
        k = k + 1;
        sc = sc + 1;
        indent = indent - 1;
    }
    buf[k] = '^';
    k = k + 1;
    buf[k] = 10;
    k = k + 1;
    kcc_sys_write(2, buf, k);
}
@}

\section{Emit and Wrappers}

\texttt{kcc\_diag\_emit} prints the location and message, draws the caret, and
updates the counters: an error past the twentieth is fatal (the same limit the
assembly enforced), and a warning bumps its own count.  The three public
wrappers fix the severity; \texttt{kcc\_diag\_had\_errors} and
\texttt{kcc\_diag\_reset} query and clear.  The severity constants are the
assembly's (error~0, warning~1, note~2), and the format strings---%
\texttt{<input>} for a missing path, the colons, and the severity words---match
byte for byte.

@l c
@d Selfhost: diag emit @{
void kcc_diag_emit(int severity, unsigned long line, unsigned long col,
                   const char *msg) {
    if (kcc_src_path) kcc_io_err(kcc_src_path);
    else kcc_io_err("<input>");
    kcc_io_err(":");
    diag_putu(line);
    kcc_io_err(":");
    diag_putu(col);
    kcc_io_err(": ");
    if (severity == 1) kcc_io_err("warning");
    else if (severity == 2) kcc_io_err("note");
    else kcc_io_err("error");
    kcc_io_err(": ");
    kcc_io_err(msg);
    kcc_io_err("\n");
    diag_caret(line, col);
    if (severity == 0) {
        kcc_diag_error_count = kcc_diag_error_count + 1;
        if (kcc_diag_error_count >= 20) {
            kcc_io_err("kcc: fatal: too many errors emitted, stopping\n");
            kcc_sys_exit(1);
        }
    } else if (severity == 1) {
        kcc_diag_warn_count = kcc_diag_warn_count + 1;
    }
}

void kcc_diag_error(unsigned long line, unsigned long col, const char *msg) {
    kcc_diag_emit(0, line, col, msg);
}
void kcc_diag_warning(unsigned long line, unsigned long col, const char *msg) {
    kcc_diag_emit(1, line, col, msg);
}
void kcc_diag_note(unsigned long line, unsigned long col, const char *msg) {
    kcc_diag_emit(2, line, col, msg);
}

unsigned long kcc_diag_had_errors(void) {
    return kcc_diag_error_count;
}
void kcc_diag_reset(void) {
    kcc_diag_error_count = 0;
    kcc_diag_warn_count = 0;
}
@}

\section{Assembling the Translation Unit}

@l c
@d Selfhost: diag @{
@<Selfhost: diag preamble@>
@<Selfhost: diag caret@>
@<Selfhost: diag emit@>
@}

\section{Verification}
\label{sec:selfhost-diag-verify}

\texttt{make selfhost-diag} runs the drop-in loop through the code-generation
suite, and because this subsystem's product is error text, the swapped-in
compiler is \emph{also} exercised by \texttt{make diagtest} and
\texttt{make warntest}, whose 23 and 31 checks compare the exact stderr of a
rejected or warned program.  A clean sweep of all three means \kcc{} compiled
its own diagnostics---format, caret, and counters---byte for byte.

@d Selfhost: diag verify @{
#!/usr/bin/env bash
# make selfhost-diag — compile kcc's diagnostic engine in C with kcc, relink,
# run the codegen, diagnostic, and warning suites.
set -euo pipefail

SDK=$(xcrun --show-sdk-path)
SH=tmp/selfhost
sources="main syscalls arena strings io hashtab vec strtab source lexer \
lexer_tables diag preprocessor parser expressions statements declarations \
types symtab conversions sema ir opt emit_arm64 emit_x86 linker codegen emit_macho dwarf driver"

echo "[1/3] compiling tmp/selfhost/diag.c with kcc"
tmp/kcc -c "$SH/diag.c" -o "$SH/diag_c.o" >/dev/null

echo "[2/3] linking tmp/kcc_selfhost_diag (diag.o -> kcc-compiled diag_c.o)"
OBJ=""
for f in $sources; do
    if [ "$f" = "diag" ]; then OBJ="$OBJ $SH/diag_c.o"; else OBJ="$OBJ tmp/src/${f}.o"; fi
done
ld -o tmp/kcc_selfhost_diag $OBJ -lSystem -syslibroot "$SDK" -e _main -arch arm64

echo "[3/3] running codegen + diagtest + warntest with the self-hosted diagnostics"
cp tmp/kcc "$SH/kcc_asm_backup_diag"
cp tmp/kcc_selfhost_diag tmp/kcc
set +e
bash tmp/tests/test_codegen.sh; s1=$?
bash tmp/tests/diagtest.sh;      s2=$?
bash tmp/tests/warntest.sh;      s3=$?
cp "$SH/kcc_asm_backup_diag" tmp/kcc
[ $s1 -eq 0 ] && [ $s2 -eq 0 ] && [ $s3 -eq 0 ]
@}
