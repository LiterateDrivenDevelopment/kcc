% 36-dce.weft — Dead Code Elimination
%
% Removes IR instructions whose results are never used.
% Phase 1: mark all vregs that appear as sources.
% Phase 2: sweep instructions whose dest is unmarked and that
%           have no side effects.

\chapter{Dead Code Elimination}
\label{ch:dce}

After constant folding and identity elimination have simplified the IR, some instructions may no longer contribute to the program's output---their destination vregs are never referenced by any subsequent instruction.  This chapter removes such dead code through a mark-and-sweep algorithm.  The mark pass records every vreg that appears as a source operand; the sweep pass deletes any instruction whose destination vreg was not marked, provided the instruction has no side effects (stores, calls, branches, and returns are always preserved).

\section{Dead Code Elimination}

DCE removes instructions whose results are never used.  It works in two
passes: a \emph{mark} pass walks every instruction and records which
vregs are live (referenced as sources), and a \emph{sweep} pass deletes
any instruction whose destination vreg was not marked.  Instructions
with side effects---stores, calls, branches, returns---are never deleted
regardless of whether their result is used.

\subsection{Setup and Bitmap Allocation}

The function begins by allocating a dense used-vreg bitmap sized to
the function's vreg count.  Each slot is eight bytes wide (one machine
word) for alignment convenience; a non-zero value means the vreg is
referenced somewhere in the function.  The bitmap is zeroed before the
mark pass begins.

@d Opt: dead code elimination @{
// -- kcc_opt_dce ----------------------------------------------------------
// uint64_t kcc_opt_dce(ir_func *func)
// Eliminates dead instructions.  Returns number of eliminations.
.text
.globl _kcc_opt_dce
.p2align 2
_kcc_opt_dce:
    stp x29, x30, [sp, #-96]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    stp x25, x26, [sp, #64]
    str x27, [sp, #80]

    mov x19, x0                 // func
    mov x27, #0                 // elimination count

    ldr x20, [x19, #IRF_VREG_N]
    cbz x20, .Ldce_done
    add x20, x20, #1

    // Allocate used bitmap (8 bytes per vreg for simplicity)
    lsl x0, x20, #3
    bl _kcc_arena_alloc
    mov x21, x0                 // used array

    // Zero it
    mov x0, x21
    mov x1, #0
    lsl x2, x20, #3
    bl _kcc_memset
@| _kcc_opt_dce
@}

\subsection{Mark Pass}

The mark pass iterates every instruction in every basic block and records
which vregs are referenced as source operands.  Special care is needed
for instructions whose fields carry non-vreg data: \texttt{IR\_CONST}
encodes an immediate in \texttt{src1}, \texttt{IR\_CALL} stores a
function name pointer, and branch instructions carry basic-block
identifiers.  A subtler case is the \texttt{IR\_NOP} left behind by an
earlier sweep: its source fields still hold whatever they carried before
deletion (a folded constant leaves \texttt{src2} at zero), so reading them
would spuriously mark vreg~0---or another---as used and keep a genuinely
dead instruction alive across the fixed point.  Because the pass and the
sweep run in a loop, a \texttt{NOP} must therefore be skipped outright.
The pass also handles \texttt{IR\_CALL} argument arrays by walking each
element and marking the argument vregs individually.

@d Opt: dead code elimination @{
    // Pass 1: mark used vregs
    ldr x0, [x19, #IRF_BLOCKS]
    cbz x0, .Ldce_done
    mov x22, x0                 // blocks vec
    ldr x23, [x22, #VEC_COUNT]
    mov x24, #0

.Ldce_mark_bb:
    cmp x24, x23
    b.ge .Ldce_sweep

    mov x0, x22
    mov x1, x24
    bl _kcc_vec_get
    ldr x25, [x0]               // BB ptr

    ldr x0, [x25, #BB_FIRST]
.Ldce_mark_instr:
    cbz x0, .Ldce_mark_next_bb
    mov x26, x0

    // A NOP (an instruction a previous sweep already deleted) references
    // nothing.  Its src fields still hold whatever they did before deletion---a
    // folded constant leaves src2 = 0---so reading them here would spuriously
    // mark vreg 0 (or another) as used, keeping a genuinely dead instruction
    // alive across the fixed point.  Skip NOPs entirely.
    ldr x2, [x26, #IR_OP]
    cmp x2, #IR_NOP
    b.eq .Ldce_mark_next

    // Mark SRC1 as used (if it looks like a vreg — <vreg_n)
    ldr x1, [x26, #IR_SRC1]
    ldr x2, [x26, #IR_OP]

    // Skip marking SRC1 for IR_CONST (src1=immediate), IR_CALL (src1=name),
    // IR_BR (src1=BB id), IR_GLOBAL_REF (src1=name)
    // IR_CALL_IND SRC1 is a vreg — DO mark it
    cmp x2, #IR_CONST
    b.eq .Ldce_mark_src2
    cmp x2, #IR_CALL
    b.eq .Ldce_mark_src2
    cmp x2, #IR_BR
    b.eq .Ldce_mark_src2
    cmp x2, #IR_GLOBAL_REF
    b.eq .Ldce_mark_src2

    cmp x1, x20
    b.ge .Ldce_mark_src2
    mov x3, #1
    str x3, [x21, x1, lsl #3]

.Ldce_mark_src2:
    ldr x1, [x26, #IR_SRC2]
    ldr x2, [x26, #IR_OP]

    // Skip SRC2 for IR_BR_COND (src2=BB id), IR_BR (no src2)
    cmp x2, #IR_BR_COND
    b.eq .Ldce_mark_dest
    cmp x2, #IR_BR
    b.eq .Ldce_mark_dest
    cmp x2, #IR_CONST
    b.eq .Ldce_mark_dest

    // IR_CALL/IR_CALL_IND: SRC2 is a pointer to args array, mark each arg vreg
    cmp x2, #IR_CALL
    b.eq .Ldce_mark_call_args
    cmp x2, #IR_CALL_IND
    b.eq .Ldce_mark_call_args

    cmp x1, x20
    b.ge .Ldce_mark_dest
    mov x3, #1
    str x3, [x21, x1, lsl #3]
    b .Ldce_mark_dest

.Ldce_mark_call_args:
    // x1 = SRC2 = pointer to [count, vreg0, class0, vreg1, class1, ...]
    // Two words per argument; the vreg is at offset 1 + index*2.
    cbz x1, .Ldce_mark_dest
    ldr x4, [x1]                 // packed: count | (first_stack_idx << 32)
    and x4, x4, #0xffffffff      // count (low half; high half is the ABI hint)
    mov x5, #0                    // index
.Ldce_mark_call_arg_loop:
    cmp x5, x4
    b.ge .Ldce_mark_dest
    lsl x6, x5, #1
    add x6, x6, #1               // offset = 1 + index*2
    ldr x7, [x1, x6, lsl #3]    // vreg = args[1 + index*2]
    cmp x7, x20
    b.ge .Ldce_mark_call_arg_next
    mov x3, #1
    str x3, [x21, x7, lsl #3]   // mark vreg as used
.Ldce_mark_call_arg_next:
    add x5, x5, #1
    b .Ldce_mark_call_arg_loop

.Ldce_mark_dest:
    // Also mark DEST for br_cond (dest=condition vreg)
    ldr x2, [x26, #IR_OP]
    cmp x2, #IR_BR_COND
    b.ne .Ldce_mark_ret
    ldr x1, [x26, #IR_DEST]
    cmp x1, x20
    b.ge .Ldce_mark_ret
    mov x3, #1
    str x3, [x21, x1, lsl #3]

.Ldce_mark_ret:
    // Mark SRC1 for ret (src1=return value vreg)
    ldr x2, [x26, #IR_OP]
    cmp x2, #IR_RET
    b.ne .Ldce_mark_store
    ldr x1, [x26, #IR_SRC1]
    cmp x1, x20
    b.ge .Ldce_mark_next
    mov x3, #1
    str x3, [x21, x1, lsl #3]
    b .Ldce_mark_next

.Ldce_mark_store:
    // Mark both src1 and src2 for store
    ldr x2, [x26, #IR_OP]
    cmp x2, #IR_STORE
    b.ne .Ldce_mark_next
    ldr x1, [x26, #IR_SRC1]
    cmp x1, x20
    b.ge .Ldce_mark_store2
    mov x3, #1
    str x3, [x21, x1, lsl #3]
.Ldce_mark_store2:
    ldr x1, [x26, #IR_SRC2]
    cmp x1, x20
    b.ge .Ldce_mark_next
    mov x3, #1
    str x3, [x21, x1, lsl #3]

.Ldce_mark_next:
    ldr x0, [x26, #IR_NEXT]
    b .Ldce_mark_instr

.Ldce_mark_next_bb:
    add x24, x24, #1
    b .Ldce_mark_bb
@}

\subsection{Sweep Pass}

Armed with the completed used-vreg bitmap, the sweep pass makes a second
traversal over every instruction.  Any instruction whose destination vreg
is not marked as used---and that has no side effects---is replaced with
\texttt{IR\_NOP}.  Side-effecting instructions (\texttt{IR\_STORE},
\texttt{IR\_BR}, \texttt{IR\_BR\_COND}, \texttt{IR\_RET},
\texttt{IR\_CALL}) and stack allocations (\texttt{IR\_ALLOCA}) are
unconditionally preserved.  The function returns the total number of
eliminations so the pass manager can detect whether another round of
optimization is warranted.

@d Opt: dead code elimination @{
    // Pass 2: sweep — replace dead non-side-effect instructions with NOP
.Ldce_sweep:
    mov x24, #0

.Ldce_sweep_bb:
    cmp x24, x23
    b.ge .Ldce_done

    mov x0, x22
    mov x1, x24
    bl _kcc_vec_get
    ldr x25, [x0]

    ldr x0, [x25, #BB_FIRST]
.Ldce_sweep_instr:
    cbz x0, .Ldce_sweep_next_bb
    mov x26, x0

    ldr x1, [x26, #IR_OP]
    // Skip side-effecting instructions
    cmp x1, #IR_STORE
    b.eq .Ldce_sweep_skip
    cmp x1, #IR_BR
    b.eq .Ldce_sweep_skip
    cmp x1, #IR_BR_COND
    b.eq .Ldce_sweep_skip
    cmp x1, #IR_RET
    b.eq .Ldce_sweep_skip
    cmp x1, #IR_CALL
    b.eq .Ldce_sweep_skip
    cmp x1, #IR_CALL_IND
    b.eq .Ldce_sweep_skip
    cmp x1, #IR_NOP
    b.eq .Ldce_sweep_skip
    cmp x1, #IR_ALLOCA
    b.eq .Ldce_sweep_skip       // keep allocas

    // A volatile load is a side effect: the read must occur even if its value
    // is unused, so it is never dead.
    cmp x1, #IR_LOAD
    b.ne .Ldce_notvol
    ldr x2, [x26, #IR_TYPE]
    cmp x2, #0x1000
    b.lo .Ldce_notvol
    ldr x2, [x2, #TY_QUALS]
    tst x2, #2
    b.ne .Ldce_sweep_skip
.Ldce_notvol:

    // Check if dest vreg is used
    ldr x2, [x26, #IR_DEST]
    cmp x2, x20
    b.ge .Ldce_sweep_skip
    ldr x3, [x21, x2, lsl #3]
    cbnz x3, .Ldce_sweep_skip

    // Dead! Replace with NOP
    mov x1, #IR_NOP
    str x1, [x26, #IR_OP]
    add x27, x27, #1

.Ldce_sweep_skip:
    ldr x0, [x26, #IR_NEXT]
    b .Ldce_sweep_instr

.Ldce_sweep_next_bb:
    add x24, x24, #1
    b .Ldce_sweep_bb

.Ldce_done:
    mov x0, x27

    ldr x27, [sp, #80]
    ldp x25, x26, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #96
    ret
@}
