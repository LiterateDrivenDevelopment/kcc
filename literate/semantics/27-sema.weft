% 27-sema.weft — Semantic Analysis
%
% This chapter implements the semantic analysis pass that walks the AST,
% resolves types, populates the symbol table, and checks type constraints.
% After this pass, every expression node has a resolved type in AST_F3.

\chapter{Semantic Analysis}
\label{ch:sema}

Parsing produces a syntactically valid AST, but many constraints in the C language are semantic rather than syntactic: an operand must have arithmetic type for \texttt{+}, a function call must match its prototype, and every identifier must resolve to a visible declaration.  This chapter implements the semantic analysis pass that enforces these rules.  It walks the AST top-down, resolves declaration types using the type system from Chapter~\ref{ch:types}, populates the symbol table from Chapter~\ref{ch:symtab}, and annotates every expression node with its resolved type.  The chapter is organized around three domains: declaration checking, statement checking, and expression checking.

\section{Entry Point}

The top-level entry point receives the \texttt{AST\_TRANS\_UNIT} node
and walks its linked list of declarations (chained via
\texttt{AST\_F4}).  For each declaration it delegates to
\texttt{\_kcc\_sema\_check\_decl}, which resolves types and
populates the symbol table.

@d Sema: check @{
// -- kcc_sema_check -------------------------------------------------------
// void kcc_sema_check(node *trans_unit)
//   x0 = AST_TRANS_UNIT node
// Walks all top-level declarations.
.text
.globl _kcc_sema_check
.p2align 2
_kcc_sema_check:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    // Get first declaration
    ldr x19, [x0, #AST_F0]         // first decl

.Lsc_loop:
    cbz x19, .Lsc_done

    mov x0, x19
    bl _kcc_sema_check_decl

    // Next sibling
    ldr x19, [x19, #AST_F4]
    b .Lsc_loop

.Lsc_done:
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_sema_check
@}

\section{Type Resolution}

Type resolution converts parser-produced AST type nodes into the
canonical type descriptors from Chapter~\ref{ch:types}.  The
dispatcher handles nine type node kinds: built-in types use the
specifier bitmask to select a pre-allocated singleton; pointer, array,
and function types recurse into their children and call the
corresponding type constructor.  Struct and union nodes with a body
(field list) create a new type descriptor; those without a body are
forward references and look up the tag in the symbol table to find
the original definition.  Typedef names are resolved via
symbol table lookup.  Qualified types are currently passed through to
the base type.  Any unrecognised or null type node falls back to
\texttt{int}.

@d Sema: resolve type @{
// -- kcc_sema_resolve_type ------------------------------------------------
// type_desc *kcc_sema_resolve_type(node *type_node)
//   x0 = AST type node (AST_TYPE_BUILTIN, AST_TYPE_PTR, etc.)
// Returns type descriptor pointer.
.text
.globl _kcc_sema_resolve_type
.p2align 2
_kcc_sema_resolve_type:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    cbz x0, .Lsrt_null
    mov x19, x0

    ldr x0, [x19, #AST_TAG]

    cmp x0, #AST_TYPE_BUILTIN
    b.eq .Lsrt_builtin
    cmp x0, #AST_TYPE_PTR
    b.eq .Lsrt_ptr
    cmp x0, #AST_TYPE_ARRAY
    b.eq .Lsrt_array
    cmp x0, #AST_TYPE_FUNC
    b.eq .Lsrt_func
    cmp x0, #AST_TYPE_STRUCT
    b.eq .Lsrt_struct
    cmp x0, #AST_TYPE_UNION
    b.eq .Lsrt_union
    cmp x0, #AST_TYPE_ENUM
    b.eq .Lsrt_enum
    cmp x0, #AST_TYPE_NAME
    b.eq .Lsrt_name
    cmp x0, #AST_TYPE_QUALS
    b.eq .Lsrt_quals

    // Unknown type node → return int as fallback
    b .Lsrt_fallback

.Lsrt_builtin:
    // F0 = specifier bitmask
    ldr x0, [x19, #AST_F0]
    bl _kcc_type_from_specmask
    cbz x0, .Lsrt_fallback
    b .Lsrt_done

.Lsrt_ptr:
    // F0 = pointee type node
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_resolve_type
    bl _kcc_type_ptr
    b .Lsrt_done

.Lsrt_array:
    // F0 = element type node, F1 = size expr (or 0)
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_resolve_type
    mov x20, x0                     // element type

    // Array length: evaluate constant expr if present
    ldr x1, [x19, #AST_F1]
    cbz x1, .Lsrt_array_incomplete
    // For now, if size_expr is INT_LIT, use its value
    ldr x2, [x1, #AST_TAG]
    cmp x2, #AST_INT_LIT
    b.ne .Lsrt_array_incomplete
    ldr x1, [x1, #AST_F0]          // literal value
    b .Lsrt_array_make

.Lsrt_array_incomplete:
    mov x1, #0                      // incomplete array

.Lsrt_array_make:
    mov x0, x20
    bl _kcc_type_array
    b .Lsrt_done

.Lsrt_func:
    // F0 = return type node, F1 = params (linked list)
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_resolve_type
    mov x20, x0                     // return type

    // For now, create function type without resolving params
    mov x0, x20                     // return type
    mov x1, #0                      // no param vec
    bl _kcc_type_func
    b .Lsrt_done

.Lsrt_struct:
    // F0 = struct_decl AST node
    // If the decl has fields, create a new type from it.
    // If not (forward ref), look up the tag in the symbol table.
    ldr x20, [x19, #AST_F0]        // AST_STRUCT_DECL
    cbz x20, .Lsrt_fallback
    ldr x0, [x20, #AST_F1]         // fields
    cbnz x0, .Lsrt_struct_new
    // No fields: look up tag
    ldr x0, [x20, #AST_F0]         // tag name_ptr
    cbz x0, .Lsrt_struct_new
    mov x20, x0
    bl _kcc_strlen
    mov x1, x0
    mov x0, x20
    bl _kcc_symtab_lookup_tag
    cbz x0, .Lsrt_fallback
    ldr x0, [x0, #SYM_TYPE]        // sym → type descriptor
    b .Lsrt_done
.Lsrt_struct_new:
    mov x0, x20
    bl _kcc_type_struct
    b .Lsrt_done

.Lsrt_union:
    // Same logic as struct: look up tag if no fields
    ldr x20, [x19, #AST_F0]
    cbz x20, .Lsrt_fallback
    ldr x0, [x20, #AST_F1]
    cbnz x0, .Lsrt_union_new
    ldr x0, [x20, #AST_F0]
    cbz x0, .Lsrt_union_new
    mov x20, x0
    bl _kcc_strlen
    mov x1, x0
    mov x0, x20
    bl _kcc_symtab_lookup_tag
    cbz x0, .Lsrt_fallback
    ldr x0, [x0, #SYM_TYPE]        // sym → type descriptor
    b .Lsrt_done
.Lsrt_union_new:
    mov x0, x20
    bl _kcc_type_union
    b .Lsrt_done

.Lsrt_enum:
    ldr x0, [x19, #AST_F0]
    bl _kcc_type_enum
    b .Lsrt_done

.Lsrt_name:
    // Typedef name: lookup in symbol table
    ldr x20, [x19, #AST_F0]        // interned name ptr
    cbz x20, .Lsrt_fallback
    mov x0, x20
    bl _kcc_strlen
    mov x1, x0                     // len
    mov x0, x20                    // name
    bl _kcc_symtab_lookup
    cbz x0, .Lsrt_name_builtin

    // Found symbol: return its type
    ldr x0, [x0, #SYM_TYPE]
    b .Lsrt_done

.Lsrt_name_builtin:
    // Built-in typedef va_list → an 8-byte pointer.  (No <stdarg.h>: the
    // variadic builtins below treat it as an opaque cursor into the stack.)
    mov x0, x20
    adrp x1, _kcc_sema_str_va_list@@PAGE
    add  x1, x1, _kcc_sema_str_va_list@@PAGEOFF
    bl _kcc_strcmp
    cbnz x0, .Lsrt_fallback
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr x0, [x0]
    bl _kcc_type_ptr
    b .Lsrt_done

.Lsrt_quals:
    // F0 = base type node, F1 = qualifier flags
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_resolve_type
    // TODO: apply qualifiers to a copy of the descriptor
    // For now, just return the base type
    b .Lsrt_done

.Lsrt_null:
.Lsrt_fallback:
    // Default to int
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr  x0, [x0]

.Lsrt_done:
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_sema_resolve_type
@}

\section{Declaration Checking}

The declaration checker dispatches on the AST tag to handle each
declaration kind.  Variable declarations resolve their type and
register a \texttt{SYM\_VAR} in the symbol table, optionally
type-checking the initialiser.  Function declarations resolve the
return type, wrap it in a \texttt{TY\_FUNC} descriptor via
\texttt{\_kcc\_type\_func}, and register the resulting function type
as \texttt{SYM\_FUNC}.  The \texttt{TY\_FUNC} wrapper is essential:
without it, identifier lookup returns the bare return type, and
function-decay produces the wrong kind of pointer---the call handler
then falls back to \texttt{int}, corrupting pointer return values.
After registration the checker pushes a scope for parameters and body,
then checks the body statements.  Typedef declarations register
\texttt{SYM\_TYPEDEF}.  Struct and union declarations register the
tag in the tag namespace via \texttt{\_kcc\_symtab\_declare\_tag}.
After creating the type descriptor, the checker counts the struct's
fields and sets \texttt{TY\_SIZE} to $\mathit{nfields}\times 8$,
matching the all-spill backend's slot size.  This size is essential
for pointer subscript on struct pointers (\texttt{arr[i].x}), where
the stride must equal the full struct width.
Enum declarations register the tag and walk the enumerator list,
assigning each constant an incrementing integer value.  The parser
wraps standalone enum declarations in an \texttt{AST\_TYPE\_ENUM}
node; the dispatcher unwraps it to reach the inner
\texttt{AST\_ENUM\_DECL} before processing.  The same unwrapping
is needed in the statement checker, since enums may be declared
inside function bodies.

@d Sema: check declaration @{
// -- kcc_sema_check_decl --------------------------------------------------
// void kcc_sema_check_decl(node *decl)
//   x0 = declaration AST node
// Processes declarations, registers symbols.
.text
.globl _kcc_sema_check_decl
.p2align 2
_kcc_sema_check_decl:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]

    cbz x0, .Lscd_done
    mov x19, x0

    ldr x20, [x19, #AST_TAG]

    cmp x20, #AST_VAR_DECL
    b.eq .Lscd_var
    cmp x20, #AST_FUNC_DECL
    b.eq .Lscd_func
    cmp x20, #AST_TYPEDEF_DECL
    b.eq .Lscd_typedef
    cmp x20, #AST_STRUCT_DECL
    b.eq .Lscd_struct
    cmp x20, #AST_UNION_DECL
    b.eq .Lscd_struct       // same handling as struct
    cmp x20, #AST_TYPE_STRUCT
    b.eq .Lscd_type_struct
    cmp x20, #AST_TYPE_UNION
    b.eq .Lscd_type_struct
    cmp x20, #AST_ENUM_DECL
    b.eq .Lscd_enum
    cmp x20, #AST_TYPE_ENUM
    b.eq .Lscd_type_enum

    // Other nodes (e.g., static_assert): skip
    b .Lscd_done

.Lscd_var:
    // Resolve type
    ldr x0, [x19, #AST_F0]         // type node
    bl _kcc_sema_resolve_type
    mov x21, x0                     // resolved type

    // Register in symbol table
    ldr x0, [x19, #AST_F1]         // name_ptr
    cbz x0, .Lscd_var_init
    mov x22, x0
    bl _kcc_strlen
    mov x1, x0                     // len
    mov x0, x22                    // name
    mov x2, #SYM_VAR
    mov x3, x21
    bl _kcc_symtab_declare

.Lscd_var_init:
    // Check initializer if present
    ldr x0, [x19, #AST_F2]
    cbz x0, .Lscd_done
    bl _kcc_sema_expr
    b .Lscd_done

.Lscd_func:
    // Resolve return type
    ldr x0, [x19, #AST_F0]         // type node
    bl _kcc_sema_resolve_type
    // Wrap in TY_FUNC so callers see a proper function type
    mov x1, #0                     // no param vec for now
    bl _kcc_type_func
    mov x21, x0                     // TY_FUNC descriptor

    // Variadic prototype: record the fixed-param count in TY_QUALS (see prose).
    ldr x2, [x19, #AST_F2]         // params pointer (bit 0 = variadic)
    tst x2, #1
    b.eq .Lscd_func_declared
    bic x2, x2, #1
    mov x3, #0                     // nfixed
.Lscd_func_nfixed:
    cbz x2, .Lscd_func_setq
    add x3, x3, #1
    ldr x2, [x2, #AST_F4]
    b .Lscd_func_nfixed
.Lscd_func_setq:
    str x3, [x21, #TY_QUALS]
.Lscd_func_declared:

    // Register function in symbol table
    ldr x0, [x19, #AST_F1]         // name_ptr
    cbz x0, .Lscd_func_body
    mov x22, x0
    bl _kcc_strlen
    mov x1, x0
    mov x0, x22
    mov x2, #SYM_FUNC
    mov x3, x21
    bl _kcc_symtab_declare

.Lscd_func_body:
    // Check function body if present
    ldr x0, [x19, #AST_F3]         // body
    cbz x0, .Lscd_done

    // Store current function return type (extract from TY_FUNC)
    ldr x0, [x21, #TY_F0]          // return type from TY_FUNC
    adrp x1, _kcc_sema_cur_ret@@PAGE
    add  x1, x1, _kcc_sema_cur_ret@@PAGEOFF
    str x0, [x1]

    // Push scope for function body
    bl _kcc_symtab_push_scope
    bl _kcc_symtab_label_begin

    // Process parameters (mask the variadic tag in bit 0)
    ldr x0, [x19, #AST_F2]         // first param (bit 0 = variadic)
    bic x0, x0, #1
.Lscd_param_loop:
    cbz x0, .Lscd_func_stmts
    mov x22, x0

    // Resolve param type and register
    ldr x0, [x22, #AST_F0]         // param type node
    bl _kcc_sema_resolve_type
    mov x21, x0

    ldr x0, [x22, #AST_F1]         // param name
    cbz x0, .Lscd_param_next
    mov x20, x0
    bl _kcc_strlen
    mov x1, x0
    mov x0, x20
    mov x2, #SYM_VAR
    mov x3, x21
    bl _kcc_symtab_declare

.Lscd_param_next:
    ldr x0, [x22, #AST_F4]         // next param
    b .Lscd_param_loop

.Lscd_func_stmts:
    // Check function body statements
    ldr x0, [x19, #AST_F3]
    bl _kcc_sema_check_stmt

    bl _kcc_symtab_label_end
    bl _kcc_symtab_pop_scope
    b .Lscd_done
@| _kcc_sema_check_decl
@}

\paragraph{Typedefs, Aggregate Tags, and Enumerations}

Typedef declarations resolve the underlying type and register the name
with kind \texttt{SYM\_TYPEDEF}.  Struct and union declarations create
the corresponding type descriptor via \texttt{kcc\_type\_struct} or
\texttt{kcc\_type\_union} and register the tag in the tag name space.
The struct size, alignment, and per-field byte offsets are computed by
\texttt{\_kcc\_type\_layout} (below), which lays out the aggregate
following the standard C rules rather than the earlier one-slot-per-field
approximation.
Enum declarations register both the tag itself and each enumerator
constant as an ordinary symbol of type \texttt{int}, assigning
consecutive integer values starting from zero.

\paragraph{Aggregate Layout}

\texttt{\_kcc\_type\_layout} computes the byte-accurate layout of a
\texttt{struct} or \texttt{union} following \stdref{6.7.2.1}: each member
is placed at the next offset that satisfies its alignment, the aggregate's
alignment is the maximum member alignment, and the total size is padded up
to that alignment.  For a \texttt{union} every member sits at offset~0 and
the size is the largest member's size.  The routine is idempotent and
memoised: once \texttt{TY\_SIZE} is non-zero the cached layout is returned,
so it is safe to call from any later phase (\texttt{sizeof}, alloca sizing,
member addressing) to force a lazy layout.  Each member's byte offset is
stored in its declaration node's \texttt{AST\_F3} slot, from which the IR
builder reads it when addressing a member.  Because a member of aggregate
type must be laid out before its own offset can be known, the routine
recurses into nested aggregates first, and it recomputes array sizes from
the (possibly just-laid-out) element type; C forbids a struct from
containing itself by value, so the recursion always terminates.
\texttt{\_kcc\_type\_align} returns a type's alignment, reading
\texttt{TY\_ALIGN} directly for scalars, pointers, and already-laid-out
aggregates, and recursing through the element type of an array.

@d Sema: struct layout @{
// -- kcc_type_align -------------------------------------------------------
// uint64_t kcc_type_align(type_desc *ty)
//   Alignment in bytes; 8 for null/unknown.  Arrays inherit element align.
.text
.globl _kcc_type_align
.p2align 2
_kcc_type_align:
    cbz x0, .Lta_def
    ldr x1, [x0, #TY_KIND]
    cmp x1, #TY_ARRAY
    b.ne .Lta_read
    ldr x0, [x0, #TY_F0]        // element type
    b _kcc_type_align           // tail recurse
.Lta_read:
    ldr x0, [x0, #TY_ALIGN]
    cbz x0, .Lta_def
    ret
.Lta_def:
    mov x0, #8
    ret

// -- kcc_type_layout ------------------------------------------------------
// uint64_t kcc_type_layout(type_desc *ty)
//   Ensures ty (and any aggregate it transitively contains) has a
//   byte-accurate TY_SIZE/TY_ALIGN, and stores each struct/union member's
//   byte offset in its field decl's AST_F3.  Returns TY_SIZE.  Idempotent.
.text
.globl _kcc_type_layout
.p2align 2
_kcc_type_layout:
    stp x29, x30, [sp, #-80]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    cbz x0, .Ltl_zero
    mov x19, x0                 // ty
    ldr x1, [x19, #TY_KIND]
    cmp x1, #TY_ARRAY
    b.eq .Ltl_array
    cmp x1, #TY_STRUCT
    b.eq .Ltl_aggregate
    cmp x1, #TY_UNION
    b.eq .Ltl_aggregate
    // Scalar / pointer / enum: already sized by its constructor.
    ldr x0, [x19, #TY_SIZE]
    b .Ltl_ret

.Ltl_array:
    ldr x20, [x19, #TY_F0]      // element type
    ldr x21, [x19, #TY_F1]      // length
    mov x0, x20
    bl _kcc_type_layout         // ensure element laid out → element size
    mul x0, x0, x21
    str x0, [x19, #TY_SIZE]     // size = element_size * length
    mov x0, x20
    bl _kcc_type_align
    str x0, [x19, #TY_ALIGN]    // align = element align
    ldr x0, [x19, #TY_SIZE]
    b .Ltl_ret

.Ltl_aggregate:
    ldr x0, [x19, #TY_SIZE]
    cbnz x0, .Ltl_ret           // memoised: already laid out
    ldr x1, [x19, #TY_KIND]
    cmp x1, #TY_UNION
    cset x20, eq                // x20 = is_union
    ldr x21, [x19, #TY_F0]      // AST_STRUCT_DECL
    cbz x21, .Ltl_zero
    ldr x21, [x21, #AST_F1]     // first field
    cbz x21, .Ltl_zero          // opaque (no body): cannot size
    mov x22, #0                 // running offset (struct)
    mov x23, #1                 // max alignment
    mov x24, #0                 // max member size (union)

.Ltl_loop:
    cbz x21, .Ltl_finish
    ldr x0, [x21, #AST_F0]      // field type specifier
    cbz x0, .Ltl_field_default
    bl _kcc_sema_resolve_type
    cbz x0, .Ltl_field_default
    str x0, [sp, #64]           // stash ftype across the calls
    bl _kcc_type_layout         // ensure laid out → field size in x0
    str x0, [sp, #72]           // stash fsize
    ldr x0, [sp, #64]           // ftype
    bl _kcc_type_align          // falign in x0
    mov x3, x0                  // falign
    ldr x2, [sp, #72]           // fsize
    b .Ltl_field_have
.Ltl_field_default:
    mov x2, #8                  // unresolved: assume one 8-byte slot
    mov x3, #8
.Ltl_field_have:
    cbnz x20, .Ltl_union_field
    // struct: round running offset up to the field's alignment
    sub x4, x3, #1
    add x22, x22, x4
    bic x22, x22, x4            // aligned offset (falign is a power of two)
    str x22, [x21, #AST_F3]     // record field byte offset
    add x22, x22, x2            // advance by field size
    b .Ltl_field_align
.Ltl_union_field:
    str xzr, [x21, #AST_F3]     // union member: offset 0
    cmp x2, x24
    csel x24, x2, x24, gt       // track largest member
.Ltl_field_align:
    cmp x3, x23
    csel x23, x3, x23, gt       // track maximum alignment
    ldr x21, [x21, #AST_F4]     // next field
    b .Ltl_loop

.Ltl_finish:
    cbz x20, .Ltl_total
    mov x22, x24                // union total = largest member
.Ltl_total:
    // pad total size up to the aggregate alignment
    sub x4, x23, #1
    add x22, x22, x4
    bic x22, x22, x4
    str x22, [x19, #TY_SIZE]
    str x23, [x19, #TY_ALIGN]
    mov x0, x22
    b .Ltl_ret

.Ltl_zero:
    mov x0, #0
.Ltl_ret:
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #80
    ret
@| _kcc_type_align _kcc_type_layout
@}

@d Sema: check declaration @{
.Lscd_typedef:
    // Resolve type and register as typedef
    ldr x0, [x19, #AST_F0]         // type node
    bl _kcc_sema_resolve_type
    mov x21, x0

    ldr x0, [x19, #AST_F1]         // name_ptr
    cbz x0, .Lscd_done
    mov x22, x0
    bl _kcc_strlen
    mov x1, x0
    mov x0, x22
    mov x2, #SYM_TYPEDEF
    mov x3, x21
    bl _kcc_symtab_declare
    b .Lscd_done

.Lscd_type_struct:
    // AST_TYPE_STRUCT/UNION wrapper: unwrap to inner struct_decl
    ldr x19, [x19, #AST_F0]        // inner AST_STRUCT_DECL
    cbz x19, .Lscd_done
    ldr x20, [x19, #AST_TAG]
    // Fall through to .Lscd_struct

.Lscd_struct:
    // Register struct/union tag if named
    ldr x0, [x19, #AST_F0]         // name_ptr
    cbz x0, .Lscd_done
    mov x22, x0

    // Create type for struct/union
    mov x0, x19
    cmp x20, #AST_STRUCT_DECL
    b.ne .Lscd_make_union
    bl _kcc_type_struct
    b .Lscd_tag_register
.Lscd_make_union:
    bl _kcc_type_union

.Lscd_tag_register:
    mov x21, x0                     // type descriptor

    // Lay out the aggregate: byte-accurate size, alignment, field offsets.
    mov x0, x21
    bl _kcc_type_layout

    mov x0, x22                     // name
    bl _kcc_strlen
    mov x1, x0
    mov x0, x22
    mov x2, x21
    bl _kcc_symtab_declare_tag
    b .Lscd_done

.Lscd_type_enum:
    // Unwrap AST_TYPE_ENUM → get EnumDecl child
    ldr x19, [x19, #AST_F0]
    cbz x19, .Lscd_done

.Lscd_enum:
    // Register enum tag and enumerator constants
    ldr x0, [x19, #AST_F0]         // name_ptr
    cbz x0, .Lscd_enum_consts

    mov x22, x0
    mov x0, x19
    bl _kcc_type_enum
    mov x21, x0
    mov x0, x22
    bl _kcc_strlen
    mov x1, x0
    mov x0, x22
    mov x2, x21
    bl _kcc_symtab_declare_tag

.Lscd_enum_consts:
    // Register each enumerator as SYM_ENUM_CONST with int type
    ldr x22, [x19, #AST_F1]        // first enumerator
    mov x20, #0                     // counter value

.Lscd_enum_loop:
    cbz x22, .Lscd_done

    // Explicit value (= expr) resets the running counter (§6.7.2.2).
    ldr x0, [x22, #AST_F1]         // value expr, or 0
    cbz x0, .Lscd_enum_reg
    ldr x1, [x0, #AST_TAG]
    cmp x1, #AST_INT_LIT
    b.eq .Lscd_enum_lit
    cmp x1, #AST_CHAR_LIT
    b.eq .Lscd_enum_lit
    cmp x1, #AST_UNARY_EXPR
    b.ne .Lscd_enum_reg            // unsupported const form: keep the counter
    ldr x1, [x0, #AST_F0]          // unary op token
    cmp x1, #TOK_MINUS
    b.ne .Lscd_enum_reg
    ldr x1, [x0, #AST_F1]          // operand
    cbz x1, .Lscd_enum_reg
    ldr x2, [x1, #AST_TAG]
    cmp x2, #AST_INT_LIT
    b.ne .Lscd_enum_reg
    ldr x20, [x1, #AST_F0]
    neg x20, x20                   // = -literal
    b .Lscd_enum_reg
.Lscd_enum_lit:
    ldr x20, [x0, #AST_F0]         // = literal

.Lscd_enum_reg:
    ldr x0, [x22, #AST_F0]         // name_ptr
    cbz x0, .Lscd_enum_next
    mov x21, x0
    bl _kcc_strlen
    mov x1, x0
    mov x0, x21
    mov x2, #SYM_ENUM_CONST
    adrp x3, _kcc_type_int_s@@PAGE
    add  x3, x3, _kcc_type_int_s@@PAGEOFF
    ldr  x3, [x3]
    bl _kcc_symtab_declare
    // Store enum value
    str x20, [x0, #SYM_VALUE]

.Lscd_enum_next:
    add x20, x20, #1
    ldr x22, [x22, #AST_F4]        // next enumerator
    b .Lscd_enum_loop

.Lscd_done:
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@}

\section{Statement Checking}

The statement checker walks the AST recursively, dispatching on the
statement tag.  Compound statements push a new scope before walking
their children and pop it afterward, implementing C's block scoping
rules.  Expression statements type-check their expression via
\texttt{\_kcc\_sema\_expr}.  Control-flow statements
(\texttt{if}/\texttt{while}/\texttt{do}/\texttt{for}) check their
conditions and recurse into their bodies.  \texttt{for} pushes its
own scope to contain the loop variable declaration.  Labels register
themselves in the label namespace.  Declarations encountered inside
compound statements are forwarded to the declaration checker.

@d Sema: check statement @{
// -- kcc_sema_check_stmt --------------------------------------------------
// void kcc_sema_check_stmt(node *stmt)
//   x0 = statement AST node
.text
.globl _kcc_sema_check_stmt
.p2align 2
_kcc_sema_check_stmt:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    cbz x0, .Lscs_done
    mov x19, x0

    ldr x20, [x19, #AST_TAG]

    cmp x20, #AST_COMPOUND
    b.eq .Lscs_compound
    cmp x20, #AST_EXPR_STMT
    b.eq .Lscs_expr
    cmp x20, #AST_IF_STMT
    b.eq .Lscs_if
    cmp x20, #AST_WHILE_STMT
    b.eq .Lscs_while
    cmp x20, #AST_DO_STMT
    b.eq .Lscs_do
    cmp x20, #AST_FOR_STMT
    b.eq .Lscs_for
    cmp x20, #AST_RETURN_STMT
    b.eq .Lscs_return
    cmp x20, #AST_SWITCH_STMT
    b.eq .Lscs_switch
    cmp x20, #AST_LABEL_STMT
    b.eq .Lscs_label
    cmp x20, #AST_CASE_STMT
    b.eq .Lscs_case
    cmp x20, #AST_DEFAULT_STMT
    b.eq .Lscs_default
    cmp x20, #AST_GOTO_STMT
    b.eq .Lscs_done         // nothing to check
    cmp x20, #AST_BREAK_STMT
    b.eq .Lscs_done
    cmp x20, #AST_CONTINUE_STMT
    b.eq .Lscs_done
    cmp x20, #AST_NULL_STMT
    b.eq .Lscs_done

    // Could be a declaration within a compound stmt
    cmp x20, #AST_VAR_DECL
    b.eq .Lscs_decl
    cmp x20, #AST_TYPEDEF_DECL
    b.eq .Lscs_decl
    cmp x20, #AST_STRUCT_DECL
    b.eq .Lscs_decl
    cmp x20, #AST_UNION_DECL
    b.eq .Lscs_decl
    cmp x20, #AST_ENUM_DECL
    b.eq .Lscs_decl
    cmp x20, #AST_TYPE_ENUM
    b.eq .Lscs_decl
    cmp x20, #AST_STATIC_ASSERT
    b.eq .Lscs_done

    b .Lscs_done
@| _kcc_sema_check_stmt
@}

\paragraph{Compound Statements and Control Flow}

Compound statements push a new scope onto both the ordinary and tag
stacks, walk their child list recursively, and pop the scope on exit.
Expression statements simply type-check their contained expression.
The \texttt{if}/\texttt{while}/\texttt{do}/\texttt{for} handlers each
check their condition expression and recurse into their bodies;
\texttt{for} additionally pushes its own scope to contain the loop
variable declaration.

@d Sema: check statement @{
.Lscs_compound:
    bl _kcc_symtab_push_scope

    // Walk items
    ldr x19, [x19, #AST_F0]        // first item
.Lscs_compound_loop:
    cbz x19, .Lscs_compound_end
    mov x0, x19
    bl _kcc_sema_check_stmt
    ldr x19, [x19, #AST_F4]        // next
    b .Lscs_compound_loop

.Lscs_compound_end:
    bl _kcc_symtab_pop_scope
    b .Lscs_done

.Lscs_expr:
    ldr x0, [x19, #AST_F0]
    cbz x0, .Lscs_done
    bl _kcc_sema_expr
    b .Lscs_done

.Lscs_if:
    ldr x0, [x19, #AST_F0]         // condition
    bl _kcc_sema_expr
    ldr x0, [x19, #AST_F1]         // then
    bl _kcc_sema_check_stmt
    ldr x0, [x19, #AST_F2]         // else (may be null)
    cbz x0, .Lscs_done
    bl _kcc_sema_check_stmt
    b .Lscs_done

.Lscs_while:
    ldr x0, [x19, #AST_F0]         // condition
    bl _kcc_sema_expr
    ldr x0, [x19, #AST_F1]         // body
    bl _kcc_sema_check_stmt
    b .Lscs_done

.Lscs_do:
    ldr x0, [x19, #AST_F0]         // body
    bl _kcc_sema_check_stmt
    ldr x0, [x19, #AST_F1]         // condition
    bl _kcc_sema_expr
    b .Lscs_done

.Lscs_for:
    bl _kcc_symtab_push_scope
    ldr x0, [x19, #AST_F0]         // init
    cbz x0, .Lscs_for_cond
    bl _kcc_sema_check_stmt
.Lscs_for_cond:
    ldr x0, [x19, #AST_F1]         // condition
    cbz x0, .Lscs_for_incr
    bl _kcc_sema_expr
.Lscs_for_incr:
    ldr x0, [x19, #AST_F2]         // increment
    cbz x0, .Lscs_for_body
    bl _kcc_sema_expr
.Lscs_for_body:
    ldr x0, [x19, #AST_F3]         // body
    cbz x0, .Lscs_for_end
    bl _kcc_sema_check_stmt
.Lscs_for_end:
    bl _kcc_symtab_pop_scope
    b .Lscs_done
@}

\paragraph{Return, Switch, Labels, and Declarations}

\texttt{return} type-checks its expression (if present) against the
function's declared return type.  \texttt{switch} checks the controlling
expression and recurses into the body.  Label, case, and default
statements register or validate their labels and recurse into their
associated statement.  Any declaration node encountered inside a compound
statement is forwarded to \texttt{kcc\_sema\_check\_decl}.

@d Sema: check statement @{
.Lscs_return:
    ldr x0, [x19, #AST_F0]         // return expression
    cbz x0, .Lscs_done
    bl _kcc_sema_expr
    // TODO: check against function return type
    b .Lscs_done

.Lscs_switch:
    ldr x0, [x19, #AST_F0]         // controlling expression
    bl _kcc_sema_expr
    // TODO: verify integer type
    ldr x0, [x19, #AST_F1]         // body
    bl _kcc_sema_check_stmt
    b .Lscs_done

.Lscs_label:
    // Register label
    ldr x0, [x19, #AST_F0]         // label name_ptr
    cbz x0, .Lscs_label_stmt
    mov x20, x0
    bl _kcc_strlen
    mov x1, x0
    mov x0, x20
    bl _kcc_symtab_label_add
.Lscs_label_stmt:
    ldr x0, [x19, #AST_F1]         // labeled statement
    cbz x0, .Lscs_done
    bl _kcc_sema_check_stmt
    b .Lscs_done

.Lscs_case:
    ldr x0, [x19, #AST_F0]         // case expression
    bl _kcc_sema_expr
    ldr x0, [x19, #AST_F1]         // statement
    cbz x0, .Lscs_done
    bl _kcc_sema_check_stmt
    b .Lscs_done

.Lscs_default:
    ldr x0, [x19, #AST_F0]         // statement
    cbz x0, .Lscs_done
    bl _kcc_sema_check_stmt
    b .Lscs_done

.Lscs_decl:
    mov x0, x19
    bl _kcc_sema_check_decl
    b .Lscs_done

.Lscs_done:
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@}

\section{Expression Type-Checking}

The expression type-checker is the core of semantic analysis.  It
dispatches on the AST tag, delegates to specialised handlers for each
expression kind, and stores the resolved type in the node's
\texttt{AST\_F3} field.  Simple expressions are handled inline:
parenthesised expressions unwrap to their child, comma expressions
return the type of the right operand, conditional expressions return
the type of the \emph{then} branch, and subscript expressions
dereference one level of pointer or array type.  More complex
expressions (identifiers, binary, unary, assignment, calls, member
access, casts, sizeof) are delegated to dedicated subroutines
described in the following subsections.

@d Sema: check expression @{
// -- kcc_sema_expr --------------------------------------------------------
// type_desc *kcc_sema_expr(node *expr)
//   x0 = expression AST node
// Type-checks the expression, stores result in AST_F3.
// Returns the resolved type.
.text
.globl _kcc_sema_expr
.p2align 2
_kcc_sema_expr:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    cbz x0, .Lse_null
    mov x19, x0

    ldr x20, [x19, #AST_TAG]

    cmp x20, #AST_IDENT_EXPR
    b.eq .Lse_ident
    cmp x20, #AST_INT_LIT
    b.eq .Lse_int_lit
    cmp x20, #AST_FLOAT_LIT
    b.eq .Lse_int_lit             // typed by _kcc_sema_expr_literal (→ double)
    cmp x20, #AST_STR_LIT
    b.eq .Lse_str_lit
    cmp x20, #AST_CHAR_LIT
    b.eq .Lse_char_lit
    cmp x20, #AST_BINARY_EXPR
    b.eq .Lse_binary
    cmp x20, #AST_UNARY_EXPR
    b.eq .Lse_unary
    cmp x20, #AST_ASSIGN_EXPR
    b.eq .Lse_assign
    cmp x20, #AST_COND_EXPR
    b.eq .Lse_cond
    cmp x20, #AST_CALL_EXPR
    b.eq .Lse_call
    cmp x20, #AST_SUBSCRIPT
    b.eq .Lse_subscript
    cmp x20, #AST_MEMBER
    b.eq .Lse_member
    cmp x20, #AST_CAST_EXPR
    b.eq .Lse_cast
    cmp x20, #AST_SIZEOF_EXPR
    b.eq .Lse_sizeof
    cmp x20, #AST_COMMA_EXPR
    b.eq .Lse_comma
    cmp x20, #AST_PAREN_EXPR
    b.eq .Lse_paren
    cmp x20, #AST_VA_ARG
    b.eq .Lse_va_arg

    // Default: int
    b .Lse_default_int

.Lse_va_arg:
    // Type the va_list operand; the va_arg node's type is the requested type.
    ldr x0, [x19, #AST_F0]        // va_list expression
    cbz x0, .Lse_va_arg_type
    bl _kcc_sema_expr
.Lse_va_arg_type:
    ldr x0, [x19, #AST_F1]        // target type node
    cbz x0, .Lse_default_int
    bl _kcc_sema_resolve_type
    b .Lse_store

.Lse_ident:
    bl _kcc_sema_expr_ident
    b .Lse_store
.Lse_int_lit:
    bl _kcc_sema_expr_literal
    b .Lse_store
.Lse_str_lit:
    bl _kcc_sema_expr_literal
    b .Lse_store
.Lse_char_lit:
    bl _kcc_sema_expr_literal
    b .Lse_store
.Lse_binary:
    bl _kcc_sema_expr_binary
    b .Lse_store
.Lse_unary:
    bl _kcc_sema_expr_unary
    b .Lse_store
.Lse_assign:
    bl _kcc_sema_expr_assign
    b .Lse_store
.Lse_cond:
    // Check all three parts, result type = type of then-expr
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_expr
    ldr x0, [x19, #AST_F1]
    bl _kcc_sema_expr
    mov x20, x0                     // save then type
    ldr x0, [x19, #AST_F2]
    bl _kcc_sema_expr
    mov x0, x20
    b .Lse_store
.Lse_call:
    bl _kcc_sema_expr_call
    b .Lse_store
.Lse_subscript:
    // array[index]: check both, result = element type
    ldr x0, [x19, #AST_F0]         // array
    bl _kcc_sema_expr
    mov x20, x0
    ldr x0, [x19, #AST_F1]         // index
    bl _kcc_sema_expr
    // Dereference array/pointer type
    ldr x1, [x20, #TY_KIND]
    cmp x1, #TY_PTR
    b.eq .Lse_sub_ptr
    cmp x1, #TY_ARRAY
    b.eq .Lse_sub_arr
    // Not a pointer or array, default to int
    b .Lse_default_int
.Lse_sub_ptr:
.Lse_sub_arr:
    ldr x0, [x20, #TY_F0]          // pointee/element type
    b .Lse_store
.Lse_member:
    bl _kcc_sema_expr_member
    b .Lse_store
.Lse_cast:
    bl _kcc_sema_expr_cast
    b .Lse_store
.Lse_sizeof:
    bl _kcc_sema_expr_sizeof
    b .Lse_store
.Lse_comma:
    // Evaluate LHS, result is type of RHS
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_expr
    ldr x0, [x19, #AST_F1]
    bl _kcc_sema_expr
    b .Lse_store
.Lse_paren:
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_expr
    b .Lse_store

.Lse_default_int:
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr  x0, [x0]

.Lse_store:
    // Store resolved type in AST_F3 of the expression node
    str x0, [x19, #AST_F3]

    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

.Lse_null:
    adrp x0, _kcc_type_void@@PAGE
    add  x0, x0, _kcc_type_void@@PAGEOFF
    ldr  x0, [x0]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_sema_expr
@}

\subsection{Identifier Expression}

An identifier expression looks up the name in the symbol table.  If
found, the symbol's type is returned after applying function and
array decay (per \stdref{6.3.2.1}): a function designator decays to
a pointer-to-function, and an array decays to a pointer to its first
element.  Undeclared identifiers fall back to \texttt{int}; a
diagnostic is deferred to avoid crashing on implicit function
declarations common in legacy C code.

Enumeration constants receive special treatment.  When the lookup
returns a symbol whose kind is \texttt{SYM\_ENUM\_CONST}, the AST
node is rewritten in place: its tag becomes \texttt{AST\_INT\_LIT}
and \texttt{F0} receives the constant's integer value from
\texttt{SYM\_VALUE}.  The IR builder then sees a plain integer
literal and emits \texttt{IR\_CONST}---no global reference, no
symbol lookup at link time.  This rewrite is safe because the node
will never be examined as an identifier again.

@d Sema: expr ident @{
// -- kcc_sema_expr_ident --------------------------------------------------
// type_desc *kcc_sema_expr_ident(node *expr)
//   x19 = expression node (already loaded by caller)
// Looks up identifier in symbol table, returns its type.
.text
.p2align 2
_kcc_sema_expr_ident:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    // x19 = expr node (from caller)
    // Get name pointer
    ldr x20, [x19, #AST_F0]        // x20 = name_ptr
    cbz x20, .Lsei_unknown

    mov x0, x20
    bl _kcc_strlen
    mov x1, x0                     // len
    mov x0, x20                    // name

    bl _kcc_symtab_lookup
    cbz x0, .Lsei_undeclared

    // Check if this is an enum constant
    ldr x1, [x0, #SYM_KIND]
    cmp x1, #SYM_ENUM_CONST
    b.ne .Lsei_normal

    // Rewrite AST node: AST_IDENT_EXPR → AST_INT_LIT with enum value
    ldr x1, [x0, #SYM_VALUE]
    mov x0, #AST_INT_LIT
    str x0, [x19]                   // overwrite tag
    str x1, [x19, #AST_F0]         // store constant value
    b .Lsei_int_type

.Lsei_normal:
    // Return symbol's type
    ldr x0, [x0, #SYM_TYPE]
    // Apply function/array decay
    bl _kcc_conv_func_decay
    bl _kcc_conv_array_decay

    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

.Lsei_undeclared:
    // Undeclared identifier — return int as fallback
    // (diagnostic omitted for now to avoid crash on implicit declarations)

.Lsei_unknown:
.Lsei_int_type:
    // Return int as fallback / enum constant type
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr  x0, [x0]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@}

\subsection{Literal Expressions}

Integer and character literals have type \texttt{int}.  String
literals have type \texttt{char~*} (pointer to signed char), matching
the C17 rule that a string literal is an array that decays to a
pointer.

@d Sema: expr literal @{
// -- kcc_sema_expr_literal ------------------------------------------------
// type_desc *kcc_sema_expr_literal(node *expr)
//   x19 = expression node, x20 = tag (set by caller)
.text
.p2align 2
_kcc_sema_expr_literal:
    stp x29, x30, [sp, #-16]!
    mov x29, sp

    cmp x20, #AST_INT_LIT
    b.eq .Lsel_int
    cmp x20, #AST_CHAR_LIT
    b.eq .Lsel_int
    cmp x20, #AST_FLOAT_LIT
    b.eq .Lsel_double
    cmp x20, #AST_STR_LIT
    b.eq .Lsel_str

    // Default: int
.Lsel_int:
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr  x0, [x0]
    ldp x29, x30, [sp], #16
    ret

.Lsel_double:
    // A floating constant is double, or float when it carried an f/F suffix
    // (recorded in AST_F2 by the parser; the value was rounded to single there).
    ldr x0, [x19, #AST_F2]
    cbz x0, .Lsel_double_d
    adrp x0, _kcc_type_float@@PAGE
    add  x0, x0, _kcc_type_float@@PAGEOFF
    ldr  x0, [x0]
    ldp x29, x30, [sp], #16
    ret
.Lsel_double_d:
    adrp x0, _kcc_type_double@@PAGE
    add  x0, x0, _kcc_type_double@@PAGEOFF
    ldr  x0, [x0]
    ldp x29, x30, [sp], #16
    ret

.Lsel_str:
    // String literal: type is "char *" (pointer to char)
    adrp x0, _kcc_type_char_s@@PAGE
    add  x0, x0, _kcc_type_char_s@@PAGEOFF
    ldr  x0, [x0]
    bl _kcc_type_ptr
    ldp x29, x30, [sp], #16
    ret
@}

\subsection{Binary Expression}

Binary expression type-checking first resolves the types of both
operands.  Comparison and logical operators always produce
\texttt{int} (per \stdref{6.5.8--9} and \stdref{6.5.13--14}).  If
the left operand is a pointer and the operator is additive, the
result is a pointer type (pointer arithmetic).  Otherwise, the usual
arithmetic conversions (\texttt{\_kcc\_conv\_usual}) determine the
common type.

@d Sema: expr binary @{
// -- kcc_sema_expr_binary -------------------------------------------------
// type_desc *kcc_sema_expr_binary(node *expr)
//   x19 = expression node
.text
.p2align 2
_kcc_sema_expr_binary:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]

    // Type-check LHS
    ldr x0, [x19, #AST_F1]
    bl _kcc_sema_expr
    mov x21, x0                     // LHS type

    // Type-check RHS
    ldr x0, [x19, #AST_F2]
    bl _kcc_sema_expr
    mov x22, x0                     // RHS type

    // Get operator
    ldr x20, [x19, #AST_F0]

    // Comparison operators return int
    cmp x20, #TOK_EQ
    b.eq .Lseb_int
    cmp x20, #TOK_NE
    b.eq .Lseb_int
    cmp x20, #TOK_LT
    b.eq .Lseb_int
    cmp x20, #TOK_GT
    b.eq .Lseb_int
    cmp x20, #TOK_LE
    b.eq .Lseb_int
    cmp x20, #TOK_GE
    b.eq .Lseb_int

    // Logical operators return int
    cmp x20, #TOK_AND
    b.eq .Lseb_int
    cmp x20, #TOK_OR
    b.eq .Lseb_int

    // Pointer arithmetic: ptr + int or ptr - int
    ldr x0, [x21, #TY_KIND]
    cmp x0, #TY_PTR
    b.eq .Lseb_ptr_arith

    // Arithmetic operators: usual arithmetic conversions
    mov x0, x21
    mov x1, x22
    bl _kcc_conv_usual
    b .Lseb_done

.Lseb_ptr_arith:
    // Result is pointer type
    mov x0, x21
    b .Lseb_done

.Lseb_int:
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr  x0, [x0]

.Lseb_done:
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@}

\subsection{Unary Expression}

Unary expression types depend on the operator.  Address-of
(\texttt{\&}) wraps the operand type in a pointer.  Dereference
(\texttt{*}) unwraps one pointer level; if the operand is not a
pointer, the checker falls back to \texttt{int}.  Logical not
(\texttt{!}) always produces \texttt{int}.  All remaining operators
(bitwise not, increment, decrement, unary minus and plus) preserve
the operand type.

@d Sema: expr unary @{
// -- kcc_sema_expr_unary --------------------------------------------------
// type_desc *kcc_sema_expr_unary(node *expr)
//   x19 = expression node
.text
.p2align 2
_kcc_sema_expr_unary:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    // Type-check operand
    ldr x0, [x19, #AST_F1]
    bl _kcc_sema_expr
    mov x20, x0                     // operand type

    // Get operator
    ldr x0, [x19, #AST_F0]

    cmp x0, #TOK_AMP               // address-of
    b.eq .Lseu_addr
    cmp x0, #TOK_STAR              // dereference
    b.eq .Lseu_deref
    cmp x0, #TOK_BANG              // logical not → int
    b.eq .Lseu_int
    cmp x0, #TOK_TILDE            // bitwise not → operand type
    b.eq .Lseu_operand
    cmp x0, #TOK_INC              // increment
    b.eq .Lseu_operand
    cmp x0, #TOK_DEC              // decrement
    b.eq .Lseu_operand
    cmp x0, #TOK_MINUS            // unary minus
    b.eq .Lseu_operand
    cmp x0, #TOK_PLUS             // unary plus
    b.eq .Lseu_operand

    // Default: operand type
    b .Lseu_operand

.Lseu_addr:
    // &expr → pointer to operand type
    mov x0, x20
    bl _kcc_type_ptr
    b .Lseu_done

.Lseu_deref:
    // *expr → dereference pointer
    ldr x1, [x20, #TY_KIND]
    cmp x1, #TY_PTR
    b.ne .Lseu_int              // error: not a pointer
    ldr x0, [x20, #TY_F0]      // pointee type
    b .Lseu_done

.Lseu_int:
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr  x0, [x0]
    b .Lseu_done

.Lseu_operand:
    mov x0, x20

.Lseu_done:
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@}

\subsection{Assignment Expression}

Per \stdref{6.5.16}, the type of an assignment expression is the type
of the left operand.  Both sides are type-checked, but the result
type is always the LHS type.  Compound assignments (\texttt{+=},
\texttt{-=}, etc.) are treated identically for type purposes.

@d Sema: expr assign @{
// -- kcc_sema_expr_assign -------------------------------------------------
// type_desc *kcc_sema_expr_assign(node *expr)
//   x19 = expression node
// Type of assignment = type of LHS.
.text
.p2align 2
_kcc_sema_expr_assign:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    // Type-check LHS
    ldr x0, [x19, #AST_F1]
    bl _kcc_sema_expr
    mov x20, x0                     // LHS type (= result type)

    // Type-check RHS
    ldr x0, [x19, #AST_F2]
    bl _kcc_sema_expr

    // Result type is LHS type
    mov x0, x20

    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@}

\subsection{Function Call}

A function call first type-checks the callee expression, then
walks the argument list and type-checks each argument.  The result
type is the callee's return type, extracted from the
\texttt{TY\_FUNC} descriptor's \texttt{TY\_F0} field.  If the callee
is a pointer-to-function, the pointer is dereferenced first.
Implicit function declarations (callee not found) fall back to
\texttt{int} return.

@d Sema: expr call @{
// -- kcc_sema_expr_call ---------------------------------------------------
// type_desc *kcc_sema_expr_call(node *expr)
//   x19 = expression node
.text
.p2align 2
_kcc_sema_expr_call:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    // Type-check callee
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_expr
    mov x20, x0                     // callee type

    // Type-check arguments
    ldr x21, [x19, #AST_F1]        // first arg
.Lsec_arg_loop:
    cbz x21, .Lsec_arg_done
    mov x0, x21
    bl _kcc_sema_expr
    ldr x21, [x21, #AST_F4]        // next arg
    b .Lsec_arg_loop

.Lsec_arg_done:
    // Get return type from callee type
    ldr x1, [x20, #TY_KIND]
    cmp x1, #TY_FUNC
    b.eq .Lsec_func_ret
    cmp x1, #TY_PTR
    b.eq .Lsec_ptr_func

    // Not a function type: assume int return
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr  x0, [x0]
    b .Lsec_done

.Lsec_func_ret:
    ldr x0, [x20, #TY_F0]          // return type
    b .Lsec_done

.Lsec_ptr_func:
    // Pointer to function: dereference then get return type
    ldr x0, [x20, #TY_F0]          // pointee (should be TY_FUNC)
    ldr x1, [x0, #TY_KIND]
    cmp x1, #TY_FUNC
    b.ne .Lsec_default_int
    ldr x0, [x0, #TY_F0]           // return type
    b .Lsec_done

.Lsec_default_int:
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr  x0, [x0]

.Lsec_done:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@}

\subsection{Member Access}

Member access handles both dot (\texttt{s.m}) and arrow
(\texttt{p->m}) forms.  For arrow access the object type must be a
pointer, which is dereferenced first.  The resulting type must be
\texttt{TY\_STRUCT} or \texttt{TY\_UNION}; if not, the checker falls
back to \texttt{int}.  The lookup walks the struct declaration's
field chain (\texttt{AST\_F1} linked via \texttt{AST\_F4}), counting
fields until it finds a name matching the member name in
\texttt{AST\_MEMBER.F1}.  On a match the field's declared type is
returned and stored in \texttt{AST\_F3} by the caller (the standard
\texttt{.Lse\_store} path); the IR builder later re-walks the field
list to compute the field index at code-generation time.

@d Sema: expr member @{
// -- kcc_sema_expr_member -------------------------------------------------
// type_desc *kcc_sema_expr_member(node *expr)
//   x19 = expression node (AST_MEMBER)
// F0=object, F1=name_ptr, F2=arrow(1)/dot(0)
// Returns: resolved field type (or int as fallback)
.text
.p2align 2
_kcc_sema_expr_member:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]

    // Type-check the object expression
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_expr
    mov x20, x0                     // object type

    // If arrow: dereference pointer first
    ldr x1, [x19, #AST_F2]
    cbz x1, .Lsem_dot
    // Arrow: type should be pointer to struct/union
    ldr x1, [x20, #TY_KIND]
    cmp x1, #TY_PTR
    b.ne .Lsem_fallback
    ldr x20, [x20, #TY_F0]         // dereference

.Lsem_dot:
    // Type should be struct or union
    ldr x1, [x20, #TY_KIND]
    cmp x1, #TY_STRUCT
    b.eq .Lsem_lookup
    cmp x1, #TY_UNION
    b.eq .Lsem_lookup

.Lsem_fallback:
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr  x0, [x0]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

.Lsem_lookup:
    // Walk the struct's field list to find the member
    ldr x21, [x20, #TY_F0]         // AST_STRUCT_DECL node
    ldr x21, [x21, #AST_F1]        // first field (AST_FIELD_DECL chain)
    ldr x22, [x19, #AST_F1]        // member name to find

.Lsem_field_loop:
    cbz x21, .Lsem_not_found
    ldr x0, [x21, #AST_F1]         // field name_ptr
    cbz x0, .Lsem_field_next       // skip anonymous fields

    mov x1, x22
    bl _kcc_strcmp
    cbz x0, .Lsem_found

.Lsem_field_next:
    ldr x21, [x21, #AST_F4]        // next field
    b .Lsem_field_loop

.Lsem_not_found:
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr  x0, [x0]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

.Lsem_found:
    // x21 = matching AST_FIELD_DECL
    ldr x0, [x21, #AST_F0]         // field type node
    cbz x0, .Lsem_found_int
    bl _kcc_sema_resolve_type
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

.Lsem_found_int:
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr  x0, [x0]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@}

\subsection{Cast Expression}

A cast expression resolves its target type from the AST type node,
type-checks the inner expression, and returns the target type as the
result.  No conversion code is emitted at this stage; the IR builder
handles actual truncation and extension.

@d Sema: expr cast @{
// -- kcc_sema_expr_cast ---------------------------------------------------
// type_desc *kcc_sema_expr_cast(node *expr)
//   x19 = expression node
// F0=type, F1=expr
.text
.p2align 2
_kcc_sema_expr_cast:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    // Resolve cast target type
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_resolve_type
    mov x20, x0                     // target type

    // Type-check the expression being cast
    ldr x0, [x19, #AST_F1]
    bl _kcc_sema_expr

    // Result is the target type
    mov x0, x20

    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@}

\subsection{Sizeof Expression}

The \texttt{sizeof} operator can take either a type or an expression
as its operand (distinguished by the \texttt{AST\_F1} flag).  If the
operand is an expression, it is type-checked (though its value is not
evaluated at run time).  In both cases the result type is
\texttt{unsigned long}, which is \texttt{size\_t} on ARM64.

@d Sema: expr sizeof @{
// -- kcc_sema_expr_sizeof -------------------------------------------------
// type_desc *kcc_sema_expr_sizeof(node *expr)
//   x19 = expression node
// F0=operand (type node or expr), F1=is_type
// Result type is always unsigned long (size_t on ARM64).
.text
.p2align 2
_kcc_sema_expr_sizeof:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    // Check if operand is a type or expression
    ldr x1, [x19, #AST_F1]         // is_type flag
    cbnz x1, .Lses_type

    // Expression operand: type-check it
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_expr

    // sizeof does not decay arrays (§6.3.2.1): if the operand names an
    // array, restore its array type so the size is the whole array, not a
    // pointer.  sema_expr already decayed it to a pointer in AST_F3.  The
    // operand is the node whose AST_F3 the IR builder reads; the name may
    // sit under one or more parentheses, so descend to the inner expression.
    ldr x20, [x19, #AST_F0]        // operand node (IR builder reads its AST_F3)
    mov x1, x20
.Lses_unwrap:
    ldr x0, [x1, #AST_TAG]
    cmp x0, #AST_PAREN_EXPR
    b.ne .Lses_inner
    ldr x1, [x1, #AST_F0]
    cbnz x1, .Lses_unwrap
    b .Lses_result
.Lses_inner:
    cmp x0, #AST_IDENT_EXPR
    b.ne .Lses_result
    ldr x21, [x1, #AST_F0]         // name ptr
    cbz x21, .Lses_result
    mov x0, x21
    bl _kcc_strlen
    mov x1, x0
    mov x0, x21
    bl _kcc_symtab_lookup
    cbz x0, .Lses_result
    ldr x0, [x0, #SYM_TYPE]
    cbz x0, .Lses_result
    ldr x1, [x0, #TY_KIND]
    cmp x1, #TY_ARRAY
    b.ne .Lses_result
    str x0, [x20, #AST_F3]         // set the un-decayed array type on the operand
    b .Lses_result

.Lses_type:
    // Type operand: resolve it (for validation)
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_resolve_type

.Lses_result:
    // sizeof always returns unsigned long (size_t)
    adrp x0, _kcc_type_long_u@@PAGE
    add  x0, x0, _kcc_type_long_u@@PAGEOFF
    ldr  x0, [x0]
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@}

\section{Dump Types}

The type dumper implements the \texttt{--dump-types} flag.  It walks
the top-level declaration list and prints each variable, function, or
typedef declaration together with its resolved type descriptor.  The
output format is:
\begin{verbatim}
var x: int
func main: int
typedef size_t = unsigned long
\end{verbatim}

@d Sema: dump types @{
// -- kcc_sema_dump_types --------------------------------------------------
// void kcc_sema_dump_types(node *trans_unit)
//   x0 = AST_TRANS_UNIT after semantic analysis
// Prints each declaration with resolved types.
.text
.globl _kcc_sema_dump_types
.p2align 2
_kcc_sema_dump_types:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    ldr x19, [x0, #AST_F0]         // first decl

.Lsdt_loop:
    cbz x19, .Lsdt_done

    // Print declaration info
    ldr x0, [x19, #AST_TAG]
    cmp x0, #AST_VAR_DECL
    b.eq .Lsdt_var
    cmp x0, #AST_FUNC_DECL
    b.eq .Lsdt_func
    cmp x0, #AST_TYPEDEF_DECL
    b.eq .Lsdt_typedef
    b .Lsdt_next

.Lsdt_var:
    adrp x0, _kcc_sema_str_var@@PAGE
    add  x0, x0, _kcc_sema_str_var@@PAGEOFF
    bl _kcc_io_puts

    // Print name
    ldr x0, [x19, #AST_F1]
    cbz x0, .Lsdt_var_type
    bl _kcc_io_puts

.Lsdt_var_type:
    adrp x0, _kcc_sema_str_colon@@PAGE
    add  x0, x0, _kcc_sema_str_colon@@PAGEOFF
    bl _kcc_io_puts

    // Resolve and print type
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_resolve_type
    bl _kcc_type_dump

    adrp x0, _kcc_sema_str_nl@@PAGE
    add  x0, x0, _kcc_sema_str_nl@@PAGEOFF
    bl _kcc_io_puts
    b .Lsdt_next

.Lsdt_func:
    adrp x0, _kcc_sema_str_func@@PAGE
    add  x0, x0, _kcc_sema_str_func@@PAGEOFF
    bl _kcc_io_puts

    ldr x0, [x19, #AST_F1]
    cbz x0, .Lsdt_func_type
    bl _kcc_io_puts

.Lsdt_func_type:
    adrp x0, _kcc_sema_str_colon@@PAGE
    add  x0, x0, _kcc_sema_str_colon@@PAGEOFF
    bl _kcc_io_puts

    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_resolve_type
    bl _kcc_type_dump

    adrp x0, _kcc_sema_str_nl@@PAGE
    add  x0, x0, _kcc_sema_str_nl@@PAGEOFF
    bl _kcc_io_puts
    b .Lsdt_next

.Lsdt_typedef:
    adrp x0, _kcc_sema_str_typedef@@PAGE
    add  x0, x0, _kcc_sema_str_typedef@@PAGEOFF
    bl _kcc_io_puts

    ldr x0, [x19, #AST_F1]
    cbz x0, .Lsdt_td_type
    bl _kcc_io_puts

.Lsdt_td_type:
    adrp x0, _kcc_sema_str_eq@@PAGE
    add  x0, x0, _kcc_sema_str_eq@@PAGEOFF
    bl _kcc_io_puts

    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_resolve_type
    bl _kcc_type_dump

    adrp x0, _kcc_sema_str_nl@@PAGE
    add  x0, x0, _kcc_sema_str_nl@@PAGEOFF
    bl _kcc_io_puts

.Lsdt_next:
    ldr x19, [x19, #AST_F4]
    b .Lsdt_loop

.Lsdt_done:
    bl _kcc_io_flush
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_sema_dump_types
@}

\section{Semantic Analysis Data}

Module-level state for semantic analysis: a pointer to the current
function's return type (used to validate \texttt{return} statements),
error message strings for diagnostics, and formatting strings used by
the type dumper.

@d Sema: data @{
// -- Sema globals ---------------------------------------------------------
.data
.globl _kcc_sema_cur_ret
_kcc_sema_cur_ret:    .quad 0       // current function return type

// -- Sema error messages --------------------------------------------------
.section __TEXT,__cstring,cstring_literals
_kcc_sema_err_undecl:
    .asciz "use of undeclared identifier"
_kcc_sema_err_not_func:
    .asciz "called object is not a function"
_kcc_sema_err_not_struct:
    .asciz "member access on non-struct/union type"
_kcc_sema_err_void_val:
    .asciz "void value not ignored as it ought to be"

// -- Dump type strings ----------------------------------------------------
_kcc_sema_str_var:      .asciz "var "
_kcc_sema_str_func:     .asciz "func "
_kcc_sema_str_typedef:  .asciz "typedef "
_kcc_sema_str_colon:    .asciz ": "
_kcc_sema_str_eq:       .asciz " = "
_kcc_sema_str_nl:       .asciz "\n"
_kcc_sema_str_va_list:  .asciz "va_list"
@| _kcc_sema_cur_ret
@| _kcc_sema_str_var
@| _kcc_sema_str_func
@| _kcc_sema_str_typedef
@| _kcc_sema_str_colon
@| _kcc_sema_str_eq
@| _kcc_sema_str_nl
@| _kcc_sema_str_va_list
@}
