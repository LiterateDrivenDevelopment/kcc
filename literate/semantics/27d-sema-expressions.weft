% 27d-sema-expressions.weft — expression type-checking and diagnostics
%
% Split from 27-sema.weft (structural refactor, no content changes):
% per-expression type checks, the named-message diagnostic helpers, and the
% -Wall semantic checks (sign-compare, int/pointer conversion, ...).

\section{Expression Type-Checking}

The expression type-checker is the core of semantic analysis.  It
dispatches on the AST tag, delegates to specialised handlers for each
expression kind, and stores the resolved type in the node's
\texttt{AST\_F3} field.  Simple expressions are handled inline:
parenthesised expressions unwrap to their child, comma expressions
return the type of the right operand, conditional expressions return
the type of the \emph{then} branch, and subscript expressions
dereference one level of pointer or array type.  More complex
expressions (identifiers, binary, unary, assignment, calls, member
access, casts, sizeof) are delegated to dedicated subroutines
described in the following subsections.

@d Sema: check expression @{
// -- kcc_sema_expr --------------------------------------------------------
// type_desc *kcc_sema_expr(node *expr)
//   x0 = expression AST node
// Type-checks the expression, stores result in AST_F3.
// Returns the resolved type.
.text
.globl _kcc_sema_expr
.p2align 2
_kcc_sema_expr:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    cbz x0, .Lse_null
    mov x19, x0

    ldr x20, [x19, #AST_TAG]

    cmp x20, #AST_IDENT_EXPR
    b.eq .Lse_ident
    cmp x20, #AST_INT_LIT
    b.eq .Lse_int_lit
    cmp x20, #AST_FLOAT_LIT
    b.eq .Lse_int_lit             // typed by _kcc_sema_expr_literal (→ double)
    cmp x20, #AST_STR_LIT
    b.eq .Lse_str_lit
    cmp x20, #AST_CHAR_LIT
    b.eq .Lse_char_lit
    cmp x20, #AST_BINARY_EXPR
    b.eq .Lse_binary
    cmp x20, #AST_UNARY_EXPR
    b.eq .Lse_unary
    cmp x20, #AST_ASSIGN_EXPR
    b.eq .Lse_assign
    cmp x20, #AST_COND_EXPR
    b.eq .Lse_cond
    cmp x20, #AST_CALL_EXPR
    b.eq .Lse_call
    cmp x20, #AST_SUBSCRIPT
    b.eq .Lse_subscript
    cmp x20, #AST_MEMBER
    b.eq .Lse_member
    cmp x20, #AST_CAST_EXPR
    b.eq .Lse_cast
    cmp x20, #AST_SIZEOF_EXPR
    b.eq .Lse_sizeof
    cmp x20, #AST_ALIGNOF_EXPR
    b.eq .Lse_alignof
    cmp x20, #AST_COMMA_EXPR
    b.eq .Lse_comma
    cmp x20, #AST_PAREN_EXPR
    b.eq .Lse_paren
    cmp x20, #AST_VA_ARG
    b.eq .Lse_va_arg
    cmp x20, #AST_GENERIC
    b.eq .Lse_generic
    cmp x20, #AST_COMPOUND_LIT
    b.eq .Lse_compound_lit
    cmp x20, #AST_INIT_LIST
    b.eq .Lse_init_list
    cmp x20, #AST_STMT_EXPR
    b.eq .Lse_stmt_expr

    // Default: int
    b .Lse_default_int

.Lse_init_list:
    // Type every element of a brace initializer so each leaf expression carries
    // a resolved type in AST_F3.  Sema otherwise never descends into a list, so
    // an array-valued element stayed untyped and the IR builder could not tell
    // it had to decay to a pointer: a local `S s = { arr, ... }` then stored a
    // loaded int where the pointer member belonged, and the member pointed at
    // garbage.  Recursion handles nested braces; a designator node types
    // harmlessly (its value follows in the AST_F4 chain and is typed in turn).
    ldr x0, [x19, #AST_F0]        // first element
.Lse_il_loop:
    cbz x0, .Lse_default_int      // list itself has no scalar type → int
    mov x20, x0                    // cursor (callee-saved across the recursion)
    ldr x1, [x20, #AST_TAG]
    cmp x1, #AST_DESIGNATOR
    b.ne .Lse_il_type
    // A designated element (`.m = v` / `[i] = v`) stores its value initializer
    // on the head designator's AST_F3 (the designator chain links via AST_F2).
    // Type that value---NOT the designator node, whose AST_F3 would then be
    // overwritten with the int default, destroying the fill's value pointer.
    ldr x0, [x20, #AST_F3]        // designated value initializer
    cbz x0, .Lse_il_next
    bl _kcc_sema_expr
    b .Lse_il_next
.Lse_il_type:
    bl _kcc_sema_expr
.Lse_il_next:
    ldr x0, [x20, #AST_F4]        // next sibling
    b .Lse_il_loop

.Lse_compound_lit:
    // A compound literal's type is its parenthesised type name; storing it in
    // AST_F3 lets a postfix `.m`/`[i]`/pass-by-value see a real aggregate.
    ldr x0, [x19, #AST_F0]        // the type node
    cbz x0, .Lse_default_int
    bl _kcc_sema_resolve_type
    b .Lse_store

.Lse_generic:
    mov x0, x19
    bl _kcc_sema_expr_generic
    b .Lse_store

.Lse_va_arg:
    // Type the va_list operand; the va_arg node's type is the requested type.
    ldr x0, [x19, #AST_F0]        // va_list expression
    cbz x0, .Lse_va_arg_type
    bl _kcc_sema_expr
.Lse_va_arg_type:
    ldr x0, [x19, #AST_F1]        // target type node
    cbz x0, .Lse_default_int
    bl _kcc_sema_resolve_type
    b .Lse_store

.Lse_ident:
    bl _kcc_sema_expr_ident
    b .Lse_store
.Lse_int_lit:
    bl _kcc_sema_expr_literal
    b .Lse_store
.Lse_str_lit:
    bl _kcc_sema_expr_literal
    b .Lse_store
.Lse_char_lit:
    bl _kcc_sema_expr_literal
    b .Lse_store
.Lse_binary:
    bl _kcc_sema_expr_binary
    b .Lse_store
.Lse_unary:
    bl _kcc_sema_expr_unary
    b .Lse_store
.Lse_assign:
    bl _kcc_sema_expr_assign
    b .Lse_store
.Lse_cond:
    // Check all three parts, result type = type of then-expr
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_expr
    ldr x0, [x19, #AST_F1]
    bl _kcc_sema_expr
    mov x20, x0                     // save then type
    ldr x0, [x19, #AST_F2]
    bl _kcc_sema_expr
    mov x0, x20
    b .Lse_store
.Lse_call:
    bl _kcc_sema_expr_call
    b .Lse_store
.Lse_subscript:
    // array[index]: check both, result = element type
    ldr x0, [x19, #AST_F0]         // array
    bl _kcc_sema_expr
    mov x20, x0
    ldr x0, [x19, #AST_F1]         // index
    bl _kcc_sema_expr
    // Dereference array/pointer type
    ldr x1, [x20, #TY_KIND]
    cmp x1, #TY_PTR
    b.eq .Lse_sub_ptr
    cmp x1, #TY_ARRAY
    b.eq .Lse_sub_arr
    // Not a pointer or array, default to int
    b .Lse_default_int
.Lse_sub_ptr:
.Lse_sub_arr:
    ldr x0, [x20, #TY_F0]          // pointee/element type
    b .Lse_store
.Lse_member:
    bl _kcc_sema_expr_member
    b .Lse_store
.Lse_cast:
    bl _kcc_sema_expr_cast
    b .Lse_store
.Lse_sizeof:
    bl _kcc_sema_expr_sizeof
    b .Lse_store
.Lse_alignof:
    // _Alignof(type): validate the type; the result type is size_t.
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_resolve_type
    adrp x0, _kcc_type_long_u@@PAGE
    add  x0, x0, _kcc_type_long_u@@PAGEOFF
    ldr  x0, [x0]
    b .Lse_store
.Lse_comma:
    // Evaluate LHS, result is type of RHS
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_expr
    ldr x0, [x19, #AST_F1]
    bl _kcc_sema_expr
    b .Lse_store
.Lse_paren:
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_expr
    b .Lse_store

.Lse_stmt_expr:
    // GNU statement expression `({ ... })`.  Type-check the compound block ---
    // this recursively types every inner statement, including the value-yielding
    // final expression.  The construct's type is that of its last item when that
    // item is an expression-statement; otherwise (a declaration, a control-flow
    // statement, or an empty block) it is void.
    ldr x0, [x19, #AST_F0]         // compound node
    cbz x0, .Lse_stmt_void
    mov x20, x0
    bl _kcc_sema_check_stmt        // types all inner statements
    ldr x1, [x20, #AST_F0]         // first item in the block
    cbz x1, .Lse_stmt_void
.Lse_se_last:
    ldr x2, [x1, #AST_F4]          // walk the sibling chain to the last item
    cbz x2, .Lse_se_have_last
    mov x1, x2
    b .Lse_se_last
.Lse_se_have_last:
    ldr x2, [x1, #AST_TAG]
    cmp x2, #AST_EXPR_STMT
    b.ne .Lse_stmt_void
    ldr x0, [x1, #AST_F0]          // the final expression
    cbz x0, .Lse_stmt_void
    ldr x0, [x0, #AST_F3]          // its resolved type
    cbz x0, .Lse_stmt_void
    b .Lse_store
.Lse_stmt_void:
    adrp x0, _kcc_type_void@@PAGE
    add  x0, x0, _kcc_type_void@@PAGEOFF
    ldr  x0, [x0]
    b .Lse_store

.Lse_default_int:
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr  x0, [x0]

.Lse_store:
    // Store resolved type in AST_F3 of the expression node
    str x0, [x19, #AST_F3]

    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

.Lse_null:
    adrp x0, _kcc_type_void@@PAGE
    add  x0, x0, _kcc_type_void@@PAGEOFF
    ldr  x0, [x0]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_sema_expr
@}

\paragraph{Generic selection.}
A \texttt{\_Generic} expression (\stdref{6.5.1.1}) is resolved entirely here, at
type-check time: the controlling expression is \emph{typed but never
evaluated}, and its type chooses one association's expression, which alone is
kept.  The pass types the controlling expression (decaying an array to a
pointer, as lvalue conversion requires), then walks the association list; the
first association whose named type is compatible with the controlling type
wins, and a \texttt{default} association is remembered as the fallback.  Because
\texttt{\_kcc\_type\_compatible} matches on kind and signedness and ignores
qualifiers, a \texttt{volatile int} controlling expression still selects the
\texttt{int} association, as the Standard's lvalue conversion demands.  The
chosen expression is stashed in the node's spare field so the IR builder emits
\emph{only} it---never the controlling expression or the discarded arms---and
its type becomes the type of the whole selection.  A selection that matches
nothing and has no default is a diagnosed error.

@d Sema: check expression @{
// -- kcc_sema_expr_generic ------------------------------------------------
// uint64_t kcc_sema_expr_generic(node *generic)
// Resolve a _Generic selection: type the (unevaluated) controlling expression,
// pick the association whose type is compatible with it---or the default---and
// stash the chosen expression in AST_F2 for the IR builder.  Returns the chosen
// expression's type.
.text
.p2align 2
_kcc_sema_expr_generic:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    mov x19, x0                   // generic node

    // The controlling expression is not evaluated; type it only.  An array or
    // function type decays before the match---handle the common array case.
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_expr
    mov x20, x0                   // controlling type
    cbz x20, .Lseg_walk
    ldr x1, [x20, #TY_KIND]
    cmp x1, #TY_ARRAY
    b.ne .Lseg_walk
    ldr x0, [x20, #TY_F0]        // element type
    bl _kcc_type_ptr
    mov x20, x0
.Lseg_walk:
    ldr x21, [x19, #AST_F1]      // current association
    mov x22, #0                    // remembered default expression (0 = none)
.Lseg_loop:
    cbz x21, .Lseg_use_default
    ldr x0, [x21, #AST_F0]        // association type node (0 = default)
    cbz x0, .Lseg_default
    bl _kcc_sema_resolve_type     // x0 = association type descriptor
    mov x1, x20
    bl _kcc_type_compatible
    cbz x0, .Lseg_next
    ldr x0, [x21, #AST_F1]        // compatible → this association's expression
    b .Lseg_select
.Lseg_default:
    ldr x22, [x21, #AST_F1]
.Lseg_next:
    ldr x21, [x21, #AST_F4]       // next association
    b .Lseg_loop
.Lseg_use_default:
    cbz x22, .Lseg_error
    mov x0, x22
.Lseg_select:
    str x0, [x19, #AST_F2]       // chosen expression, for the IR builder
    bl _kcc_sema_expr             // type-check it
    b .Lseg_done
.Lseg_error:
    ldr x0, [x19, #AST_LINE]
    mov x1, #0
    adrp x2, .Lseg_errmsg@@PAGE
    add  x2, x2, .Lseg_errmsg@@PAGEOFF
    bl _kcc_diag_error
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr  x0, [x0]
.Lseg_done:
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

.section __TEXT,__cstring,cstring_literals
.Lseg_errmsg:
    .asciz "_Generic: no association compatible with the controlling type"
.text
@| _kcc_sema_expr_generic
@}

\subsection{Identifier Expression}

An identifier expression looks up the name in the symbol table.  If
found, the symbol's type is returned after applying function and
array decay (per \stdref{6.3.2.1}): a function designator decays to
a pointer-to-function, and an array decays to a pointer to its first
element.  An undeclared identifier used as a \emph{value} is a hard error
(\texttt{use of undeclared identifier '\\meta{name}'}); the one exception is a
bare name in call position, which is taken as an implicit function declaration
(legacy C) rather than an error---the call handler signals that case through
\texttt{\_kcc\_sema\_callee\_ctx}.  Under \texttt{-Wall} that implicit
declaration is not silent: \kcc{} emits an
\texttt{implicit declaration of function '\\meta{name}'} warning (but still
compiles, assuming an \texttt{int}-returning signature).  Either way the
node's type falls back to \texttt{int} so the pass keeps running and reports
any further errors.

\paragraph{The named-message helpers.}
Several diagnostics have the shape \texttt{\\meta{prefix}\\meta{name}'} --- an
undeclared identifier, a missing member, a redefinition, an implicit
declaration, an unused variable.  \texttt{\_kcc\_sema\_build\_named} assembles
that body once in the arena (the prefix carries its own opening quote; the
closing quote and NUL are appended), and two thin wrappers hand it to the
diagnostic engine: \texttt{\_kcc\_sema\_err\_named} as an error,
\texttt{\_kcc\_sema\_warn\_named} as a warning.  Splitting error from warning
at this seam is what lets the \texttt{-Wall} family reuse the exact message
machinery the hard errors already use.

Enumeration constants receive special treatment.  When the lookup
returns a symbol whose kind is \texttt{SYM\_ENUM\_CONST}, the AST
node is rewritten in place: its tag becomes \texttt{AST\_INT\_LIT}
and \texttt{F0} receives the constant's integer value from
\texttt{SYM\_VALUE}.  The IR builder then sees a plain integer
literal and emits \texttt{IR\_CONST}---no global reference, no
symbol lookup at link time.  This rewrite is safe because the node
will never be examined as an identifier again.

@d Sema: expr ident @{
// -- kcc_sema_expr_ident --------------------------------------------------
// type_desc *kcc_sema_expr_ident(node *expr)
//   x19 = expression node (already loaded by caller)
// Looks up identifier in symbol table, returns its type.
.text
.p2align 2
_kcc_sema_expr_ident:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    // x19 = expr node (from caller)
    // Get name pointer
    ldr x20, [x19, #AST_F0]        // x20 = name_ptr
    cbz x20, .Lsei_unknown

    mov x0, x20
    bl _kcc_strlen
    mov x1, x0                     // len
    mov x0, x20                    // name

    bl _kcc_symtab_lookup
    cbz x0, .Lsei_undeclared

    // Check if this is an enum constant
    ldr x1, [x0, #SYM_KIND]
    cmp x1, #SYM_ENUM_CONST
    b.ne .Lsei_normal

    // Rewrite AST node: AST_IDENT_EXPR → AST_INT_LIT with enum value
    ldr x1, [x0, #SYM_VALUE]
    mov x0, #AST_INT_LIT
    str x0, [x19]                   // overwrite tag
    str x1, [x19, #AST_F0]         // store constant value
    b .Lsei_int_type

.Lsei_normal:
    // Mark the symbol used (for -Wunused-variable); harmless for functions.
    ldr w1, [x0, #SYM_FLAGS]
    orr w1, w1, #2
    str w1, [x0, #SYM_FLAGS]
    // Return symbol's type
    ldr x0, [x0, #SYM_TYPE]
    // Apply function/array decay
    bl _kcc_conv_func_decay
    bl _kcc_conv_array_decay

    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

.Lsei_undeclared:
    // A bare identifier used as a value must be declared.  When it is the
    // direct target of a call we defer to implicit-function-declaration
    // leniency (legacy C: \texttt{printf()} without a prototype); otherwise it
    // is a hard error.  Either way we fall through to the int fallback so the
    // rest of the pass keeps running and reports further errors.
    adrp x0, _kcc_sema_callee_ctx@@PAGE
    add  x0, x0, _kcc_sema_callee_ctx@@PAGEOFF
    ldr  x0, [x0]
    cbz x0, .Lsei_emit_undecl
    // Implicit function declaration: remember it so the call handler does not
    // then complain that the callee is not a function.
    adrp x1, _kcc_sema_callee_implicit@@PAGE
    add  x1, x1, _kcc_sema_callee_implicit@@PAGEOFF
    mov  x2, #1
    str  x2, [x1]
    // -Wall: warn about the implicit declaration (still lenient — compilation
    // continues with an int-returning signature).
    adrp x0, _kcc_warn_all@@PAGE
    add  x0, x0, _kcc_warn_all@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lsei_int_type
    ldr x0, [x19, #AST_LINE]
    ldr x1, [x19, #AST_COL]
    mov x2, x20                    // name
    adrp x3, _kcc_sema_implicit_pre@@PAGE
    add  x3, x3, _kcc_sema_implicit_pre@@PAGEOFF
    bl _kcc_sema_warn_named
    b .Lsei_int_type
.Lsei_emit_undecl:
    ldr x0, [x19, #AST_LINE]
    ldr x1, [x19, #AST_COL]
    mov x2, x20                    // name
    adrp x3, _kcc_sema_undecl_pre@@PAGE
    add  x3, x3, _kcc_sema_undecl_pre@@PAGEOFF
    bl _kcc_sema_err_named

.Lsei_unknown:
.Lsei_int_type:
    // Return int as fallback / enum constant type
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr  x0, [x0]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- kcc_sema_build_named -------------------------------------------------
// char *kcc_sema_build_named(const char *name, const char *prefix)
//   x0 = name, x1 = prefix ; returns x0 = arena "<prefix>name'"
// Builds the quoted message body once (the prefix supplies its own opening
// quote); the closing quote and NUL are appended here.  Shared by the error
// and warning wrappers below.
.text
.p2align 2
_kcc_sema_build_named:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    mov x21, x0                    // name
    mov x22, x1                    // prefix
    mov x0, x22
    bl _kcc_strlen
    mov x24, x0                    // prefix_len
    mov x0, x21
    bl _kcc_strlen
    mov x20, x0                    // name_len
    add x0, x24, x20
    add x0, x0, #2                 // + closing quote + NUL
    bl _kcc_arena_alloc
    mov x23, x0                    // buffer
    mov x0, x23
    mov x1, x22
    mov x2, x24
    bl _kcc_memcpy                 // prefix
    add x0, x23, x24
    mov x1, x21
    mov x2, x20
    bl _kcc_memcpy                 // name
    add x9, x23, x24
    add x9, x9, x20
    mov w10, #0x27                 // '\''
    strb w10, [x9]
    strb wzr, [x9, #1]
    mov x0, x23                    // return buffer
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret

// -- kcc_sema_err_named ---------------------------------------------------
// void kcc_sema_err_named(uint64_t line, uint64_t col,
//                         const char *name, const char *prefix)
// Emits "<prefix>name'" as an error at line:col.  Shared by the
// undeclared-identifier, no-member, and redefinition diagnostics.
.globl _kcc_sema_err_named
.p2align 2
_kcc_sema_err_named:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    mov x19, x0                    // line
    mov x20, x1                    // col
    mov x0, x2                     // name
    mov x1, x3                     // prefix
    bl _kcc_sema_build_named
    mov x2, x0
    mov x0, x19
    mov x1, x20
    bl _kcc_diag_error
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- kcc_sema_warn_named --------------------------------------------------
// void kcc_sema_warn_named(uint64_t line, uint64_t col,
//                          const char *name, const char *prefix)
// Same message body as err_named, emitted as a warning.  Used by the
// -Wall family (implicit function declaration, unused variable, ...).
.globl _kcc_sema_warn_named
.p2align 2
_kcc_sema_warn_named:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    mov x19, x0                    // line
    mov x20, x1                    // col
    mov x0, x2                     // name
    mov x1, x3                     // prefix
    bl _kcc_sema_build_named
    mov x2, x0
    mov x0, x19
    mov x1, x20
    bl _kcc_diag_warning
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- kcc_sema_check_unused_scope ------------------------------------------
// void kcc_sema_check_unused_scope(void)
// Under -Wall, walk the innermost ordinary scope and warn for each SYM_VAR
// that was declared but never referenced.  Called just before a block or
// for-scope is popped; the function/parameter scope is deliberately not
// checked (unused parameters are outside -Wall).
.globl _kcc_sema_check_unused_scope
.p2align 2
_kcc_sema_check_unused_scope:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    str x23, [sp, #48]
    adrp x0, _kcc_warn_all@@PAGE
    add  x0, x0, _kcc_warn_all@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lcus_done
    bl _kcc_symtab_current_ht
    cbz x0, .Lcus_done
    ldr x19, [x0, #HT_ENTRIES]     // entries base
    ldr x20, [x0, #HT_CAP]         // capacity
    mov x21, #0                    // i
.Lcus_loop:
    cmp x21, x20
    b.hs .Lcus_done
    mov x22, #HTE_SIZE
    mul x22, x21, x22
    add x22, x19, x22              // entry ptr
    ldr x0, [x22, #HTE_KEY]
    cbz x0, .Lcus_next             // empty slot
    ldr x23, [x22, #HTE_VALUE]     // sym
    cbz x23, .Lcus_next
    ldr x0, [x23, #SYM_KIND]
    cmp x0, #SYM_VAR
    b.ne .Lcus_next
    ldr w0, [x23, #SYM_FLAGS]
    tst w0, #2                     // used bit set?
    b.ne .Lcus_next
    ldr x0, [x23, #SYM_LINE]
    ldr x1, [x23, #SYM_COL]
    ldr x2, [x23, #SYM_NAME]
    adrp x3, _kcc_sema_unused_pre@@PAGE
    add  x3, x3, _kcc_sema_unused_pre@@PAGEOFF
    bl _kcc_sema_warn_named
.Lcus_next:
    add x21, x21, #1
    b .Lcus_loop
.Lcus_done:
    ldr x23, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret

// -- kcc_sema_check_redef -------------------------------------------------
// void kcc_sema_check_redef(node *decl, const char *name)
// At block scope (depth >= 2; file scope is depth 1) a name already present
// in the current scope is a redefinition, since a block has no tentative
// definitions.  Emits "redefinition of 'name'" at the decl node's location.
.text
.globl _kcc_sema_check_redef
.p2align 2
_kcc_sema_check_redef:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    mov x19, x0                    // node
    mov x20, x1                    // name
    adrp x0, _kcc_sym_depth@@PAGE
    add  x0, x0, _kcc_sym_depth@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #2
    b.lt .Lscr_done
    mov x0, x20
    bl _kcc_strlen
    mov x1, x0
    mov x0, x20
    bl _kcc_symtab_lookup_current
    cbz x0, .Lscr_done
    ldr x0, [x19, #AST_LINE]
    ldr x1, [x19, #AST_COL]
    mov x2, x20                    // name
    adrp x3, _kcc_sema_redef_pre@@PAGE
    add  x3, x3, _kcc_sema_redef_pre@@PAGEOFF
    bl _kcc_sema_err_named
.Lscr_done:
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- kcc_agg_leaf_count ---------------------------------------------------
// uint64_t kcc_agg_leaf_count(type *ty)
// Number of scalar leaves a fully brace-elided initializer fills for `ty`
// (\stdref{6.7.9p20}): 1 for a scalar, length*leaves for an array, the sum of
// its fields' leaves for a struct, the first member's leaves for a union.
.text
.globl _kcc_agg_leaf_count
.p2align 2
_kcc_agg_leaf_count:
    cbz x0, .Lalc_one
    ldr x1, [x0, #TY_KIND]
    cmp x1, #TY_ARRAY
    b.eq .Lalc_array
    cmp x1, #TY_STRUCT
    b.eq .Lalc_struct
    cmp x1, #TY_UNION
    b.eq .Lalc_union
.Lalc_one:
    mov x0, #1
    ret
.Lalc_array:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    ldr x20, [x0, #TY_F1]          // length
    ldr x0, [x0, #TY_F0]           // element type
    bl _kcc_agg_leaf_count
    mul x0, x0, x20
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
.Lalc_struct:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]
    ldr x19, [x0, #TY_F0]          // struct decl
    cbz x19, .Lalc_s_one
    ldr x19, [x19, #AST_F1]        // first field
    mov x20, #0                    // leaf accumulator
.Lalc_s_loop:
    cbz x19, .Lalc_s_ret
    ldr x0, [x19, #AST_F0]         // field type spec
    bl _kcc_sema_resolve_type
    bl _kcc_agg_leaf_count
    add x20, x20, x0
    ldr x19, [x19, #AST_F4]
    b .Lalc_s_loop
.Lalc_s_one:
    mov x20, #1
.Lalc_s_ret:
    mov x0, x20
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
.Lalc_union:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    ldr x1, [x0, #TY_F0]           // union decl
    cbz x1, .Lalc_u_one
    ldr x1, [x1, #AST_F1]          // first member (elision fills only it)
    cbz x1, .Lalc_u_one
    ldr x0, [x1, #AST_F0]          // its type spec
    bl _kcc_sema_resolve_type
    bl _kcc_agg_leaf_count
    ldp x29, x30, [sp], #32
    ret
.Lalc_u_one:
    mov x0, #1
    ldp x29, x30, [sp], #32
    ret

// -- kcc_infer_arr_elems --------------------------------------------------
// uint64_t kcc_infer_arr_elems(node *head, type *elem)
// Count how many array elements a brace-elided initializer list `head..`
// forms when each element has aggregate type `elem`: an item with its own
// brace consumes one element, otherwise a run of leaf-count scalars does
// (\stdref{6.7.9p20}).  Used to size `struct P a[] = { 1,2,3, 4,5,6 }` at 2,
// not 6.
.text
.globl _kcc_infer_arr_elems
.p2align 2
_kcc_infer_arr_elems:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    mov x19, x0                    // item cursor
    mov x0, x1
    bl _kcc_agg_leaf_count
    mov x22, x0                    // leaves per element
    mov x21, #0                    // element count
.Liae_loop:
    cbz x19, .Liae_ret
    ldr x0, [x19, #AST_TAG]
    cmp x0, #AST_INIT_LIST         // element wrote its own brace → one item
    b.eq .Liae_braced
    cmp x0, #AST_DESIGNATOR        // a designator also occupies one slot
    b.eq .Liae_braced
    // Brace elision: this element consumes up to `leaves` scalar items.
    mov x20, x22
.Liae_skip:
    cbz x20, .Liae_count
    cbz x19, .Liae_count
    ldr x19, [x19, #AST_F4]
    sub x20, x20, #1
    b .Liae_skip
    b .Liae_count
.Liae_braced:
    ldr x19, [x19, #AST_F4]
.Liae_count:
    add x21, x21, #1
    b .Liae_loop
.Liae_ret:
    mov x0, x21
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

// -- kcc_sema_infer_array_len ---------------------------------------------
// void kcc_sema_infer_array_len(node *decl)
// If the declaration's type is an incomplete array (an AST_TYPE_ARRAY with no
// size expression) and it has an initializer, synthesise an AST_INT_LIT
// length and hang it on the type node's size-expr slot, so that every later
// resolve of that node yields a *complete* array type.  A string literal
// gives strlen+1; a brace list of scalars gives its element span
// (designator-aware); a brace-elided list of aggregates is grouped by the
// element's leaf count.
.globl _kcc_sema_infer_array_len
.p2align 2
_kcc_sema_infer_array_len:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]
    ldr x19, [x0, #AST_F0]         // type node
    cbz x19, .Lial_done
    ldr x1, [x19, #AST_TAG]
    cmp x1, #AST_TYPE_ARRAY
    b.ne .Lial_done
    ldr x1, [x19, #AST_F1]         // existing size expr?
    cbnz x1, .Lial_done            // already a complete array
    ldr x20, [x0, #AST_F2]         // initializer
    cbz x20, .Lial_done
    ldr x1, [x20, #AST_TAG]
    cmp x1, #AST_STR_LIT
    b.eq .Lial_str
    cmp x1, #AST_INIT_LIST
    b.eq .Lial_list
    b .Lial_done
.Lial_str:
    ldr x21, [x20, #AST_F1]        // string length
    add x21, x21, #1              // + terminating NUL
    b .Lial_make
.Lial_list:
    // When the array element is itself an aggregate, a brace-elided list groups
    // several scalars into each element, so a flat count would over-size the
    // array.  Resolve the element type and, for an aggregate, count grouped
    // elements; a scalar element keeps the plain designator-aware span.
    mov x0, x19                    // AST_TYPE_ARRAY node
    bl _kcc_sema_resolve_type
    cbz x0, .Lial_list_flat
    ldr x0, [x0, #TY_F0]           // element type
    cbz x0, .Lial_list_flat
    ldr x1, [x0, #TY_KIND]
    cmp x1, #TY_STRUCT
    b.eq .Lial_list_agg
    cmp x1, #TY_UNION
    b.eq .Lial_list_agg
    cmp x1, #TY_ARRAY
    b.eq .Lial_list_agg
.Lial_list_flat:
    mov x0, x20
    bl _kcc_ir_initlist_count      // element span (max index + 1)
    mov x21, x0
    b .Lial_make
.Lial_list_agg:
    mov x1, x0                     // element type
    ldr x0, [x20, #AST_F0]         // init-list head
    bl _kcc_infer_arr_elems
    mov x21, x0
.Lial_make:
    mov x0, #AST_INT_LIT
    bl _kcc_ast_alloc
    str x21, [x0, #AST_F0]        // literal value = inferred length
    str x0, [x19, #AST_F1]        // type node's size expr
.Lial_done:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@}

\subsection{Reaching the End of a Non-Void Function}

\texttt{-Wreturn-type} warns when control can run off the bottom of a
function whose return type is not \texttt{void}, because the value it
then hands back is indeterminate.  The whole difficulty is doing this
\emph{without} false positives: a function that ends in an exhaustive
\texttt{if}/\texttt{else} where both arms return, or in an infinite
loop, or in a call to \texttt{exit}, never actually falls through, and
warning about it would be worse than saying nothing.  So the analysis is
built the sound way round: \texttt{kcc\_sema\_falls\_through} returns
true only when it can \emph{prove} control reaches the bottom of a
statement, and the warning fires only on that proof.  Anything it cannot
analyse it treats as ``might not fall through,'' which costs a missed
warning but never a spurious one.

The recursion mirrors the language's control flow.  A \texttt{return},
\texttt{goto}, \texttt{break}, or \texttt{continue} does not fall
through.  A block falls through only if every one of its statements
does---the first statement that diverts control ends the block.  An
\texttt{if} falls through if it lacks an \texttt{else} (the untaken path
continues) or if either arm falls through.  A \texttt{while}/\texttt{for}/%
\texttt{do} whose controlling expression is a constant truth and whose
body contains no \texttt{break} that would leave \emph{this} loop is an
infinite loop and does not fall through; any other loop is assumed to be
exitable.  A \texttt{switch} is treated conservatively as possibly
terminating (so an exhaustive returning \texttt{switch} is never
falsely flagged), and an expression statement that is a call to a known
\texttt{\_Noreturn} function (\texttt{exit}, \texttt{abort}, and kin)
does not fall through.  \texttt{main} is exempt entirely, since falling
off its end is defined to return zero (\stdref{5.1.2.2.3}).

\texttt{kcc\_sema\_has\_toplevel\_break} supports the loop case: it looks
for a \texttt{break} that belongs to the loop being analysed, stopping
its descent at any nested loop or \texttt{switch}, whose own
\texttt{break}s bind there instead.

@d Sema: return path @{
// -- kcc_sema_const_true --------------------------------------------------
// int kcc_sema_const_true(node *expr)
// 1 iff expr is (parenthesised) integer/char constant with a non-zero value.
.text
.p2align 2
_kcc_sema_const_true:
    cbz x0, .Lct_no
.Lct_unwrap:
    ldr x1, [x0, #AST_TAG]
    cmp x1, #AST_PAREN_EXPR
    b.ne .Lct_check
    ldr x0, [x0, #AST_F0]
    cbz x0, .Lct_no
    b .Lct_unwrap
.Lct_check:
    cmp x1, #AST_INT_LIT
    b.eq .Lct_int
    cmp x1, #AST_CHAR_LIT
    b.eq .Lct_int
    mov x0, #0
    ret
.Lct_int:
    ldr x0, [x0, #AST_F0]          // value
    cmp x0, #0
    cset x0, ne
    ret
.Lct_no:
    mov x0, #0
    ret

// -- kcc_sema_has_toplevel_break ------------------------------------------
// int kcc_sema_has_toplevel_break(node *s)
// 1 iff s contains a break that would exit the *enclosing* loop, i.e. a
// break not itself inside a nested loop or switch.
.p2align 2
_kcc_sema_has_toplevel_break:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    mov x19, x0
    cbz x19, .Lhb_no
    ldr x20, [x19, #AST_TAG]
    cmp x20, #AST_BREAK_STMT
    b.eq .Lhb_yes
    cmp x20, #AST_WHILE_STMT
    b.eq .Lhb_no
    cmp x20, #AST_FOR_STMT
    b.eq .Lhb_no
    cmp x20, #AST_DO_STMT
    b.eq .Lhb_no
    cmp x20, #AST_SWITCH_STMT
    b.eq .Lhb_no
    cmp x20, #AST_COMPOUND
    b.eq .Lhb_compound
    cmp x20, #AST_IF_STMT
    b.eq .Lhb_if
    cmp x20, #AST_LABEL_STMT
    b.eq .Lhb_inner_f1
    cmp x20, #AST_CASE_STMT
    b.eq .Lhb_inner_f1
    cmp x20, #AST_DEFAULT_STMT
    b.eq .Lhb_inner_f0
    b .Lhb_no
.Lhb_yes:
    mov x0, #1
    b .Lhb_ret
.Lhb_no:
    mov x0, #0
    b .Lhb_ret
.Lhb_compound:
    ldr x19, [x19, #AST_F0]
.Lhb_cl:
    cbz x19, .Lhb_no
    mov x0, x19
    bl _kcc_sema_has_toplevel_break
    cbnz x0, .Lhb_yes
    ldr x19, [x19, #AST_F4]
    b .Lhb_cl
.Lhb_if:
    ldr x0, [x19, #AST_F1]         // then
    bl _kcc_sema_has_toplevel_break
    cbnz x0, .Lhb_yes
    ldr x0, [x19, #AST_F2]         // else
    cbz x0, .Lhb_no
    bl _kcc_sema_has_toplevel_break
    b .Lhb_ret
.Lhb_inner_f1:
    ldr x0, [x19, #AST_F1]
    bl _kcc_sema_has_toplevel_break
    b .Lhb_ret
.Lhb_inner_f0:
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_has_toplevel_break
.Lhb_ret:
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- kcc_sema_is_noreturn_call --------------------------------------------
// int kcc_sema_is_noreturn_call(node *expr)
// 1 iff expr is a direct call to a known _Noreturn library function.
.p2align 2
_kcc_sema_is_noreturn_call:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    mov x19, x0
    cbz x19, .Linr_no
    ldr x0, [x19, #AST_TAG]
    cmp x0, #AST_CALL_EXPR
    b.ne .Linr_no
    ldr x0, [x19, #AST_F0]         // callee
    cbz x0, .Linr_no
    ldr x1, [x0, #AST_TAG]
    cmp x1, #AST_IDENT_EXPR
    b.ne .Linr_no
    ldr x19, [x0, #AST_F0]         // callee name
    cbz x19, .Linr_no
    adrp x20, _kcc_sema_noreturn_tbl@@PAGE
    add  x20, x20, _kcc_sema_noreturn_tbl@@PAGEOFF
.Linr_loop:
    ldr x1, [x20]
    cbz x1, .Linr_no
    mov x0, x19
    bl _kcc_strcmp
    cbz x0, .Linr_yes
    add x20, x20, #8
    b .Linr_loop
.Linr_yes:
    mov x0, #1
    b .Linr_ret
.Linr_no:
    mov x0, #0
.Linr_ret:
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- kcc_sema_falls_through -----------------------------------------------
// int kcc_sema_falls_through(node *s)
// 1 iff control can be *proven* to reach the bottom of statement s.
.p2align 2
_kcc_sema_falls_through:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    mov x19, x0
    cbz x19, .Lft_yes              // null/empty statement falls through
    ldr x20, [x19, #AST_TAG]
    cmp x20, #AST_RETURN_STMT
    b.eq .Lft_no
    cmp x20, #AST_GOTO_STMT
    b.eq .Lft_no
    cmp x20, #AST_BREAK_STMT
    b.eq .Lft_no
    cmp x20, #AST_CONTINUE_STMT
    b.eq .Lft_no
    cmp x20, #AST_SWITCH_STMT
    b.eq .Lft_no                   // conservative: never falsely flag a switch
    cmp x20, #AST_COMPOUND
    b.eq .Lft_compound
    cmp x20, #AST_IF_STMT
    b.eq .Lft_if
    cmp x20, #AST_LABEL_STMT
    b.eq .Lft_label
    cmp x20, #AST_WHILE_STMT
    b.eq .Lft_while
    cmp x20, #AST_FOR_STMT
    b.eq .Lft_for
    cmp x20, #AST_DO_STMT
    b.eq .Lft_do
    cmp x20, #AST_EXPR_STMT
    b.eq .Lft_expr
    // everything else (declarations, plain labels, case/default wrappers) is
    // straight-line code that falls through.
    b .Lft_yes
.Lft_no:
    mov x0, #0
    b .Lft_ret
.Lft_yes:
    mov x0, #1
    b .Lft_ret
.Lft_compound:
    ldr x19, [x19, #AST_F0]        // first item
.Lft_comp_loop:
    cbz x19, .Lft_yes              // ran off the end → falls through
    mov x0, x19
    bl _kcc_sema_falls_through
    cbz x0, .Lft_no                // a diverting statement ends the block
    ldr x19, [x19, #AST_F4]        // next item
    b .Lft_comp_loop
.Lft_if:
    ldr x0, [x19, #AST_F2]         // else
    cbz x0, .Lft_yes               // no else → the untaken path continues
    ldr x0, [x19, #AST_F1]         // then
    bl _kcc_sema_falls_through
    cbnz x0, .Lft_yes
    ldr x0, [x19, #AST_F2]         // else
    bl _kcc_sema_falls_through
    b .Lft_ret
.Lft_label:
    ldr x0, [x19, #AST_F1]         // labelled statement
    bl _kcc_sema_falls_through
    b .Lft_ret
.Lft_while:
    ldr x0, [x19, #AST_F0]         // cond
    bl _kcc_sema_const_true
    cbz x0, .Lft_yes               // exitable loop → may fall through
    ldr x0, [x19, #AST_F1]         // body
    bl _kcc_sema_has_toplevel_break
    cbnz x0, .Lft_yes
    b .Lft_no                      // infinite, no break
.Lft_for:
    ldr x0, [x19, #AST_F1]         // cond
    cbz x0, .Lft_for_inf           // for(;;) → no condition → infinite
    bl _kcc_sema_const_true
    cbz x0, .Lft_yes
.Lft_for_inf:
    ldr x0, [x19, #AST_F3]         // body
    bl _kcc_sema_has_toplevel_break
    cbnz x0, .Lft_yes
    b .Lft_no
.Lft_do:
    ldr x0, [x19, #AST_F1]         // cond
    bl _kcc_sema_const_true
    cbz x0, .Lft_yes
    ldr x0, [x19, #AST_F0]         // body
    bl _kcc_sema_has_toplevel_break
    cbnz x0, .Lft_yes
    b .Lft_no
.Lft_expr:
    ldr x0, [x19, #AST_F0]         // expression
    bl _kcc_sema_is_noreturn_call
    cbnz x0, .Lft_no
    b .Lft_yes
.Lft_ret:
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- kcc_sema_check_return_path -------------------------------------------
// void kcc_sema_check_return_path(node *func)
// Under -Wall, warn if a non-void, non-main function can fall off its end.
// The return type is read from _kcc_sema_cur_ret, which the body handler set
// (the TY_FUNC register is reused by the parameter loop and is not reliable
// here).
.globl _kcc_sema_check_return_path
.p2align 2
_kcc_sema_check_return_path:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    mov x19, x0                    // func node
    adrp x0, _kcc_warn_all@@PAGE
    add  x0, x0, _kcc_warn_all@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lcrp_done
    adrp x0, _kcc_sema_cur_ret@@PAGE
    add  x0, x0, _kcc_sema_cur_ret@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lcrp_done
    ldr  x1, [x0, #TY_KIND]
    cmp  x1, #TY_VOID
    b.eq .Lcrp_done
    ldr  x0, [x19, #AST_F1]        // name
    cbz  x0, .Lcrp_done
    adrp x1, _kcc_sema_main_name@@PAGE
    add  x1, x1, _kcc_sema_main_name@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lcrp_done             // main is exempt
    ldr x0, [x19, #AST_F3]         // body
    cbz x0, .Lcrp_done             // no body (prototype)
    bl _kcc_sema_falls_through
    cbz x0, .Lcrp_done             // provably returns on all paths
    ldr x0, [x19, #AST_LINE]
    ldr x1, [x19, #AST_COL]
    adrp x2, _kcc_sema_reach_end@@PAGE
    add  x2, x2, _kcc_sema_reach_end@@PAGEOFF
    bl _kcc_diag_warning
.Lcrp_done:
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@}

\subsection{Literal Expressions}

A character literal and an unsuffixed integer literal have type
\texttt{int}.  A suffixed integer literal takes the type its suffix names
(\stdref{6.4.4.1}): the parser recorded \texttt{u}/\texttt{U} and the
\texttt{l}/\texttt{L} count as flags in \texttt{AST\_F2}, and here we decode
them---bit~0 selects the unsigned variant, and the long rank in bits~1--2
chooses \texttt{int}, \texttt{long}, or \texttt{long long}.  A char literal
leaves \texttt{AST\_F2} zero and so still types as \texttt{int}.  This is a
deliberately \emph{suffix-only} typing: it does not yet promote an unsuffixed
constant whose magnitude overflows \texttt{int} to a wider type, which is a
separate value-directed rule.  String literals have type \texttt{char~*}
(pointer to signed char), matching the C17 rule that a string literal is an
array that decays to a pointer.

@d Sema: expr literal @{
// -- kcc_sema_expr_literal ------------------------------------------------
// type_desc *kcc_sema_expr_literal(node *expr)
//   x19 = expression node, x20 = tag (set by caller)
.text
.p2align 2
_kcc_sema_expr_literal:
    stp x29, x30, [sp, #-16]!
    mov x29, sp

    cmp x20, #AST_INT_LIT
    b.eq .Lsel_int
    cmp x20, #AST_CHAR_LIT
    b.eq .Lsel_int
    cmp x20, #AST_FLOAT_LIT
    b.eq .Lsel_double
    cmp x20, #AST_STR_LIT
    b.eq .Lsel_str

    // Default: int
.Lsel_int:
    // An integer literal's suffix flags live in AST_F2 (bit 0 = unsigned,
    // bits 1-2 = long rank).  A char literal and an unsuffixed integer both
    // leave AST_F2 == 0, so they fall through to plain int.
    ldr x1, [x19, #AST_F2]
    cbz x1, .Lsel_plain_int
    lsr x2, x1, #1
    and x2, x2, #3               // long rank: 0 int, 1 long, 2 long long
    and x1, x1, #1               // unsigned bit
    cbz x2, .Lsel_rank_int
    cmp x2, #1
    b.eq .Lsel_rank_long
    // long long
    cbz x1, .Lsel_llong_s
    adrp x0, _kcc_type_llong_u@@PAGE
    add  x0, x0, _kcc_type_llong_u@@PAGEOFF
    b .Lsel_int_ret
.Lsel_llong_s:
    adrp x0, _kcc_type_llong_s@@PAGE
    add  x0, x0, _kcc_type_llong_s@@PAGEOFF
    b .Lsel_int_ret
.Lsel_rank_long:
    cbz x1, .Lsel_long_s
    adrp x0, _kcc_type_long_u@@PAGE
    add  x0, x0, _kcc_type_long_u@@PAGEOFF
    b .Lsel_int_ret
.Lsel_long_s:
    adrp x0, _kcc_type_long_s@@PAGE
    add  x0, x0, _kcc_type_long_s@@PAGEOFF
    b .Lsel_int_ret
.Lsel_rank_int:
    // rank int but unsigned suffix (u/U with no l/L)
    adrp x0, _kcc_type_int_u@@PAGE
    add  x0, x0, _kcc_type_int_u@@PAGEOFF
    b .Lsel_int_ret
.Lsel_plain_int:
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
.Lsel_int_ret:
    ldr  x0, [x0]
    ldp x29, x30, [sp], #16
    ret

.Lsel_double:
    // A floating constant is double, or float when it carried an f/F suffix
    // (recorded in AST_F2 by the parser; the value was rounded to single there).
    ldr x0, [x19, #AST_F2]
    cbz x0, .Lsel_double_d
    adrp x0, _kcc_type_float@@PAGE
    add  x0, x0, _kcc_type_float@@PAGEOFF
    ldr  x0, [x0]
    ldp x29, x30, [sp], #16
    ret
.Lsel_double_d:
    adrp x0, _kcc_type_double@@PAGE
    add  x0, x0, _kcc_type_double@@PAGEOFF
    ldr  x0, [x0]
    ldp x29, x30, [sp], #16
    ret

.Lsel_str:
    // String literal: type is "char *" (pointer to char)
    adrp x0, _kcc_type_char_s@@PAGE
    add  x0, x0, _kcc_type_char_s@@PAGEOFF
    ldr  x0, [x0]
    bl _kcc_type_ptr
    ldp x29, x30, [sp], #16
    ret
@}

\subsection{Binary Expression}

Binary expression type-checking first resolves the types of both
operands.  Comparison and logical operators always produce
\texttt{int} (per \stdref{6.5.8--9} and \stdref{6.5.13--14}).  If
the left operand is a pointer and the operator is additive, the
result is a pointer type (pointer arithmetic).  A shift
(\texttt{<<}, \texttt{>>}) is special (\stdref{6.5.7}): its result type
is the \emph{promoted left operand} alone, so the right operand never
enters the conversions and \texttt{1 << 1u} stays a signed \texttt{int}.
Otherwise, the usual arithmetic conversions
(\texttt{\_kcc\_conv\_usual}) determine the common type.

The six relational and equality operators additionally run the
\texttt{-Wsign-compare} check (\texttt{kcc\_sema\_check\_sign\_compare}).
When one operand is a signed integer and the other unsigned, the usual
conversions turn the signed value unsigned, which flips the meaning of a
negative value---the classic \texttt{u < -1} surprise.  The check warns
on exactly that mismatch, with one deliberate suppression that keeps it
quiet on ordinary code: if either operand is a \emph{known non-negative
constant}, there is nothing to be surprised by, so \texttt{u < 10} and
\texttt{i == 0} stay silent.  Identifying that constant is easy here
because the AST has no negative literals---a negative value is a
unary-minus expression---so an integer or character literal operand is
necessarily non-negative.  An enumeration constant, already folded to
such a literal by the time the operands are checked, is covered by the
same test.  Signedness itself comes from
\texttt{kcc\_sema\_int\_signedness}, which reads \texttt{TY\_F0} for the
ranked integer kinds and treats an enum as signed \texttt{int}; anything
that is not one of those integers (a pointer, a float) is unranked and
the check is skipped.

@d Sema: expr binary @{
// -- kcc_sema_expr_binary -------------------------------------------------
// type_desc *kcc_sema_expr_binary(node *expr)
//   x19 = expression node
.text
.p2align 2
_kcc_sema_expr_binary:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]

    // Type-check LHS
    ldr x0, [x19, #AST_F1]
    bl _kcc_sema_expr
    mov x21, x0                     // LHS type

    // Type-check RHS
    ldr x0, [x19, #AST_F2]
    bl _kcc_sema_expr
    mov x22, x0                     // RHS type

    // Get operator
    ldr x20, [x19, #AST_F0]

    // Comparison operators return int (and get the -Wsign-compare check)
    cmp x20, #TOK_EQ
    b.eq .Lseb_cmp
    cmp x20, #TOK_NE
    b.eq .Lseb_cmp
    cmp x20, #TOK_LT
    b.eq .Lseb_cmp
    cmp x20, #TOK_GT
    b.eq .Lseb_cmp
    cmp x20, #TOK_LE
    b.eq .Lseb_cmp
    cmp x20, #TOK_GE
    b.eq .Lseb_cmp

    // Logical operators return int
    cmp x20, #TOK_AND
    b.eq .Lseb_int
    cmp x20, #TOK_OR
    b.eq .Lseb_int

    // Shift operators: the result type is the promoted LEFT operand alone
    // (\stdref{6.5.7}); the right operand does not enter the usual arithmetic
    // conversions, so `1 << 1u` stays a signed int, not unsigned.
    cmp x20, #TOK_SHL
    b.eq .Lseb_shift
    cmp x20, #TOK_SHR
    b.eq .Lseb_shift

    // Pointer arithmetic: ptr + int or ptr - int
    ldr x0, [x21, #TY_KIND]
    cmp x0, #TY_PTR
    b.eq .Lseb_ptr_arith

    // Arithmetic operators: usual arithmetic conversions
    mov x0, x21
    mov x1, x22
    bl _kcc_conv_usual
    b .Lseb_done

.Lseb_shift:
    mov x0, x21                    // left operand type
    bl _kcc_conv_promote           // integer-promote (rank < int → int)
    b .Lseb_done

.Lseb_ptr_arith:
    // `ptr + int` and `ptr - int` yield a pointer, but `ptr - ptr` is a pointer
    // \emph{difference} whose type is the signed integer \texttt{ptrdiff_t}
    // (\stdref{6.5.6}), here \texttt{long}.  Getting this wrong made the result
    // of `p - q` carry a pointer type, so a surrounding `(p - q) + n` treated it
    // as pointer arithmetic and scaled `n` by the element size --- `(p-buf)+buf[2]`
    // added `buf[2] * sizeof(int)` instead of `buf[2]`.
    cmp x20, #TOK_MINUS
    b.ne .Lseb_ptr_result
    ldr x1, [x22, #TY_KIND]         // RHS kind
    cmp x1, #TY_PTR
    b.eq .Lseb_ptrdiff
    cmp x1, #TY_ARRAY
    b.eq .Lseb_ptrdiff
.Lseb_ptr_result:
    mov x0, x21                    // ptr ± int → pointer type
    b .Lseb_done
.Lseb_ptrdiff:
    adrp x0, _kcc_type_long_s@@PAGE
    add  x0, x0, _kcc_type_long_s@@PAGEOFF
    ldr  x0, [x0]
    b .Lseb_done

.Lseb_cmp:
    // -Wall -Wsign-compare: a signed-vs-unsigned comparison, then int result.
    mov x0, x19                    // expr node (for location + operand nodes)
    mov x1, x21                    // LHS type
    mov x2, x22                    // RHS type
    bl _kcc_sema_check_sign_compare
    // fall through to the int result

.Lseb_int:
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr  x0, [x0]

.Lseb_done:
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

// -- kcc_sema_int_signedness ----------------------------------------------
// int kcc_sema_int_signedness(type_desc *t)
// 1 = signed integer, 0 = unsigned integer, -1 = not an integer we rank.
// Integer kinds CHAR..LLONG carry signedness in TY_F0; an enum is signed int.
.globl _kcc_sema_int_signedness
.p2align 2
_kcc_sema_int_signedness:
    cbz x0, .Lsg_na
    ldr x1, [x0, #TY_KIND]
    cmp x1, #TY_ENUM
    b.eq .Lsg_signed
    cmp x1, #TY_CHAR
    b.lt .Lsg_na                   // below CHAR (void/bool) → skip
    cmp x1, #TY_LLONG
    b.gt .Lsg_na                   // above LLONG (float/ptr/...) → skip
    ldr x0, [x0, #TY_F0]           // 1=signed, 0=unsigned
    ret
.Lsg_signed:
    mov x0, #1
    ret
.Lsg_na:
    mov x0, #-1
    ret

// -- kcc_sema_is_nonneg_const ---------------------------------------------
// int kcc_sema_is_nonneg_const(node *e)
// 1 iff e is a (parenthesised) integer/char literal.  In this AST such a
// literal is always non-negative -- a negative value is a unary-minus
// expression -- so this exactly identifies a known non-negative constant.
.p2align 2
_kcc_sema_is_nonneg_const:
    cbz x0, .Lnn_no
.Lnn_unwrap:
    ldr x1, [x0, #AST_TAG]
    cmp x1, #AST_PAREN_EXPR
    b.ne .Lnn_check
    ldr x0, [x0, #AST_F0]
    cbz x0, .Lnn_no
    b .Lnn_unwrap
.Lnn_check:
    cmp x1, #AST_INT_LIT
    b.eq .Lnn_yes
    cmp x1, #AST_CHAR_LIT
    b.eq .Lnn_yes
    mov x0, #0
    ret
.Lnn_yes:
    mov x0, #1
    ret
.Lnn_no:
    mov x0, #0
    ret

// -- kcc_sema_check_sign_compare ------------------------------------------
// void kcc_sema_check_sign_compare(node *expr, type_desc *lt, type_desc *rt)
// Under -Wall, warn when a comparison mixes a signed and an unsigned integer
// operand, unless one operand is a known non-negative constant (the common,
// safe case such as `u < 10`).
.globl _kcc_sema_check_sign_compare
.p2align 2
_kcc_sema_check_sign_compare:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    mov x19, x0                    // expr node
    mov x21, x1                    // LHS type
    mov x22, x2                    // RHS type
    adrp x0, _kcc_warn_all@@PAGE
    add  x0, x0, _kcc_warn_all@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lcsc_done
    mov x0, x21
    bl _kcc_sema_int_signedness
    cmn x0, #1                     // == -1 ?
    b.eq .Lcsc_done                // LHS not an integer we rank
    mov x20, x0                    // LHS signedness
    mov x0, x22
    bl _kcc_sema_int_signedness
    cmn x0, #1
    b.eq .Lcsc_done                // RHS not an integer
    cmp x0, x20
    b.eq .Lcsc_done                // same signedness → fine
    // Signedness differs: suppress if either operand is a non-negative const.
    ldr x0, [x19, #AST_F1]         // LHS node
    bl _kcc_sema_is_nonneg_const
    cbnz x0, .Lcsc_done
    ldr x0, [x19, #AST_F2]         // RHS node
    bl _kcc_sema_is_nonneg_const
    cbnz x0, .Lcsc_done
    ldr x0, [x19, #AST_LINE]
    ldr x1, [x19, #AST_COL]
    adrp x2, _kcc_sema_sign_cmp@@PAGE
    add  x2, x2, _kcc_sema_sign_cmp@@PAGEOFF
    bl _kcc_diag_warning
.Lcsc_done:
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@}

\subsection{Unary Expression}

Unary expression types depend on the operator.  Address-of
(\texttt{\&}) wraps the operand type in a pointer.  Dereference
(\texttt{*}) unwraps one pointer level; if the operand is not a
pointer, the checker falls back to \texttt{int}.  Logical not
(\texttt{!}) always produces \texttt{int}.  All remaining operators
(bitwise not, increment, decrement, unary minus and plus) preserve
the operand type.

@d Sema: expr unary @{
// -- kcc_sema_expr_unary --------------------------------------------------
// type_desc *kcc_sema_expr_unary(node *expr)
//   x19 = expression node
.text
.p2align 2
_kcc_sema_expr_unary:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    // Type-check operand
    ldr x0, [x19, #AST_F1]
    bl _kcc_sema_expr
    mov x20, x0                     // operand type

    // Get operator
    ldr x0, [x19, #AST_F0]

    cmp x0, #TOK_AMP               // address-of
    b.eq .Lseu_addr
    cmp x0, #TOK_STAR              // dereference
    b.eq .Lseu_deref
    cmp x0, #TOK_BANG              // logical not → int
    b.eq .Lseu_int
    cmp x0, #TOK_TILDE            // bitwise not → promoted operand type
    b.eq .Lseu_promote
    cmp x0, #TOK_INC              // increment → operand type (an lvalue)
    b.eq .Lseu_operand
    cmp x0, #TOK_DEC              // decrement → operand type (an lvalue)
    b.eq .Lseu_operand
    cmp x0, #TOK_MINUS            // unary minus → promoted operand type
    b.eq .Lseu_promote
    cmp x0, #TOK_PLUS             // unary plus → promoted operand type
    b.eq .Lseu_promote

    // Default: operand type
    b .Lseu_operand

.Lseu_promote:
    // The arithmetic unary operators -, +, ~ apply the integer promotions to
    // their result (\stdref{6.5.3.3}), so \texttt{-(unsigned short)1} is a
    // signed \texttt{int}, not an unsigned short.
    mov x0, x20
    bl _kcc_conv_promote
    b .Lseu_done

.Lseu_addr:
    // &expr → pointer to operand type
    mov x0, x20
    bl _kcc_type_ptr
    b .Lseu_done

.Lseu_deref:
    // *expr → dereference pointer
    ldr x1, [x20, #TY_KIND]
    cmp x1, #TY_PTR
    b.ne .Lseu_int              // error: not a pointer
    ldr x0, [x20, #TY_F0]      // pointee type
    b .Lseu_done

.Lseu_int:
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr  x0, [x0]
    b .Lseu_done

.Lseu_operand:
    mov x0, x20

.Lseu_done:
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@}

\subsection{Assignment Expression}

Per \stdref{6.5.16}, the type of an assignment expression is the type
of the left operand.  Both sides are type-checked, but the result
type is always the LHS type.  Compound assignments (\texttt{+=},
\texttt{-=}, etc.) are treated identically for type purposes.

A simple assignment additionally runs the \texttt{-Wint-conversion}
check (\texttt{kcc\_sema\_check\_int\_ptr}), the same check reused for
initialisation and \texttt{return}: mixing an integer and a pointer
across the assignment---\texttt{int *p = 5}, or \texttt{int n =
p}---without a cast is almost always a mistake, and the resulting value
is meaningless on this target where pointers are wider than
\texttt{int}.  \texttt{kcc\_sema\_ptr\_int\_class} sorts each type into
pointer, integer, or neither, and a warning is issued only for the two
genuine mismatches (integer into pointer, pointer into integer).  Two
suppressions keep it honest: the check is limited to the simple
\texttt{=} operator, since \texttt{p += n} is legitimate pointer
arithmetic rather than a conversion; and the integer constant zero is
recognised as the null pointer constant
(\texttt{kcc\_sema\_is\_null\_const}), so \texttt{int *p = 0} stays
silent while \texttt{int *p = 5} does not.  Function arguments are not
covered, because the function type descriptor does not yet carry its
parameter types.

@d Sema: expr assign @{
// -- kcc_sema_expr_assign -------------------------------------------------
// type_desc *kcc_sema_expr_assign(node *expr)
//   x19 = expression node
// Type of assignment = type of LHS.
.text
.p2align 2
_kcc_sema_expr_assign:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    // Type-check LHS
    ldr x0, [x19, #AST_F1]
    bl _kcc_sema_expr
    mov x20, x0                     // LHS type (= result type)

    // Type-check RHS
    ldr x0, [x19, #AST_F2]
    bl _kcc_sema_expr               // x0 = RHS type

    // -Wall -Wint-conversion: only for a simple '=' (compound assignment on a
    // pointer is legal arithmetic, not a conversion).
    ldr x1, [x19, #AST_F0]         // operator
    cmp x1, #TOK_ASSIGN
    b.ne .Lsea_result
    mov x2, x0                      // src type (RHS)
    mov x1, x20                     // dst type (LHS)
    mov x0, x19                     // location node
    ldr x3, [x19, #AST_F2]         // src node
    bl _kcc_sema_check_int_ptr

.Lsea_result:
    // Result type is LHS type
    mov x0, x20

    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- kcc_sema_ptr_int_class -----------------------------------------------
// int kcc_sema_ptr_int_class(type_desc *t)
// 1 = pointer, 2 = integer (bool..long long, enum), 0 = anything else.
.p2align 2
_kcc_sema_ptr_int_class:
    cbz x0, .Lpic_other
    ldr x1, [x0, #TY_KIND]
    cmp x1, #TY_PTR
    b.eq .Lpic_ptr
    cmp x1, #TY_ENUM
    b.eq .Lpic_int
    cmp x1, #TY_BOOL               // 2
    b.lt .Lpic_other
    cmp x1, #TY_LLONG              // 7
    b.gt .Lpic_other
    mov x0, #2
    ret
.Lpic_ptr:
    mov x0, #1
    ret
.Lpic_int:
    mov x0, #2
    ret
.Lpic_other:
    mov x0, #0
    ret

// -- kcc_sema_is_null_const -----------------------------------------------
// int kcc_sema_is_null_const(node *e)
// 1 iff e is a (parenthesised) integer literal equal to zero -- the null
// pointer constant, which converts to any pointer without complaint.
.p2align 2
_kcc_sema_is_null_const:
    cbz x0, .Lnc_no
.Lnc_unwrap:
    ldr x1, [x0, #AST_TAG]
    cmp x1, #AST_PAREN_EXPR
    b.ne .Lnc_check
    ldr x0, [x0, #AST_F0]
    cbz x0, .Lnc_no
    b .Lnc_unwrap
.Lnc_check:
    cmp x1, #AST_INT_LIT
    b.ne .Lnc_no
    ldr x0, [x0, #AST_F0]          // value
    cmp x0, #0
    cset x0, eq
    ret
.Lnc_no:
    mov x0, #0
    ret

// -- kcc_sema_check_int_ptr -----------------------------------------------
// void kcc_sema_check_int_ptr(node *loc, type *dst, type *src, node *srcexpr)
// Under -Wall, warn when an integer is converted to a pointer or vice versa
// without a cast (assignment, initialisation, return).  A null pointer
// constant (integer 0) assigned to a pointer is exempt.
.globl _kcc_sema_check_int_ptr
.p2align 2
_kcc_sema_check_int_ptr:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    mov x19, x0                    // loc node
    mov x20, x1                    // dst type
    mov x21, x2                    // src type
    mov x22, x3                    // src node
    adrp x0, _kcc_warn_all@@PAGE
    add  x0, x0, _kcc_warn_all@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lcip_done
    mov x0, x20
    bl _kcc_sema_ptr_int_class
    mov x20, x0                    // dst class (leaf call: x19/x21/x22 intact)
    mov x0, x21
    bl _kcc_sema_ptr_int_class
    mov x21, x0                    // src class
    cmp x20, #1                    // dst pointer?
    b.ne .Lcip_int_dst
    cmp x21, #2                    // src integer?
    b.ne .Lcip_done
    mov x0, x22
    bl _kcc_sema_is_null_const
    cbnz x0, .Lcip_done            // int 0 → null pointer constant, fine
    ldr x0, [x19, #AST_LINE]
    ldr x1, [x19, #AST_COL]
    adrp x2, _kcc_sema_int2ptr@@PAGE
    add  x2, x2, _kcc_sema_int2ptr@@PAGEOFF
    bl _kcc_diag_warning
    b .Lcip_done
.Lcip_int_dst:
    cmp x20, #2                    // dst integer?
    b.ne .Lcip_done
    cmp x21, #1                    // src pointer?
    b.ne .Lcip_done
    ldr x0, [x19, #AST_LINE]
    ldr x1, [x19, #AST_COL]
    adrp x2, _kcc_sema_ptr2int@@PAGE
    add  x2, x2, _kcc_sema_ptr2int@@PAGEOFF
    bl _kcc_diag_warning
.Lcip_done:
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@}

\subsection{Function Call}

A function call first type-checks the callee expression, then
walks the argument list and type-checks each argument.  The result
type is the callee's return type, extracted from the
\texttt{TY\_FUNC} descriptor's \texttt{TY\_F0} field.  If the callee
is a pointer-to-function, the pointer is dereferenced first.
Implicit function declarations (callee not found) fall back to
\texttt{int} return.

@d Sema: expr call @{
// -- kcc_sema_expr_call ---------------------------------------------------
// type_desc *kcc_sema_expr_call(node *expr)
//   x19 = expression node
.text
.p2align 2
_kcc_sema_expr_call:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    // Type-check callee.  When it is a bare identifier, enter "callee
    // context" so an undeclared name is taken as an implicit function
    // declaration rather than an undeclared-identifier error.
    adrp x3, _kcc_sema_callee_implicit@@PAGE
    add  x3, x3, _kcc_sema_callee_implicit@@PAGEOFF
    str xzr, [x3]                   // clear implicit-function marker
    ldr x0, [x19, #AST_F0]         // callee node
    ldr x1, [x0]                   // AST_TAG
    cmp x1, #AST_IDENT_EXPR
    cset x2, eq
    adrp x3, _kcc_sema_callee_ctx@@PAGE
    add  x3, x3, _kcc_sema_callee_ctx@@PAGEOFF
    str x2, [x3]
    bl _kcc_sema_expr
    mov x20, x0                     // callee type
    adrp x3, _kcc_sema_callee_ctx@@PAGE
    add  x3, x3, _kcc_sema_callee_ctx@@PAGEOFF
    str xzr, [x3]

    // Type-check arguments
    ldr x21, [x19, #AST_F1]        // first arg
.Lsec_arg_loop:
    cbz x21, .Lsec_arg_done
    mov x0, x21
    bl _kcc_sema_expr
    ldr x21, [x21, #AST_F4]        // next arg
    b .Lsec_arg_loop

.Lsec_arg_done:
    // Get return type from callee type
    ldr x1, [x20, #TY_KIND]
    cmp x1, #TY_FUNC
    b.eq .Lsec_func_ret
    cmp x1, #TY_PTR
    b.eq .Lsec_ptr_func

    // Not a function type.  Unless the callee was an implicit function
    // declaration (an undeclared bare name in call position), this is an
    // error: something that is not a function is being called.
    adrp x0, _kcc_sema_callee_implicit@@PAGE
    add  x0, x0, _kcc_sema_callee_implicit@@PAGEOFF
    ldr  x0, [x0]
    cbnz x0, .Lsec_default_int
    ldr x0, [x19, #AST_LINE]
    ldr x1, [x19, #AST_COL]
    adrp x2, _kcc_sema_err_not_func@@PAGE
    add  x2, x2, _kcc_sema_err_not_func@@PAGEOFF
    bl _kcc_diag_error
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr  x0, [x0]
    b .Lsec_done

.Lsec_func_ret:
    ldr x0, [x20, #TY_F0]          // return type
    b .Lsec_done

.Lsec_ptr_func:
    // Pointer to function: dereference then get return type
    ldr x0, [x20, #TY_F0]          // pointee (should be TY_FUNC)
    ldr x1, [x0, #TY_KIND]
    cmp x1, #TY_FUNC
    b.ne .Lsec_default_int
    ldr x0, [x0, #TY_F0]           // return type
    b .Lsec_done

.Lsec_default_int:
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr  x0, [x0]

.Lsec_done:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@}

\subsection{Member Access}

Member access handles both dot (\texttt{s.m}) and arrow
(\texttt{p->m}) forms.  For arrow access the object type must be a
pointer, which is dereferenced first.  The resulting type must be
\texttt{TY\_STRUCT} or \texttt{TY\_UNION}; if not, the checker falls
back to \texttt{int}.  The lookup is factored into a shared helper,
\texttt{kcc\_type\_find\_member}, which walks the aggregate's field
chain (\texttt{AST\_F1} linked via \texttt{AST\_F4}) for a name matching
the member in \texttt{AST\_MEMBER.F1}.  When it meets a \emph{nameless}
field whose type is itself a struct or union --- an anonymous member in
the sense of C11 \S6.7.2.1 --- it recurses into that member and, on a
hit, adds the anonymous member's own byte offset to the offset returned
from within.  A member of an anonymous inner aggregate is therefore
reachable directly, as though its fields belonged to the enclosing type.
The helper returns the matching field decl together with its accumulated
byte offset; on a match the field's declared type is stored in
\texttt{AST\_F3} by the caller (the standard \texttt{.Lse\_store} path).
The IR builder calls the very same helper when lowering a member address,
so type-checking and code generation agree on both the resolved field
and its offset.

@d Sema: expr member @{
// -- kcc_type_find_member -------------------------------------------------
// (AST_FIELD_DECL, uint64_t offset) kcc_type_find_member(type *sty, char *name)
//   x0 = struct/union type, x1 = member name
// Returns x0 = matching field decl (0 if none), x1 = its byte offset within
// `sty`.  Recurses into anonymous (nameless) struct/union members and adds
// their offsets (C11 6.7.2.1), so a member of an anonymous inner aggregate is
// reachable directly.  Shared by member type-checking and the IR builder's
// member-address lowering, keeping the two in lock-step.
.text
.globl _kcc_type_find_member
.p2align 2
_kcc_type_find_member:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]
    mov x19, x0                    // struct/union type
    mov x20, x1                    // member name
    mov x0, x19
    bl _kcc_type_layout            // ensure per-field AST_F3 offsets are set
    ldr x0, [x19, #TY_F0]          // AST_STRUCT_DECL / AST_UNION_DECL
    cbz x0, .Lfm_notfound
    ldr x21, [x0, #AST_F1]         // first field
.Lfm_loop:
    cbz x21, .Lfm_notfound
    ldr x0, [x21, #AST_F1]         // field name
    cbz x0, .Lfm_anon              // nameless field: an anonymous member
    mov x1, x20
    bl _kcc_strcmp
    cbz x0, .Lfm_direct
    b .Lfm_next
.Lfm_direct:
    mov x0, x21
    ldr x1, [x21, #AST_F3]         // field byte offset
    b .Lfm_done
.Lfm_anon:
    ldr x0, [x21, #AST_F0]         // its type must be a struct/union to promote
    cbz x0, .Lfm_next
    bl _kcc_sema_resolve_type
    cbz x0, .Lfm_next
    ldr x1, [x0, #TY_KIND]
    cmp x1, #TY_STRUCT
    b.eq .Lfm_recurse
    cmp x1, #TY_UNION
    b.ne .Lfm_next
.Lfm_recurse:
    mov x1, x20
    bl _kcc_type_find_member       // x0 = inner field, x1 = inner offset; x21 kept
    cbz x0, .Lfm_next
    ldr x2, [x21, #AST_F3]         // this anonymous member's own offset
    add x1, x1, x2                 // accumulate
    b .Lfm_done
.Lfm_next:
    ldr x21, [x21, #AST_F4]        // next field
    b .Lfm_loop
.Lfm_notfound:
    mov x0, #0
    mov x1, #0
.Lfm_done:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

// -- kcc_sema_expr_member -------------------------------------------------
// type_desc *kcc_sema_expr_member(node *expr)
//   x19 = expression node (AST_MEMBER)
// F0=object, F1=name_ptr, F2=arrow(1)/dot(0)
// Returns: resolved field type (or int as fallback)
.text
.p2align 2
_kcc_sema_expr_member:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]

    // Type-check the object expression
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_expr
    mov x20, x0                     // object type

    // If arrow: dereference pointer first
    ldr x1, [x19, #AST_F2]
    cbz x1, .Lsem_dot
    // Arrow: type should be pointer to struct/union
    ldr x1, [x20, #TY_KIND]
    cmp x1, #TY_PTR
    b.ne .Lsem_fallback
    ldr x20, [x20, #TY_F0]         // dereference

.Lsem_dot:
    // Type should be struct or union
    ldr x1, [x20, #TY_KIND]
    cmp x1, #TY_STRUCT
    b.eq .Lsem_lookup
    cmp x1, #TY_UNION
    b.eq .Lsem_lookup

.Lsem_fallback:
    ldr x0, [x19, #AST_LINE]
    ldr x1, [x19, #AST_COL]
    adrp x2, _kcc_sema_err_not_struct@@PAGE
    add  x2, x2, _kcc_sema_err_not_struct@@PAGEOFF
    bl _kcc_diag_error
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr  x0, [x0]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

.Lsem_lookup:
    // Find the member, descending through anonymous members (C11 6.7.2.1).
    mov x0, x20                    // struct/union type
    ldr x1, [x19, #AST_F1]         // member name
    bl _kcc_type_find_member
    mov x21, x0                    // matching AST_FIELD_DECL (0 if none)
    cbnz x21, .Lsem_found

.Lsem_not_found:
    ldr x0, [x19, #AST_LINE]
    ldr x1, [x19, #AST_COL]
    ldr x2, [x19, #AST_F1]         // member name
    adrp x3, _kcc_sema_nomember_pre@@PAGE
    add  x3, x3, _kcc_sema_nomember_pre@@PAGEOFF
    bl _kcc_sema_err_named
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr  x0, [x0]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

.Lsem_found:
    // x21 = matching AST_FIELD_DECL
    ldr x0, [x21, #AST_F0]         // field type node
    cbz x0, .Lsem_found_int
    bl _kcc_sema_resolve_type
    mov x22, x0                    // declared field type
    // Bit-field integer promotion (\stdref{6.3.1.1}): a bit-field of width W is
    // promoted where int can represent all its values, which for a bit-field
    // narrower than int is \emph{always} --- even an unsigned one --- so
    // `unsigned f:3` yields a signed int and `(f - 2)` is a signed compare.  A
    // full-width unsigned bit-field (W == int width) stays unsigned int; wider
    // (long) bit-fields keep their declared type.  W is the low 16 bits of the
    // field's packed AST_F2 (0 for a non-bit-field member).
    ldr x1, [x21, #AST_F2]
    and x1, x1, #0xFFFF            // bit-field width
    cbz x1, .Lsem_found_ret
    cbz x22, .Lsem_found_ret
    ldr x2, [x22, #TY_KIND]
    sub x3, x2, #2
    cmp x3, #5                     // integer kind (TY_BOOL(2)..TY_LLONG(7))?
    b.hi .Lsem_found_ret
    ldr x2, [x22, #TY_F0]          // signedness (1 = signed, 0 = unsigned)
    cbz x2, .Lsem_bf_unsigned
    cmp x1, #32                    // signed: W<=32 → int, else declared
    b.hi .Lsem_found_ret
    b .Lsem_bf_int
.Lsem_bf_unsigned:
    cmp x1, #31
    b.ls .Lsem_bf_int             // unsigned W<=31 → int (int holds all values)
    cmp x1, #32
    b.hi .Lsem_found_ret          // unsigned W>32 → keep declared (unsigned long)
    adrp x0, _kcc_type_int_u@@PAGE // unsigned W==32 → unsigned int
    add  x0, x0, _kcc_type_int_u@@PAGEOFF
    ldr  x0, [x0]
    b .Lsem_found_pret
.Lsem_bf_int:
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr  x0, [x0]
    b .Lsem_found_pret
.Lsem_found_ret:
    mov x0, x22
.Lsem_found_pret:
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

.Lsem_found_int:
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr  x0, [x0]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_type_find_member _kcc_sema_expr_member
@}

\subsection{Cast Expression}

A cast expression resolves its target type from the AST type node,
type-checks the inner expression, and returns the target type as the
result.  No conversion code is emitted at this stage; the IR builder
handles actual truncation and extension.

@d Sema: expr cast @{
// -- kcc_sema_expr_cast ---------------------------------------------------
// type_desc *kcc_sema_expr_cast(node *expr)
//   x19 = expression node
// F0=type, F1=expr
.text
.p2align 2
_kcc_sema_expr_cast:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    // Resolve cast target type
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_resolve_type
    mov x20, x0                     // target type

    // Type-check the expression being cast
    ldr x0, [x19, #AST_F1]
    bl _kcc_sema_expr

    // Result is the target type
    mov x0, x20

    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@}

\subsection{Sizeof Expression}

The \texttt{sizeof} operator can take either a type or an expression
as its operand (distinguished by the \texttt{AST\_F1} flag).  If the
operand is an expression, it is type-checked (though its value is not
evaluated at run time).  In both cases the result type is
\texttt{unsigned long}, which is \texttt{size\_t} on ARM64.

One subtlety deserves care: \stdref{6.3.2.1} says an array is \emph{not}
converted to a pointer when it is the operand of \texttt{sizeof}, so
\texttt{sizeof(arr)} must be the whole array and not a pointer.
\texttt{\_kcc\_sema\_expr} has already decayed the operand to a pointer in
its \texttt{AST\_F3}, so we undo that for two array-valued operand shapes
by pinning the un-decayed array type back onto the operand node (which is
what the IR builder and constant folder read).  A named array is looked up
in the symbol table and its \texttt{TY\_ARRAY} type restored.  A
\emph{string literal} is an array \texttt{char[N+1]} (\stdref{6.4.5}) even
though we type it as \texttt{char~*} everywhere else for convenient decay;
here we rebuild \texttt{char[len+1]} from its recorded length so that
\texttt{sizeof("...")} is the array size, not~8.  Without this,
\texttt{sizeof(literal)/-1} length idioms---\texttt{luaS\_newliteral} among
them---silently truncated every string to the pointer size, corrupting
memory downstream.

@d Sema: expr sizeof @{
// -- kcc_sema_expr_sizeof -------------------------------------------------
// type_desc *kcc_sema_expr_sizeof(node *expr)
//   x19 = expression node
// F0=operand (type node or expr), F1=is_type
// Result type is always unsigned long (size_t on ARM64).
.text
.p2align 2
_kcc_sema_expr_sizeof:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    // Check if operand is a type or expression
    ldr x1, [x19, #AST_F1]         // is_type flag
    cbnz x1, .Lses_type

    // Expression operand: type-check it
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_expr

    // sizeof does not decay arrays (§6.3.2.1): if the operand names an
    // array, restore its array type so the size is the whole array, not a
    // pointer.  sema_expr already decayed it to a pointer in AST_F3.  The
    // operand is the node whose AST_F3 the IR builder reads; the name may
    // sit under one or more parentheses, so descend to the inner expression.
    ldr x20, [x19, #AST_F0]        // operand node (IR builder reads its AST_F3)
    mov x1, x20
.Lses_unwrap:
    ldr x0, [x1, #AST_TAG]
    cmp x0, #AST_PAREN_EXPR
    b.ne .Lses_inner
    ldr x1, [x1, #AST_F0]
    cbnz x1, .Lses_unwrap
    b .Lses_result
.Lses_inner:
    cmp x0, #AST_STR_LIT
    b.eq .Lses_strlit
    cmp x0, #AST_IDENT_EXPR
    b.ne .Lses_result
    ldr x21, [x1, #AST_F0]         // name ptr
    cbz x21, .Lses_result
    mov x0, x21
    bl _kcc_strlen
    mov x1, x0
    mov x0, x21
    bl _kcc_symtab_lookup
    cbz x0, .Lses_result
    ldr x0, [x0, #SYM_TYPE]
    cbz x0, .Lses_result
    ldr x1, [x0, #TY_KIND]
    cmp x1, #TY_ARRAY
    b.ne .Lses_result
    str x0, [x20, #AST_F3]         // set the un-decayed array type on the operand
    b .Lses_result

.Lses_strlit:
    // A string literal is an array char[N+1] (§6.4.5); sema_expr already
    // decayed it to char* in AST_F3, but sizeof must see the whole array.
    // Rebuild char[len+1] from the recorded length and pin it on the operand.
    ldr x21, [x1, #AST_F1]         // string length N
    add x21, x21, #1              // + terminating NUL
    adrp x0, _kcc_type_char_s@@PAGE
    add  x0, x0, _kcc_type_char_s@@PAGEOFF
    ldr  x0, [x0]                  // element type char
    mov  x1, x21
    bl _kcc_type_array             // → char[N+1]
    str x0, [x20, #AST_F3]         // un-decayed array type on the operand
    b .Lses_result

.Lses_type:
    // Type operand: resolve it (for validation)
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_resolve_type

.Lses_result:
    // sizeof always returns unsigned long (size_t)
    adrp x0, _kcc_type_long_u@@PAGE
    add  x0, x0, _kcc_type_long_u@@PAGEOFF
    ldr  x0, [x0]
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@}

