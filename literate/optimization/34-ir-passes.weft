% 34-ir-passes.weft — Optimization Pass Manager
%
% Runs constant folding and dead code elimination in a loop
% until no more changes occur (fixed-point iteration).

\chapter{Optimization Passes}
\label{ch:ir-passes}

Generating correct IR is necessary, but the initial translation from AST to IR often leaves redundancy---constant expressions that could be evaluated at compile time, subexpressions and loads computed more than once, and instructions whose results are never consumed.  This chapter provides the pass manager that drives optimization.  It iterates over every IR function and runs the available passes---constant folding, strength reduction, common subexpression elimination, copy/constant propagation, and dead code elimination---in a loop until no further changes occur, achieving a fixed-point result.  Running them together matters: folding a cast can expose a common subexpression, strength-reducing a multiply into a shift can expose a fresh constant, forwarding a stored value to a load can leave that load dead, eliminating a subexpression can leave another load dead, and each pass feeds the next until the IR settles.  Every pass is a pure IR-to-IR transform, so it lives above the code generator and a second target inherits all of them unchanged.

\section{Pass Manager}

The pass manager runs optimization passes over each IR function until a
fixed point is reached---that is, until no pass reports any changes.  Each
pass is a function that takes an IR function pointer and returns non-zero
if it modified something.  The outer loop iterates all functions in the
module; the inner loop repeats the pass sequence until stable.

@d Opt: pass manager @{
// -- kcc_opt_run ----------------------------------------------------------
// void kcc_opt_run(void)
// Runs optimization passes on all IR functions until stable.
.text
.globl _kcc_opt_run
.p2align 2
_kcc_opt_run:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]

    // Load function list
    adrp x0, _kcc_ir_funcs@@PAGE
    add  x0, x0, _kcc_ir_funcs@@PAGEOFF
    ldr x19, [x0]
    cbz x19, .Lpr_done

    ldr x20, [x19, #VEC_COUNT]
    mov x21, #0

.Lpr_func_loop:
    cmp x21, x20
    b.ge .Lpr_done

    mov x0, x19
    mov x1, x21
    bl _kcc_vec_get
    ldr x22, [x0]               // func ptr

    // Run passes on this function
    mov x0, x22
    bl _kcc_opt_run_func

    add x21, x21, #1
    b .Lpr_func_loop

.Lpr_done:
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_opt_run
@}

\section{Per-Function Iteration}

The per-function driver calls each registered pass and tracks whether any
modification occurred.  When a pass fires, the \texttt{changed} flag resets
the fixed-point loop so all passes run again on the modified IR.

@d Opt: pass manager @{
// -- kcc_opt_run_func -----------------------------------------------------
// void kcc_opt_run_func(ir_func *func)
// Iterates constfold + cse + dce until no changes.
.text
.globl _kcc_opt_run_func
.p2align 2
_kcc_opt_run_func:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    mov x19, x0                 // func
    mov x20, #0                 // iteration counter (safety limit)

.Lprf_loop:
    cmp x20, #10                // max 10 iterations
    b.ge .Lprf_done

    // Run constant folding
    mov x0, x19
    bl _kcc_opt_constfold
    mov x1, x0                  // fold count

    // Strength reduction / algebraic simplification (mul/div/mod by a power
    // of two -> shift/mask).  Runs after folding so a constant operand it
    // relies on is already materialised, and before CSE/DCE so the shift it
    // introduces is available for their bookkeeping.
    mov x0, x19
    bl _kcc_opt_strength
    add x1, x1, x0              // + strength count

    // Run common subexpression elimination
    mov x0, x19
    bl _kcc_opt_cse
    add x1, x1, x0              // + cse count

    // Copy / constant propagation (store-to-load forwarding); DCE below then
    // sweeps the loads it makes dead.
    mov x0, x19
    bl _kcc_opt_copyprop
    add x1, x1, x0             // + copyprop count

    // Run DCE
    mov x0, x19
    bl _kcc_opt_dce
    add x0, x0, x1              // total changes

    // If no changes, we're done
    cbz x0, .Lprf_done

    add x20, x20, #1
    b .Lprf_loop

.Lprf_done:
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_opt_run_func
@}
