void kcc_codegen_all(void);
void kcc_codegen_emit_strings(void);
int kcc_as_render(const char *path);
int kcc_x86_render(const char *path);
void kcc_dwarf_build(void);
void kcc_macho_init(const char *out);
void kcc_macho_finalize(void);
void kcc_pp_add_include_dir(const char *dir);
void kcc_pp_add_cmdline_define(const char *def);

long kcc_sys_fork(void);
long kcc_sys_execve(const char *path, char *const argv[], char *const envp[]);
long kcc_sys_wait4(long pid, int *status, long options, void *rusage);
long kcc_sys_open(const char *path, long flags, long mode);
long kcc_sys_close(long fd);
long kcc_sys_write(long fd, const void *buf, long len);
long kcc_sys_unlink(const char *path);
void kcc_sys_exit(int status);

extern void *kcc_src_base;
extern unsigned long kcc_src_size;
extern unsigned long kcc_target;
extern unsigned long kcc_x86_os;
extern const char *kcc_dep_out;                  /* .d output path for -MD/-Wp,-MMD */
void kcc_dep_reset(void);
void kcc_dep_write(const char *obj, const char *src);
extern void *kcc_x86_tu;
extern unsigned long kcc_warn_all;
extern unsigned long kcc_dwarf_enabled;

void *kcc_envp = 0;
unsigned long kcc_emit_asm = 0;
unsigned long kcc_host_linux = 0;    /* set to 1 by the Linux _start (os_linux) */

static const char OPT_O[] = "-o";
static const char OPT_COMPILE[] = "-c";
static const char OPT_WALL[] = "-Wall";
static const char OPT_G[] = "-g";
static const char OPT_EMITASM[] = "--emit-asm";
static const char OPT_TARGET_X86[] = "--target=x86_64";
static const char OPT_TARGET_LINUX[] = "--target=x86_64-linux";
static const char STR_X86_64[] = "x86_64";
static const char STR_AS_ARGV0[] = "as";
static const char STR_AS_PATH[] = "/usr/bin/as";
static const char STR_DOT_S[] = ".s";
static const char STR_ARCH[] = "-arch";
static const char STR_LD_ARGV0[] = "ld";
static const char STR_LD_PATH[] = "/usr/bin/ld";
static const char STR_LSYSTEM[] = "-lSystem";
static const char STR_SYSLIBROOT[] = "-syslibroot";
static const char STR_ARM64[] = "arm64";
static const char STR_DASH_E[] = "-e";
static const char STR_UMAIN[] = "_main";
static const char STR_AS_64[] = "--64";          /* ELF: assemble 64-bit */
static const char STR_STATIC[] = "-static";       /* ELF: static, no dynamic loader */
static const char STR_NOSTDLIB[] = "-nostdlib";   /* ELF: no libc; kcc supplies the runtime */
static const char STR_USTART[] = "_start";        /* ELF entry point */
static const char STR_DOT_O[] = ".o";
static const char STR_AOUT[] = "a.out";
static const char STR_SDKROOT_ENV[] = "SDKROOT";
static const char STR_SDK_CLT[] =
    "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk";
static const char STR_SDK_XCODE[] =
    "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk";
static const char ERR_NOINPUT[] = "kcc: error: no input files\n";

/* The Linux runtime kcc emits and assembles at link time so that a -nostdlib
   static executable has an entry point and syscall stubs.  It mirrors the
   hand-written os_linux.s that kcc itself is built from --- the same syscall
   numbers and the same macOS-to-Linux flag/argument translations --- minus the
   kcc-internal kcc_host_linux hook, so it links against any freestanding TU. */
static const char STR_RT_S[] = "kcc_rt.s";
static const char STR_RT_O[] = "kcc_rt.o";
static const char STR_RUNTIME[] =
    ".set SYS_read,0\n.set SYS_write,1\n.set SYS_open,2\n.set SYS_close,3\n"
    ".set SYS_lseek,8\n.set SYS_mmap,9\n.set SYS_munmap,11\n.set SYS_fork,57\n"
    ".set SYS_execve,59\n.set SYS_exit,60\n.set SYS_wait4,61\n.set SYS_unlink,87\n"
    "\t.comm kcc_host_linux,8,8\n"    /* merges with the kcc that links us, if any */
    "\t.text\n\t.globl _start\n_start:\n"
    "\tleaq __init_array_start(%rip), %rbx\n"
    "\tleaq __init_array_end(%rip), %rbp\n"
    ".Linit_loop:\n\tcmpq %rbp, %rbx\n\tjae .Linit_done\n"
    "\tcall *(%rbx)\n\taddq $8, %rbx\n\tjmp .Linit_loop\n.Linit_done:\n"
    "\tmovq $1, kcc_host_linux(%rip)\n"   /* a kcc we build can itself drive as/ld */
    "\tmovq (%rsp), %rdi\n\tleaq 8(%rsp), %rsi\n\tleaq 16(%rsp,%rdi,8), %rdx\n"
    "\tcall main\n\tmovq %rax, %rdi\n\tmovq $SYS_exit, %rax\n\tsyscall\n\thlt\n"
    "\t.globl kcc_sys_exit\nkcc_sys_exit:\n\tmovq $SYS_exit, %rax\n\tsyscall\n\thlt\n"
    "\t.globl kcc_sys_fork\nkcc_sys_fork:\n\tmovq $SYS_fork, %rax\n\tsyscall\n\tret\n"
    "\t.globl kcc_sys_execve\nkcc_sys_execve:\n\tmovq $SYS_execve, %rax\n\tsyscall\n\tret\n"
    "\t.globl kcc_sys_wait4\nkcc_sys_wait4:\n\tmovq %rcx, %r10\n\tmovq $SYS_wait4, %rax\n\tsyscall\n\tret\n"
    "\t.globl kcc_sys_read\nkcc_sys_read:\n\tmovq $SYS_read, %rax\n\tsyscall\n\tret\n"
    "\t.globl kcc_sys_write\nkcc_sys_write:\n\tmovq $SYS_write, %rax\n\tsyscall\n\tret\n"
    "\t.globl kcc_sys_open\nkcc_sys_open:\n\tmovq %rsi, %r11\n\tandq $3, %rsi\n"
    "\ttestq $0x200, %r11\n\tjz 1f\n\torq $0x40, %rsi\n"
    "1:\ttestq $0x400, %r11\n\tjz 2f\n\torq $0x200, %rsi\n"
    "2:\tmovq $SYS_open, %rax\n\tsyscall\n\tret\n"
    "\t.globl kcc_sys_close\nkcc_sys_close:\n\tmovq $SYS_close, %rax\n\tsyscall\n\tret\n"
    "\t.globl kcc_sys_lseek\nkcc_sys_lseek:\n\tmovq $SYS_lseek, %rax\n\tsyscall\n\tret\n"
    "\t.globl kcc_sys_unlink\nkcc_sys_unlink:\n\tmovq $SYS_unlink, %rax\n\tsyscall\n\tret\n"
    "\t.globl kcc_sys_mmap\nkcc_sys_mmap:\n\ttestq $0x1000, %rcx\n\tjz .Lmmap_go\n"
    "\tbtrq $12, %rcx\n\torq $0x20, %rcx\n.Lmmap_go:\n\tmovq %rcx, %r10\n"
    "\tmovq $SYS_mmap, %rax\n\tsyscall\n\tret\n"
    "\t.globl kcc_sys_munmap\nkcc_sys_munmap:\n\tmovq $SYS_munmap, %rax\n\tsyscall\n\tret\n"
    "\t.section .note.GNU-stack,\"\",@@progbits\n";

char *kcc_getenv(const char *name, unsigned long namelen);
int kcc_driver_x86_object(const char *out);
int kcc_driver_emit_asm_object(const char *out);
int kcc_driver_spawn(const char *path, char *const argv[]);
char *kcc_driver_obj_name(const char *src);
unsigned long kcc_driver_I(const char *arg, const char *next, unsigned long reg);
unsigned long kcc_driver_D(const char *arg, const char *next, unsigned long reg);
@}

@l c
@d Selfhost: driver compile @{
/* gcc `-include FILE` force-includes, collected from the command line (pass 1)
   and applied to every translation unit before parsing. */
#define KCC_MAX_FORCE_INC 32
static const char *kcc_force_inc[KCC_MAX_FORCE_INC];
static long kcc_force_inc_n = 0;

int kcc_driver_compile(const char *src, const char *out) {
    kcc_dep_reset();
    kcc_source_open(src);
    kcc_source_encode();
    kcc_source_splice();
    kcc_lex_init(kcc_src_base, kcc_src_size);
    kcc_pp_init();
    /* Force-includes are pushed in reverse so the preprocessor reads them back
       in command-line order, ahead of the primary source. */
    for (long k = kcc_force_inc_n - 1; k >= 0; k--)
        kcc_pp_force_include(kcc_force_inc[k]);
    kcc_strtab_init();
    kcc_typedef_init();
    void *tu = kcc_parse();
    kcc_types_init();
    kcc_symtab_init();
    kcc_sema_check(tu);
    if (kcc_diag_had_errors()) { kcc_io_flush(); return 1; }
    kcc_ir_init();
    kcc_ir_build(tu);
    kcc_opt_run();
    if (kcc_ir_validate()) { kcc_io_flush(); return 1; }
    if (kcc_target) {
        kcc_x86_tu = tu;
        int r = kcc_driver_x86_object(out);
        if (r == 0) kcc_dep_write(out, src);      /* -MD: emit the dependency file */
        return r;
    }
    kcc_code_init();
    kcc_linker_init();
    kcc_codegen_init();
    kcc_preregister_globals(tu);
    kcc_codegen_all();
    kcc_codegen_emit_strings();
    if (kcc_emit_asm) return kcc_driver_emit_asm_object(out);
    char *side = kcc_getenv("KCC_EMIT_ASM", 12);
    if (side) kcc_as_render(side);
    kcc_dwarf_build();
    kcc_macho_init(out);
    kcc_macho_finalize();
    return 0;
}

/* Build "<out>.s", render to it, then assemble to <out>. */
int kcc_driver_emit_asm_object(const char *out) {
    unsigned long len = kcc_strlen(out);
    char *outs = (char *)kcc_arena_alloc((long)(len + 3));
    kcc_memcpy(outs, out, len);
    kcc_memcpy(outs + len, STR_DOT_S, 3);
    if (kcc_as_render(outs)) return 1;
    char *av[5];
    av[0] = (char *)STR_AS_ARGV0;
    av[1] = (char *)OPT_O;
    av[2] = (char *)out;
    av[3] = outs;
    av[4] = 0;
    if (kcc_driver_spawn(STR_AS_PATH, av)) return 1;
    return 0;
}

int kcc_driver_x86_object(const char *out) {
    if (kcc_x86_os && !kcc_host_linux) {  /* macOS host, Linux target: can only emit .s */
        kcc_x86_render(out);
        return 0;
    }
    unsigned long len = kcc_strlen(out);
    char *outs = (char *)kcc_arena_alloc((long)(len + 3));
    kcc_memcpy(outs, out, len);
    kcc_memcpy(outs + len, STR_DOT_S, 3);
    if (kcc_x86_render(outs)) return 1;
    char *av[7];
    long k = 0;
    av[k++] = (char *)STR_AS_ARGV0;
    if (kcc_host_linux) {                 /* ELF assembler: as --64 */
        av[k++] = (char *)STR_AS_64;
    } else {                              /* Darwin assembler: as -arch x86_64 */
        av[k++] = (char *)STR_ARCH;
        av[k++] = (char *)STR_X86_64;
    }
    av[k++] = (char *)OPT_O;
    av[k++] = (char *)out;
    av[k++] = outs;
    av[k] = 0;
    if (kcc_driver_spawn(STR_AS_PATH, av)) return 1;
    return 0;
}
@}

\section{Argument Helpers and Object Naming}

\texttt{driver\_I} and \texttt{driver\_D} each recognise their option in the
attached (\texttt{-Idir}) or separated (\texttt{-I dir}) shape and return how
many argument slots it occupies, optionally registering the directory or macro;
this lets every argument loop step over them uniformly.  \texttt{obj\_name}
rewrites a \texttt{.c} suffix to \texttt{.o}, or appends \texttt{.o}.

@l c
@d Selfhost: driver args @{
unsigned long kcc_driver_I(const char *arg, const char *next, unsigned long reg) {
    if (kcc_memcmp(arg, "-I", 2) != 0) return 0;
    if (arg[2] == 0) {                    /* separated "-I dir" */
        if (reg && next) kcc_pp_add_include_dir(next);
        return 2;
    }
    if (reg) kcc_pp_add_include_dir(arg + 2);  /* attached "-Idir" */
    return 1;
}

unsigned long kcc_driver_D(const char *arg, const char *next, unsigned long reg) {
    if (kcc_memcmp(arg, "-D", 2) != 0) return 0;
    if (arg[2] == 0) {                    /* separated "-D NAME" */
        if (reg && next) kcc_pp_add_cmdline_define(next);
        return 2;
    }
    if (reg) kcc_pp_add_cmdline_define(arg + 2);
    return 1;
}

char *kcc_driver_obj_name(const char *src) {
    unsigned long len = kcc_strlen(src);
    char *dst = (char *)kcc_arena_alloc((long)(len + 3));
    kcc_memcpy(dst, src, len);
    if (len >= 2 && src[len - 2] == '.' && src[len - 1] == 'c') {
        dst[len - 1] = 'o';
        dst[len] = 0;
    } else {
        dst[len] = '.';
        dst[len + 1] = 'o';
        dst[len + 2] = 0;
    }
    return dst;
}
@}

\section{Compiling Several Files}

\texttt{compile\_all} handles \texttt{-c}: a first pass sets the flags
(\texttt{-Wall}, \texttt{-g}, \texttt{--emit-asm}, \texttt{--target}), registers
include dirs and macros, and finds an explicit \texttt{-o} and the source count;
a second pass compiles each source, honouring \texttt{-o} only for a single
input.  It exits with the combined status.

Both passes scan from \texttt{argv[1]} and are \emph{gcc-compatible enough to be
a drop-in \texttt{CC=}} for a real Kbuild command line, which leads with dozens
of \texttt{-f}/\texttt{-W}/\texttt{-m}/\texttt{-O} flags and ends with
\texttt{-c -o out.o in.c}: \texttt{-c} is skipped wherever it sits, the two-word
options a kernel build uses (\texttt{-isystem dir}, \texttt{-include file},
\texttt{-MF}, \texttt{-x}, \ldots) consume their second word, and every other
dash-led token is an option kcc ignores.  \texttt{-include FILE} is not merely
skipped: pass~1 collects each such \texttt{FILE}, and every translation unit is
then force-included with them (through \texttt{kcc\_pp\_force\_include}) before
its own text---the mechanism Kbuild uses to inject \texttt{kconfig.h} and
\texttt{compiler\_types.h}, and thus the \texttt{CONFIG\_*} macros, ahead of each
kernel object.  Dependency generation is honoured too:
on \texttt{-MD}/\texttt{-MMD} or the comma-joined \texttt{-Wp,-M[M]D,file} the
driver records the \texttt{.d} path and, after a successful compile, writes the
Makefile fragment (\texttt{obj: src headers\ldots}) that Kbuild's \texttt{fixdep}
consumes; the preprocessor supplies the include list.  \texttt{kcc\_dep\_out}
stays null otherwise, so an ordinary compile writes no \texttt{.d}.

@l c
@d Selfhost: driver compile-all @{
/* Some gcc options take a separate second word (a path or name) that must be
   skipped along with the option so it is not mistaken for a source file.  These
   are the ones a Kbuild command line actually uses. */
static int kcc_driver_two_arg_opt(const char *a) {
    return kcc_strcmp(a, "-isystem") == 0 || kcc_strcmp(a, "-include") == 0 ||
           kcc_strcmp(a, "-idirafter") == 0 || kcc_strcmp(a, "-imacros") == 0 ||
           kcc_strcmp(a, "-iquote") == 0 || kcc_strcmp(a, "-x") == 0 ||
           kcc_strcmp(a, "-MT") == 0 || kcc_strcmp(a, "-MF") == 0 ||
           kcc_strcmp(a, "-MQ") == 0 || kcc_strcmp(a, "-aux-info") == 0 ||
           kcc_strcmp(a, "-MD") == 0 || kcc_strcmp(a, "-MMD") == 0;
}

/* Recognise the dependency-file options and record the .d path.  Kbuild uses the
   comma-joined `-Wp,-MMD,<file>`; the standalone `-MD <file>`/`-MMD <file>` take
   the next word.  Returns the number of argv slots consumed (0 if not a dep opt). */
static int kcc_str_startswith(const char *s, const char *pre) {
    while (*pre) { if (*s++ != *pre++) return 0; }
    return 1;
}
static unsigned long kcc_dep_from_arg(const char *a, const char *next) {
    if (kcc_str_startswith(a, "-Wp,-MMD,")) { kcc_dep_out = a + 9; return 1; }
    if (kcc_str_startswith(a, "-Wp,-MD,"))  { kcc_dep_out = a + 8; return 1; }
    if (kcc_strcmp(a, "-MD") == 0 || kcc_strcmp(a, "-MMD") == 0) {
        if (next) { kcc_dep_out = next; return 2; }
        return 1;
    }
    return 0;
}

void kcc_driver_compile_all(long argc, char **argv) {
    const char *explicit_out = 0;
    long src_count = 0;
    /* Pass 1: register -I/-D, capture -o, count sources.  Scan from argv[1] and
       treat every other dash-led token as an option kcc ignores---the driver is
       gcc-compatible enough for Kbuild, which leads with dozens of -f/-W/-m/-O
       flags and ends with `-c -o out.o in.c`. */
    for (long i = 1; i < argc; ) {
        char *a = argv[i];
        if (kcc_strcmp(a, OPT_COMPILE) == 0) { i++; continue; }
        if (kcc_strcmp(a, OPT_WALL) == 0) { kcc_warn_all = 1; i++; continue; }
        if (kcc_strcmp(a, OPT_EMITASM) == 0) { kcc_emit_asm = 1; i++; continue; }
        if (kcc_strcmp(a, OPT_TARGET_X86) == 0) { kcc_target = 1; i++; continue; }
        if (kcc_strcmp(a, OPT_TARGET_LINUX) == 0) {
            kcc_target = 1; kcc_x86_os = 1; i++; continue;
        }
        if (kcc_strcmp(a, OPT_G) == 0) { kcc_dwarf_enabled = 1; i++; continue; }
        if (kcc_strcmp(a, OPT_O) == 0) {
            i++;
            if (i >= argc) break;
            explicit_out = argv[i]; i++; continue;
        }
        const char *next = (i + 1 < argc) ? argv[i + 1] : 0;
        unsigned long n = kcc_driver_I(a, next, 1);
        if (n) { i += (long)n; continue; }
        n = kcc_driver_D(a, next, 1);
        if (n) { i += (long)n; continue; }
        { unsigned long nd = kcc_dep_from_arg(a, next); if (nd) { i += (long)nd; continue; } }
        if (kcc_strcmp(a, "-include") == 0) {      /* gcc -include FILE: force-include it */
            if (next && kcc_force_inc_n < KCC_MAX_FORCE_INC)
                kcc_force_inc[kcc_force_inc_n++] = next;
            i += 2; continue;
        }
        if (kcc_driver_two_arg_opt(a)) { i += 2; continue; }
        if (a[0] == '-') { i++; continue; }       /* any other flag: ignore */
        src_count++; i++;
    }
    if (src_count == 0) { kcc_io_err(ERR_NOINPUT); kcc_sys_exit(1); }

    long err = 0;
    for (long i = 1; i < argc; ) {
        char *a = argv[i];
        if (kcc_strcmp(a, OPT_O) == 0) { i += 2; continue; }
        unsigned long n = kcc_driver_I(a, 0, 0);
        if (n) { i += (long)n; continue; }
        n = kcc_driver_D(a, 0, 0);
        if (n) { i += (long)n; continue; }
        if (kcc_driver_two_arg_opt(a)) { i += 2; continue; }
        if (a[0] == '-') { i++; continue; }       /* every option: handled above */
        const char *out;
        if (src_count == 1 && explicit_out) out = explicit_out;
        else out = kcc_driver_obj_name(a);
        err |= kcc_driver_compile(a, out);
        i++;
    }
    kcc_io_flush();
    kcc_sys_exit((int)err);
}
@}

\section{Environment, SDK, and Spawning}

\texttt{getenv} scans the captured environment; \texttt{dir\_exists} probes a
path by opening it; \texttt{sdkroot} finds the macOS SDK (from \texttt{\$SDKROOT}
or the two standard locations) for \texttt{ld -syslibroot}; and \texttt{spawn}
forks, execs the child, and returns its exit status.

@l c
@d Selfhost: driver spawn @{
char *kcc_getenv(const char *name, unsigned long namelen) {
    char **envp = (char **)kcc_envp;
    if (envp == 0) return 0;
    for (; *envp; envp++) {
        char *e = *envp;
        if (kcc_memcmp(e, name, namelen) == 0 && e[namelen] == '=')
            return e + namelen + 1;
    }
    return 0;
}

int kcc_dir_exists(const char *path) {
    long fd = kcc_sys_open(path, 0, 0);
    if (fd < 0) return 0;
    kcc_sys_close(fd);
    return 1;
}

char *kcc_driver_sdkroot(void) {
    char *p = kcc_getenv(STR_SDKROOT_ENV, 7);
    if (p && kcc_dir_exists(p)) return p;
    if (kcc_dir_exists(STR_SDK_CLT)) return (char *)STR_SDK_CLT;
    if (kcc_dir_exists(STR_SDK_XCODE)) return (char *)STR_SDK_XCODE;
    return (char *)STR_SDK_CLT;
}

int kcc_driver_spawn(const char *path, char *const argv[]) {
    long pid = kcc_sys_fork();
    if (pid == 0) {
        kcc_sys_execve(path, argv, (char *const *)kcc_envp);
        kcc_sys_exit(127);
    }
    if (pid < 0) return -1;
    int status = 0;
    kcc_sys_wait4(pid, &status, 0, 0);
    return (status >> 8) & 0xff;
}
@}

\section{Automatic Linking}

\texttt{link\_all} is the no-\texttt{-c} path: a first pass sets the flags---and,
like \texttt{compile\_all}, collects the \texttt{-include} force-includes and
consumes the two-word options (\texttt{-isystem}, \texttt{-MF}, \texttt{-x},
\ldots) and the \texttt{-Wp,-M[M]D} dependency flag so they reach the compile
step rather than leaking to the linker.  It then scans the arguments building the
linker command line---compiling each \texttt{.c} to a temporary object (tracked
for removal), forwarding an unknown \texttt{-flag} verbatim, and handing any
other file (a \texttt{.o}, an archive) straight to \texttt{ld}.  Collecting
\texttt{-include} here matters because Kbuild compiles its generated
\texttt{.s} prepare-stage files with \texttt{-S} (no \texttt{-c}), which routes
through this path.  On a Darwin host it appends the system link line
(\texttt{-o out -lSystem -syslibroot <sdk> -arch <arch> -e \_main}).  On a Linux
host (\texttt{kcc\_host\_linux}, set by \texttt{os\_linux}'s \texttt{\_start}) it
instead emits and assembles the embedded runtime to a temporary object and links
statically with no libc (\texttt{-static -nostdlib -o out <objs> kcc\_rt.o -e
\_start}); this is what lets \kcc{} produce a running executable from source in a
single command on Linux.  It then runs \texttt{ld}, removes the temporary
objects, and exits with the linker's status.

@l c
@d Selfhost: driver link @{
static int kcc_driver_write_runtime(const char *path) {
    long fd = kcc_sys_open(path, 0x601, 0x1a4);   /* O_WRONLY|O_CREAT|O_TRUNC, 0644 */
    if (fd < 0) return 1;
    long n = (long)kcc_strlen(STR_RUNTIME);
    int ok = (kcc_sys_write(fd, STR_RUNTIME, n) == n);
    kcc_sys_close(fd);
    return ok ? 0 : 1;
}
void kcc_driver_link_all(long argc, char **argv) {
    /* Pass 1: honour flags wherever they appear. */
    for (long i = 1; i < argc; ) {
        char *a = argv[i];
        if (kcc_strcmp(a, OPT_WALL) == 0) { kcc_warn_all = 1; i++; continue; }
        if (kcc_strcmp(a, OPT_EMITASM) == 0) { kcc_emit_asm = 1; i++; continue; }
        if (kcc_strcmp(a, OPT_TARGET_X86) == 0) { kcc_target = 1; i++; continue; }
        if (kcc_strcmp(a, OPT_TARGET_LINUX) == 0) { kcc_target = 1; kcc_x86_os = 1; i++; continue; }
        if (kcc_strcmp(a, OPT_G) == 0) { kcc_dwarf_enabled = 1; i++; continue; }
        const char *next = (i + 1 < argc) ? argv[i + 1] : 0;
        unsigned long n = kcc_driver_I(a, next, 1);
        if (n) { i += (long)n; continue; }
        n = kcc_driver_D(a, next, 1);
        if (n) { i += (long)n; continue; }
        { unsigned long nd = kcc_dep_from_arg(a, next); if (nd) { i += (long)nd; continue; } }
        if (kcc_strcmp(a, "-include") == 0) {      /* gcc -include FILE: force-include it */
            if (next && kcc_force_inc_n < KCC_MAX_FORCE_INC)
                kcc_force_inc[kcc_force_inc_n++] = next;
            i += 2; continue;
        }
        if (kcc_driver_two_arg_opt(a)) { i += 2; continue; }
        i++;
    }

    char **larg = (char **)kcc_arena_alloc((long)((argc + 12) * 8));
    char **tmpobj = (char **)kcc_arena_alloc((long)((argc + 1) * 8));
    long tmpcount = 0;

    larg[0] = (char *)STR_LD_ARGV0;
    long k = 1;                            /* next larg slot */
    const char *out = 0;
    long err = 0;
    long inputs = 0;

    for (long i = 1; i < argc; ) {
        char *a = argv[i];
        if (kcc_strcmp(a, OPT_O) == 0) {
            i++;
            if (i >= argc) break;
            out = argv[i]; i++; continue;
        }
        if (kcc_strcmp(a, OPT_WALL) == 0 || kcc_strcmp(a, OPT_G) == 0 ||
            kcc_strcmp(a, OPT_EMITASM) == 0 ||
            kcc_strcmp(a, OPT_TARGET_X86) == 0 ||
            kcc_strcmp(a, OPT_TARGET_LINUX) == 0) { i++; continue; }
        unsigned long n = kcc_driver_I(a, 0, 0);
        if (n) { i += (long)n; continue; }
        n = kcc_driver_D(a, 0, 0);
        if (n) { i += (long)n; continue; }
        { unsigned long nd = kcc_dep_from_arg(a, 0); if (nd) { i += (long)nd; continue; } }
        if (kcc_strcmp(a, "-include") == 0) { i += 2; continue; }  /* consumed in pass 1 */
        if (kcc_driver_two_arg_opt(a)) { i += 2; continue; }
        /* Classify a non-option argument. */
        if (a[0] == '-') {                 /* unknown linker flag: forward */
            larg[k++] = a; i++; continue;
        }
        unsigned long al = kcc_strlen(a);
        if (al >= 2 && a[al - 2] == '.' && a[al - 1] == 'c') {
            char *obj = kcc_driver_obj_name(a);
            larg[k++] = obj;
            tmpobj[tmpcount++] = obj;
            err |= kcc_driver_compile(a, obj);
            inputs++; i++;
        } else {                           /* .o / .a / other: linker input */
            larg[k++] = a;
            inputs++; i++;
        }
    }

    if (err) { kcc_io_flush(); kcc_sys_exit(1); }
    if (inputs == 0) { kcc_io_err(ERR_NOINPUT); kcc_sys_exit(1); }

    if (out == 0) out = STR_AOUT;
    if (kcc_x86_os && kcc_host_linux) {   /* Linux host: static, no libc, embedded runtime */
        if (kcc_driver_write_runtime(STR_RT_S)) { kcc_io_flush(); kcc_sys_exit(1); }
        char *rav[6];
        rav[0] = (char *)STR_AS_ARGV0; rav[1] = (char *)STR_AS_64;
        rav[2] = (char *)OPT_O; rav[3] = (char *)STR_RT_O; rav[4] = (char *)STR_RT_S; rav[5] = 0;
        if (kcc_driver_spawn(STR_AS_PATH, rav)) { kcc_io_flush(); kcc_sys_exit(1); }
        larg[k++] = (char *)STR_RT_O;     /* runtime object as a link input */
        larg[k++] = (char *)OPT_O;
        larg[k++] = (char *)out;
        larg[k++] = (char *)STR_STATIC;
        larg[k++] = (char *)STR_NOSTDLIB;
        larg[k++] = (char *)STR_DASH_E;
        larg[k++] = (char *)STR_USTART;
    } else {                              /* Darwin host: link against libSystem */
        larg[k++] = (char *)OPT_O;
        larg[k++] = (char *)out;
        larg[k++] = (char *)STR_LSYSTEM;
        larg[k++] = (char *)STR_SYSLIBROOT;
        larg[k++] = kcc_driver_sdkroot();
        larg[k++] = (char *)STR_ARCH;
        larg[k++] = kcc_target ? (char *)STR_X86_64 : (char *)STR_ARM64;
        larg[k++] = (char *)STR_DASH_E;
        larg[k++] = (char *)STR_UMAIN;
    }
    larg[k] = 0;

    kcc_io_flush();
    int status = kcc_driver_spawn(STR_LD_PATH, larg);

    if (kcc_x86_os && kcc_host_linux) { kcc_sys_unlink(STR_RT_S); kcc_sys_unlink(STR_RT_O); }
    for (long i = 0; i < tmpcount; i++) kcc_sys_unlink(tmpobj[i]);

    kcc_io_flush();
    kcc_sys_exit(status);
}
@}

\section{Assembling the Translation Unit}

@l c
@d Selfhost: driver @{
@<Selfhost: driver preamble@>
@<Selfhost: driver compile@>
@<Selfhost: driver args@>
@<Selfhost: driver compile-all@>
@<Selfhost: driver spawn@>
@<Selfhost: driver link@>
@}

\section{Verification}
\label{sec:selfhost-driver-verify}

\texttt{make selfhost-driver} runs the drop-in loop through the code-generation
suite (whose harness drives \texttt{kcc\_driver\_compile\_all}) and the
end-to-end suite (which drives \texttt{kcc\_driver\_link\_all} to build and run
real executables), so both the compile and the link orchestration are verified.

@d Selfhost: driver verify @{
#!/usr/bin/env bash
# make selfhost-driver — compile kcc's driver in C with kcc, relink, run the
# codegen and end-to-end suites.
set -euo pipefail

SDK=$(xcrun --show-sdk-path)
SH=tmp/selfhost
sources="main syscalls arena strings io hashtab vec strtab source lexer \
lexer_tables diag preprocessor parser expressions statements declarations \
types symtab conversions sema ir opt emit_arm64 emit_x86 linker codegen emit_macho dwarf driver"

echo "[1/3] compiling tmp/selfhost/driver.c with kcc"
tmp/kcc -c "$SH/driver.c" -o "$SH/driver_c.o" >/dev/null

echo "[2/3] linking tmp/kcc_selfhost_driver (driver.o -> C)"
OBJ=""
for f in $sources; do
    if [ "$f" = "driver" ]; then OBJ="$OBJ $SH/driver_c.o"; else OBJ="$OBJ tmp/src/${f}.o"; fi
done
ld -o tmp/kcc_selfhost_driver $OBJ -lSystem -syslibroot "$SDK" -e _main -arch arm64

echo "[3/3] running codegen + e2e with the self-hosted driver"
cp tmp/kcc "$SH/kcc_asm_backup_driver"
cp tmp/kcc_selfhost_driver tmp/kcc
set +e
bash tmp/tests/test_codegen.sh; s1=$?
bash tmp/tests/e2e.sh;          s2=$?
cp "$SH/kcc_asm_backup_driver" tmp/kcc
[ $s1 -eq 0 ] && [ $s2 -eq 0 ]
@}
