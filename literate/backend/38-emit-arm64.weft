% 38-emit-arm64.weft — ARM64 Instruction Binary Encoding
%
% This chapter provides the low-level machinery for encoding ARM64
% instructions into their 32-bit binary representations.  The code
% buffer is arena-allocated and grows as needed.  Each encoding
% function takes the operand fields and returns the packed 32-bit word,
% which is then appended to the buffer via kcc_code_emit32.

\chapter{ARM64 Encoding}
\label{ch:emit-arm64}

The code generator from Chapter~\ref{ch:codegen} decides which ARM64 instructions to emit; this chapter provides the low-level machinery that encodes those instructions into their 32-bit binary representations.  It manages a growable code buffer, implements the encoding functions for each instruction format (arithmetic, logical, memory, compare-and-branch, conditional branch, and unconditional branch), and provides the \texttt{patch32} facility used to resolve forward branches after their targets are known.

\section{Code Buffer}

The code buffer is a simple growable byte array.  Since ARM64
instructions are fixed-width (4 bytes), we always append in 4-byte
increments.

@d Backend: constants @{
// -- Backend constants --------------------------------------------------------
.equ CODEBUF_INIT_CAP, 4096     // initial code buffer capacity (bytes)
@}

The buffer provides four operations: \texttt{init} allocates a 4\,KB arena block; \texttt{emit32} appends one instruction (doubling the buffer when full); \texttt{current\_pos} returns the write offset (used to compute branch distances and record relocation sites); and \texttt{patch32} overwrites an already-emitted instruction (used to resolve forward branches).

@d Backend: code buffer @{
// -- kcc_code_init ------------------------------------------------------------
// void kcc_code_init(void)
// Allocates the initial code buffer.
.text
.globl _kcc_code_init
.p2align 2
_kcc_code_init:
    stp x29, x30, [sp, #-16]!
    mov x29, sp

    mov x0, #CODEBUF_INIT_CAP
    bl _kcc_arena_alloc

    adrp x1, _kcc_code_buf@@PAGE
    add  x1, x1, _kcc_code_buf@@PAGEOFF
    str x0, [x1]

    adrp x1, _kcc_code_pos@@PAGE
    add  x1, x1, _kcc_code_pos@@PAGEOFF
    str xzr, [x1]

    mov x2, #CODEBUF_INIT_CAP
    adrp x1, _kcc_code_cap@@PAGE
    add  x1, x1, _kcc_code_cap@@PAGEOFF
    str x2, [x1]

    ldp x29, x30, [sp], #16
    ret

// -- kcc_code_emit32 ----------------------------------------------------------
// void kcc_code_emit32(uint32_t word)
//   x0 = 32-bit instruction word
// Appends a 4-byte instruction to the code buffer.
.text
.globl _kcc_code_emit32
.p2align 2
_kcc_code_emit32:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    mov x19, x0                   // save word

    // Check if we need to grow
    adrp x1, _kcc_code_pos@@PAGE
    add  x1, x1, _kcc_code_pos@@PAGEOFF
    ldr x2, [x1]                  // pos
    add x3, x2, #4
    adrp x4, _kcc_code_cap@@PAGE
    add  x4, x4, _kcc_code_cap@@PAGEOFF
    ldr x5, [x4]                  // cap
    cmp x3, x5
    b.le .Lce32_write

    // Grow: allocate new buffer (double capacity)
    lsl x0, x5, #1               // new cap = old * 2
    str x0, [x4]                  // update cap
    mov x5, x0                   // save new cap
    bl _kcc_arena_alloc
    mov x6, x0                   // new buf

    // Copy old data
    adrp x1, _kcc_code_buf@@PAGE
    add  x1, x1, _kcc_code_buf@@PAGEOFF
    ldr x7, [x1]                  // old buf
    str x6, [x1]                  // update buf ptr

    // memcpy(new, old, pos)
    mov x0, x6
    mov x1, x7
    adrp x2, _kcc_code_pos@@PAGE
    add  x2, x2, _kcc_code_pos@@PAGEOFF
    ldr x2, [x2]
    bl _kcc_memcpy

.Lce32_write:
    adrp x1, _kcc_code_buf@@PAGE
    add  x1, x1, _kcc_code_buf@@PAGEOFF
    ldr x1, [x1]                  // buf
    adrp x2, _kcc_code_pos@@PAGE
    add  x2, x2, _kcc_code_pos@@PAGEOFF
    ldr x3, [x2]                  // pos
    str w19, [x1, x3]             // write word at buf+pos
    add x3, x3, #4
    str x3, [x2]                  // pos += 4

    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_code_init
@| _kcc_code_emit32
@}

\paragraph{Inspection and Patching}

The remaining two operations read or modify the buffer rather than appending to it. \texttt{kcc\_code\_current\_pos} returns the byte offset where the next instruction will be written---the codegen uses this to compute branch distances and to record relocation sites for the linker. \texttt{kcc\_code\_patch32} overwrites an already-emitted 32-bit word at a given offset, which is how forward branches are resolved once the target address becomes known.

@d Backend: code buffer @{
// -- kcc_code_current_pos -----------------------------------------------------
// uint64_t kcc_code_current_pos(void)
// Returns the current offset in the code buffer.
.text
.globl _kcc_code_current_pos
.p2align 2
_kcc_code_current_pos:
    adrp x0, _kcc_code_pos@@PAGE
    add  x0, x0, _kcc_code_pos@@PAGEOFF
    ldr x0, [x0]
    ret

// -- kcc_code_patch32 ---------------------------------------------------------
// void kcc_code_patch32(uint64_t offset, uint32_t word)
//   x0 = offset in code buffer
//   x1 = new 32-bit word
// Overwrites the instruction at the given offset.
.text
.globl _kcc_code_patch32
.p2align 2
_kcc_code_patch32:
    adrp x2, _kcc_code_buf@@PAGE
    add  x2, x2, _kcc_code_buf@@PAGEOFF
    ldr x2, [x2]
    str w1, [x2, x0]
    ret
@| _kcc_code_current_pos
@| _kcc_code_patch32
@}

\section{Arithmetic Encoding (Register)}

All register-form arithmetic instructions share a common encoding: the \texttt{sf} bit (bit~31) selects 64-bit vs.\ 32-bit operation, \texttt{Rm} occupies bits [20:16], \texttt{Rn} bits [9:5], and \texttt{Rd} bits [4:0]. The opcode prefix distinguishes the operation (e.g., \texttt{0x0B} for \textsc{add}, \texttt{0x4B} for \textsc{sub}). Multiply uses the three-source \textsc{madd} form with \texttt{Ra\,=\,xzr}, and the modulo helper \textsc{msub} computes $R_d = R_a - R_n \times R_m$.

@d Backend: encode arithmetic reg @{
// -- kcc_enc_add_reg ----------------------------------------------------------
// uint32_t kcc_enc_add_reg(uint32_t rd, uint32_t rn, uint32_t rm, uint32_t sf)
//   x0=rd, x1=rn, x2=rm, x3=sf (1=64-bit, 0=32-bit)
.text
.globl _kcc_enc_add_reg
.p2align 2
_kcc_enc_add_reg:
    // ADD: sf=0 → 0x0B000000, sf=1 → 0x8B000000
    mov w4, #0x0B000000
    orr w4, w4, w3, lsl #31       // set sf bit
    orr w4, w4, w2, lsl #16       // Rm
    orr w4, w4, w1, lsl #5        // Rn
    orr w4, w4, w0                // Rd
    mov w0, w4
    ret

// -- kcc_enc_sub_reg ----------------------------------------------------------
.text
.globl _kcc_enc_sub_reg
.p2align 2
_kcc_enc_sub_reg:
    // SUB: sf=0 → 0x4B000000, sf=1 → 0xCB000000
    mov w4, #0x4B000000
    orr w4, w4, w3, lsl #31
    orr w4, w4, w2, lsl #16
    orr w4, w4, w1, lsl #5
    orr w4, w4, w0
    mov w0, w4
    ret

// -- kcc_enc_mul --------------------------------------------------------------
.text
.globl _kcc_enc_mul
.p2align 2
_kcc_enc_mul:
    // MUL (MADD Rd,Rn,Rm,XZR): sf=0 → 0x1B007C00, sf=1 → 0x9B007C00
    mov w4, #0x1B000000
    orr w4, w4, w3, lsl #31
    orr w4, w4, w2, lsl #16       // Rm
    orr w4, w4, #(31 << 10)       // Ra = xzr (31)
    orr w4, w4, w1, lsl #5        // Rn
    orr w4, w4, w0                // Rd
    mov w0, w4
    ret

// -- kcc_enc_sdiv -------------------------------------------------------------
.text
.globl _kcc_enc_sdiv
.p2align 2
_kcc_enc_sdiv:
    // SDIV: sf=0 → 0x1AC00C00, sf=1 → 0x9AC00C00
    movz w4, #0x1AC0, lsl #16
    movk w4, #0x0C00
    orr w4, w4, w3, lsl #31       // sf
    orr w4, w4, w2, lsl #16       // Rm
    orr w4, w4, w1, lsl #5        // Rn
    orr w4, w4, w0                // Rd
    mov w0, w4
    ret

// -- kcc_enc_udiv -------------------------------------------------------------
.text
.globl _kcc_enc_udiv
.p2align 2
_kcc_enc_udiv:
    // UDIV: sf=0 → 0x1AC00800, sf=1 → 0x9AC00800
    movz w4, #0x1AC0, lsl #16
    movk w4, #0x0800
    orr w4, w4, w3, lsl #31       // sf
    orr w4, w4, w2, lsl #16       // Rm
    orr w4, w4, w1, lsl #5        // Rn
    orr w4, w4, w0                // Rd
    mov w0, w4
    ret

// -- kcc_enc_msub -------------------------------------------------------------
// MSUB Rd, Rn, Rm, Ra: Rd = Ra - Rn*Rm
// x0=rd, x1=rn, x2=rm, x3=ra, x4=sf
.text
.globl _kcc_enc_msub
.p2align 2
_kcc_enc_msub:
    // MSUB: sf=0 → 0x1B008000, sf=1 → 0x9B008000
    mov w5, #0x1B000000
    orr w5, w5, w4, lsl #31       // sf
    orr w5, w5, #0x8000           // o0 bit (distinguishes MSUB from MADD)
    orr w5, w5, w2, lsl #16       // Rm
    orr w5, w5, w3, lsl #10       // Ra
    orr w5, w5, w1, lsl #5        // Rn
    orr w5, w5, w0                // Rd
    mov w0, w5
    ret
@| _kcc_enc_add_reg
@| _kcc_enc_sub_reg
@| _kcc_enc_mul
@| _kcc_enc_sdiv
@| _kcc_enc_udiv
@| _kcc_enc_msub
@}

\section{Arithmetic Encoding (Immediate)}

Immediate-form arithmetic encodes a 12-bit unsigned immediate in bits [21:10]. \textsc{movz} and \textsc{movk} together materialise arbitrary 64-bit constants: \textsc{movz} zeroes the register and inserts a 16-bit chunk at the half-word position selected by \texttt{hw}, while \textsc{movk} overwrites one 16-bit lane without disturbing the rest.

@d Backend: encode arithmetic imm @{
// -- kcc_enc_add_imm ----------------------------------------------------------
// uint32_t kcc_enc_add_imm(uint32_t rd, uint32_t rn, uint32_t imm12, uint32_t sf)
.text
.globl _kcc_enc_add_imm
.p2align 2
_kcc_enc_add_imm:
    // ADD imm: sf=0 → 0x11000000, sf=1 → 0x91000000
    mov w4, #0x11000000
    orr w4, w4, w3, lsl #31
    orr w4, w4, w2, lsl #10       // imm12
    orr w4, w4, w1, lsl #5        // Rn
    orr w4, w4, w0                // Rd
    mov w0, w4
    ret

// -- kcc_enc_sub_imm ----------------------------------------------------------
.text
.globl _kcc_enc_sub_imm
.p2align 2
_kcc_enc_sub_imm:
    // SUB imm: sf=0 → 0x51000000, sf=1 → 0xD1000000
    mov w4, #0x51000000
    orr w4, w4, w3, lsl #31
    orr w4, w4, w2, lsl #10       // imm12
    orr w4, w4, w1, lsl #5        // Rn
    orr w4, w4, w0                // Rd
    mov w0, w4
    ret

// -- kcc_enc_movz -------------------------------------------------------------
// uint32_t kcc_enc_movz(uint32_t rd, uint32_t imm16, uint32_t hw, uint32_t sf)
//   hw = shift amount / 16 (0,1,2,3)
.text
.globl _kcc_enc_movz
.p2align 2
_kcc_enc_movz:
    // MOVZ: sf=0 → 0x52800000, sf=1 → 0xD2800000
    mov w4, #0x52800000
    orr w4, w4, w3, lsl #31
    orr w4, w4, w2, lsl #21       // hw
    orr w4, w4, w1, lsl #5        // imm16
    orr w4, w4, w0                // Rd
    mov w0, w4
    ret

// -- kcc_enc_movk -------------------------------------------------------------
.text
.globl _kcc_enc_movk
.p2align 2
_kcc_enc_movk:
    // MOVK: sf=0 → 0x72800000, sf=1 → 0xF2800000
    mov w4, #0x72800000
    orr w4, w4, w3, lsl #31
    orr w4, w4, w2, lsl #21       // hw
    orr w4, w4, w1, lsl #5        // imm16
    orr w4, w4, w0                // Rd
    mov w0, w4
    ret
@| _kcc_enc_add_imm
@| _kcc_enc_sub_imm
@| _kcc_enc_movz
@| _kcc_enc_movk
@}

\section{Logical Encoding}

Logical register operations use the same $(\mathit{sf}, R_m, R_n, R_d)$ layout as arithmetic, with opcode prefixes \texttt{0x0A} (\textsc{and}), \texttt{0x2A} (\textsc{orr}), and \texttt{0x4A} (\textsc{eor}). Bitwise \textsc{not} is encoded as \textsc{orn}\;$R_d, \mathit{xzr}, R_m$ (the \texttt{N}~bit at position~21 selects the inverted second operand). The variable-distance shifts (\textsc{lslv}, \textsc{lsrv}, \textsc{asrv}) live in the Data Processing (2-source) space with distinct sub-opcodes in bits [11:10].

@d Backend: encode logical @{
// -- kcc_enc_and_reg ----------------------------------------------------------
.text
.globl _kcc_enc_and_reg
.p2align 2
_kcc_enc_and_reg:
    // AND: sf=0 → 0x0A000000, sf=1 → 0x8A000000
    mov w4, #0x0A000000
    orr w4, w4, w3, lsl #31
    orr w4, w4, w2, lsl #16
    orr w4, w4, w1, lsl #5
    orr w4, w4, w0
    mov w0, w4
    ret

// -- kcc_enc_orr_reg ----------------------------------------------------------
.text
.globl _kcc_enc_orr_reg
.p2align 2
_kcc_enc_orr_reg:
    // ORR: sf=0 → 0x2A000000, sf=1 → 0xAA000000
    mov w4, #0x2A000000
    orr w4, w4, w3, lsl #31
    orr w4, w4, w2, lsl #16
    orr w4, w4, w1, lsl #5
    orr w4, w4, w0
    mov w0, w4
    ret

// -- kcc_enc_eor_reg ----------------------------------------------------------
.text
.globl _kcc_enc_eor_reg
.p2align 2
_kcc_enc_eor_reg:
    // EOR: sf=0 → 0x4A000000, sf=1 → 0xCA000000
    mov w4, #0x4A000000
    orr w4, w4, w3, lsl #31
    orr w4, w4, w2, lsl #16
    orr w4, w4, w1, lsl #5
    orr w4, w4, w0
    mov w0, w4
    ret

// -- kcc_enc_mvn --------------------------------------------------------------
// MVN Rd, Rm → ORN Rd, XZR, Rm
// x0=rd, x1=rm, x2=sf
.text
.globl _kcc_enc_mvn
.p2align 2
_kcc_enc_mvn:
    // ORN: sf=0 → 0x2A200000, sf=1 → 0xAA200000
    mov w4, #0x2A200000
    orr w4, w4, w2, lsl #31       // sf
    orr w4, w4, w1, lsl #16       // Rm
    mov w5, #31
    orr w4, w4, w5, lsl #5        // Rn = XZR (31)
    orr w4, w4, w0                // Rd
    mov w0, w4
    ret

@| _kcc_enc_and_reg
@| _kcc_enc_orr_reg
@| _kcc_enc_eor_reg
@| _kcc_enc_mvn
@}

\paragraph{Variable-Distance Shifts}

The variable-distance shift instructions \texttt{LSLV}, \texttt{LSRV}, and \texttt{ASRV} belong to a different ARM64 instruction class---Data Processing (2-source)---rather than the Logical Shifted Register group above. They share the same opcode prefix \texttt{0x1AC0} (with \texttt{sf} at bit~31) and differ only in the sub-opcode at bits [11:10]: \texttt{0x2000} for left shift, \texttt{0x2400} for logical right shift, and \texttt{0x2800} for arithmetic right shift. The shift amount comes from register \texttt{Rm} rather than an immediate.

@d Backend: encode logical @{
// -- kcc_enc_lsl_reg ----------------------------------------------------------
// LSLV: x0=rd, x1=rn, x2=rm, x3=sf
.text
.globl _kcc_enc_lsl_reg
.p2align 2
_kcc_enc_lsl_reg:
    // LSLV: sf=0 → 0x1AC02000, sf=1 → 0x9AC02000
    movz w4, #0x1AC0, lsl #16
    movk w4, #0x2000
    orr w4, w4, w3, lsl #31
    orr w4, w4, w2, lsl #16
    orr w4, w4, w1, lsl #5
    orr w4, w4, w0
    mov w0, w4
    ret

// -- kcc_enc_lsr_reg ----------------------------------------------------------
.text
.globl _kcc_enc_lsr_reg
.p2align 2
_kcc_enc_lsr_reg:
    // LSRV: sf=0 → 0x1AC02400, sf=1 → 0x9AC02400
    movz w4, #0x1AC0, lsl #16
    movk w4, #0x2400
    orr w4, w4, w3, lsl #31
    orr w4, w4, w2, lsl #16
    orr w4, w4, w1, lsl #5
    orr w4, w4, w0
    mov w0, w4
    ret

// -- kcc_enc_asr_reg ----------------------------------------------------------
.text
.globl _kcc_enc_asr_reg
.p2align 2
_kcc_enc_asr_reg:
    // ASRV: sf=0 → 0x1AC02800, sf=1 → 0x9AC02800
    movz w4, #0x1AC0, lsl #16
    movk w4, #0x2800
    orr w4, w4, w3, lsl #31
    orr w4, w4, w2, lsl #16
    orr w4, w4, w1, lsl #5
    orr w4, w4, w0
    mov w0, w4
    ret
@| _kcc_enc_lsl_reg
@| _kcc_enc_lsr_reg
@| _kcc_enc_asr_reg
@}

\section{Compare and Conditional Set}

Comparison is encoded as \texttt{SUBS\;xzr,\;Rn,\;Rm}---a subtract whose result is discarded but whose flags are set. \textsc{cset} is a pseudo-instruction for \texttt{CSINC\;Rd,\;xzr,\;xzr,\;inv(cond)}: if the \emph{inverted} condition is false (meaning the original condition is true), the result increments zero to one; otherwise it stays zero. Bit~10 distinguishes \textsc{csinc} from \textsc{csel}.

@d Backend: encode compare @{
// -- kcc_enc_cmp_reg ----------------------------------------------------------
// CMP Rn, Rm → SUBS XZR, Rn, Rm
// x0=rn, x1=rm, x2=sf
.text
.globl _kcc_enc_cmp_reg
.p2align 2
_kcc_enc_cmp_reg:
    // SUBS: sf=0 → 0x6B000000, sf=1 → 0xEB000000
    mov w3, #0x6B000000
    orr w3, w3, w2, lsl #31
    orr w3, w3, w1, lsl #16       // Rm
    orr w3, w3, w0, lsl #5        // Rn
    mov w4, #31
    orr w3, w3, w4                // Rd = XZR (31)
    mov w0, w3
    ret

// -- kcc_enc_cset -------------------------------------------------------------
// CSET Rd, cond → CSINC Rd, XZR, XZR, inv(cond)
// x0=rd, x1=cond (already inverted!), x2=sf
.text
.globl _kcc_enc_cset
.p2align 2
_kcc_enc_cset:
    // CSINC: sf=0 → 0x1A9F07E0, sf=1 → 0x9A9F07E0
    // Encoding: sf|0|0|11010100|Rm(=11111)|cond|01|Rn(=11111)|Rd
    // = sf | 0x1A800000 | 31<<16 | cond<<12 | 1<<10 | 31<<5 | rd
    mov w3, #0x1A800000
    orr w3, w3, #0x400            // bit 10 = 1 → CSINC (not CSEL)
    orr w3, w3, w2, lsl #31       // sf
    mov w4, #31
    orr w3, w3, w4, lsl #16       // Rm = XZR
    orr w3, w3, w1, lsl #12       // cond (inverted)
    orr w3, w3, w4, lsl #5        // Rn = XZR
    orr w3, w3, w0                // Rd
    mov w0, w3
    ret
@| _kcc_enc_cmp_reg
@| _kcc_enc_cset
@}

\section{Memory Encoding}

Load and store use the unsigned-offset form: the 12-bit immediate is pre-scaled by the access size (divided by~8 for 64-bit, by~4 for 32-bit). The load encoder also provides the three sign-extending narrow forms \textsc{ldrsb}, \textsc{ldrsh}, and \textsc{ldrsw} (size codes 5, 6, 4), which set \texttt{opc}\;$=$\;\texttt{10} to extend a byte, halfword, or word into the full 64-bit register---needed now that packed struct fields and array elements are addressed at their natural width and a signed narrow value must keep its sign in the eight-byte spill slot. \textsc{stp} (pre-index) and \textsc{ldp} (post-index) use a 7-bit signed immediate scaled by~8, encoded in bits [21:15]. \textsc{mov}\;$R_d, R_m$ is encoded as \texttt{ORR\;Rd,\;xzr,\;Rm}.

@d Backend: encode memory @{
// -- kcc_enc_str_imm ----------------------------------------------------------
// STR (unsigned offset): x0=rt, x1=rn, x2=imm12_scaled,
//   x3=size(0=32,1=64,2=byte,3=half)
.text
.globl _kcc_enc_str_imm
.p2align 2
_kcc_enc_str_imm:
    cmp w3, #2
    b.eq .Lstr_8
    cmp w3, #3
    b.eq .Lstr_16
    cbz w3, .Lstr_32
    mov w4, #0xF9000000            // 64-bit
    b .Lstr_common
.Lstr_32:
    mov w4, #0xB9000000            // 32-bit
    b .Lstr_common
.Lstr_8:
    mov w4, #0x39000000            // 8-bit (STRB)
    b .Lstr_common
.Lstr_16:
    mov w4, #0x79000000            // 16-bit (STRH)
.Lstr_common:
    orr w4, w4, w2, lsl #10       // imm12 (pre-scaled)
    orr w4, w4, w1, lsl #5        // Rn
    orr w4, w4, w0                // Rt
    mov w0, w4
    ret

// -- kcc_enc_ldr_imm ----------------------------------------------------------
// LDR (unsigned offset): x0=rt, x1=rn, x2=imm12_scaled,
//   x3=size(0=32,1=64,2=byte,3=half,4=LDRSW,5=LDRSB,6=LDRSH)
// Codes 4--6 sign-extend a narrow load into the full 64-bit register
// (opc=10 in bits [23:22]); the unsigned forms 0/2/3 zero-extend (opc=01).
.text
.globl _kcc_enc_ldr_imm
.p2align 2
_kcc_enc_ldr_imm:
    cmp w3, #2
    b.eq .Lldr_8
    cmp w3, #3
    b.eq .Lldr_16
    cmp w3, #4
    b.eq .Lldr_sw
    cmp w3, #5
    b.eq .Lldr_sb
    cmp w3, #6
    b.eq .Lldr_sh
    cbz w3, .Lldr_32
    mov w4, #0xF9400000            // 64-bit
    b .Lldr_common
.Lldr_32:
    mov w4, #0xB9400000            // 32-bit
    b .Lldr_common
.Lldr_8:
    mov w4, #0x39400000            // 8-bit (LDRB)
    b .Lldr_common
.Lldr_16:
    mov w4, #0x79400000            // 16-bit (LDRH)
    b .Lldr_common
.Lldr_sw:
    mov w4, #0xB9800000            // LDRSW (32→64 signed)
    b .Lldr_common
.Lldr_sb:
    mov w4, #0x39800000            // LDRSB (8→64 signed)
    b .Lldr_common
.Lldr_sh:
    mov w4, #0x79800000            // LDRSH (16→64 signed)
.Lldr_common:
    orr w4, w4, w2, lsl #10       // imm12 (pre-scaled)
    orr w4, w4, w1, lsl #5        // Rn
    orr w4, w4, w0                // Rt
    mov w0, w4
    ret
@| _kcc_enc_str_imm
@| _kcc_enc_ldr_imm
@}

\paragraph{Paired Load/Store}

The \textsc{stp} (store pair, pre-index) and \textsc{ldp} (load pair, post-index) instructions transfer two 64-bit registers in a single operation. They are used almost exclusively in function prologues and epilogues to save and restore \texttt{x29}/\texttt{x30}. The 7-bit signed immediate in bits [21:15] is scaled by~8, giving a $\pm$512-byte range from the base register.

@d Backend: encode memory @{
// -- kcc_enc_stp_pre ----------------------------------------------------------
// STP (pre-index, 64-bit): x0=rt1, x1=rt2, x2=rn, x3=imm7 (signed, scaled by 8)
// Encoding: 0xA9800000 | (imm7&0x7F)<<15 | rt2<<10 | rn<<5 | rt1
.text
.globl _kcc_enc_stp_pre
.p2align 2
_kcc_enc_stp_pre:
    mov w4, #0xA9800000
    and w5, w3, #0x7F
    orr w4, w4, w5, lsl #15       // imm7
    orr w4, w4, w1, lsl #10       // Rt2
    orr w4, w4, w2, lsl #5        // Rn
    orr w4, w4, w0                // Rt1
    mov w0, w4
    ret

// -- kcc_enc_ldp_post ---------------------------------------------------------
// LDP (post-index, 64-bit): x0=rt1, x1=rt2, x2=rn, x3=imm7 (signed, scaled by 8)
// Encoding: 0xA8C00000 | (imm7&0x7F)<<15 | rt2<<10 | rn<<5 | rt1
.text
.globl _kcc_enc_ldp_post
.p2align 2
_kcc_enc_ldp_post:
    mov w4, #0xA8C00000
    and w5, w3, #0x7F
    orr w4, w4, w5, lsl #15       // imm7
    orr w4, w4, w1, lsl #10       // Rt2
    orr w4, w4, w2, lsl #5        // Rn
    orr w4, w4, w0                // Rt1
    mov w0, w4
    ret
@| _kcc_enc_stp_pre
@| _kcc_enc_ldp_post
@}

\paragraph{Register Move}

\textsc{mov}\;$R_d, R_m$ is not a first-class ARM64 instruction but an alias for \texttt{ORR\;Rd, XZR, Rm}---a bitwise OR with the zero register that simply copies \texttt{Rm} into \texttt{Rd}. We encode it as a logical operation with \texttt{Rn\,=\,31} (the zero register), opcode prefix \texttt{0x2A000000}, and \texttt{sf} at bit~31.

@d Backend: encode memory @{
// -- kcc_enc_mov_reg ----------------------------------------------------------
// MOV Rd, Rm → ORR Rd, XZR, Rm
// x0=rd, x1=rm, x2=sf
.text
.globl _kcc_enc_mov_reg
.p2align 2
_kcc_enc_mov_reg:
    mov w3, #0x2A000000
    orr w3, w3, w2, lsl #31       // sf
    orr w3, w3, w1, lsl #16       // Rm
    mov w4, #31
    orr w3, w3, w4, lsl #5        // Rn = XZR
    orr w3, w3, w0                // Rd
    mov w0, w3
    ret
@| _kcc_enc_mov_reg
@}

\section{Floating-Point Encoding}

Floating-point work uses a small, fixed slice of the SIMD\&FP encoding
space, all in double precision (\texttt{ptype}\;$=$\;\texttt{01}).  The
two-source data-processing form (\textsc{fadd}, \textsc{fsub},
\textsc{fmul}, \textsc{fdiv}) shares a base word and selects the
operation with a four-bit opcode in bits [15:12].  Conversions between
the integer and floating files are single-source: \textsc{scvtf}
signed-int\;$\to$\;double, \textsc{fcvtzs} double\;$\to$\;signed-int
(round toward zero).  \textsc{fcmp} sets the \texttt{NZCV} flags from a
double comparison, after which an ordinary \textsc{cset} materialises
the boolean.  Finally, doubles move to and from stack slots with the
SIMD\&FP unsigned-offset \textsc{ldr}/\textsc{str} (bit~26, the
\texttt{V} bit, distinguishes them from the general-register forms).

@d Backend: encode floating point @{
// -- kcc_enc_fp_dp2 -----------------------------------------------------------
// Double-precision 2-source op: FADD/FSUB/FMUL/FDIV.
//   x0=Rd, x1=Rn, x2=Rm, x3=opcode (fmul=0,fdiv=1,fadd=2,fsub=3)
.text
.globl _kcc_enc_fp_dp2
.p2align 2
_kcc_enc_fp_dp2:
    movz w4, #0x0800             // base: fp dp2, double (bits[11:10]=10)
    movk w4, #0x1E60, lsl #16
    orr w4, w4, w3, lsl #12       // opcode
    orr w4, w4, w2, lsl #16       // Rm
    orr w4, w4, w1, lsl #5        // Rn
    orr w4, w4, w0                // Rd
    mov w0, w4
    ret

// -- kcc_enc_scvtf ------------------------------------------------------------
// SCVTF Dd, Xn — signed 64-bit integer → double.  x0=Rd(fp), x1=Rn(int)
.text
.globl _kcc_enc_scvtf
.p2align 2
_kcc_enc_scvtf:
    movz w2, #0x9E62, lsl #16
    orr w2, w2, w1, lsl #5        // Rn
    orr w2, w2, w0                // Rd
    mov w0, w2
    ret

// -- kcc_enc_fcvtzs -----------------------------------------------------------
// FCVTZS Xd, Dn — double → signed 64-bit integer (round toward zero).
//   x0=Rd(int), x1=Rn(fp)
.text
.globl _kcc_enc_fcvtzs
.p2align 2
_kcc_enc_fcvtzs:
    movz w2, #0x9E78, lsl #16
    orr w2, w2, w1, lsl #5        // Rn
    orr w2, w2, w0                // Rd
    mov w0, w2
    ret

// -- kcc_enc_fcvt_s_d / kcc_enc_fcvt_d_s --------------------------------------
// FCVT Sd, Dn (double → single, rounds) and FCVT Dd, Sn (single → double).
// Rounding a double through single and back is how a value is truncated to
// single precision at a conversion to float.  x0=Rd, x1=Rn.
.text
.globl _kcc_enc_fcvt_s_d
.p2align 2
_kcc_enc_fcvt_s_d:
    movz w2, #0x4000
    movk w2, #0x1E62, lsl #16     // FCVT Sd, Dn = 0x1E624000
    orr w2, w2, w1, lsl #5        // Rn
    orr w2, w2, w0                // Rd
    mov w0, w2
    ret

.text
.globl _kcc_enc_fcvt_d_s
.p2align 2
_kcc_enc_fcvt_d_s:
    movz w2, #0xC000
    movk w2, #0x1E22, lsl #16     // FCVT Dd, Sn = 0x1E22C000
    orr w2, w2, w1, lsl #5        // Rn
    orr w2, w2, w0                // Rd
    mov w0, w2
    ret

// -- kcc_enc_fmov_d_x / kcc_enc_fmov_x_d --------------------------------------
// Move the raw 64 bits between a general register and a double register, so a
// register-allocated value (which lives in a GP register) can be read or
// written by the floating-point paths.  x0=Rd, x1=Rn.
.text
.globl _kcc_enc_fmov_d_x
.p2align 2
_kcc_enc_fmov_d_x:
    movz w2, #0x0000
    movk w2, #0x9E67, lsl #16     // FMOV Dd, Xn = 0x9E670000
    orr w2, w2, w1, lsl #5        // Rn (general)
    orr w2, w2, w0                // Rd (double)
    mov w0, w2
    ret

.text
.globl _kcc_enc_fmov_x_d
.p2align 2
_kcc_enc_fmov_x_d:
    movz w2, #0x0000
    movk w2, #0x9E66, lsl #16     // FMOV Xd, Dn = 0x9E660000
    orr w2, w2, w1, lsl #5        // Rn (double)
    orr w2, w2, w0                // Rd (general)
    mov w0, w2
    ret

// -- kcc_enc_fmov_d_d ---------------------------------------------------------
// FMOV Dd, Dn — copy one double register to another (register-to-register), so
// a value already allocated to a d-register can be moved into a scratch d-reg.
// x0=Rd, x1=Rn.
.text
.globl _kcc_enc_fmov_d_d
.p2align 2
_kcc_enc_fmov_d_d:
    movz w2, #0x4000
    movk w2, #0x1E60, lsl #16     // FMOV Dd, Dn = 0x1E604000
    orr w2, w2, w1, lsl #5        // Rn (double)
    orr w2, w2, w0                // Rd (double)
    mov w0, w2
    ret

// -- kcc_enc_fneg_d -----------------------------------------------------------
// FNEG Dd, Dn — negate a double (flips the sign bit in the FP unit).  x0=Rd, x1=Rn.
.text
.globl _kcc_enc_fneg_d
.p2align 2
_kcc_enc_fneg_d:
    movz w2, #0x4000
    movk w2, #0x1E61, lsl #16     // FNEG Dd, Dn = 0x1E614000
    orr w2, w2, w1, lsl #5        // Rn (double)
    orr w2, w2, w0                // Rd (double)
    mov w0, w2
    ret

// -- kcc_enc_fcmp -------------------------------------------------------------
// FCMP Dn, Dm — set NZCV from a double comparison.  x0=Rn, x1=Rm
.text
.globl _kcc_enc_fcmp
.p2align 2
_kcc_enc_fcmp:
    movz w2, #0x2000
    movk w2, #0x1E60, lsl #16
    orr w2, w2, w1, lsl #16       // Rm
    orr w2, w2, w0, lsl #5        // Rn
    mov w0, w2
    ret

// -- kcc_enc_ldr_fp / kcc_enc_str_fp ------------------------------------------
// LDR/STR Dt, [Xn, #imm12*8] — SIMD&FP unsigned offset (64-bit double).
//   x0=Rt(fp), x1=Rn, x2=imm12 (already scaled by 8)
.text
.globl _kcc_enc_ldr_fp
.p2align 2
_kcc_enc_ldr_fp:
    movz w3, #0xFD40, lsl #16
    orr w3, w3, w2, lsl #10       // imm12
    orr w3, w3, w1, lsl #5        // Rn
    orr w3, w3, w0                // Rt
    mov w0, w3
    ret

.text
.globl _kcc_enc_str_fp
.p2align 2
_kcc_enc_str_fp:
    movz w3, #0xFD00, lsl #16
    orr w3, w3, w2, lsl #10       // imm12
    orr w3, w3, w1, lsl #5        // Rn
    orr w3, w3, w0                // Rt
    mov w0, w3
    ret
@| _kcc_enc_fp_dp2 _kcc_enc_scvtf _kcc_enc_fcvtzs _kcc_enc_fcvt_s_d _kcc_enc_fcvt_d_s _kcc_enc_fcmp _kcc_enc_ldr_fp _kcc_enc_str_fp
@}

\section{Branch Encoding}

Unconditional branches (\textsc{b}, \textsc{bl}) encode a 26-bit signed offset in instruction units (divide byte offset by~4). Conditional \textsc{b.cond} uses a 19-bit offset with the condition code in bits [3:0]. \textsc{cbz} and \textsc{cbnz} combine a register test with a 19-bit branch offset. \textsc{ret} is hard-coded to branch to the address in \texttt{x30}.

@d Backend: encode branch @{
// -- kcc_enc_b ----------------------------------------------------------------
// B imm26: x0 = offset in bytes (will be divided by 4)
.text
.globl _kcc_enc_b
.p2align 2
_kcc_enc_b:
    asr x0, x0, #2                // offset in instructions
    mov w1, #0x14000000
    and w0, w0, #0x03FFFFFF
    orr w0, w0, w1
    ret

// -- kcc_enc_bl ---------------------------------------------------------------
// BL imm26: x0 = offset in bytes
.text
.globl _kcc_enc_bl
.p2align 2
_kcc_enc_bl:
    asr x0, x0, #2
    mov w1, #0x94000000
    and w0, w0, #0x03FFFFFF
    orr w0, w0, w1
    ret
@| _kcc_enc_b
@| _kcc_enc_bl
@}

\paragraph{Conditional Branches and Return}

Conditional branches use a narrower 19-bit signed offset (still in instruction units). \textsc{b.cond} tests the NZCV flags against a 4-bit condition code in bits [3:0]; the codegen emits a \textsc{cmp} immediately before it. \textsc{cbz} and \textsc{cbnz} combine a zero/non-zero register test with the branch, avoiding a separate compare---useful for loop exits and null checks. \textsc{ret} is a fixed encoding (\texttt{0xD65F03C0}) that branches to the address in \texttt{x30}.

@d Backend: encode branch @{
// -- kcc_enc_b_cond -----------------------------------------------------------
// B.cond imm19: x0 = offset in bytes, x1 = condition code
.text
.globl _kcc_enc_b_cond
.p2align 2
_kcc_enc_b_cond:
    asr x0, x0, #2                // offset in instructions
    mov w2, #0x54000000
    and w3, w0, #0x7FFFF          // imm19
    orr w2, w2, w3, lsl #5        // imm19 << 5
    orr w2, w2, w1                // cond
    mov w0, w2
    ret

// -- kcc_enc_cbz --------------------------------------------------------------
// CBZ Rt, imm19: x0 = rt, x1 = offset in bytes, x2 = sf
.text
.globl _kcc_enc_cbz
.p2align 2
_kcc_enc_cbz:
    asr x1, x1, #2                // offset in instructions
    mov w3, #0x34000000
    orr w3, w3, w2, lsl #31       // sf
    and w4, w1, #0x7FFFF
    orr w3, w3, w4, lsl #5        // imm19
    orr w3, w3, w0                // Rt
    mov w0, w3
    ret

// -- kcc_enc_cbnz -------------------------------------------------------------
// CBNZ Rt, imm19: x0 = rt, x1 = offset in bytes, x2 = sf
.text
.globl _kcc_enc_cbnz
.p2align 2
_kcc_enc_cbnz:
    asr x1, x1, #2
    mov w3, #0x35000000
    orr w3, w3, w2, lsl #31       // sf
    and w4, w1, #0x7FFFF
    orr w3, w3, w4, lsl #5        // imm19
    orr w3, w3, w0                // Rt
    mov w0, w3
    ret

// -- kcc_enc_ret --------------------------------------------------------------
.text
.globl _kcc_enc_ret
.p2align 2
_kcc_enc_ret:
    movz w0, #0xD65F, lsl #16
    movk w0, #0x03C0
    ret
// -- kcc_enc_blr --------------------------------------------------------------
// uint32_t kcc_enc_blr(uint32_t rn)
//   Encodes BLR Xn: 0xD63F0000 | (rn << 5)
.text
.globl _kcc_enc_blr
.p2align 2
_kcc_enc_blr:
    movz w1, #0xD63F, lsl #16
    movk w1, #0x0000
    lsl w0, w0, #5
    orr w0, w1, w0
    ret

@| _kcc_enc_b_cond
@| _kcc_enc_cbz
@| _kcc_enc_cbnz
@| _kcc_enc_ret
@| _kcc_enc_blr
@}

\section{System Instructions}

Two fixed-encoding system instructions: \textsc{nop} (\texttt{0xD503201F}) for alignment or placeholder purposes, and \textsc{brk} for software breakpoints (the 16-bit immediate identifies the breakpoint to the debugger).

@d Backend: encode system @{
// -- kcc_enc_nop --------------------------------------------------------------
.text
.globl _kcc_enc_nop
.p2align 2
_kcc_enc_nop:
    movz w0, #0xD503, lsl #16
    movk w0, #0x201F
    ret

// -- kcc_enc_brk --------------------------------------------------------------
// BRK #imm16: x0 = imm16
.text
.globl _kcc_enc_brk
.p2align 2
_kcc_enc_brk:
    mov w1, #0xD4200000
    orr w0, w1, w0, lsl #5
    ret
@| _kcc_enc_nop
@| _kcc_enc_brk
@}

\section{ADRP and Page-Offset Encoding}

The \textsc{adrp} instruction loads a PC-relative page address into a register. The 21-bit immediate is split: bits [1:0] go to \texttt{immlo} at instruction bits [30:29], and bits [20:2] to \texttt{immhi} at bits [23:5]. The linker fills in the actual page offset via an \texttt{ARM64\_RELOC\_PAGE21} relocation; we emit zero as a placeholder.

@d Backend: encode adrp @{
// -- kcc_enc_adrp -------------------------------------------------------------
// ADRP Rd, imm21: x0=rd, x1=imm21 (page offset in 4KB pages)
// Encoding: 1|immlo(2)|10000|immhi(19)|Rd(5)
// immlo = imm21[1:0], immhi = imm21[20:2]
.text
.globl _kcc_enc_adrp
.p2align 2
_kcc_enc_adrp:
    mov w2, #0x90000000
    and w3, w1, #0x3               // immlo = imm21[1:0]
    orr w2, w2, w3, lsl #29        // immlo at bits [30:29]
    lsr w4, w1, #2                 // immhi = imm21[20:2]
    and w4, w4, #0x7FFFF           // mask to 19 bits
    orr w2, w2, w4, lsl #5         // immhi at bits [23:5]
    orr w2, w2, w0                 // Rd
    mov w0, w2
    ret
@| _kcc_enc_adrp
@}

\section{Code Buffer Data}

Three words of mutable state track the code buffer: a pointer to the arena-allocated memory, the current write position, and the capacity.

@d Backend: emit data @{
// -- Code buffer state --------------------------------------------------------
.data
.p2align 3
.globl _kcc_code_buf
_kcc_code_buf:       .quad 0     // pointer to code buffer
.globl _kcc_code_pos
_kcc_code_pos:       .quad 0     // current write position (bytes)
.globl _kcc_code_cap
_kcc_code_cap:       .quad 0     // buffer capacity (bytes)
@| _kcc_code_buf
@| _kcc_code_pos
@| _kcc_code_cap
@}
