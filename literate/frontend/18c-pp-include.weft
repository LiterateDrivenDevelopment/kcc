% 18c-pp-include.weft — file inclusion and freestanding built-in headers
%
% Split from 18-preprocessor.weft (structural refactor, no content changes):
% #include resolution, the embedded built-in header table (<stdio.h> etc.),
% and the #error directive.

\section{File Inclusion (\texttt{\#include})}

\texttt{\#include "file"} opens and processes the named file.  The
current lexer and source states are pushed onto the context stack.
When the included file reaches EOF, the state is restored and
processing continues in the including file.

\paragraph{Locating the file.}
A quoted include is resolved (\stdref{6.10.2}) relative to the
directory of the file that contains the directive, then---failing
that---by the name as given (which the operating system interprets
against the current working directory), and finally along an ordered
list of \emph{include directories}.  This is what allows a project
header to sit beside the \texttt{.c} file that includes it regardless
of where the compiler was invoked, while library headers are found on
the search path.  \texttt{\_kcc\_pp\_resolve\_include} performs the
search: it splices the directory prefix of the current source path onto
the include name, probes that candidate with a throwaway \texttt{open},
and---failing the including directory and the bare name---walks the
include-directory list, joining each directory to the name and probing
in turn, returning the first path that exists.  A
\texttt{\_kcc\_pp\_file\_exists} helper wraps the probe, relying on
\texttt{\_kcc\_sys\_open} returning $-1$ for a file that cannot be
opened.  Angle-bracket includes are resolved the same way; the list is
populated by \texttt{-I} directories and by the compiler's own default
directory (\S\ref{sec:include-path}).  A quoted include that resolves
nowhere is a hard error, but a missing \emph{system} header
(\texttt{\#include <\dots>}) is silently skipped: \kcc{} is freestanding
and supplies what such headers would declare---for instance the
\texttt{va\_*} variadic built-ins---directly, so a program that writes
\texttt{\#include <stdarg.h>} for portability still compiles.

@d PP: resolve include @{
.text
// -- _kcc_pp_file_exists --------------------------------------------
// uint64_t _kcc_pp_file_exists(const char *path)
//   x0 = null-terminated path → 1 if it can be opened, else 0
.p2align 2
_kcc_pp_file_exists:
    stp x29, x30, [sp, #-16]!
    mov x29, sp
    mov x1, #0                   // O_RDONLY
    mov x2, #0
    bl _kcc_sys_open
    cmn x0, #1                   // x0 == -1 ?
    b.eq .Lfe_no
    bl _kcc_sys_close            // opened: close the probe fd
    mov x0, #1
    ldp x29, x30, [sp], #16
    ret
.Lfe_no:
    mov x0, #0
    ldp x29, x30, [sp], #16
    ret

// -- _kcc_pp_resolve_include ----------------------------------------
// char *_kcc_pp_resolve_include(const char *name)
//   x0 = include name → openable path (arena), or 0 if not found.
// Searches the including file's directory first, then the name as given.
.p2align 2
_kcc_pp_resolve_include:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]

    mov x19, x0                  // name
    bl _kcc_strlen
    mov x20, x0                  // namelen

    adrp x0, _kcc_src_path@@PAGE
    add  x0, x0, _kcc_src_path@@PAGEOFF
    ldr  x21, [x0]               // including file path
    cbz x21, .Lri_raw

    // dirlen = length up to and including the last '/'
    mov x22, #0
    mov x23, #0
.Lri_scan:
    ldrb w0, [x21, x23]
    cbz w0, .Lri_scan_done
    cmp w0, #'/'
    b.ne .Lri_scan_next
    add x22, x23, #1
.Lri_scan_next:
    add x23, x23, #1
    b .Lri_scan
.Lri_scan_done:
    cbz x22, .Lri_raw            // no directory prefix

    add x0, x22, x20
    add x0, x0, #1
    bl _kcc_arena_alloc
    mov x24, x0                  // candidate = dir + name + null
    mov x0, x24
    mov x1, x21
    mov x2, x22
    bl _kcc_memcpy
    add x0, x24, x22
    mov x1, x19
    mov x2, x20
    bl _kcc_memcpy
    add x0, x24, x22
    strb wzr, [x0, x20]

    mov x0, x24
    bl _kcc_pp_file_exists
    cbz x0, .Lri_raw
    mov x0, x24
    b .Lri_done

.Lri_raw:
    mov x0, x19
    bl _kcc_pp_file_exists
    cbz x0, .Lri_search
    mov x0, x19
    b .Lri_done

.Lri_search:
    // Walk the include-directory list: join each dir (stored with a trailing
    // '/') to the name and probe.  x19=name, x20=namelen are still live.
    mov x22, #0                  // i
.Lri_search_loop:
    adrp x0, _kcc_inc_ndirs@@PAGE
    add  x0, x0, _kcc_inc_ndirs@@PAGEOFF
    ldr  x0, [x0]
    cmp  x22, x0
    b.hs .Lri_none
    adrp x0, _kcc_inc_dirs@@PAGE
    add  x0, x0, _kcc_inc_dirs@@PAGEOFF
    ldr  x23, [x0, x22, lsl #3]  // dir[i]
    mov  x0, x23
    bl _kcc_strlen
    mov  x21, x0                 // dirlen
    add  x0, x21, x20
    add  x0, x0, #1
    bl _kcc_arena_alloc
    mov  x24, x0                 // candidate = dir + name + null
    mov  x0, x24
    mov  x1, x23
    mov  x2, x21
    bl _kcc_memcpy
    add  x0, x24, x21
    mov  x1, x19
    mov  x2, x20
    bl _kcc_memcpy
    add  x0, x24, x21
    strb wzr, [x0, x20]
    mov  x0, x24
    bl _kcc_pp_file_exists
    cbz  x0, .Lri_search_next
    mov  x0, x24
    b .Lri_done
.Lri_search_next:
    add  x22, x22, #1
    b .Lri_search_loop

.Lri_none:
    mov x0, #0

.Lri_done:
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@}

\subsection{The include search path}
\label{sec:include-path}

The list that \texttt{\_kcc\_pp\_resolve\_include} walks is a fixed-capacity
array of directory strings, each normalised to carry a trailing slash so a
candidate path is a plain concatenation.  Two entry points populate it.
\texttt{\_kcc\_pp\_add\_include\_dir} appends one directory, appending the
slash if the caller's string lacks it; the driver calls it for every
\texttt{-I} argument.  \texttt{\_kcc\_pp\_add\_default\_includes} registers the
compiler's \emph{own} directory: given \texttt{argv[0]} it takes the prefix up
to the last slash---the directory the \texttt{kcc} binary was run from---and
appends \texttt{include}, yielding the sibling \texttt{include/} folder that
ships beside the executable.  This is where the hosted library headers
(\S\ref{sec:builtin-headers}) live as ordinary files, so
\verb|#include <stdio.h>| resolves with no configuration.  Because both
functions write to a driver-lifetime global rather than to per-file
preprocessor state, the path is registered once at startup and survives every
translation unit.  The default directory is added last, after any \texttt{-I}
directories, so a user's \texttt{-I} always takes precedence over the shipped
headers.

@d PP: include path @{
.text
// -- _kcc_pp_add_include_dir ----------------------------------------
// void _kcc_pp_add_include_dir(const char *dir)
//   Appends dir (normalised with a trailing '/') to the include search list.
//   Silently ignored once the fixed-size list is full.
.globl _kcc_pp_add_include_dir
.p2align 2
_kcc_pp_add_include_dir:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    mov x19, x0                  // dir
    adrp x0, _kcc_inc_ndirs@@PAGE
    add  x0, x0, _kcc_inc_ndirs@@PAGEOFF
    ldr  x22, [x0]               // count
    cmp  x22, #64
    b.hs .Ladd_done
    mov  x0, x19
    bl _kcc_strlen
    mov  x21, x0                 // dirlen
    add  x0, x21, #2             // '/' + null
    bl _kcc_arena_alloc
    mov  x20, x0                 // buf
    mov  x0, x20
    mov  x1, x19
    mov  x2, x21
    bl _kcc_memcpy
    mov  w0, #'/'
    strb w0, [x20, x21]
    add  x0, x21, #1
    strb wzr, [x20, x0]
    adrp x0, _kcc_inc_dirs@@PAGE
    add  x0, x0, _kcc_inc_dirs@@PAGEOFF
    str  x20, [x0, x22, lsl #3]
    add  x22, x22, #1
    adrp x0, _kcc_inc_ndirs@@PAGE
    add  x0, x0, _kcc_inc_ndirs@@PAGEOFF
    str  x22, [x0]
.Ladd_done:
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

// -- _kcc_pp_add_default_includes -----------------------------------
// void _kcc_pp_add_default_includes(const char *argv0)
//   Derives the compiler's own include directory as dirname(argv0) +
//   "include" and registers it.  With no directory prefix in argv0 the bare
//   name "include" (relative to the working directory) is used.
.globl _kcc_pp_add_default_includes
.p2align 2
_kcc_pp_add_default_includes:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    mov x19, x0                  // argv0
    mov x20, #0                  // prefixlen (through last '/')
    mov x21, #0                  // i
.Ladi_scan:
    ldrb w0, [x19, x21]
    cbz  w0, .Ladi_done
    cmp  w0, #'/'
    b.ne .Ladi_next
    add  x20, x21, #1
.Ladi_next:
    add  x21, x21, #1
    b .Ladi_scan
.Ladi_done:
    add  x0, x20, #8             // prefix + "include"(7) + null
    bl _kcc_arena_alloc
    mov  x22, x0                 // buf
    mov  x0, x22
    mov  x1, x19
    mov  x2, x20
    bl _kcc_memcpy              // copy dir prefix
    add  x0, x22, x20
    adrp x1, _kcc_str_include@@PAGE
    add  x1, x1, _kcc_str_include@@PAGEOFF
    mov  x2, #7
    bl _kcc_memcpy             // append "include"
    add  x0, x22, x20
    strb wzr, [x0, #7]
    mov  x0, x22
    bl _kcc_pp_add_include_dir
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

.data
.p2align 3
_kcc_inc_dirs:  .space 8*64      // up to 64 include directories
_kcc_inc_ndirs: .quad 0
.section __TEXT,__cstring
_kcc_str_include: .asciz "include"
.text
@| _kcc_pp_add_include_dir _kcc_pp_add_default_includes @}

@d PP: include @{
.text
// -- _kcc_pp_do_include ---------------------------------------------
.p2align 2
_kcc_pp_do_include:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]

    // Read include path token
    bl _kcc_lex_next
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]

    // Accept string literal "file.h" or scan <file.h>
    cmp  x0, #TOK_STRING_LIT
    b.eq .Lincl_string
    cmp  x0, #TOK_LT
    b.eq .Lincl_angle
    b .Lincl_err

.Lincl_string:
    mov  x22, #0              // x22 = 0: quoted include (must resolve)
    // Token text includes quotes: "file.h"
    // Strip quotes: start+1, len-2
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x19, [x0]
    add  x19, x19, #1         // skip opening "
    adrp x0, _kcc_tok_len@@PAGE
    add  x0, x0, _kcc_tok_len@@PAGEOFF
    ldr  x20, [x0]
    sub  x20, x20, #2         // remove both quotes
    b .Lincl_open

.Lincl_angle:
    mov  x22, #1              // x22 = 1: system <...> include (skippable)
    // Scan from cursor to '>' to get the path
    adrp x0, _kcc_lex_cursor@@PAGE
    add  x0, x0, _kcc_lex_cursor@@PAGEOFF
    ldr  x19, [x0]            // start after <
    adrp x1, _kcc_lex_end@@PAGE
    add  x1, x1, _kcc_lex_end@@PAGEOFF
    ldr  x1, [x1]
    mov  x2, x19
.Lincl_angle_scan:
    cmp  x2, x1
    b.hs .Lincl_err
    ldrb w3, [x2]
    cmp  w3, #'>'
    b.eq .Lincl_angle_found
    cmp  w3, #0x0A
    b.eq .Lincl_err            // newline before >
    add  x2, x2, #1
    b .Lincl_angle_scan
.Lincl_angle_found:
    sub  x20, x2, x19         // path length
    add  x2, x2, #1           // skip >
    adrp x0, _kcc_lex_cursor@@PAGE
    add  x0, x0, _kcc_lex_cursor@@PAGEOFF
    str  x2, [x0]             // update cursor
    b .Lincl_open

.Lincl_open:
    // Create null-terminated path in arena
    add  x0, x20, #1          // +1 for null
    bl _kcc_arena_alloc
    mov  x21, x0              // x21 = path buffer

    mov  x0, x21               // dst
    mov  x1, x19               // src
    mov  x2, x20               // len
    bl _kcc_memcpy

    // Null-terminate
    strb wzr, [x21, x20]

    // Skip rest of directive line
    bl _kcc_pp_skip_line

    // Built-in standard header?  Lex its resident text instead of a file.
    mov  x0, x21
    bl _kcc_pp_builtin_header
    cbz  x0, .Lincl_resolve
    mov  x22, x0                 // header text
    bl _kcc_strlen
    mov  x23, x0                 // length

    mov  x0, #PP_CTX_INCLUDE
    bl _kcc_pp_ctx_push

    adrp x0, _kcc_src_base@@PAGE
    add  x0, x0, _kcc_src_base@@PAGEOFF
    str  x22, [x0]
    adrp x0, _kcc_src_size@@PAGE
    add  x0, x0, _kcc_src_size@@PAGEOFF
    str  x23, [x0]
    adrp x0, _kcc_src_path@@PAGE
    add  x0, x0, _kcc_src_path@@PAGEOFF
    str  x21, [x0]               // path = header name

    mov  x0, x22
    mov  x1, x23
    bl _kcc_lex_init
    adrp x0, _kcc_pp_prev_line@@PAGE
    add  x0, x0, _kcc_pp_prev_line@@PAGEOFF
    str  xzr, [x0]

    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret

.Lincl_resolve:
    // Resolve against the including file's directory, then the name as given
    mov  x0, x21
    bl _kcc_pp_resolve_include
    mov  x21, x0
    cbz  x21, .Lincl_notfound

    // Push current state onto context stack
    mov  x0, #PP_CTX_INCLUDE
    bl _kcc_pp_ctx_push

    // Open and process the included file
    mov  x0, x21
    bl _kcc_source_open
    bl _kcc_source_encode
    bl _kcc_source_splice

    // Initialize lexer on included file
    adrp x0, _kcc_src_base@@PAGE
    add  x0, x0, _kcc_src_base@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_src_size@@PAGE
    add  x1, x1, _kcc_src_size@@PAGEOFF
    ldr  x1, [x1]
    bl _kcc_lex_init

    // Reset prev_line for new file
    adrp x0, _kcc_pp_prev_line@@PAGE
    add  x0, x0, _kcc_pp_prev_line@@PAGEOFF
    str  xzr, [x0]

    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret

.Lincl_notfound:
    // A missing system header (<...>) is silently skipped: kcc is freestanding
    // and provides what it needs (e.g. the va_* builtins) without headers.
    // A missing quoted header ("...") is still a hard error.
    cbnz x22, .Lincl_skip
    adrp x0, _kcc_pp_dir_line@@PAGE
    add  x0, x0, _kcc_pp_dir_line@@PAGEOFF
    ldr  x0, [x0]
    mov  x1, #1
    adrp x2, _kcc_pp_err_notfound@@PAGE
    add  x2, x2, _kcc_pp_err_notfound@@PAGEOFF
    bl _kcc_diag_error
.Lincl_skip:
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret

.Lincl_err:
    adrp x0, _kcc_pp_dir_line@@PAGE
    add  x0, x0, _kcc_pp_dir_line@@PAGEOFF
    ldr  x0, [x0]
    mov  x1, #1
    adrp x2, _kcc_pp_err_include@@PAGE
    add  x2, x2, _kcc_pp_err_include@@PAGEOFF
    bl _kcc_diag_error
    bl _kcc_pp_skip_line
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@}

\subsection{Built-in standard headers}
\label{sec:builtin-headers}

A freestanding compiler that simply skips \verb|#include <stdio.h>| forces
every program to hand-declare \texttt{printf}, \texttt{malloc}, and friends.
That is tolerable for the compiler's own bootstrap sources but hostile to
ordinary C.  kcc answers this in two ways, along the fault line the Standard
itself draws.  The \emph{freestanding} headers are embedded directly in the
compiler: when the include machinery is asked for a recognised name it hands
back a compiler-resident C snippet and lexes it in place of a file (the hook in
\texttt{.Lincl\_open} above).  The \emph{hosted} headers are shipped as ordinary
files in the \texttt{include/} directory beside the binary
(\S\ref{sec:include-path}), found on the search path like any other header.
Either way the text carries real prototypes, so the front end learns each
function's arity and argument classes---enough to marshal a call
correctly---and the linker resolves the symbols against \texttt{libSystem}.

The prototypes are deliberately spare: parameters are named (kcc's declarator
parser wants a name), qualifiers are dropped (they do not affect the calling
convention), and \texttt{size\_t}-shaped arguments are written as
\texttt{unsigned long} so no cross-header \texttt{typedef} collides.  Each
header carries an \verb|#ifndef| guard so double inclusion is a no-op.  The
embedded lookup is a linear scan of a name/text table---nine entries, one per
freestanding header, so nothing fancier is warranted.

A distinction from the Standard shapes which of these headers kcc truly
\emph{owns}.  The \emph{freestanding} headers (\stdref{4.6})---\verb|<float.h>|,
\verb|<iso646.h>|, \verb|<limits.h>|, \verb|<stdalign.h>|, \verb|<stdarg.h>|,
\verb|<stdbool.h>|, \verb|<stddef.h>|, \verb|<stdint.h>|, and
\verb|<stdnoreturn.h>|---declare no library functions; they define properties of
the \emph{compiler} itself: type limits, \texttt{size\_t}, \texttt{va\_list},
\texttt{offsetof}, the boolean and character macros.  A conforming
implementation, even a freestanding one, must supply these, and it is the
compiler---which alone knows \texttt{INT\_MAX}, \texttt{DBL\_MAX}, and the
widths of the integer types on its target---that is obliged to.  kcc therefore
provides all nine directly: \verb|<limits.h>| and \verb|<float.h>|
enumerate the target's integer and floating limits (an LP64 target where
\texttt{long} is 64~bits and \texttt{long double} equals \texttt{double}),
\verb|<iso646.h>| the alternative operator spellings, \verb|<stdnoreturn.h>|
the \verb|noreturn| macro, and \verb|<stdalign.h>| the \verb|alignas| and
\verb|alignof| aliases for the \verb|_Alignas| and \verb|_Alignof| operators,
which the front end now accepts (\verb|_Alignof| yields the type's alignment as
an \texttt{unsigned long} constant; \verb|_Alignas| is consumed as a declaration
specifier and its argument accepted, though over-aligning storage beyond the
frame's natural guarantee is not yet enforced).  The remaining standard
headers---\verb|<stdio.h>|, \verb|<stdlib.h>|, \verb|<string.h>|,
\verb|<math.h>|, \verb|<ctype.h>|, \verb|<assert.h>|---are \emph{hosted} headers
that properly belong to the C library, not the compiler.  kcc supplies spare
prototypes for them only as a convenience bridge so the symbols resolve against
\texttt{libSystem} at link time; rather than bake them into the binary, it
ships them as the ordinary \texttt{.h} files below, tangled to
\texttt{include/}.  Adding another hosted bridge---\verb|<time.h>|,
\verb|<errno.h>|---is then a matter of writing a file, not editing the
compiler: a new header fragment and its \texttt{@@o} route, no assembly.

Each of \verb|<stdio.h>|, \verb|<stdlib.h>|, and \verb|<string.h>| opens with
\verb|typedef unsigned long size_t;|, because \stdref{7.21}, \stdref{7.22}, and
\stdref{7.24} each require the header to define \texttt{size\_t} independently of
\verb|<stddef.h>|.  Real code leans on this constantly---\texttt{malloc((size\_t)n)},
\texttt{memcpy(d, s, (size\_t)len)}---so without it a cast to \texttt{size\_t}
fails to parse as a type name.  The typedef is intentionally repeated across the
headers rather than guarded behind a shared macro: an identical
\texttt{typedef} is a legal redefinition (\stdref{6.7}), and the front end
accepts it, so a translation unit that includes several of these headers sees
one consistent \texttt{size\_t} with no conflict.

The standard streams \texttt{stdin}, \texttt{stdout}, and \texttt{stderr} are
included.  They are not functions but \emph{data} objects imported from
\texttt{libSystem} (\verb|__stdinp| and friends), which the header exposes as
\texttt{extern} declarations with the usual macro aliases.  A dylib-imported
datum has no fixed image address, so a reference to one must load its address
through the global offset table rather than form it with a direct
\verb|adrp|/\verb|add| pair; the back end's \texttt{IR\_GLOBAL\_REF} handler
does exactly this for every external data symbol, so
\texttt{fprintf(stderr, \ldots)} now links and runs.

@d Preprocessor: builtin headers @{
// char *_kcc_pp_builtin_header(const char *name)
//   x0 = include name → compiler-resident header text, or 0 if unknown.
.p2align 2
_kcc_pp_builtin_header:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    mov x19, x0                     // requested include name
    adrp x20, _kcc_pp_builtin_table@@PAGE
    add  x20, x20, _kcc_pp_builtin_table@@PAGEOFF
.Lbh_loop:
    ldr x0, [x20]                   // candidate name (0 terminates table)
    cbz x0, .Lbh_none
    mov x1, x19
    bl _kcc_strcmp
    cbz x0, .Lbh_found
    add x20, x20, #16
    b .Lbh_loop
.Lbh_found:
    ldr x0, [x20, #8]               // matching header text
    b .Lbh_ret
.Lbh_none:
    mov x0, #0
.Lbh_ret:
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

.section __TEXT,__cstring
_kcc_hdr_n_stddef:  .asciz "stddef.h"
_kcc_hdr_n_stdbool: .asciz "stdbool.h"
_kcc_hdr_n_stdarg:  .asciz "stdarg.h"
_kcc_hdr_n_stdint:  .asciz "stdint.h"
_kcc_hdr_n_limits:  .asciz "limits.h"
_kcc_hdr_n_float:   .asciz "float.h"
_kcc_hdr_n_iso646:  .asciz "iso646.h"
_kcc_hdr_n_stdnoreturn: .asciz "stdnoreturn.h"
_kcc_hdr_n_stdalign: .asciz "stdalign.h"

_kcc_hdr_stddef: .asciz "#ifndef _STDDEF_H\n#define _STDDEF_H\ntypedef unsigned long size_t;\ntypedef long ptrdiff_t;\ntypedef long max_align_t;\n#define NULL ((void*)0)\n#define offsetof(t, m) ((size_t)&(((t*)0)->m))\n#endif\n"

_kcc_hdr_stdbool: .asciz "#ifndef _STDBOOL_H\n#define _STDBOOL_H\n#define bool int\n#define true 1\n#define false 0\n#endif\n"

_kcc_hdr_stdarg: .asciz "#ifndef _STDARG_H\n#define _STDARG_H\n#endif\n"

_kcc_hdr_stdint: .asciz "#ifndef _STDINT_H\n#define _STDINT_H\ntypedef signed char int8_t;\ntypedef unsigned char uint8_t;\ntypedef short int16_t;\ntypedef unsigned short uint16_t;\ntypedef int int32_t;\ntypedef unsigned int uint32_t;\ntypedef long int64_t;\ntypedef unsigned long uint64_t;\ntypedef long intptr_t;\ntypedef unsigned long uintptr_t;\ntypedef long intmax_t;\ntypedef unsigned long uintmax_t;\ntypedef signed char int_least8_t;\ntypedef unsigned char uint_least8_t;\ntypedef short int_least16_t;\ntypedef unsigned short uint_least16_t;\ntypedef int int_least32_t;\ntypedef unsigned int uint_least32_t;\ntypedef long int_least64_t;\ntypedef unsigned long uint_least64_t;\ntypedef signed char int_fast8_t;\ntypedef unsigned char uint_fast8_t;\ntypedef long int_fast16_t;\ntypedef unsigned long uint_fast16_t;\ntypedef long int_fast32_t;\ntypedef unsigned long uint_fast32_t;\ntypedef long int_fast64_t;\ntypedef unsigned long uint_fast64_t;\n#define INT8_MAX 127\n#define INT16_MAX 32767\n#define INT32_MAX 2147483647\n#define INT64_MAX 9223372036854775807L\n#define UINT8_MAX 255\n#define UINT16_MAX 65535\n#define UINT32_MAX 4294967295U\n#define UINT64_MAX 18446744073709551615UL\n#define INTMAX_MAX 9223372036854775807L\n#define UINTMAX_MAX 18446744073709551615UL\n#define INTPTR_MAX 9223372036854775807L\n#define UINTPTR_MAX 18446744073709551615UL\n#define SIZE_MAX 18446744073709551615UL\n#define INT8_MIN (-128)\n#define INT16_MIN (-32768)\n#define INT32_MIN (-2147483647-1)\n#define INT64_MIN (-9223372036854775807L-1)\n#define INTMAX_MIN (-9223372036854775807L-1)\n#define INTPTR_MIN (-9223372036854775807L-1)\n#endif\n"

_kcc_hdr_limits: .asciz "#ifndef _LIMITS_H\n#define _LIMITS_H\n#define CHAR_BIT 8\n#define SCHAR_MIN (-128)\n#define SCHAR_MAX 127\n#define UCHAR_MAX 255\n#define CHAR_MIN (-128)\n#define CHAR_MAX 127\n#define MB_LEN_MAX 6\n#define SHRT_MIN (-32768)\n#define SHRT_MAX 32767\n#define USHRT_MAX 65535\n#define INT_MIN (-2147483647 - 1)\n#define INT_MAX 2147483647\n#define UINT_MAX 4294967295U\n#define LONG_MIN (-9223372036854775807L - 1)\n#define LONG_MAX 9223372036854775807L\n#define ULONG_MAX 18446744073709551615UL\n#define LLONG_MIN (-9223372036854775807LL - 1)\n#define LLONG_MAX 9223372036854775807LL\n#define ULLONG_MAX 18446744073709551615ULL\n#endif\n"

_kcc_hdr_float: .asciz "#ifndef _FLOAT_H\n#define _FLOAT_H\n#define FLT_RADIX 2\n#define FLT_MANT_DIG 24\n#define DBL_MANT_DIG 53\n#define LDBL_MANT_DIG 53\n#define FLT_DIG 6\n#define DBL_DIG 15\n#define LDBL_DIG 15\n#define FLT_MIN_EXP (-125)\n#define DBL_MIN_EXP (-1021)\n#define LDBL_MIN_EXP (-1021)\n#define FLT_MAX_EXP 128\n#define DBL_MAX_EXP 1024\n#define LDBL_MAX_EXP 1024\n#define FLT_MIN_10_EXP (-37)\n#define DBL_MIN_10_EXP (-307)\n#define LDBL_MIN_10_EXP (-307)\n#define FLT_MAX_10_EXP 38\n#define DBL_MAX_10_EXP 308\n#define LDBL_MAX_10_EXP 308\n#define FLT_ROUNDS 1\n#define FLT_EVAL_METHOD 0\n#define FLT_EPSILON 1.19209290e-7F\n#define DBL_EPSILON 2.2204460492503131e-16\n#define LDBL_EPSILON 2.2204460492503131e-16\n#define FLT_MIN 1.17549435e-38F\n#define DBL_MIN 2.2250738585072014e-308\n#define LDBL_MIN 2.2250738585072014e-308\n#define FLT_MAX 3.40282347e+38F\n#define DBL_MAX 1.7976931348623157e+308\n#define LDBL_MAX 1.7976931348623157e+308\n#define DECIMAL_DIG 17\n#endif\n"

_kcc_hdr_iso646: .asciz "#ifndef _ISO646_H\n#define _ISO646_H\n#define and &&\n#define and_eq &=\n#define bitand &\n#define bitor |\n#define compl ~\n#define not !\n#define not_eq !=\n#define or ||\n#define or_eq |=\n#define xor ^\n#define xor_eq ^=\n#endif\n"

_kcc_hdr_stdnoreturn: .asciz "#ifndef _STDNORETURN_H\n#define _STDNORETURN_H\n#define noreturn _Noreturn\n#define __noreturn_is_defined 1\n#endif\n"

_kcc_hdr_stdalign: .asciz "#ifndef _STDALIGN_H\n#define _STDALIGN_H\n#define alignas _Alignas\n#define alignof _Alignof\n#define __alignas_is_defined 1\n#define __alignof_is_defined 1\n#endif\n"

.data
.align 3
_kcc_pp_builtin_table:
    .quad _kcc_hdr_n_stddef,  _kcc_hdr_stddef
    .quad _kcc_hdr_n_stdbool, _kcc_hdr_stdbool
    .quad _kcc_hdr_n_stdarg,  _kcc_hdr_stdarg
    .quad _kcc_hdr_n_stdint,  _kcc_hdr_stdint
    .quad _kcc_hdr_n_limits,  _kcc_hdr_limits
    .quad _kcc_hdr_n_float,   _kcc_hdr_float
    .quad _kcc_hdr_n_iso646,  _kcc_hdr_iso646
    .quad _kcc_hdr_n_stdnoreturn, _kcc_hdr_stdnoreturn
    .quad _kcc_hdr_n_stdalign, _kcc_hdr_stdalign
    .quad 0, 0
.text
@}

\subsection{Hosted library headers (shipped as files)}
\label{sec:hosted-headers}

These are the convenience bridges the compiler no longer embeds.  Each is
a plain header fragment routed to \texttt{include/} by \texttt{assembly.weft},
so it lands on disk beside the binary and resolves through the default include
directory.  They read as the C they are---no escape counting, no
\texttt{.asciz}---which is the whole point: a hosted header is data the library
owns, and treating it as a file rather than a string baked into the
preprocessor makes it trivial to correct or extend.  The prototypes remain
spare bridges, not faithful copies of the platform headers: enough for the
front end to type each call and for the linker to bind it to \texttt{libSystem}.

\verb|<stdio.h>| additionally exposes the standard streams
\texttt{stdin}/\texttt{stdout}/\texttt{stderr} as \texttt{extern} data objects
imported from \texttt{libSystem} (\verb|__stdinp| and friends) with the usual
macro aliases; the back end's \texttt{IR\_GLOBAL\_REF} handler loads such a
dylib-imported datum through the global offset table, so
\texttt{fprintf(stderr, \ldots)} links and runs.

@d Header: stdio @{
#ifndef _STDIO_H
#define _STDIO_H
#ifndef NULL
#define NULL ((void*)0)
#endif
typedef unsigned long size_t;
typedef void FILE;
extern FILE *__stdinp;
extern FILE *__stdoutp;
extern FILE *__stderrp;
#define stdin  __stdinp
#define stdout __stdoutp
#define stderr __stderrp
#define EOF (-1)
#define BUFSIZ 1024
#define FOPEN_MAX 20
#define FILENAME_MAX 1024
#define L_tmpnam 1024
#define SEEK_SET 0
#define SEEK_CUR 1
#define SEEK_END 2
#define _IOFBF 0
#define _IOLBF 1
#define _IONBF 2
int printf(char *fmt, ...);
int fprintf(FILE *stream, char *fmt, ...);
int sprintf(char *str, char *fmt, ...);
int snprintf(char *str, unsigned long size, char *fmt, ...);
int puts(char *s);
int putchar(int c);
int fputs(char *s, FILE *stream);
int fputc(int c, FILE *stream);
int getchar(void);
int scanf(char *fmt, ...);
int sscanf(char *str, char *fmt, ...);
FILE *fopen(char *path, char *mode);
int fclose(FILE *stream);
unsigned long fread(void *ptr, unsigned long size, unsigned long n, FILE *stream);
unsigned long fwrite(void *ptr, unsigned long size, unsigned long n, FILE *stream);
int fflush(FILE *stream);
int fgetc(FILE *stream);
char *fgets(char *s, int n, FILE *stream);
int getc(FILE *stream);
int ungetc(int c, FILE *stream);
int feof(FILE *stream);
int ferror(FILE *stream);
void clearerr(FILE *stream);
int fseek(FILE *stream, long offset, int whence);
long ftell(FILE *stream);
void rewind(FILE *stream);
int setvbuf(FILE *stream, char *buf, int mode, unsigned long size);
void setbuf(FILE *stream, char *buf);
FILE *freopen(char *path, char *mode, FILE *stream);
FILE *tmpfile(void);
char *tmpnam(char *s);
int fscanf(FILE *stream, char *fmt, ...);
void perror(char *s);
int remove(char *path);
int rename(char *oldp, char *newp);
#endif
@}

