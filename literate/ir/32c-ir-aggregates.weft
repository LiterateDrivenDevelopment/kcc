% 32c-ir-aggregates.weft — IR lowering of aggregate/variable declarations
%
% Split from 32-ir-builder.weft (structural refactor, no content changes):
% struct copy/address helpers, aggregate + designated + string init, static
% locals, and the variable-declaration builder.

\section{Building Variable Declarations}
\label{sec:ir-aggregates}

A variable declaration emits \texttt{IR\_ALLOCA} to reserve a stack
slot, then records the mapping \texttt{name $\to$ vreg+1} in the
locals hash table (the \texttt{+1} bias lets zero represent ``not
found'').  If the declaration carries an initialiser, the builder
evaluates the expression and emits \texttt{IR\_STORE} to write the
initial value into the alloca.  The type is resolved via
\texttt{\_kcc\_sema\_resolve\_type}; if resolution fails, the
builder falls back to \texttt{i32}.

\paragraph{Pointer tagging.}
The locals entry carries a one-bit annotation in bit~63 of its value:
set for pointer \emph{variables}, clear for arrays and scalars.  The
subscript builder reads this bit to choose its addressing mode---a
pointer variable is loaded and then offset, whereas an array is
indexed directly from its alloca base (\S\ref{sec:ir-subscript}).
The distinction must be drawn from the \emph{declared} type, which is
why the flag is captured at \texttt{.Libvd\_alloca} before the array
branch overwrites the working type register with the element type.
Were the bit derived after that point, an array of pointers such as
\texttt{int *a[N]} would inherit its element's \texttt{TY\_PTR} kind
and be mistaken for a pointer variable; subscripting would then load
\texttt{a[0]}'s contents as a base address and compute a wild
pointer.  An array is an array regardless of what it holds, so the
flag reflects only the top-level declared kind.

\paragraph{Struct copy.}
When the declared type is \texttt{TY\_STRUCT}, a single load/store
would copy only the first 8-byte slot.  Instead, the builder
resolves the source struct's base address---an alloca vreg for
locals or a \texttt{global\_ref} for globals---and calls
\texttt{\_kcc\_ir\_emit\_struct\_copy}, which emits a
\texttt{GEP$+$LOAD$+$GEP$+$STORE} sequence walking the object in
descending power-of-two chunks: as many 8-byte transfers as fit,
then a 4-byte, 2-byte, and 1-byte tail as the size requires, for
\emph{exactly} \texttt{TY\_SIZE} bytes.  An earlier version copied
\texttt{ceil(TY\_SIZE/8)} whole 8-byte slots on the theory that an
aggregate's storage is always rounded up to a slot, so the trailing
padding belonged to the object.  That assumption fails for a struct
stored into a \emph{packed} location---an element of an array of
sub-8-byte structs, such as zlib's Huffman decode table
(\texttt{code table[]} with \texttt{sizeof(code)==4}): an 8-byte
store to \texttt{table[i]} silently overwrote the first four bytes of
\texttt{table[i+1]}, corrupting the decode tables so inflation failed.
Copying the exact size also avoids reading past a caller's struct on a
by-value or \texttt{sret} copy.  The tail transfers use the narrow
load/store access-size codes (word/half/byte), so the copy stays
independent of the packed field layout.  The same helper is reused by
the assignment builder for statements like \texttt{cur = saved;}.

@d IR: struct copy helper @{
// -- kcc_ir_emit_struct_copy ----------------------------------------------
// void kcc_ir_emit_struct_copy(src_base_vreg, dst_base_vreg, byte_size)
//   x0 = source base vreg
//   x1 = destination base vreg
//   x2 = number of bytes to copy (TY_SIZE, exact)
// Emits GEP+LOAD+GEP+STORE per chunk, choosing the largest power-of-two
// transfer (8/4/2/1 bytes) that still fits in the remaining bytes so the
// copy touches exactly byte_size bytes and never spills into a neighbour.
.text
.globl _kcc_ir_emit_struct_copy
.p2align 2
_kcc_ir_emit_struct_copy:
    stp x29, x30, [sp, #-96]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    stp x25, x26, [sp, #64]

    mov x19, x0                  // src base vreg
    mov x20, x1                  // dst base vreg
    str x2, [sp, #80]            // total byte size
    mov x22, #0                  // current byte offset

.Liesc_loop:
    ldr x0, [sp, #80]
    sub x0, x0, x22              // remaining bytes
    cmp x0, #0
    b.le .Liesc_done

    // Pick the largest chunk (x25) that fits, and its access-size code (x26):
    // 8→0 (default 64-bit), 4→4 (word), 2→2 (half), 1→1 (byte).
    cmp x0, #8
    b.ge .Liesc_c8
    cmp x0, #4
    b.ge .Liesc_c4
    cmp x0, #2
    b.ge .Liesc_c2
    mov x25, #1
    mov x26, #1
    b .Liesc_have
.Liesc_c8:
    mov x25, #8
    mov x26, #0
    b .Liesc_have
.Liesc_c4:
    mov x25, #4
    mov x26, #4
    b .Liesc_have
.Liesc_c2:
    mov x25, #2
    mov x26, #2
.Liesc_have:

    // IR_CONST byte offset = current offset (stride-1 GEP adds it directly)
    mov x0, #IR_CONST
    bl _kcc_ir_alloc_instr
    mov x21, x0
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x21, #IR_TYPE]
    str x22, [x21, #IR_SRC1]
    bl _kcc_ir_next_vreg
    str x0, [x21, #IR_DEST]
    mov x24, x0                  // x24 = idx_vreg
    mov x0, x21
    bl _kcc_ir_emit

    // IR_GEP src_base, idx → src element address
    mov x0, #IR_GEP
    bl _kcc_ir_alloc_instr
    mov x21, x0
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x21, #IR_TYPE]
    str x19, [x21, #IR_SRC1]
    str x24, [x21, #IR_SRC2]
    bl _kcc_ir_next_vreg
    str x0, [x21, #IR_DEST]
    mov x23, x0                  // x23 = src_elem vreg
    mov x0, x21
    bl _kcc_ir_emit

    // IR_LOAD src_elem → value, with the chunk's access-size code
    mov x0, #IR_LOAD
    bl _kcc_ir_alloc_instr
    mov x21, x0
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x21, #IR_TYPE]
    str x23, [x21, #IR_SRC1]
    str x26, [x21, #IR_SRC2]     // load access-size code
    bl _kcc_ir_next_vreg
    str x0, [x21, #IR_DEST]
    mov x23, x0                  // x23 = val vreg
    mov x0, x21
    bl _kcc_ir_emit

    // IR_GEP dst_base, idx → dst element address
    mov x0, #IR_GEP
    bl _kcc_ir_alloc_instr
    mov x21, x0
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x21, #IR_TYPE]
    str x20, [x21, #IR_SRC1]
    str x24, [x21, #IR_SRC2]
    bl _kcc_ir_next_vreg
    str x0, [x21, #IR_DEST]
    mov x24, x0                  // x24 = dst_elem vreg
    mov x0, x21
    bl _kcc_ir_emit

    // IR_STORE value → dst element, with the chunk's access-size code
    mov x0, #IR_STORE
    bl _kcc_ir_alloc_instr
    mov x21, x0
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x21, #IR_TYPE]
    str x23, [x21, #IR_SRC1]
    str x24, [x21, #IR_SRC2]
    str x26, [x21, #IR_DEST]     // store access-size code
    mov x0, x21
    bl _kcc_ir_emit

    add x22, x22, x25            // advance by the chunk size
    b .Liesc_loop

.Liesc_done:
    ldp x25, x26, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #96
    ret
@| _kcc_ir_emit_struct_copy
@}

\paragraph{The address of a struct value.}
Both struct return (\S\ref{sec:struct-return}) and struct
pass-by-value (\S\ref{sec:struct-args}) need the \emph{address} of a
struct-valued expression rather than a loaded scalar, because an
aggregate never fits a single register.
\texttt{\_kcc\_ir\_build\_struct\_addr} centralises that resolution:
an identifier yields its alloca vreg (or a \texttt{global\_ref} for a
file-scope struct), a call yields the address of its own result buffer
(the struct-return path already returns exactly that), and
\texttt{.f}/\texttt{[i]} lvalues reuse the member and subscript address
builders.  A parenthesised expression is unwrapped and re-dispatched.
Anything else falls back to \texttt{build\_expr}, which for a pointer
operand already produces an address.

@d IR: struct address helper @{
// -- kcc_ir_build_struct_addr ---------------------------------------------
// uint64_t kcc_ir_build_struct_addr(node *expr)
//   x0 = expression node of struct type
//   returns x0 = vreg holding the struct's base address (0 if unknown)
.text
.globl _kcc_ir_build_struct_addr
.p2align 2
_kcc_ir_build_struct_addr:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    mov x19, x0
    cbz x19, .Libsad_zero
    ldr x1, [x19, #AST_TAG]
    cmp x1, #AST_PAREN_EXPR
    b.ne .Libsad_dispatch
    ldr x19, [x19, #AST_F0]      // unwrap parentheses
    cbz x19, .Libsad_zero
    ldr x1, [x19, #AST_TAG]

.Libsad_dispatch:
    cmp x1, #AST_IDENT_EXPR
    b.eq .Libsad_ident
    cmp x1, #AST_CALL_EXPR
    b.eq .Libsad_call
    cmp x1, #AST_MEMBER
    b.eq .Libsad_member
    cmp x1, #AST_SUBSCRIPT
    b.eq .Libsad_subscript
    cmp x1, #AST_UNARY_EXPR
    b.eq .Libsad_deref
    cmp x1, #AST_COMPOUND_LIT
    b.eq .Libsad_compound
    mov x0, x19
    bl _kcc_ir_build_expr        // fallback: operand already yields an address
    b .Libsad_done

.Libsad_compound:
    // A compound literal is an lvalue; its materialised object's address is
    // exactly what a struct address wants (used by `&(T){...}`, member access
    // on a literal, and struct-copy initialisers).
    mov x0, x19
    bl _kcc_ir_build_compound_lit
    b .Libsad_done

.Libsad_deref:
    // `*p` (a dereferenced pointer to a struct): the pointer's VALUE is the
    // struct's address, so build the pointer operand---not the deref, which
    // would emit a struct load.  Any other unary operator falls back.
    ldr x1, [x19, #AST_F0]      // unary op token
    cmp x1, #TOK_STAR
    b.ne .Libsad_fallback
    ldr x0, [x19, #AST_F1]      // pointer operand
    bl _kcc_ir_build_expr
    b .Libsad_done
.Libsad_fallback:
    mov x0, x19
    bl _kcc_ir_build_expr
    b .Libsad_done

.Libsad_ident:
    ldr x20, [x19, #AST_F0]      // name ptr
    mov x0, x20
    bl _kcc_strlen
    mov x2, x0
    adrp x0, _kcc_ir_locals@@PAGE
    add  x0, x0, _kcc_ir_locals@@PAGEOFF
    ldr x0, [x0]
    mov x1, x20
    bl _kcc_ht_get
    cbz x0, .Libsad_global
    bic x0, x0, #0x8000000000000000
    sub x0, x0, #1               // local: alloca vreg is the struct base
    b .Libsad_done

.Libsad_global:
    // File-scope struct: its address is a global reference.
    mov x0, #IR_GLOBAL_REF
    bl _kcc_ir_alloc_instr
    str x20, [x0, #IR_SRC1]      // symbol name
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    mov x19, x0
    bl _kcc_ir_next_vreg
    str x0, [x19, #IR_DEST]
    mov x20, x0
    mov x0, x19
    bl _kcc_ir_emit
    mov x0, x20
    b .Libsad_done

.Libsad_call:
    mov x0, x19
    bl _kcc_ir_build_call        // struct-returning call → result buffer address
    b .Libsad_done

.Libsad_member:
    mov x0, x19
    bl _kcc_ir_build_member_addr
    b .Libsad_done

.Libsad_subscript:
    mov x0, x19
    bl _kcc_ir_build_subscript_addr
    b .Libsad_done

.Libsad_zero:
    mov x0, #0

.Libsad_done:
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_ir_build_struct_addr
@}

\paragraph{Aggregate initializer lists.}
A brace-enclosed initializer such as \texttt{int a[3] = \{10, 20, 30\}}
or \texttt{struct P p = \{3, 4\}} is parsed into an
\texttt{AST\_INIT\_LIST} whose elements hang off \texttt{F0} and chain
through \texttt{F4}.  In the all-spill model an array element and a
struct field alike occupy one eight-byte slot at their ordinal
position, so a single loop lowers both aggregate kinds: element~$i$ of
the list is written to slot~$i$ of the destination.  Two small helpers
support this.  \texttt{\_kcc\_ir\_initlist\_count} counts the top-level
elements---used to size an implicitly-bounded array
(\texttt{int a[] = \{\ldots\}}), whose length the declarator leaves
unspecified.  \texttt{\_kcc\_ir\_emit\_indexed\_store} emits the
\texttt{IR\_CONST$+$IR\_GEP$+$IR\_STORE} triple that places one value
at a given index, factoring the register juggling out of the
declaration builder's loop.  The stride is the eight-byte slot, so
these writes are read back correctly by the subscript
(\S\ref{sec:ir-subscript}) and member-access lowerings.

When a list is shorter than the aggregate (\texttt{int a[4] = \{5,
6\}}), \stdref{6.7.9} requires the unmentioned elements to be
initialised as if they had static storage duration---that is, to
zero.  The builder therefore records the total slot count when it
sizes the alloca and, after the provided values are placed, stores a
single reused zero constant into every remaining slot.

\emph{Designated and nested initializers} (\stdref{6.7.9}) are emitted by
a small recursive family, so an arbitrarily deep aggregate is initialised
by descending it, not by a single flat loop.  After zero-filling the whole
region, \texttt{\_kcc\_ir\_fill\_list} walks a brace-delimited list against
the sub-objects of the target type, keeping a running ``current object''
position (\stdref{6.7.9p17--18}).  A plain element with its own brace, or a
scalar landing on a scalar sub-object, is written by
\texttt{\_kcc\_ir\_fill\_one}; a designation---which may now be a
\emph{chain} such as \texttt{.p.a}, \texttt{.arr[1]}, or
\texttt{[0].x}---is resolved by \texttt{\_kcc\_ir\_resolve\_designator},
which follows the \texttt{AST\_F2} links one sub-object at a time
(\texttt{\_kcc\_ir\_subobj} descending both the byte offset and the type)
to the leaf, and retargets the cursor to the first designator's position so
plain elements that follow resume from there.  The remaining subtlety is
\emph{brace elision} (\stdref{6.7.9p20}): when a plain scalar meets an
aggregate sub-object that has no brace of its own, the scalar and those
after it flow into that aggregate's leaves in order.
\texttt{\_kcc\_ir\_fill} models exactly this---it treats the list as a flat
stream and returns the next unconsumed element---so \texttt{int m[2][2] =
\{1,2,3,4\}} fills the four leaves left to right and \texttt{struct \{int a;
int r[2]; int b;\} = \{1,2,3,4\}} spills the middle two into the array.
Because the region was zero-filled first, a sparse list such as
\texttt{int a[6] = \{ [5] = 9 \}} still leaves the gaps at zero, and a
bit-field leaf keeps its read--modify--write because
\texttt{\_kcc\_ir\_subobj} publishes the resolved field for
\texttt{\_kcc\_ir\_store\_elem}.  An \emph{unnamed} bit-field
(\texttt{int :4}) is a layout-only member that reserves bits but takes no
initializer (\stdref{6.7.9}): the positional walk steps over its cursor
position without consuming an element, so \texttt{\{2,3,4\}} against
\texttt{struct \{int a:4; int :4; int b:4; int c:4;\}} fills
\texttt{a},~\texttt{b},~\texttt{c}---not the padding member---and the anonymous
slot stays zero.  String initialisers for character arrays
(\texttt{char s[] = "abc"}) take their own byte-copy path above.
File-scope aggregates share this exact machinery: their emitter
(\texttt{\_kcc\_ir\_emit\_aggregate\_init}, \S\ref{sec:global-inits}) is a
thin adapter that calls \texttt{\_kcc\_ir\_fill\_list} against the global's
materialised base address instead of a stack alloca, relying on zeroed BSS
in place of the explicit zero-fill, so designator chains and brace elision
work identically at file scope.

@d IR: aggregate init helpers @{
// -- kcc_ir_initlist_count ------------------------------------------------
// uint64_t kcc_ir_initlist_count(node *init_list)
//   x0 = AST_INIT_LIST node → number of array slots the list spans.  Plain
//   elements advance a running index; an `[i] =` designator resets it, so a
//   sparse list like { [9] = 1 } reports a length of 10.  The result is the
//   highest index reached plus one (used only for `int a[]` sizing).
.text
.globl _kcc_ir_initlist_count
.p2align 2
_kcc_ir_initlist_count:
    ldr x0, [x0, #AST_F0]       // first element
    mov x1, #0                  // running index
    mov x2, #0                  // max slots
.Lilc_loop:
    cbz x0, .Lilc_done
    ldr x3, [x0, #AST_TAG]
    cmp x3, #AST_DESIGNATOR
    b.ne .Lilc_step
    ldr x3, [x0, #AST_F1]       // is_field?
    cbnz x3, .Lilc_step         // a member designator does not move the index
    ldr x1, [x0, #AST_F0]       // [i] = : running index becomes i
.Lilc_step:
    add x1, x1, #1              // this element consumes slot (running-1)
    cmp x1, x2
    b.le .Lilc_nomax
    mov x2, x1
.Lilc_nomax:
    ldr x0, [x0, #AST_F4]
    b .Lilc_loop
.Lilc_done:
    mov x0, x2
    ret

// -- kcc_ir_emit_indexed_store --------------------------------------------
// void kcc_ir_emit_indexed_store(base_vreg, byte_offset, value_vreg, width)
//   x0 = base vreg, x1 = byte offset, x2 = value vreg, x3 = store width
//        (0 = 8-byte slot, else 1/2/4)
// Emits IR_CONST(byte_offset) + IR_GEP(base,offset) + IR_STORE(value,addr).
.text
.globl _kcc_ir_emit_indexed_store
.p2align 2
_kcc_ir_emit_indexed_store:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    str x23, [sp, #48]

    mov x19, x0                  // base vreg
    mov x20, x1                  // byte offset
    mov x21, x2                  // value vreg
    mov x22, x3                  // store width

    // IR_CONST byte offset
    mov x0, #IR_CONST
    bl _kcc_ir_alloc_instr
    mov x23, x0
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x23, #IR_TYPE]
    str x20, [x23, #IR_SRC1]     // const value = byte offset
    bl _kcc_ir_next_vreg
    str x0, [x23, #IR_DEST]
    mov x20, x0                  // x20 = offset vreg
    mov x0, x23
    bl _kcc_ir_emit

    // IR_GEP base + byte offset
    mov x0, #IR_GEP
    bl _kcc_ir_alloc_instr
    mov x23, x0
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x23, #IR_TYPE]
    str x19, [x23, #IR_SRC1]     // base pointer
    str x20, [x23, #IR_SRC2]     // byte offset vreg
    bl _kcc_ir_next_vreg
    str x0, [x23, #IR_DEST]
    mov x20, x0                  // x20 = element address vreg
    mov x0, x23
    bl _kcc_ir_emit

    // IR_STORE value -> element address (IR_DEST = access-size override)
    mov x0, #IR_STORE
    bl _kcc_ir_alloc_instr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    str x21, [x0, #IR_SRC1]      // value
    str x20, [x0, #IR_SRC2]      // address
    str x22, [x0, #IR_DEST]      // width override
    bl _kcc_ir_emit

    ldr x23, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret

// -- kcc_ir_elem_off_width ------------------------------------------------
// (byte_offset, width) kcc_ir_elem_off_width(type *ty, uint64_t index)
//   x0 = element type (array) or aggregate type (struct/union), x1 = index
// Returns x0 = byte offset of the index-th initializer element,
//         x1 = its store-width override.  For an array-element type the
//   stride is uniform (index * size); for a struct/union the offset comes
//   from the index-th field's laid-out AST_F3 and the width from its type.
.text
.globl _kcc_ir_elem_off_width
.p2align 2
_kcc_ir_elem_off_width:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    mov x19, x0                  // type
    mov x20, x1                  // index
    // Clear any previously published field; an array element has none.
    adrp x2, _kcc_ir_member_field@@PAGE
    add  x2, x2, _kcc_ir_member_field@@PAGEOFF
    str xzr, [x2]
    cbz x19, .Leow_scalar
    ldr x2, [x19, #TY_KIND]
    cmp x2, #TY_STRUCT
    b.eq .Leow_struct
    cmp x2, #TY_UNION
    b.eq .Leow_struct

    // Array element: uniform stride = index * sizeof(element)
    mov x0, x19
    bl _kcc_type_layout          // element size
    mul x21, x20, x0             // byte offset
    mov x0, x19
    bl _kcc_ir_store_width
    mov x1, x0                   // width
    mov x0, x21                  // offset
    b .Leow_ret

.Leow_scalar:
    lsl x0, x20, #3              // fallback: 8-byte slots
    mov x1, #0
    b .Leow_ret

.Leow_struct:
    mov x0, x19
    bl _kcc_type_layout          // ensure per-field offsets
    ldr x21, [x19, #TY_F0]       // struct decl
    cbz x21, .Leow_struct_zero
    ldr x21, [x21, #AST_F1]      // first field
.Leow_walk:
    cbz x21, .Leow_struct_zero
    cbz x20, .Leow_found
    ldr x21, [x21, #AST_F4]      // next field
    sub x20, x20, #1
    b .Leow_walk
.Leow_found:
    adrp x0, _kcc_ir_member_field@@PAGE
    add  x0, x0, _kcc_ir_member_field@@PAGEOFF
    str x21, [x0]                // publish the field for a possible bit-field store
    ldr x20, [x21, #AST_F3]      // field byte offset
    ldr x1, [x21, #AST_F0]       // field type spec
    cbz x1, .Leow_found_w0
    mov x0, x1
    bl _kcc_sema_resolve_type
    bl _kcc_ir_store_width
    mov x1, x0                   // width
    mov x0, x20                  // offset
    b .Leow_ret
.Leow_found_w0:
    mov x0, x20
    mov x1, #0
    b .Leow_ret
.Leow_struct_zero:
    mov x0, #0
    mov x1, #0
.Leow_ret:
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

// -- kcc_ir_field_index ---------------------------------------------------
// int64_t kcc_ir_field_index(type *aggregate, char *name)
//   x0 = struct/union type, x1 = interned member name
// Returns the zero-based position of the named member (so the positional
// offset machinery can be reused), or -1 if there is no such member.
.globl _kcc_ir_field_index
.p2align 2
_kcc_ir_field_index:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]
    mov x19, x1                  // name
    ldr x2, [x0, #TY_F0]         // struct decl
    cbz x2, .Lfi_notfound
    ldr x20, [x2, #AST_F1]       // first field
    mov x21, #0                  // index (callee-saved across strcmp)
.Lfi_loop:
    cbz x20, .Lfi_notfound
    ldr x0, [x20, #AST_F1]       // field name
    mov x1, x19
    bl _kcc_strcmp
    cbz x0, .Lfi_found
    ldr x20, [x20, #AST_F4]      // next field
    add x21, x21, #1
    b .Lfi_loop
.Lfi_found:
    mov x0, x21
    b .Lfi_ret
.Lfi_notfound:
    mov x0, #-1
.Lfi_ret:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

// -- kcc_ir_subobj --------------------------------------------------------
// (offset, width, sub_type) kcc_ir_subobj(type *agg, uint64_t index)
//   x0 = the *actual* aggregate type (array, struct, or union); x1 = the
//        position of a sub-object within it.
//   Returns x0 = the sub-object's byte offset inside `agg`, x1 = its store
//   access-size code, x2 = its type descriptor.  A struct/union position is
//   the index-th field (offset from its laid-out AST_F3); an array position
//   is index * sizeof(element).  Also publishes the resolved field in
//   _kcc_ir_member_field (cleared for an array element) so a following
//   _kcc_ir_store_elem can detect a bit-field target.  This is the typed
//   companion to _kcc_ir_elem_off_width, which the recursive initializer
//   needs so it can descend into a nested aggregate sub-object.
.text
.globl _kcc_ir_subobj
.p2align 2
_kcc_ir_subobj:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]
    mov x19, x0                  // aggregate type
    mov x20, x1                  // index
    adrp x0, _kcc_ir_member_field@@PAGE
    add  x0, x0, _kcc_ir_member_field@@PAGEOFF
    str xzr, [x0]                // default: no bit-field field published
    cbz x19, .Lso_void
    ldr x2, [x19, #TY_KIND]
    cmp x2, #TY_ARRAY
    b.eq .Lso_array
    cmp x2, #TY_STRUCT
    b.eq .Lso_struct
    cmp x2, #TY_UNION
    b.eq .Lso_struct
    // Scalar (or a braced scalar `int x = {5}`): one element of `agg` itself.
    mov x0, x19
    bl _kcc_type_layout          // size
    mul x20, x20, x0             // offset = index * size
    mov x0, x19
    bl _kcc_ir_store_width       // width
    mov x1, x0
    mov x0, x20                  // offset
    mov x2, x19                  // sub_type = the scalar itself
    b .Lso_ret
.Lso_void:
    lsl x0, x20, #3              // no type: fall back to 8-byte slots
    mov x1, #0
    mov x2, #0
    b .Lso_ret
.Lso_array:
    ldr x21, [x19, #TY_F0]       // element type = sub_type
    mov x0, x21
    bl _kcc_type_layout          // element size
    mul x20, x20, x0             // offset = index * element size
    mov x0, x21
    bl _kcc_ir_store_width       // width
    mov x1, x0
    mov x0, x20                  // offset
    mov x2, x21                  // sub_type
    b .Lso_ret
.Lso_struct:
    mov x0, x19
    bl _kcc_type_layout          // ensure per-field offsets
    ldr x21, [x19, #TY_F0]       // struct decl
    cbz x21, .Lso_zero
    ldr x21, [x21, #AST_F1]      // first field
.Lso_walk:
    cbz x21, .Lso_zero
    cbz x20, .Lso_found
    ldr x21, [x21, #AST_F4]      // next field
    sub x20, x20, #1
    b .Lso_walk
.Lso_found:
    adrp x0, _kcc_ir_member_field@@PAGE
    add  x0, x0, _kcc_ir_member_field@@PAGEOFF
    str x21, [x0]                // publish for a possible bit-field store
    ldr x1, [x21, #AST_F0]       // field type spec
    cbz x1, .Lso_found_w0
    mov x0, x1
    bl _kcc_sema_resolve_type    // x0 = sub_type
    mov x20, x0                  // hold sub_type across store_width
    bl _kcc_ir_store_width       // x0 = width (reads x0 = sub_type)
    mov x1, x0                   // width
    ldr x0, [x21, #AST_F3]       // field byte offset
    mov x2, x20                  // sub_type
    b .Lso_ret
.Lso_found_w0:
    ldr x0, [x21, #AST_F3]       // offset
    mov x1, #0                   // width
    mov x2, #0                   // sub_type
    b .Lso_ret
.Lso_zero:
    mov x0, #0
    mov x1, #0
    mov x2, #0
.Lso_ret:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

// -- kcc_ir_resolve_designator --------------------------------------------
// (offset, sub_type, first_pos, field)
//     kcc_ir_resolve_designator(type *agg, uint64_t base_off, node *desig)
//   x0 = the aggregate type the designation applies to; x1 = its base byte
//        offset; x2 = the head AST_DESIGNATOR of a designator chain (linked
//        through AST_F2, e.g. `.p.a`, `.arr[1]`, `[0].x`).
//   Walks the chain, descending one sub-object per designator, and returns
//   x0 = the absolute byte offset of the designated leaf, x1 = its type,
//   x2 = the *first* designator's position (so plain elements that follow in
//   the enclosing list resume from there), x3 = the leaf field descriptor
//   (0 for an array leaf) for bit-field-aware storage.
.text
.globl _kcc_ir_resolve_designator
.p2align 2
_kcc_ir_resolve_designator:
    stp x29, x30, [sp, #-80]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    mov x19, x0                  // cur_type
    mov x20, x1                  // cur_off (absolute)
    mov x21, x2                  // current designator
    mov x22, #-1                 // first_pos sentinel
    mov x23, #0                  // leaf field
.Lrd_loop:
    cbz x21, .Lrd_done
    ldr x0, [x21, #AST_F1]       // is_field?
    cbz x0, .Lrd_index
    mov x0, x19                  // cur_type
    ldr x1, [x21, #AST_F0]       // member name
    bl _kcc_ir_field_index       // x0 = position (or -1)
    mov x24, x0                  // position
    b .Lrd_sub
.Lrd_index:
    ldr x24, [x21, #AST_F0]      // [i] : position = i
.Lrd_sub:
    mov x0, x19
    mov x1, x24
    bl _kcc_ir_subobj            // x0=off, x1=width, x2=sub_type; publishes field
    add x20, x20, x0             // cur_off += off
    mov x19, x2                  // descend: cur_type = sub_type
    adrp x0, _kcc_ir_member_field@@PAGE
    add  x0, x0, _kcc_ir_member_field@@PAGEOFF
    ldr x23, [x0]                // remember leaf field (last one wins)
    cmn x22, #1                  // first_pos still -1?
    b.ne .Lrd_next
    mov x22, x24                 // record the first position
.Lrd_next:
    ldr x21, [x21, #AST_F2]      // next designator in the chain
    b .Lrd_loop
.Lrd_done:
    mov x0, x20                  // absolute offset
    mov x1, x19                  // leaf type
    mov x2, x22                  // first position
    mov x3, x23                  // leaf field
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #80
    ret

// -- kcc_ir_agg_count -----------------------------------------------------
// uint64_t kcc_ir_agg_count(type *ty)
//   Number of sub-objects the brace-elision consumer must fill for an
//   aggregate: an array's element count, a struct's field count, 1 for a
//   union (elision fills only the first member) or a scalar.
.text
.globl _kcc_ir_agg_count
.p2align 2
_kcc_ir_agg_count:
    cbz x0, .Lac_one
    ldr x1, [x0, #TY_KIND]
    cmp x1, #TY_ARRAY
    b.eq .Lac_array
    cmp x1, #TY_STRUCT
    b.eq .Lac_struct
.Lac_one:
    mov x0, #1
    ret
.Lac_array:
    ldr x0, [x0, #TY_F1]         // element count
    ret
.Lac_struct:
    ldr x1, [x0, #TY_F0]         // struct decl
    cbz x1, .Lac_one
    ldr x1, [x1, #AST_F1]        // first field
    mov x0, #0
.Lac_sc:
    cbz x1, .Lac_scdone
    add x0, x0, #1
    ldr x1, [x1, #AST_F4]        // next field
    b .Lac_sc
.Lac_scdone:
    ret

// -- kcc_ir_fill_one ------------------------------------------------------
// void kcc_ir_fill_one(type *ty, base_alloca, uint64_t off, node, field)
//   Initialize the single object of type `ty` at `off` from ONE initializer
//   `node` (no stream elision).  A braced `node` fills `ty` from its own
//   sub-list; a scalar `node` whose target is an aggregate (a designator
//   naming an aggregate, `.m = 1`) elides from that point via _kcc_ir_fill;
//   an ordinary scalar leaf is stored at `ty`'s width, honouring `field`
//   for a bit-field.  This is the one place a value is actually emitted.
.text
.globl _kcc_ir_fill_one
.p2align 2
_kcc_ir_fill_one:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    mov x19, x0                  // ty
    mov x20, x1                  // base_alloca
    mov x21, x2                  // off
    mov x22, x3                  // node
    mov x23, x4                  // field
    cbz x22, .Lfo_done
    ldr x0, [x22, #AST_TAG]
    cmp x0, #AST_INIT_LIST
    b.eq .Lfo_list
    // Scalar node.  If its target type is an aggregate, elide into it.
    cbz x19, .Lfo_scalar
    ldr x0, [x19, #TY_KIND]
    cmp x0, #TY_STRUCT
    b.eq .Lfo_elide
    cmp x0, #TY_UNION
    b.eq .Lfo_elide
    cmp x0, #TY_ARRAY
    b.eq .Lfo_elide
.Lfo_scalar:
    mov x0, x22
    bl _kcc_ir_build_expr
    mov x24, x0                  // value vreg
    adrp x0, _kcc_ir_member_field@@PAGE
    add  x0, x0, _kcc_ir_member_field@@PAGEOFF
    str x23, [x0]                // republish field (build_expr may clear it)
    mov x0, x19
    bl _kcc_ir_store_width
    mov x3, x0                   // width
    mov x0, x20                  // base
    mov x1, x21                  // offset
    mov x2, x24                  // value
    bl _kcc_ir_store_elem
    b .Lfo_done
.Lfo_list:
    ldr x3, [x22, #AST_F0]       // sub-list head
    mov x0, x19
    mov x1, x20
    mov x2, x21
    bl _kcc_ir_fill_list
    b .Lfo_done
.Lfo_elide:
    mov x0, x19
    mov x1, x20
    mov x2, x21
    mov x3, x22
    bl _kcc_ir_fill              // consume this one node into the aggregate
.Lfo_done:
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@}

\paragraph{Compound literals.}
A compound literal \texttt{(T)\{\ldots\}} (\stdref{6.5.2.5}) denotes an
unnamed object of type \texttt{T} initialised by the brace list.  Inside a
function it has automatic storage, so
\texttt{\_kcc\_ir\_build\_compound\_lit} materialises exactly what a local
aggregate declaration would: an \texttt{alloca} of the right size, a
slot-by-slot zero-fill, then \texttt{\_kcc\_ir\_fill\_list} to place the
initializer (designators and brace elision included).  A compound literal is
an \emph{lvalue}, so the builder returns the vreg holding the object's
\emph{address}; a caller wanting the value (a scalar literal, or a member
access on it) loads through that address, while aggregate uses --- the common
case, \texttt{\&(struct S)\{1,2\}} or passing one by value --- take the
address directly.  A file-scope compound literal is a different animal (static
storage), handled in the global-initializer path.

@d IR: aggregate init helpers @{
// -- kcc_ir_build_compound_lit --------------------------------------------
// uint64_t kcc_ir_build_compound_lit(node *cl)
//   x0 = AST_COMPOUND_LIT (F0 = type, F1 = brace init list)
// Returns the vreg holding the address of the materialised automatic object.
.text
.globl _kcc_ir_build_compound_lit
.p2align 2
_kcc_ir_build_compound_lit:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    mov x19, x0                  // compound-literal node
    ldr x0, [x19, #AST_F0]       // type node
    bl _kcc_sema_resolve_type
    mov x21, x0                  // object type
    cbz x21, .Lbcl_zero

    // Slot count = ceil(TY_SIZE / 8), at least one.
    mov x0, x21
    bl _kcc_type_layout          // byte size
    add x0, x0, #7
    lsr x24, x0, #3
    cbnz x24, .Lbcl_alloca
    mov x24, #1
.Lbcl_alloca:
    mov x0, #IR_ALLOCA
    bl _kcc_ir_alloc_instr
    str x21, [x0, #IR_TYPE]
    str x24, [x0, #IR_SRC1]      // slot count
    mov x22, x0
    bl _kcc_ir_next_vreg
    str x0, [x22, #IR_DEST]
    mov x23, x0                  // x23 = alloca vreg (the object's address)
    mov x0, x22
    bl _kcc_ir_emit

    // Zero the whole object, so a sparse initializer leaves zeros (§6.7.9).
    mov x0, #IR_CONST
    bl _kcc_ir_alloc_instr
    mov x22, x0
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x22, #IR_TYPE]
    str xzr, [x22, #IR_SRC1]
    bl _kcc_ir_next_vreg
    str x0, [x22, #IR_DEST]
    mov x20, x0                  // zero vreg
    mov x0, x22
    bl _kcc_ir_emit
    mov x22, #0                  // slot index
.Lbcl_zf:
    cmp x22, x24
    b.ge .Lbcl_fill
    mov x0, x23                  // base
    lsl x1, x22, #3             // byte offset = slot * 8
    mov x2, x20                  // zero vreg
    mov x3, #0                   // 8-byte slot
    bl _kcc_ir_emit_indexed_store
    add x22, x22, #1
    b .Lbcl_zf

.Lbcl_fill:
    ldr x0, [x19, #AST_F1]       // brace init list
    cbz x0, .Lbcl_ret            // no list → the zeroed object stands
    ldr x1, [x0, #AST_TAG]
    cmp x1, #AST_INIT_LIST
    b.ne .Lbcl_scalar
    ldr x3, [x0, #AST_F0]        // list head
    mov x0, x21                  // object type
    mov x1, x23                  // base alloca
    mov x2, #0                   // base offset
    bl _kcc_ir_fill_list
    b .Lbcl_ret
.Lbcl_scalar:
    // A non-brace initializer (a scalar compound literal whose value the
    // parser did not wrap in a list): store it into the single object.
    mov x3, x0                   // init node
    mov x0, x21                  // type
    mov x1, x23                  // base alloca
    mov x2, #0                   // offset
    mov x4, #0                   // no bit-field
    bl _kcc_ir_fill_one
.Lbcl_ret:
    mov x0, x23                  // address of the object
    b .Lbcl_done
.Lbcl_zero:
    mov x0, #0
.Lbcl_done:
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@| _kcc_ir_build_compound_lit
@}

@d IR: aggregate init helpers @{
// -- kcc_ir_fill ----------------------------------------------------------
// node *kcc_ir_fill(type *ty, base_alloca, uint64_t off, node *elem)
//   Brace-elision stream consumer.  Fills the object of type `ty` at `off`
//   by drawing elements from the flat list stream starting at `elem`, and
//   returns the next unconsumed element.  A scalar `ty` consumes exactly
//   one element; an aggregate with no brace of its own recurses across its
//   sub-objects, so `int m[2][2] = {1,2,3,4}` flows the four scalars into
//   the four leaves in order (\stdref{6.7.9p20}).
.text
.globl _kcc_ir_fill
.p2align 2
_kcc_ir_fill:
    stp x29, x30, [sp, #-80]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    str x25, [sp, #64]
    mov x19, x0                  // ty
    mov x20, x1                  // base_alloca
    mov x21, x2                  // off
    mov x22, x3                  // elem
    cbz x22, .Lfl_ret
    cbz x19, .Lfl_scalar
    ldr x0, [x19, #TY_KIND]
    cmp x0, #TY_STRUCT
    b.eq .Lfl_agg
    cmp x0, #TY_UNION
    b.eq .Lfl_agg
    cmp x0, #TY_ARRAY
    b.eq .Lfl_agg
.Lfl_scalar:
    mov x0, x19
    mov x1, x20
    mov x2, x21
    mov x3, x22
    mov x4, #0                   // elision has no bit-field context
    bl _kcc_ir_fill_one
    ldr x22, [x22, #AST_F4]      // consumed one element
    b .Lfl_ret
.Lfl_agg:
    // A struct/union VALUE element initializes this aggregate sub-object by a
    // whole-object COPY, not by brace elision: `struct A a = {2, b}` copies all
    // of the struct `b` into `a.b`.  Elision would instead splice b's fields one
    // scalar at a time and lose everything past the first.  Sema types init-list
    // elements, so the element's AST_F3 is its struct/union type; a matching
    // aggregate sub-object gets the copy.
    ldr x0, [x22, #AST_TAG]
    cmp x0, #AST_INIT_LIST
    b.eq .Lfl_agg_count          // its own braces → recurse/elide as before
    ldr x0, [x22, #AST_F3]       // element's resolved type
    cbz x0, .Lfl_agg_count
    ldr x1, [x0, #TY_KIND]
    cmp x1, #TY_STRUCT
    b.eq .Lfl_agg_copy
    cmp x1, #TY_UNION
    b.ne .Lfl_agg_count
.Lfl_agg_copy:
    mov x0, x20                  // base alloca
    mov x1, x21                  // sub-object byte offset
    bl _kcc_ir_emit_gep_const    // x0 = destination address vreg
    mov x23, x0                  // dst
    mov x0, x22                  // element expression (ident/member/call/…)
    bl _kcc_ir_build_struct_addr // x0 = source struct base address vreg
    mov x24, x0                  // src
    mov x0, x19                  // sub-object type
    bl _kcc_type_layout          // x0 = exact byte size
    mov x2, x0
    mov x0, x24                  // src
    mov x1, x23                  // dst
    bl _kcc_ir_emit_struct_copy
    ldr x22, [x22, #AST_F4]      // consumed one element
    b .Lfl_ret
.Lfl_agg_count:
    mov x0, x19
    bl _kcc_ir_agg_count
    mov x23, x0                  // number of sub-objects
    mov x24, #0                  // cursor
.Lfl_agg_loop:
    cbz x22, .Lfl_ret            // stream exhausted
    cmp x24, x23
    b.ge .Lfl_ret                // all positions filled
    mov x0, x19
    mov x1, x24
    bl _kcc_ir_subobj            // x0=off, x2=sub_type
    mov x25, x2                  // sub_type
    add x2, x21, x0              // absolute offset
    mov x0, x25                  // sub_type
    mov x1, x20                  // base
    mov x3, x22                  // elem
    bl _kcc_ir_fill              // consume; returns next element
    mov x22, x0
    add x24, x24, #1
    b .Lfl_agg_loop
.Lfl_ret:
    mov x0, x22                  // next unconsumed element (may be 0)
    ldr x25, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #80
    ret

// -- kcc_ir_fill_list -----------------------------------------------------
// void kcc_ir_fill_list(type *ty, base_alloca, uint64_t base_off, node *head)
//   Fill the aggregate `ty` at `base_off` from a brace-delimited element
//   list `head..`.  Walks a running cursor over `ty`'s sub-objects; a
//   designator chain retargets the cursor (and the value goes to the named
//   leaf), a plain element with an explicit brace or scalar-into-scalar
//   fills one sub-object, and a plain scalar whose sub-object is itself an
//   aggregate spills into it by brace elision (via _kcc_ir_fill).  Gaps left
//   by a sparse list keep the caller's zero-fill.
.text
.globl _kcc_ir_fill_list
.p2align 2
_kcc_ir_fill_list:
    stp x29, x30, [sp, #-96]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    stp x25, x26, [sp, #64]
    mov x19, x0                  // ty
    mov x20, x1                  // base_alloca
    mov x21, x2                  // base_off
    mov x22, x3                  // current element
    mov x23, #0                  // cursor position
.Lfll_loop:
    cbz x22, .Lfll_done
    ldr x0, [x22, #AST_TAG]
    cmp x0, #AST_DESIGNATOR
    b.ne .Lfll_plain
    // Designator chain: retarget the cursor and fill the named leaf.
    mov x0, x19
    mov x1, x21
    mov x2, x22
    bl _kcc_ir_resolve_designator  // x0=abs, x1=sub_type, x2=first_pos, x3=field
    mov x23, x2                  // cursor = first position
    mov x24, x0                  // absolute offset
    mov x25, x1                  // sub_type
    mov x26, x3                  // leaf field
    ldr x3, [x22, #AST_F3]       // value node (on the head)
    mov x0, x25
    mov x1, x20
    mov x2, x24
    mov x4, x26
    bl _kcc_ir_fill_one
    add x23, x23, #1
    ldr x22, [x22, #AST_F4]
    b .Lfll_loop
.Lfll_plain:
    mov x0, x19
    mov x1, x23                  // sub-object at the cursor
    bl _kcc_ir_subobj            // x0=off, x2=sub_type; publishes field
    mov x25, x2                  // sub_type
    add x24, x21, x0             // absolute offset
    adrp x0, _kcc_ir_member_field@@PAGE
    add  x0, x0, _kcc_ir_member_field@@PAGEOFF
    ldr x26, [x0]                // leaf field for this position
    // An unnamed bit-field (no name, non-zero width) reserves layout bits but
    // takes NO initializer (C17 6.7.9): step over its position without
    // consuming the current element, so `{2,3,4}` fills a, b, c -- not the
    // anonymous padding member in between.
    cbz x26, .Lfll_notanon
    ldr x0, [x26, #AST_F1]       // field name
    cbnz x0, .Lfll_notanon
    ldr x0, [x26, #AST_F2]       // packed bit-field width (0 = not a bit-field)
    cbz x0, .Lfll_notanon
    add x23, x23, #1             // advance the cursor, keep the element
    b .Lfll_loop
.Lfll_notanon:
    cbz x25, .Lfll_skip          // ran past the aggregate: ignore the element
    // Elision only when the sub-object is an aggregate AND the element is
    // not its own brace; otherwise one element fills this sub-object.
    ldr x0, [x22, #AST_TAG]
    cmp x0, #AST_INIT_LIST
    b.eq .Lfll_one
    ldr x0, [x25, #TY_KIND]
    cmp x0, #TY_STRUCT
    b.eq .Lfll_elide
    cmp x0, #TY_UNION
    b.eq .Lfll_elide
    cmp x0, #TY_ARRAY
    b.eq .Lfll_elide
.Lfll_one:
    mov x0, x25
    mov x1, x20
    mov x2, x24
    mov x3, x22
    mov x4, x26
    bl _kcc_ir_fill_one
    ldr x22, [x22, #AST_F4]
    b .Lfll_adv
.Lfll_elide:
    mov x0, x25
    mov x1, x20
    mov x2, x24
    mov x3, x22
    bl _kcc_ir_fill              // spill the stream into this aggregate
    mov x22, x0                  // next unconsumed element
    b .Lfll_adv
.Lfll_skip:
    ldr x22, [x22, #AST_F4]
.Lfll_adv:
    add x23, x23, #1
    b .Lfll_loop
.Lfll_done:
    ldp x25, x26, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #96
    ret
@| _kcc_ir_initlist_count
@| _kcc_ir_emit_indexed_store
@| _kcc_ir_elem_off_width
@| _kcc_ir_field_index
@| _kcc_ir_subobj
@| _kcc_ir_resolve_designator
@| _kcc_ir_agg_count
@| _kcc_ir_fill_one
@| _kcc_ir_fill
@| _kcc_ir_fill_list
@}

\subsection{Static Locals}
\label{sec:ir-static-locals}

A \texttt{static} local has block scope but static storage duration: it
is initialised once, before the program starts, and retains its value
across calls.  The all-spill model already has a natural home for such
storage---the BSS globals every ordinary file-scope variable uses---so
the builder \emph{hoists} each static local to a synthetic global
rather than giving it a stack alloca.

Two functions may each declare their own \texttt{static int i}, so the
hoisted global needs a name that is unique yet reproducible from the
declaration alone.  \texttt{\_kcc\_ir\_static\_name} supplies it by
formatting the declaration node's own address as
\texttt{sl\_}\\meta{16 hex digits}.  Because the name is a pure function
of the node pointer, the two passes that must agree on it---the
declaration builder, which records the mapping and suppresses the
alloca, and \texttt{\_kcc\_ir\_emit\_global\_inits}, which emits the
one-time initialiser at program start---derive the identical string
independently, with no shared table.  The symbol itself is created
lazily by the code generator when it lowers the first
\texttt{IR\_GLOBAL\_REF} that names it.

The declaration builder records \emph{two} things about a static local: the
name-to-mangled mapping in \texttt{\_kcc\_ir\_statics}, and, in the parallel
\texttt{\_kcc\_ir\_static\_types}, the declared type.  The type is needed
because an \emph{array} static must decay to its address (like a file-scope
global array) rather than be loaded as a scalar, and the block scope that
would tell the symbol table so is popped once semantic analysis finishes.  The
identifier-decay and subscript-address builders consult this table to route a
static array through the address path.  The code generator's static
pre-registration then reserves the array's real byte size, not the scalar
eight bytes the lazy \texttt{IR\_GLOBAL\_REF} fallback would give, so a static
array larger than a slot has correct storage.  (A brace initialiser on a
static \emph{aggregate} is still stored as a scalar and remains a gap.)

@d IR: static local helper @{
// -- kcc_ir_static_name ---------------------------------------------------
// char *kcc_ir_static_name(node *decl)
//   x0 = declaration node → arena string "sl_" + 16 hex digits of the node
//        pointer, the unique symbol name for this static local's global.
.text
.globl _kcc_ir_static_name
.p2align 2
_kcc_ir_static_name:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    mov x19, x0                  // node pointer = value to encode

    mov x0, #24
    bl _kcc_arena_alloc
    mov x20, x0

    mov w1, #'s'
    strb w1, [x20]
    mov w1, #'l'
    strb w1, [x20, #1]
    mov w1, #'_'
    strb w1, [x20, #2]

    add x2, x20, #3              // write cursor
    mov x3, #60                  // shift, most-significant nibble first
.Lisn_loop:
    lsr x4, x19, x3
    and x4, x4, #0xf
    cmp x4, #10
    b.lt .Lisn_dec
    add x4, x4, #87             // 'a' - 10
    b .Lisn_put
.Lisn_dec:
    add x4, x4, #48             // '0'
.Lisn_put:
    strb w4, [x2], #1
    subs x3, x3, #4
    b.ge .Lisn_loop

    strb wzr, [x2]               // null terminator

    mov x0, x20
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_ir_static_name
@}

@d IR: build var decl @{
// -- kcc_ir_build_var_decl ------------------------------------------------
// void kcc_ir_build_var_decl(node *decl)
//   x0 = AST_VAR_DECL (F0=type, F1=name, F2=init)
.text
.globl _kcc_ir_build_var_decl
.p2align 2
_kcc_ir_build_var_decl:
    stp x29, x30, [sp, #-80]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]

    mov x19, x0                  // x19 = decl node (KEEP)
    ldr x20, [x19, #AST_F1]     // x20 = name
    cbz x20, .Libvd_done

    // static local? hoist to a global instead of an alloca
    ldr x0, [x19, #AST_F3]      // storage class (3 = static)
    cmp x0, #3
    b.eq .Libvd_static

    // Resolve type
    ldr x0, [x19, #AST_F0]
    cbz x0, .Libvd_default_type
    bl _kcc_sema_resolve_type
    mov x21, x0
    cbnz x21, .Libvd_alloca
.Libvd_default_type:
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr x21, [x0]

.Libvd_alloca:
    // Pointer-variable flag from the declared type (before x21 is reassigned)
    mov x2, #0
    ldr x0, [x21, #TY_KIND]
    cmp x0, #TY_PTR
    b.ne .Libvd_ptrflag_done
    mov x2, #1
.Libvd_ptrflag_done:
    str x2, [sp, #64]

    // Determine alloca slot count: arrays need N slots, structs need field count, scalars need 1
    mov x24, #1                  // default: 1 slot
    ldr x0, [x21, #TY_KIND]
    cmp x0, #TY_ARRAY
    b.eq .Libvd_array
    cmp x0, #TY_STRUCT
    b.eq .Libvd_struct
    cmp x0, #TY_UNION
    b.eq .Libvd_struct           // a union is sized like a struct: ceil(TY_SIZE/8)
    b .Libvd_emit_alloca

.Libvd_array:
    ldr x24, [x21, #TY_F1]      // array length (0 if unspecified: int a[])
    ldr x22, [x21, #TY_F0]      // element type
    cbnz x24, .Libvd_array_scale
    // Implicit size — infer length from the initializer list element count
    ldr x0, [x19, #AST_F2]
    cbz x0, .Libvd_array_scale
    ldr x1, [x0, #AST_TAG]
    cmp x1, #AST_INIT_LIST
    b.ne .Libvd_array_scale
    bl _kcc_ir_initlist_count
    mov x24, x0
.Libvd_array_scale:
    mov x21, x22                // x21 = element type (for the alloca's IR_TYPE)
    cbz x24, .Libvd_emit_alloca
    // Byte-accurate: total bytes = length * element size, rounded up to
    // whole 8-byte slots.  int a[4] is 16 bytes → two slots (not four).
    mov x0, x22                 // element type
    bl _kcc_type_layout         // element size in bytes
    mul x24, x24, x0            // total bytes
    add x24, x24, #7
    lsr x24, x24, #3            // ceil(bytes / 8)
    b .Libvd_emit_alloca

.Libvd_struct:
    // Slot count = ceil(TY_SIZE / 8) over the packed struct/union size.  A union
    // is as large as its widest member, so a 16-byte `union{int i,j[4];}` needs
    // two slots; without this it fell to the 1-slot default and left the tail
    // past the first member unallocated and un-zeroed (garbage `t.j[2..3]`).
    mov x0, x21
    bl _kcc_ir_type_slots
    mov x24, x0

.Libvd_emit_alloca:
    str x24, [sp, #72]          // total slot count (for init-list zero-fill)

    // Emit alloca — SRC1 = slot count
    mov x0, #IR_ALLOCA
    bl _kcc_ir_alloc_instr
    str x21, [x0, #IR_TYPE]
    str x24, [x0, #IR_SRC1]     // slot count (1 for scalar, N for array)
    mov x22, x0                  // x22 = alloca instr
    bl _kcc_ir_next_vreg
    str x0, [x22, #IR_DEST]
    mov x23, x0                  // x23 = alloca vreg number
    mov x0, x22
    // Hoist the storage reservation to the entry block: a local's address must
    // dominate every use, but a switch case or goto label after this
    // declaration (yet inside the same block) can be entered directly, past
    // this point.  The initialising stores below stay where they are.
    bl _kcc_ir_emit_entry

    // Record in locals: name -> alloca vreg (bit 63 tags pointer variables)
    mov x0, x20
    bl _kcc_strlen
    mov x2, x0                   // keylen
    adrp x0, _kcc_ir_locals@@PAGE
    add  x0, x0, _kcc_ir_locals@@PAGEOFF
    ldr x0, [x0]
    mov x1, x20                  // key = name
    add x3, x23, #1              // value = alloca vreg + 1 (0 reserved for not-found)
    ldr x4, [sp, #64]            // pointer-variable flag
    cbz x4, .Libvd_put
    orr x3, x3, #0x8000000000000000
.Libvd_put:
    bl _kcc_ht_put

    // Check for initializer (x19 = decl node, still valid)
    ldr x0, [x19, #AST_F2]      // init expr
    cbz x0, .Libvd_done

    // Brace-enclosed aggregate initializer (arrays and flat structs)
    ldr x1, [x0, #AST_TAG]
    cmp x1, #AST_INIT_LIST
    b.eq .Libvd_initlist
    cmp x1, #AST_STR_LIT
    b.eq .Libvd_string_init

    // Struct/union types initialised from another aggregate value copy the
    // whole object; a scalar initializer (or an aggregate whose type failed to
    // resolve) takes the single-store path.
    ldr x1, [x21, #TY_KIND]
    cmp x1, #TY_STRUCT
    b.eq .Libvd_struct_init
    cmp x1, #TY_UNION
    b.eq .Libvd_struct_init
    b .Libvd_scalar_init

.Libvd_string_init:
    // char s[] = "abc" copies the bytes; char *s = "abc" (pointer) instead
    // holds the string's address, so only an array target takes the copy path.
    ldr x22, [x0, #AST_F0]      // str_ptr
    ldr x24, [x0, #AST_F1]      // str_len
    ldr x0, [x19, #AST_F0]      // declared type spec
    bl _kcc_sema_resolve_type
    cbz x0, .Libvd_str_scalar
    ldr x1, [x0, #TY_KIND]
    cmp x1, #TY_ARRAY
    b.ne .Libvd_str_scalar
    ldr x21, [x0, #TY_F1]       // array length (char → bytes)
    cbnz x21, .Libvd_str_call
    add x21, x24, #1
.Libvd_str_call:
    mov x0, x23                  // base alloca
    mov x1, x22                  // str_ptr
    mov x2, x24                  // str_len
    mov x3, x21                  // array_len
    mov x4, #1                   // zero-fill (local)
    bl _kcc_ir_emit_string_init
    b .Libvd_done
.Libvd_str_scalar:
    ldr x0, [x19, #AST_F2]      // reload init node (clobbered by resolve)

.Libvd_scalar_init:
    // Build initializer expression (scalar/pointer)
    ldr x24, [x0, #AST_F3]      // init expr's sema type (stash before building)
    str x24, [sp, #72]
    bl _kcc_ir_build_expr
    mov x24, x0                  // x24 = init value vreg

    // Convert across the int/float boundary if the declared type differs.
    ldr x1, [sp, #72]           // from = init type
    mov x2, x21                  // to = declared type
    bl _kcc_ir_convert
    mov x24, x0

    // Emit store: value -> alloca.  Set the access-size from the declared type
    // so the value is written at its true width; in particular a `float`, whose
    // 4-byte single representation differs from the double working format, is
    // narrowed and stored as 4 bytes (store_width → code 8) rather than as an
    // 8-byte double---otherwise `&f`/`sizeof`-4 copies of the local saw double
    // bytes (Lua's `string.pack("<f", …)` wrote zeros).
    mov x0, #IR_STORE
    bl _kcc_ir_alloc_instr
    mov x22, x0                  // x22 = store instr
    str x21, [x22, #IR_TYPE]     // type
    str x24, [x22, #IR_SRC1]     // value vreg
    str x23, [x22, #IR_SRC2]     // alloca vreg
    mov x0, x21                  // declared type → access-size code
    bl _kcc_ir_store_width
    str x0, [x22, #IR_DEST]      // access-size override
    mov x0, x22
    bl _kcc_ir_emit
    b .Libvd_done

.Libvd_struct_init:
    // x0 = init expr, x21 = struct/union type, x23 = dst alloca vreg.
    // A struct/union declared with an initializer that is itself a
    // struct/union value---`S a = b;`, `S a = *p;`, `S a = q.m;`, `S a = f();`,
    // `expdesc temp = *e1;`---is a whole-object COPY.  `_kcc_ir_build_struct_addr`
    // resolves the source's base address for every such shape (ident, call,
    // member, subscript, dereferenced pointer, parenthesised); copy exactly
    // TY_SIZE bytes.  Earlier this recognised only an identifier
    // and a call, and used the field count instead of the byte size---so a
    // union or a `= *p` initializer copied only the first word.  lcode's
    // `swapexps` (`expdesc temp = *e1;`) hit exactly that and crashed on `>`.
    bl _kcc_ir_build_struct_addr // x0 = source struct base address vreg
    mov x24, x0                  // src
    mov x0, x21
    bl _kcc_type_layout          // x0 = aggregate byte size
    mov x2, x0                    // byte size (exact)
    mov x0, x24                  // src
    mov x1, x23                  // dst = this variable's alloca
    bl _kcc_ir_emit_struct_copy
    b .Libvd_done

.Libvd_initlist:
    // x0 = AST_INIT_LIST; x23 = base alloca vreg; [sp,#72] = total slot count.
    // Zero the whole region first (slot by slot), then hand the list to the
    // recursive initializer, which descends into nested braces and follows
    // designator chains.  The declared aggregate type is resolved afresh
    // because x21 has been narrowed to the *element* type for an array; the
    // recursion needs the real array/struct type to size its sub-objects.
    mov x22, x0                  // init-list node (survives the zero-fill)
    ldr x0, [x19, #AST_F0]      // declared type spec
    bl _kcc_sema_resolve_type
    mov x21, x0                  // aggregate type (array/struct/union)

    ldr x24, [sp, #72]          // total slot count
    mov x0, #IR_CONST
    bl _kcc_ir_alloc_instr
    mov x19, x0                  // zero-const instr (decl node no longer needed)
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x19, #IR_TYPE]
    str xzr, [x19, #IR_SRC1]
    bl _kcc_ir_next_vreg
    str x0, [x19, #IR_DEST]
    mov x20, x0                  // zero vreg
    mov x0, x19
    bl _kcc_ir_emit

    mov x19, #0                  // slot index
.Libvd_il_zf_loop:
    cmp x19, x24
    b.ge .Libvd_il_emit
    mov x0, x23                  // base
    lsl x1, x19, #3             // byte offset = slot * 8
    mov x2, x20                  // zero vreg
    mov x3, #0                   // width = 8-byte slot
    bl _kcc_ir_emit_indexed_store
    add x19, x19, #1
    b .Libvd_il_zf_loop

.Libvd_il_emit:
    ldr x3, [x22, #AST_F0]       // list head element
    mov x0, x21                  // aggregate type
    mov x1, x23                  // base alloca
    mov x2, #0                   // base offset
    bl _kcc_ir_fill_list
    b .Libvd_done

.Libvd_static:
    // Hoist: record source-name -> mangled global; skip alloca and init
    mov x0, x19
    bl _kcc_ir_static_name
    mov x21, x0                  // mangled name ptr

    mov x0, x20
    bl _kcc_strlen
    mov x2, x0                   // keylen (kept in x24 for the type table too)
    mov x24, x0
    adrp x0, _kcc_ir_statics@@PAGE
    add  x0, x0, _kcc_ir_statics@@PAGEOFF
    ldr x0, [x0]
    mov x1, x20                  // key = source name
    mov x3, x21                  // value = mangled name ptr
    bl _kcc_ht_put

    // Also record the declared type so the array-vs-pointer decision survives
    // the popped block scope (used by identifier decay and subscript).
    ldr x0, [x19, #AST_F0]      // declared type node
    cbz x0, .Libvd_done
    bl _kcc_sema_resolve_type
    cbz x0, .Libvd_done
    mov x3, x0                   // value = type descriptor
    adrp x0, _kcc_ir_static_types@@PAGE
    add  x0, x0, _kcc_ir_static_types@@PAGEOFF
    ldr x0, [x0]
    mov x1, x20                  // key = source name
    mov x2, x24                  // keylen
    bl _kcc_ht_put

.Libvd_done:
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #80
    ret
@| _kcc_ir_build_var_decl
@}

\paragraph{End-to-end tests.}
Each local variable declaration emits an \texttt{IR\_ALLOCA}
instruction, which the code generator maps to a unique 8-byte slot
in the function's stack frame at offset $-(16 + \text{vreg} \times 8)$
from the frame pointer.  An initialiser compiles to an
\texttt{IR\_STORE} that writes the value into the slot, and every
subsequent use compiles to an \texttt{IR\_LOAD} that reads it back.
These tests verify that distinct locals occupy distinct slots and
that values survive across intervening statements.

@d Test: codegen locals @{
echo ""
echo "--- Local Variables ---"

run_test "local variable" \
    "int main(void) { int x = 10; return x; }" 10

run_test "two locals" \
    "int main(void) { int a = 3; int b = 4; return a + b; }" 7

run_test "local reassignment" \
    "int main(void) { int x = 1; x = 42; return x; }" 42

run_test "char literal" \
    "int main(void) { char c = 'A'; return c; }" 65
@}

\paragraph{Multi-variable declarations.}
C allows several variables to share one set of declaration specifiers,
separated by commas: \texttt{int a=3, b=4;}.  The parser links the
declarators through \texttt{F4}; the compound-statement builder walks
the chain to its tail so that subsequent items are appended correctly.

@d Test: codegen multi-var @{
echo ""
echo "--- Multi-Variable Declarations ---"

run_test "multi-var basic" \
    "int main(void) { int a = 3, b = 4; return a + b; }" 7

run_test "multi-var three" \
    "int main(void) { int a = 1, b = 2, c = 3; return a + b + c; }" 6

run_test "multi-var after stmt" \
    "int main(void) { int x = 10; int a = 1, b = 2; return x + a + b; }" 13

run_test "multi-var before stmt" \
    "int main(void) { int a = 5, b = 6; int c = a + b; return c; }" 11

run_test "multi-var no init" \
    "int main(void) { int a = 7, b; b = 3; return a + b; }" 10

run_test "multi-var in loop" \
    "int main(void) { int s = 0; int i; for (i = 0; i < 3; i++) { int a = i, b = i + 1; s = s + a + b; } return s; }" 9
@}

@d Test: codegen unsigned @{
echo ""
echo "--- Unsigned and Extensions ---"

run_test "unsigned modulo" \
    "int main(void) { unsigned int a = 17; unsigned int b = 5; return a % b; }" 2

run_test "unsigned divide" \
    "int main(void) { unsigned int a = 100; unsigned int b = 7; return a / b; }" 14

run_test "unsigned less-than true" \
    "int main(void) { unsigned int a = 3; unsigned int b = 5; if (a < b) return 1; return 0; }" 1

run_test "unsigned less-than false" \
    "int main(void) { unsigned int a = 5; unsigned int b = 3; if (a < b) return 1; return 0; }" 0

run_test "unsigned less-equal true" \
    "int main(void) { unsigned int a = 5; unsigned int b = 5; if (a <= b) return 1; return 0; }" 1

run_test "unsigned less-equal false" \
    "int main(void) { unsigned int a = 6; unsigned int b = 5; if (a <= b) return 1; return 0; }" 0

run_test "char to int sext" \
    "int main(void) { char c = (char)200; int x = (int)c; if (x < 0) return 1; return 0; }" 1

run_test "unsigned char to int zext" \
    "int main(void) { unsigned char c = (unsigned char)200; int x = (int)c; return x - 200; }" 0
@}

