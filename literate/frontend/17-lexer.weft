    .quad _kcc_kw_s_noreturn,   9,  51
    .quad _kcc_kw_s_sassert,    14, 52
    .quad _kcc_kw_s_tlocal,     13, 53

.equ KW_COUNT, 44
.equ KW_ENTRY_BYTES, 24       // 3 quads per entry
@| _kcc_kw_s_auto
