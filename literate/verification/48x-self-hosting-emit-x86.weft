S(s_retq, "\tretq\n"); S(s_movq, "\tmovq\t"); S(s_movabsq, "\tmovabsq\t$");
S(s_movl, "\tmovl\t"); S(s_movb, "\tmovb\t"); S(s_movw, "\tmovw\t");
S(s_movslq, "\tmovslq\t"); S(s_movsbq, "\tmovsbq\t"); S(s_movswq, "\tmovswq\t");
S(s_movzbq, "\tmovzbq\t"); S(s_movzwq, "\tmovzwq\t"); S(s_leaq, "\tleaq\t");
S(s_addq, "\taddq\t"); S(s_subq, "\tsubq\t"); S(s_imulq, "\timulq\t");
