% 27-sema.weft — Semantic Analysis
%
% This chapter implements the semantic analysis pass that walks the AST,
% resolves types, populates the symbol table, and checks type constraints.
% After this pass, every expression node has a resolved type in AST_F3.

\chapter{Semantic Analysis}
\label{ch:sema}

Parsing produces a syntactically valid AST, but many constraints in the C language are semantic rather than syntactic: an operand must have arithmetic type for \texttt{+}, a function call must match its prototype, and every identifier must resolve to a visible declaration.  This chapter implements the semantic analysis pass that enforces these rules.  It walks the AST top-down, resolves declaration types using the type system from Chapter~\ref{ch:types}, populates the symbol table from Chapter~\ref{ch:symtab}, and annotates every expression node with its resolved type.  The chapter is organized around three domains: declaration checking, statement checking, and expression checking.

\section{Entry Point}

The top-level entry point receives the \texttt{AST\_TRANS\_UNIT} node
and walks its linked list of declarations (chained via
\texttt{AST\_F4}).  For each declaration it delegates to
\texttt{\_kcc\_sema\_check\_decl}, which resolves types and
populates the symbol table.

@d Sema: check @{
// -- kcc_sema_check -------------------------------------------------------
// void kcc_sema_check(node *trans_unit)
//   x0 = AST_TRANS_UNIT node
// Walks all top-level declarations.
.text
.globl _kcc_sema_check
.p2align 2
_kcc_sema_check:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    // Get first declaration
    ldr x19, [x0, #AST_F0]         // first decl

.Lsc_loop:
    cbz x19, .Lsc_done

    mov x0, x19
    bl _kcc_sema_check_decl

    // Next sibling
    ldr x19, [x19, #AST_F4]
    b .Lsc_loop

.Lsc_done:
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_sema_check
@}

\section{Type Resolution}

Type resolution converts parser-produced AST type nodes into the
canonical type descriptors from Chapter~\ref{ch:types}.  The
dispatcher handles nine type node kinds: built-in types use the
specifier bitmask to select a pre-allocated singleton; pointer, array,
and function types recurse into their children and call the
corresponding type constructor.  Struct and union nodes with a body
(field list) create a new type descriptor; those without a body are
forward references and look up the tag in the symbol table to find
the original definition.  Typedef names are resolved via
symbol table lookup, with two built-in exceptions that no declaration
introduces: the name \texttt{va\_list} and its GNU spelling
\texttt{\_\_builtin\_va\_list} both resolve to the opaque eight-byte pointer
the variadic builtins use (Section~\ref{sec:variadic-defs}), so a freestanding
\texttt{<stdarg.h>} needs no header support.  Qualified types are currently
passed through to the base type.  Any unrecognised or null type node falls back
to \texttt{int}.

@d Sema: resolve type @{
// -- kcc_sema_resolve_type ------------------------------------------------
// type_desc *kcc_sema_resolve_type(node *type_node)
//   x0 = AST type node (AST_TYPE_BUILTIN, AST_TYPE_PTR, etc.)
// Returns type descriptor pointer.
.text
.globl _kcc_sema_resolve_type
.p2align 2
_kcc_sema_resolve_type:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    cbz x0, .Lsrt_null
    mov x19, x0

    ldr x0, [x19, #AST_TAG]

    cmp x0, #AST_TYPE_BUILTIN
    b.eq .Lsrt_builtin
    cmp x0, #AST_TYPE_PTR
    b.eq .Lsrt_ptr
    cmp x0, #AST_TYPE_ARRAY
    b.eq .Lsrt_array
    cmp x0, #AST_TYPE_FUNC
    b.eq .Lsrt_func
    cmp x0, #AST_TYPE_STRUCT
    b.eq .Lsrt_struct
    cmp x0, #AST_TYPE_UNION
    b.eq .Lsrt_union
    cmp x0, #AST_TYPE_ENUM
    b.eq .Lsrt_enum
    cmp x0, #AST_TYPE_NAME
    b.eq .Lsrt_name
    cmp x0, #AST_TYPE_QUALS
    b.eq .Lsrt_quals
    cmp x0, #AST_TYPE_TYPEOF
    b.eq .Lsrt_typeof

    // Unknown type node → return int as fallback
    b .Lsrt_fallback

.Lsrt_typeof:
    // GNU typeof: F1=1 means the operand is a type-name (resolve it directly);
    // F1=0 means it is an expression, whose type is obtained by type-checking it
    // in this unevaluated context (sema does not emit code, so no side effects).
    //
    // The result is memoised in AST_F3.  This matters when the operand is an
    // expression naming a local: the type is resolved twice --- once in the sema
    // pass (symbol table populated, so the name resolves) and again later when
    // the IR builder re-resolves the declaration's type (by which point the
    // block's scope has been popped and the name would appear undeclared).
    // Caching the sema-pass result makes the second resolution a plain load, so
    // `__typeof__(local)` keeps the operand's true type instead of falling back
    // to int and emitting a spurious ``undeclared identifier'' diagnostic.
    ldr x2, [x19, #AST_F3]      // cached resolved type?
    cbnz x2, .Lsrt_typeof_cached
    ldr x1, [x19, #AST_F1]      // is_type
    ldr x0, [x19, #AST_F0]      // operand
    cbz x0, .Lsrt_fallback
    cbz x1, .Lsrt_typeof_expr
    bl _kcc_sema_resolve_type   // type-name → resolve
    cbz x0, .Lsrt_fallback
    str x0, [x19, #AST_F3]      // memoise
    b .Lsrt_done
.Lsrt_typeof_expr:
    bl _kcc_sema_expr           // expression → its resolved type
    cbz x0, .Lsrt_fallback
    str x0, [x19, #AST_F3]      // memoise
    b .Lsrt_done
.Lsrt_typeof_cached:
    mov x0, x2
    b .Lsrt_done

.Lsrt_builtin:
    // F0 = specifier bitmask
    ldr x0, [x19, #AST_F0]
    bl _kcc_type_from_specmask
    cbz x0, .Lsrt_fallback
    b .Lsrt_done

.Lsrt_ptr:
    // F0 = pointee type node
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_resolve_type
    bl _kcc_type_ptr
    b .Lsrt_done

.Lsrt_array:
    // F0 = element type node, F1 = size expr (or 0)
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_resolve_type
    mov x20, x0                     // element type

    // Array length: fold the size as an integer constant expression
    // (\stdref{6.7.6.2}).  A bare literal, but equally `31 + 1` or
    // `sizeof(int) * CHAR_BIT`, must reduce to its value; only a genuinely
    // absent size (`a[]`) is an incomplete array.  A size that is NOT a
    // constant expression is a variable-length array (`int a[n]`), which kcc
    // does not support: it is rejected with a diagnostic rather than folded to
    // a bogus fixed length (which would silently under-size the storage).  See
    // Appendix~\ref{ch:limitations}.
    ldr x1, [x19, #AST_F1]
    cbz x1, .Lsrt_array_incomplete
    mov x0, x1
    bl _kcc_expr_is_ice
    cbnz x0, .Lsrt_array_const
    // VLA: emit a diagnostic and treat the array as incomplete (the error count
    // fails the compile).
    ldr x0, [x19, #AST_LINE]
    ldr x1, [x19, #AST_COL]
    adrp x2, _kcc_sema_msg_vla@@PAGE
    add  x2, x2, _kcc_sema_msg_vla@@PAGEOFF
    bl _kcc_diag_error
    b .Lsrt_array_incomplete
.Lsrt_array_const:
    ldr x0, [x19, #AST_F1]
    bl _kcc_eval_const_int
    mov x1, x0                     // folded length
    b .Lsrt_array_make

.Lsrt_array_incomplete:
    mov x1, #0                      // incomplete array

.Lsrt_array_make:
    mov x0, x20
    bl _kcc_type_array
    b .Lsrt_done

.Lsrt_func:
    // AST_TYPE_FUNC: F0 = return type node, F1 = params (linked list),
    // F2 = variadic flag (0/1).  This node is produced by a grouped declarator
    // `(name)(params, ...)` and by function pointers---note the variadic flag
    // lives in F2 here, NOT in bit 0 of the params pointer (that packing is the
    // AST_FUNC_DECL convention).
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_resolve_type
    mov x20, x0                     // return type

    // Carry the parameter declaration list as the function type's param vec, so
    // the call site can convert and classify each argument by its parameter's
    // type---e.g. an integer argument to a \texttt{double} parameter needs an
    // int-to-double conversion and an SSE-class register.
    ldr x1, [x19, #AST_F1]          // params list
    bic x1, x1, #1                  // defensive: clear bit 0
    mov x0, x20                     // return type
    bl _kcc_type_func
    mov x20, x0                     // reuse x20 (return type consumed) = TY_FUNC

    // A variadic prototype records its fixed-parameter count in TY_QUALS (zero
    // means non-variadic); the call lowering reads it to place the variadic
    // tail on the stack.  Without this, EVERY variadic call through a grouped
    // declarator---which is how Lua declares its whole API, e.g.
    // `const char *(lua_pushfstring)(lua_State *, const char *, ...)`---was
    // treated as non-variadic and passed its arguments in registers, so the
    // callee read the stack and got garbage.  (Only x19/x20 are callee-saved
    // here, so the fixed-param walk uses caller-saved temporaries and makes no
    // calls.)
    ldr x2, [x19, #AST_F2]          // variadic flag
    cbz x2, .Lsrt_func_done
    ldr x2, [x19, #AST_F1]          // params list (clean)
    mov x3, #0                      // nfixed
.Lsrt_func_nfixed:
    cbz x2, .Lsrt_func_setq
    add x3, x3, #1
    ldr x2, [x2, #AST_F4]
    b .Lsrt_func_nfixed
.Lsrt_func_setq:
    str x3, [x20, #TY_QUALS]
.Lsrt_func_done:
    mov x0, x20
    b .Lsrt_done

.Lsrt_struct:
    // F0 = struct_decl AST node.  A bodyless reference looks up the tag; a body
    // resolves to a descriptor for that definition.
    ldr x20, [x19, #AST_F0]        // AST_STRUCT_DECL
    cbz x20, .Lsrt_fallback
    ldr x0, [x20, #AST_F1]         // fields
    cbz x0, .Lsrt_struct_fwd       // no body → forward-ref tag lookup
    // Body present.  If it is NAMED and the tag already resolves to THIS same
    // decl, reuse that descriptor rather than minting a second one.  A duplicate
    // descriptor shares the field AST nodes, and laying it out again re-runs
    // bit-field packing over an AST_F2 the first layout already replaced with a
    // packed (bit_offset<<16 | width) integer -- dereferencing that small value
    // as a width-expression pointer and crashing.  SQLite's `struct sqlite3`
    // nests a named `struct sqlite3InitInfo {...}` bit-field member exactly so.
    ldr x0, [x20, #AST_F0]         // tag name_ptr
    cbz x0, .Lsrt_struct_new       // anonymous body → must create fresh
    bl _kcc_strlen
    mov x1, x0                     // len
    ldr x0, [x20, #AST_F0]         // name
    bl _kcc_symtab_lookup_tag
    cbz x0, .Lsrt_struct_new       // tag not registered yet → create it
    ldr x1, [x0, #SYM_TYPE]
    cbz x1, .Lsrt_struct_new
    ldr x2, [x1, #TY_F0]           // registered descriptor's decl node
    cmp x2, x20                    // same definition as this one?
    b.ne .Lsrt_struct_new          // shadowing / different → fresh
    mov x0, x1                     // reuse the registered, already-laid-out desc
    b .Lsrt_done
.Lsrt_struct_fwd:
    // No fields: look up tag
    ldr x0, [x20, #AST_F0]         // tag name_ptr
    cbz x0, .Lsrt_struct_new
    mov x20, x0
    bl _kcc_strlen
    mov x1, x0
    mov x0, x20
    bl _kcc_symtab_lookup_tag
    cbz x0, .Lsrt_fallback
    ldr x0, [x0, #SYM_TYPE]        // sym → type descriptor
    b .Lsrt_done
.Lsrt_struct_new:
    mov x0, x20
    bl _kcc_type_struct
    b .Lsrt_done

.Lsrt_union:
    // Same logic as struct: a named body already registered as this same decl is
    // reused (avoiding a duplicate descriptor that would re-pack bit-fields); a
    // bodyless reference looks up the tag.
    ldr x20, [x19, #AST_F0]
    cbz x20, .Lsrt_fallback
    ldr x0, [x20, #AST_F1]
    cbz x0, .Lsrt_union_fwd        // no body → forward-ref tag lookup
    ldr x0, [x20, #AST_F0]         // tag name_ptr
    cbz x0, .Lsrt_union_new        // anonymous body → fresh
    bl _kcc_strlen
    mov x1, x0
    ldr x0, [x20, #AST_F0]
    bl _kcc_symtab_lookup_tag
    cbz x0, .Lsrt_union_new
    ldr x1, [x0, #SYM_TYPE]
    cbz x1, .Lsrt_union_new
    ldr x2, [x1, #TY_F0]           // registered descriptor's decl node
    cmp x2, x20
    b.ne .Lsrt_union_new           // shadowing / different → fresh
    mov x0, x1                     // reuse registered descriptor
    b .Lsrt_done
.Lsrt_union_fwd:
    ldr x0, [x20, #AST_F0]
    cbz x0, .Lsrt_union_new
    mov x20, x0
    bl _kcc_strlen
    mov x1, x0
    mov x0, x20
    bl _kcc_symtab_lookup_tag
    cbz x0, .Lsrt_fallback
    ldr x0, [x0, #SYM_TYPE]        // sym → type descriptor
    b .Lsrt_done
.Lsrt_union_new:
    mov x0, x20
    bl _kcc_type_union
    b .Lsrt_done

.Lsrt_enum:
    ldr x0, [x19, #AST_F0]
    bl _kcc_type_enum
    b .Lsrt_done

.Lsrt_name:
    // Typedef name: lookup in symbol table
    ldr x20, [x19, #AST_F0]        // interned name ptr
    cbz x20, .Lsrt_fallback
    mov x0, x20
    bl _kcc_strlen
    mov x1, x0                     // len
    mov x0, x20                    // name
    bl _kcc_symtab_lookup
    cbz x0, .Lsrt_name_builtin

    // Found symbol: return its type
    ldr x0, [x0, #SYM_TYPE]
    b .Lsrt_done

.Lsrt_name_builtin:
    // Built-in typedef va_list → an 8-byte pointer.  (No <stdarg.h>: the
    // variadic builtins below treat it as an opaque cursor into the stack.)
    // The GNU spelling __builtin_va_list (kernel <stdarg.h>) is an alias.
    mov x0, x20
    adrp x1, _kcc_sema_str_va_list@@PAGE
    add  x1, x1, _kcc_sema_str_va_list@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lsrt_va_list_ptr
    mov x0, x20
    adrp x1, _kcc_sema_str_builtin_va_list@@PAGE
    add  x1, x1, _kcc_sema_str_builtin_va_list@@PAGEOFF
    bl _kcc_strcmp
    cbnz x0, .Lsrt_fallback
.Lsrt_va_list_ptr:
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr x0, [x0]
    bl _kcc_type_ptr
    b .Lsrt_done

.Lsrt_quals:
    // F0 = base type node, F1 = qualifier flags.
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_resolve_type
    // Only volatile is honoured (it must not be optimized away); const and
    // restrict are still dropped, keeping the shared descriptors---and the code
    // that compares types by identity---untouched.  A volatile object gets a
    // fresh copy of the descriptor with the volatile bit set, so the qualifier
    // reaches the alloca and its loads and stores without disturbing the
    // canonical unqualified type.
    ldr x1, [x19, #AST_F1]
    and x1, x1, #2
    cbz x1, .Lsrt_done
    mov x20, x0                    // base descriptor (callee-saved)
    mov x0, #TY_DESC_SIZE
    bl _kcc_arena_alloc
    ldr x1, [x20, #0]
    str x1, [x0, #0]
    ldr x1, [x20, #8]
    str x1, [x0, #8]
    ldr x1, [x20, #16]
    str x1, [x0, #16]
    ldr x1, [x20, #24]
    str x1, [x0, #24]
    ldr x1, [x20, #32]
    str x1, [x0, #32]
    ldr x1, [x20, #40]
    str x1, [x0, #40]
    ldr x1, [x0, #TY_QUALS]
    orr x1, x1, #2               // mark volatile
    str x1, [x0, #TY_QUALS]
    b .Lsrt_done

.Lsrt_null:
.Lsrt_fallback:
    // Default to int
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr  x0, [x0]

.Lsrt_done:
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

.section __TEXT,__cstring,cstring_literals
_kcc_sema_msg_vla:
    .asciz "variable-length arrays are not supported"
.text
@| _kcc_sema_resolve_type
@}

\section{Dump Types}

The type dumper implements the \texttt{--dump-types} flag.  It walks
the top-level declaration list and prints each variable, function, or
typedef declaration together with its resolved type descriptor.  The
output format is:
\begin{verbatim}
var x: int
func main: int
typedef size_t = unsigned long
\end{verbatim}

@d Sema: dump types @{
// -- kcc_sema_dump_types --------------------------------------------------
// void kcc_sema_dump_types(node *trans_unit)
//   x0 = AST_TRANS_UNIT after semantic analysis
// Prints each declaration with resolved types.
.text
.globl _kcc_sema_dump_types
.p2align 2
_kcc_sema_dump_types:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    ldr x19, [x0, #AST_F0]         // first decl

.Lsdt_loop:
    cbz x19, .Lsdt_done

    // Print declaration info
    ldr x0, [x19, #AST_TAG]
    cmp x0, #AST_VAR_DECL
    b.eq .Lsdt_var
    cmp x0, #AST_FUNC_DECL
    b.eq .Lsdt_func
    cmp x0, #AST_TYPEDEF_DECL
    b.eq .Lsdt_typedef
    b .Lsdt_next

.Lsdt_var:
    adrp x0, _kcc_sema_str_var@@PAGE
    add  x0, x0, _kcc_sema_str_var@@PAGEOFF
    bl _kcc_io_puts

    // Print name
    ldr x0, [x19, #AST_F1]
    cbz x0, .Lsdt_var_type
    bl _kcc_io_puts

.Lsdt_var_type:
    adrp x0, _kcc_sema_str_colon@@PAGE
    add  x0, x0, _kcc_sema_str_colon@@PAGEOFF
    bl _kcc_io_puts

    // Resolve and print type
    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_resolve_type
    bl _kcc_type_dump

    adrp x0, _kcc_sema_str_nl@@PAGE
    add  x0, x0, _kcc_sema_str_nl@@PAGEOFF
    bl _kcc_io_puts
    b .Lsdt_next

.Lsdt_func:
    adrp x0, _kcc_sema_str_func@@PAGE
    add  x0, x0, _kcc_sema_str_func@@PAGEOFF
    bl _kcc_io_puts

    ldr x0, [x19, #AST_F1]
    cbz x0, .Lsdt_func_type
    bl _kcc_io_puts

.Lsdt_func_type:
    adrp x0, _kcc_sema_str_colon@@PAGE
    add  x0, x0, _kcc_sema_str_colon@@PAGEOFF
    bl _kcc_io_puts

    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_resolve_type
    bl _kcc_type_dump

    adrp x0, _kcc_sema_str_nl@@PAGE
    add  x0, x0, _kcc_sema_str_nl@@PAGEOFF
    bl _kcc_io_puts
    b .Lsdt_next

.Lsdt_typedef:
    adrp x0, _kcc_sema_str_typedef@@PAGE
    add  x0, x0, _kcc_sema_str_typedef@@PAGEOFF
    bl _kcc_io_puts

    ldr x0, [x19, #AST_F1]
    cbz x0, .Lsdt_td_type
    bl _kcc_io_puts

.Lsdt_td_type:
    adrp x0, _kcc_sema_str_eq@@PAGE
    add  x0, x0, _kcc_sema_str_eq@@PAGEOFF
    bl _kcc_io_puts

    ldr x0, [x19, #AST_F0]
    bl _kcc_sema_resolve_type
    bl _kcc_type_dump

    adrp x0, _kcc_sema_str_nl@@PAGE
    add  x0, x0, _kcc_sema_str_nl@@PAGEOFF
    bl _kcc_io_puts

.Lsdt_next:
    ldr x19, [x19, #AST_F4]
    b .Lsdt_loop

.Lsdt_done:
    bl _kcc_io_flush
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_sema_dump_types
@}

\section{Semantic Analysis Data}

Module-level state for semantic analysis: a pointer to the current
function's return type (used to validate \texttt{return} statements),
error message strings for diagnostics, and formatting strings used by
the type dumper.

@d Sema: data @{
// -- Sema globals ---------------------------------------------------------
.data
.globl _kcc_sema_cur_ret
_kcc_sema_cur_ret:    .quad 0       // current function return type
.globl _kcc_sema_callee_ctx
_kcc_sema_callee_ctx: .quad 0       // 1 while checking a call's direct callee
.globl _kcc_sema_callee_implicit
_kcc_sema_callee_implicit: .quad 0  // 1 if the callee was an implicit function

// -- Sema error messages --------------------------------------------------
.section __TEXT,__cstring,cstring_literals
.globl _kcc_sema_undecl_pre
_kcc_sema_undecl_pre:
    .asciz "use of undeclared identifier '"
_kcc_sema_nomember_pre:
    .asciz "no member named '"
.globl _kcc_sema_redef_pre
_kcc_sema_redef_pre:
    .asciz "redefinition of '"
_kcc_sema_implicit_pre:
    .asciz "implicit declaration of function '"
_kcc_sema_unused_pre:
    .asciz "unused variable '"
_kcc_sema_err_undecl:
    .asciz "use of undeclared identifier"
_kcc_sema_err_not_func:
    .asciz "called object is not a function"
_kcc_sema_err_not_struct:
    .asciz "member access on non-struct/union type"
_kcc_sema_err_void_val:
    .asciz "void value not ignored as it ought to be"
_kcc_sema_ret_void:
    .asciz "void function should not return a value"
_kcc_sema_ret_nonvoid:
    .asciz "non-void function should return a value"
_kcc_sema_reach_end:
    .asciz "control reaches end of non-void function"
_kcc_sema_sign_cmp:
    .asciz "comparison of integers of different signedness"
_kcc_sema_int2ptr:
    .asciz "incompatible integer to pointer conversion"
_kcc_sema_ptr2int:
    .asciz "incompatible pointer to integer conversion"
_kcc_sema_main_name:
    .asciz "main"
// Known _Noreturn library functions: a trailing call to one of these means
// the function does not fall through (for -Wreturn-type).
_kcc_nr_exit:        .asciz "exit"
_kcc_nr_uexit:       .asciz "_exit"
_kcc_nr_bexit:       .asciz "_Exit"
_kcc_nr_abort:       .asciz "abort"
_kcc_nr_longjmp:     .asciz "longjmp"
_kcc_nr_unreach:     .asciz "__builtin_unreachable"
_kcc_nr_trap:        .asciz "__builtin_trap"
// Pointer table lives in .data (a cstring section holds only strings); the
// following dump strings restore the cstring section afterwards.
.data
.p2align 3
_kcc_sema_noreturn_tbl:
    .quad _kcc_nr_exit, _kcc_nr_uexit, _kcc_nr_bexit, _kcc_nr_abort
    .quad _kcc_nr_longjmp, _kcc_nr_unreach, _kcc_nr_trap, 0
.section __TEXT,__cstring,cstring_literals

// -- Dump type strings ----------------------------------------------------
_kcc_sema_str_var:      .asciz "var "
_kcc_sema_str_func:     .asciz "func "
_kcc_sema_str_typedef:  .asciz "typedef "
_kcc_sema_str_colon:    .asciz ": "
_kcc_sema_str_eq:       .asciz " = "
_kcc_sema_str_nl:       .asciz "\n"
_kcc_sema_str_va_list:  .asciz "va_list"
_kcc_sema_str_builtin_va_list: .asciz "__builtin_va_list"
@| _kcc_sema_cur_ret
@| _kcc_sema_callee_ctx
@| _kcc_sema_callee_implicit
@| _kcc_sema_redef_pre
@| _kcc_sema_str_var
@| _kcc_sema_str_func
@| _kcc_sema_str_typedef
@| _kcc_sema_str_colon
@| _kcc_sema_str_eq
@| _kcc_sema_str_nl
@| _kcc_sema_str_va_list
@| _kcc_sema_str_builtin_va_list
@}
