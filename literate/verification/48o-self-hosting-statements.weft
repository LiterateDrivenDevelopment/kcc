@}

\section{Verification}
\label{sec:selfhost-statements-verify}

\texttt{make selfhost-statements} runs the drop-in loop.  Because every function
body the suite compiles is parsed into statements by this file, a green
code-generation suite means \kcc{} compiled its own statement grammar correctly;
\texttt{difftest} additionally confirms the resulting programs behave identically
to \texttt{clang}.

@d Selfhost: statements verify @{
#!/usr/bin/env bash
# make selfhost-statements — compile kcc's statement parser in C with kcc,
# relink, run the suite.
set -euo pipefail

SDK=$(xcrun --show-sdk-path)
SH=tmp/selfhost
sources="main syscalls arena strings io hashtab vec strtab source lexer \
lexer_tables diag preprocessor parser expressions statements declarations \
types symtab conversions sema ir opt emit_arm64 emit_x86 linker codegen emit_macho dwarf driver"

echo "[1/3] compiling tmp/selfhost/statements.c with kcc"
tmp/kcc -c "$SH/statements.c" -o "$SH/statements_c.o" >/dev/null

echo "[2/3] linking tmp/kcc_selfhost_statements (statements.o -> C)"
OBJ=""
for f in $sources; do
    if [ "$f" = "statements" ]; then OBJ="$OBJ $SH/statements_c.o"; else OBJ="$OBJ tmp/src/${f}.o"; fi
done
ld -o tmp/kcc_selfhost_statements $OBJ -lSystem -syslibroot "$SDK" -e _main -arch arm64

echo "[3/3] running the codegen suite with the self-hosted statement parser"
cp tmp/kcc "$SH/kcc_asm_backup_statements"
cp tmp/kcc_selfhost_statements tmp/kcc
set +e
bash tmp/tests/test_codegen.sh
status=$?
cp "$SH/kcc_asm_backup_statements" tmp/kcc
exit $status
@}
