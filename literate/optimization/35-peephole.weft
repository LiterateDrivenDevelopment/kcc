% 35-peephole.weft — Constant Folding and Identity Elimination
%
% This chapter implements peephole optimizations on the IR:
% 1. Constant folding: IR_CONST + IR_CONST → single IR_CONST
% 2. Identity elimination: x + 0, x * 1, x & ~0 → x

\chapter{Peephole Optimization}
\label{ch:peephole}

Peephole optimizations examine a small window of instructions and replace patterns that can be simplified without global analysis.  This chapter implements constant folding on the IR: an instruction whose inputs are all compile-time constants is evaluated at compile time and replaced with a single \texttt{IR\_CONST}.  Three shapes fold.  A \emph{binary} operation with two constant operands (\texttt{2 * 3}) evaluates directly.  A \emph{unary} \texttt{NEG} or \texttt{NOT} of a constant folds likewise---and although a bare 64-bit complement of \texttt{\~{}0u} is not the 32-bit \texttt{0xFFFFFFFF} the source means, the front end appends a width cast after every such operation, and that cast folds in turn, narrowing the value to the correct width.  That is the third and load-bearing shape: a \emph{width cast}---the \texttt{SEXT}/\texttt{ZEXT}/\texttt{TRUNC} inserted on nearly every integer operation---folds when its operand is constant.  Without it a constant chain stalls at the first cast (folding \texttt{3*4} but not the surrounding \texttt{2 + \dots - 1}, because the intervening sign-extend hid the intermediate constant), so folding through casts is what lets a whole constant expression collapse to one value.  All three feed the fixed-point loop of Chapter~\ref{ch:ir-passes}, so each fold that produces a fresh constant can unblock the next.

\section{Constant Folding}

Constant folding is the classic peephole optimization: when both operands
of a binary instruction are compile-time constants, we evaluate the
operation at compile time and replace the instruction with a single
\texttt{IR\_CONST}.  This eliminates work at run time and, equally
important, feeds additional constants into later iterations---an
\texttt{IR\_ADD} whose result becomes constant may enable a downstream
\texttt{IR\_MUL} to fold as well.

The implementation works in two linear passes over the function's basic
blocks.  Pass~1 scans every instruction and records which vregs were
produced by \texttt{IR\_CONST}; pass~2 revisits every binary operation
and, when both source vregs appear in the constant map, computes the
result and rewrites the instruction in place.  A dense array indexed by
vreg number stores the known constant values, with a parallel valid
array so we can distinguish ``not a constant'' from ``constant zero.''

\subsection{Building the Constant Map}

Before folding can begin we need a fast lookup from vreg number to
constant value.  We allocate two arena arrays sized to the function's
vreg count: \texttt{values[]} holds the immediate and \texttt{valid[]}
records whether a mapping exists.  Pass~1 then walks every instruction;
for each \texttt{IR\_CONST} it finds, it stores the immediate in the
corresponding slot and marks it valid.

@d Opt: constant fold @{
// -- kcc_opt_constfold ----------------------------------------------------
// uint64_t kcc_opt_constfold(ir_func *func)
// Folds constant expressions.  Returns number of folds performed.
.text
.globl _kcc_opt_constfold
.p2align 2
_kcc_opt_constfold:
    stp x29, x30, [sp, #-96]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    stp x25, x26, [sp, #64]
    str x27, [sp, #80]

    mov x19, x0                 // func
    mov x27, #0                 // fold count

    // Allocate const value map: array of (valid, value) pairs
    // Max vregs = func.vreg_n
    ldr x20, [x19, #IRF_VREG_N]
    cbz x20, .Lcf_done
    add x20, x20, #1            // +1 for safety

    // Allocate arrays: values[vreg_n] and valid[vreg_n]
    lsl x0, x20, #3             // values: 8 bytes each
    bl _kcc_arena_alloc
    mov x21, x0                 // x21 = values array

    mov x0, x20                 // valid: 1 byte each (we'll use 8)
    lsl x0, x0, #3
    bl _kcc_arena_alloc
    mov x22, x0                 // x22 = valid array

    // Zero valid array
    mov x0, x22
    mov x1, #0
    lsl x2, x20, #3
    bl _kcc_memset

    // Pass 1: collect all IR_CONST → record in map
    ldr x0, [x19, #IRF_BLOCKS]
    cbz x0, .Lcf_done
    mov x23, x0                 // blocks vec
    ldr x24, [x23, #VEC_COUNT]
    mov x25, #0

.Lcf_collect_bb:
    cmp x25, x24
    b.ge .Lcf_pass2

    mov x0, x23
    mov x1, x25
    bl _kcc_vec_get
    ldr x26, [x0]               // BB ptr

    ldr x0, [x26, #BB_FIRST]
.Lcf_collect_instr:
    cbz x0, .Lcf_collect_next_bb
    mov x26, x0                 // current instr

    ldr x1, [x26, #IR_OP]
    cmp x1, #IR_CONST
    b.ne .Lcf_collect_skip

    // Record: valid[dest] = 1, values[dest] = src1
    ldr x1, [x26, #IR_DEST]
    cmp x1, x20
    b.ge .Lcf_collect_skip
    mov x2, #1
    str x2, [x22, x1, lsl #3]
    ldr x2, [x26, #IR_SRC1]
    str x2, [x21, x1, lsl #3]

.Lcf_collect_skip:
    ldr x0, [x26, #IR_NEXT]
    b .Lcf_collect_instr

.Lcf_collect_next_bb:
    add x25, x25, #1
    b .Lcf_collect_bb
@| _kcc_opt_constfold
@}

\subsection{Folding Binary Operations}

With the constant map in hand, pass~2 walks every instruction a second
time.  For each binary operation (arithmetic, bitwise, shift, or
comparison) it checks whether both source vregs have entries in the
map.  When they do, the two constant values are loaded and the
appropriate operation is dispatched.  Non-binary opcodes and operations
with at least one non-constant source are skipped untouched.

@d Opt: constant fold @{
    // Pass 2: fold binary ops with two const sources
.Lcf_pass2:
    mov x25, #0

.Lcf_fold_bb:
    cmp x25, x24
    b.ge .Lcf_done

    mov x0, x23
    mov x1, x25
    bl _kcc_vec_get
    ldr x26, [x0]

    ldr x0, [x26, #BB_FIRST]
.Lcf_fold_instr:
    cbz x0, .Lcf_fold_next_bb
    mov x26, x0

    // A floating operation must never be folded with integer arithmetic: the
    // fold below negates/adds the raw 64-bit pattern, which is meaningless for a
    // double.  Skip any FP-typed instruction and let the back end materialise
    // the constant and compute with FADD/FNEG at run time.
    ldr x1, [x26, #IR_TYPE]
    cmp x1, #0x1000
    b.lo .Lcf_check_op
    ldr x2, [x1, #TY_KIND]
    cmp x2, #8                   // FLOAT
    b.lo .Lcf_check_op
    cmp x2, #10                  // ..LDOUBLE
    b.ls .Lcf_fold_skip
.Lcf_check_op:
    ldr x1, [x26, #IR_OP]
    // Width casts of a constant fold too: the front end inserts SEXT/ZEXT/TRUNC
    // on nearly every integer operation, and without folding through them a
    // constant chain stalls at the first cast (e.g. 2+3*4 folds 3*4 but the
    // sign-extend then blocks the add).
    cmp x1, #IR_SEXT
    b.eq .Lcf_ext
    cmp x1, #IR_ZEXT
    b.eq .Lcf_ext
    cmp x1, #IR_TRUNC
    b.eq .Lcf_ext
    // Check if it's a foldable binary op (1-7, 10-15, 20-25)
    cmp x1, #IR_ADD
    b.lt .Lcf_fold_skip
    cmp x1, #IR_CMP_SGE
    b.gt .Lcf_fold_skip
    // Unary NEG/NOT of a constant fold to a constant too; the width
    // normalization the front end appends is a cast that folds in turn, so the
    // 64-bit result is narrowed to the right width by the next iteration.
    cmp x1, #IR_NEG
    b.eq .Lcf_unary
    cmp x1, #IR_NOT
    b.eq .Lcf_unary

    // Check both sources are const
    ldr x2, [x26, #IR_SRC1]
    cmp x2, x20
    b.ge .Lcf_fold_skip
    ldr x3, [x22, x2, lsl #3]   // valid[src1]?
    cbz x3, .Lcf_fold_skip

    ldr x3, [x26, #IR_SRC2]
    cmp x3, x20
    b.ge .Lcf_fold_skip
    ldr x4, [x22, x3, lsl #3]   // valid[src2]?
    cbz x4, .Lcf_fold_skip

    // Both const! Get values
    ldr x2, [x26, #IR_SRC1]
    ldr x2, [x21, x2, lsl #3]   // val1
    ldr x3, [x26, #IR_SRC2]
    ldr x3, [x21, x3, lsl #3]   // val2

    // Compute result based on opcode
    ldr x1, [x26, #IR_OP]
    cmp x1, #IR_ADD
    b.eq .Lcf_do_add
    cmp x1, #IR_SUB
    b.eq .Lcf_do_sub
    cmp x1, #IR_MUL
    b.eq .Lcf_do_mul
    cmp x1, #IR_SDIV
    b.eq .Lcf_do_sdiv
    cmp x1, #IR_AND
    b.eq .Lcf_do_and
    cmp x1, #IR_OR
    b.eq .Lcf_do_or
    cmp x1, #IR_XOR
    b.eq .Lcf_do_xor
    cmp x1, #IR_SHL
    b.eq .Lcf_do_shl
    cmp x1, #IR_ASHR
    b.eq .Lcf_do_ashr
    cmp x1, #IR_CMP_EQ
    b.eq .Lcf_do_eq
    cmp x1, #IR_CMP_NE
    b.eq .Lcf_do_ne
    cmp x1, #IR_CMP_SLT
    b.eq .Lcf_do_slt
    cmp x1, #IR_CMP_SGT
    b.eq .Lcf_do_sgt
    b .Lcf_fold_skip
@}

\subsection{Arithmetic Dispatch}

Each foldable opcode maps to a short straight-line sequence that computes
the result in register \texttt{x4} from the two constant operands in
\texttt{x2} and \texttt{x3}.  After the computation, control falls
through to the replacement logic, which rewrites the original instruction
as an \texttt{IR\_CONST} carrying the folded value, updates the constant
map (so cascading folds work within the same pass), and increments the
fold counter.

@d Opt: constant fold @{
.Lcf_do_add:
    add x4, x2, x3
    b .Lcf_replace
.Lcf_do_sub:
    sub x4, x2, x3
    b .Lcf_replace
.Lcf_do_mul:
    mul x4, x2, x3
    b .Lcf_replace
.Lcf_do_sdiv:
    cbz x3, .Lcf_fold_skip      // div by zero: skip
    sdiv x4, x2, x3
    b .Lcf_replace
.Lcf_do_and:
    and x4, x2, x3
    b .Lcf_replace
.Lcf_do_or:
    orr x4, x2, x3
    b .Lcf_replace
.Lcf_do_xor:
    eor x4, x2, x3
    b .Lcf_replace
.Lcf_do_shl:
    lsl x4, x2, x3
    b .Lcf_replace
.Lcf_do_ashr:
    asr x4, x2, x3
    b .Lcf_replace
.Lcf_do_eq:
    cmp x2, x3
    cset x4, eq
    b .Lcf_replace
.Lcf_do_ne:
    cmp x2, x3
    cset x4, ne
    b .Lcf_replace
.Lcf_do_slt:
    cmp x2, x3
    cset x4, lt
    b .Lcf_replace
.Lcf_do_sgt:
    cmp x2, x3
    cset x4, gt
    b .Lcf_replace

.Lcf_unary:
    ldr x2, [x26, #IR_SRC1]
    cmp x2, x20
    b.ge .Lcf_fold_skip
    ldr x3, [x22, x2, lsl #3]
    cbz x3, .Lcf_fold_skip
    ldr x2, [x21, x2, lsl #3]
    ldr x1, [x26, #IR_OP]
    cmp x1, #IR_NEG
    b.eq .Lcf_un_neg
    mvn x4, x2
    b .Lcf_replace
.Lcf_un_neg:
    neg x4, x2
    b .Lcf_replace

.Lcf_ext:
    // Fold a width cast of a constant.  SEXT/ZEXT read the source width from
    // SRC2; TRUNC reads the target width from its result type.  The folded
    // value is the constant sign- or zero-adjusted to that width.
    ldr x2, [x26, #IR_SRC1]
    cmp x2, x20
    b.ge .Lcf_fold_skip
    ldr x3, [x22, x2, lsl #3]   // valid[src1]?
    cbz x3, .Lcf_fold_skip
    ldr x2, [x21, x2, lsl #3]   // val
    ldr x1, [x26, #IR_OP]
    cmp x1, #IR_TRUNC
    b.eq .Lcf_ext_trunc
    ldr x5, [x26, #IR_SRC2]     // source width (bytes)
    cbz x5, .Lcf_fold_skip
    cmp x5, #8
    b.hs .Lcf_ext_id
    cmp x1, #IR_ZEXT
    b.eq .Lcf_ext_mask
    // SEXT: sign-extend from width*8 bits
    lsl x6, x5, #3
    mov x7, #64
    sub x7, x7, x6
    lsl x4, x2, x7
    asr x4, x4, x7
    b .Lcf_replace
.Lcf_ext_trunc:
    ldr x5, [x26, #IR_TYPE]
    cbz x5, .Lcf_fold_skip
    ldr x5, [x5, #TY_SIZE]      // target width
    cbz x5, .Lcf_fold_skip
    cmp x5, #8
    b.hs .Lcf_ext_id
.Lcf_ext_mask:
    // ZEXT / TRUNC: keep the low width*8 bits, zero the rest
    lsl x6, x5, #3
    mov x7, #1
    lsl x7, x7, x6
    sub x7, x7, #1
    and x4, x2, x7
    b .Lcf_replace
.Lcf_ext_id:
    mov x4, x2                  // width >= 8: value unchanged

.Lcf_replace:
    // Replace instruction with IR_CONST
    mov x1, #IR_CONST
    str x1, [x26, #IR_OP]
    str x4, [x26, #IR_SRC1]     // folded value
    str xzr, [x26, #IR_SRC2]

    // Update const map
    ldr x1, [x26, #IR_DEST]
    cmp x1, x20
    b.ge .Lcf_fold_count
    mov x2, #1
    str x2, [x22, x1, lsl #3]
    str x4, [x21, x1, lsl #3]

.Lcf_fold_count:
    add x27, x27, #1

.Lcf_fold_skip:
    ldr x0, [x26, #IR_NEXT]
    b .Lcf_fold_instr

.Lcf_fold_next_bb:
    add x25, x25, #1
    b .Lcf_fold_bb

.Lcf_done:
    mov x0, x27                 // return fold count

    ldr x27, [sp, #80]
    ldp x25, x26, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #96
    ret
@}
