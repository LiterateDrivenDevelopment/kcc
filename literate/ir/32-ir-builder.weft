% 32-ir-builder.weft — AST to IR Lowering and IR Dump
%
% This chapter walks the typed AST and produces linear IR with
% virtual registers and basic blocks.  It also provides the textual
% dump for --dump-ir.

\chapter{IR Builder}
\label{ch:ir-builder}

With the IR data structures defined in Chapter~\ref{ch:ir-design}, we now need machinery to translate the typed AST into linear IR.  This chapter implements the IR builder, which walks the AST recursively and emits IR instructions for each expression, statement, and declaration.  Control-flow constructs (\texttt{if}/\texttt{else}, \texttt{while}, \texttt{for}, \texttt{do}/\texttt{while}, \texttt{break}/\texttt{continue}) are lowered into conditional and unconditional branches between basic blocks.  The chapter also provides the textual dump used by the \texttt{--dump-ir} flag for debugging.

\section{IR Builder Entry Point}

The builder walks the translation unit, processing each function
declaration.  Non-function declarations (globals, typedefs) are
skipped for now.

\paragraph{Module initialisation across translation units.}
Global initializers are lowered to runtime stores rather than a
pre-initialised data image (\S\ref{sec:global-inits}).  For the
translation unit that defines \texttt{main} those stores are injected
at the top of \texttt{main}, which runs before any user code.  But a
translation unit that does \emph{not} define \texttt{main}---a library
object compiled separately and linked in---has no such entry point, so
its file-scope initializers would never execute and its globals would
keep their zero (BSS) image.  A separately compiled \texttt{int~g~=~7;}
would read as \texttt{0}; a global function pointer would be
\texttt{NULL} and calling it would fault.

The fix is a per-unit \emph{module-init function}.  When this unit has
no \texttt{main} but does carry file-scope initializers, we synthesise
a function holding exactly the same initializer stores and register its
address in a \texttt{(\_\_DATA,\_\_mod\_init\_func)} section
(\S\ref{sec:macho-modinit}); \texttt{dyld} runs every module
initializer before \texttt{main}, for every unit in the image.  The
unit that owns \texttt{main} is left untouched---its initializers still
run at \texttt{main}'s entry---so single-unit programs are unaffected.

@d IR: build @{
// -- kcc_ir_build ---------------------------------------------------------
// void kcc_ir_build(node *trans_unit)
//   x0 = AST_TRANS_UNIT node
// Walks all top-level declarations and builds IR for functions.
.text
.globl _kcc_ir_build
.p2align 2
_kcc_ir_build:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    // Save translation unit for global init emission in main
    adrp x1, _kcc_ir_trans_unit@@PAGE
    add  x1, x1, _kcc_ir_trans_unit@@PAGEOFF
    str x0, [x1]

    ldr x19, [x0, #AST_F0]      // first declaration

.Lirb_loop:
    cbz x19, .Lirb_scan

    // Check if it's a function declaration with a body
    ldr x0, [x19, #AST_TAG]
    cmp x0, #AST_FUNC_DECL
    b.ne .Lirb_next

    // F3 = body (compound stmt); skip prototypes
    ldr x0, [x19, #AST_F3]
    cbz x0, .Lirb_next

    mov x0, x19
    bl _kcc_ir_build_func

.Lirb_next:
    ldr x19, [x19, #AST_F4]     // next sibling
    b .Lirb_loop

.Lirb_scan:
    // Decide whether this unit needs a module-init function: it must lack a
    // main definition yet carry at least one initializer to run at startup ---
    // a file-scope one, or a `static` local initializer inside a function body.
    adrp x0, _kcc_ir_trans_unit@@PAGE
    add  x0, x0, _kcc_ir_trans_unit@@PAGEOFF
    ldr x0, [x0]
    ldr x19, [x0, #AST_F0]      // first declaration
    mov x20, #0                  // has_main
    mov x21, #0                  // has_ginit
.Lirb_scan_loop:
    cbz x19, .Lirb_scan_done
    ldr x0, [x19, #AST_TAG]
    cmp x0, #AST_FUNC_DECL
    b.ne .Lirb_scan_var
    ldr x0, [x19, #AST_F3]      // body → a definition, not a prototype
    cbz x0, .Lirb_scan_next

    // Scan the body for a `static` local with an initializer: it too must run
    // once at startup, so in a non-main unit it is what obliges a module-init
    // function (no calls here, so x9/x10 survive to the main check below).
    ldr x9, [x0, #AST_F0]       // first body statement
.Lirb_scan_body:
    cbz x9, .Lirb_scan_main
    ldr x10, [x9, #AST_TAG]
    cmp x10, #AST_VAR_DECL
    b.ne .Lirb_scan_body_next
    ldr x10, [x9, #AST_F3]      // storage class (3 = static)
    cmp x10, #3
    b.ne .Lirb_scan_body_next
    ldr x10, [x9, #AST_F2]      // initializer present?
    cbz x10, .Lirb_scan_body_next
    mov x21, #1                  // static-local initializer → needs module init
    b .Lirb_scan_main
.Lirb_scan_body_next:
    ldr x9, [x9, #AST_F4]
    b .Lirb_scan_body

.Lirb_scan_main:
    ldr x0, [x19, #AST_F1]      // name
    cbz x0, .Lirb_scan_next
    adrp x1, _kcc_str_main@@PAGE
    add  x1, x1, _kcc_str_main@@PAGEOFF
    bl _kcc_strcmp
    cbnz x0, .Lirb_scan_next
    mov x20, #1                  // defines main
    b .Lirb_scan_next
.Lirb_scan_var:
    cmp x0, #AST_VAR_DECL
    b.ne .Lirb_scan_next
    ldr x0, [x19, #AST_F2]      // initializer present?
    cbz x0, .Lirb_scan_next
    mov x21, #1                  // has a file-scope initializer
.Lirb_scan_next:
    ldr x19, [x19, #AST_F4]
    b .Lirb_scan_loop
.Lirb_scan_done:
    // Synthesise module-init only for a non-main unit that has initializers.
    cbnz x20, .Lirb_done
    cbz x21, .Lirb_done
    bl _kcc_ir_emit_modinit

.Lirb_done:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_ir_build
@}

\subsection{Global Variable Initializers}
\label{sec:global-inits}

File-scope variables with initializers (\texttt{int x = 42;}) are not
placed in a pre-initialized data section---the all-spill model allocates
all globals in BSS.  Instead, the builder emits store instructions at
the top of \texttt{main()}'s entry block: an \texttt{IR\_GLOBAL\_REF}
materialises the address, the initializer expression produces a value
vreg, and an \texttt{IR\_STORE} writes it.  This runs before any user
statements in \texttt{main}.

A brace-enclosed initializer for a file-scope array
(\texttt{int t[3] = \{7, 8, 9\}}) is lowered the same way, one
\texttt{\_kcc\_ir\_emit\_indexed\_store} per element against the single
\texttt{IR\_GLOBAL\_REF} base.  Because BSS is already zero, a short
list needs no explicit tail fill: the unmentioned elements retain
their zero image.  These global tables are exactly the lookup tables a
self-hosted lexer relies on.

A second pass then seeds the \texttt{static} locals
(\S\ref{sec:ir-static-locals}).  Since these are hoisted to globals but
their declarations live inside function bodies, this pass walks each
function's top-level statement list for \texttt{static} declarations
that carry an initialiser, materialises the mangled symbol with an
\texttt{IR\_GLOBAL\_REF}, and hands it to the shared
\texttt{\_kcc\_ir\_emit\_init\_stores} routine---so a scalar, an
aggregate list, or a string static is initialised by exactly the same
code path a file-scope global uses.
Running it here---at the top of \texttt{main}---is what gives a static
its \emph{initialise once} semantics: the store executes at program
start rather than on every entry to the declaring function.  A static
without an initialiser, or one initialised to zero, needs nothing here;
BSS already supplies the zero.  Static locals declared inside nested
blocks are not yet swept by this pass, so a non-zero initialiser on one
is not applied (its storage still persists, starting at zero).

\paragraph{Read-only const globals (M5).}  Most globals are zero-initialised
storage seeded at load time by the stores this routine emits.  A
\texttt{const} global whose initialiser is a pure integer byte image is
different: the back end places its bytes in the read-only \texttt{\_\_TEXT}
tail (\S\ref{sec:mt-m5}), where a stray write faults rather than silently
corrupting a neighbour.  Such an object has \emph{no} writable storage, so this
routine must \emph{not} emit a runtime store for it---a store into a read-only
page would fault at startup.  \texttt{\_kcc\_global\_const\_rodata} is the
predicate both this routine (to suppress the store) and the code generator (to
lay the bytes) consult; being a pure function of the declaration AST, they
always agree.  It reads \texttt{const} straight from the declarator---peeling
\texttt{AST\_TYPE\_ARRAY} to the innermost \texttt{AST\_TYPE\_QUALS} and testing
bit~0---because semantics drops the qualifier from resolved descriptors, and it
accepts an integer \emph{or floating} scalar or array whose initialiser is a
matching scalar or a flat list of matching leaves (\texttt{\_kcc\_rodata\_is\_lit}):
for an integer element, any constant expression built from integer/character
literals, enum-constant identifiers, and the operators
\texttt{\_kcc\_eval\_const\_int} folds (\texttt{\_kcc\_rodata\_const\_intexpr},
so \texttt{\{1<<0,\ 1<<1\}}, a masked literal, or \texttt{\{STATE\_A,\ STATE\_B\}}
qualifies); for a \texttt{float}/\texttt{double} element, a floating literal or a
unary minus of one.  A \texttt{struct} of scalar fields with a positional literal
initialiser---and a 1-D array of such structs (\texttt{\_kcc\_rodata\_struct\_ok}
per element, via \texttt{\_kcc\_rodata\_aos\_ok})---is also accepted, laid
field-by-field at each member's offset.  Anything else (\texttt{sizeof}, non-enum
identifiers, designators, pointers, bit-fields, brace elision, multi-dimensional
arrays of structs, structs with aggregate fields) falls back to the ordinary
writable path, correct but unprotected.

@d IR: build @{
// -- kcc_rodata_is_lit --------------------------------------------------------
// uint64_t kcc_rodata_binop_ok(uint64_t op)
// 1 iff op is a binary operator _kcc_eval_const_int folds (arithmetic, shift,
// bitwise).  Comparison and logical ops are excluded so an accepted expression
// tree never reaches eval's return-0 default (which would silently misfold).
.text
.globl _kcc_rodata_binop_ok
.p2align 2
_kcc_rodata_binop_ok:
    cmp x0, #TOK_PLUS
    b.eq .Lrbo_yes
    cmp x0, #TOK_MINUS
    b.eq .Lrbo_yes
    cmp x0, #TOK_STAR
    b.eq .Lrbo_yes
    cmp x0, #TOK_SLASH
    b.eq .Lrbo_yes
    cmp x0, #TOK_PERCENT
    b.eq .Lrbo_yes
    cmp x0, #TOK_SHL
    b.eq .Lrbo_yes
    cmp x0, #TOK_SHR
    b.eq .Lrbo_yes
    cmp x0, #TOK_AMP
    b.eq .Lrbo_yes
    cmp x0, #TOK_PIPE
    b.eq .Lrbo_yes
    cmp x0, #TOK_CARET
    b.eq .Lrbo_yes
    mov x0, #0
    ret
.Lrbo_yes:
    mov x0, #1
    ret

// uint64_t kcc_rodata_const_intexpr(node *n)
// 1 iff n is an integer constant expression built from integer/character
// literals, enum-constant identifiers, and the operators _kcc_eval_const_int
// folds.  An identifier is accepted only when it names an enum constant, looked
// up in the scope stack that both IR-build and codegen see identically (neither
// modifies the frozen post-sema stack), so the predicate agrees in both phases;
// sizeof and non-enum identifiers are rejected so eval never hits its return-0
// default.  This lets bit-flag tables (`{1<<0, 1<<1}`), masked literals, negated
// constants, and enum tables (`{STATE_A, STATE_B}`) reach rodata.
.text
.globl _kcc_rodata_const_intexpr
.p2align 2
_kcc_rodata_const_intexpr:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]
    mov x19, x0
    cbz x19, .Lrci_no
    ldr x0, [x19, #AST_TAG]
    cmp x0, #AST_INT_LIT
    b.eq .Lrci_yes
    cmp x0, #AST_CHAR_LIT
    b.eq .Lrci_yes
    cmp x0, #AST_PAREN_EXPR
    b.eq .Lrci_paren
    cmp x0, #AST_CAST_EXPR
    b.eq .Lrci_cast
    cmp x0, #AST_UNARY_EXPR
    b.eq .Lrci_unary
    cmp x0, #AST_BINARY_EXPR
    b.eq .Lrci_binary
    cmp x0, #AST_IDENT_EXPR
    b.eq .Lrci_ident
    b .Lrci_no
.Lrci_ident:
    // An identifier is a constant only when it names an enum constant; the
    // symbol table is consulted identically at IR-build and codegen (both after
    // sema), so the predicate agrees in both phases and _kcc_eval_const_int
    // yields the enumerator's value.
    ldr x0, [x19, #AST_F0]          // name ptr
    cbz x0, .Lrci_no
    bl _kcc_strlen
    mov x1, x0
    ldr x0, [x19, #AST_F0]
    bl _kcc_symtab_lookup
    cbz x0, .Lrci_no
    ldr x1, [x0, #SYM_KIND]
    cmp x1, #SYM_ENUM_CONST
    b.ne .Lrci_no
    b .Lrci_yes
.Lrci_paren:
    ldr x0, [x19, #AST_F0]
    bl _kcc_rodata_const_intexpr
    b .Lrci_done
.Lrci_cast:
    ldr x0, [x19, #AST_F1]          // cast value (type ignored, as eval does)
    bl _kcc_rodata_const_intexpr
    b .Lrci_done
.Lrci_unary:
    ldr x1, [x19, #AST_F0]          // op: minus/tilde/bang are folded by eval
    cmp x1, #TOK_MINUS
    b.eq .Lrci_un_ok
    cmp x1, #TOK_TILDE
    b.eq .Lrci_un_ok
    cmp x1, #TOK_BANG
    b.ne .Lrci_no
.Lrci_un_ok:
    ldr x0, [x19, #AST_F1]          // operand
    bl _kcc_rodata_const_intexpr
    b .Lrci_done
.Lrci_binary:
    ldr x0, [x19, #AST_F0]          // op must be in the folded set
    bl _kcc_rodata_binop_ok
    cbz x0, .Lrci_no
    ldr x0, [x19, #AST_F1]          // lhs
    bl _kcc_rodata_const_intexpr
    cbz x0, .Lrci_no
    ldr x0, [x19, #AST_F2]          // rhs
    bl _kcc_rodata_const_intexpr
    b .Lrci_done
.Lrci_yes:
    mov x0, #1
    b .Lrci_done
.Lrci_no:
    mov x0, #0
.Lrci_done:
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// uint64_t kcc_rodata_is_lit(node *n, uint64_t isfloat)
// For an integer element, n must be an integer constant expression
// (kcc_rodata_const_intexpr).  For a floating element, a floating literal or a
// unary minus of one -- _kcc_eval_const_int is integer-only, so a float leaf
// stays a literal whose bits come straight from AST_F0.
.text
.globl _kcc_rodata_is_lit
.p2align 2
_kcc_rodata_is_lit:
    cbnz x1, .Lril_float
    b _kcc_rodata_const_intexpr     // integer: tail-call the validator
.Lril_float:
    ldr x2, [x0, #AST_TAG]
    cmp x2, #AST_UNARY_EXPR
    b.ne .Lril_fdirect
    ldr x3, [x0, #AST_F0]           // unary op
    cmp x3, #TOK_MINUS
    b.ne .Lril_fno
    ldr x0, [x0, #AST_F1]           // operand must be a floating literal
    cbz x0, .Lril_fno
    ldr x2, [x0, #AST_TAG]
.Lril_fdirect:
    cmp x2, #AST_FLOAT_LIT
    b.eq .Lril_fyes
.Lril_fno:
    mov x0, #0
    ret
.Lril_fyes:
    mov x0, #1
    ret

// uint64_t kcc_rodata_struct_ok(type *sty, node *init)
// 1 iff sty is a struct whose members are all scalar integer/floating fields
// (no bit-fields, no nested aggregates) and init is a positional list of
// matching literals -- so the struct's byte image can be laid field-by-field.
.text
.globl _kcc_rodata_struct_ok
.p2align 2
_kcc_rodata_struct_ok:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]
    mov x19, x0                     // struct type
    ldr x0, [x1, #AST_TAG]          // init must be a brace list
    cmp x0, #AST_INIT_LIST
    b.ne .Lrso_no
    ldr x20, [x1, #AST_F0]          // x20 = init element cursor
    mov x0, x19                     // force layout so offsets/sizes are valid
    bl _kcc_type_layout
    ldr x0, [x19, #TY_F0]           // AST_STRUCT_DECL
    cbz x0, .Lrso_no
    ldr x21, [x0, #AST_F1]          // x21 = field cursor
.Lrso_loop:
    cbz x20, .Lrso_yes              // init exhausted: remaining fields stay zero
    cbz x21, .Lrso_no               // more initializers than fields
    ldr x0, [x21, #AST_F2]          // reject bit-fields (width expr present)
    cbnz x0, .Lrso_no
    ldr x0, [x20, #AST_TAG]         // reject a designated element (positional only)
    cmp x0, #AST_DESIGNATOR
    b.eq .Lrso_no
    ldr x0, [x21, #AST_F0]          // field type must be scalar int/float
    cbz x0, .Lrso_no
    bl _kcc_sema_resolve_type
    cbz x0, .Lrso_no
    ldr x1, [x0, #TY_KIND]
    cmp x1, #TY_BOOL
    b.lt .Lrso_no
    cmp x1, #TY_DOUBLE
    b.gt .Lrso_no
    cmp x1, #TY_FLOAT               // matching literal (float leaf if kind>=FLOAT)
    cset x1, ge
    mov x0, x20
    bl _kcc_rodata_is_lit
    cbz x0, .Lrso_no
    ldr x21, [x21, #AST_F4]         // next field
    ldr x20, [x20, #AST_F4]         // next element
    b .Lrso_loop
.Lrso_yes:
    mov x0, #1
    b .Lrso_done
.Lrso_no:
    mov x0, #0
.Lrso_done:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

// uint64_t kcc_rodata_aos_ok(type *sty, node *outer)
// 1 iff outer is a brace list whose every element is itself a brace list that
// passes kcc_rodata_struct_ok for the element struct type -- i.e. a 1-D array of
// scalar-field structs, each initialised positionally.  A short list leaves its
// trailing structs zero; a flat (brace-elided) element is rejected.
.text
.globl _kcc_rodata_aos_ok
.p2align 2
_kcc_rodata_aos_ok:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]
    mov x19, x0                     // element struct type
    ldr x0, [x1, #AST_TAG]
    cmp x0, #AST_INIT_LIST
    b.ne .Laos_no
    ldr x21, [x1, #AST_F0]          // x21 = outer element cursor
.Laos_loop:
    cbz x21, .Laos_yes              // exhausted: remaining structs stay zero
    ldr x0, [x21, #AST_TAG]         // each element must be its own brace
    cmp x0, #AST_INIT_LIST
    b.ne .Laos_no
    mov x0, x19
    mov x1, x21
    bl _kcc_rodata_struct_ok
    cbz x0, .Laos_no
    ldr x21, [x21, #AST_F4]
    b .Laos_loop
.Laos_yes:
    mov x0, #1
    b .Laos_done
.Laos_no:
    mov x0, #0
.Laos_done:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

// -- kcc_global_const_rodata --------------------------------------------------
// uint64_t kcc_global_const_rodata(node *decl)
// 1 iff decl is a const-qualified global whose storage can be a fixed byte
// image: an integer/floating scalar or array with matching literal leaves, a
// (non-array) struct of scalar fields, or a 1-D array of such structs, each with
// a positional literal initializer.
.text
.globl _kcc_global_const_rodata
.p2align 2
_kcc_global_const_rodata:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    mov x19, x0
    mov x22, #0                     // x22 = count of array wrappers peeled
    ldr x0, [x19, #AST_F2]         // must have an initializer
    cbz x0, .Lgcr_no
    ldr x1, [x19, #AST_F0]         // declared type spec
.Lgcr_peel:
    cbz x1, .Lgcr_no
    ldr x2, [x1, #AST_TAG]
    cmp x2, #AST_TYPE_ARRAY
    b.ne .Lgcr_qual
    add x22, x22, #1                // count the array wrapper
    ldr x1, [x1, #AST_F0]          // element type
    b .Lgcr_peel
.Lgcr_qual:
    cmp x2, #AST_TYPE_QUALS         // innermost must be a qualifier node
    b.ne .Lgcr_no
    ldr x2, [x1, #AST_F1]           // qualifier flags
    and x2, x2, #1                  // const bit
    cbz x2, .Lgcr_no
    ldr x0, [x1, #AST_F0]           // base type under the qualifier
    cbz x0, .Lgcr_no
    bl _kcc_sema_resolve_type
    cbz x0, .Lgcr_no
    ldr x2, [x0, #TY_KIND]
    // A struct base (no array wrapper) validates field-by-field; the integer
    // kinds TY_BOOL(2)..TY_LLONG(7) take integer literals; the floating kinds
    // TY_FLOAT(8)/TY_DOUBLE(9) take floating literals.  x21 = float mode.
    cmp x2, #TY_STRUCT
    b.eq .Lgcr_struct               // x0 = struct type
    cmp x2, #TY_BOOL
    b.lt .Lgcr_no
    cmp x2, #TY_LLONG
    b.le .Lgcr_intmode
    cmp x2, #TY_DOUBLE
    b.gt .Lgcr_no
    mov x21, #1                     // float/double element
    b .Lgcr_init
.Lgcr_struct:
    // x0 = struct type.  No array wrapper -> scalar struct; exactly one -> a
    // 1-D array of structs; more -> not handled.
    cbz x22, .Lgcr_scalar_struct
    cmp x22, #1
    b.ne .Lgcr_no
    ldr x1, [x19, #AST_F2]          // outer init list
    bl _kcc_rodata_aos_ok
    b .Lgcr_done
.Lgcr_scalar_struct:
    ldr x1, [x19, #AST_F2]          // init list (x0 = struct type)
    bl _kcc_rodata_struct_ok
    b .Lgcr_done
.Lgcr_intmode:
    mov x21, #0
.Lgcr_init:
    ldr x0, [x19, #AST_F2]          // initializer shape
    ldr x1, [x0, #AST_TAG]
    cmp x1, #AST_INIT_LIST
    b.eq .Lgcr_list
    mov x1, x21                     // scalar: the init node itself
    bl _kcc_rodata_is_lit
    b .Lgcr_done
.Lgcr_list:
    ldr x20, [x0, #AST_F0]          // first element
.Lgcr_list_loop:
    cbz x20, .Lgcr_yes              // every element was a matching literal
    mov x0, x20
    mov x1, x21
    bl _kcc_rodata_is_lit
    cbz x0, .Lgcr_no
    ldr x20, [x20, #AST_F4]         // next element
    b .Lgcr_list_loop
.Lgcr_yes:
    mov x0, #1
    b .Lgcr_done
.Lgcr_no:
    mov x0, #0
.Lgcr_done:
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

// uint64_t kcc_global_const_ptrarr(node *decl)
// 1 iff decl is a 1-D array of const pointers (`const char *const opts[]`)
// initialised with string literals and/or integer (NULL) constants.  Such a
// table cannot live in immutable __TEXT---its pointers are relocated at load---so
// it goes to __DATA_CONST,__const (a separate emit path, kcc_emit_rodata_ptrarr).
.text
.globl _kcc_global_const_ptrarr
.p2align 2
_kcc_global_const_ptrarr:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    mov x19, x0
    ldr x0, [x19, #AST_F2]          // must have an initializer
    cbz x0, .Lgcp_no
    ldr x1, [x19, #AST_F0]          // declared type
    cbz x1, .Lgcp_no
    ldr x2, [x1, #AST_TAG]
    cmp x2, #AST_TYPE_ARRAY         // a 1-D array
    b.ne .Lgcp_no
    ldr x1, [x1, #AST_F0]           // element type: must be a pointer
    cbz x1, .Lgcp_no
    ldr x2, [x1, #AST_TAG]
    cmp x2, #AST_TYPE_PTR
    b.ne .Lgcp_no
    ldr x2, [x1, #AST_F1]           // the pointer's own qualifiers (the *const)
    and x2, x2, #1                  // const bit: the element pointers are const,
    cbz x2, .Lgcp_no                // so the array is read-only
    ldr x0, [x19, #AST_F2]          // init: flat list of string/int-constant leaves
    ldr x1, [x0, #AST_TAG]
    cmp x1, #AST_INIT_LIST
    b.ne .Lgcp_no
    ldr x20, [x0, #AST_F0]
.Lgcp_loop:
    cbz x20, .Lgcp_yes
    ldr x0, [x20, #AST_TAG]
    cmp x0, #AST_STR_LIT
    b.eq .Lgcp_elem_ok
    cmp x0, #AST_INT_LIT            // an integer constant (NULL) leaves a zero slot
    b.ne .Lgcp_no
.Lgcp_elem_ok:
    ldr x20, [x20, #AST_F4]
    b .Lgcp_loop
.Lgcp_yes:
    mov x0, #1
    b .Lgcp_pdone
.Lgcp_no:
    mov x0, #0
.Lgcp_pdone:
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_rodata_binop_ok _kcc_rodata_const_intexpr _kcc_rodata_struct_ok _kcc_rodata_aos_ok _kcc_rodata_is_lit _kcc_global_const_rodata _kcc_global_const_ptrarr
@}

@d IR: build @{
// -- kcc_ir_emit_global_inits --------------------------------------------
// void kcc_ir_emit_global_inits(void)
// Walks the saved translation unit for global var_decls with initializers
// and emits IR_GLOBAL_REF + build_expr(init) + IR_STORE into the current BB.
.text
.globl _kcc_ir_emit_global_inits
.p2align 2
_kcc_ir_emit_global_inits:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]

    adrp x0, _kcc_ir_trans_unit@@PAGE
    add  x0, x0, _kcc_ir_trans_unit@@PAGEOFF
    ldr x0, [x0]
    cbz x0, .Legi_done
    ldr x19, [x0, #AST_F0]      // first declaration

.Legi_loop:
    cbz x19, .Legi_statics
    ldr x0, [x19, #AST_TAG]
    cmp x0, #AST_VAR_DECL
    b.ne .Legi_next

    // Check for initializer (AST_F2)
    ldr x0, [x19, #AST_F2]
    cbz x0, .Legi_next
    // Check for name (AST_F1)
    ldr x20, [x19, #AST_F1]
    cbz x20, .Legi_next

    // A const scalar/aggregate global emitted as read-only __TEXT bytes, or a
    // const pointer array emitted to __DATA_CONST, has no writable storage; a
    // runtime store would fault.  Suppress it.
    mov x0, x19
    bl _kcc_global_const_rodata
    cbnz x0, .Legi_next
    mov x0, x19
    bl _kcc_global_const_ptrarr
    cbnz x0, .Legi_next

    // Emit IR_GLOBAL_REF for this variable
    mov x0, #IR_GLOBAL_REF
    bl _kcc_ir_alloc_instr
    mov x21, x0
    str x20, [x21, #IR_SRC1]    // name
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x21, #IR_TYPE]
    bl _kcc_ir_next_vreg
    str x0, [x21, #IR_DEST]
    mov x22, x0                  // x22 = address vreg
    mov x0, x21
    bl _kcc_ir_emit

    // Emit the initializer (scalar, aggregate list, or string) against the
    // just-materialised base address.  The same routine serves the static
    // locals below, keyed only on the base address it is handed.
    mov x0, x19                  // decl node
    mov x1, x22                  // base address vreg
    bl _kcc_ir_emit_init_stores

.Legi_next:
    ldr x19, [x19, #AST_F4]     // next sibling
    b .Legi_loop

.Legi_statics:
    // Second pass: one-time initialisers for static locals, hoisted globals
    adrp x0, _kcc_ir_trans_unit@@PAGE
    add  x0, x0, _kcc_ir_trans_unit@@PAGEOFF
    ldr x0, [x0]
    cbz x0, .Legi_done
    ldr x19, [x0, #AST_F0]      // first top-level decl
.Legi_fn_loop:
    cbz x19, .Legi_done
    ldr x0, [x19, #AST_TAG]
    cmp x0, #AST_FUNC_DECL
    b.ne .Legi_fn_next
    ldr x0, [x19, #AST_F3]      // function body (compound stmt)
    cbz x0, .Legi_fn_next
    ldr x20, [x0, #AST_F0]      // first body item
.Legi_stmt_loop:
    cbz x20, .Legi_fn_next
    ldr x0, [x20, #AST_TAG]
    cmp x0, #AST_VAR_DECL
    b.ne .Legi_stmt_next
    ldr x0, [x20, #AST_F3]      // storage class (3 = static)
    cmp x0, #3
    b.ne .Legi_stmt_next
    ldr x0, [x20, #AST_F2]      // initializer
    cbz x0, .Legi_stmt_next

    // Same read-only const rule as the file-scope pass: no runtime store.
    mov x0, x20
    bl _kcc_global_const_rodata
    cbnz x0, .Legi_stmt_next
    mov x0, x20
    bl _kcc_global_const_ptrarr
    cbnz x0, .Legi_stmt_next

    // GLOBAL_REF(mangled) + shared initializer emission.  Because the static
    // shares one routine with file-scope globals, an aggregate static
    // (`static const struct P p = {..}` or `static const int a[] = {..}`) is
    // laid out element-by-element into its storage, not truncated to a single
    // scalar store.
    mov x0, x20
    bl _kcc_ir_static_name
    mov x21, x0                  // mangled name

    mov x0, #IR_GLOBAL_REF
    bl _kcc_ir_alloc_instr
    str x21, [x0, #IR_SRC1]
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    mov x22, x0
    bl _kcc_ir_next_vreg
    str x0, [x22, #IR_DEST]
    mov x21, x0                  // x21 = address vreg
    mov x0, x22
    bl _kcc_ir_emit

    mov x0, x20                  // static decl node
    mov x1, x21                  // base address vreg
    bl _kcc_ir_emit_init_stores

.Legi_stmt_next:
    ldr x20, [x20, #AST_F4]
    b .Legi_stmt_loop
.Legi_fn_next:
    ldr x19, [x19, #AST_F4]
    b .Legi_fn_loop

.Legi_done:
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@| _kcc_ir_emit_global_inits
@}

\paragraph{Shared initializer emission.}
Both file-scope globals and hoisted static locals reduce to the same
problem: given a base address and a declaration, emit the store
instructions that realise its initialiser.  Factoring that into one
routine, \texttt{\_kcc\_ir\_emit\_init\_stores}, is what lets a
\texttt{static const} aggregate be laid out correctly---the earlier
static pass truncated \texttt{\{7,\,9\}} to a single scalar store,
leaving the second field at its BSS zero, so \texttt{lcode.c}'s
\texttt{static const expdesc ef = \{VKINT,\,\{0\},\,NO\_JUMP,\,NO\_JUMP\}}
came back mis-initialised.  The routine takes the declaration in
\texttt{x0} and the base-address vreg in \texttt{x1}, dispatches on the
shape of the initialiser, and emits the corresponding stores: a scalar
(with the \texttt{\_Bool} 0/1 normalisation), a brace-enclosed list
(one \texttt{\_kcc\_ir\_store\_elem} per element, honouring designators
and byte-accurate offsets), or a string literal copied into an array.
It writes nothing for the unmentioned tail, since BSS already supplies
the zero image.

\paragraph{Nested aggregate initialisers.}  A brace-enclosed initialiser can
nest: an array of structs (\texttt{static const luaL\_Reg lib[] =
\{\{"a",\,f\},\ldots\}}) or a struct with an aggregate member, and it may use
designator chains (\texttt{.p.a = 1}) or brace elision (\texttt{int m[2][2] =
\{1,2,3,4\}}) just as a block-scope initialiser can.  Rather than duplicate
that logic, \texttt{\_kcc\_ir\_emit\_aggregate\_init} is now a thin adapter
onto the shared recursive initializer (\S\ref{sec:ir-aggregates}): it hands
the list, the aggregate type, and the global's base \emph{address} to
\texttt{\_kcc\_ir\_fill\_list}, which descends the object emitting one
\texttt{IR\_GEP}-plus-store per leaf.  The base being a materialised address
rather than an alloca vreg makes no difference---\texttt{IR\_GEP} strides
either by a byte offset all the same---so file-scope and block-scope
aggregates share a single, tested code path.  A flat single-store-per-element
scheme (the original behaviour) once placed a function-pointer field's brace
initialiser at the wrong slot, so Lua's \texttt{loadedlibs} table called into
its own data (an \texttt{EXC\_BAD\_ACCESS} during \texttt{luaL\_openlibs});
routing both scopes through the same recursion keeps that class of bug fixed
in one place.

@d IR: build @{
// -- kcc_ir_emit_aggregate_init ------------------------------------------
// void kcc_ir_emit_aggregate_init(node *init_list, type *agg, uint64_t base)
//   x0 = AST_INIT_LIST, x1 = aggregate type (array/struct/union, or a scalar
//   type for the untyped int fallback), x2 = base ADDRESS vreg.
// Thin adapter onto the shared recursive initializer: the file-scope path
// emits its stores against a materialised base address exactly as the local
// path does against an alloca, so both go through _kcc_ir_fill_list and get
// designator chains and brace elision for free.  No zero-fill here---a
// file-scope aggregate starts life in zeroed BSS, so a sparse list's gaps
// are already zero.
.text
.globl _kcc_ir_emit_aggregate_init
.p2align 2
_kcc_ir_emit_aggregate_init:
    stp x29, x30, [sp, #-16]!
    mov x29, sp
    ldr x3, [x0, #AST_F0]        // list head element
    mov x0, x1                   // aggregate type
    mov x1, x2                   // base address vreg
    mov x2, #0                   // base offset
    bl _kcc_ir_fill_list
    ldp x29, x30, [sp], #16
    ret
@| _kcc_ir_emit_aggregate_init
@}

@d IR: build @{
// -- kcc_ir_emit_init_stores ---------------------------------------------
// void kcc_ir_emit_init_stores(node *decl, uint64_t base_vreg)
//   x0 = AST_VAR_DECL (AST_F0 = declared type, AST_F2 = initializer)
//   x1 = base address vreg (storage the initializer writes into)
// Emits the store(s) for a scalar, aggregate init-list, or string init.
.text
.globl _kcc_ir_emit_init_stores
.p2align 2
_kcc_ir_emit_init_stores:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]

    mov x19, x0                  // decl node
    mov x22, x1                  // base address vreg

    ldr x0, [x19, #AST_F2]      // initializer
    cbz x0, .Leis_done
    ldr x1, [x0, #AST_TAG]
    cmp x1, #AST_INIT_LIST
    b.eq .Leis_initlist
    cmp x1, #AST_STR_LIT
    b.eq .Leis_string

.Leis_scalar:
    // An initializer that is neither a brace list nor a string literal, but
    // whose target is a struct/union (`expdesc temp = *e1;`, `S a = b;`), is a
    // whole-object COPY, not a scalar store---otherwise only the first word is
    // copied and the rest of the object is left as stack garbage.  (This is a
    // different path from a plain assignment `a = b`: a declaration with an
    // initializer.)  It broke Lua's `lcode.c`, whose `swapexps` does exactly
    // `expdesc temp = *e1;` to compile the `>`/`>=` operators, so every `a > b`
    // crashed the parser.
    ldr x0, [x19, #AST_F0]      // declared type spec
    bl _kcc_sema_resolve_type
    cbz x0, .Leis_scalar_val
    mov x23, x0                  // x23 = resolved type
    ldr x1, [x0, #TY_KIND]
    cmp x1, #TY_STRUCT
    b.eq .Leis_struct_copy
    cmp x1, #TY_UNION
    b.eq .Leis_struct_copy
    b .Leis_scalar_val

.Leis_struct_copy:
    ldr x0, [x19, #AST_F2]      // initializer expression
    bl _kcc_ir_build_struct_addr // x0 = source struct base address vreg
    mov x24, x0                  // x24 = src
    mov x0, x23
    bl _kcc_type_layout          // x0 = aggregate byte size
    mov x2, x0                    // byte size (exact)
    mov x0, x24                  // src
    mov x1, x22                  // dst = base address
    bl _kcc_ir_emit_struct_copy
    b .Leis_done

.Leis_scalar_val:
    // Build the initializer expression, remembering its sema type first so the
    // value can be converted to the declared type---exactly as the block-scope
    // scalar path does.  Without this a global `double d = 100;` stored the raw
    // integer bits of 100 instead of the IEEE-754 double, and a `float f = 5;`
    // stored 8 integer bytes; both read back as ~0.
    ldr x0, [x19, #AST_F2]      // init expr node
    ldr x24, [x0, #AST_F3]      // from = initializer's sema type (may be 0)
    bl _kcc_ir_build_expr
    mov x21, x0                  // value vreg

    ldr x0, [x19, #AST_F0]      // declared type spec
    bl _kcc_sema_resolve_type
    mov x23, x0                  // to = declared type (may be 0)

    // Convert across the int/float boundary if both types are known.
    cbz x23, .Leis_sv_bool
    cbz x24, .Leis_sv_bool
    mov x0, x21
    mov x1, x24                  // from
    mov x2, x23                  // to
    bl _kcc_ir_convert
    mov x21, x0

.Leis_sv_bool:
    // A _Bool target normalises its initializer to 0/1.
    cbz x23, .Leis_scalar_store
    ldr x0, [x23, #TY_KIND]
    cmp x0, #TY_BOOL
    b.ne .Leis_scalar_store
    mov x0, x21
    bl _kcc_ir_emit_bool_norm
    mov x21, x0

.Leis_scalar_store:
    // Compute the access-size from the declared type (x24 is free after the
    // conversion) so a narrow scalar---and a `float`, whose 4-byte single form
    // differs from the double working format---is written at its true width.
    mov x0, x23
    bl _kcc_ir_store_width
    mov x24, x0                  // access-size code

    mov x0, #IR_STORE
    bl _kcc_ir_alloc_instr
    cbz x23, .Leis_sv_inttype
    str x23, [x0, #IR_TYPE]     // declared type
    b .Leis_sv_havetype
.Leis_sv_inttype:
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
.Leis_sv_havetype:
    str x21, [x0, #IR_SRC1]     // value
    str x22, [x0, #IR_SRC2]     // address
    str x24, [x0, #IR_DEST]     // access-size override
    bl _kcc_ir_emit
    b .Leis_done

.Leis_initlist:
    // Lay out the brace initialiser against the declared aggregate type,
    // recursing for nested aggregates.  When the type does not resolve, fall
    // back to an int-strided array (the historical untyped behaviour).
    ldr x0, [x19, #AST_F0]      // declared type spec
    bl _kcc_sema_resolve_type
    cbnz x0, .Leis_il_have_type
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr x0, [x0]
.Leis_il_have_type:
    mov x1, x0                   // aggregate type
    ldr x0, [x19, #AST_F2]      // init-list node
    mov x2, x22                  // base address vreg
    bl _kcc_ir_emit_aggregate_init
    b .Leis_done

.Leis_string:
    // char s[] = "abc": copy bytes into the array storage (a char *g stores
    // the address, so only an array target takes this path).
    ldr x0, [x19, #AST_F0]      // declared type
    bl _kcc_sema_resolve_type
    cbz x0, .Leis_scalar
    ldr x1, [x0, #TY_KIND]
    cmp x1, #TY_ARRAY
    b.ne .Leis_scalar
    ldr x21, [x0, #TY_F1]       // array length (char → bytes)
    ldr x0, [x19, #AST_F2]
    ldr x23, [x0, #AST_F0]      // str_ptr
    ldr x24, [x0, #AST_F1]      // str_len
    cbnz x21, .Leis_str_call
    add x21, x24, #1
.Leis_str_call:
    mov x0, x22                  // base = address vreg
    mov x1, x23                  // str_ptr
    mov x2, x24                  // str_len
    mov x3, x21                  // array_len
    mov x4, #0                   // BSS already zero
    bl _kcc_ir_emit_string_init

.Leis_done:
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@| _kcc_ir_emit_init_stores
@}

The synthesised module-init function is an ordinary IR function built by
hand: it reuses \texttt{\_kcc\_ir\_emit\_global\_inits} for its body, so its
stores are byte-for-byte the ones \texttt{main} would have run, then closes
with an implicit return.  It is named \texttt{kcc.module\_init}---a name no
C identifier can spell, so it never collides with a user symbol---and the
code generator gives it \emph{local} linkage, so several separately compiled
units may each define one without a duplicate-symbol error at link time.
Setting \texttt{\_kcc\_modinit\_present} tells the code generator and the
Mach-O writer to emit the \texttt{\_\_mod\_init\_func} pointer that makes
\texttt{dyld} run it.

@d IR: build @{
// -- kcc_ir_emit_modinit --------------------------------------------------
// void kcc_ir_emit_modinit(void)
// Synthesises a local void(void) function whose body is the file-scope
// initializer stores, so a non-main translation unit initialises its
// globals via a (__DATA,__mod_init_func) entry run by dyld before main.
.text
.globl _kcc_ir_emit_modinit
.p2align 2
_kcc_ir_emit_modinit:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    // Create the IR function (name "kcc.module_init", return type int)
    adrp x0, _kcc_str_modinit@@PAGE
    add  x0, x0, _kcc_str_modinit@@PAGEOFF
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    bl _kcc_ir_alloc_func
    mov x19, x0                  // ir_func

    adrp x1, _kcc_ir_cur_func@@PAGE
    add  x1, x1, _kcc_ir_cur_func@@PAGEOFF
    str x19, [x1]

    // Fresh per-function tables: emit_global_inits' build_expr may consult
    // the locals/statics/label maps even though this body defines no locals.
    mov x0, #64
    bl _kcc_ht_init
    adrp x1, _kcc_ir_locals@@PAGE
    add  x1, x1, _kcc_ir_locals@@PAGEOFF
    str x0, [x1]
    mov x0, #16
    bl _kcc_ht_init
    adrp x1, _kcc_ir_statics@@PAGE
    add  x1, x1, _kcc_ir_statics@@PAGEOFF
    str x0, [x1]
    mov x0, #16
    bl _kcc_ht_init
    adrp x1, _kcc_ir_static_types@@PAGE
    add  x1, x1, _kcc_ir_static_types@@PAGEOFF
    str x0, [x1]
    mov x0, #16
    bl _kcc_ht_init
    adrp x1, _kcc_ir_labels@@PAGE
    add  x1, x1, _kcc_ir_labels@@PAGEOFF
    str x0, [x1]

    // Fresh block-scope shadowing journal for this function.
    adrp x0, _kcc_ir_scope_jdepth@@PAGE
    add  x0, x0, _kcc_ir_scope_jdepth@@PAGEOFF
    str xzr, [x0]
    adrp x0, _kcc_ir_scope_sp@@PAGE
    add  x0, x0, _kcc_ir_scope_sp@@PAGEOFF
    str xzr, [x0]

    // Entry basic block
    bl _kcc_ir_alloc_bb
    mov x20, x0
    str x20, [x19, #IRF_ENTRY]
    mov x0, x20
    bl _kcc_ir_set_bb

    // Body: exactly the stores main would inject
    bl _kcc_ir_emit_global_inits

    // Implicit return
    mov x0, #IR_RET
    bl _kcc_ir_alloc_instr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    bl _kcc_ir_emit
    adrp x1, _kcc_ir_cur_bb@@PAGE
    add  x1, x1, _kcc_ir_cur_bb@@PAGEOFF
    ldr x1, [x1]
    ldr x2, [x1, #BB_FLAGS]
    orr x2, x2, #BB_FLAG_TERMINATED
    str x2, [x1, #BB_FLAGS]

    // Append to the function list so codegen lowers it
    adrp x0, _kcc_ir_funcs@@PAGE
    add  x0, x0, _kcc_ir_funcs@@PAGEOFF
    ldr x0, [x0]
    str x19, [sp, #32]
    add x1, sp, #32
    bl _kcc_vec_push

    // Signal the backend to emit the __mod_init_func pointer
    adrp x0, _kcc_modinit_present@@PAGE
    add  x0, x0, _kcc_modinit_present@@PAGEOFF
    mov x1, #1
    str x1, [x0]

    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_ir_emit_modinit
@}

\section{Building a Function}

For each function, we create an IR function, allocate an entry basic
block, build alloca instructions for parameters and local variables,
then lower the body.

A function whose return type is a \texttt{struct} follows the
\emph{hidden result pointer} convention (Section~\ref{sec:struct-return}):
the caller allocates storage for the returned value and passes its
address as an extra trailing argument.  The callee therefore has one
more incoming parameter than the source declares.  We account for this
by bumping the parameter count when \texttt{IRF\_RETTYPE} is a struct,
which reserves an additional incoming vreg; the codegen prologue spills
it from register~\texttt{x$k$} (where $k$ is the declared parameter
count), and \texttt{build\_return} reads it back as the copy destination.

@d IR: build function @{
// -- kcc_ir_build_func ----------------------------------------------------
// void kcc_ir_build_func(node *func_decl)
//   x0 = AST_FUNC_DECL node (F0=type, F1=name, F2=params, F3=body)
// Builds IR for one function.
.text
.globl _kcc_ir_build_func
.p2align 2
_kcc_ir_build_func:
    stp x29, x30, [sp, #-80]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    str x25, [sp, #64]

    mov x19, x0                  // x19 = func_decl AST

    // Get return type from the resolved type (F3 from sema = type desc)
    // The function type is in F0 (type AST), resolved type should be
    // obtained from the symbol table entry or from AST_F3 (sema type)
    // For now, use int as default; check if sema stored type
    ldr x20, [x19, #AST_F1]     // x20 = name_ptr
    ldr x21, [x19, #AST_F0]     // x21 = type AST

    // Resolve return type from the declarator's type node. A FuncDecl
    // stores its return type directly in F0 (e.g. a StructType); an
    // AST_TYPE_FUNC wrapper, when present, holds it one level down in F0.
    mov x22, #0                  // default ret type = NULL
    cbz x21, .Libf_default_ret
    ldr x0, [x21, #AST_TAG]
    cmp x0, #AST_TYPE_FUNC
    b.ne .Libf_resolve_ret
    ldr x21, [x21, #AST_F0]      // unwrap func type → return type AST
    cbz x21, .Libf_default_ret
.Libf_resolve_ret:
    mov x0, x21
    bl _kcc_sema_resolve_type
    mov x22, x0
    cbz x22, .Libf_default_ret
    b .Libf_create

.Libf_default_ret:
    // Default: signed int
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr x22, [x0]

.Libf_create:
    // Create IR function
    mov x0, x20                  // name
    mov x1, x22                  // ret type
    bl _kcc_ir_alloc_func
    mov x23, x0                  // x23 = ir_func

    // Record the declaration line for DWARF debug info.
    ldr x0, [x19, #AST_LINE]
    str x0, [x23, #IRF_LINE]

    // Propagate internal linkage: bit 1 of the packed params pointer marks a
    // static function, which the emitter turns into a local Mach-O symbol.
    ldr x0, [x19, #AST_F2]
    and x0, x0, #2
    lsr x0, x0, #1               // 1 if static, else 0
    str x0, [x23, #IRF_STATIC]

    // Set as current function
    adrp x1, _kcc_ir_cur_func@@PAGE
    add  x1, x1, _kcc_ir_cur_func@@PAGEOFF
    str x23, [x1]

    // Reset locals hash table
    mov x0, #64
    bl _kcc_ht_init
    adrp x1, _kcc_ir_locals@@PAGE
    add  x1, x1, _kcc_ir_locals@@PAGEOFF
    str x0, [x1]

    // Reset statics hash table (static locals visible only in this function)
    mov x0, #16
    bl _kcc_ht_init
    adrp x1, _kcc_ir_statics@@PAGE
    add  x1, x1, _kcc_ir_statics@@PAGEOFF
    str x0, [x1]

    // Parallel table: static local name → its declared type, so the subscript
    // and identifier-decay paths can tell an array from a pointer once the
    // symbol table's block scope has been popped.
    mov x0, #16
    bl _kcc_ht_init
    adrp x1, _kcc_ir_static_types@@PAGE
    add  x1, x1, _kcc_ir_static_types@@PAGEOFF
    str x0, [x1]

    // Reset label table (label names visible only in this function)
    mov x0, #16
    bl _kcc_ht_init
    adrp x1, _kcc_ir_labels@@PAGE
    add  x1, x1, _kcc_ir_labels@@PAGEOFF
    str x0, [x1]

    // Create entry basic block
    bl _kcc_ir_alloc_bb
    mov x24, x0                  // x24 = entry BB
    str x24, [x23, #IRF_ENTRY]
    mov x0, x24
    bl _kcc_ir_set_bb

    // Count parameters and set IRF_PARAMS (mask the variadic tag in bit 0 and
    // the static tag in bit 1 before dereferencing the param pointer)
    ldr x25, [x19, #AST_F2]     // x25 = first param decl (bit 0=variadic, bit 1=static)
    bic x25, x25, #3
    mov x20, #0                   // param count
.Libf_count_params:
    cbz x25, .Libf_count_done
    ldr x0, [x25, #AST_TAG]
    cmp x0, #AST_PARAM_DECL
    b.ne .Libf_count_next
    ldr x0, [x25, #AST_F1]       // an unnamed param is the `(void)` marker
    cbz x0, .Libf_count_next
    add x20, x20, #1
.Libf_count_next:
    ldr x25, [x25, #AST_F4]
    b .Libf_count_params
.Libf_count_done:
    // AAPCS64 struct return: a struct larger than 16 bytes (class REF) is
    // returned through a hidden result pointer the caller supplies in x8, so
    // reserve one extra incoming vreg for it.  A struct of 16 bytes or less
    // (ST1/ST2) is returned in x0(-x1) and needs no hidden parameter.
    ldr x0, [x23, #IRF_RETTYPE]
    bl _kcc_ir_classify_type
    cmp x0, #4                    // REF (>16B aggregate)
    b.ne .Libf_params_set
    add x20, x20, #1
.Libf_params_set:
    str x20, [x23, #IRF_PARAMS]  // set param count (incl. hidden sret)
    // Record whether the function is variadic (bit 0 of the param-list pointer);
    // codegen needs it to place a register-overflow fixed parameter at the
    // stack offset the variadic caller used.
    ldr x0, [x19, #AST_F2]
    and x0, x0, #1
    str x0, [x23, #IRF_VARIADIC]

    // Record each incoming parameter's AAPCS64 class for the prologue.
    mov x0, x23                   // ir_func
    mov x1, x19                   // func_decl
    bl _kcc_ir_fill_param_classes

    // Reserve incoming-parameter vregs.  A 9..16-byte struct parameter
    // (class ST2) arrives in two registers and occupies two vregs; every
    // other parameter occupies one.  Sum the widths, then reserve that many.
    mov x24, #0                   // total vreg width
    mov x25, #0                   // param index
.Libf_reserve_count:
    cmp x25, x20
    b.ge .Libf_reserve_do
    ldr x0, [x23, #IRF_PARAM_CLS]
    cbz x0, .Libf_rc_one
    ldr x0, [x0, x25, lsl #3]     // class
    cmp x0, #3                    // ST2 → width 2
    b.eq .Libf_rc_two
.Libf_rc_one:
    add x24, x24, #1
    b .Libf_rc_next
.Libf_rc_two:
    add x24, x24, #2
.Libf_rc_next:
    add x25, x25, #1
    b .Libf_reserve_count
.Libf_reserve_do:
    mov x25, #0
.Libf_reserve_vregs:
    cmp x25, x24
    b.ge .Libf_build_params
    bl _kcc_ir_next_vreg
    add x25, x25, #1
    b .Libf_reserve_vregs
.Libf_build_params:

    // Build alloca + store for each parameter, passing its vreg BASE (which
    // accounts for two-vreg ST2 parameters), not its ordinal index.
    ldr x25, [x19, #AST_F2]     // first param decl (bit 0=variadic, bit 1=static)
    bic x25, x25, #3
    mov x20, #0                   // param index
    mov x24, #0                   // vreg base (cumulative)

.Libf_param_loop:
    cbz x25, .Libf_body

    ldr x0, [x25, #AST_TAG]
    cmp x0, #AST_PARAM_DECL
    b.ne .Libf_param_next
    ldr x0, [x25, #AST_F1]       // skip the unnamed `(void)` marker
    cbz x0, .Libf_param_next

    mov x0, x25
    mov x1, x24                   // vreg base for this parameter
    bl _kcc_ir_build_param
    ldr x1, [x23, #IRF_PARAM_CLS]
    ldr x1, [x1, x20, lsl #3]     // class
    cmp x1, #3
    b.ne .Libf_pl_one
    add x24, x24, #2              // ST2 consumed two vregs
    b .Libf_pl_adv
.Libf_pl_one:
    add x24, x24, #1
.Libf_pl_adv:
    add x20, x20, #1

.Libf_param_next:
    ldr x25, [x25, #AST_F4]
    b .Libf_param_loop

.Libf_body:
    // If this is main(), emit global variable initializers first
    ldr x0, [x19, #AST_F1]      // function name
    adrp x1, _kcc_str_main@@PAGE
    add  x1, x1, _kcc_str_main@@PAGEOFF
    bl _kcc_strcmp
    cbnz x0, .Libf_body_stmts
    bl _kcc_ir_emit_global_inits

.Libf_body_stmts:
    // Pre-allocate a BB for every label so forward gotos resolve
    ldr x0, [x19, #AST_F3]
    bl _kcc_ir_prescan_labels

    // Lower the function body (compound statement)
    ldr x0, [x19, #AST_F3]
    bl _kcc_ir_build_stmt

    // Ensure the last BB has a terminator (implicit return)
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    cbz x0, .Libf_register

    ldr x1, [x0, #BB_FLAGS]
    tst x1, #BB_FLAG_TERMINATED
    b.ne .Libf_register

    // Emit implicit return.  Reaching the closing brace of main returns 0
    // (\stdref{5.1.2.2.3}); every other non-void function that falls off the
    // end is undefined behaviour, so it returns no value (unchanged).
    ldr x0, [x23, #IRF_NAME]
    cbz x0, .Libf_impret_void
    adrp x1, .Libf_main_name@@PAGE
    add  x1, x1, .Libf_main_name@@PAGEOFF
    bl _kcc_strcmp
    cbnz x0, .Libf_impret_void
    mov x0, #0
    bl _kcc_ir_emit_const        // vreg holding the constant 0
    str x0, [sp, #72]            // stash across alloc_instr
    mov x0, #IR_RET
    bl _kcc_ir_alloc_instr
    str x22, [x0, #IR_TYPE]
    ldr x1, [sp, #72]
    str x1, [x0, #IR_SRC1]       // main's implicit return value = 0
    bl _kcc_ir_emit
    b .Libf_impret_done
.Libf_impret_void:
    // A function that falls off its end returns no value.  For a void function
    // that is correct; for a value-returning one it is undefined behaviour the
    // caller must not rely on --- but the implicit return must still carry NO
    // type, not the declared one.  Tagging it with a struct/union return type
    // (while leaving SRC1 = 0) made the backend marshal a return value that was
    // never produced: it read vreg 0 (which happens to be the first parameter)
    // as the aggregate's address and faulted.  A null IR_TYPE makes the backend
    // emit a bare RET, returning whatever is in the result registers.
    mov x0, #IR_RET
    bl _kcc_ir_alloc_instr
    str xzr, [x0, #IR_TYPE]     // no value: a bare return
    bl _kcc_ir_emit
.Libf_impret_done:

    // Mark BB terminated
    adrp x1, _kcc_ir_cur_bb@@PAGE
    add  x1, x1, _kcc_ir_cur_bb@@PAGEOFF
    ldr x1, [x1]
    ldr x2, [x1, #BB_FLAGS]
    orr x2, x2, #BB_FLAG_TERMINATED
    str x2, [x1, #BB_FLAGS]

.Libf_register:
    // Add function to global list
    adrp x0, _kcc_ir_funcs@@PAGE
    add  x0, x0, _kcc_ir_funcs@@PAGEOFF
    ldr x0, [x0]
    str x23, [sp, #72]          // store func ptr as element
    add x1, sp, #72
    bl _kcc_vec_push

    ldr x25, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #80
    ret

.section __TEXT,__cstring,cstring_literals
.Libf_main_name:
    .asciz "main"
.text
@| _kcc_ir_build_func
@}

\section{Building Parameters}

Each function parameter gets an \textsc{alloca} for its stack storage
and a \textsc{store} that saves the incoming register value.  The
codegen prologue copies \texttt{x0}--\texttt{x7} into vreg slots
0--7, so the parameter's ``incoming vreg'' is simply its index.
The alloca vreg is recorded in the \texttt{locals} hash table so
that later identifier references find the right address.

\paragraph{Passing a struct by value.}
\label{sec:struct-args}
A \texttt{struct} does not fit a single register, so it is passed the
same way it is returned (\S\ref{sec:struct-return}): the caller places
the \emph{address} of the object in the argument register---
\texttt{build\_call} uses \texttt{\_kcc\_ir\_build\_struct\_addr}
instead of loading a value---and the callee makes its own copy.  Here
in \texttt{build\_param}, a struct parameter therefore allocates its
full $N$-slot storage and, rather than storing the 8-byte register,
copies $N$ slots from the incoming pointer into that storage with
\texttt{\_kcc\_ir\_emit\_struct\_copy}.  The copy is what gives C's
by-value semantics: mutations to the parameter touch the callee's
copy, never the caller's object.  Because each struct argument still
consumes exactly one register (a pointer), this composes cleanly with
the hidden result pointer of struct return and with ordinary scalar
arguments.  Passing more than eight registers' worth of arguments on
the stack remains a separate, still-open ABI item.

@d IR: build param @{
// -- kcc_ir_build_param ---------------------------------------------------
// void kcc_ir_build_param(node *param_decl, uint64_t param_index)
//   x0 = AST_PARAM_DECL (F0=type, F1=name)
//   x1 = param index (0-based, corresponds to reserved vreg)
// Emits alloca + store from the incoming param vreg, records in locals.
// The codegen prologue stores x<i> into vreg slot i. We emit:
//   %N = alloca type
//   store %i, ptr %N        (i = param_index = incoming value vreg)
.text
.globl _kcc_ir_build_param
.p2align 2
_kcc_ir_build_param:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    str x23, [sp, #48]

    mov x19, x0                  // param_decl
    mov x22, x1                  // x22 = param index (= incoming vreg)

    // Resolve type.  An array/function parameter decays to a pointer
    // (\stdref{6.7.6.3}): the callee receives the passed address, so the
    // storage is a single pointer slot, not inline array space.
    ldr x0, [x19, #AST_F0]
    cbz x0, .Libp_done
    bl _kcc_sema_resolve_type
    bl _kcc_type_param_adjust
    mov x20, x0                  // x20 = type desc
    cbz x20, .Libp_done

    // Get name
    ldr x21, [x19, #AST_F1]     // x21 = name ptr
    cbz x21, .Libp_done

    // Slot count: a struct parameter occupies N eight-byte slots and is
    // received as a pointer to the caller's object; a scalar occupies one.
    ldr x0, [x20, #TY_KIND]
    cmp x0, #TY_STRUCT
    b.ne .Libp_scalar_slots
    mov x0, x20
    bl _kcc_ir_type_slots       // x0 = N
    str x0, [sp, #56]
    b .Libp_alloca
.Libp_scalar_slots:
    mov x0, #1
    str x0, [sp, #56]

.Libp_alloca:
    // Emit alloca for param storage
    mov x0, #IR_ALLOCA
    bl _kcc_ir_alloc_instr
    str x20, [x0, #IR_TYPE]
    ldr x1, [sp, #56]
    str x1, [x0, #IR_SRC1]      // slot count (N for struct, 1 for scalar)
    mov x19, x0                  // save instr
    bl _kcc_ir_next_vreg
    str x0, [x19, #IR_DEST]
    mov x23, x0                  // x23 = alloca vreg number
    mov x0, x19
    bl _kcc_ir_emit

    // Initialise parameter storage from the incoming register(s).
    ldr x0, [x20, #TY_KIND]
    cmp x0, #TY_STRUCT
    b.eq .Libp_agg
    cmp x0, #TY_UNION
    b.eq .Libp_agg
    b .Libp_scalar_store

.Libp_agg:
    // <=8B (ST1): arrives as a value in one register → store like a scalar.
    // 9..16B (ST2): arrives in two registers (vregs base, base+1) → store both
    //   words into the alloca.
    // >16B (REF): arrives as a pointer → copy slot by slot.
    mov x0, x20
    bl _kcc_type_layout
    cmp x0, #8
    b.le .Libp_scalar_store
    cmp x0, #16
    b.gt .Libp_struct_copy

    // ST2: reconstruct the 16-byte aggregate from the two incoming vregs.
    mov x0, x23                  // base = alloca vreg
    mov x1, #0                   // byte offset 0
    mov x2, x22                  // value = incoming word 0 (vreg base)
    mov x3, #0
    bl _kcc_ir_emit_indexed_store
    mov x0, x23
    mov x1, #8                   // byte offset 8
    add x2, x22, #1              // value = incoming word 1 (vreg base + 1)
    mov x3, #0
    bl _kcc_ir_emit_indexed_store
    b .Libp_record

.Libp_scalar_store:
    // Scalar / ST1: store the incoming value into the alloca.
    // IR_STORE: SRC1 = value vreg (param index), SRC2 = pointer vreg (alloca)
    // The access-size code (store_width of the parameter type) must be set so a
    // `float` parameter is written to its stack home as a 4-byte single, exactly
    // as every read of it loads a single---otherwise the copy stored 8 double
    // bytes while each use read 4 single bytes, and the value came back as ~0.
    mov x0, #IR_STORE
    bl _kcc_ir_alloc_instr
    str x0, [sp, #56]           // stash store instr
    str x22, [x0, #IR_SRC1]     // value = incoming param vreg
    str x23, [x0, #IR_SRC2]     // ptr = alloca vreg
    str x20, [x0, #IR_TYPE]
    mov x0, x20                 // parameter type → access-size code
    bl _kcc_ir_store_width
    ldr x1, [sp, #56]
    str x0, [x1, #IR_DEST]
    ldr x0, [sp, #56]
    bl _kcc_ir_emit
    b .Libp_record

.Libp_struct_copy:
    // The incoming register holds a pointer to the caller's struct;
    // copy exactly sizeof(param) bytes into this parameter's own storage
    // (pass by value).  x20 still holds the parameter's type descriptor.
    mov x0, x20
    bl _kcc_type_layout
    mov x2, x0                    // byte size (exact)
    mov x0, x22                  // src base = incoming pointer vreg
    mov x1, x23                  // dst base = local param storage
    bl _kcc_ir_emit_struct_copy

.Libp_record:
    // Record in locals: name → alloca vreg
    adrp x0, _kcc_ir_locals@@PAGE
    add  x0, x0, _kcc_ir_locals@@PAGEOFF
    ldr x0, [x0]
    mov x4, x0                   // save ht
    mov x0, x21
    bl _kcc_strlen
    mov x2, x0                   // keylen
    mov x0, x4                   // ht
    mov x1, x21                  // key
    add x3, x23, #1              // value = alloca vreg + 1
    ldr x4, [x20, #TY_KIND]
    cmp x4, #TY_PTR
    b.ne .Libp_put
    orr x3, x3, #0x8000000000000000
.Libp_put:
    bl _kcc_ht_put

.Libp_done:
    ldr x23, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@| _kcc_ir_build_param
@}

\section{Labels and Goto}
\label{sec:ir-goto}

\texttt{goto} may jump \emph{forward} to a label not yet seen, so the
target basic block must exist before any \texttt{goto} is lowered.
Before building a function body, \texttt{\_kcc\_ir\_prescan\_labels}
walks it recursively---through compounds, both arms of an \texttt{if},
loop and \texttt{switch} bodies, and nested labels---allocating a basic
block for every \texttt{AST\_LABEL\_STMT} and recording
name\,$\to$\,block in a per-function table.  Because a block joins the
function's ordered block list only when \texttt{set\_bb} makes it
current, these pre-allocated blocks stay out of the emission order until
their label is actually reached, so code order is preserved.

Lowering then uses two small helpers.
\texttt{\_kcc\_ir\_branch\_to} ends the current block with an
\texttt{IR\_BR} to a target block and marks it terminated---unless it
already has a terminator, in which case it is a no-op.
\texttt{\_kcc\_ir\_label\_bb} resolves a name to its pre-allocated block.
A \emph{label} branches the current block into its own block (a
fall-through) and continues there; a \emph{goto} branches to the target
and opens a fresh block for any unreachable statements that follow.

@d IR: build goto @{
// -- kcc_ir_branch_to -----------------------------------------------------
// void kcc_ir_branch_to(bb *target)
//   Ends the current BB with IR_BR to target (and marks it terminated),
//   unless the current BB already has a terminator.
.text
.globl _kcc_ir_branch_to
.p2align 2
_kcc_ir_branch_to:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]
    mov x19, x0                  // target BB

    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    cbz x0, .Lbrt_done
    ldr x1, [x0, #BB_FLAGS]
    tst x1, #BB_FLAG_TERMINATED
    b.ne .Lbrt_done

    mov x0, #IR_BR
    bl _kcc_ir_alloc_instr
    ldr x1, [x19, #BB_ID]
    str x1, [x0, #IR_SRC1]
    bl _kcc_ir_emit

    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]
.Lbrt_done:
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- kcc_ir_label_bb ------------------------------------------------------
// bb *kcc_ir_label_bb(const char *name)   → pre-allocated BB, or 0
.text
.globl _kcc_ir_label_bb
.p2align 2
_kcc_ir_label_bb:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]
    mov x19, x0
    bl _kcc_strlen
    mov x2, x0                   // keylen
    adrp x0, _kcc_ir_labels@@PAGE
    add  x0, x0, _kcc_ir_labels@@PAGEOFF
    ldr x0, [x0]
    cbz x0, .Llbb_none
    mov x1, x19
    bl _kcc_ht_get
    b .Llbb_done
.Llbb_none:
    mov x0, #0
.Llbb_done:
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- kcc_ir_prescan_labels ------------------------------------------------
// void kcc_ir_prescan_labels(node *stmt)
//   Recursively allocate a BB for every label and register name -> BB.
.text
.globl _kcc_ir_prescan_labels
.p2align 2
_kcc_ir_prescan_labels:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]
    mov x19, x0
    cbz x19, .Lps_done
    ldr x20, [x19, #AST_TAG]

    cmp x20, #AST_COMPOUND
    b.eq .Lps_compound
    cmp x20, #AST_LABEL_STMT
    b.eq .Lps_label
    cmp x20, #AST_IF_STMT
    b.eq .Lps_if
    cmp x20, #AST_WHILE_STMT
    b.eq .Lps_body_f1
    cmp x20, #AST_SWITCH_STMT
    b.eq .Lps_body_f1
    cmp x20, #AST_CASE_STMT
    b.eq .Lps_body_f1
    cmp x20, #AST_DO_STMT
    b.eq .Lps_body_f0
    cmp x20, #AST_DEFAULT_STMT
    b.eq .Lps_body_f0
    cmp x20, #AST_FOR_STMT
    b.eq .Lps_body_f3
    b .Lps_done

.Lps_compound:
    ldr x19, [x19, #AST_F0]
.Lps_comp_loop:
    cbz x19, .Lps_done
    mov x0, x19
    bl _kcc_ir_prescan_labels
    ldr x19, [x19, #AST_F4]
    b .Lps_comp_loop

.Lps_label:
    ldr x21, [x19, #AST_F0]      // label name
    bl _kcc_ir_alloc_bb
    mov x20, x0                  // new BB
    mov x0, x21
    bl _kcc_strlen
    mov x2, x0                   // keylen
    adrp x0, _kcc_ir_labels@@PAGE
    add  x0, x0, _kcc_ir_labels@@PAGEOFF
    ldr x0, [x0]
    mov x1, x21
    mov x3, x20
    bl _kcc_ht_put
    ldr x0, [x19, #AST_F1]       // labelled statement
    bl _kcc_ir_prescan_labels
    b .Lps_done

.Lps_if:
    ldr x0, [x19, #AST_F1]
    bl _kcc_ir_prescan_labels
    ldr x0, [x19, #AST_F2]
    bl _kcc_ir_prescan_labels
    b .Lps_done
.Lps_body_f0:
    ldr x0, [x19, #AST_F0]
    bl _kcc_ir_prescan_labels
    b .Lps_done
.Lps_body_f1:
    ldr x0, [x19, #AST_F1]
    bl _kcc_ir_prescan_labels
    b .Lps_done
.Lps_body_f3:
    ldr x0, [x19, #AST_F3]
    bl _kcc_ir_prescan_labels
.Lps_done:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_ir_branch_to
@| _kcc_ir_label_bb
@| _kcc_ir_prescan_labels
@}

\section{Building Statements}

The statement dispatcher matches the AST tag and calls the
appropriate lowering function.  Expression statements call
\texttt{ir\_build\_expr} and discard the result vreg.  Compound
statements recurse over their children.  All control-flow
statements (if, while, do, for) and break/continue have
dedicated builders in \S\ref{sec:ir-control-flow}; labels and
\texttt{goto} use the helpers of \S\ref{sec:ir-goto}.

\paragraph{Block scope.}
A compound statement opens a name scope.  The locals map, though, is one
flat name~$\to$~vreg hash table for the whole function, so a nested
\texttt{\{ int v; \}} that redeclares an outer \texttt{v} would overwrite
the outer binding and leave it overwritten after the block---the outer
read would then see the inner value.  Rather than give the table a scope
chain, we \emph{journal} it: \texttt{kcc\_ir\_locals\_put} records, before
each write, the name's previous value; \texttt{kcc\_ir\_scope\_enter}
remembers the journal's depth on block entry, and
\texttt{kcc\_ir\_scope\_leave} replays every entry logged since, restoring
the enclosing bindings exactly.  Because the compound handler brackets its
body between an enter and a leave, arbitrary nesting and shadowing come out
right with no per-scope allocation.  The same mechanism gives a block-scope
\texttt{extern} its meaning: it binds the name to the ``resolve as a
global'' marker (value~0) for the block, shadowing any enclosing local so a
reference lowers to a \texttt{GLOBAL\_REF}, then the outer binding returns
on exit.  The journal lives in \texttt{.bss} and is reset per function.

@d IR: build statement @{
// -- kcc_ir_locals_put ----------------------------------------------------
// void kcc_ir_locals_put(char *name, size_t keylen, uint64_t value)
//   Records name → value in the locals map, first journalling the name's
//   PREVIOUS value so the enclosing block scope can be restored on exit.  A
//   value of 0 means "resolve as a global" (a block-scope `extern`), which
//   shadows any enclosing local of the same name for the block's duration.
.text
.globl _kcc_ir_locals_put
.p2align 2
_kcc_ir_locals_put:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    mov x19, x0                   // name
    mov x20, x1                   // keylen
    mov x21, x2                   // value

    // old = ht_get(locals, name, keylen)  --- 0 if the name is unbound
    adrp x0, _kcc_ir_locals@@PAGE
    add  x0, x0, _kcc_ir_locals@@PAGEOFF
    ldr x0, [x0]
    mov x1, x19
    mov x2, x20
    bl _kcc_ht_get
    mov x22, x0                   // previous value

    // journal[jdepth] = {name, keylen, old};  jdepth++
    adrp x0, _kcc_ir_scope_jdepth@@PAGE
    add  x0, x0, _kcc_ir_scope_jdepth@@PAGEOFF
    ldr x1, [x0]
    adrp x2, _kcc_ir_scope_journal@@PAGE
    add  x2, x2, _kcc_ir_scope_journal@@PAGEOFF
    mov x3, #24
    madd x2, x1, x3, x2           // entry = journal + jdepth*24
    str x19, [x2]
    str x20, [x2, #8]
    str x22, [x2, #16]
    add x1, x1, #1
    str x1, [x0]

    // ht_put(locals, name, keylen, value)
    adrp x0, _kcc_ir_locals@@PAGE
    add  x0, x0, _kcc_ir_locals@@PAGEOFF
    ldr x0, [x0]
    mov x1, x19
    mov x2, x20
    mov x3, x21
    bl _kcc_ht_put

    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret

// -- kcc_ir_scope_enter ---------------------------------------------------
// void kcc_ir_scope_enter(void)
//   Marks the start of a block scope by pushing the journal's current depth.
.globl _kcc_ir_scope_enter
.p2align 2
_kcc_ir_scope_enter:
    adrp x0, _kcc_ir_scope_jdepth@@PAGE
    add  x0, x0, _kcc_ir_scope_jdepth@@PAGEOFF
    ldr x1, [x0]                  // current jdepth
    adrp x2, _kcc_ir_scope_sp@@PAGE
    add  x2, x2, _kcc_ir_scope_sp@@PAGEOFF
    ldr x3, [x2]                  // scope sp
    adrp x4, _kcc_ir_scope_stack@@PAGE
    add  x4, x4, _kcc_ir_scope_stack@@PAGEOFF
    str x1, [x4, x3, lsl #3]
    add x3, x3, #1
    str x3, [x2]
    ret

// -- kcc_ir_scope_leave ---------------------------------------------------
// void kcc_ir_scope_leave(void)
//   Ends the current block scope: replays every journal entry recorded since
//   the matching enter, restoring each name's previous locals-map binding.
.globl _kcc_ir_scope_leave
.p2align 2
_kcc_ir_scope_leave:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    adrp x0, _kcc_ir_scope_sp@@PAGE
    add  x0, x0, _kcc_ir_scope_sp@@PAGEOFF
    ldr x1, [x0]
    sub x1, x1, #1
    str x1, [x0]                  // pop scope stack
    adrp x2, _kcc_ir_scope_stack@@PAGE
    add  x2, x2, _kcc_ir_scope_stack@@PAGEOFF
    ldr x19, [x2, x1, lsl #3]     // x19 = saved jdepth (scope floor)

    adrp x20, _kcc_ir_scope_jdepth@@PAGE
    add  x20, x20, _kcc_ir_scope_jdepth@@PAGEOFF
.Lscl_loop:
    ldr x1, [x20]                 // jdepth
    cmp x1, x19
    b.ls .Lscl_done
    sub x1, x1, #1
    str x1, [x20]                 // pop journal entry
    adrp x2, _kcc_ir_scope_journal@@PAGE
    add  x2, x2, _kcc_ir_scope_journal@@PAGEOFF
    mov x3, #24
    madd x21, x1, x3, x2          // entry = journal + jdepth*24
    // ht_put(locals, key, keylen, old_value) --- restores the enclosing binding
    adrp x0, _kcc_ir_locals@@PAGE
    add  x0, x0, _kcc_ir_locals@@PAGEOFF
    ldr x0, [x0]
    ldr x1, [x21]                 // key
    ldr x2, [x21, #8]             // keylen
    ldr x3, [x21, #16]            // previous value
    bl _kcc_ht_put
    b .Lscl_loop
.Lscl_done:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

// -- kcc_ir_build_stmt ----------------------------------------------------
// void kcc_ir_build_stmt(node *stmt)
//   x0 = AST statement node
// Dispatches to the appropriate lowering based on AST_TAG.
.globl _kcc_ir_build_stmt
.p2align 2
_kcc_ir_build_stmt:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    cbz x0, .Libs_done
    mov x19, x0

    ldr x0, [x19, #AST_TAG]

    cmp x0, #AST_COMPOUND
    b.eq .Libs_compound
    cmp x0, #AST_EXPR_STMT
    b.eq .Libs_expr
    cmp x0, #AST_RETURN_STMT
    b.eq .Libs_return
    cmp x0, #AST_IF_STMT
    b.eq .Libs_if
    cmp x0, #AST_WHILE_STMT
    b.eq .Libs_while
    cmp x0, #AST_DO_STMT
    b.eq .Libs_do
    cmp x0, #AST_FOR_STMT
    b.eq .Libs_for
    cmp x0, #AST_VAR_DECL
    b.eq .Libs_var_decl
    cmp x0, #AST_BREAK_STMT
    b.eq .Libs_break
    cmp x0, #AST_CONTINUE_STMT
    b.eq .Libs_continue
    cmp x0, #AST_SWITCH_STMT
    b.eq .Libs_switch
    cmp x0, #AST_LABEL_STMT
    b.eq .Libs_label
    cmp x0, #AST_GOTO_STMT
    b.eq .Libs_goto
    cmp x0, #AST_CASE_STMT
    b.eq .Libs_case
    cmp x0, #AST_DEFAULT_STMT
    b.eq .Libs_default
    cmp x0, #AST_NULL_STMT
    b.eq .Libs_done
    cmp x0, #AST_ASM_STMT
    b.eq .Libs_asm

    // Unhandled statement type — skip
    b .Libs_done

.Libs_asm:
    // Inline assembly: emit an IR_ASM carrying the template pointer (SRC1) and
    // its length (SRC2).  It yields no value; the back end splices the template
    // verbatim into the textual `.s` stream.
    mov x0, #IR_ASM
    bl _kcc_ir_alloc_instr
    ldr x1, [x19, #AST_F0]      // template ptr
    str x1, [x0, #IR_SRC1]
    ldr x1, [x19, #AST_F1]      // template len
    str x1, [x0, #IR_SRC2]
    bl _kcc_ir_emit
    b .Libs_done

.Libs_label:
    // Fall the current block into the label's block, then build the body
    ldr x0, [x19, #AST_F0]      // label name
    bl _kcc_ir_label_bb
    cbz x0, .Libs_label_inner
    mov x20, x0                  // x20 = label BB
    bl _kcc_ir_branch_to
    mov x0, x20
    bl _kcc_ir_set_bb
.Libs_label_inner:
    ldr x0, [x19, #AST_F1]      // labelled statement
    bl _kcc_ir_build_stmt
    b .Libs_done

.Libs_goto:
    ldr x0, [x19, #AST_F0]      // target label name
    bl _kcc_ir_label_bb
    cbz x0, .Libs_done
    bl _kcc_ir_branch_to        // branch to target, terminate current block
    bl _kcc_ir_alloc_bb         // fresh block for unreachable trailing code
    bl _kcc_ir_set_bb
    b .Libs_done

.Libs_case:
    // A `case` label placed by the enclosing switch's scan (its BB is stashed
    // in AST_F2).  Like a goto label, fall the current block into the case
    // block and continue there --- giving C fall-through --- then build the
    // labelled statement.  Labels can nest anywhere in the body, so this path
    // in build_stmt is what makes Duff's device work.
    ldr x20, [x19, #AST_F2]     // case BB (0 if not inside a switch)
    cbz x20, .Libs_case_body
    mov x0, x20
    bl _kcc_ir_branch_to
    mov x0, x20
    bl _kcc_ir_set_bb
.Libs_case_body:
    ldr x0, [x19, #AST_F1]      // labelled statement
    bl _kcc_ir_build_stmt
    b .Libs_done

.Libs_default:
    ldr x20, [x19, #AST_F1]     // default BB (stashed in F1)
    cbz x20, .Libs_default_body
    mov x0, x20
    bl _kcc_ir_branch_to
    mov x0, x20
    bl _kcc_ir_set_bb
.Libs_default_body:
    ldr x0, [x19, #AST_F0]      // labelled statement
    bl _kcc_ir_build_stmt
    b .Libs_done

.Libs_compound:
    // A block introduces a name scope: names it declares (or `extern`-shadows)
    // are undone on exit so an enclosing local of the same name is restored.
    bl _kcc_ir_scope_enter
    // Walk all items in compound statement
    ldr x19, [x19, #AST_F0]     // first item
.Libs_compound_loop:
    cbz x19, .Libs_compound_end
    mov x0, x19
    bl _kcc_ir_build_stmt
    ldr x19, [x19, #AST_F4]
    b .Libs_compound_loop
.Libs_compound_end:
    bl _kcc_ir_scope_leave
    b .Libs_done

.Libs_expr:
    ldr x0, [x19, #AST_F0]      // expression
    bl _kcc_ir_build_expr
    b .Libs_done

.Libs_return:
    mov x0, x19
    bl _kcc_ir_build_return
    b .Libs_done

.Libs_if:
    mov x0, x19
    bl _kcc_ir_build_if
    b .Libs_done

.Libs_while:
    mov x0, x19
    bl _kcc_ir_build_while
    b .Libs_done

.Libs_do:
    mov x0, x19
    bl _kcc_ir_build_do
    b .Libs_done

.Libs_for:
    mov x0, x19
    bl _kcc_ir_build_for
    b .Libs_done

.Libs_var_decl:
    mov x0, x19
    bl _kcc_ir_build_var_decl
    b .Libs_done

.Libs_break:
    mov x0, x19
    bl _kcc_ir_build_break
    b .Libs_done

.Libs_continue:
    mov x0, x19
    bl _kcc_ir_build_continue
    b .Libs_done

.Libs_switch:
    mov x0, x19
    bl _kcc_ir_build_switch
    b .Libs_done

.Libs_done:
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_ir_build_stmt
@}

\section{Building Return}
\label{sec:struct-return}

A return statement evaluates its expression (if any), \emph{converts} the
value to the function's declared return type, emits
\texttt{IR\_RET} with the result vreg as \texttt{SRC1}, and marks
the current basic block as terminated.  The conversion is the same
\stdref{6.8.6.4} coercion an assignment applies: \texttt{return 504} from a
function typed \texttt{double} must yield \texttt{504.0}, not the integer's
bit pattern reinterpreted in a floating register---the defect that made
Lua's \texttt{lua\_version} (\texttt{return LUA\_VERSION\_NUM}) hand back
zero and trip \texttt{luaL\_checkversion}'s ``version mismatch''.  A void
return emits \texttt{IR\_RET} with a void type and no source operand.  The
termination flag prevents the builder from appending further
instructions to this block.

\paragraph{Returning a struct by value.}  When the current function
returns a struct, we do not squeeze the aggregate into result
registers.  Instead the ABI reserves a \emph{hidden result pointer}:
the caller has allocated storage for the value and handed us its
address in the last incoming parameter vreg (\texttt{IRF\_PARAMS}$-1$).
The return therefore reduces to a field-by-field copy from the
returned object into that destination, followed by a void
\texttt{IR\_RET}.  We obtain the source \emph{address} of the returned
expression rather than a loaded scalar: an identifier resolves to its
alloca vreg, a nested call yields the address of its own result buffer,
and \texttt{.f}/\texttt{[i]} lvalues reuse the member and subscript
address builders.  \texttt{\_kcc\_type\_layout} gives the exact byte
size to copy through the hidden \texttt{sret} pointer; copying the exact
size (rather than rounding up to whole slots) avoids overrunning the
caller's result buffer.  A \texttt{union} return takes this same aggregate
path---it too is passed by its address, not squeezed into a register---so the
kind test admits \texttt{TY\_UNION} alongside \texttt{TY\_STRUCT}; routing a
union down the scalar path instead loaded four bytes of member~0 and returned
that in place of the object.  The caller side mirrors this: the call builder
reserves the result buffer for a union return just as for a struct, or the
backend unpacks the returned registers into a never-materialised address.

@d IR: build return @{
// -- kcc_ir_build_return --------------------------------------------------
// void kcc_ir_build_return(node *ret_stmt)
//   x0 = AST_RETURN_STMT (F0=expr or 0)
.text
.globl _kcc_ir_build_return
.p2align 2
_kcc_ir_build_return:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    mov x19, x0
    ldr x0, [x19, #AST_F0]      // return expression
    cbz x0, .Libret_void

    // Struct return-by-value: copy the aggregate to the hidden result
    // pointer instead of returning a scalar in x0.
    adrp x1, _kcc_ir_cur_func@@PAGE
    add  x1, x1, _kcc_ir_cur_func@@PAGEOFF
    ldr x1, [x1]
    ldr x1, [x1, #IRF_RETTYPE]
    cbz x1, .Libret_scalar
    ldr x1, [x1, #TY_KIND]
    cmp x1, #TY_STRUCT
    b.eq .Libret_struct
    cmp x1, #TY_UNION            // a union returns by value exactly like a struct:
    b.eq .Libret_struct         // pass its ADDRESS, not a scalar load of member 0

.Libret_scalar:
    // Build the return expression
    bl _kcc_ir_build_expr
    mov x20, x0                  // x20 = vreg of return value

    // Convert the value to the function's return type (int<->double, widths):
    // `return 504` from a double function must produce 504.0, not int bits.
    adrp x0, _kcc_ir_cur_func@@PAGE
    add  x0, x0, _kcc_ir_cur_func@@PAGEOFF
    ldr x0, [x0]
    ldr x2, [x0, #IRF_RETTYPE]   // to = return type
    cbz x2, .Libret_scalar_emit
    ldr x1, [x19, #AST_F0]      // return expr node
    cbz x1, .Libret_scalar_emit
    ldr x1, [x1, #AST_F3]       // from = expr type
    cbz x1, .Libret_scalar_emit
    mov x0, x20                  // value vreg
    bl _kcc_ir_convert           // (value x0, from x1, to x2) → converted
    mov x20, x0

.Libret_scalar_emit:
    // Emit ret with value
    mov x0, #IR_RET
    bl _kcc_ir_alloc_instr

    // Get return type from current function
    adrp x1, _kcc_ir_cur_func@@PAGE
    add  x1, x1, _kcc_ir_cur_func@@PAGEOFF
    ldr x1, [x1]
    ldr x1, [x1, #IRF_RETTYPE]
    str x1, [x0, #IR_TYPE]
    str x20, [x0, #IR_SRC1]
    bl _kcc_ir_emit

    // Mark BB as terminated
    b .Libret_terminate

.Libret_void:
    mov x0, #IR_RET
    bl _kcc_ir_alloc_instr
    // void ret
    adrp x1, _kcc_type_void@@PAGE
    add  x1, x1, _kcc_type_void@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    bl _kcc_ir_emit
    b .Libret_terminate

.Libret_struct:
    // x0 = return expression node; resolve its struct address (x20).
    bl _kcc_ir_build_struct_addr
    mov x20, x0
    adrp x0, _kcc_ir_cur_func@@PAGE
    add  x0, x0, _kcc_ir_cur_func@@PAGEOFF
    ldr x0, [x0]
    ldr x19, [x0, #IRF_RETTYPE]   // x19 = return type
    mov x0, x19
    bl _kcc_ir_classify_type
    cmp x0, #4                    // REF (>16B) → hidden result pointer
    b.eq .Libret_struct_ref

    // ST1/ST2: return the aggregate in x0(-x1).  IR_RET carries the struct
    // address in SRC1 and the struct type; codegen loads the words.
    mov x0, #IR_RET
    bl _kcc_ir_alloc_instr
    str x19, [x0, #IR_TYPE]
    str x20, [x0, #IR_SRC1]
    bl _kcc_ir_emit
    b .Libret_terminate

.Libret_struct_ref:
    // >16B: copy through the hidden result pointer (received in x8), void ret.
    // Copy exactly sizeof(struct) bytes; the caller's sret buffer is sized to
    // the struct, so rounding up could overrun it.
    mov x0, x19
    bl _kcc_type_layout          // byte size (kept in x2, untouched below)
    mov x2, x0
    // The hidden sret pointer is the last reserved parameter vreg, i.e. the
    // sum of every parameter's vreg width minus one (an ST2 param takes two).
    adrp x0, _kcc_ir_cur_func@@PAGE
    add  x0, x0, _kcc_ir_cur_func@@PAGEOFF
    ldr x0, [x0]
    ldr x3, [x0, #IRF_PARAMS]
    ldr x4, [x0, #IRF_PARAM_CLS]
    mov x1, #0                    // width sum
    mov x5, #0                    // index
.Libret_sret_loop:
    cmp x5, x3
    b.ge .Libret_sret_done
    add x1, x1, #1
    cbz x4, .Libret_sret_next
    ldr x6, [x4, x5, lsl #3]
    cmp x6, #3
    b.ne .Libret_sret_next
    add x1, x1, #1
.Libret_sret_next:
    add x5, x5, #1
    b .Libret_sret_loop
.Libret_sret_done:
    sub x1, x1, #1               // dst = hidden sret vreg
    mov x0, x20                  // src base
    bl _kcc_ir_emit_struct_copy

    mov x0, #IR_RET
    bl _kcc_ir_alloc_instr
    adrp x1, _kcc_type_void@@PAGE
    add  x1, x1, _kcc_type_void@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    bl _kcc_ir_emit

.Libret_terminate:
    adrp x0, _kcc_ir_cur_bb@@PAGE
    add  x0, x0, _kcc_ir_cur_bb@@PAGEOFF
    ldr x0, [x0]
    cbz x0, .Libret_done
    ldr x1, [x0, #BB_FLAGS]
    orr x1, x1, #BB_FLAG_TERMINATED
    str x1, [x0, #BB_FLAGS]

.Libret_done:
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_ir_build_return
@}

\section{String Constants}

The IR dump and builder share a set of string constants for opcode
mnemonics, punctuation, and formatting.  These live in the
\texttt{\_\_TEXT,\_\_cstring} section so the linker can deduplicate
them.  The loop stack data (depth counter and 16-entry array) is
placed in \texttt{.data} since it is mutable at run time.

@d IR: builder data @{
// -- IR builder string constants ------------------------------------------
.section __TEXT,__cstring,cstring_literals

_kcc_str_main:          .asciz "main"
.globl _kcc_str_modinit
_kcc_str_modinit:       .asciz "kcc.module_init"
_kcc_ir_str_func:       .asciz "func @@"
_kcc_ir_str_arrow:      .asciz "() -> "
_kcc_ir_str_colon_nl:   .asciz ":\n"
_kcc_ir_str_bb:         .asciz "  bb"
_kcc_ir_str_indent:     .asciz "    "
_kcc_ir_str_eq:         .asciz " = "
_kcc_ir_str_comma:      .asciz ", %"
_kcc_ir_str_ptr_pct:    .asciz ", ptr %"
_kcc_ir_str_comma_bb:   .asciz ", bb"
_kcc_ir_str_unknown:    .asciz "???"

// Opcode names
_kcc_ir_op_add:         .asciz "add"
_kcc_ir_op_sub:         .asciz "sub"
_kcc_ir_op_mul:         .asciz "mul"
_kcc_ir_op_sdiv:        .asciz "sdiv"
_kcc_ir_op_udiv:        .asciz "udiv"
_kcc_ir_op_smod:        .asciz "smod"
_kcc_ir_op_umod:        .asciz "umod"
_kcc_ir_op_neg:         .asciz "neg"
_kcc_ir_op_and:         .asciz "and"
_kcc_ir_op_or:          .asciz "or"
_kcc_ir_op_xor:         .asciz "xor"
_kcc_ir_op_shl:         .asciz "shl"
_kcc_ir_op_lshr:        .asciz "lshr"
_kcc_ir_op_ashr:        .asciz "ashr"
_kcc_ir_op_not:         .asciz "not"
_kcc_ir_op_cmp_eq:      .asciz "cmp_eq"
_kcc_ir_op_cmp_ne:      .asciz "cmp_ne"
_kcc_ir_op_cmp_slt:     .asciz "cmp_slt"
_kcc_ir_op_cmp_sle:     .asciz "cmp_sle"
_kcc_ir_op_cmp_sgt:     .asciz "cmp_sgt"
_kcc_ir_op_cmp_sge:     .asciz "cmp_sge"
_kcc_ir_op_cmp_ult:     .asciz "cmp_ult"
_kcc_ir_op_cmp_ule:     .asciz "cmp_ule"
_kcc_ir_op_load:        .asciz "load "
_kcc_ir_op_store:       .asciz "store "
_kcc_ir_op_alloca:      .asciz "alloca "
_kcc_ir_op_gep:         .asciz "gep "
_kcc_ir_op_br:          .asciz "br bb"
_kcc_ir_op_br_cond:     .asciz "br_cond %"
_kcc_ir_op_ret:         .asciz "ret "
_kcc_ir_op_call:        .asciz "call "
_kcc_ir_op_call_ind:    .asciz "call_ind "
_kcc_ir_op_sext:        .asciz "sext"
_kcc_ir_op_zext:        .asciz "zext"
_kcc_ir_op_trunc:       .asciz "trunc"
_kcc_ir_op_bitcast:     .asciz "bitcast"
_kcc_ir_op_sitofp:      .asciz "sitofp"
_kcc_ir_op_uitofp:      .asciz "uitofp"
_kcc_ir_op_fptosi:      .asciz "fptosi"
_kcc_ir_op_const:       .asciz "const "
_kcc_ir_op_nop:         .asciz "nop"
_kcc_ir_op_global_ref:  .asciz "global_ref "
_kcc_ir_op_string_lit:  .asciz "string_lit "

// -- Loop stack (break/continue targets) --
.data
.p2align 3
.globl _kcc_loop_depth
_kcc_loop_depth: .quad 0
.globl _kcc_loop_stack
_kcc_loop_stack: .space 256   // 16 levels * 16 bytes (break_bb, continue_bb)
.globl _kcc_ir_trans_unit
_kcc_ir_trans_unit: .quad 0
// Field decl matched by the most recent _kcc_ir_build_member_addr, so the
// member load/store can see its bit-field metadata (0 if none).
.globl _kcc_ir_member_field
_kcc_ir_member_field: .quad 0
// Lazily-cloned `volatile unsigned long` descriptor: a volatile bit-field's
// container load/store carries this so the optimizer sees the volatile bit.
.globl _kcc_ir_vol_longu
_kcc_ir_vol_longu: .quad 0

// Short type names
.section __TEXT,__cstring,cstring_literals
_kcc_ir_ty_void:        .asciz "void"
_kcc_ir_ty_i1:          .asciz "i1"
_kcc_ir_ty_i8:          .asciz "i8"
_kcc_ir_ty_i16:         .asciz "i16"
_kcc_ir_ty_i32:         .asciz "i32"
_kcc_ir_ty_i64:         .asciz "i64"
_kcc_ir_ty_f32:         .asciz "f32"
_kcc_ir_ty_f64:         .asciz "f64"
_kcc_ir_ty_ptr:         .asciz "ptr"
_kcc_ir_ty_struct:      .asciz "struct"
_kcc_ir_ty_unknown:     .asciz "?type"
.Lidts_volstr:          .asciz "volatile "
@| _kcc_ir_str_func
@| _kcc_ir_str_arrow
@| _kcc_ir_str_colon_nl
@| _kcc_ir_str_bb
@| _kcc_ir_str_indent
@| _kcc_ir_str_eq
@| _kcc_ir_str_comma
@| _kcc_ir_str_ptr_pct
@| _kcc_ir_str_comma_bb
@| _kcc_ir_str_unknown
@| _kcc_ir_op_add
@| _kcc_ir_op_sub
@| _kcc_ir_op_mul
@| _kcc_ir_op_sdiv
@| _kcc_ir_op_udiv
@| _kcc_ir_op_smod
@| _kcc_ir_op_umod
@| _kcc_ir_op_neg
@| _kcc_ir_op_and
@| _kcc_ir_op_or
@| _kcc_ir_op_xor
@| _kcc_ir_op_shl
@| _kcc_ir_op_lshr
@| _kcc_ir_op_ashr
@| _kcc_ir_op_not
@| _kcc_ir_op_cmp_eq
@| _kcc_ir_op_cmp_ne
@| _kcc_ir_op_cmp_slt
@| _kcc_ir_op_cmp_sle
@| _kcc_ir_op_cmp_sgt
@| _kcc_ir_op_cmp_sge
@| _kcc_ir_op_cmp_ult
@| _kcc_ir_op_cmp_ule
@| _kcc_ir_op_load
@| _kcc_ir_op_store
@| _kcc_ir_op_alloca
@| _kcc_ir_op_gep
@| _kcc_ir_op_br
@| _kcc_ir_op_br_cond
@| _kcc_ir_op_ret
@| _kcc_ir_op_call
@| _kcc_ir_op_call_ind
@| _kcc_ir_op_sext
@| _kcc_ir_op_zext
@| _kcc_ir_op_trunc
@| _kcc_ir_op_bitcast
@| _kcc_ir_op_const
@| _kcc_ir_op_nop
@| _kcc_ir_op_global_ref
@| _kcc_ir_op_string_lit
@| _kcc_loop_depth
@| _kcc_loop_stack
@| _kcc_ir_ty_void
@| _kcc_ir_ty_i1
@| _kcc_ir_ty_i8
@| _kcc_ir_ty_i16
@| _kcc_ir_ty_i32
@| _kcc_ir_ty_i64
@| _kcc_ir_ty_f32
@| _kcc_ir_ty_f64
@| _kcc_ir_ty_ptr
@| _kcc_ir_ty_struct
@| _kcc_ir_ty_unknown
@}
