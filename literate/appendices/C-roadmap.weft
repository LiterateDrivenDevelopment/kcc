\section{Summary}
\label{sec:roadmap-summary}

\begin{center}
\begin{tabular}{cclll}
\hline
Phase & Status & Milestone & Key Output & \texttt{.weft} Files \\
\hline
0 & \mkDone & Skeleton boots        & \texttt{tmp/kcc} runs         & 01, 02, 07--09, 11, 12, 43 \\
1 & \mkDone & Lexer                 & \texttt{--dump-tokens}        & 10, 14, 17 \\
2 & \mkDone & Diagnostics + tests   & \texttt{just test}            & 13, 15, 16, 44, 45 \\
3 & \mkDone & Preprocessor          & \texttt{-E}                   & 18, 19, 20 \\
4 & \mkDone & Parser                & \texttt{--dump-ast}           & 21--24 \\
5 & \mkDone & Type system           & \texttt{--dump-types}         & 25--30 \\
6 & \mkDone & IR + optimization     & \texttt{--dump-ir}            & 31--36 \\
7 & \mkDone & Backend               & \texttt{-c file.c -o file.o}  & 37--40, 42 \\
