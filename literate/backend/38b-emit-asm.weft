% 38b-emit-asm.weft — Textual .s emission (the assemble-with-`as` backend)
%
% The primary ARM64 backend (Chapter~\ref{ch:emit-arm64}) encodes each
% instruction to a 32-bit word and writes a Mach-O object directly.  This
% chapter provides the SECOND emission strategy from the retargeting playbook:
% render the generated code as textual assembly (`.s`) and let the platform
% assembler produce the object file.  It is the strategy a new target uses, and
% on this target it is what unlocks inline assembly --- an `asm("...")` template
% is simply spliced into the text stream for `as` to assemble.

\chapter{Textual Assembly Emission}
\label{ch:emit-asm}

The direct encoder of Chapter~\ref{ch:emit-arm64} is fast and self-contained,
but it can only emit the fixed instruction set \kcc{} itself selects: it is not
a general assembler, so it cannot turn an arbitrary \texttt{asm("...")} template
into machine code.  The retargeting playbook (Chapter~\ref{ch:retargeting})
describes the alternative---emit textual \texttt{.s} and invoke the platform
assembler---and this chapter implements it for \arch{}.

The renderer works \emph{from the already-generated code buffer}, so the entire
front end, optimiser, register allocator, and instruction selector are reused
unchanged; only the final packaging differs.  For each 32-bit word the code
generator produced, the renderer emits one of two things.  If a relocation
covers that word---a call or a data-address reference whose target address the
linker chooses---it emits the \emph{symbolic} form (\texttt{bl \_f},
\texttt{adrp x0, \_g@@PAGE}, \ldots) so the assembler re-creates the relocation.
Otherwise it emits \texttt{.long 0x\emph{word}}: the assembler reproduces the
exact bytes, and because internal branches are PC-relative and the instruction
sequence is unchanged, their distances are preserved.  This makes the renderer
correct by construction even where it has no pretty-printer for an opcode.

\section{The Output Buffer}

Assembly text is accumulated in a growable arena buffer and written out in one
\texttt{write} at the end.  The helpers below append a byte, a C string, a
decimal number, and an eight-digit hexadecimal word.

@d Emit-asm: data @{
.data
.p2align 3
_kcc_as_buf:   .quad 0        // growable text buffer
_kcc_as_pos:   .quad 0        // bytes used
_kcc_as_cap:   .quad 0        // capacity
_kcc_as_fd:    .quad 0        // open .s file descriptor
// Inline-asm snippets: an array of {code_offset, template_ptr, template_len}
// (24 bytes each) recorded by codegen at each IR_ASM, spliced by the renderer.
.globl _kcc_asm_snips
_kcc_asm_snips:      .quad 0
.globl _kcc_asm_snip_count
_kcc_asm_snip_count: .quad 0
.globl _kcc_asm_snip_cap
_kcc_asm_snip_cap:   .quad 0
// Per-word byte flags: 1 = a branch target that needs a synthetic label.
.globl _kcc_as_targets
_kcc_as_targets:     .quad 0
.section __TEXT,__cstring,cstring_literals
_kcc_as_s_sect:   .asciz "\t.section __TEXT,__text,regular\n"
_kcc_as_s_p2a:    .asciz "\t.p2align 2\n"
_kcc_as_s_globl:  .asciz "\t.globl "
_kcc_as_s_long:   .asciz "\t.long 0x"
_kcc_as_s_byte:   .asciz "\t.byte 0x"
_kcc_as_s_bl:     .asciz "\tbl\t"
_kcc_as_s_adrp:   .asciz "\tadrp\t"
_kcc_as_s_add:    .asciz "\tadd\t"
_kcc_as_s_ldr:    .asciz "\tldr\t"
_kcc_as_s_page:   .asciz "@@PAGE"
_kcc_as_s_pageoff:.asciz "@@PAGEOFF"
_kcc_as_s_gotpage:.asciz "@@GOTPAGE"
_kcc_as_s_gotoff: .asciz "@@GOTPAGEOFF"
_kcc_as_s_hexdig: .asciz "0123456789abcdef"
_kcc_as_s_bdot:   .asciz "\tb."
_kcc_as_s_b:      .asciz "\tb\t"
_kcc_as_s_cbz:    .asciz "\tcbz\t"
_kcc_as_s_cbnz:   .asciz "\tcbnz\t"
_kcc_as_s_lc:     .asciz "Lc"
_kcc_as_s_zerofill:.asciz "\t.zerofill __DATA,__common,"
_kcc_as_s_a3nl:   .asciz ",3\n"
_kcc_as_s_modsect:.asciz "\t.section __DATA,__mod_init_func,mod_init_funcs\n\t.p2align 3\n\t.quad "
// Condition names indexed by cond*3 (two chars + NUL each).
_kcc_as_s_conds:  .ascii "eq\0ne\0hs\0lo\0mi\0pl\0vs\0vc\0hi\0ls\0ge\0lt\0gt\0le\0al\0nv\0"
.globl _kcc_as_s_env
_kcc_as_s_env:    .asciz "KCC_EMIT_ASM"
.text
@}

@d Emit-asm: buffer @{
// -- kcc_as_init ---
// Allocate the text buffer (64 KiB, grows on demand).
.globl _kcc_as_init
.p2align 2
_kcc_as_init:
    stp x29, x30, [sp, #-16]!
    mov x29, sp
    mov x0, #65536
    bl _kcc_arena_alloc
    adrp x1, _kcc_as_buf@@PAGE
    add  x1, x1, _kcc_as_buf@@PAGEOFF
    str x0, [x1]
    adrp x1, _kcc_as_pos@@PAGE
    add  x1, x1, _kcc_as_pos@@PAGEOFF
    str xzr, [x1]
    adrp x1, _kcc_as_cap@@PAGE
    add  x1, x1, _kcc_as_cap@@PAGEOFF
    mov x2, #65536
    str x2, [x1]
    ldp x29, x30, [sp], #16
    ret

// -- kcc_as_ch ---
// void kcc_as_ch(uint32_t byte) — append one byte, growing the buffer if full.
.globl _kcc_as_ch
.p2align 2
_kcc_as_ch:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]
    mov w19, w0                   // byte
    adrp x0, _kcc_as_pos@@PAGE
    add  x0, x0, _kcc_as_pos@@PAGEOFF
    ldr x1, [x0]                  // pos
    adrp x2, _kcc_as_cap@@PAGE
    add  x2, x2, _kcc_as_cap@@PAGEOFF
    ldr x3, [x2]                  // cap
    cmp x1, x3
    b.lo .Lasch_write
    // Grow: double, copy.
    lsl x4, x3, #1
    str x4, [x2]
    mov x0, x4
    bl _kcc_arena_alloc           // new buffer
    mov x5, x0
    adrp x6, _kcc_as_buf@@PAGE
    add  x6, x6, _kcc_as_buf@@PAGEOFF
    ldr x7, [x6]                  // old buffer
    str x5, [x6]
    mov x0, x5
    mov x1, x7
    adrp x2, _kcc_as_pos@@PAGE
    add  x2, x2, _kcc_as_pos@@PAGEOFF
    ldr x2, [x2]
    bl _kcc_memcpy
.Lasch_write:
    adrp x0, _kcc_as_buf@@PAGE
    add  x0, x0, _kcc_as_buf@@PAGEOFF
    ldr x0, [x0]                  // buffer
    adrp x2, _kcc_as_pos@@PAGE
    add  x2, x2, _kcc_as_pos@@PAGEOFF
    ldr x3, [x2]                  // pos
    strb w19, [x0, x3]
    add x3, x3, #1
    str x3, [x2]
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- kcc_as_str ---
// void kcc_as_str(const char *s) — append a NUL-terminated string.
.globl _kcc_as_str
.p2align 2
_kcc_as_str:
    stp x29, x30, [sp, #-16]!
    mov x29, sp
    str x19, [sp, #-16]!          // (scratch save below main frame not needed)
    mov x19, x0
.Lasstr_loop:
    ldrb w0, [x19], #1
    cbz w0, .Lasstr_done
    bl _kcc_as_ch
    b .Lasstr_loop
.Lasstr_done:
    ldr x19, [sp], #16
    ldp x29, x30, [sp], #16
    ret

// -- kcc_as_putn ---
// void kcc_as_putn(const char *p, uint64_t n) — append n raw bytes.
.globl _kcc_as_putn
.p2align 2
_kcc_as_putn:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    mov x19, x0
    mov x20, x1
.Lputn_loop:
    cbz x20, .Lputn_done
    ldrb w0, [x19], #1
    bl _kcc_as_ch
    sub x20, x20, #1
    b .Lputn_loop
.Lputn_done:
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- kcc_as_dec ---
// void kcc_as_dec(uint64_t n) — append decimal digits.
.globl _kcc_as_dec
.p2align 2
_kcc_as_dec:
    stp x29, x30, [sp, #-80]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]
    mov x19, x0
    add x20, sp, #72              // one past the scratch digit area [sp,#48..71]
    add x21, sp, #72              // end marker (fixed)
    cbnz x19, .Lasdec_loop
    mov w0, #'0'
    bl _kcc_as_ch
    b .Lasdec_done
.Lasdec_loop:
    cbz x19, .Lasdec_emit
    mov x2, #10
    udiv x3, x19, x2
    msub x4, x3, x2, x19          // x4 = n % 10
    add w4, w4, #'0'
    strb w4, [x20, #-1]!
    mov x19, x3
    b .Lasdec_loop
.Lasdec_emit:
    // digits from x20 (start) up to x21 (end)
.Lasdec_e2:
    cmp x20, x21
    b.hs .Lasdec_done
    ldrb w0, [x20], #1
    bl _kcc_as_ch
    b .Lasdec_e2
.Lasdec_done:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #80
    ret

// -- kcc_as_hex8 ---
// void kcc_as_hex8(uint32_t w) — append exactly 8 hex digits (no 0x prefix).
.globl _kcc_as_hex8
.p2align 2
_kcc_as_hex8:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    mov w19, w0
    mov w20, #28                  // shift for the top nibble
.Lashex_loop:
    lsr w0, w19, w20
    and w0, w0, #0xf
    adrp x1, _kcc_as_s_hexdig@@PAGE
    add  x1, x1, _kcc_as_s_hexdig@@PAGEOFF
    ldrb w0, [x1, x0]
    bl _kcc_as_ch
    subs w20, w20, #4
    b.ge .Lashex_loop
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- kcc_as_hex2 ---
// void kcc_as_hex2(uint32_t b) — append exactly 2 hex digits (low byte of b).
.globl _kcc_as_hex2
.p2align 2
_kcc_as_hex2:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]
    and w19, w0, #0xff
    lsr w0, w19, #4
    adrp x1, _kcc_as_s_hexdig@@PAGE
    add  x1, x1, _kcc_as_s_hexdig@@PAGEOFF
    ldrb w0, [x1, x0]
    bl _kcc_as_ch
    and w0, w19, #0xf
    adrp x1, _kcc_as_s_hexdig@@PAGE
    add  x1, x1, _kcc_as_s_hexdig@@PAGEOFF
    ldrb w0, [x1, x0]
    bl _kcc_as_ch
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- kcc_as_xreg ---
// void kcc_as_xreg(uint32_t n) — append an x-register name (31 → xzr).
.globl _kcc_as_xreg
.p2align 2
_kcc_as_xreg:
    stp x29, x30, [sp, #-16]!
    mov x29, sp
    str x19, [sp, #-16]!
    mov w19, w0
    cmp w19, #31
    b.eq .Lasxr_zr
    mov w0, #'x'
    bl _kcc_as_ch
    mov x0, x19
    bl _kcc_as_dec
    b .Lasxr_done
.Lasxr_zr:
    mov w0, #'x'
    bl _kcc_as_ch
    mov w0, #'z'
    bl _kcc_as_ch
    mov w0, #'r'
    bl _kcc_as_ch
.Lasxr_done:
    ldr x19, [sp], #16
    ldp x29, x30, [sp], #16
    ret
@}

\section{Rendering the Text Section}

The renderer walks the code buffer one instruction at a time.  Before each
word it emits any symbol \emph{label} defined at that offset; then, if a
relocation covers the word, the symbolic form, else the raw \texttt{.long}.
A small helper appends a symbol's name given its index in the linker's symbol
vector.

@d Emit-asm: render @{
// -- kcc_as_symname ---
// void kcc_as_symname(uint64_t idx) — append symbol[idx].name.
.globl _kcc_as_symname
.p2align 2
_kcc_as_symname:
    stp x29, x30, [sp, #-16]!
    mov x29, sp
    adrp x1, _kcc_linker_syms@@PAGE
    add  x1, x1, _kcc_linker_syms@@PAGEOFF
    ldr x1, [x1]                  // syms vec
    ldr x1, [x1, #VEC_DATA]       // entry array
    mov x2, #SYM_ENTRY_SIZE
    madd x1, x0, x2, x1           // &syms[idx]
    ldr x0, [x1, #SYM_NAME]       // name ptr
    bl _kcc_as_str
    ldp x29, x30, [sp], #16
    ret

// -- kcc_as_reloc_at ---
// uint64_t kcc_as_reloc_at(uint64_t off)
//   Returns pointer to the reloc entry whose RELOC_OFFSET == off, or 0.
.globl _kcc_as_reloc_at
.p2align 2
_kcc_as_reloc_at:
    adrp x1, _kcc_linker_relocs@@PAGE
    add  x1, x1, _kcc_linker_relocs@@PAGEOFF
    ldr x1, [x1]
    ldr x2, [x1, #VEC_COUNT]
    ldr x3, [x1, #VEC_DATA]
    mov x4, #0
.Lasra_loop:
    cmp x4, x2
    b.hs .Lasra_none
    mov x5, #RELOC_SIZE
    madd x6, x4, x5, x3           // &reloc[x4]
    ldr x7, [x6, #RELOC_OFFSET]
    cmp x7, x0
    b.eq .Lasra_hit
    add x4, x4, #1
    b .Lasra_loop
.Lasra_hit:
    mov x0, x6
    ret
.Lasra_none:
    mov x0, #0
    ret

// -- kcc_as_add_snip ---
// void kcc_as_add_snip(uint64_t off, const char *tmpl, uint64_t len)
//   Record an inline-asm snippet at code offset `off`.  Called by codegen.
.globl _kcc_as_add_snip
.p2align 2
_kcc_as_add_snip:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    mov x19, x0                   // off
    mov x20, x1                   // tmpl
    mov x21, x2                   // len
    // Ensure capacity (lazily allocate 16 entries, grow ×2).
    adrp x0, _kcc_asm_snip_cap@@PAGE
    add  x0, x0, _kcc_asm_snip_cap@@PAGEOFF
    ldr x22, [x0]                 // cap
    adrp x0, _kcc_asm_snip_count@@PAGE
    add  x0, x0, _kcc_asm_snip_count@@PAGEOFF
    ldr x2, [x0]                  // count
    cmp x2, x22
    b.lo .Lsnip_store
    // grow
    mov x0, #16
    cmp x22, #0
    csel x22, x0, x22, eq
    lsl x22, x22, #1              // new cap
    mov x0, x22
    mov x1, #24
    mul x0, x0, x1
    bl _kcc_arena_alloc
    mov x3, x0                    // new array
    adrp x0, _kcc_asm_snips@@PAGE
    add  x0, x0, _kcc_asm_snips@@PAGEOFF
    ldr x4, [x0]                  // old array
    str x3, [x0]
    adrp x0, _kcc_asm_snip_cap@@PAGE
    add  x0, x0, _kcc_asm_snip_cap@@PAGEOFF
    str x22, [x0]
    // copy old entries (count*24)
    cbz x4, .Lsnip_store
    adrp x0, _kcc_asm_snip_count@@PAGE
    add  x0, x0, _kcc_asm_snip_count@@PAGEOFF
    ldr x2, [x0]
    mov x1, #24
    mul x2, x2, x1
    mov x0, x3
    mov x1, x4
    bl _kcc_memcpy
.Lsnip_store:
    adrp x0, _kcc_asm_snips@@PAGE
    add  x0, x0, _kcc_asm_snips@@PAGEOFF
    ldr x0, [x0]                  // array
    adrp x1, _kcc_asm_snip_count@@PAGE
    add  x1, x1, _kcc_asm_snip_count@@PAGEOFF
    ldr x2, [x1]                  // count
    mov x3, #24
    madd x0, x2, x3, x0           // &array[count]
    str x19, [x0, #0]            // offset
    str x20, [x0, #8]            // tmpl
    str x21, [x0, #16]           // len
    add x2, x2, #1
    str x2, [x1]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

// -- kcc_as_snip_at ---
// uint64_t kcc_as_snip_at(uint64_t off) — pointer to the snippet at `off`, or 0.
.globl _kcc_as_snip_at
.p2align 2
_kcc_as_snip_at:
    adrp x1, _kcc_asm_snips@@PAGE
    add  x1, x1, _kcc_asm_snips@@PAGEOFF
    ldr x1, [x1]
    cbz x1, .Lsnat_none
    adrp x2, _kcc_asm_snip_count@@PAGE
    add  x2, x2, _kcc_asm_snip_count@@PAGEOFF
    ldr x2, [x2]
    mov x3, #0
.Lsnat_loop:
    cmp x3, x2
    b.hs .Lsnat_none
    mov x4, #24
    madd x5, x3, x4, x1
    ldr x6, [x5, #0]
    cmp x6, x0
    b.eq .Lsnat_hit
    add x3, x3, #1
    b .Lsnat_loop
.Lsnat_hit:
    mov x0, x5
    ret
.Lsnat_none:
    mov x0, #0
    ret

// -- kcc_as_labels_at ---
// void kcc_as_labels_at(uint64_t off) — emit `name:` for every text symbol
// defined at this offset (and `.globl name` first if it is external).
.globl _kcc_as_labels_at
.p2align 2
_kcc_as_labels_at:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    mov x19, x0                   // target offset
    adrp x0, _kcc_linker_syms@@PAGE
    add  x0, x0, _kcc_linker_syms@@PAGEOFF
    ldr x0, [x0]
    ldr x20, [x0, #VEC_COUNT]
    ldr x21, [x0, #VEC_DATA]
    mov x22, #0
.Lasla_loop:
    cmp x22, x20
    b.hs .Lasla_done
    mov x0, #SYM_ENTRY_SIZE
    madd x0, x22, x0, x21         // &sym[x22]
    ldr x1, [x0, #SYM_SECTION]
    cmp x1, #1                    // text section?
    b.ne .Lasla_next
    ldr x1, [x0, #SYM_VALUE]
    cmp x1, x19
    b.ne .Lasla_next
    // Emit `.globl name` if external.  Registers x21 (entry array) and x22
    // (index) are callee-saved and survive the calls, so the symbol pointer is
    // recomputed by madd rather than stashed on the stack.
    ldr x2, [x0, #SYM_FLAGS]
    tst x2, #N_EXT
    b.eq .Lasla_label
    adrp x0, _kcc_as_s_globl@@PAGE
    add  x0, x0, _kcc_as_s_globl@@PAGEOFF
    bl _kcc_as_str
    mov x0, #SYM_ENTRY_SIZE
    madd x0, x22, x0, x21
    ldr x0, [x0, #SYM_NAME]
    bl _kcc_as_str
    mov w0, #'\n'
    bl _kcc_as_ch
.Lasla_label:
    mov x0, #SYM_ENTRY_SIZE
    madd x0, x22, x0, x21
    ldr x0, [x0, #SYM_NAME]
    bl _kcc_as_str
    mov w0, #':'
    bl _kcc_as_ch
    mov w0, #'\n'
    bl _kcc_as_ch
.Lasla_next:
    add x22, x22, #1
    b .Lasla_loop
.Lasla_done:
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

// -- kcc_as_reloc_line ---
// void kcc_as_reloc_line(uint64_t reloc, uint32_t word)
//   Emit the symbolic assembly for a relocated instruction.
.globl _kcc_as_reloc_line
.p2align 2
_kcc_as_reloc_line:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]
    mov x19, x0                   // reloc entry
    mov w20, w1                   // word
    ldr x21, [x19, #RELOC_TYPE]
    and w0, w20, #0x1f            // Rd/Rt = bits[4:0]
    lsr w1, w20, #5
    and w1, w1, #0x1f             // Rn = bits[9:5]
    // Dispatch on reloc type.
    cmp x21, #ARM64_RELOC_BRANCH26
    b.eq .Lasrl_branch
    cmp x21, #ARM64_RELOC_PAGE21
    b.eq .Lasrl_adrp
    cmp x21, #ARM64_RELOC_GOT_LOAD_PAGE21
    b.eq .Lasrl_gotadrp
    cmp x21, #ARM64_RELOC_PAGEOFF12
    b.eq .Lasrl_pageoff
    cmp x21, #ARM64_RELOC_GOT_LOAD_PAGEOFF12
    b.eq .Lasrl_gotoff
    // Unknown reloc type: fall back to a raw word (loses the reloc, but at
    // least assembles); should not happen for the types kcc emits.
    b .Lasrl_done

.Lasrl_branch:
    adrp x0, _kcc_as_s_bl@@PAGE
    add  x0, x0, _kcc_as_s_bl@@PAGEOFF
    bl _kcc_as_str
    ldr x0, [x19, #RELOC_SYM]
    bl _kcc_as_symname
    b .Lasrl_nl

.Lasrl_adrp:
    adrp x0, _kcc_as_s_adrp@@PAGE
    add  x0, x0, _kcc_as_s_adrp@@PAGEOFF
    bl _kcc_as_str
    and w0, w20, #0x1f
    bl _kcc_as_xreg
    mov w0, #','
    bl _kcc_as_ch
    mov w0, #' '
    bl _kcc_as_ch
    ldr x0, [x19, #RELOC_SYM]
    bl _kcc_as_symname
    adrp x0, _kcc_as_s_page@@PAGE
    add  x0, x0, _kcc_as_s_page@@PAGEOFF
    bl _kcc_as_str
    b .Lasrl_nl

.Lasrl_gotadrp:
    adrp x0, _kcc_as_s_adrp@@PAGE
    add  x0, x0, _kcc_as_s_adrp@@PAGEOFF
    bl _kcc_as_str
    and w0, w20, #0x1f
    bl _kcc_as_xreg
    mov w0, #','
    bl _kcc_as_ch
    mov w0, #' '
    bl _kcc_as_ch
    ldr x0, [x19, #RELOC_SYM]
    bl _kcc_as_symname
    adrp x0, _kcc_as_s_gotpage@@PAGE
    add  x0, x0, _kcc_as_s_gotpage@@PAGEOFF
    bl _kcc_as_str
    b .Lasrl_nl

.Lasrl_pageoff:
    // add xD, xN, sym@@PAGEOFF   (kcc materialises an address with add)
    adrp x0, _kcc_as_s_add@@PAGE
    add  x0, x0, _kcc_as_s_add@@PAGEOFF
    bl _kcc_as_str
    and w0, w20, #0x1f
    bl _kcc_as_xreg
    mov w0, #','
    bl _kcc_as_ch
    mov w0, #' '
    bl _kcc_as_ch
    lsr w0, w20, #5
    and w0, w0, #0x1f
    bl _kcc_as_xreg
    mov w0, #','
    bl _kcc_as_ch
    mov w0, #' '
    bl _kcc_as_ch
    ldr x0, [x19, #RELOC_SYM]
    bl _kcc_as_symname
    adrp x0, _kcc_as_s_pageoff@@PAGE
    add  x0, x0, _kcc_as_s_pageoff@@PAGEOFF
    bl _kcc_as_str
    b .Lasrl_nl

.Lasrl_gotoff:
    // ldr xD, [xN, sym@@GOTPAGEOFF]
    adrp x0, _kcc_as_s_ldr@@PAGE
    add  x0, x0, _kcc_as_s_ldr@@PAGEOFF
    bl _kcc_as_str
    and w0, w20, #0x1f
    bl _kcc_as_xreg
    mov w0, #','
    bl _kcc_as_ch
    mov w0, #' '
    bl _kcc_as_ch
    mov w0, #'['
    bl _kcc_as_ch
    lsr w0, w20, #5
    and w0, w0, #0x1f
    bl _kcc_as_xreg
    mov w0, #','
    bl _kcc_as_ch
    mov w0, #' '
    bl _kcc_as_ch
    ldr x0, [x19, #RELOC_SYM]
    bl _kcc_as_symname
    adrp x0, _kcc_as_s_gotoff@@PAGE
    add  x0, x0, _kcc_as_s_gotoff@@PAGEOFF
    bl _kcc_as_str
    mov w0, #']'
    bl _kcc_as_ch
.Lasrl_nl:
    mov w0, #'\n'
    bl _kcc_as_ch
.Lasrl_done:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

// -- kcc_as_wreg ---
// void kcc_as_wreg(uint32_t n) — append a w-register name (31 → wzr).
.globl _kcc_as_wreg
.p2align 2
_kcc_as_wreg:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]
    mov w19, w0
    mov w0, #'w'
    bl _kcc_as_ch
    cmp w19, #31
    b.ne .Laswr_num
    mov w0, #'z'
    bl _kcc_as_ch
    mov w0, #'r'
    bl _kcc_as_ch
    b .Laswr_done
.Laswr_num:
    mov x0, x19
    bl _kcc_as_dec
.Laswr_done:
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- kcc_as_sym_at ---
// uint64_t kcc_as_sym_at(uint64_t off) — name pointer of a text symbol defined
// at `off`, or 0.  Used to reference a branch/call target by its real name.
.globl _kcc_as_sym_at
.p2align 2
_kcc_as_sym_at:
    adrp x1, _kcc_linker_syms@@PAGE
    add  x1, x1, _kcc_linker_syms@@PAGEOFF
    ldr x1, [x1]
    ldr x2, [x1, #VEC_COUNT]
    ldr x3, [x1, #VEC_DATA]
    mov x4, #0
.Lsyat_loop:
    cmp x4, x2
    b.hs .Lsyat_none
    mov x5, #SYM_ENTRY_SIZE
    madd x6, x4, x5, x3
    ldr x7, [x6, #SYM_SECTION]
    cmp x7, #1
    b.ne .Lsyat_next
    ldr x7, [x6, #SYM_VALUE]
    cmp x7, x0
    b.ne .Lsyat_next
    ldr x0, [x6, #SYM_NAME]
    ret
.Lsyat_next:
    add x4, x4, #1
    b .Lsyat_loop
.Lsyat_none:
    mov x0, #0
    ret

// -- kcc_as_branch_kind ---
// uint64_t kcc_as_branch_kind(uint32_t word)
//   0 = not a branch, 1 = b, 2 = bl, 3 = b.cond, 4 = cbz, 5 = cbnz.
.globl _kcc_as_branch_kind
.p2align 2
_kcc_as_branch_kind:
    lsr w1, w0, #26
    cmp w1, #0x05                 // b
    b.eq .Lbk_b
    cmp w1, #0x25                 // bl
    b.eq .Lbk_bl
    lsr w1, w0, #24
    and w2, w1, #0xff
    cmp w2, #0x54                 // b.cond (bits[31:24]=0x54, bit4=0)
    b.ne .Lbk_cb
    tst w0, #0x10
    b.ne .Lbk_none
    mov x0, #3
    ret
.Lbk_cb:
    and w2, w1, #0x7f
    cmp w2, #0x34                 // cbz
    b.eq .Lbk_cbz
    cmp w2, #0x35                 // cbnz
    b.eq .Lbk_cbnz
.Lbk_none:
    mov x0, #0
    ret
.Lbk_b:
    mov x0, #1
    ret
.Lbk_bl:
    mov x0, #2
    ret
.Lbk_cbz:
    mov x0, #4
    ret
.Lbk_cbnz:
    mov x0, #5
    ret

// -- kcc_as_branch_target ---
// uint64_t kcc_as_branch_target(uint32_t word, uint64_t off)
//   Byte offset the branch targets, or (uint64_t)-1 if not a branch.
.globl _kcc_as_branch_target
.p2align 2
_kcc_as_branch_target:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    mov w19, w0                   // word
    mov x20, x1                   // off
    bl _kcc_as_branch_kind        // (x0=word already) → kind
    cbz x0, .Lbt_none
    cmp x0, #2
    b.gt .Lbt_imm19               // kinds 3,4,5 use imm19; 1,2 use imm26
    and w1, w19, #0x03FFFFFF       // imm26
    lsl w1, w1, #6               // sign-extend from bit 25
    asr w1, w1, #6
    b .Lbt_compute
.Lbt_imm19:
    lsr w1, w19, #5
    and w1, w1, #0x7FFFF           // imm19
    lsl w1, w1, #13             // sign-extend from bit 18
    asr w1, w1, #13
.Lbt_compute:
    sxtw x1, w1
    lsl x1, x1, #2               // instructions → bytes
    add x0, x20, x1
    b .Lbt_done
.Lbt_none:
    mov x0, #-1
.Lbt_done:
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- kcc_as_label_ref ---
// void kcc_as_label_ref(uint64_t target) — append the target's symbol name if
// one is defined there, else a synthetic `Lc<target>` label.
.globl _kcc_as_label_ref
.p2align 2
_kcc_as_label_ref:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]
    mov x19, x0
    bl _kcc_as_sym_at             // (x0=target) → name or 0
    cbz x0, .Llr_synth
    bl _kcc_as_str
    b .Llr_done
.Llr_synth:
    adrp x0, _kcc_as_s_lc@@PAGE
    add  x0, x0, _kcc_as_s_lc@@PAGEOFF
    bl _kcc_as_str
    mov x0, x19
    bl _kcc_as_dec
.Llr_done:
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- kcc_as_render_branch ---
// void kcc_as_render_branch(uint32_t word, uint64_t off) — emit the symbolic
// form of an internal (non-relocated) branch, so `as` recomputes its distance.
.globl _kcc_as_render_branch
.p2align 2
_kcc_as_render_branch:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    mov w19, w0                   // word
    mov x20, x1                   // off
    bl _kcc_as_branch_kind        // (x0=word) → kind
    mov x21, x0
    mov w0, w19
    mov x1, x20
    bl _kcc_as_branch_target
    mov x22, x0                   // target
    cmp x21, #1
    b.eq .Lrb_b
    cmp x21, #2
    b.eq .Lrb_bl
    cmp x21, #3
    b.eq .Lrb_bcond
    cmp x21, #4
    b.eq .Lrb_cbz
    b .Lrb_cbnz
.Lrb_b:
    adrp x0, _kcc_as_s_b@@PAGE
    add  x0, x0, _kcc_as_s_b@@PAGEOFF
    bl _kcc_as_str
    mov x0, x22
    bl _kcc_as_label_ref
    b .Lrb_nl
.Lrb_bl:
    adrp x0, _kcc_as_s_bl@@PAGE
    add  x0, x0, _kcc_as_s_bl@@PAGEOFF
    bl _kcc_as_str
    mov x0, x22
    bl _kcc_as_label_ref
    b .Lrb_nl
.Lrb_bcond:
    adrp x0, _kcc_as_s_bdot@@PAGE
    add  x0, x0, _kcc_as_s_bdot@@PAGEOFF
    bl _kcc_as_str
    and w0, w19, #0xf             // cond
    mov w1, #3
    mul w0, w0, w1
    adrp x1, _kcc_as_s_conds@@PAGE
    add  x1, x1, _kcc_as_s_conds@@PAGEOFF
    add x0, x1, x0
    bl _kcc_as_str
    mov w0, #'\t'
    bl _kcc_as_ch
    mov x0, x22
    bl _kcc_as_label_ref
    b .Lrb_nl
.Lrb_cbz:
    adrp x0, _kcc_as_s_cbz@@PAGE
    add  x0, x0, _kcc_as_s_cbz@@PAGEOFF
    bl _kcc_as_str
    b .Lrb_cbcommon
.Lrb_cbnz:
    adrp x0, _kcc_as_s_cbnz@@PAGE
    add  x0, x0, _kcc_as_s_cbnz@@PAGEOFF
    bl _kcc_as_str
.Lrb_cbcommon:
    // register: x if sf(bit31)=1 else w
    and w0, w19, #0x1f
    tst w19, #0x80000000
    b.eq .Lrb_cbw
    bl _kcc_as_xreg
    b .Lrb_cbsep
.Lrb_cbw:
    bl _kcc_as_wreg
.Lrb_cbsep:
    mov w0, #','
    bl _kcc_as_ch
    mov w0, #' '
    bl _kcc_as_ch
    mov x0, x22
    bl _kcc_as_label_ref
.Lrb_nl:
    mov w0, #'\n'
    bl _kcc_as_ch
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

// -- kcc_as_mark_targets ---
// void kcc_as_mark_targets(uint64_t code_size) — allocate the per-word target
// flag array and mark the target of every internal (non-relocated) branch that
// lands where no symbol is defined, so the renderer can emit a synthetic label.
.globl _kcc_as_mark_targets
.p2align 2
_kcc_as_mark_targets:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    mov x19, x0                   // code_size
    lsr x20, x19, #2              // number of words
    add x0, x20, #1
    bl _kcc_arena_alloc
    mov x21, x0                   // flag array
    adrp x1, _kcc_as_targets@@PAGE
    add  x1, x1, _kcc_as_targets@@PAGEOFF
    str x21, [x1]
    // zero it
    mov x2, #0
.Lmt_zero:
    cmp x2, x20
    b.hs .Lmt_scan
    strb wzr, [x21, x2]
    add x2, x2, #1
    b .Lmt_zero
.Lmt_scan:
    mov x22, #0                   // offset
.Lmt_loop:
    cmp x22, x19
    b.hs .Lmt_done
    // Skip relocated words (calls/data refs go through the reloc path).
    mov x0, x22
    bl _kcc_as_reloc_at
    cbnz x0, .Lmt_next
    adrp x0, _kcc_code_buf@@PAGE
    add  x0, x0, _kcc_code_buf@@PAGEOFF
    ldr x0, [x0]
    ldr w0, [x0, x22]            // word
    mov w23, w0
    bl _kcc_as_branch_kind
    cbz x0, .Lmt_next
    mov w0, w23
    mov x1, x22
    bl _kcc_as_branch_target      // x0 = target
    cmn x0, #1
    b.eq .Lmt_next               // -1
    mov x24, x0                   // save target
    bl _kcc_as_sym_at             // (x0=target) → name or 0
    cbnz x0, .Lmt_next           // has a real symbol → no synthetic label
    // mark flag[target/4] = 1
    adrp x0, _kcc_as_targets@@PAGE
    add  x0, x0, _kcc_as_targets@@PAGEOFF
    ldr x0, [x0]
    lsr x1, x24, #2
    mov w2, #1
    strb w2, [x0, x1]
.Lmt_next:
    add x22, x22, #4
    b .Lmt_loop
.Lmt_done:
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret

// -- kcc_as_render_text ---
// void kcc_as_render_text(void) — emit the __text section.  The code buffer is
// [ instructions | string-literal bytes ]: emit_strings appended the cstring
// region and advanced code_pos, so the instructions occupy the first
// (code_pos - cstr_pos) bytes and the string data the rest.  Instructions are
// rendered four bytes at a time (symbolic if relocated, else `.long`); the
// string region is rendered byte at a time as `.byte`, so a literal whose length
// is not a multiple of four, or a label that lands mid-word, is still exact.
.globl _kcc_as_render_text
.p2align 2
_kcc_as_render_text:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    // Section header + alignment.
    adrp x0, _kcc_as_s_sect@@PAGE
    add  x0, x0, _kcc_as_s_sect@@PAGEOFF
    bl _kcc_as_str
    adrp x0, _kcc_as_s_p2a@@PAGE
    add  x0, x0, _kcc_as_s_p2a@@PAGEOFF
    bl _kcc_as_str
    // x22 = total buffer size (code + strings); x20 = code/string boundary.
    adrp x0, _kcc_code_pos@@PAGE
    add  x0, x0, _kcc_code_pos@@PAGEOFF
    ldr x22, [x0]
    adrp x0, _kcc_cstr_pos@@PAGE
    add  x0, x0, _kcc_cstr_pos@@PAGEOFF
    ldr x0, [x0]                  // cstring size
    sub x20, x22, x0              // code_size = code_pos - cstr_pos
    // Mark internal branch targets so they get synthetic labels.
    mov x0, x20
    bl _kcc_as_mark_targets
    mov x19, #0                   // offset
.Lasrt_loop:
    cmp x19, x20
    b.hs .Lasrt_strings
    // Emit any labels at this offset.
    mov x0, x19
    bl _kcc_as_labels_at
    // Synthetic branch-target label (only where no real symbol is defined).
    lsr x0, x19, #2
    adrp x1, _kcc_as_targets@@PAGE
    add  x1, x1, _kcc_as_targets@@PAGEOFF
    ldr x1, [x1]
    cbz x1, .Lasrt_nolabel
    ldrb w2, [x1, x0]
    cbz w2, .Lasrt_nolabel
    adrp x0, _kcc_as_s_lc@@PAGE
    add  x0, x0, _kcc_as_s_lc@@PAGEOFF
    bl _kcc_as_str
    mov x0, x19
    bl _kcc_as_dec
    mov w0, #':'
    bl _kcc_as_ch
    mov w0, #'\n'
    bl _kcc_as_ch
.Lasrt_nolabel:
    // Inline-asm snippet at this offset?  Splice the template verbatim in place
    // of the NOP placeholder the codegen emitted.
    mov x0, x19
    bl _kcc_as_snip_at
    cbz x0, .Lasrt_notsnip
    mov w1, #'\t'
    mov x21, x0                   // snippet entry (callee-saved)
    mov w0, w1
    bl _kcc_as_ch
    ldr x0, [x21, #8]            // template ptr
    ldr x1, [x21, #16]           // template len
    bl _kcc_as_putn
    mov w0, #'\n'
    bl _kcc_as_ch
    b .Lasrt_advance
.Lasrt_notsnip:
    // Load the instruction word.
    adrp x0, _kcc_code_buf@@PAGE
    add  x0, x0, _kcc_code_buf@@PAGEOFF
    ldr x0, [x0]
    ldr w21, [x0, x19]            // word
    // Relocated?
    mov x0, x19
    bl _kcc_as_reloc_at
    cbz x0, .Lasrt_raw
    mov x1, x21
    bl _kcc_as_reloc_line
    b .Lasrt_advance
.Lasrt_raw:
    // Internal (non-relocated) branch → symbolic form so `as` recomputes the
    // distance (robust to inline-asm templates that change the word count).
    mov w0, w21
    bl _kcc_as_branch_kind
    cbz x0, .Lasrt_rawlong
    mov w0, w21
    mov x1, x19
    bl _kcc_as_render_branch
    b .Lasrt_advance
.Lasrt_rawlong:
    adrp x0, _kcc_as_s_long@@PAGE
    add  x0, x0, _kcc_as_s_long@@PAGEOFF
    bl _kcc_as_str
    mov w0, w21
    bl _kcc_as_hex8
    mov w0, #'\n'
    bl _kcc_as_ch
.Lasrt_advance:
    add x19, x19, #4
    b .Lasrt_loop
.Lasrt_strings:
    // String-literal region [code_size, code_pos): one `.byte` per byte, with
    // any string-literal label emitted at its exact offset.
    cmp x19, x22
    b.hs .Lasrt_done
    mov x0, x19
    bl _kcc_as_labels_at
    adrp x0, _kcc_as_s_byte@@PAGE
    add  x0, x0, _kcc_as_s_byte@@PAGEOFF
    bl _kcc_as_str
    adrp x0, _kcc_code_buf@@PAGE
    add  x0, x0, _kcc_code_buf@@PAGEOFF
    ldr x0, [x0]
    ldrb w0, [x0, x19]           // the byte
    bl _kcc_as_hex2
    mov w0, #'\n'
    bl _kcc_as_ch
    add x19, x19, #1
    b .Lasrt_strings
.Lasrt_done:
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@}

\section{Writing the File}

The top-level entry initialises the buffer, renders the text section, and
writes the accumulated bytes to the given path in a single \texttt{write}.

@d Emit-asm: render @{
// -- kcc_as_common_size ---
// uint64_t kcc_as_common_size(uint64_t off) — size of the __common global at
// `off`: the gap to the next section-2 symbol offset, or to the end of the
// __common region.  (kcc stores only offsets, not per-symbol sizes.)
.globl _kcc_as_common_size
.p2align 2
_kcc_as_common_size:
    mov x8, x0                    // this offset
    adrp x1, _kcc_globals_size@@PAGE
    add  x1, x1, _kcc_globals_size@@PAGEOFF
    ldr x9, [x1]                  // best = total common size
    adrp x1, _kcc_linker_syms@@PAGE
    add  x1, x1, _kcc_linker_syms@@PAGEOFF
    ldr x1, [x1]
    ldr x2, [x1, #VEC_COUNT]
    ldr x3, [x1, #VEC_DATA]
    mov x4, #0
.Lcs_loop:
    cmp x4, x2
    b.hs .Lcs_done
    mov x5, #SYM_ENTRY_SIZE
    madd x6, x4, x5, x3
    ldr x7, [x6, #SYM_SECTION]
    cmp x7, #2
    b.ne .Lcs_next
    ldr x7, [x6, #SYM_VALUE]
    cmp x7, x8
    b.ls .Lcs_next               // <= this: not a successor
    cmp x7, x9
    b.hs .Lcs_next               // not smaller than best
    mov x9, x7
.Lcs_next:
    add x4, x4, #1
    b .Lcs_loop
.Lcs_done:
    sub x0, x9, x8
    ret

// -- kcc_as_render_common ---
// void kcc_as_render_common(void) — emit a `.zerofill __DATA,__common` entry for
// every zero-storage global (section 2).  Their initialisers, if any, run as
// ordinary code in the module-init function.
.globl _kcc_as_render_common
.p2align 2
_kcc_as_render_common:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    adrp x0, _kcc_linker_syms@@PAGE
    add  x0, x0, _kcc_linker_syms@@PAGEOFF
    ldr x0, [x0]
    ldr x19, [x0, #VEC_COUNT]
    ldr x20, [x0, #VEC_DATA]
    mov x21, #0
.Lrc_loop:
    cmp x21, x19
    b.hs .Lrc_done
    mov x0, #SYM_ENTRY_SIZE
    madd x22, x21, x0, x20        // &sym[i]
    ldr x0, [x22, #SYM_SECTION]
    cmp x0, #2                    // __common?
    b.ne .Lrc_next
    // .globl if external
    ldr x0, [x22, #SYM_FLAGS]
    tst x0, #N_EXT
    b.eq .Lrc_zf
    adrp x0, _kcc_as_s_globl@@PAGE
    add  x0, x0, _kcc_as_s_globl@@PAGEOFF
    bl _kcc_as_str
    ldr x0, [x22, #SYM_NAME]
    bl _kcc_as_str
    mov w0, #'\n'
    bl _kcc_as_ch
.Lrc_zf:
    adrp x0, _kcc_as_s_zerofill@@PAGE
    add  x0, x0, _kcc_as_s_zerofill@@PAGEOFF
    bl _kcc_as_str
    ldr x0, [x22, #SYM_NAME]
    bl _kcc_as_str
    mov w0, #','
    bl _kcc_as_ch
    ldr x0, [x22, #SYM_VALUE]
    bl _kcc_as_common_size
    bl _kcc_as_dec
    adrp x0, _kcc_as_s_a3nl@@PAGE
    add  x0, x0, _kcc_as_s_a3nl@@PAGEOFF
    bl _kcc_as_str
.Lrc_next:
    add x21, x21, #1
    b .Lrc_loop
.Lrc_done:
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

// -- kcc_as_render_modinit ---
// void kcc_as_render_modinit(void) — when this TU synthesised a module-init
// function, emit the __mod_init_func pointer so dyld runs it before main (this
// is what initialises non-const globals).
.globl _kcc_as_render_modinit
.p2align 2
_kcc_as_render_modinit:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]
    adrp x0, _kcc_modinit_sym@@PAGE
    add  x0, x0, _kcc_modinit_sym@@PAGEOFF
    ldr x19, [x0]                 // symbol index + 1 (0 = none)
    cbz x19, .Lrmi_done
    adrp x0, _kcc_as_s_modsect@@PAGE
    add  x0, x0, _kcc_as_s_modsect@@PAGEOFF
    bl _kcc_as_str
    sub x0, x19, #1
    bl _kcc_as_symname
    mov w0, #'\n'
    bl _kcc_as_ch
.Lrmi_done:
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- kcc_as_render ---
// int kcc_as_render(const char *path) — render the current translation unit's
// generated code as `.s` text and write it to `path`.  Returns 0 on success.
.globl _kcc_as_render
.p2align 2
_kcc_as_render:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    mov x19, x0                   // path
    bl _kcc_as_init
    bl _kcc_as_render_text
    bl _kcc_as_render_common      // __common zero-storage globals
    bl _kcc_as_render_modinit     // __mod_init_func (global initialisers)
    mov x0, x19
    bl _kcc_as_write_file
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- kcc_as_write_file ---
// int kcc_as_write_file(const char *path) — write the rendered text buffer
// (_kcc_as_buf, _kcc_as_pos) to `path` and close it.  Shared by every
// assembly-emission back end (ARM64 `.s` and x86-64), so the buffer globals
// stay file-local to this module.  Returns 0 on success, 1 on error.
.globl _kcc_as_write_file
.p2align 2
_kcc_as_write_file:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x20, [sp, #16]
    // Open the output file (O_WRONLY|O_CREAT|O_TRUNC = 0x601, mode 0644).
    mov x1, #0x601
    mov x2, #420
    bl _kcc_sys_open
    cmp x0, #0
    b.lt .Lawf_err
    mov x20, x0                   // fd
    // write(fd, buf, pos)
    adrp x0, _kcc_as_buf@@PAGE
    add  x0, x0, _kcc_as_buf@@PAGEOFF
    ldr x1, [x0]                  // buffer
    adrp x0, _kcc_as_pos@@PAGE
    add  x0, x0, _kcc_as_pos@@PAGEOFF
    ldr x2, [x0]                  // length
    mov x0, x20                   // fd
    bl _kcc_sys_write
    mov x0, x20
    bl _kcc_sys_close
    mov x0, #0
    b .Lawf_done
.Lawf_err:
    mov x0, #1
.Lawf_done:
    ldr x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@}
