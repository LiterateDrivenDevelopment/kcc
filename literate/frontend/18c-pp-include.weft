% 18c-pp-include.weft — file inclusion and freestanding built-in headers
%
% Split from 18-preprocessor.weft (structural refactor, no content changes):
% #include resolution, the embedded built-in header table (<stdio.h> etc.),
% and the #error directive.

\section{File Inclusion (\texttt{\#include})}

\texttt{\#include "file"} opens and processes the named file.  The
current lexer and source states are pushed onto the context stack.
When the included file reaches EOF, the state is restored and
processing continues in the including file.

\paragraph{Locating the file.}
A quoted include is resolved (\stdref{6.10.2}) relative to the
directory of the file that contains the directive, then---failing
that---by the name as given, which the operating system interprets
against the current working directory.  This is what allows a project
header to sit beside the \texttt{.c} file that includes it regardless
of where the compiler was invoked.  \texttt{\_kcc\_pp\_resolve\_include}
performs the search: it splices the directory prefix of the current
source path onto the include name, probes that candidate with a
throwaway \texttt{open}, and returns the first path that exists (or the
bare name as a last resort).  A \texttt{\_kcc\_pp\_file\_exists} helper
wraps the probe, relying on \texttt{\_kcc\_sys\_open} returning $-1$ for
a file that cannot be opened.  Angle-bracket includes are resolved the
same way for now; a dedicated system search path (\texttt{-I}
directories) is left to Phase~9.  A quoted include that resolves nowhere
is a hard error, but a missing \emph{system} header
(\texttt{\#include <\dots>}) is silently skipped: \kcc{} is freestanding
and supplies what such headers would declare---for instance the
\texttt{va\_*} variadic built-ins---directly, so a program that writes
\texttt{\#include <stdarg.h>} for portability still compiles.

@d PP: resolve include @{
.text
// -- _kcc_pp_file_exists --------------------------------------------
// uint64_t _kcc_pp_file_exists(const char *path)
//   x0 = null-terminated path → 1 if it can be opened, else 0
.p2align 2
_kcc_pp_file_exists:
    stp x29, x30, [sp, #-16]!
    mov x29, sp
    mov x1, #0                   // O_RDONLY
    mov x2, #0
    bl _kcc_sys_open
    cmn x0, #1                   // x0 == -1 ?
    b.eq .Lfe_no
    bl _kcc_sys_close            // opened: close the probe fd
    mov x0, #1
    ldp x29, x30, [sp], #16
    ret
.Lfe_no:
    mov x0, #0
    ldp x29, x30, [sp], #16
    ret

// -- _kcc_pp_resolve_include ----------------------------------------
// char *_kcc_pp_resolve_include(const char *name)
//   x0 = include name → openable path (arena), or 0 if not found.
// Searches the including file's directory first, then the name as given.
.p2align 2
_kcc_pp_resolve_include:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]

    mov x19, x0                  // name
    bl _kcc_strlen
    mov x20, x0                  // namelen

    adrp x0, _kcc_src_path@@PAGE
    add  x0, x0, _kcc_src_path@@PAGEOFF
    ldr  x21, [x0]               // including file path
    cbz x21, .Lri_raw

    // dirlen = length up to and including the last '/'
    mov x22, #0
    mov x23, #0
.Lri_scan:
    ldrb w0, [x21, x23]
    cbz w0, .Lri_scan_done
    cmp w0, #'/'
    b.ne .Lri_scan_next
    add x22, x23, #1
.Lri_scan_next:
    add x23, x23, #1
    b .Lri_scan
.Lri_scan_done:
    cbz x22, .Lri_raw            // no directory prefix

    add x0, x22, x20
    add x0, x0, #1
    bl _kcc_arena_alloc
    mov x24, x0                  // candidate = dir + name + null
    mov x0, x24
    mov x1, x21
    mov x2, x22
    bl _kcc_memcpy
    add x0, x24, x22
    mov x1, x19
    mov x2, x20
    bl _kcc_memcpy
    add x0, x24, x22
    strb wzr, [x0, x20]

    mov x0, x24
    bl _kcc_pp_file_exists
    cbz x0, .Lri_raw
    mov x0, x24
    b .Lri_done

.Lri_raw:
    mov x0, x19
    bl _kcc_pp_file_exists
    cbz x0, .Lri_none
    mov x0, x19
    b .Lri_done

.Lri_none:
    mov x0, #0

.Lri_done:
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@}

@d PP: include @{
.text
// -- _kcc_pp_do_include ---------------------------------------------
.p2align 2
_kcc_pp_do_include:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]

    // Read include path token
    bl _kcc_lex_next
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]

    // Accept string literal "file.h" or scan <file.h>
    cmp  x0, #TOK_STRING_LIT
    b.eq .Lincl_string
    cmp  x0, #TOK_LT
    b.eq .Lincl_angle
    b .Lincl_err

.Lincl_string:
    mov  x22, #0              // x22 = 0: quoted include (must resolve)
    // Token text includes quotes: "file.h"
    // Strip quotes: start+1, len-2
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x19, [x0]
    add  x19, x19, #1         // skip opening "
    adrp x0, _kcc_tok_len@@PAGE
    add  x0, x0, _kcc_tok_len@@PAGEOFF
    ldr  x20, [x0]
    sub  x20, x20, #2         // remove both quotes
    b .Lincl_open

.Lincl_angle:
    mov  x22, #1              // x22 = 1: system <...> include (skippable)
    // Scan from cursor to '>' to get the path
    adrp x0, _kcc_lex_cursor@@PAGE
    add  x0, x0, _kcc_lex_cursor@@PAGEOFF
    ldr  x19, [x0]            // start after <
    adrp x1, _kcc_lex_end@@PAGE
    add  x1, x1, _kcc_lex_end@@PAGEOFF
    ldr  x1, [x1]
    mov  x2, x19
.Lincl_angle_scan:
    cmp  x2, x1
    b.hs .Lincl_err
    ldrb w3, [x2]
    cmp  w3, #'>'
    b.eq .Lincl_angle_found
    cmp  w3, #0x0A
    b.eq .Lincl_err            // newline before >
    add  x2, x2, #1
    b .Lincl_angle_scan
.Lincl_angle_found:
    sub  x20, x2, x19         // path length
    add  x2, x2, #1           // skip >
    adrp x0, _kcc_lex_cursor@@PAGE
    add  x0, x0, _kcc_lex_cursor@@PAGEOFF
    str  x2, [x0]             // update cursor
    b .Lincl_open

.Lincl_open:
    // Create null-terminated path in arena
    add  x0, x20, #1          // +1 for null
    bl _kcc_arena_alloc
    mov  x21, x0              // x21 = path buffer

    mov  x0, x21               // dst
    mov  x1, x19               // src
    mov  x2, x20               // len
    bl _kcc_memcpy

    // Null-terminate
    strb wzr, [x21, x20]

    // Skip rest of directive line
    bl _kcc_pp_skip_line

    // Built-in standard header?  Lex its resident text instead of a file.
    mov  x0, x21
    bl _kcc_pp_builtin_header
    cbz  x0, .Lincl_resolve
    mov  x22, x0                 // header text
    bl _kcc_strlen
    mov  x23, x0                 // length

    mov  x0, #PP_CTX_INCLUDE
    bl _kcc_pp_ctx_push

    adrp x0, _kcc_src_base@@PAGE
    add  x0, x0, _kcc_src_base@@PAGEOFF
    str  x22, [x0]
    adrp x0, _kcc_src_size@@PAGE
    add  x0, x0, _kcc_src_size@@PAGEOFF
    str  x23, [x0]
    adrp x0, _kcc_src_path@@PAGE
    add  x0, x0, _kcc_src_path@@PAGEOFF
    str  x21, [x0]               // path = header name

    mov  x0, x22
    mov  x1, x23
    bl _kcc_lex_init
    adrp x0, _kcc_pp_prev_line@@PAGE
    add  x0, x0, _kcc_pp_prev_line@@PAGEOFF
    str  xzr, [x0]

    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret

.Lincl_resolve:
    // Resolve against the including file's directory, then the name as given
    mov  x0, x21
    bl _kcc_pp_resolve_include
    mov  x21, x0
    cbz  x21, .Lincl_notfound

    // Push current state onto context stack
    mov  x0, #PP_CTX_INCLUDE
    bl _kcc_pp_ctx_push

    // Open and process the included file
    mov  x0, x21
    bl _kcc_source_open
    bl _kcc_source_encode
    bl _kcc_source_splice

    // Initialize lexer on included file
    adrp x0, _kcc_src_base@@PAGE
    add  x0, x0, _kcc_src_base@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_src_size@@PAGE
    add  x1, x1, _kcc_src_size@@PAGEOFF
    ldr  x1, [x1]
    bl _kcc_lex_init

    // Reset prev_line for new file
    adrp x0, _kcc_pp_prev_line@@PAGE
    add  x0, x0, _kcc_pp_prev_line@@PAGEOFF
    str  xzr, [x0]

    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret

.Lincl_notfound:
    // A missing system header (<...>) is silently skipped: kcc is freestanding
    // and provides what it needs (e.g. the va_* builtins) without headers.
    // A missing quoted header ("...") is still a hard error.
    cbnz x22, .Lincl_skip
    adrp x0, _kcc_pp_dir_line@@PAGE
    add  x0, x0, _kcc_pp_dir_line@@PAGEOFF
    ldr  x0, [x0]
    mov  x1, #1
    adrp x2, _kcc_pp_err_notfound@@PAGE
    add  x2, x2, _kcc_pp_err_notfound@@PAGEOFF
    bl _kcc_diag_error
.Lincl_skip:
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret

.Lincl_err:
    adrp x0, _kcc_pp_dir_line@@PAGE
    add  x0, x0, _kcc_pp_dir_line@@PAGEOFF
    ldr  x0, [x0]
    mov  x1, #1
    adrp x2, _kcc_pp_err_include@@PAGE
    add  x2, x2, _kcc_pp_err_include@@PAGEOFF
    bl _kcc_diag_error
    bl _kcc_pp_skip_line
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@}

\subsection{Built-in standard headers}
\label{sec:builtin-headers}

A freestanding compiler that simply skips \verb|#include <stdio.h>| forces
every program to hand-declare \texttt{printf}, \texttt{malloc}, and friends.
That is tolerable for the compiler's own bootstrap sources but hostile to
ordinary C.  Rather than ship header \emph{files} and a search path, kcc
embeds a small set of standard headers directly in the compiler: when the
include machinery is asked for a recognised name it hands back a
compiler-resident C snippet and lexes it in place of a file (the hook in
\texttt{.Lincl\_open} above).  The snippets carry real prototypes, so the
front end learns each function's arity and argument classes---enough to
marshal a call correctly---and the linker resolves the symbols against
\texttt{libSystem}.

The prototypes are deliberately spare: parameters are named (kcc's declarator
parser wants a name), qualifiers are dropped (they do not affect the calling
convention), and \texttt{size\_t}-shaped arguments are written as
\texttt{unsigned long} so no cross-header \texttt{typedef} collides.  Each
header carries an \verb|#ifndef| guard so double inclusion is a no-op.  The
lookup is a linear scan of a name/text table---ten entries, so nothing
fancier is warranted.

The standard streams \texttt{stdin}, \texttt{stdout}, and \texttt{stderr} are
included.  They are not functions but \emph{data} objects imported from
\texttt{libSystem} (\verb|__stdinp| and friends), which the header exposes as
\texttt{extern} declarations with the usual macro aliases.  A dylib-imported
datum has no fixed image address, so a reference to one must load its address
through the global offset table rather than form it with a direct
\verb|adrp|/\verb|add| pair; the back end's \texttt{IR\_GLOBAL\_REF} handler
does exactly this for every external data symbol, so
\texttt{fprintf(stderr, \ldots)} now links and runs.

@d Preprocessor: builtin headers @{
// char *_kcc_pp_builtin_header(const char *name)
//   x0 = include name → compiler-resident header text, or 0 if unknown.
.p2align 2
_kcc_pp_builtin_header:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    mov x19, x0                     // requested include name
    adrp x20, _kcc_pp_builtin_table@@PAGE
    add  x20, x20, _kcc_pp_builtin_table@@PAGEOFF
.Lbh_loop:
    ldr x0, [x20]                   // candidate name (0 terminates table)
    cbz x0, .Lbh_none
    mov x1, x19
    bl _kcc_strcmp
    cbz x0, .Lbh_found
    add x20, x20, #16
    b .Lbh_loop
.Lbh_found:
    ldr x0, [x20, #8]               // matching header text
    b .Lbh_ret
.Lbh_none:
    mov x0, #0
.Lbh_ret:
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

.section __TEXT,__cstring
_kcc_hdr_n_stdio:   .asciz "stdio.h"
_kcc_hdr_n_stdlib:  .asciz "stdlib.h"
_kcc_hdr_n_string:  .asciz "string.h"
_kcc_hdr_n_stddef:  .asciz "stddef.h"
_kcc_hdr_n_stdbool: .asciz "stdbool.h"
_kcc_hdr_n_stdarg:  .asciz "stdarg.h"
_kcc_hdr_n_stdint:  .asciz "stdint.h"
_kcc_hdr_n_ctype:   .asciz "ctype.h"
_kcc_hdr_n_math:    .asciz "math.h"
_kcc_hdr_n_assert:  .asciz "assert.h"

_kcc_hdr_stddef: .asciz "#ifndef _STDDEF_H\n#define _STDDEF_H\ntypedef unsigned long size_t;\ntypedef long ptrdiff_t;\n#define NULL ((void*)0)\n#endif\n"

_kcc_hdr_stdbool: .asciz "#ifndef _STDBOOL_H\n#define _STDBOOL_H\n#define bool int\n#define true 1\n#define false 0\n#endif\n"

_kcc_hdr_stdarg: .asciz "#ifndef _STDARG_H\n#define _STDARG_H\n#endif\n"

_kcc_hdr_stdint: .asciz "#ifndef _STDINT_H\n#define _STDINT_H\ntypedef signed char int8_t;\ntypedef unsigned char uint8_t;\ntypedef short int16_t;\ntypedef unsigned short uint16_t;\ntypedef int int32_t;\ntypedef unsigned int uint32_t;\ntypedef long int64_t;\ntypedef unsigned long uint64_t;\ntypedef long intptr_t;\ntypedef unsigned long uintptr_t;\n#endif\n"

_kcc_hdr_assert: .asciz "#ifndef _ASSERT_H\n#define _ASSERT_H\n#define assert(x) ((void)0)\n#endif\n"

_kcc_hdr_ctype: .asciz "#ifndef _CTYPE_H\n#define _CTYPE_H\nint isalpha(int c);\nint isdigit(int c);\nint isalnum(int c);\nint isspace(int c);\nint isupper(int c);\nint islower(int c);\nint ispunct(int c);\nint toupper(int c);\nint tolower(int c);\n#endif\n"

_kcc_hdr_math: .asciz "#ifndef _MATH_H\n#define _MATH_H\ndouble sqrt(double x);\ndouble pow(double x, double y);\ndouble sin(double x);\ndouble cos(double x);\ndouble tan(double x);\ndouble exp(double x);\ndouble log(double x);\ndouble fabs(double x);\ndouble floor(double x);\ndouble ceil(double x);\ndouble fmod(double x, double y);\n#endif\n"

_kcc_hdr_string: .asciz "#ifndef _STRING_H\n#define _STRING_H\nunsigned long strlen(char *s);\nint strcmp(char *a, char *b);\nint strncmp(char *a, char *b, unsigned long n);\nchar *strcpy(char *d, char *s);\nchar *strncpy(char *d, char *s, unsigned long n);\nchar *strcat(char *d, char *s);\nchar *strncat(char *d, char *s, unsigned long n);\nchar *strchr(char *s, int c);\nchar *strrchr(char *s, int c);\nchar *strstr(char *h, char *n);\nvoid *memcpy(void *d, void *s, unsigned long n);\nvoid *memmove(void *d, void *s, unsigned long n);\nvoid *memset(void *d, int c, unsigned long n);\nint memcmp(void *a, void *b, unsigned long n);\n#endif\n"

_kcc_hdr_stdlib: .asciz "#ifndef _STDLIB_H\n#define _STDLIB_H\nvoid *malloc(unsigned long size);\nvoid *calloc(unsigned long n, unsigned long size);\nvoid *realloc(void *ptr, unsigned long size);\nvoid free(void *ptr);\nvoid exit(int status);\nvoid abort(void);\nint atoi(char *s);\nlong atol(char *s);\nint abs(int x);\nlong labs(long x);\nint rand(void);\nvoid srand(unsigned int seed);\n#endif\n"

_kcc_hdr_stdio: .asciz "#ifndef _STDIO_H\n#define _STDIO_H\ntypedef void FILE;\nextern FILE *__stdinp;\nextern FILE *__stdoutp;\nextern FILE *__stderrp;\n#define stdin __stdinp\n#define stdout __stdoutp\n#define stderr __stderrp\nint printf(char *fmt, ...);\nint fprintf(FILE *stream, char *fmt, ...);\nint sprintf(char *str, char *fmt, ...);\nint snprintf(char *str, unsigned long size, char *fmt, ...);\nint puts(char *s);\nint putchar(int c);\nint fputs(char *s, FILE *stream);\nint fputc(int c, FILE *stream);\nint getchar(void);\nint scanf(char *fmt, ...);\nint sscanf(char *str, char *fmt, ...);\nFILE *fopen(char *path, char *mode);\nint fclose(FILE *stream);\nunsigned long fread(void *ptr, unsigned long size, unsigned long n, FILE *stream);\nunsigned long fwrite(void *ptr, unsigned long size, unsigned long n, FILE *stream);\nint fflush(FILE *stream);\nint fgetc(FILE *stream);\nchar *fgets(char *s, int n, FILE *stream);\nint remove(char *path);\n#endif\n"

.data
.align 3
_kcc_pp_builtin_table:
    .quad _kcc_hdr_n_stdio,   _kcc_hdr_stdio
    .quad _kcc_hdr_n_stdlib,  _kcc_hdr_stdlib
    .quad _kcc_hdr_n_string,  _kcc_hdr_string
    .quad _kcc_hdr_n_stddef,  _kcc_hdr_stddef
    .quad _kcc_hdr_n_stdbool, _kcc_hdr_stdbool
    .quad _kcc_hdr_n_stdarg,  _kcc_hdr_stdarg
    .quad _kcc_hdr_n_stdint,  _kcc_hdr_stdint
    .quad _kcc_hdr_n_ctype,   _kcc_hdr_ctype
    .quad _kcc_hdr_n_math,    _kcc_hdr_math
    .quad _kcc_hdr_n_assert,  _kcc_hdr_assert
    .quad 0, 0
.text
@}

\paragraph{End-to-end tests.}
The preprocessor already runs ahead of the code generator, so these
tests compile and execute programs that lean on it: object-like and
function-like macros, conditional compilation, and---through
\texttt{run\_test\_include}---a shared header that supplies both a macro
constant and a \texttt{struct} definition to the translation unit that
includes it.  The last case is the one that matters for self-hosting: a
project header sitting beside its \texttt{.c} file must be found and its
declarations honoured on the \texttt{-c} path.

@d Test: codegen preprocessor @{
echo ""
echo "--- Preprocessor ---"

run_test "pp-define-const" \
    "#define ANSWER 42
int main(void){ return ANSWER; }" 42

run_test "pp-define-arith" \
    "#define N 5
#define M 3
int main(void){ return N * M; }" 15

run_test "pp-define-funclike" \
    "#define SQ(x) ((x)*(x))
int main(void){ return SQ(6); }" 36

run_test "pp-ifdef-true" \
    "#define DEBUG
int main(void){
#ifdef DEBUG
  return 7;
#else
  return 0;
#endif
}" 7

run_test "pp-ifndef-else" \
    "int main(void){
#ifdef NOPE
  return 0;
#else
  return 9;
#endif
}" 9

run_test_include "pp-include-macro" \
    "#define LIMIT 7" \
    "#include \"defs.h\"
int main(void){ return LIMIT + 3; }" 10

run_test_include "pp-include-struct" \
    "struct Pair { int a; int b; };" \
    "#include \"defs.h\"
int main(void){ struct Pair p; p.a = 4; p.b = 6; return p.a + p.b; }" 10
@}

\section{Error Directive}

\texttt{\#error} emits a diagnostic with the rest of the directive
line as the message.

@d PP: error directive @{
.text
// -- _kcc_pp_do_error -----------------------------------------------
.p2align 2
_kcc_pp_do_error:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    // Get rest of line as message
    bl _kcc_pp_rest_of_line
    mov x19, x0               // msg ptr
    mov x20, x1               // msg len

    // Create null-terminated copy in arena
    add  x0, x20, #1
    bl _kcc_arena_alloc
    mov  x2, x0               // dst
    mov  x0, x2
    mov  x1, x19
    mov  x3, x20
    // memcpy(dst, src, len)
    mov  x1, x19
    mov  x2, x20
    bl _kcc_memcpy

    // Null terminate
    add  x1, x0, x20
    strb wzr, [x1]

    // Emit error
    adrp x1, _kcc_pp_dir_line@@PAGE
    add  x1, x1, _kcc_pp_dir_line@@PAGEOFF
    ldr  x1, [x1]             // line
    mov  x2, x0               // msg (arena copy, null-terminated)
    mov  x0, x1                // line
    mov  x1, #1               // col
    bl _kcc_diag_error

    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@}

