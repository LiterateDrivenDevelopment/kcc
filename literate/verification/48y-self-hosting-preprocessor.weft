% 48y-self-hosting-preprocessor.weft — Stage 8z: the C17 preprocessor, written
% in C, compiled by kcc itself, and linked back into the compiler.

\chapter{Self-Hosting: The Preprocessor in C}
\label{ch:self-hosting-preprocessor}

The preprocessor of Chapters~\ref{ch:preprocessor}--\ref{ch:preprocessor} (the
spine plus its macro, conditional, and include chapters) is the last and most
stateful slice of the front end, and porting it completes the \emph{entire}
front end---lexer, preprocessor, parser, and semantics---in kcc-compiled C.  It
wraps the Phase~3 lexer, executing directives and expanding macros so the parser
sees a fully preprocessed token stream: \texttt{\#define}/\texttt{\#undef} with
object- and function-like macros, argument prescan (\stdref{6.10.3.1}), the
\texttt{\#} and \texttt{\#\#} operators, the \texttt{\#if} family with a
recursive-descent constant-expression evaluator, \texttt{\#include} with a
search path and nine compiler-resident freestanding headers, and the
\texttt{push\_macro}/\texttt{pop\_macro} pragmas.

The port is verified by the strongest oracle available---\texttt{difftest}
byte-compares generated objects against clang, and every case runs through the
preprocessor---plus the self-host and lexer suites and the diagnostic tests.
The preprocessor-heavy real-world corpora (Lua, zlib, bzip2) exercise the macro
machinery far past what a synthetic test would.

\section{State, Constants, and Externs}

@l c
@d Selfhost: pp preamble @{
/* macro definition (56 bytes) */
struct PPMacro {
    const char *name; unsigned long namelen; unsigned long flags;
    unsigned long nparams; const char *body; unsigned long bodylen; void *params;
};
struct PPParam { const char *name; unsigned long len; };   /* 16 bytes */
struct PPArg { const char *start; unsigned long len; };     /* 16 bytes */
struct StrResult { char *buf; unsigned long len; };         /* returned in x0:x1 */
/* context stack entry (80 bytes): saved lexer/source state */
struct PPCtx {
    unsigned long type; const char *cursor; const char *end; unsigned long line;
    const char *lstart; const char *src_base; unsigned long src_size;
    const char *src_path; struct PPMacro *macro; unsigned long prevline;
};
/* push_macro save-stack node (32 bytes) */
struct PPSave { struct PPSave *next; const char *name; unsigned long len; void *saved; };

/* macro flags */
#define PP_FLAG_FUNCLIKE  1
#define PP_FLAG_EXPANDING 2
#define PP_FLAG_BUILTIN   4
#define PP_FLAG_VARIADIC  8
/* context types */
#define PP_CTX_INCLUDE 0
#define PP_CTX_EXPAND  1
/* conditional states */
#define PP_COND_ACTIVE 0
#define PP_COND_SKIP   1
#define PP_COND_DONE   2
/* limits */
#define PP_MAX_CTX_DEPTH 256
#define PP_MAX_COND 64
#define PP_MAX_ARGS 64

/* tokens */
enum {
    TOK_EOF=0, TOK_IDENT=1, TOK_NUMBER=2, TOK_STRING_LIT=4,
    TOK_LPAREN=60, TOK_RPAREN=61, TOK_COMMA=67, TOK_STAR=73, TOK_PLUS=74,
    TOK_MINUS=75, TOK_TILDE=76, TOK_BANG=77, TOK_SLASH=78, TOK_PERCENT=79,
    TOK_SHL=80, TOK_SHR=81, TOK_LT=82, TOK_GT=83, TOK_LE=84, TOK_GE=85,
    TOK_EQ=86, TOK_NE=87, TOK_CARET=88, TOK_PIPE=89, TOK_AND=90, TOK_OR=91,
    TOK_QUESTION=92, TOK_COLON=93, TOK_AMP=72, TOK_HASH=105, TOK_ELLIPSIS=107
};

/* externs — lexer / source globals */
extern unsigned long kcc_x86_os;     /* 1 when the target is Linux/x86-64 */
extern unsigned long kcc_tok_type, kcc_tok_len, kcc_tok_line;
extern const char *kcc_tok_start;
extern const char *kcc_lex_cursor, *kcc_lex_end, *kcc_lex_line_start;
extern unsigned long kcc_lex_line;
extern const char *kcc_src_base, *kcc_src_path;
extern unsigned long kcc_src_size;
void kcc_lex_next(void);
void kcc_lex_init(const char *base, unsigned long size);
void kcc_lex_dump_token(void);
/* externs — hashtable / arena / string / diag / os / source */
void *kcc_ht_init(unsigned long cap);
void kcc_ht_put(void *ht, const void *key, unsigned long keylen, void *val);
void *kcc_ht_get(void *ht, const void *key, unsigned long keylen);
void *kcc_arena_alloc(unsigned long n);
void *kcc_memcpy(void *d, const void *s, unsigned long n);
int kcc_memcmp(const void *a, const void *b, unsigned long n);
unsigned long kcc_strlen(const char *s);
void kcc_diag_error(unsigned long line, unsigned long col, const char *msg);
void kcc_diag_warning(unsigned long line, unsigned long col, const char *msg);
long kcc_sys_open(const char *path, unsigned long flags, unsigned long mode);
long kcc_sys_write(long fd, const void *buf, unsigned long len);
long kcc_sys_close(long fd);
void kcc_sys_exit(long code);
void kcc_source_open(const char *path);
void kcc_source_encode(void);
void kcc_source_splice(void);

/* exported state (driver/other modules reference these) */
void *kcc_pp_macros = 0;
long kcc_line_delta = 0;
unsigned long kcc_pp_counter = 0;                /* __COUNTER__: next value to emit */
unsigned long kcc_pp_ctx_depth = 0;
/* internal state */
static struct PPSave *pp_macro_stack = 0;
static unsigned long pp_eval_depth = 0;
static unsigned long pp_drain_floor = 0;
static unsigned long pp_cond_depth = 0;
static unsigned long pp_prev_line = 0;
static unsigned long pp_has_pending = 0;
static unsigned long pp_dir_line = 0;
static struct PPCtx pp_ctx_stack[PP_MAX_CTX_DEPTH];
static unsigned char pp_cond_stack[PP_MAX_COND];
static const char *pp_inc_dirs[64];
static unsigned long pp_inc_ndirs = 0;
static const char *pp_cmdline_defs[64];
static unsigned long pp_cmdline_ndefs = 0;

/* error messages */
static const char m_unknown_dir[] = "unknown preprocessing directive";
static const char m_def_name[]  = "expected identifier after #define";
static const char m_def_param[] = "expected parameter name or ')' in macro parameter list";
static const char m_ifdef_name[]= "expected identifier after #ifdef/#ifndef";
static const char m_stray_elif[]= "#elif without matching #if";
static const char m_stray_else[]= "#else without matching #if";
static const char m_stray_endif[]="#endif without matching #if";
static const char m_include[]   = "#include expects \"file\" or <file>";
static const char m_notfound[]  = "#include file not found";
static const char m_unterm_cond[]="unterminated conditional directive";
static const char m_unterm_args[]="unterminated macro argument list";
static const char m_depth[]     = "maximum include/expansion depth exceeded";

/* forward decls */
void kcc_pp_next(void);
int kcc_pp_try_expand(void);
unsigned long kcc_pp_atoi(const char *p, unsigned long len);
long kcc_pp_eval_expr(void);
void kcc_pp_do_line(void);
void kcc_pp_add_include_dir(const char *dir);
void kcc_pp_apply_cmdline_defines(void);
static void pp_dispatch(void);
static void pp_skip_directive(void);
static void pp_ctx_pop(void);
static void pp_skip_line(void);
static const char *pp_rest_of_line(unsigned long *len_out);
static void pp_predefine(void);
static void pp_do_endif(void);
static void pp_do_elif(void);
static void pp_do_else(void);
static void pp_def_simple(const char *name, unsigned long nl, const char *body, unsigned long bl);
static const char *pp_prepare_cond(const char *src, unsigned long len, unsigned long *lo);
static const char *pp_builtin_header(const char *name);
static int kcc_strcmp2(const char *a, const char *b);
void kcc_pp_init(void);
void kcc_pp_dump_all(void);
void kcc_pp_do_define(void);
