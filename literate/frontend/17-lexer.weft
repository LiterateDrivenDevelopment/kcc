\paragraph{Punctuator name strings.}
Each punctuator token type has a corresponding human-readable name
used in the \texttt{--dump-tokens} output.  The names follow the
convention used by Clang's token dump format: \texttt{l\_paren},
\texttt{semi}, \texttt{plusplus}, \texttt{lessequal}, and so on.

@d Lexer: token names @{
// Punctuators
_kcc_tn_lparen:       .asciz "l_paren"
_kcc_tn_rparen:       .asciz "r_paren"
_kcc_tn_lbrace:       .asciz "l_brace"
_kcc_tn_rbrace:       .asciz "r_brace"
_kcc_tn_lbracket:     .asciz "l_bracket"
_kcc_tn_rbracket:     .asciz "r_bracket"
_kcc_tn_semi:         .asciz "semi"
_kcc_tn_comma:        .asciz "comma"
_kcc_tn_dot:          .asciz "dot"
_kcc_tn_arrow:        .asciz "arrow"
_kcc_tn_plusplus:     .asciz "plusplus"
_kcc_tn_minusminus:  .asciz "minusminus"
_kcc_tn_amp:          .asciz "amp"
_kcc_tn_star:         .asciz "star"
_kcc_tn_plus:         .asciz "plus"
_kcc_tn_minus:        .asciz "minus"
_kcc_tn_tilde:        .asciz "tilde"
_kcc_tn_exclaim:      .asciz "exclaim"
_kcc_tn_slash:        .asciz "slash"
_kcc_tn_percent:      .asciz "percent"
_kcc_tn_lessless:     .asciz "lessless"
_kcc_tn_greatergreater: .asciz "greatergreater"
_kcc_tn_less:         .asciz "less"
_kcc_tn_greater:      .asciz "greater"
_kcc_tn_lessequal:    .asciz "lessequal"
_kcc_tn_greaterequal: .asciz "greaterequal"
_kcc_tn_equalequal:   .asciz "equalequal"
_kcc_tn_exclaimequal: .asciz "exclaimequal"
_kcc_tn_caret:        .asciz "caret"
_kcc_tn_pipe:         .asciz "pipe"
_kcc_tn_ampamp:       .asciz "ampamp"
_kcc_tn_pipepipe:     .asciz "pipepipe"
_kcc_tn_question:     .asciz "question"
_kcc_tn_colon:        .asciz "colon"
_kcc_tn_equal:        .asciz "equal"
_kcc_tn_starequal:    .asciz "starequal"
_kcc_tn_slashequal:   .asciz "slashequal"
_kcc_tn_percentequal: .asciz "percentequal"
_kcc_tn_plusequal:    .asciz "plusequal"
_kcc_tn_minusequal:   .asciz "minusequal"
_kcc_tn_lesslessequal: .asciz "lesslessequal"
