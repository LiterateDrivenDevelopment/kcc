% -- Differential testing against clang -------------------------------

\noindent\textbf{difftest.sh} --- compile each program with \kcc{} and
\texttt{clang}, run both, compare (Chapter~\ref{ch:differential-testing}):

@o tests/difftest.sh @{
@<Difftest: runner@>
@<Difftest: arithmetic@>
@<Difftest: control@>
@<Difftest: functions@>
@<Difftest: aggregates@>
@<Difftest: struct layout@>
@<Difftest: floating point@>
@<Difftest: operators@>
@<Difftest: combinations@>
@<Difftest: language@>
@<Difftest: divergences@>
@<Difftest: gaps@>
@<Difftest: results@>
@}

\noindent\textbf{interop.sh} --- compile one translation unit with \kcc{} and
the other with \texttt{clang}, link, run, compare to the all-\texttt{clang}
oracle (Chapter~\ref{ch:interop-testing}):

@o tests/interop.sh @{
@<Interop: runner@>
@<Interop: cases@>
@<Interop: results@>
@}

\noindent\textbf{e2e.sh} --- drive the whole toolchain like a user:
\texttt{kcc src.c -o out} then run \texttt{out} (Section~\ref{sec:e2e-tests}):

@o tests/e2e.sh @{
@<E2E: runner@>
@}

\noindent\textbf{diagtest.sh} --- feed the compiler invalid programs and
check the diagnostics (Section~\ref{sec:diag-tests}):

@o tests/diagtest.sh @{
@<Diag: tests@>
@}

\noindent\textbf{warntest.sh} --- feed the compiler valid programs and
check that \texttt{-Wall} warns while the default build stays silent
(Section~\ref{sec:warn-tests}):

@o tests/warntest.sh @{
@<Warn: tests@>
@}

\subsection*{Kernel-boot reproduction}

The capstone demonstration of \S\ref{sec:um-kernelboot}---\kcc{} compiling
\texttt{init/main.o} of a Linux~6.6 kernel that boots to a BusyBox login
shell---tangles to a Docker build recipe and five numbered scripts under
\texttt{gen/repro/}, with \texttt{run-all.sh} to chain the build steps.  The
prose for each lives with the manual section; here we only route the output.

@o repro/Dockerfile @{@<Repro: Dockerfile@>@}
@o repro/01-image.sh @{@<Repro: 01 build image@>@}
@o repro/02-build-kcc.sh @{@<Repro: 02 build kcc@>@}
@o repro/03-kernel.sh @{@<Repro: 03 build kernel@>@}
@o repro/04-initramfs.sh @{@<Repro: 04 initramfs@>@}
@o repro/05-boot.sh @{@<Repro: 05 boot@>@}
@o repro/run-all.sh @{@<Repro: run all@>@}


\section*{The build recipe}

The build is not described in a file kept separately from the book---it is
itself a tangled artifact.  The chunk below emits the project \texttt{Makefile}
into the repository root (the \texttt{../} escapes the \texttt{gen/} prefix that
\texttt{-p} prepends to every other output), so the one command
\begin{quote}\ttfamily weft -p gen/ -{}-mkdirs kcc.weft\end{quote}
\noindent tangles the compiler's sources, the verification scripts, and the
\texttt{Makefile} that drives them, all into \texttt{gen/} (and the root
\texttt{Makefile}).  From there, ordinary \texttt{make} targets do the rest.
The generated sources live under \texttt{gen/} and are never edited by hand;
\texttt{make clean} removes the whole directory, and the command above
regenerates it.

The version string \emph{itself} is single-sourced from the \texttt{version}
fragment defined in the master document.  Tangling it to a plain
\texttt{gen/VERSION} file lets non-\weft{} artifacts share that one value: the
\texttt{pdf} target below substitutes it into the cover \texttt{.svg}
templates (which carry a \texttt{\{\{VERSION\}\}} placeholder) before
rasterising them, so the covers, the compiler's banner, and this book never
disagree about which version they describe.

@o VERSION -s @{@<version@>@}

The tutorial's first program (\S\ref{sec:um-first}) is tangled here too, so a
freshly built compiler has something to compile: \texttt{gen/hello.c}.

@o hello.c -s @{@<Tutorial: hello world@>@}

@o ../Makefile -t -s @{
# kcc — A Formal C17 Compiler in ARM64 Assembly
# Build pipeline: .weft → weft tangle → .s → as → .o → ld → kcc
#
# This Makefile is itself a tangled artifact: it is generated into the repo
# root by `weft -p gen/ --mkdirs kcc.weft` (the @@o ../Makefile chunk in
# literate/assembly.weft). Do not edit it here; edit the book.
#
# Written for the system make (GNU Make 3.81), which
# lacks .ONESHELL/.SHELLFLAGS, so each multi-command recipe is a single logical
# line (joined with \) that begins with `set -e` for fail-fast behaviour.
# Command echo is silenced (.SILENT) to match the original `set quiet`.

SHELL := /bin/bash
.SILENT:

# All assembly source basenames (order doesn't matter for linking)
sources := main syscalls arena strings io hashtab vec strtab source lexer lexer_tables diag preprocessor parser expressions statements declarations types symtab conversions sema ir opt emit_arm64 emit_x86 linker codegen emit_macho dwarf driver

# Library sources (everything except main — shared with the test binary)
lib_sources := syscalls arena strings io hashtab vec strtab source lexer lexer_tables diag preprocessor parser expressions statements declarations types symtab conversions sema ir opt emit_arm64 emit_x86 linker codegen emit_macho dwarf driver

# Test source basenames (in gen/tests/)
test_sources := test_runner test_lexer

# SDK root for the linker
SDKROOT := $(shell xcrun --show-sdk-path)
LDFLAGS := -lSystem -syslibroot $(SDKROOT) -e _main -arch arm64

.DEFAULT_GOAL := build

.PHONY: all default ci tangle assemble build test selfhost selfhost-lexer \
        selfhost-types selfhost-opt selfhost-lexer-tables selfhost-linker \
        selfhost-statements selfhost-emit-macho selfhost-expressions selfhost-parser selfhost-driver \
        selfhost-declarations selfhost-dwarf selfhost-emit-arm64 selfhost-sema \
        selfhost-emit-x86 selfhost-preprocessor selfhost-codegen selfhost-ir selfhost-main selfhost-lexer-core meta-a meta-c \
        difftest interop e2e diagtest warntest test-codegen weave pdf clean \
        run map

# Default: build everything
all default: build

# CI: the complete verification suite, in one entry point. Fast native checks
# run first (fail fast); the meta-* self-host milestones run last and need
# Docker + qemu-user. Prerequisites share `build`, so it is assembled once.
ci: build test difftest interop e2e diagtest warntest test-codegen meta-a meta-c
	echo "=== ci: all suites passed ==="

# Tangle: weave the literate sources into gen/ (sources, scripts, and this
# Makefile itself). -p prepends gen/ to every @@o path; --mkdirs creates the
# output directories. This target regenerates the very Makefile that defines
# it, so the build description never drifts from the book.
tangle:
	weft -p gen/ --mkdirs kcc.weft

# Assemble: compile each .s to .o
assemble: tangle
	set -e; for f in $(sources); do as -o gen/src/$${f}.o gen/src/$${f}.s; done

# Link: produce the kcc binary
build: assemble
	set -e; OBJ=""; for f in $(sources); do OBJ="$$OBJ gen/src/$${f}.o"; done; \
	ld -o gen/kcc $$OBJ $(LDFLAGS)

# Test: build and run the unit-test suite
test: tangle
	set -e; \
	for f in $(lib_sources); do as -o gen/src/$${f}.o gen/src/$${f}.s; done; \
	for f in $(test_sources); do as -o gen/tests/$${f}.o gen/tests/$${f}.s; done; \
	OBJ=""; \
	for f in $(lib_sources); do OBJ="$$OBJ gen/src/$${f}.o"; done; \
	for f in $(test_sources); do OBJ="$$OBJ gen/tests/$${f}.o"; done; \
	ld -o gen/test_kcc $$OBJ $(LDFLAGS); \
	echo ""; \
	./gen/test_kcc

# Self-hosting (Stage 8b): compile kcc's arena in C with kcc, relink, run suite
selfhost: build
	chmod +x gen/selfhost/selfhost.sh
	gen/selfhost/selfhost.sh

# Self-hosting (Stage 8b): compile a C tokenizer with kcc, self-test, diff clang
selfhost-lexer: build
	chmod +x gen/selfhost/lexer_verify.sh
	gen/selfhost/lexer_verify.sh

# Self-hosting (Stage 8c): compile kcc's vector in C with kcc, relink, run suite
selfhost-vec: build
	chmod +x gen/selfhost/vec_verify.sh
	gen/selfhost/vec_verify.sh

# Self-hosting (Stage 8d): compile kcc's string primitives in C, relink, run suite
selfhost-strings: build
	chmod +x gen/selfhost/strings_verify.sh
	gen/selfhost/strings_verify.sh

# Self-hosting (Stage 8e): compile kcc's hash table in C, relink, run suite
selfhost-hashtab: build
	chmod +x gen/selfhost/hashtab_verify.sh
	gen/selfhost/hashtab_verify.sh

# Self-hosting (Stage 8f): compile kcc's string interner in C, relink, run suite
selfhost-strtab: build
	chmod +x gen/selfhost/strtab_verify.sh
	gen/selfhost/strtab_verify.sh

# Self-hosting (Stage 8g): compile kcc's buffered output in C, relink, run suite
selfhost-io: build
	chmod +x gen/selfhost/io_verify.sh
	gen/selfhost/io_verify.sh

# Self-hosting (Stage 8h): compile kcc's source manager in C, relink, run suite
selfhost-source: build
	chmod +x gen/selfhost/source_verify.sh
	gen/selfhost/source_verify.sh

# Self-hosting (Stage 8i): compile kcc's diagnostic engine in C, relink, run suites
selfhost-diag: build
	chmod +x gen/selfhost/diag_verify.sh
	gen/selfhost/diag_verify.sh

# Self-hosting (Stage 8j): compile kcc's symbol table in C, relink, run suite
selfhost-symtab: build
	chmod +x gen/selfhost/symtab_verify.sh
	gen/selfhost/symtab_verify.sh

# Self-hosting (Stage 8k): compile kcc's conversions in C, relink, run suite
selfhost-conversions: build
	chmod +x gen/selfhost/conversions_verify.sh
	gen/selfhost/conversions_verify.sh

# Self-hosting (Stage 8l): compile kcc's type system in C, relink, run suite
selfhost-types: build
	chmod +x gen/selfhost/types_verify.sh
	gen/selfhost/types_verify.sh

# Self-hosting (Stage 8m): compile kcc's optimizer in C, relink, run suite
selfhost-opt: build
	chmod +x gen/selfhost/opt_verify.sh
	gen/selfhost/opt_verify.sh

# Self-hosting (Stage 8n): compile kcc's lexer tables in C, relink, run suites
selfhost-lexer-tables: build
	chmod +x gen/selfhost/lexer_tables_verify.sh
	gen/selfhost/lexer_tables_verify.sh

# Self-hosting (Stage 8o): compile kcc's linker info in C, relink, run suite
selfhost-linker: build
	chmod +x gen/selfhost/linker_verify.sh
	gen/selfhost/linker_verify.sh

# Self-hosting (Stage 8p): compile kcc's statement parser in C, relink, run suite
selfhost-statements: build
	chmod +x gen/selfhost/statements_verify.sh
	gen/selfhost/statements_verify.sh

# Self-hosting (Stage 8q): compile kcc's Mach-O writer in C, relink, run suite
selfhost-emit-macho: build
	chmod +x gen/selfhost/emit_macho_verify.sh
	gen/selfhost/emit_macho_verify.sh

# Self-hosting (Stage 8r): compile kcc's expression parser in C, relink, run suite
selfhost-expressions: build
	chmod +x gen/selfhost/expressions_verify.sh
	gen/selfhost/expressions_verify.sh

# Self-hosting (Stage 8s): compile kcc's parser spine in C, relink, run suite
selfhost-parser: build
	chmod +x gen/selfhost/parser_verify.sh
	gen/selfhost/parser_verify.sh

# Self-hosting (Stage 8t): compile kcc's driver in C, relink, run codegen+e2e
selfhost-driver: build
	chmod +x gen/selfhost/driver_verify.sh
	gen/selfhost/driver_verify.sh

# Self-hosting (Stage 8u): compile kcc's declaration parser in C, relink, run codegen
selfhost-declarations: build
	chmod +x gen/selfhost/declarations_verify.sh
	gen/selfhost/declarations_verify.sh

# Self-hosting (Stage 8v): compile kcc's DWARF emitter in C, relink,
# run codegen + a -g byte-compare against the asm build
selfhost-dwarf: build
	chmod +x gen/selfhost/dwarf_verify.sh
	gen/selfhost/dwarf_verify.sh

# Self-hosting (Stage 8w): compile kcc's ARM64 encoder + .s renderer in C,
# relink, verify both halves (difftest + --emit-asm functional check)
selfhost-emit-arm64: build
	chmod +x gen/selfhost/emit_arm64_verify.sh
	gen/selfhost/emit_arm64_verify.sh

# Self-hosting (Stage 8x): compile kcc's semantic analyzer in C, relink,
# verify with difftest + diagtest + warntest + codegen
selfhost-sema: build
	chmod +x gen/selfhost/sema_verify.sh
	gen/selfhost/sema_verify.sh

# Self-hosting (Stage 8y): compile kcc's x86-64 back end in C, relink,
# verify functionally (arm64 codegen + x86 programs run under Rosetta)
selfhost-emit-x86: build
	chmod +x gen/selfhost/emit_x86_verify.sh
	gen/selfhost/emit_x86_verify.sh

# Self-hosting (Stage 8z): compile kcc's preprocessor in C, relink,
# verify with difftest + diagtest + codegen
selfhost-preprocessor: build
	chmod +x gen/selfhost/preprocessor_verify.sh
	gen/selfhost/preprocessor_verify.sh

# Self-hosting: compile kcc's ARM64 code generator in C, relink, verify
selfhost-codegen: build
	chmod +x gen/selfhost/codegen_verify.sh
	gen/selfhost/codegen_verify.sh

# Self-hosting: compile kcc's middle-end IR builder in C, relink, verify
selfhost-ir: build
	chmod +x gen/selfhost/ir_verify.sh
	gen/selfhost/ir_verify.sh

# Self-hosting: compile kcc's entry point in C, relink in place of main.o, verify
selfhost-main: build
	chmod +x gen/selfhost/main_verify.sh
	gen/selfhost/main_verify.sh

# Self-hosting: compile the compiler's lexer in C, relink in place of lexer.o, verify
selfhost-lexer-core: build
	chmod +x gen/selfhost/lexer_core_verify.sh
	gen/selfhost/lexer_core_verify.sh

# Milestone A: cross-compile a multi-TU C program to Linux/x86-64 with kcc,
# link against the Linux runtime (no libc), run it natively (Chapter: Runtime).
meta-a: build
	chmod +x gen/runtime/meta_a_verify.sh
	gen/runtime/meta_a_verify.sh

# Milestone C: cross-compile kcc's own source to Linux, link it, and prove the
# Linux-native compiler self-hosts (and re-hosts itself) in a single command.
meta-c: build
	chmod +x gen/runtime/meta_c_verify.sh
	gen/runtime/meta_c_verify.sh

# Differential tests: compile each program with kcc AND clang, compare
difftest: build
	chmod +x gen/tests/difftest.sh
	gen/tests/difftest.sh

# ABI interop: compile one TU with kcc and the other with clang, link, run
interop: build
	chmod +x gen/tests/interop.sh
	gen/tests/interop.sh

# End-to-end: kcc compiles AND links to an executable, then runs it
e2e: build
	chmod +x gen/tests/e2e.sh
	gen/tests/e2e.sh

# Diagnostics: invalid programs must be rejected with clear errors (no hang)
diagtest: build
	chmod +x gen/tests/diagtest.sh
	gen/tests/diagtest.sh

# Warnings: -Wall must warn while the default build stays silent
warntest: build
	chmod +x gen/tests/warntest.sh
	gen/tests/warntest.sh

# Code generation tests: compile with kcc, link, run, check exit codes
test-codegen: build
	chmod +x gen/tests/test_codegen.sh
	gen/tests/test_codegen.sh

# Weave: literate .weft sources -> LaTeX (kcc.tex). Mirrors `tangle`, which
# produces the code to compile; `weave` produces the document source.
weave:
	weft -w tex -o -d -r kcc.weft

# PDF: compile the woven LaTeX to kcc.pdf (lualatex for native Unicode).
# The covers are edited as assets/cover.svg and assets/back-cover.svg, which
# carry a {{VERSION}} placeholder; substitute the single-sourced version from
# gen/VERSION, rasterise to assets/cover.pdf + assets/back-cover.png (when
# rsvg-convert is available), then typeset.
pdf: weave
	test -f gen/VERSION || weft -p gen/ --mkdirs kcc.weft
	if command -v rsvg-convert >/dev/null 2>&1; then VER=$$(cat gen/VERSION); sed "s/{{VERSION}}/$$VER/g" assets/cover.svg > gen/cover.svg && rsvg-convert -f pdf -o assets/cover.pdf gen/cover.svg; sed "s/{{VERSION}}/$$VER/g" assets/back-cover.svg > gen/back-cover.svg && rsvg-convert -w 2480 -o assets/back-cover.png gen/back-cover.svg; fi
	latexmk -lualatex -interaction=nonstopmode -f kcc.tex

# Clean generated files
clean:
	rm -rf gen/

# Run the compiler:  make run ARGS="file.c -o out"
run: build
	./gen/kcc $(ARGS)

# Structure map (JSON)
map:
	weft -m kcc.weft
@}
