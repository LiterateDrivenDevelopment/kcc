                          unsigned long np, void *aa, void *raa, unsigned long ac, unsigned long *lo);
@}

\section{Initialization, the Main Loop, and Contexts}

\texttt{kcc\_pp\_next} returns one preprocessed token: it handles a false
conditional branch by skipping to the next directive, a \texttt{\#} at
beginning-of-line as a directive, and a macro name by pushing its expansion.
The context stack saves and restores lexer state across \texttt{\#include} and
macro expansion.

@l c
@d Selfhost: pp core @{
void kcc_pp_init(void) {
    kcc_pp_macros = kcc_ht_init(256);
    kcc_pp_ctx_depth = 0;
    pp_cond_depth = 0;
    pp_prev_line = 0;
    pp_has_pending = 0;
    pp_predefine();
}

static void pp_ctx_push(unsigned long type) {
    if (kcc_pp_ctx_depth >= PP_MAX_CTX_DEPTH) {
        kcc_diag_error(kcc_tok_line, 1, m_depth);
        kcc_sys_exit(1);
    }
    struct PPCtx *e = &pp_ctx_stack[kcc_pp_ctx_depth];
    e->type = type;
    e->cursor = kcc_lex_cursor;
    e->end = kcc_lex_end;
    e->line = kcc_lex_line;
    e->lstart = kcc_lex_line_start;
    e->src_base = kcc_src_base;
    e->src_size = kcc_src_size;
    e->src_path = kcc_src_path;
    e->prevline = pp_prev_line;
    e->macro = 0;
    kcc_pp_ctx_depth++;
}

static void pp_ctx_push_expand(struct PPMacro *m, const char *buf, unsigned long buflen) {
    pp_ctx_push(PP_CTX_EXPAND);
    pp_ctx_stack[kcc_pp_ctx_depth - 1].macro = m;
    kcc_lex_cursor = buf;
    kcc_lex_end = buf + buflen;
    kcc_lex_line_start = buf;
}

static void pp_ctx_pop(void) {
    if (kcc_pp_ctx_depth == 0) return;
    kcc_pp_ctx_depth--;
    struct PPCtx *e = &pp_ctx_stack[kcc_pp_ctx_depth];
    if (e->type == PP_CTX_INCLUDE) {
        kcc_src_base = e->src_base;
        kcc_src_size = e->src_size;
        kcc_src_path = e->src_path;
    } else if (e->macro) {
        e->macro->flags &= ~(unsigned long)PP_FLAG_EXPANDING;
    }
    kcc_lex_cursor = e->cursor;
    kcc_lex_end = e->end;
    kcc_lex_line = e->line;
    kcc_lex_line_start = e->lstart;
    pp_prev_line = e->prevline;
}

void kcc_pp_next(void) {
    for (;;) {
        if (pp_has_pending) pp_has_pending = 0;
        else kcc_lex_next();
        unsigned long tt = kcc_tok_type;
        unsigned long tl = kcc_tok_line;
        if (tt == TOK_EOF) {
            if (kcc_pp_ctx_depth) {
                pp_ctx_pop();
                if (pp_drain_floor && kcc_pp_ctx_depth < pp_drain_floor) return;
                continue;
            }
            if (pp_cond_depth) kcc_diag_error(kcc_tok_line, 1, m_unterm_cond);
            return;
        }
        /* conditional skip */
        if (pp_cond_depth && pp_cond_stack[pp_cond_depth - 1] != PP_COND_ACTIVE) {
            if (tt == TOK_HASH && tl > pp_prev_line) {
                pp_prev_line = tl;
                pp_skip_directive();
                continue;
            }
            pp_prev_line = tl;
            continue;
        }
        /* directive at BOL */
        if (tt == TOK_HASH && tl > pp_prev_line) {
            pp_prev_line = tl;
            pp_dispatch();
            continue;
        }
        /* macro expansion: IDENT or keyword-class [10,60) */
        if (tt == TOK_IDENT || (tt - 10) < 50) {
            if (kcc_pp_try_expand()) continue;
        }
        pp_prev_line = tl;
        return;
    }
}

void kcc_pp_dump_all(void) {
    for (;;) {
        kcc_pp_next();
        if (kcc_tok_type == TOK_EOF) return;
        kcc_lex_dump_token();
    }
}
@}

\section{Helpers: Skip-Line and Rest-of-Line}

\texttt{pp\_skip\_line} advances the cursor past the line's newline, skipping a
block comment that spans the newline so a skipped directive's logical line ends
where the comment does;
\texttt{pp\_rest\_of\_line} returns the directive's remaining text, trimmed,
scanning past block comments and string/character literals so a newline inside
one does not end the directive.

@l c
@d Selfhost: pp helpers @{
static void pp_skip_line(void) {
    const char *p = kcc_lex_cursor;
    const char *end = kcc_lex_end;
    while (p < end) {
        char c = *p;
        /* A block comment is whitespace that may span newlines (phase 3), so a
           directive's trailing `/ * ... * /` extends its logical line past those
           newlines.  Skip the whole comment, or a skipped `#define X 0x20 / *
           ...multi-line... * /` would leave the cursor mid-comment and the
           apostrophe in a word like "that's" would then be lexed as a char
           constant (kernel uapi/linux/openat2.h). */
        if (c == '/' && p + 1 < end && p[1] == '*') {
            p += 2;
            while (p < end && !(*p == '*' && p + 1 < end && p[1] == '/')) {
                if (*p == 0x0A) { kcc_lex_line++; kcc_lex_line_start = p + 1; }
                p++;
            }
            if (p < end) p += 2;                 /* consume the closing star-slash */
            continue;
        }
        p++;
        if (c == 0x0A) {
            kcc_lex_line++;
            kcc_lex_line_start = p;
            break;
        }
    }
    kcc_lex_cursor = p;
}

static const char *pp_rest_of_line(unsigned long *len_out) {
    const char *p = kcc_lex_cursor;
    const char *end = kcc_lex_end;
    while (p < end && (*p == ' ' || *p == 0x09)) p++;
    const char *start = p;
    /* Return a comment-stripped copy of the body (translation phase 3, which
       precedes macro definition): a macro body must not retain comments, or an
       apostrophe or quote inside one---as in the kernel's doc comment
       "a node's interval"---would later flip pp_substitute into char/string mode
       and copy the rest of the body verbatim, leaving every parameter and `##`
       past that point unexpanded.  Each comment becomes one space so adjacent
       tokens stay separated; string and character literals are copied intact. */
    unsigned long cap = (unsigned long)(end - start) + 2;
    char *out = (char *)kcc_arena_alloc(cap);
    unsigned long op = 0;
    int state = 0;                              /* 0 normal,1 block,2 str,3 char */
    const char *nl = 0;
    while (p < end) {
        char c = *p;
        if (state == 1) {                       /* block comment: skip, emit a space at its end */
            if (c == '*' && p + 1 < end && p[1] == '/') { state = 0; p += 2; out[op++] = ' '; continue; }
            if (c == 0x0A) kcc_lex_line++;
            p++;
            continue;
        }
        if (state == 2) {                       /* string literal: copy verbatim */
            if (c == 0x5C) { out[op++] = c; if (p + 1 < end) out[op++] = p[1]; p += 2; continue; }
            if (c == '"') { out[op++] = c; state = 0; p++; continue; }
            if (c == 0x0A) { nl = p; break; }
            out[op++] = c; p++;
            continue;
        }
        if (state == 3) {                       /* character constant: copy verbatim */
            if (c == 0x5C) { out[op++] = c; if (p + 1 < end) out[op++] = p[1]; p += 2; continue; }
            if (c == 0x27) { out[op++] = c; state = 0; p++; continue; }
            if (c == 0x0A) { nl = p; break; }
            out[op++] = c; p++;
            continue;
        }
        if (c == 0x0A) { nl = p; break; }
        if (c == '"') { out[op++] = c; state = 2; p++; continue; }
        if (c == 0x27) { out[op++] = c; state = 3; p++; continue; }
        if (c == '/' && p + 1 < end && p[1] == '*') { state = 1; p += 2; continue; }
        if (c == '/' && p + 1 < end && p[1] == '/') {   /* line comment: to logical end-of-line */
            p += 2;
            while (p < end && *p != 0x0A) p++;
            continue;
        }
        out[op++] = c; p++;
    }
    if (nl) kcc_lex_cursor = nl;
    else kcc_lex_cursor = end;
    /* trim trailing whitespace */
    while (op && (out[op - 1] == ' ' || out[op - 1] == 0x09)) op--;
    *len_out = op;
    return out;
}
@}

\section{Directive Dispatch}

@l c
@d Selfhost: pp dispatch @{
static int dname(const char *n, unsigned long l, const char *s, unsigned long sl) {
    return l == sl && kcc_memcmp(n, s, sl) == 0;
}

static void pp_dispatch(void) {
    pp_dir_line = kcc_tok_line;
    kcc_lex_next();
    unsigned long tt = kcc_tok_type;
    if (tt != TOK_IDENT && (tt < 10 || tt > 53)) { pp_skip_line(); return; }
    const char *n = kcc_tok_start;
    unsigned long l = kcc_tok_len;
    if (dname(n, l, "define", 6)) kcc_pp_do_define();
    else if (dname(n, l, "undef", 5)) kcc_pp_do_undef();
    else if (dname(n, l, "ifdef", 5)) kcc_pp_do_ifdef(0);
    else if (dname(n, l, "ifndef", 6)) kcc_pp_do_ifdef(1);
    else if (dname(n, l, "if", 2)) kcc_pp_do_if();
    else if (dname(n, l, "elif", 4)) pp_do_elif();
    else if (dname(n, l, "else", 4)) pp_do_else();
    else if (dname(n, l, "endif", 5)) pp_do_endif();
    else if (dname(n, l, "include", 7)) kcc_pp_do_include();
    else if (dname(n, l, "error", 5)) kcc_pp_do_error();
    else if (dname(n, l, "line", 4)) kcc_pp_do_line();
    else if (dname(n, l, "pragma", 6)) kcc_pp_do_pragma();
    else {
        kcc_diag_warning(pp_dir_line, 1, m_unknown_dir);
        pp_skip_line();
    }
}
@}

\section{\texttt{\#define}, \texttt{\#undef}, and Pragmas}

\texttt{kcc\_pp\_do\_define} reads the macro name and, if a \texttt{(} follows it
with no intervening space, the parameter list.  Each parameter is an identifier;
a bare \texttt{...} in final position makes the macro variadic, binding the
trailing arguments to \texttt{\_\_VA\_ARGS\_\_} (\stdref{6.10.3}).  \kcc{} also
accepts the GNU \emph{named} variadic form \texttt{name...}: an identifier
immediately followed by \texttt{...} names the rest parameter, so the macro body
refers to the trailing arguments as \texttt{name} rather than
\texttt{\_\_VA\_ARGS\_\_}.  This spelling is pervasive in the Linux kernel
headers (for example \texttt{ASM\_NO\_INPUT\_CLOBBER(clbr...)}).  In both cases
the binding name is written into the variadic slot \texttt{params[nparams]} here,
at definition time, and the fixed-parameter count \texttt{nparams} excludes it;
the expander later collapses the trailing arguments into that already-named slot.

@l c
@d Selfhost: pp define @{
void kcc_pp_do_define(void) {
    kcc_lex_next();
    unsigned long tt = kcc_tok_type;
    if (tt != TOK_IDENT && (tt - 10) >= 50) {
        kcc_diag_error(pp_dir_line, 1, m_def_name);
        pp_skip_line();
        return;
    }
    const char *name = kcc_tok_start;
    unsigned long namelen = kcc_tok_len;
    unsigned long flags = 0, nparams = 0;
    struct PPParam *params = 0;
    /* function-like iff '(' immediately follows the name (no space) */
    int funclike = (kcc_lex_cursor < kcc_lex_end && *kcc_lex_cursor == '(');
    if (funclike) {
        flags = PP_FLAG_FUNCLIKE;
        kcc_lex_next();                          /* '(' */
        kcc_lex_next();                          /* first param or ')' */
        params = (struct PPParam *)kcc_arena_alloc(PP_MAX_ARGS * sizeof(struct PPParam));
        if (kcc_tok_type != TOK_RPAREN) {
            for (;;) {
                if (kcc_tok_type == TOK_ELLIPSIS) {
                    flags |= PP_FLAG_VARIADIC;
                    params[nparams].name = "__VA_ARGS__";
                    params[nparams].len = 11;
                    kcc_lex_next();
                    if (kcc_tok_type != TOK_RPAREN) { kcc_diag_error(pp_dir_line, 1, m_def_param); pp_skip_line(); return; }
                    break;
                }
                /* A parameter name, like the macro name, may be a keyword-class
                   token [10,60): phase 4 has no keywords (6.4.1), and the
                   kernel's TRACE_EVENT names a parameter `struct`. */
                if (kcc_tok_type != TOK_IDENT && (kcc_tok_type - 10) >= 50) { kcc_diag_error(pp_dir_line, 1, m_def_param); pp_skip_line(); return; }
                params[nparams].name = kcc_tok_start;
                params[nparams].len = kcc_tok_len;
                kcc_lex_next();
                if (kcc_tok_type == TOK_ELLIPSIS) {
                    /* GNU named variadic parameter "name...": bind the trailing
                       arguments to `name` rather than to __VA_ARGS__.  Leave the
                       name in the variadic slot params[nparams] without counting
                       it among the fixed parameters. */
                    flags |= PP_FLAG_VARIADIC;
                    kcc_lex_next();
                    if (kcc_tok_type != TOK_RPAREN) { kcc_diag_error(pp_dir_line, 1, m_def_param); pp_skip_line(); return; }
                    break;
                }
                nparams++;
                if (kcc_tok_type == TOK_COMMA) { kcc_lex_next(); continue; }
                if (kcc_tok_type != TOK_RPAREN) { kcc_diag_error(pp_dir_line, 1, m_def_param); pp_skip_line(); return; }
                break;
            }
        }
    }
    unsigned long bodylen;
    const char *body = pp_rest_of_line(&bodylen);
    struct PPMacro *m = (struct PPMacro *)kcc_arena_alloc(sizeof(struct PPMacro));
    m->name = name; m->namelen = namelen; m->flags = flags; m->nparams = nparams;
    m->body = body; m->bodylen = bodylen; m->params = params;
    kcc_ht_put(kcc_pp_macros, name, namelen, m);
    pp_skip_line();
}

void kcc_pp_do_undef(void) {
    kcc_lex_next();
    if (kcc_tok_type == TOK_IDENT)
        kcc_ht_put(kcc_pp_macros, kcc_tok_start, kcc_tok_len, 0);
    pp_skip_line();
}

/* Parse ( "NAME" ) after push_macro/pop_macro; returns name/len (len 0 = fail). */
static const char *pp_pragma_name(unsigned long *lo) {
    kcc_lex_next();
    if (kcc_tok_type != TOK_LPAREN) { *lo = 0; return 0; }
    kcc_lex_next();
    if (kcc_tok_type != TOK_STRING_LIT) { *lo = 0; return 0; }
    *lo = kcc_tok_len - 2;
    return kcc_tok_start + 1;
}

void kcc_pp_do_pragma(void) {
    kcc_lex_next();
    if (kcc_tok_type == TOK_IDENT) {
        const char *v = kcc_tok_start;
        unsigned long vl = kcc_tok_len;
        if (vl == 10 && kcc_memcmp(v, "push_macro", 10) == 0) {
            unsigned long nl;
            const char *nm = pp_pragma_name(&nl);
            if (nl) {
                void *saved = kcc_ht_get(kcc_pp_macros, nm, nl);
                struct PPSave *node = (struct PPSave *)kcc_arena_alloc(sizeof(struct PPSave));
                node->name = nm; node->len = nl; node->saved = saved;
                node->next = pp_macro_stack;
                pp_macro_stack = node;
            }
        } else if (vl == 9 && kcc_memcmp(v, "pop_macro", 9) == 0) {
            unsigned long nl;
            const char *nm = pp_pragma_name(&nl);
            if (nl) {
                struct PPSave **link = &pp_macro_stack;
                while (*link) {
                    struct PPSave *node = *link;
                    if (node->len == nl && kcc_memcmp(nm, node->name, nl) == 0) {
                        kcc_ht_put(kcc_pp_macros, nm, nl, node->saved);
                        *link = node->next;
                        break;
                    }
                    link = &node->next;
                }
            }
        }
    }
    pp_skip_line();
}
@}

\section{Macro Expansion}

\texttt{kcc\_pp\_try\_expand} looks the identifier up, honours the anti-recursion
flag, substitutes \texttt{\_\_LINE\_\_} and \texttt{\_\_FILE\_\_} dynamically,
and for a function-like macro collects arguments (across context boundaries,
never past the argument prescan floor), prescan-expands them, substitutes, and
pushes the result.  \texttt{\_\_FILE\_\_} cannot be a static body because its
value is the current source path (\texttt{kcc\_src\_path}, which the include
machinery saves and restores per file); it is emitted as a freshly-quoted
string-literal token at each use.

Argument collection normally records each argument as a contiguous source span,
but the kernel drives a conditional \emph{through} a macro call---\verb|malloc(flush ? a() :|
\verb|#ifdef X ... #else sizeof(...) #endif )|---so a \verb|#| directive can
interrupt an argument.  A bare span would swallow the directive keywords and both
branches; instead, when a directive is seen at line start during collection it is
evaluated with the ordinary conditional machinery (\texttt{pp\_dispatch} when the
enclosing branch is live, \texttt{pp\_skip\_directive} otherwise), tokens inside a
dead branch are dropped, and---because the surviving tokens are no longer
contiguous---the argument is rebuilt token-by-token in an arena buffer via
\texttt{pp\_arg\_append}.  Arguments with no directive keep the fast span path.

\texttt{try\_expand} also intercepts the \texttt{\_Pragma("\dots")} operator here,
before the macro lookup: it is not a macro but a destringized \texttt{\#pragma},
which the kernel plants through \texttt{\_\_diag\_ignore\_all} to toggle GCC
diagnostics kcc does not act on.  Recognised by name, it consumes its
parenthesised argument---balancing the nested parens of the \texttt{\_\_diag\_str}
that constructs the string---and expands to nothing, locating its \texttt{(}
exactly as a function-like macro does.

@l c
@d Selfhost: pp expand @{
static const char *pp_line_digits(unsigned long *lo) {
    unsigned long line = kcc_lex_line + (unsigned long)kcc_line_delta;
    char *buf = (char *)kcc_arena_alloc(24);
    char *e = buf + 24;
    if (line == 0) { *--e = '0'; }
    else while (line) { *--e = '0' + (line % 10); line /= 10; }
    *lo = (unsigned long)((buf + 24) - e);
    return e;
}

static const char *pp_expand_arg(const char *text, unsigned long len, unsigned long *lo);

/* Append s[0..n) to an arena-backed, geometrically-grown buffer.  Used to
   rebuild a macro argument whose token run a conditional directive interrupts. */
static void pp_arg_append(char **buf, unsigned long *cap, unsigned long *len,
                          const char *s, unsigned long n) {
    if (*len + n > *cap) {
        unsigned long nc = *cap ? *cap : 256;
        while (nc < *len + n) nc = nc * 2;
        char *nb = (char *)kcc_arena_alloc(nc);
        kcc_memcpy(nb, *buf, *len);
        *buf = nb; *cap = nc;
    }
    kcc_memcpy(*buf + *len, s, n);
    *len = *len + n;
}

int kcc_pp_try_expand(void) {
    const char *name = kcc_tok_start;
    unsigned long namelen = kcc_tok_len;
    struct PPMacro *m = (struct PPMacro *)kcc_ht_get(kcc_pp_macros, name, namelen);
    /* The `_Pragma("...")' operator is a destringized #pragma, not a macro.  The
       kernel plants it through __diag_ignore_all (compiler-gcc.h) to toggle GCC
       diagnostics; kcc honours none of those, so consume the parenthesised
       string-literal argument (balancing nested parens, e.g. the __diag_str(...)
       that builds it) and expand to nothing.  The `(' is located exactly as a
       function-like macro's is, dropping only exhausted expansion contexts. */
    if (namelen == 7 && kcc_memcmp(name, "_Pragma", 7) == 0) {
        for (;;) {
            if (kcc_lex_cursor < kcc_lex_end) break;
            if (kcc_pp_ctx_depth == 0) break;
            if (kcc_pp_ctx_depth <= pp_drain_floor) break;
            pp_ctx_pop();
        }
        const char *p = kcc_lex_cursor;
        while (p < kcc_lex_end && (*p == ' ' || *p == 0x09 || *p == 0x0A || *p == 0x0D)) p++;
        if (p >= kcc_lex_end || *p != '(') return 0;   /* bare `_Pragma' → leave as ident */
        kcc_lex_next();                                 /* '(' */
        long pdepth = 1;
        for (;;) {
            kcc_lex_next();
            unsigned long tt = kcc_tok_type;
            if (tt == TOK_EOF) return 1;
            if (tt == TOK_LPAREN) pdepth++;
            else if (tt == TOK_RPAREN) { pdepth--; if (pdepth == 0) break; }
        }
        return 1;                                       /* expands to nothing */
    }
    if (!m) return 0;
    if (m->flags & PP_FLAG_EXPANDING) return 0;
    /* dynamic __LINE__ */
    if ((m->flags & PP_FLAG_BUILTIN) && namelen == 8 && kcc_memcmp(name, "__LINE__", 8) == 0) {
        unsigned long dl;
        const char *d = pp_line_digits(&dl);
        m->flags |= PP_FLAG_EXPANDING;
        pp_ctx_push_expand(m, d, dl);
        return 1;
    }
    /* dynamic __FILE__ → the current source path as a string literal.  The
     * include machinery saves/restores kcc_src_path, so this is the header's
     * own name inside a header (C17 6.10.8.1). */
    if ((m->flags & PP_FLAG_BUILTIN) && namelen == 8 && kcc_memcmp(name, "__FILE__", 8) == 0) {
        const char *p = kcc_src_path ? kcc_src_path : "<stdin>";
        unsigned long pl = kcc_strlen(p);
        char *buf = (char *)kcc_arena_alloc(pl + 3);
        buf[0] = '"';
        kcc_memcpy(buf + 1, p, pl);
        buf[pl + 1] = '"';
        m->flags |= PP_FLAG_EXPANDING;
        pp_ctx_push_expand(m, buf, pl + 2);
        return 1;
    }
    /* dynamic __COUNTER__ → a fresh incrementing integer at each use. */
    if ((m->flags & PP_FLAG_BUILTIN) && namelen == 11 && kcc_memcmp(name, "__COUNTER__", 11) == 0) {
        unsigned long v = kcc_pp_counter++;
        char *buf = (char *)kcc_arena_alloc(24);
        char *e = buf + 24;
        if (v == 0) { *--e = '0'; }
        else while (v) { *--e = '0' + (v % 10); v /= 10; }
        m->flags |= PP_FLAG_EXPANDING;
        pp_ctx_push_expand(m, e, (unsigned long)((buf + 24) - e));
        return 1;
    }
    if (!(m->flags & PP_FLAG_FUNCLIKE)) {
        /* object-like */
        unsigned long bl = m->bodylen;
        if (!bl) return 1;                       /* empty */
        char *buf = (char *)kcc_arena_alloc(bl);
        kcc_memcpy(buf, m->body, bl);
        m->flags |= PP_FLAG_EXPANDING;
        pp_ctx_push_expand(m, buf, bl);
        return 1;
    }
    /* function-like: drop exhausted contexts to find '(' in enclosing text,
     * but never cross the argument-prescan drain floor. */
    for (;;) {
        if (kcc_lex_cursor < kcc_lex_end) break;
        if (kcc_pp_ctx_depth == 0) break;
        if (kcc_pp_ctx_depth <= pp_drain_floor) break;
        pp_ctx_pop();
    }
    const char *p = kcc_lex_cursor;
    while (p < kcc_lex_end && (*p == ' ' || *p == 0x09 || *p == 0x0A || *p == 0x0D)) p++;
    if (p >= kcc_lex_end || *p != '(') return 0;
    kcc_lex_next();                              /* '(' */
    unsigned long nparams = m->nparams;
    struct PPParam *params = (struct PPParam *)m->params;
    struct PPArg *args = (struct PPArg *)kcc_arena_alloc(PP_MAX_ARGS * 16);
    unsigned long argc = 0;
    long depth = 1;
    args[0].start = kcc_lex_cursor;
    args[0].len = 0;
    /* Buffer state for an argument a conditional directive interrupts: `abuf' is
       non-null once this argument switched from span to rebuilt-buffer mode, and
       `aprev' is the source end of the last token folded into it. */
    char *abuf = 0; unsigned long acap = 0, alen = 0;
    const char *aprev = args[0].start;
    int any_buf = 0;                 /* any argument rebuilt in a buffer? */
    for (;;) {
        kcc_lex_next();
        unsigned long tt = kcc_tok_type;
        unsigned long tl = kcc_tok_line;
        if (tt == TOK_EOF) { kcc_diag_error(pp_dir_line, 1, m_unterm_args); return 0; }
        /* A directive at line start interrupts the argument (GNU extension): fold
           the live text collected so far into a buffer, evaluate the directive so
           the conditional stack tracks which branch is taken, and continue. */
        if (tt == TOK_HASH && tl > pp_prev_line) {
            if (!abuf) { acap = 256; abuf = (char *)kcc_arena_alloc(acap); alen = 0; any_buf = 1; }
            pp_arg_append(&abuf, &acap, &alen, aprev, (unsigned long)(kcc_tok_start - aprev));
            pp_prev_line = tl;
            if (pp_cond_depth && pp_cond_stack[pp_cond_depth - 1] != PP_COND_ACTIVE)
                pp_skip_directive();
            else
                pp_dispatch();
            aprev = kcc_lex_cursor;
            continue;
        }
        /* Tokens inside a dead conditional branch are dropped from the argument. */
        if (pp_cond_depth && pp_cond_stack[pp_cond_depth - 1] != PP_COND_ACTIVE) {
            pp_prev_line = tl;
            aprev = kcc_lex_cursor;
            continue;
        }
        pp_prev_line = tl;
        if (tt == TOK_LPAREN) { depth++; continue; }
        if (tt == TOK_RPAREN) {
            depth--;
            if (depth == 0) {
                if (abuf) {
                    pp_arg_append(&abuf, &acap, &alen, aprev, (unsigned long)(kcc_tok_start - aprev));
                    args[argc].start = abuf; args[argc].len = alen;
                } else {
                    args[argc].len = (unsigned long)(kcc_tok_start - args[argc].start);
                }
                argc++;
                break;
            }
            continue;
        }
        if (tt == TOK_COMMA && depth == 1) {
            if (abuf) {
                pp_arg_append(&abuf, &acap, &alen, aprev, (unsigned long)(kcc_tok_start - aprev));
                args[argc].start = abuf; args[argc].len = alen;
            } else {
                args[argc].len = (unsigned long)(kcc_tok_start - args[argc].start);
            }
            argc++;
            args[argc].start = kcc_lex_cursor;
            args[argc].len = 0;
            abuf = 0; acap = 0; alen = 0;
            aprev = kcc_lex_cursor;
        }
    }
    /* variadic: collapse trailing args into the variadic slot params[nparams],
       whose name (__VA_ARGS__, or the GNU named-rest identifier) was bound when
       the macro was defined. */
    if (m->flags & PP_FLAG_VARIADIC) {
        if (argc > nparams) {
            if (any_buf) {
                /* Some trailing argument was rebuilt in its own buffer, so the
                   arguments are no longer one contiguous source run and the
                   pointer span below would be meaningless; join them---with the
                   separating commas---into a fresh buffer instead. */
                char *vb = 0; unsigned long vc = 0, vl = 0;
                for (unsigned long i = nparams; i < argc; i++) {
                    if (i > nparams) pp_arg_append(&vb, &vc, &vl, ",", 1);
                    pp_arg_append(&vb, &vc, &vl, args[i].start, args[i].len);
                }
                args[nparams].start = vb; args[nparams].len = vl;
            } else {
                const char *first = args[nparams].start;
                const char *last_end = args[argc - 1].start + args[argc - 1].len;
                args[nparams].len = (unsigned long)(last_end - first);
            }
        } else {
            args[nparams].start = args[0].start;
            args[nparams].len = 0;
        }
        nparams++;
        argc = nparams;
    }
    /* Preserve each argument's raw (pre-prescan) span: a parameter that is an
       operand of `#' (stringise, 6.10.3.2) or `##' (paste, 6.10.3.1) uses its
       argument UNexpanded, whereas an ordinary parameter uses the prescan
       expansion.  The kernel's ftrace_eval_map generator relies on this ---
       `__##TRACE_SYSTEM##_##a' must paste the enum's spelling, not its value. */
    struct PPArg *rawargs = (struct PPArg *)kcc_arena_alloc(PP_MAX_ARGS * 16);
    for (unsigned long i = 0; i < argc; i++) rawargs[i] = args[i];
    /* argument prescan (6.10.3.1) */
    for (unsigned long i = 0; i < argc; i++) {
        unsigned long el;
        const char *eb = pp_expand_arg(args[i].start, args[i].len, &el);
        args[i].start = eb;
        args[i].len = el;
    }
    /* substitute */
    unsigned long rl;
    const char *rbuf = pp_substitute(m->body, m->bodylen, params, nparams, args, rawargs, argc, &rl);
    if (!rl) return 1;
    m->flags |= PP_FLAG_EXPANDING;
    pp_ctx_push_expand(m, rbuf, rl);
    return 1;
}
@}

\section{Argument Prescan and Substitution}

\texttt{pp\_expand\_arg} drives \texttt{kcc\_pp\_next} over an argument's text
behind a \emph{drain floor}, so expansion stops at the argument boundary rather
than reading into the enclosing text.  \texttt{pp\_substitute} walks the body,
replacing parameter names with argument text and honouring the \texttt{\#}
(stringise) and \texttt{\#\#} (paste) operators.  The choice of \emph{which}
argument text is the crux of \stdref{6.10.3.1}: an ordinary parameter takes the
prescan expansion, but a parameter that is an operand of \texttt{\#} or
\texttt{\#\#} takes its \emph{raw}, unexpanded argument.  Both spans are kept
(the prescan overwrites the argument array, so the raw spans are copied aside
first); \texttt{prev\_paste} flags that the previous body token was \texttt{\#\#}
so the following parameter is its right operand, and a one-token look-ahead
catches a parameter that is a \emph{left} \texttt{\#\#} operand.  Without this the
kernel's ftrace eval-map generator misfires: \texttt{\_\_\#\#TRACE\_SYSTEM\#\#\_\#\#a}
would paste an enum's \emph{value} (\texttt{(1 << \dots)}) instead of its spelling,
because the argument would have been expanded before the paste.  It also
implements the GNU comma-elision special case \texttt{,\,\#\#\,\_\_VA\_ARGS\_\_}:
when the right operand of \texttt{\#\#} is a parameter whose argument is empty,
the paste deletes both the operand and a preceding comma---the mechanism behind
the kernel's \texttt{static\_assert(expr,\,...)} wrapper, and thus a hard
prerequisite for the \texttt{<linux/bitops.h>} sanity assertions.

@l c
@d Selfhost: pp substitute @{
static int is_id(int c) {
    return c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}
static int is_idn(int c) { return is_id(c) || (c >= '0' && c <= '9'); }

/* Would a token ending in `a' and one starting with `b', written adjacent, lex
   as a single longer pp-token?  Exactly the two-character C punctuators (plus a
   `.'`.' that could open `...'): `--', `<<', `->', `+=' and friends must not
   fuse across a macro-expansion boundary.  Crucially `/'`/' is NOT here---after
   phase 3 it is two `/' tokens, never a comment---so a computed include path
   like `asm/trace//x86_fpu.h' keeps its `//' rather than gaining a stray space. */
static int pp_pastes(char a, char b) {
    switch (a) {
    case '+': return b == '+' || b == '=';
    case '-': return b == '-' || b == '>' || b == '=';
    case '<': return b == '<' || b == '=' || b == ':' || b == '%';
    case '>': return b == '>' || b == '=';
    case '=': return b == '=';
    case '!': return b == '=';
    case '&': return b == '&' || b == '=';
    case '|': return b == '|' || b == '=';
    case '*': case '/': case '%': case '^': return b == '=';
    case '#': return b == '#';
    case ':': return b == '>';
    case '.': return b == '.';
    default:  return 0;
    }
}

static const char *pp_expand_arg(const char *text, unsigned long len, unsigned long *lo) {
    if (!len) { *lo = 0; return text; }
    unsigned long base_depth = kcc_pp_ctx_depth;
    unsigned long saved_floor = pp_drain_floor;
    pp_drain_floor = base_depth + 1;
    unsigned long saved_pending = pp_has_pending;
    pp_has_pending = 0;
    unsigned long cap = len * 4 + 256;
    char *out = (char *)kcc_arena_alloc(cap);
    unsigned long outlen = 0;
    const char *prev_end = 0;
    pp_ctx_push_expand(0, text, len);
    for (;;) {
        kcc_pp_next();
        if (kcc_pp_ctx_depth <= base_depth) break;
        if (kcc_tok_type == TOK_EOF) break;
        const char *ts = kcc_tok_start;
        unsigned long tl = kcc_tok_len;
        if (outlen + tl + 1 > cap) {
            unsigned long ncap = (outlen + tl + 1) * 2;
            char *nb = (char *)kcc_arena_alloc(ncap);
            kcc_memcpy(nb, out, outlen);
            out = nb; cap = ncap;
        }
        /* Separate tokens with a single space only where the source had
           whitespace (the byte before the token is whitespace, so `#'-stringify
           reproduces `a > b' and `.section' stays joined), or---across a bare
           macro-expansion boundary, where that byte lives in another buffer---
           only where the two tokens would otherwise fuse into one: two word
           tokens (`FOO'`bar') or a real two-character punctuator (`-'`-'->`--',
           `<'`<'->`<<') per pp_pastes.  A non-pasting punctuation boundary stays
           joined: `TRACE_INCLUDE_PATH' (->`asm/trace/') abutting `/system.h'
           keeps `asm/trace//x86_fpu.h', a valid computed #include path, not
           `asm/trace/ /x86_fpu.h' which no header search resolves. */
        if (outlen && ts != prev_end) {
            char before = ts[-1];
            char a = out[outlen - 1], b = ts[0];
            int fuse = (is_idn((unsigned char)a) && is_idn((unsigned char)b)) ||
                       pp_pastes(a, b);
            if (before == ' ' || before == 0x09 || before == 0x0A ||
                before == 0x0D || fuse)
                out[outlen++] = ' ';
        }
        kcc_memcpy(out + outlen, ts, tl);
        outlen += tl;
        prev_end = ts + tl;
    }
    pp_drain_floor = saved_floor;
    pp_has_pending = saved_pending;
    *lo = outlen;
    return out;
}

/* Emit a "..." literal of src with whitespace collapsed and " / \ escaped. */
static unsigned long pp_emit_string(const char *src, unsigned long len, char *dst) {
    char *d = dst;
    *d++ = '"';
    unsigned long i = 0;
    /* Each whitespace SEQUENCE (spaces, tabs, and the newlines of a multi-line
       argument such as a BUILD_BUG_ON condition) collapses to one space, and
       leading/trailing whitespace is dropped (\stdref{6.10.3.2}); an embedded
       newline copied verbatim would close the string prematurely. */
    while (i < len && (src[i] == ' ' || src[i] == 0x09 || src[i] == 0x0A || src[i] == 0x0D)) i++;
    int pending = 0;
    for (; i < len; i++) {
        char c = src[i];
        if (c == ' ' || c == 0x09 || c == 0x0A || c == 0x0D) { pending = 1; continue; }
        if (pending) { *d++ = ' '; pending = 0; }
        if (c == '"' || c == 0x5C) *d++ = 0x5C;
        *d++ = c;
    }
    *d++ = '"';
    return (unsigned long)(d - dst);
}

const char *pp_substitute(const char *body, unsigned long blen, struct PPParam *params,
                          unsigned long np, void *aa, void *raa, unsigned long ac, unsigned long *lo) {
    struct PPArg *args = (struct PPArg *)aa;
    struct PPArg *rawargs = (struct PPArg *)raa;
    (void)ac;
    /* Set once a `##' operator was just emitted, so the next parameter is its
       right operand and must substitute its RAW argument (6.10.3.1). */
    int after_paste = 0;
    /* The output buffer must grow: a macro like the kernel's `pr_alert(fmt,
       data_race(x), data_race(y), ...)` substitutes several arguments that are
       themselves large _Generic expansions, easily exceeding any fixed size (a
       former 4 KB buffer truncated mid-string -> "unterminated string literal").
       `guard` bounds the most any single iteration can emit---a string literal
       spanning the rest of the body, or a stringised/pasted argument (up to
       twice its length)---so one check per iteration keeps `out` big enough. */
    unsigned long maxarg = 0;
    for (unsigned long k = 0; k < np; k++)
        if (args[k].len > maxarg) maxarg = args[k].len;
    unsigned long guard = blen + 2 * maxarg + 16;
    unsigned long cap = guard + 256;
    char *out = (char *)kcc_arena_alloc(cap);
    unsigned long op = 0;
    unsigned long i = 0;
    while (i < blen) {
        int prev_paste = after_paste; after_paste = 0;
        if (op + guard > cap) {
            unsigned long nc = cap * 2;
            while (nc < op + guard) nc *= 2;
            char *nb = (char *)kcc_arena_alloc(nc);
            kcc_memcpy(nb, out, op);
            out = nb; cap = nc;
        }
        char c = body[i];
        if (c == '"' || c == '\'') {
            /* A string literal or character constant is a single token: its
               contents are never subject to parameter replacement (\stdref{6.10.3.1}).
               Copy it through verbatim, honouring backslash escapes, so that a
               parameter name that happens to appear inside quotes---e.g. `x` in
               `"value x here"`, or `%[ptr]` in an inline-asm template---survives. */
            char q = c;
            out[op++] = body[i++];
            while (i < blen) {
                char d = body[i];
                out[op++] = d; i++;
                if (d == '\\' && i < blen) { out[op++] = body[i++]; continue; }
                if (d == q) break;
            }
            continue;
        }
        if (c == '#') {
            if (i + 1 < blen && body[i + 1] == '#') {
                /* GNU comma elision `, ## __VA_ARGS__`: when the right operand of
                   ## is a parameter whose argument is empty, the ## deletes it and
                   a preceding comma (used pervasively via the kernel's
                   `static_assert(expr, ...)` macro). */
                unsigned long pj = i + 2;
                while (pj < blen && (body[pj] == ' ' || body[pj] == 0x09)) pj++;
                unsigned long ps = pj;
                while (pj < blen && is_idn((unsigned char)body[pj])) pj++;
                unsigned long plen = pj - ps;
                long ppi = -1;
                for (unsigned long k = 0; k < np; k++)
                    if (params[k].len == plen && kcc_memcmp(body + ps, params[k].name, plen) == 0) { ppi = (long)k; break; }
                if (ppi >= 0 && rawargs[ppi].len == 0) {
                    while (op && (out[op - 1] == ' ' || out[op - 1] == 0x09)) op--;
                    if (op && out[op - 1] == ',') op--;     /* drop the dangling comma */
                    i = pj;                                  /* consume ## and the empty operand */
                    continue;
                }
                /* ## paste: trim emitted whitespace, skip operator + whitespace.
                   Mark that a paste just happened so the next parameter, its
                   right operand, substitutes its raw (unexpanded) argument. */
                while (op && (out[op - 1] == ' ' || out[op - 1] == 0x09)) op--;
                i += 2;
                while (i < blen && (body[i] == ' ' || body[i] == 0x09)) i++;
                after_paste = 1;
                continue;
            }
            /* # stringise */
            unsigned long j = i + 1;
            while (j < blen && (body[j] == ' ' || body[j] == 0x09)) j++;
            unsigned long s = j;
            while (j < blen && is_idn((unsigned char)body[j])) j++;
            unsigned long idlen = j - s;
            long pi = -1;
            for (unsigned long k = 0; k < np; k++)
                if (params[k].len == idlen && kcc_memcmp(body + s, params[k].name, idlen) == 0) { pi = (long)k; break; }
            if (pi >= 0) {
                /* # stringises the RAW argument, before prescan (6.10.3.2). */
                op += pp_emit_string(rawargs[pi].start, rawargs[pi].len, out + op);
                i = j;
            } else {
                out[op++] = '#';
                for (unsigned long k = s; k < j; k++) out[op++] = body[k];
                i = j;
            }
            continue;
        }
        if (is_id((unsigned char)c)) {
            unsigned long s = i;
            i++;
            while (i < blen && is_idn((unsigned char)body[i])) i++;
            unsigned long idlen = i - s;
            long pi = -1;
            for (unsigned long k = 0; k < np; k++)
                if (params[k].len == idlen && kcc_memcmp(body + s, params[k].name, idlen) == 0) { pi = (long)k; break; }
            if (pi >= 0) {
                /* A parameter that is an operand of `##' --- preceded by a paste
                   (prev_paste) or immediately followed by one --- substitutes its
                   raw argument; otherwise the prescan-expanded one (6.10.3.1). */
                int use_raw = prev_paste;
                if (!use_raw) {
                    unsigned long pk = i;
                    while (pk < blen && (body[pk] == ' ' || body[pk] == 0x09)) pk++;
                    if (pk + 1 < blen && body[pk] == '#' && body[pk + 1] == '#') use_raw = 1;
                }
                const char *as = args[pi].start;
                unsigned long al = args[pi].len;
                if (use_raw) {
                    /* The raw span keeps the call's surrounding whitespace (`, 3'
                       -> " 3"); a paste juxtaposes tokens, so trim it --- the
                       prescan-expanded span is already trimmed. */
                    as = rawargs[pi].start; al = rawargs[pi].len;
                    while (al && (*as == ' ' || *as == 0x09 || *as == 0x0A || *as == 0x0D)) { as++; al--; }
                    while (al && (as[al - 1] == ' ' || as[al - 1] == 0x09 ||
                                  as[al - 1] == 0x0A || as[al - 1] == 0x0D)) al--;
                }
                kcc_memcpy(out + op, as, al);
                op += al;
            } else {
                kcc_memcpy(out + op, body + s, idlen);
                op += idlen;
            }
            continue;
        }
        out[op++] = c;
        i++;
    }
    *lo = op;
    return out;
}
@}

\section{Predefined Macros and Command-Line Defines}

\texttt{pp\_predefine} seeds the macro table, for every translation unit, with
the object-like built-ins a hosted C compiler is expected to define---the
\texttt{\_\_STDC\_\_} family, \texttt{\_\_LP64\_\_}, and the dynamically
substituted \texttt{\_\_LINE\_\_}.  It also advertises
\texttt{\_\_SIZEOF\_INT128\_\_} as~16, the way gcc and clang do on 64-bit
targets, because kcc now supports the \texttt{\_\_int128} type---the Linux kernel
gates its \texttt{u128}/\texttt{\_\_u128} typedefs on that macro, so without it
\texttt{<asm/cmpxchg\_64.h>} would not even see the type.  It publishes the
\texttt{\_\_BYTE\_ORDER\_\_}/\texttt{\_\_ORDER\_*\_ENDIAN\_\_} family (both
targets little-endian) so endian-detecting code compiles instead of tripping its
\verb|#error| fallback---all three order names defined together, since an
undefined \texttt{\_\_BYTE\_ORDER\_\_} is \texttt{0} in a \verb|#if| and would
match a likewise-undefined \texttt{\_\_ORDER\_*}.  Under
\texttt{-{}-target=x86\_64-linux} it adds
\texttt{\_\_linux\_\_} and \texttt{\_\_x86\_64\_\_} so headers pick their glibc
bindings, and---so that gcc-oriented build systems (Kbuild's
\texttt{scripts/cc-version.sh}) recognise kcc as a supported compiler, exactly as
clang and icc do---the GCC identity macros \texttt{\_\_GNUC\_\_} /
\texttt{\_\_GNUC\_MINOR\_\_} / \texttt{\_\_GNUC\_PATCHLEVEL\_\_}.  Finally it
replays any \texttt{-D} command-line macros on top.

@l c
@d Selfhost: pp predefined @{
static void pp_def_simple(const char *name, unsigned long nl, const char *body, unsigned long bl) {
    struct PPMacro *m = (struct PPMacro *)kcc_arena_alloc(sizeof(struct PPMacro));
    m->name = name; m->namelen = nl; m->flags = PP_FLAG_BUILTIN; m->nparams = 0;
    m->body = body; m->bodylen = bl; m->params = 0;
    kcc_ht_put(kcc_pp_macros, name, nl, m);
}

static void pp_predefine(void) {
    pp_def_simple("__STDC__", 8, "1", 1);
    pp_def_simple("__STDC_VERSION__", 16, "201710L", 7);
    pp_def_simple("__STDC_HOSTED__", 15, "1", 1);
    pp_def_simple("__STDC_NO_ATOMICS__", 19, "1", 1);
    pp_def_simple("__STDC_NO_THREADS__", 19, "1", 1);
    pp_def_simple("__STDC_NO_COMPLEX__", 19, "1", 1);
    pp_def_simple("__STDC_NO_VLA__", 15, "1", 1);
    pp_def_simple("__LP64__", 8, "1", 1);
    pp_def_simple("_LP64", 5, "1", 1);
    pp_def_simple("__LINE__", 8, "1", 1);
    pp_def_simple("__FILE__", 8, "1", 1);   /* substituted dynamically in kcc_pp_try_expand */
    pp_def_simple("__COUNTER__", 11, "1", 1);
    /* kcc supports the GNU 128-bit integer type (16 bytes), so advertise it the
       way gcc and clang do on 64-bit targets.  The Linux kernel gates its
       u128/__u128 typedefs on this macro (include/uapi/linux/types.h). */
    pp_def_simple("__SIZEOF_INT128__", 17, "16", 2);
    /* Byte-order macros, exactly as gcc/clang publish them.  Real code (here
       doomgeneric's i_swap.h) selects its swap routines with
       `#if __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__' and `#error's if none of
       the three names resolve; an undefined `__BYTE_ORDER__' is 0 in a `#if',
       which would compare equal to a likewise-undefined `__ORDER_*' and pick the
       wrong branch, so all four must be defined.  Both kcc targets---Apple
       ARM64 and Linux x86-64---are little-endian. */
    pp_def_simple("__ORDER_LITTLE_ENDIAN__", 23, "1234", 4);
    pp_def_simple("__ORDER_BIG_ENDIAN__", 20, "4321", 4);
    pp_def_simple("__ORDER_PDP_ENDIAN__", 20, "3412", 4);
    pp_def_simple("__BYTE_ORDER__", 14, "1234", 4);
    pp_def_simple("__LITTLE_ENDIAN__", 17, "1", 1);
    if (kcc_x86_os) {                     /* Linux/x86-64 target: let headers pick glibc bindings */
        pp_def_simple("__linux__", 9, "1", 1);
        pp_def_simple("__x86_64__", 10, "1", 1);
        /* Claim GCC compatibility so gcc-oriented build systems (Kbuild's
           scripts/cc-version.sh) recognise kcc, exactly as clang and icc do. */
        pp_def_simple("__GNUC__", 8, "11", 2);
        pp_def_simple("__GNUC_MINOR__", 14, "2", 1);
        pp_def_simple("__GNUC_PATCHLEVEL__", 19, "0", 1);
    }
    kcc_pp_apply_cmdline_defines();
}

void kcc_pp_add_cmdline_define(const char *payload) {
    if (pp_cmdline_ndefs < 64) pp_cmdline_defs[pp_cmdline_ndefs++] = payload;
}

void kcc_pp_apply_cmdline_defines(void) {
    for (unsigned long i = 0; i < pp_cmdline_ndefs; i++) {
        const char *p = pp_cmdline_defs[i];
        unsigned long nl = 0;
        while (p[nl] && p[nl] != '=') nl++;
        if (p[nl] == '=') {
            const char *val = p + nl + 1;
            pp_def_simple(p, nl, val, kcc_strlen(val));
        } else {
            pp_def_simple(p, nl, "1", 1);
        }
    }
}
@}

\section{Conditionals and the \texttt{\#if} Evaluator}

@l c
@d Selfhost: pp conditional @{
static void pp_cond_push(unsigned long state) {
    if (pp_cond_depth >= PP_MAX_COND) return;
    pp_cond_stack[pp_cond_depth++] = (unsigned char)state;
}

void kcc_pp_do_ifdef(int negate) {
    kcc_lex_next();
    /* Accept a keyword-class token as the name too (phase 4 has no keywords):
       `#ifndef __inline__` in SDL's begin_code.h names a would-be macro whose
       spelling the lexer tagged as a keyword; the lookup keys on the text. */
    unsigned long tt = kcc_tok_type;
    if (tt != TOK_IDENT && (tt - 10) >= 50) {
        kcc_diag_error(pp_dir_line, 1, m_ifdef_name);
        pp_cond_push(PP_COND_SKIP);
        pp_skip_line();
        return;
    }
    void *m = kcc_ht_get(kcc_pp_macros, kcc_tok_start, kcc_tok_len);
    int cond = (m != 0);
    if (negate) cond = !cond;
    pp_cond_push(cond ? PP_COND_ACTIVE : PP_COND_SKIP);
    pp_skip_line();
}

/* Rewrite `defined X`/`defined(X)` → 1/0 (operand looked up, not expanded),
 * copying every other token verbatim. */
static const char *pp_protect_defined(const char *src, unsigned long len, unsigned long *lo) {
    const char *saved_cur = kcc_lex_cursor, *saved_end = kcc_lex_end;
    kcc_lex_cursor = src;
    kcc_lex_end = src + len;
    char *out = (char *)kcc_arena_alloc(2 * len + 64);
    unsigned long outlen = 0;
    kcc_lex_next();
    for (;;) {
        if (kcc_tok_type == TOK_EOF) break;
        if (kcc_tok_type == TOK_IDENT && kcc_tok_len == 7 &&
            kcc_memcmp(kcc_tok_start, "defined", 7) == 0) {
            kcc_lex_next();
            int paren = (kcc_tok_type == TOK_LPAREN);
            if (paren) kcc_lex_next();
            int bit = (kcc_ht_get(kcc_pp_macros, kcc_tok_start, kcc_tok_len) != 0);
            kcc_lex_next();                       /* past name */
            if (paren) kcc_lex_next();            /* past ')' */
            if (outlen) out[outlen++] = ' ';
            out[outlen++] = '0' + bit;
            continue;
        }
        if (outlen) out[outlen++] = ' ';
        kcc_memcpy(out + outlen, kcc_tok_start, kcc_tok_len);
        outlen += kcc_tok_len;
        kcc_lex_next();
    }
    kcc_lex_cursor = saved_cur;
    kcc_lex_end = saved_end;
    *lo = outlen;
    return out;
}

static const char *pp_prepare_cond(const char *src, unsigned long len, unsigned long *lo) {
    unsigned long la;
    const char *a = pp_protect_defined(src, len, &la);
    if (!la) { *lo = la; return a; }
    unsigned long saved = pp_cond_depth;
    pp_cond_depth = 0;
    unsigned long lb;
    const char *b = pp_expand_arg(a, la, &lb);
    pp_cond_depth = saved;
    *lo = lb;
    return b;
}

/* Evaluate the expanded controlling text; returns the integer result. */
static long pp_eval_line(const char *src, unsigned long len) {
    unsigned long el;
    const char *e = pp_prepare_cond(src, len, &el);
    const char *saved_cur = kcc_lex_cursor, *saved_end = kcc_lex_end;
    kcc_lex_cursor = e;
    kcc_lex_end = e + el;
    kcc_lex_next();
    long r = kcc_pp_eval_expr();
    kcc_lex_cursor = saved_cur;
    kcc_lex_end = saved_end;
    return r;
}

void kcc_pp_do_if(void) {
    unsigned long len;
    const char *src = pp_rest_of_line(&len);
    long r = pp_eval_line(src, len);
    pp_cond_push(r ? PP_COND_ACTIVE : PP_COND_SKIP);
}

void kcc_pp_do_line(void) {
    unsigned long phys = kcc_lex_line;
    unsigned long len;
    const char *src = pp_rest_of_line(&len);
    long n = pp_eval_line(src, len);
    kcc_line_delta = n - (long)phys - 1;
}

static void pp_do_elif(void) {
    if (pp_cond_depth == 0) {
        kcc_diag_error(pp_dir_line, 1, m_stray_elif);
        pp_skip_line();
        return;
    }
    unsigned char st = pp_cond_stack[pp_cond_depth - 1];
    if (st == PP_COND_ACTIVE) {
        pp_cond_stack[pp_cond_depth - 1] = PP_COND_DONE;
        pp_skip_line();
        return;
    }
    if (st == PP_COND_DONE) { pp_skip_line(); return; }
    unsigned long len;
    const char *src = pp_rest_of_line(&len);
    long r = pp_eval_line(src, len);
    pp_cond_stack[pp_cond_depth - 1] = r ? PP_COND_ACTIVE : PP_COND_SKIP;
}

static void pp_do_else(void) {
    if (pp_cond_depth == 0) {
        kcc_diag_error(pp_dir_line, 1, m_stray_else);
        pp_skip_line();
        return;
    }
    unsigned char st = pp_cond_stack[pp_cond_depth - 1];
    if (st == PP_COND_ACTIVE) pp_cond_stack[pp_cond_depth - 1] = PP_COND_DONE;
    else if (st == PP_COND_SKIP) pp_cond_stack[pp_cond_depth - 1] = PP_COND_ACTIVE;
    pp_skip_line();
}

static void pp_do_endif(void) {
    if (pp_cond_depth == 0) {
        kcc_diag_error(pp_dir_line, 1, m_stray_endif);
        pp_skip_line();
        return;
    }
    pp_cond_depth--;
    pp_skip_line();
}

static void pp_skip_directive(void) {
    pp_dir_line = kcc_tok_line;
    kcc_lex_next();
    unsigned long tt = kcc_tok_type;
    if (tt != TOK_IDENT && (tt < 10 || tt > 53)) { pp_skip_line(); return; }
    const char *n = kcc_tok_start;
    unsigned long l = kcc_tok_len;
    if (dname(n, l, "if", 2) || dname(n, l, "ifdef", 5) || dname(n, l, "ifndef", 6)) {
        pp_cond_push(PP_COND_DONE);
        pp_skip_line();
    } else if (dname(n, l, "endif", 5)) {
        pp_do_endif();
    } else if (dname(n, l, "elif", 4)) {
        pp_do_elif();
    } else if (dname(n, l, "else", 4)) {
        pp_do_else();
    } else {
        pp_skip_line();
    }
}
@}

@l c
@d Selfhost: pp eval @{
static long pp_eval_ternary(void);
static long pp_eval_primary(void);

long kcc_pp_eval_expr(void) { return pp_eval_ternary(); }

#define BINLEVEL(name, sub, body) \
static long name(void) { long a = sub(); for (;;) { unsigned long op = kcc_tok_type; body } }

static long pp_eval_unary(void);
static long pp_eval_mul(void) {
    long a = pp_eval_unary();
    for (;;) {
        unsigned long op = kcc_tok_type;
        if (op != TOK_STAR && op != TOK_SLASH && op != TOK_PERCENT) return a;
        kcc_lex_next();
        long b = pp_eval_unary();
        if (op == TOK_STAR) a = a * b;
        else if (op == TOK_SLASH) a = b ? a / b : 0;
        else a = b ? a % b : 0;
    }
}
static long pp_eval_add(void) {
    long a = pp_eval_mul();
    for (;;) {
        unsigned long op = kcc_tok_type;
        if (op != TOK_PLUS && op != TOK_MINUS) return a;
        kcc_lex_next();
        long b = pp_eval_mul();
        a = (op == TOK_PLUS) ? a + b : a - b;
    }
}
static long pp_eval_shift(void) {
    long a = pp_eval_add();
    for (;;) {
        unsigned long op = kcc_tok_type;
        if (op != TOK_SHL && op != TOK_SHR) return a;
        kcc_lex_next();
        long b = pp_eval_add();
        a = (op == TOK_SHL) ? (long)((unsigned long)a << b) : (long)((unsigned long)a >> b);
    }
}
static long pp_eval_rel(void) {
    long a = pp_eval_shift();
    for (;;) {
        unsigned long op = kcc_tok_type;
        if (op != TOK_LT && op != TOK_GT && op != TOK_LE && op != TOK_GE) return a;
        kcc_lex_next();
        long b = pp_eval_shift();
        if (op == TOK_LT) a = a < b;
        else if (op == TOK_GT) a = a > b;
        else if (op == TOK_LE) a = a <= b;
        else a = a >= b;
    }
}
static long pp_eval_eq(void) {
    long a = pp_eval_rel();
    for (;;) {
        unsigned long op = kcc_tok_type;
        if (op != TOK_EQ && op != TOK_NE) return a;
        kcc_lex_next();
        long b = pp_eval_rel();
        a = (op == TOK_EQ) ? (a == b) : (a != b);
    }
}
static long pp_eval_band(void) {
    long a = pp_eval_eq();
    while (kcc_tok_type == TOK_AMP) { kcc_lex_next(); a = a & pp_eval_eq(); }
    return a;
}
static long pp_eval_bxor(void) {
    long a = pp_eval_band();
    while (kcc_tok_type == TOK_CARET) { kcc_lex_next(); a = a ^ pp_eval_band(); }
    return a;
}
static long pp_eval_bor(void) {
    long a = pp_eval_bxor();
    while (kcc_tok_type == TOK_PIPE) { kcc_lex_next(); a = a | pp_eval_bxor(); }
    return a;
}
static long pp_eval_land(void) {
    long a = pp_eval_bor();
    while (kcc_tok_type == TOK_AND) { kcc_lex_next(); long b = pp_eval_bor(); a = (a && b); }
    return a;
}
static long pp_eval_lor(void) {
    long a = pp_eval_land();
    while (kcc_tok_type == TOK_OR) { kcc_lex_next(); long b = pp_eval_land(); a = (a || b); }
    return a;
}
static long pp_eval_ternary(void) {
    long c = pp_eval_lor();
    if (kcc_tok_type != TOK_QUESTION) return c;
    kcc_lex_next();
    long t = kcc_pp_eval_expr();
    if (kcc_tok_type == TOK_COLON) kcc_lex_next();
    long e = pp_eval_ternary();
    return c ? t : e;
}

static long pp_eval_unary(void) {
    unsigned long op = kcc_tok_type;
    if (op == TOK_BANG) { kcc_lex_next(); return !pp_eval_unary(); }
    if (op == TOK_TILDE) { kcc_lex_next(); return ~pp_eval_unary(); }
    if (op == TOK_MINUS) { kcc_lex_next(); return -pp_eval_unary(); }
    if (op == TOK_PLUS) { kcc_lex_next(); return pp_eval_unary(); }
    return pp_eval_primary();
}

/* evaluate a macro's body as an integer (macro chains + expression bodies) */
static long pp_eval_macro(struct PPMacro *m) {
    if (pp_eval_depth >= 64) return 0;
    pp_eval_depth++;
    const char *sc = kcc_lex_cursor, *se = kcc_lex_end;
    kcc_lex_cursor = m->body;
    kcc_lex_end = m->body + m->bodylen;
    kcc_lex_next();
    long r = kcc_pp_eval_expr();
    kcc_lex_cursor = sc;
    kcc_lex_end = se;
    pp_eval_depth--;
    return r;
}

static long pp_eval_primary(void) {
    unsigned long tt = kcc_tok_type;
    if (tt == TOK_NUMBER) {
        long v = (long)kcc_pp_atoi(kcc_tok_start, kcc_tok_len);
        kcc_lex_next();
        return v;
    }
    if (tt == TOK_LPAREN) {
        kcc_lex_next();
        long v = kcc_pp_eval_expr();
        if (kcc_tok_type == TOK_RPAREN) kcc_lex_next();
        return v;
    }
    if (tt == TOK_IDENT) {
        if (kcc_tok_len == 7 && kcc_memcmp(kcc_tok_start, "defined", 7) == 0) {
            kcc_lex_next();
            int paren = (kcc_tok_type == TOK_LPAREN);
            if (paren) kcc_lex_next();
            if (kcc_tok_type != TOK_IDENT) { kcc_lex_next(); return 0; }
            int bit = (kcc_ht_get(kcc_pp_macros, kcc_tok_start, kcc_tok_len) != 0);
            kcc_lex_next();
            if (paren && kcc_tok_type == TOK_RPAREN) kcc_lex_next();
            return bit;
        }
        struct PPMacro *m = (struct PPMacro *)kcc_ht_get(kcc_pp_macros, kcc_tok_start, kcc_tok_len);
        if (!m) { kcc_lex_next(); return 0; }
        long v = pp_eval_macro(m);
        kcc_lex_next();
        return v;
    }
    return 0;
}

unsigned long kcc_pp_atoi(const char *p, unsigned long len) {
    unsigned long acc = 0;
    if (len >= 2 && p[0] == '0' && ((p[1] | 0x20) == 'x')) {
        for (unsigned long i = 2; i < len; i++) {
            char c = p[i];
            unsigned long d;
            if (c >= '0' && c <= '9') d = c - '0';
            else { char lc = c | 0x20; if (lc < 'a' || lc > 'f') break; d = lc - 'a' + 10; }
            acc = (acc << 4) + d;
        }
        return acc;
    }
    if (len >= 1 && p[0] == '0') {
        for (unsigned long i = 1; i < len; i++) {
            char c = p[i];
            if (c < '0' || c > '7') break;
            acc = (acc << 3) + (c - '0');
        }
        return acc;
    }
    for (unsigned long i = 0; i < len; i++) {
        char c = p[i];
        if (c < '0' || c > '9') break;
        acc = acc * 10 + (c - '0');
    }
    return acc;
}
@}

\section{File Inclusion and Built-in Headers}

\texttt{\#include} resolves a header by trying, in order, the including file's
own directory, the literal path, and each \texttt{-I} directory; a small set of
headers is served from memory as built-ins.  Alongside resolution, the
preprocessor keeps the \emph{dependency list} for \texttt{-MD}: every real
include file it opens is recorded (built-ins have no path and are skipped), and
\texttt{kcc\_dep\_write} later emits the Makefile fragment
\texttt{obj: src headers\ldots} plus trailing phony \texttt{header:} targets---the
form Kbuild's \texttt{fixdep} reads, and what \texttt{make} needs so a deleted
header does not wedge the build.  The list is written only when the driver has
set \texttt{kcc\_dep\_out} from a \texttt{-MD}/\texttt{-Wp,-MMD} option.

\texttt{kcc\_pp\_force\_include} implements gcc's \texttt{-include FILE}: it
resolves and pushes \texttt{FILE} exactly as \texttt{\#include "FILE"} would, but
with the path handed in by the driver rather than read from a directive.  The
driver calls it once per \texttt{-include} file after \texttt{kcc\_pp\_init} and
before parsing (in reverse order, so the pushed contexts read back in
command-line order), which places each file's macros and typedefs in scope ahead
of the primary source.  Kbuild depends on this: every kernel object is compiled
with \texttt{-include ./include/linux/kconfig.h} (which pulls
\texttt{autoconf.h} and thus every \texttt{CONFIG\_*} macro) and
\texttt{-include ./include/linux/compiler\_types.h}, so without honouring
\texttt{-include} a \texttt{CONFIG\_64BIT}-gated type such as
\texttt{atomic64\_t} would never be declared.

A \texttt{\#include} whose first token after the directive is neither a string
literal nor \texttt{<} is a \emph{computed} include (C17 §6.10.2p4): the
remaining tokens are macro-expanded and the result must then read as one of the
two header-name forms.  The kernel's tracepoint generator is the canonical user:
\texttt{include/trace/define\_trace.h} ends with
\verb|#include TRACE_INCLUDE(TRACE_INCLUDE_FILE)|, and with no
\texttt{TRACE\_INCLUDE\_PATH} set \texttt{TRACE\_INCLUDE(system)} expands to
\verb|<trace/events/|\textit{system}\verb|.h>| (otherwise to a
\texttt{\_\_stringify}'d \verb|"..."|).  \texttt{kcc\_pp\_do\_include} handles
this by expanding the whole rest of the directive line through
\texttt{pp\_expand\_arg}---the same engine \texttt{\#if} uses---and then reading a
\texttt{"\ldots"} or \texttt{<\ldots>} form out of the expansion.  For the angle
form the header name is the concatenation of the token spellings between
\texttt{<} and \texttt{>} with intervening whitespace stripped, because
expansion inserts spaces at every buffer boundary (the path
\texttt{trace\ /\ events\ /\ }\textit{system}\texttt{\ .\ h} arrives as separate
tokens) yet none of that spacing belongs to the file name.  Without this, every
translation unit that defines \texttt{CREATE\_TRACE\_POINTS} stalls on the
first \texttt{define\_trace.h} computed include.

@l c
@d Selfhost: pp include @{
static int pp_file_exists(const char *path) {
    long fd = kcc_sys_open(path, 0, 0);
    if (fd < 0) return 0;    /* open failed (macOS returns -1; Linux returns -errno) */
    kcc_sys_close(fd);
    return 1;
}

static const char *pp_resolve_include(const char *name, int system) {
    unsigned long namelen = kcc_strlen(name);
    /* A quote include (`"..."') is looked up first in the directory of the file
       that holds the directive, then relative to the working directory, before
       the -I path (\stdref{6.10.2p3}).  An angle include (`<...>') searches ONLY
       the -I / system directories (\stdref{6.10.2p2})---never the working
       directory: a kernel tree has a top-level `crypto/hash.h' (a small internal
       shim) that must not shadow the public `include/crypto/hash.h' that
       `#include <crypto/hash.h>' means, or the wrong header quietly omits
       `struct crypto_istat_hash' and every reference to it fails to type-check. */
    if (!system) {
        const char *sp = kcc_src_path;
        if (sp) {
            unsigned long dirlen = 0;
            for (unsigned long i = 0; sp[i]; i++) if (sp[i] == '/') dirlen = i + 1;
            if (dirlen) {
                char *cand = (char *)kcc_arena_alloc(dirlen + namelen + 1);
                kcc_memcpy(cand, sp, dirlen);
                kcc_memcpy(cand + dirlen, name, namelen);
                cand[dirlen + namelen] = 0;
                if (pp_file_exists(cand)) return cand;
            }
        }
        if (pp_file_exists(name)) return name;
    }
    for (unsigned long i = 0; i < pp_inc_ndirs; i++) {
        const char *dir = pp_inc_dirs[i];
        unsigned long dl = kcc_strlen(dir);
        char *cand = (char *)kcc_arena_alloc(dl + namelen + 1);
        kcc_memcpy(cand, dir, dl);
        kcc_memcpy(cand + dl, name, namelen);
        cand[dl + namelen] = 0;
        if (pp_file_exists(cand)) return cand;
    }
    return 0;
}

void kcc_pp_add_include_dir(const char *dir) {
    if (pp_inc_ndirs >= 64) return;
    unsigned long dl = kcc_strlen(dir);
    char *buf = (char *)kcc_arena_alloc(dl + 2);
    kcc_memcpy(buf, dir, dl);
    buf[dl] = '/';
    buf[dl + 1] = 0;
    pp_inc_dirs[pp_inc_ndirs++] = buf;
}

void kcc_pp_add_default_includes(const char *argv0) {
    unsigned long prefixlen = 0;
    for (unsigned long i = 0; argv0[i]; i++) if (argv0[i] == '/') prefixlen = i + 1;
    char *buf = (char *)kcc_arena_alloc(prefixlen + 8);
    kcc_memcpy(buf, argv0, prefixlen);
    kcc_memcpy(buf + prefixlen, "include", 7);
    buf[prefixlen + 7] = 0;
    kcc_pp_add_include_dir(buf);
}

void kcc_pp_do_include(void) {
    kcc_lex_next();
    unsigned long tt = kcc_tok_type;
    const char *nstart;
    unsigned long nlen;
    int system;
    if (tt == TOK_STRING_LIT) {
        system = 0;
        nstart = kcc_tok_start + 1;
        nlen = kcc_tok_len - 2;
    } else if (tt == TOK_LT) {
        system = 1;
        const char *s = kcc_lex_cursor;
        const char *e = kcc_lex_end;
        const char *p = s;
        while (p < e && *p != '>' && *p != 0x0A) p++;
        if (p >= e || *p == 0x0A) { kcc_diag_error(pp_dir_line, 1, m_include); pp_skip_line(); return; }
        nstart = s;
        nlen = (unsigned long)(p - s);
        kcc_lex_cursor = p + 1;
    } else {
        /* Computed include (C17 6.10.2p4): the directive's tokens form neither a
           `"q-char"' nor a `<h-char>' header name, so macro-expand the rest of
           the line and re-interpret the result.  The kernel's tracepoint
           machinery leans on this---`#include TRACE_INCLUDE(TRACE_INCLUDE_FILE)'
           in `include/trace/define_trace.h' expands to
           `<trace/events/SYSTEM.h>' (or a `__stringify'd `"..."').  We expand the
           whole remaining line (the first token was already lexed, so start from
           its beginning) and then parse a string or angle form out of the
           expansion; for the angle form the header name is the token spellings
           between `<' and `>' with intervening whitespace removed, since
           expansion separates the path's tokens (`trace' `/' `events' `/' ...)
           with spaces that are not part of the file name. */
        const char *ls = kcc_tok_start;
        const char *le = kcc_lex_end;
        const char *pe = ls;
        while (pe < le && *pe != 0x0A) pe++;
        unsigned long xlen;
        const char *x = pp_expand_arg(ls, (unsigned long)(pe - ls), &xlen);
        unsigned long i = 0;
        while (i < xlen && (x[i] == ' ' || x[i] == 0x09)) i++;
        if (i < xlen && x[i] == '"') {
            i++;
            unsigned long j = i;
            while (j < xlen && x[j] != '"') j++;
            system = 0; nstart = x + i; nlen = j - i;
        } else if (i < xlen && x[i] == '<') {
            i++;
            char *hb = (char *)kcc_arena_alloc(xlen + 1);
            unsigned long bl = 0;
            while (i < xlen && x[i] != '>') {
                if (x[i] != ' ' && x[i] != 0x09) hb[bl++] = x[i];
                i++;
            }
            system = 1; nstart = hb; nlen = bl;
        } else {
            kcc_diag_error(pp_dir_line, 1, m_include);
            pp_skip_line();
            return;
        }
    }
    char *path = (char *)kcc_arena_alloc(nlen + 1);
    kcc_memcpy(path, nstart, nlen);
    path[nlen] = 0;
    pp_skip_line();
    /* built-in header? */
    const char *hdr = pp_builtin_header(path);
    if (hdr) {
        unsigned long hlen = kcc_strlen(hdr);
        pp_ctx_push(PP_CTX_INCLUDE);
        kcc_src_base = hdr;
        kcc_src_size = hlen;
        kcc_src_path = path;
        kcc_lex_init(hdr, hlen);
        pp_prev_line = 0;
        return;
    }
    const char *rp = pp_resolve_include(path, system);
    if (!rp) {
        if (!system) kcc_diag_error(pp_dir_line, 1, m_notfound);
        return;
    }
    kcc_dep_add(rp);                              /* record for -MD dependency output */
    pp_ctx_push(PP_CTX_INCLUDE);
    kcc_source_open(rp);
    kcc_source_encode();
    kcc_source_splice();
    kcc_lex_init(kcc_src_base, kcc_src_size);
    pp_prev_line = 0;
}

/* Force-include: process FILE as if `#include "FILE"` stood at the very top of
   the primary translation unit, for gcc's `-include FILE`.  The driver calls
   this once per -include file (in reverse command-line order) after
   kcc_pp_init and before parsing, so the pushed contexts are read back in
   forward order and their macros/typedefs are already in scope when the primary
   source is reached.  Kbuild leans on this to inject
   include/linux/kconfig.h (all the CONFIG_* macros via autoconf.h) and
   compiler_types.h before every kernel object. */
void kcc_pp_force_include(const char *path) {
    const char *hdr = pp_builtin_header(path);
    if (hdr) {
        unsigned long hlen = kcc_strlen(hdr);
        pp_ctx_push(PP_CTX_INCLUDE);
        kcc_src_base = hdr;
        kcc_src_size = hlen;
        kcc_src_path = path;
        kcc_lex_init(hdr, hlen);
        pp_prev_line = 0;
        return;
    }
    const char *rp = pp_resolve_include(path, 0);
    if (!rp) { kcc_diag_error(1, 1, m_notfound); return; }
    kcc_dep_add(rp);
    pp_ctx_push(PP_CTX_INCLUDE);
    kcc_source_open(rp);
    kcc_source_encode();
    kcc_source_splice();
    kcc_lex_init(kcc_src_base, kcc_src_size);
    pp_prev_line = 0;
}

/* Dependency tracking for `-MD`/`-Wp,-MMD,file`: record every real include file
   opened while preprocessing, then write a Makefile fragment `obj: src hdrs...`
   that Kbuild's fixdep consumes.  Built-in headers have no path and are skipped. */
const char *kcc_dep_out = 0;                  /* the .d output path, set by the driver */
static const char *kcc_dep_list[1024];
static unsigned long kcc_dep_n = 0;
void kcc_dep_reset(void) { kcc_dep_n = 0; }
void kcc_dep_add(const char *path) { if (kcc_dep_n < 1024) kcc_dep_list[kcc_dep_n++] = path; }
static void dep_puts(long fd, const char *s) { kcc_sys_write(fd, s, kcc_strlen(s)); }
void kcc_dep_write(const char *obj, const char *src) {
    if (!kcc_dep_out) return;
    /* O_WRONLY|O_CREAT|O_TRUNC = 0x241 on Linux, mode 0644; -MD is a Kbuild
       (Linux) feature so the Linux flag values apply. */
    long fd = kcc_sys_open(kcc_dep_out, 0x241, 0644);
    if (fd < 0) return;
    dep_puts(fd, obj); dep_puts(fd, ": "); dep_puts(fd, src);
    for (unsigned long i = 0; i < kcc_dep_n; i++) { dep_puts(fd, " \\\n  "); dep_puts(fd, kcc_dep_list[i]); }
    dep_puts(fd, "\n\n");
    for (unsigned long i = 0; i < kcc_dep_n; i++) { dep_puts(fd, kcc_dep_list[i]); dep_puts(fd, ":\n"); }
    kcc_sys_close(fd);
}

void kcc_pp_do_error(void) {
    unsigned long len;
    const char *msg = pp_rest_of_line(&len);
    char *buf = (char *)kcc_arena_alloc(len + 1);
    kcc_memcpy(buf, msg, len);
    buf[len] = 0;
    kcc_diag_error(pp_dir_line, 1, buf);
}
@}

\section{Phase 5 and 6: String-Literal Escapes and Concatenation}

The \texttt{preprocessor.o} object also carries translation phases~5 and~6
(Chapters~\ref{ch:string-literals}--\ref{ch:concatenation}), which the parser
calls: \texttt{kcc\_strlit\_process} converts escape sequences to their
execution-character-set bytes, and \texttt{kcc\_strlit\_gather} concatenates the
current string literal with every adjacent one (through macro expansion, via
\texttt{kcc\_pp\_next}).  Both hand back a \texttt{\{buffer, length\}} pair in the
first two registers.

@l c
@d Selfhost: pp strlit @{
struct StrResult kcc_strlit_process(const char *src, unsigned long len) {
    const char *p = src, *end = src + len;
    char *dst = (char *)kcc_arena_alloc(len + 1);
    char *d = dst;
    while (p < end) {
        char c = *p;
        if (c != 0x5C) { *d++ = c; p++; continue; }
        p++;                                     /* skip backslash */
        if (p >= end) break;                     /* trailing backslash */
        char e = *p++;
        if (e == 'n') *d++ = 0x0A;
        else if (e == 't') *d++ = 0x09;
        else if (e == 0x5C) *d++ = 0x5C;
        else if (e == '"') *d++ = 0x22;
        else if (e == 0x27) *d++ = 0x27;
        else if (e == 'a') *d++ = 0x07;
        else if (e == 'b') *d++ = 0x08;
        else if (e == 'f') *d++ = 0x0C;
        else if (e == 'r') *d++ = 0x0D;
        else if (e == 'v') *d++ = 0x0B;
        else if (e == '?') *d++ = 0x3F;
        else if (e == 'x') {
            unsigned v = 0;
            while (p < end) {
                char h = *p;
                unsigned dg;
                if (h >= '0' && h <= '9') dg = h - '0';
                else { char lc = h | 0x20; if (lc < 'a' || lc > 'f') break; dg = lc - 'a' + 10; }
                v = (v << 4) + dg;
                p++;
            }
            *d++ = (char)(v & 0xFF);
        } else if (e == '0') {
            if (p < end && *p >= '0' && *p <= '7') {
                unsigned v = 0; int n = 2;
                while (p < end && n && *p >= '0' && *p <= '7') { v = (v << 3) + (*p - '0'); p++; n--; }
                *d++ = (char)(v & 0xFF);
            } else *d++ = 0x00;
        } else if (e >= '1' && e <= '7') {
            unsigned v = e - '0'; int n = 2;
            while (p < end && n && *p >= '0' && *p <= '7') { v = (v << 3) + (*p - '0'); p++; n--; }
            *d++ = (char)(v & 0xFF);
        } else {
            *d++ = e;                            /* unknown escape → literal */
        }
    }
    struct StrResult r;
    r.buf = dst;
    r.len = (unsigned long)(d - dst);
    return r;
}

struct StrResult kcc_strlit_gather(void) {
    unsigned long cap = 256, used = 0;
    char *buf = (char *)kcc_arena_alloc(256);
    for (;;) {
        struct StrResult pr = kcc_strlit_process(kcc_tok_start + 1, kcc_tok_len - 2);
        if (used + pr.len > cap) {
            unsigned long nc = cap;
            while (nc < used + pr.len) nc <<= 1;
            char *nb = (char *)kcc_arena_alloc(nc);
            kcc_memcpy(nb, buf, used);
            buf = nb; cap = nc;
        }
        kcc_memcpy(buf + used, pr.buf, pr.len);
        used += pr.len;
        kcc_pp_next();
        if (kcc_tok_type != TOK_STRING_LIT) break;
    }
    struct StrResult r;
    r.buf = buf;
    r.len = used;
    return r;
}
@}

\section{The Nine Freestanding Built-in Headers}

@l c
@d Selfhost: pp builtin @{
static const char hdr_stddef[] = "#ifndef _STDDEF_H\n#define _STDDEF_H\ntypedef unsigned long size_t;\ntypedef long ptrdiff_t;\ntypedef long max_align_t;\n#define NULL ((void*)0)\n#define offsetof(t, m) ((size_t)&(((t*)0)->m))\n#endif\n";
static const char hdr_stdbool[] = "#ifndef _STDBOOL_H\n#define _STDBOOL_H\n#define bool int\n#define true 1\n#define false 0\n#endif\n";
static const char hdr_stdarg[] = "#ifndef _STDARG_H\n#define _STDARG_H\n#endif\n";
static const char hdr_stdint[] = "#ifndef _STDINT_H\n#define _STDINT_H\ntypedef signed char int8_t;\ntypedef unsigned char uint8_t;\ntypedef short int16_t;\ntypedef unsigned short uint16_t;\ntypedef int int32_t;\ntypedef unsigned int uint32_t;\ntypedef long int64_t;\ntypedef unsigned long uint64_t;\ntypedef long intptr_t;\ntypedef unsigned long uintptr_t;\ntypedef long intmax_t;\ntypedef unsigned long uintmax_t;\ntypedef signed char int_least8_t;\ntypedef unsigned char uint_least8_t;\ntypedef short int_least16_t;\ntypedef unsigned short uint_least16_t;\ntypedef int int_least32_t;\ntypedef unsigned int uint_least32_t;\ntypedef long int_least64_t;\ntypedef unsigned long uint_least64_t;\ntypedef signed char int_fast8_t;\ntypedef unsigned char uint_fast8_t;\ntypedef long int_fast16_t;\ntypedef unsigned long uint_fast16_t;\ntypedef long int_fast32_t;\ntypedef unsigned long uint_fast32_t;\ntypedef long int_fast64_t;\ntypedef unsigned long uint_fast64_t;\n#define INT8_MAX 127\n#define INT16_MAX 32767\n#define INT32_MAX 2147483647\n#define INT64_MAX 9223372036854775807L\n#define UINT8_MAX 255\n#define UINT16_MAX 65535\n#define UINT32_MAX 4294967295U\n#define UINT64_MAX 18446744073709551615UL\n#define INTMAX_MAX 9223372036854775807L\n#define UINTMAX_MAX 18446744073709551615UL\n#define INTPTR_MAX 9223372036854775807L\n#define UINTPTR_MAX 18446744073709551615UL\n#define SIZE_MAX 18446744073709551615UL\n#define INT8_MIN (-128)\n#define INT16_MIN (-32768)\n#define INT32_MIN (-2147483647-1)\n#define INT64_MIN (-9223372036854775807L-1)\n#define INTMAX_MIN (-9223372036854775807L-1)\n#define INTPTR_MIN (-9223372036854775807L-1)\n#endif\n";
static const char hdr_limits[] = "#ifndef _LIMITS_H\n#define _LIMITS_H\n#define CHAR_BIT 8\n#define SCHAR_MIN (-128)\n#define SCHAR_MAX 127\n#define UCHAR_MAX 255\n#define CHAR_MIN (-128)\n#define CHAR_MAX 127\n#define MB_LEN_MAX 6\n#define SHRT_MIN (-32768)\n#define SHRT_MAX 32767\n#define USHRT_MAX 65535\n#define INT_MIN (-2147483647 - 1)\n#define INT_MAX 2147483647\n#define UINT_MAX 4294967295U\n#define LONG_MIN (-9223372036854775807L - 1)\n#define LONG_MAX 9223372036854775807L\n#define ULONG_MAX 18446744073709551615UL\n#define LLONG_MIN (-9223372036854775807LL - 1)\n#define LLONG_MAX 9223372036854775807LL\n#define ULLONG_MAX 18446744073709551615ULL\n#endif\n";
static const char hdr_float[] = "#ifndef _FLOAT_H\n#define _FLOAT_H\n#define FLT_RADIX 2\n#define FLT_MANT_DIG 24\n#define DBL_MANT_DIG 53\n#define LDBL_MANT_DIG 53\n#define FLT_DIG 6\n#define DBL_DIG 15\n#define LDBL_DIG 15\n#define FLT_MIN_EXP (-125)\n#define DBL_MIN_EXP (-1021)\n#define LDBL_MIN_EXP (-1021)\n#define FLT_MAX_EXP 128\n#define DBL_MAX_EXP 1024\n#define LDBL_MAX_EXP 1024\n#define FLT_MIN_10_EXP (-37)\n#define DBL_MIN_10_EXP (-307)\n#define LDBL_MIN_10_EXP (-307)\n#define FLT_MAX_10_EXP 38\n#define DBL_MAX_10_EXP 308\n#define LDBL_MAX_10_EXP 308\n#define FLT_ROUNDS 1\n#define FLT_EVAL_METHOD 0\n#define FLT_EPSILON 1.19209290e-7F\n#define DBL_EPSILON 2.2204460492503131e-16\n#define LDBL_EPSILON 2.2204460492503131e-16\n#define FLT_MIN 1.17549435e-38F\n#define DBL_MIN 2.2250738585072014e-308\n#define LDBL_MIN 2.2250738585072014e-308\n#define FLT_MAX 3.40282347e+38F\n#define DBL_MAX 1.7976931348623157e+308\n#define LDBL_MAX 1.7976931348623157e+308\n#define DECIMAL_DIG 17\n#endif\n";
static const char hdr_iso646[] = "#ifndef _ISO646_H\n#define _ISO646_H\n#define and &&\n#define and_eq &=\n#define bitand &\n#define bitor |\n#define compl ~\n#define not !\n#define not_eq !=\n#define or ||\n#define or_eq |=\n#define xor ^\n#define xor_eq ^=\n#endif\n";
static const char hdr_stdnoreturn[] = "#ifndef _STDNORETURN_H\n#define _STDNORETURN_H\n#define noreturn _Noreturn\n#define __noreturn_is_defined 1\n#endif\n";
static const char hdr_stdalign[] = "#ifndef _STDALIGN_H\n#define _STDALIGN_H\n#define alignas _Alignas\n#define alignof _Alignof\n#define __alignas_is_defined 1\n#define __alignof_is_defined 1\n#endif\n";

static const char *pp_builtin_header(const char *name) {
    if (kcc_strcmp2(name, "stddef.h")) return hdr_stddef;
    if (kcc_strcmp2(name, "stdbool.h")) return hdr_stdbool;
    if (kcc_strcmp2(name, "stdarg.h")) return hdr_stdarg;
    if (kcc_strcmp2(name, "stdint.h")) return hdr_stdint;
    if (kcc_strcmp2(name, "limits.h")) return hdr_limits;
    if (kcc_strcmp2(name, "float.h")) return hdr_float;
    if (kcc_strcmp2(name, "iso646.h")) return hdr_iso646;
    if (kcc_strcmp2(name, "stdnoreturn.h")) return hdr_stdnoreturn;
    if (kcc_strcmp2(name, "stdalign.h")) return hdr_stdalign;
    return 0;
}
@}

\section{Assembling the Translation Unit}

@l c
@d Selfhost: preprocessor @{
@<Selfhost: pp preamble@>
static int kcc_strcmp2(const char *a, const char *b) {
    unsigned long i = 0;
    while (a[i] && a[i] == b[i]) i++;
    return a[i] == 0 && b[i] == 0;
}
@<Selfhost: pp core@>
@<Selfhost: pp helpers@>
@<Selfhost: pp dispatch@>
@<Selfhost: pp define@>
@<Selfhost: pp expand@>
@<Selfhost: pp substitute@>
@<Selfhost: pp predefined@>
@<Selfhost: pp conditional@>
@<Selfhost: pp eval@>
@<Selfhost: pp include@>
@<Selfhost: pp builtin@>
@<Selfhost: pp strlit@>
@}

\section{Verification}
\label{sec:selfhost-preprocessor-verify}

\texttt{make selfhost-preprocessor} runs the strongest oracle---\texttt{difftest}
byte-compares generated objects against clang, and every case is preprocessed by
the C engine---together with the self-host and lexer suites, the diagnostic
suite, and the code-generation suite.  A clean sweep means \kcc{} preprocessed
its own directives, macro expansions, conditionals, and includes faithfully
enough that not one byte of generated code changed.

@d Selfhost: preprocessor verify @{
#!/usr/bin/env bash
# make selfhost-preprocessor — compile kcc's preprocessor in C with kcc, relink,
# run difftest + selfhost + diagtest + codegen.
set -euo pipefail

SDK=$(xcrun --show-sdk-path)
SH=tmp/selfhost
sources="main syscalls arena strings io hashtab vec strtab source lexer \
lexer_tables diag preprocessor parser expressions statements declarations \
types symtab conversions sema ir opt emit_arm64 emit_x86 linker codegen emit_macho dwarf driver"

echo "[1/4] compiling tmp/selfhost/preprocessor.c with kcc"
tmp/kcc -c "$SH/preprocessor.c" -o "$SH/preprocessor_c.o" >/dev/null

echo "[2/4] linking tmp/kcc_selfhost_preprocessor (preprocessor.o -> C)"
OBJ=""
for f in $sources; do
    if [ "$f" = "preprocessor" ]; then OBJ="$OBJ $SH/preprocessor_c.o"; else OBJ="$OBJ tmp/src/${f}.o"; fi
done
ld -o tmp/kcc_selfhost_preprocessor $OBJ -lSystem -syslibroot "$SDK" -e _main -arch arm64

cp tmp/kcc "$SH/kcc_asm_backup_preprocessor"
cp tmp/kcc_selfhost_preprocessor tmp/kcc

echo "[3/4] difftest (byte-compare) + diagtest"
set +e
bash tmp/tests/difftest.sh >/tmp/pp_difftest.log 2>&1; dstatus=$?
tail -1 /tmp/pp_difftest.log
bash tmp/tests/diagtest.sh >/tmp/pp_diag.log 2>&1; diagst=$?
tail -1 /tmp/pp_diag.log
set -e
if [ $dstatus -ne 0 ] || [ $diagst -ne 0 ]; then cp "$SH/kcc_asm_backup_preprocessor" tmp/kcc; exit 1; fi

echo "[4/4] codegen suite with the self-hosted preprocessor"
set +e
bash tmp/tests/test_codegen.sh
status=$?
cp "$SH/kcc_asm_backup_preprocessor" tmp/kcc
exit $status
@}
