@<Header: time@>
@}

@o include/errno.h -s @{
@<Header: errno@>
@}

@o include/inttypes.h -s @{
@<Header: inttypes@>
@}

@o include/signal.h -s @{
@<Header: signal@>
@}

@o include/setjmp.h -s @{
@<Header: setjmp@>
@}

@o include/locale.h -s @{
@<Header: locale@>
@}

@o include/fenv.h -s @{
@<Header: fenv@>
@}

@o include/wchar.h -s @{
