% 20-concatenation.weft — Phase 6: Adjacent String Literal Concatenation
%
% Translation phase 6 (§5.1.1.2 paragraph 6): adjacent string literal
% tokens are concatenated.  For example, "hello " "world" becomes
% "hello world".
%
% This is a simple left-to-right pass over the token stream.

\chapter{String Literal Concatenation}
\label{ch:concatenation}

Phase~6 of the C17 translation pipeline concatenates adjacent string
literal tokens (\stdref{5.1.1.2}, paragraph~6; \stdref{6.4.5}/4).
After Phase~5 has processed escape sequences, any sequence of adjacent
\texttt{TOK\_STRING\_LIT} tokens is merged into a single string literal.

\section{Algorithm}

The gather runs where the parser reduces a primary expression to a string
literal (\S\ref{ch:expressions}).  The current token is a
\texttt{TOK\_STRING\_LIT}; \texttt{\_kcc\_strlit\_gather} processes its escapes,
copies the result into a growable arena buffer, then advances with
\texttt{\_kcc\_pp\_next} and, so long as the next token is another string
literal, appends it too.  Two points make this the right seam rather than a
lexer-level pass.  First, using \texttt{\_kcc\_pp\_next} means an adjacent
literal produced by a \emph{macro}---\verb|"%" PRId64 "\n"|, where
\texttt{PRId64} expands to \texttt{"ld"}---is seen and concatenated like any
other, which a raw lexer peek would miss.  Second, the accumulation buffer
doubles on demand, so a concatenation of any size is handled without a fixed
ceiling.  The loop leaves the first non-string token current, exactly as a
plain single-literal parse would, so the caller continues unchanged.

@d Concat: adjacent strings @{
// -- Adjacent string literal concatenation (translation phase 6) -------
// char *_kcc_strlit_gather(uint64_t *out_len)  [x1 returned, not by pointer]
//   On entry the current token is a TOK_STRING_LIT.  Processes it and every
//   adjacent string literal (through macro expansion, via _kcc_pp_next),
//   accumulating the escaped contents into one growable arena buffer.
//   Output: x0 = buffer, x1 = total length.  The next non-string token is
//   left current.
.text
.globl _kcc_strlit_gather
.p2align 2
_kcc_strlit_gather:
    stp x29, x30, [sp, #-80]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    str x25, [sp, #64]

    mov x0, #256
    bl _kcc_arena_alloc
    mov x21, x0                   // buffer base
    mov x22, #0                   // used length
    mov x23, #256                 // capacity

.Lgather_one:
    // Process this literal's escapes into a fresh buffer (x24=ptr, x25=len)
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x0, [x0]
    add  x0, x0, #1               // skip opening quote
    adrp x1, _kcc_tok_len@@PAGE
    add  x1, x1, _kcc_tok_len@@PAGEOFF
    ldr  x1, [x1]
    sub  x1, x1, #2               // content length (drop quotes)
    bl _kcc_strlit_process
    mov  x24, x0                  // processed ptr
    mov  x25, x1                  // processed len

    // Grow the buffer if used + len would overflow the capacity
    add  x0, x22, x25             // need
    cmp  x0, x23
    b.ls .Lgather_fits
    mov  x20, x23                 // newcap
.Lgather_grow:
    lsl  x20, x20, #1
    cmp  x20, x0
    b.lo .Lgather_grow
    mov  x0, x20
    bl _kcc_arena_alloc
    mov  x19, x0                  // new base
    mov  x0, x19
    mov  x1, x21
    mov  x2, x22
    bl _kcc_memcpy               // copy the bytes so far
    mov  x21, x19                // base = new
    mov  x23, x20                // cap = newcap
.Lgather_fits:
    add  x0, x21, x22            // dst = base + used
    mov  x1, x24                 // src = processed content
    mov  x2, x25                 // len
    bl _kcc_memcpy
    add  x22, x22, x25           // used += len

    // Consume this literal; continue while the next token is a string literal
    bl _kcc_pp_next
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_STRING_LIT
    b.eq .Lgather_one

    mov  x0, x21                  // buffer base
    mov  x1, x22                  // total length
    ldr x25, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #80
    ret
@| _kcc_strlit_gather
@}

\section{Data}

Reserved for future use (e.g., wide string concatenation tracking).

@d Concat: data @{
// -- Concatenation data (reserved) -------------------------------------
.data
.p2align 3
@}
