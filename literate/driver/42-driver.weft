% 42-driver.weft — Compilation Driver
%
% This chapter implements the full compilation pipeline, invoked when
% the user passes \texttt{-c} to compile a C source file into a
% Mach-O object file.

\chapter{Compilation Driver}
\label{ch:compile-driver}

The preceding chapters implement each compilation phase in isolation; this chapter wires them together into a single end-to-end pipeline.  When the user invokes \texttt{kcc~-c}, the driver opens the source file, runs translation phases, parses, type-checks, lowers to IR, optimizes, generates machine code, and writes the resulting Mach-O object file.  The pipeline is deliberately sequential and straight-line---each phase completes before the next begins---so that errors are caught early and the overall flow is easy to trace.

\section{Full Compilation Pipeline}

The driver orchestrates every phase of compilation in a single
straight-line function.  Given a source path and an output path it:
%
\begin{enumerate}
\item Opens and reads the source file.
\item Runs translation phases 1--2 (trigraph replacement and line
      splicing).
\item Initializes the lexer, preprocessor, string table, and
      typedef table.
\item Parses the translation unit into an AST.
\item Initializes the type system and symbol table, then runs
      semantic analysis.
\item Builds the IR and runs optimization passes.
\item Initializes the code buffer, linker, and code generator
      (including the cstring buffer for string literals).
\item Pre-registers global variable sizes so that struct globals
      receive the correct allocation (one 8-byte slot per field).
\item Lowers all IR to ARM64 machine code.
\item Appends string literal data to the code section and patches
      symbol values (\texttt{kcc\_codegen\_emit\_strings}).
\item Writes the Mach-O object file.
\end{enumerate}

@d Driver: compile @{
// -- kcc_driver_compile -------------------------------------------------------
// void kcc_driver_compile(const char *src_path, const char *out_path)
//   x0 = source file path
//   x1 = output file path
.text
.globl _kcc_driver_compile
.p2align 2
_kcc_driver_compile:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    mov x19, x0                    // src_path
    mov x20, x1                    // out_path

    // 1. Open and read source file
    mov x0, x19
    bl _kcc_source_open

    // 2. Translation Phase 1: trigraph replacement
    bl _kcc_source_encode

    // 3. Translation Phase 2: line splicing
    bl _kcc_source_splice

    // 4. Initialize lexer
    adrp x0, _kcc_src_base@@PAGE
    add  x0, x0, _kcc_src_base@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_src_size@@PAGE
    add  x1, x1, _kcc_src_size@@PAGEOFF
    ldr  x1, [x1]
    bl _kcc_lex_init

    // 5. Initialize preprocessor
    bl _kcc_pp_init

    // 6. Initialize string table and typedef table
    bl _kcc_strtab_init
    bl _kcc_typedef_init

    // 7. Parse
    bl _kcc_parse
    mov x21, x0                    // trans_unit

    // 8. Initialize type system and symbol table
    bl _kcc_types_init
    bl _kcc_symtab_init

    // 9. Semantic analysis
    mov x0, x21
    bl _kcc_sema_check

    // 10. Check for errors
    bl _kcc_diag_had_errors
    cbnz x0, .Ldc_error

    // 11. Build IR
    bl _kcc_ir_init
    mov x0, x21
    bl _kcc_ir_build

    // 12. Optimize
    bl _kcc_opt_run

    // 12b. Verify the optimized IR before handing it to the back end.  A
    // structural violation (bad opcode, unterminated block, cyclic list) is an
    // internal error, not a user error, so it aborts the compile rather than
    // letting the code generator produce garbage.
    bl _kcc_ir_validate
    cbnz x0, .Ldc_error

    // 12c. Target dispatch.  Under --target=x86_64 the IR is handed to the
    // x86-64 assembly-emission back end (Chapter~\ref{ch:emit-x86}), which
    // walks the same optimized IR and assembles with `as -arch x86_64`,
    // bypassing the ARM64 code generator and Mach-O writer entirely.  The
    // default (0) leaves the flagship ARM64 path below completely untouched.
    adrp x0, _kcc_target@@PAGE
    add  x0, x0, _kcc_target@@PAGEOFF
    ldr x0, [x0]
    cbz x0, .Ldc_arm64
    // Publish the AST translation unit so the x86 back end can emit storage for
    // file-scope globals (its data pass walks the same tree the ARM64
    // pre-registration does).
    adrp x1, _kcc_x86_tu@@PAGE
    add  x1, x1, _kcc_x86_tu@@PAGEOFF
    str x21, [x1]                  // x21 = trans_unit
    mov x0, x20                    // out_path
    bl _kcc_driver_x86_object
    b .Ldc_return
.Ldc_arm64:

    // 13. Initialize backend
    bl _kcc_code_init
    bl _kcc_linker_init
    bl _kcc_codegen_init

    // 13b. Pre-register global variable sizes
    mov x0, x21                    // trans_unit
    bl _kcc_preregister_globals

    // 14. Generate code
    bl _kcc_codegen_all

    // 14b. Append string literal data to code section
    bl _kcc_codegen_emit_strings

    // 14z. Emission strategy.  Under --emit-asm the object is produced through
    // the textual `.s` + platform `as` back end; otherwise the direct Mach-O
    // writer runs (with an optional KCC_EMIT_ASM=<path> side-render for
    // bring-up, which leaves the Mach-O path unaffected).
    adrp x0, _kcc_emit_asm@@PAGE
    add  x0, x0, _kcc_emit_asm@@PAGEOFF
    ldr x0, [x0]
    cbz x0, .Ldc_macho
    mov x0, x20                    // out_path
    bl _kcc_driver_emit_asm_object
    b .Ldc_return

.Ldc_macho:
    adrp x0, _kcc_as_s_env@@PAGE
    add  x0, x0, _kcc_as_s_env@@PAGEOFF
    mov x1, #12
    bl _kcc_getenv
    cbz x0, .Ldc_noasm
    bl _kcc_as_render
.Ldc_noasm:

    // 14c. Build DWARF debug sections (only under -g); code size and all
    // function addresses are final by now.
    bl _kcc_dwarf_build

    // 15. Write Mach-O object file
    mov x0, x20                    // out_path
    bl _kcc_macho_init
    bl _kcc_macho_finalize

    // 16. Success
    mov x0, #0
    b .Ldc_return

.Ldc_error:
    bl _kcc_io_flush
    mov x0, #1

.Ldc_return:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

// -- kcc_driver_emit_asm_object -----------------------------------------------
// int kcc_driver_emit_asm_object(const char *out_path)
// Renders the generated code to "<out_path>.s", then runs the platform
// assembler (`as -o <out_path> <out_path>.s`) to produce the object file.
// Returns 0 on success, 1 on error.
.globl _kcc_driver_emit_asm_object
.p2align 2
_kcc_driver_emit_asm_object:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    mov x19, x0                    // out_path
    // Build "<out_path>.s" (out_len + 3 bytes for ".s\0").
    bl _kcc_strlen
    mov x20, x0                    // out_len
    add x0, x20, #3
    bl _kcc_arena_alloc
    mov x21, x0                    // out_s buffer
    mov x0, x21
    mov x1, x19
    mov x2, x20
    bl _kcc_memcpy                 // copy out_path
    add x0, x21, x20              // &out_s[out_len]
    adrp x1, _kcc_str_dot_s@@PAGE
    add  x1, x1, _kcc_str_dot_s@@PAGEOFF
    mov x2, #3                     // ".s\0"
    bl _kcc_memcpy
    // Render the assembly to out_s.
    mov x0, x21
    bl _kcc_as_render
    cbnz x0, .Leao_err
    // Build argv = { "as", "-o", out_path, out_s, 0 } and run /usr/bin/as.
    mov x0, #48                    // 6 pointers
    bl _kcc_arena_alloc
    mov x22, x0
    adrp x0, _kcc_str_as_argv0@@PAGE
    add  x0, x0, _kcc_str_as_argv0@@PAGEOFF
    str x0, [x22, #0]
    adrp x0, _kcc_opt_o@@PAGE
    add  x0, x0, _kcc_opt_o@@PAGEOFF
    str x0, [x22, #8]
    str x19, [x22, #16]           // out_path
    str x21, [x22, #24]           // out_s
    str xzr, [x22, #32]           // NULL terminator
    adrp x0, _kcc_str_as_path@@PAGE
    add  x0, x0, _kcc_str_as_path@@PAGEOFF
    mov x1, x22
    bl _kcc_driver_spawn           // returns child exit status
    cbnz x0, .Leao_err
    mov x0, #0
    b .Leao_done
.Leao_err:
    mov x0, #1
.Leao_done:
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret

// -- kcc_driver_x86_object ----------------------------------------------------
// int kcc_driver_x86_object(const char *out_path)
// Renders the x86-64 assembly to "<out_path>.s", then runs the platform
// assembler for x86-64 (`as -arch x86_64 -o <out_path> <out_path>.s`) to
// produce the Mach-O object.  Returns 0 on success, 1 on error.  Mirrors
// kcc_driver_emit_asm_object, but renders x86-64 and passes `-arch x86_64`.
.globl _kcc_driver_x86_object
.p2align 2
_kcc_driver_x86_object:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    mov x19, x0                    // out_path

    // Linux/ELF target: this compiler runs on Darwin, whose `as` emits Mach-O,
    // not ELF.  So under --target=x86_64-linux kcc renders the ELF-flavour
    // assembly straight to the output path and stops---the object is produced
    // by assembling that `.s` on a Linux host (or with a cross-assembler).
    adrp x0, _kcc_x86_os@@PAGE
    add  x0, x0, _kcc_x86_os@@PAGEOFF
    ldr x0, [x0]
    cbz x0, .Lxo_darwin
    mov x0, x19                    // out_path receives the assembly text
    bl _kcc_x86_render
    b .Lxo_done
.Lxo_darwin:
    // Build "<out_path>.s".  (Restore x0 = out_path; the os check above clobbered it.)
    mov x0, x19
    bl _kcc_strlen
    mov x20, x0                    // out_len
    add x0, x20, #3
    bl _kcc_arena_alloc
    mov x21, x0                    // out_s buffer
    mov x0, x21
    mov x1, x19
    mov x2, x20
    bl _kcc_memcpy                 // copy out_path
    add x0, x21, x20              // &out_s[out_len]
    adrp x1, _kcc_str_dot_s@@PAGE
    add  x1, x1, _kcc_str_dot_s@@PAGEOFF
    mov x2, #3                     // ".s\0"
    bl _kcc_memcpy
    // Render the x86-64 assembly to out_s.
    mov x0, x21
    bl _kcc_x86_render
    cbnz x0, .Lxo_err
    // Build argv = { "as", "-arch", "x86_64", "-o", out_path, out_s, 0 }.
    mov x0, #56                    // 7 pointers
    bl _kcc_arena_alloc
    mov x22, x0
    adrp x0, _kcc_str_as_argv0@@PAGE
    add  x0, x0, _kcc_str_as_argv0@@PAGEOFF
    str x0, [x22, #0]
    adrp x0, _kcc_str_arch@@PAGE
    add  x0, x0, _kcc_str_arch@@PAGEOFF
    str x0, [x22, #8]
    adrp x0, _kcc_str_x86_64@@PAGE
    add  x0, x0, _kcc_str_x86_64@@PAGEOFF
    str x0, [x22, #16]
    adrp x0, _kcc_opt_o@@PAGE
    add  x0, x0, _kcc_opt_o@@PAGEOFF
    str x0, [x22, #24]
    str x19, [x22, #32]           // out_path
    str x21, [x22, #40]           // out_s
    str xzr, [x22, #48]           // NULL terminator
    adrp x0, _kcc_str_as_path@@PAGE
    add  x0, x0, _kcc_str_as_path@@PAGEOFF
    mov x1, x22
    bl _kcc_driver_spawn
    cbnz x0, .Lxo_err
    mov x0, #0
    b .Lxo_done
.Lxo_err:
    mov x0, #1
.Lxo_done:
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@| _kcc_driver_compile _kcc_driver_emit_asm_object _kcc_driver_x86_object
@}

\section{Compiling Several Translation Units}

The pipeline above compiles one file; a real project has many.  So that
a single \texttt{kcc~-c} invocation can turn a whole subsystem into
object files---the shape the self-hosting build needs---the driver
loops \texttt{\_kcc\_driver\_compile} over every source argument.  This
is why that function now \emph{returns} a status (0~success, 1~failure)
instead of exiting: the loop must survive an individual file's outcome,
accumulate the failures, and exit once at the end with the combined
result.

Because every per-translation-unit subsystem (\texttt{ir\_init},
\texttt{code\_init}, \texttt{linker\_init}, the string, typedef, type,
and symbol tables) reinitialises its state at the top of
\texttt{\_kcc\_driver\_compile}, each file starts from a clean slate;
only the arena grows monotonically, which is harmless.

Cross-unit sharing works through ordinary external linkage.  A
function called without a definition in the current file already
becomes an undefined symbol the linker resolves against the object
that defines it.  Data is symmetric once \texttt{extern} is honoured:
a plain file-scope \texttt{int total;} reserves storage, while
\texttt{extern int total;} in another unit references that same storage
without redefining it (\S\ref{sec:preregister-globals}).

\paragraph{Naming the object file.}
When the output is not given explicitly, each object file takes the
name of its source with a \texttt{.c} suffix rewritten to \texttt{.o}
(or \texttt{.o} appended if there is no such suffix).

\paragraph{The \texttt{-Wall} flag.}
Both passes recognise \texttt{-Wall} the same way they recognise
\texttt{-o}: as an argument that is \emph{not} a source file.  The first
pass, on seeing it, sets \texttt{\_kcc\_warn\_all} so the warning checks
in semantic analysis switch on; the second pass simply skips it.  Because
the flag is matched before the source-file fall-through, it may appear
anywhere in the argument list without being mistaken for an input.

\paragraph{The \texttt{-I} flag.}
An include directory arrives in either of two shapes: attached,
\texttt{-Idir}, or separated, \texttt{-I dir}.  \texttt{\_kcc\_driver\_I}
recognises both from a two-byte \texttt{-I} prefix and reports how many
argument slots the option occupies---one for the attached form, two for the
separated form---so each parsing loop can register or skip it uniformly.  The
\texttt{do\_register} argument distinguishes the roles: the counting pre-pass
calls it with registration \emph{on} (adding the directory to the search path
via \texttt{\_kcc\_pp\_add\_include\_dir}), while the compile pass calls it with
registration \emph{off}, using only the returned slot count to step over the
option.  This keeps a directory from being registered twice and localises the
attached-vs-separated logic to one place.

\paragraph{The \texttt{-D} flag.}
\texttt{\_kcc\_driver\_D} is the exact analogue for command-line macro
definitions, in the same two shapes: attached \texttt{-DNAME} or
\texttt{-DNAME=VALUE}, and separated \texttt{-D NAME}.  A bare name takes the
value~\texttt{1} (the convention \texttt{cc} follows), while an
\texttt{=}-suffix supplies an explicit body.  Because the macro table is rebuilt
for every translation unit, the scan pass merely \emph{records} each definition's
payload (via \texttt{\_kcc\_pp\_add\_cmdline\_define}); the actual macros are
(re)installed from that list at the end of \texttt{\_kcc\_pp\_predefine}, which
runs on every preprocessor initialisation.  So each source sees the same
command-line macros on top of the built-in predefines, and configuration
switches such as \texttt{-DNDEBUG} or a library's \texttt{-DLUA\_USE\_POSIX}
behave as they do under any C compiler.

@d Driver: compile @{
// -- kcc_driver_I -------------------------------------------------------------
// uint64_t kcc_driver_I(const char *arg, const char *next, uint64_t do_register)
//   Detect a -I option: attached "-Idir" or separated "-I dir".
//   Returns slots consumed: 0 = not -I, 1 = attached, 2 = separated.
//   When do_register != 0, registers the directory with the preprocessor.
.text
.p2align 2
_kcc_driver_I:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]
    mov x19, x0                    // arg
    mov x20, x1                    // next
    mov x21, x2                    // do_register
    mov x0, x19
    adrp x1, _kcc_opt_incdir@@PAGE
    add  x1, x1, _kcc_opt_incdir@@PAGEOFF
    mov  x2, #2
    bl _kcc_memcmp
    cbnz x0, .LdI_no               // arg does not start with "-I"
    ldrb w0, [x19, #2]
    cbz  w0, .LdI_sep              // exactly "-I": separated form
    // Attached "-Idir": directory is arg+2
    cbz  x21, .LdI_att_ret
    add  x0, x19, #2
    bl _kcc_pp_add_include_dir
.LdI_att_ret:
    mov  x0, #1
    b .LdI_ret
.LdI_sep:
    cbz  x21, .LdI_sep_ret
    cbz  x20, .LdI_sep_ret         // no following argument to register
    mov  x0, x20
    bl _kcc_pp_add_include_dir
.LdI_sep_ret:
    mov  x0, #2
    b .LdI_ret
.LdI_no:
    mov  x0, #0
.LdI_ret:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_driver_I
@}

@d Driver: compile @{
// -- kcc_driver_D -------------------------------------------------------------
// uint64_t kcc_driver_D(const char *arg, const char *next, uint64_t do_register)
//   Detect a -D option: attached "-DNAME"/"-DNAME=VALUE" or separated "-D NAME".
//   Returns slots consumed: 0 = not -D, 1 = attached, 2 = separated.  With
//   do_register != 0 the definition's payload is recorded for the preprocessor.
//   Mirrors kcc_driver_I so every argument-parsing pass handles -D uniformly.
.text
.p2align 2
_kcc_driver_D:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]
    mov x19, x0                    // arg
    mov x20, x1                    // next
    mov x21, x2                    // do_register
    mov x0, x19
    adrp x1, _kcc_opt_defmac@@PAGE
    add  x1, x1, _kcc_opt_defmac@@PAGEOFF
    mov  x2, #2
    bl _kcc_memcmp
    cbnz x0, .LdD_no               // arg does not start with "-D"
    ldrb w0, [x19, #2]
    cbz  w0, .LdD_sep              // exactly "-D": separated form
    // Attached "-DNAME[=VALUE]": payload is arg+2
    cbz  x21, .LdD_att_ret
    add  x0, x19, #2
    bl _kcc_pp_add_cmdline_define
.LdD_att_ret:
    mov  x0, #1
    b .LdD_ret
.LdD_sep:
    cbz  x21, .LdD_sep_ret
    cbz  x20, .LdD_sep_ret         // no following argument to record
    mov  x0, x20
    bl _kcc_pp_add_cmdline_define
.LdD_sep_ret:
    mov  x0, #2
    b .LdD_ret
.LdD_no:
    mov  x0, #0
.LdD_ret:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_driver_D
@}

The kernel is compiled with two code-generation flags that every argument pass
must recognise: \texttt{-mno-red-zone} and \texttt{-mcmodel=kernel}.  Both are
already satisfied by \kcc's x86-64 output.  The red zone---the 128 bytes below
\texttt{\%rsp} that a leaf function may use without adjusting the stack---is
never touched, because every function allocates its whole frame with an explicit
\texttt{subq}; and the code model is immaterial because symbol references are
RIP-relative (\texttt{leaq sym(\%rip)}, direct \texttt{call sym}) and large
immediates are \texttt{movabsq}, all of which resolve identically whether the
image sits in the low or the top two gigabytes.  So \texttt{kcc\_driver\_mflag}
accepts these flags as no-ops---\texttt{-mcmodel=small} and \texttt{kernel} and
either red-zone spelling---and refuses \texttt{-mcmodel=large}/\texttt{medium}
cleanly, since \kcc's direct calls and RIP-relative data cannot span the
four-gigabyte reach those models allow.  It returns 1 for a flag to skip and 0
for anything else, leaving unrelated arguments to the caller.

@d Driver: compile @{
// -- kcc_driver_mflag ---------------------------------------------------------
// uint64_t kcc_driver_mflag(const char *arg)
//   Recognise the x86 code-model / red-zone flags.  Returns 1 if arg is one
//   kcc honours (skip it), 0 if it is not an -m flag we handle.  An -mcmodel=
//   with an unsupported model is refused here (message + exit).
.text
.p2align 2
.globl _kcc_driver_mflag
_kcc_driver_mflag:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]
    mov x19, x0                    // arg
    mov x0, x19
    adrp x1, _kcc_opt_mnoredzone@@PAGE
    add  x1, x1, _kcc_opt_mnoredzone@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lmf_yes
    mov x0, x19
    adrp x1, _kcc_opt_mredzone@@PAGE
    add  x1, x1, _kcc_opt_mredzone@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lmf_yes
    mov x0, x19
    adrp x1, _kcc_opt_mcmodel@@PAGE
    add  x1, x1, _kcc_opt_mcmodel@@PAGEOFF
    mov  x2, #9                    // strlen("-mcmodel=")
    bl _kcc_memcmp
    cbnz x0, .Lmf_no               // not a -mcmodel= flag
    add x19, x19, #9               // suffix after "-mcmodel="
    mov x0, x19
    adrp x1, _kcc_str_cm_small@@PAGE
    add  x1, x1, _kcc_str_cm_small@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lmf_yes
    mov x0, x19
    adrp x1, _kcc_str_cm_kernel@@PAGE
    add  x1, x1, _kcc_str_cm_kernel@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lmf_yes
    // unsupported model: refuse cleanly
    adrp x0, _kcc_driver_err_cmodel@@PAGE
    add  x0, x0, _kcc_driver_err_cmodel@@PAGEOFF
    bl _kcc_io_err
    bl _kcc_io_flush
    mov x0, #1
    bl _kcc_sys_exit
.Lmf_yes:
    mov x0, #1
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
.Lmf_no:
    mov x0, #0
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_driver_mflag
@}

A real Kbuild command line carries dozens of code-generation, tuning, warning,
and optimisation flags---\texttt{-O2}, \texttt{-fno-strict-aliasing},
\texttt{-fno-stack-protector}, \texttt{-mno-sse}, \texttt{-mtune=generic},
\texttt{-Wno-sign-compare}, \texttt{-std=gnu11}, \texttt{-nostdinc}, and many
more.  None of them change the code \kcc{} generates for the freestanding
integer subset the kernel is written in: \kcc{} has a single fixed optimisation
pipeline, never emits vector registers except for actual floating point (which
kernel C avoids), and has no strict-aliasing or stack-protector passes to turn
off.  So \texttt{kcc\_driver\_xflag} accepts the whole family as no-ops by
prefix---anything beginning \texttt{-O}, \texttt{-f}, \texttt{-W} (past the
\texttt{-Wall} handled earlier), \texttt{-m} (past the code-model flags),
\texttt{-std=}, \texttt{-pipe}, or \texttt{-nostdinc}.  This is a deliberate
simplification, not full support: the flags are ignored, not implemented.
\texttt{kcc\_driver\_skipopt} chains the code-model recogniser and this one, so a
single call at each argument scan consumes any tuning flag wherever it appears.

@d Driver: compile @{
// -- kcc_driver_xflag ---------------------------------------------------------
// uint64_t kcc_driver_xflag(const char *arg)
//   1 if arg is a single-slot tuning/warning/optimisation flag kcc tolerates as
//   a no-op, matched by prefix; 0 otherwise.
.text
.p2align 2
_kcc_driver_xflag:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]
    mov x19, x0                    // arg
    mov x0, x19
    adrp x1, _kcc_xf_dO@@PAGE
    add  x1, x1, _kcc_xf_dO@@PAGEOFF
    mov  x2, #2
    bl _kcc_memcmp
    cbz x0, .Lxf_yes
    mov x0, x19
    adrp x1, _kcc_xf_df@@PAGE
    add  x1, x1, _kcc_xf_df@@PAGEOFF
    mov  x2, #2
    bl _kcc_memcmp
    cbz x0, .Lxf_yes
    mov x0, x19
    adrp x1, _kcc_xf_dW@@PAGE
    add  x1, x1, _kcc_xf_dW@@PAGEOFF
    mov  x2, #2
    bl _kcc_memcmp
    cbz x0, .Lxf_yes
    mov x0, x19
    adrp x1, _kcc_xf_dm@@PAGE
    add  x1, x1, _kcc_xf_dm@@PAGEOFF
    mov  x2, #2
    bl _kcc_memcmp
    cbz x0, .Lxf_yes
    mov x0, x19
    adrp x1, _kcc_xf_std@@PAGE
    add  x1, x1, _kcc_xf_std@@PAGEOFF
    mov  x2, #5                    // "-std="
    bl _kcc_memcmp
    cbz x0, .Lxf_yes
    mov x0, x19
    adrp x1, _kcc_xf_pipe@@PAGE
    add  x1, x1, _kcc_xf_pipe@@PAGEOFF
    mov  x2, #5                    // "-pipe"
    bl _kcc_memcmp
    cbz x0, .Lxf_yes
    mov x0, x19
    adrp x1, _kcc_xf_nostdinc@@PAGE
    add  x1, x1, _kcc_xf_nostdinc@@PAGEOFF
    mov  x2, #9                    // "-nostdinc"
    bl _kcc_memcmp
    cbz x0, .Lxf_yes
    mov x0, #0
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
.Lxf_yes:
    mov x0, #1
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_driver_xflag
@}

@d Driver: compile @{
// -- kcc_driver_skipopt -------------------------------------------------------
// uint64_t kcc_driver_skipopt(const char *arg)
//   1 if arg is a code-model / red-zone / tuning flag to skip as a non-source
//   option (mflag may exit for an unsupported code model); 0 otherwise.
.text
.p2align 2
.globl _kcc_driver_skipopt
_kcc_driver_skipopt:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]
    mov x19, x0
    bl _kcc_driver_mflag
    cbnz x0, .Lso_yes
    mov x0, x19
    bl _kcc_driver_xflag
    cbnz x0, .Lso_yes
    mov x0, #0
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
.Lso_yes:
    mov x0, #1
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_driver_skipopt
@}

@d Driver: compile @{
// -- kcc_driver_obj_name ------------------------------------------------------
// char *kcc_driver_obj_name(const char *src)
//   x0 = source path → arena path with ".c" rewritten to ".o"
.text
.globl _kcc_driver_obj_name
.p2align 2
_kcc_driver_obj_name:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    mov x19, x0                    // src
    bl _kcc_strlen
    mov x20, x0                    // len

    add x0, x20, #3                // len + ".o" + null
    bl _kcc_arena_alloc
    mov x21, x0                    // dst

    mov x0, x21
    mov x1, x19
    mov x2, x20
    bl _kcc_memcpy

    // ".c" suffix? (len >= 2, src[len-2]=='.', src[len-1]=='c')
    cmp x20, #2
    b.lt .Lobj_append
    sub x2, x20, #2
    ldrb w3, [x19, x2]
    cmp w3, #'.'
    b.ne .Lobj_append
    sub x2, x20, #1
    ldrb w3, [x19, x2]
    cmp w3, #'c'
    b.ne .Lobj_append

    // Rewrite the trailing 'c' to 'o'
    sub x2, x20, #1
    mov w3, #'o'
    strb w3, [x21, x2]             // dst[len-1] = 'o'
    strb wzr, [x21, x20]           // null at len
    mov x0, x21
    b .Lobj_done

.Lobj_append:
    mov w3, #'.'
    strb w3, [x21, x20]
    add x2, x20, #1
    mov w3, #'o'
    strb w3, [x21, x2]
    add x2, x20, #2
    strb wzr, [x21, x2]
    mov x0, x21

.Lobj_done:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

// -- kcc_driver_compile_all ---------------------------------------------------
// void kcc_driver_compile_all(int argc, char **argv)
//   x0 = argc, x1 = argv.  Handles "-c": compiles every source argument
//   (argv[2..]) to an object file, honouring "-o <file>" only when there is
//   exactly one source.  Exits 0 if all compiles succeed, else 1.
.text
.globl _kcc_driver_compile_all
.p2align 2
_kcc_driver_compile_all:
    stp x29, x30, [sp, #-96]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    str x25, [sp, #64]

    mov x19, x0                    // argc
    mov x20, x1                    // argv

    // Pass 1: locate an explicit "-o <out>" and count source files.  Scan from
    // argv[1]: `-c` may sit anywhere (gcc/Kbuild ordering), so it is skipped as
    // an option rather than assumed to be argv[1].
    mov x21, #0                    // explicit out (0 = none)
    mov x22, #0                    // source count
    mov x23, #1                    // i = 1
.Lca_scan:
    cmp x23, x19
    b.ge .Lca_scan_done
    ldr x0, [x20, x23, lsl #3]     // argv[i]
    adrp x1, _kcc_opt_compile@@PAGE
    add  x1, x1, _kcc_opt_compile@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lca_scan_skipc
    ldr x0, [x20, x23, lsl #3]     // argv[i]
    adrp x1, _kcc_opt_wall@@PAGE
    add  x1, x1, _kcc_opt_wall@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lca_scan_wall
    ldr x0, [x20, x23, lsl #3]     // argv[i]
    adrp x1, _kcc_opt_emitasm@@PAGE
    add  x1, x1, _kcc_opt_emitasm@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lca_scan_emitasm
    ldr x0, [x20, x23, lsl #3]     // argv[i]
    adrp x1, _kcc_opt_target_x86@@PAGE
    add  x1, x1, _kcc_opt_target_x86@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lca_scan_target
    ldr x0, [x20, x23, lsl #3]     // argv[i]
    adrp x1, _kcc_opt_target_linux@@PAGE
    add  x1, x1, _kcc_opt_target_linux@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lca_scan_target_linux
    ldr x0, [x20, x23, lsl #3]     // argv[i]
    adrp x1, _kcc_opt_g@@PAGE
    add  x1, x1, _kcc_opt_g@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lca_scan_g
    ldr x0, [x20, x23, lsl #3]     // argv[i]
    adrp x1, _kcc_opt_o@@PAGE
    add  x1, x1, _kcc_opt_o@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lca_scan_o
    // -Idir / -I dir: register the include directory; not a source
    ldr x0, [x20, x23, lsl #3]     // argv[i]
    add x1, x23, #1
    cmp x1, x19
    b.ge .Lca_scan_I_nonext
    ldr x1, [x20, x1, lsl #3]      // argv[i+1]
    b .Lca_scan_I_call
.Lca_scan_I_nonext:
    mov x1, #0
.Lca_scan_I_call:
    mov x2, #1                     // register the directory
    bl _kcc_driver_I
    cbz x0, .Lca_scan_D
    add x23, x23, x0               // consumed 1 or 2 slots
    b .Lca_scan
.Lca_scan_D:
    // -DNAME[=VALUE] / -D NAME: record a command-line macro; not a source
    ldr x0, [x20, x23, lsl #3]     // argv[i]
    add x1, x23, #1
    cmp x1, x19
    b.ge .Lca_scan_D_nonext
    ldr x1, [x20, x1, lsl #3]      // argv[i+1]
    b .Lca_scan_D_call
.Lca_scan_D_nonext:
    mov x1, #0
.Lca_scan_D_call:
    mov x2, #1                     // register the macro
    bl _kcc_driver_D
    cbz x0, .Lca_scan_m
    add x23, x23, x0
    b .Lca_scan
.Lca_scan_m:
    // code-model / red-zone / tuning flag (-mcmodel=, -O2, -f*, ...): not a source
    ldr x0, [x20, x23, lsl #3]
    bl _kcc_driver_skipopt
    cbz x0, .Lca_scan_src
    add x23, x23, #1
    b .Lca_scan
.Lca_scan_src:
    add x22, x22, #1               // a source
    add x23, x23, #1
    b .Lca_scan
.Lca_scan_skipc:
    // "-c": the compile-only selector; consumed here so it is not mistaken for a
    // source file when it appears among the flags (gcc/Kbuild ordering).
    add x23, x23, #1
    b .Lca_scan
.Lca_scan_wall:
    // "-Wall": enable the warning family; not a source
    adrp x0, _kcc_warn_all@@PAGE
    add  x0, x0, _kcc_warn_all@@PAGEOFF
    mov  x1, #1
    str  x1, [x0]
    add x23, x23, #1
    b .Lca_scan
.Lca_scan_g:
    // "-g": emit DWARF debug info; not a source
    adrp x0, _kcc_dwarf_enabled@@PAGE
    add  x0, x0, _kcc_dwarf_enabled@@PAGEOFF
    mov  x1, #1
    str  x1, [x0]
    add x23, x23, #1
    b .Lca_scan
.Lca_scan_emitasm:
    // "--emit-asm": produce the object through the `.s` + `as` back end
    adrp x0, _kcc_emit_asm@@PAGE
    add  x0, x0, _kcc_emit_asm@@PAGEOFF
    mov  x1, #1
    str  x1, [x0]
    add x23, x23, #1
    b .Lca_scan
.Lca_scan_target:
    // "--target=x86_64": select the x86-64 back end; not a source
    adrp x0, _kcc_target@@PAGE
    add  x0, x0, _kcc_target@@PAGEOFF
    mov  x1, #1
    str  x1, [x0]
    add x23, x23, #1
    b .Lca_scan
.Lca_scan_target_linux:
    // "--target=x86_64-linux": x86-64 back end in its Linux/ELF flavour.
    adrp x0, _kcc_target@@PAGE
    add  x0, x0, _kcc_target@@PAGEOFF
    mov  x1, #1
    str  x1, [x0]
    adrp x0, _kcc_x86_os@@PAGE
    add  x0, x0, _kcc_x86_os@@PAGEOFF
    mov  x1, #1
    str  x1, [x0]
    add x23, x23, #1
    b .Lca_scan
.Lca_scan_o:
    add x23, x23, #1               // step to the -o value
    cmp x23, x19
    b.ge .Lca_scan_done
    ldr x21, [x20, x23, lsl #3]    // explicit out
    add x23, x23, #1
    b .Lca_scan
.Lca_scan_done:
    cbz x22, .Lca_no_input

    // Pass 2: compile each source.  Scan from argv[1] and skip `-c` wherever it
    // sits, mirroring pass 1.
    mov x24, #0                    // error accumulator
    mov x23, #1
.Lca_loop:
    cmp x23, x19
    b.ge .Lca_finish
    ldr x25, [x20, x23, lsl #3]    // argv[i]
    mov x0, x25
    adrp x1, _kcc_opt_compile@@PAGE
    add  x1, x1, _kcc_opt_compile@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lca_skip_wall         // "-c": the compile-only selector, skip
    mov x0, x25
    adrp x1, _kcc_opt_wall@@PAGE
    add  x1, x1, _kcc_opt_wall@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lca_skip_wall
    mov x0, x25
    adrp x1, _kcc_opt_g@@PAGE
    add  x1, x1, _kcc_opt_g@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lca_skip_wall         // -g: same as -Wall, skip (already handled)
    mov x0, x25
    adrp x1, _kcc_opt_emitasm@@PAGE
    add  x1, x1, _kcc_opt_emitasm@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lca_skip_wall         // --emit-asm: handled in pass 1
    mov x0, x25
    adrp x1, _kcc_opt_target_x86@@PAGE
    add  x1, x1, _kcc_opt_target_x86@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lca_skip_wall         // --target=x86_64: handled in pass 1
    mov x0, x25
    adrp x1, _kcc_opt_target_linux@@PAGE
    add  x1, x1, _kcc_opt_target_linux@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lca_skip_wall         // --target=x86_64-linux: handled in pass 1
    mov x0, x25
    adrp x1, _kcc_opt_o@@PAGE
    add  x1, x1, _kcc_opt_o@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lca_skip_o
    // -Idir / -I dir: skip (registered in pass 1)
    mov x0, x25
    mov x1, #0
    mov x2, #0                     // do not register again
    bl _kcc_driver_I
    cbz x0, .Lca_skip_D
    add x23, x23, x0
    b .Lca_loop
.Lca_skip_D:
    // -DNAME / -D NAME: skip (recorded in pass 1)
    mov x0, x25
    mov x1, #0
    mov x2, #0
    bl _kcc_driver_D
    cbz x0, .Lca_loop_m
    add x23, x23, x0
    b .Lca_loop
.Lca_loop_m:
    // code-model / red-zone / tuning flag: honoured in pass 1, skip here
    mov x0, x25
    bl _kcc_driver_skipopt
    cbz x0, .Lca_compile_src
    add x23, x23, #1
    b .Lca_loop
.Lca_compile_src:

    // Output name: explicit only when there is a single source
    cmp x22, #1
    b.ne .Lca_derive
    cbz x21, .Lca_derive
    mov x0, x21
    b .Lca_have_out
.Lca_derive:
    mov x0, x25
    bl _kcc_driver_obj_name
.Lca_have_out:
    mov x1, x0                     // out
    mov x0, x25                    // src
    bl _kcc_driver_compile
    orr x24, x24, x0               // remember any failure
    add x23, x23, #1
    b .Lca_loop
.Lca_skip_o:
    add x23, x23, #2               // skip "-o" and its value
    b .Lca_loop
.Lca_skip_wall:
    add x23, x23, #1               // skip "-Wall" (already handled in pass 1)
    b .Lca_loop

.Lca_finish:
    bl _kcc_io_flush
    mov x0, x24
    bl _kcc_sys_exit

.Lca_no_input:
    adrp x0, _kcc_driver_err_noinput@@PAGE
    add  x0, x0, _kcc_driver_err_noinput@@PAGEOFF
    bl _kcc_io_err
    mov x0, #1
    bl _kcc_sys_exit
@| _kcc_driver_obj_name
@| _kcc_driver_compile_all
@}

\section{Automatic Linking}
\label{sec:auto-linking}

Invoked without \texttt{-c}, \kcc{} behaves like a normal compiler driver: it
compiles every source argument to a temporary object file and then links those
objects into an executable, so \texttt{kcc hello.c -o hello} produces a runnable
program in one step.  Linking is delegated to the system linker
\texttt{/usr/bin/ld}, run as a child process (Chapter~\ref{ch:syscalls}
supplies \texttt{fork}/\texttt{execve}/\texttt{wait4}).  Because \kcc{}-compiled
programs are freestanding---their entry point is \texttt{\_main}, with no C
runtime start-up---the link line is
\texttt{ld \\meta{objects} -o \\meta{out} -lSystem -syslibroot \\meta{sdk}
-arch \\meta{arch} -e \_main}.  The architecture follows the selected target:
\texttt{arm64} by default, or \texttt{x86\_64} under \texttt{-{}-target=x86\_64}
(link mode's pre-scan sets \texttt{\_kcc\_target} exactly as the compile-mode
scan does, and each source is then compiled through the same target dispatch, so
\texttt{kcc -{}-target=x86\_64 hello.c -o hello} both compiles and links for
x86-64 in one step).  The SDK root needed by \texttt{-syslibroot} is found from
\texttt{\$SDKROOT} or, failing that, the two standard SDK locations.  After a
successful link the intermediate object files are removed.

Not every non-option argument is a source.  As the driver scans the command
line it classifies each one: a name ending in \texttt{.c} is compiled to a
temporary object; a leading \texttt{-} is an unrecognised linker flag
(\texttt{-lm}, \texttt{-Lpath}, \texttt{-framework}) forwarded verbatim so
\texttt{ld} sees it in order; and anything else---most importantly a
pre-compiled \texttt{.o} or a \texttt{.a} archive---is handed straight to the
linker.  This is what lets \texttt{kcc main.c libfoo.o -o app} mix sources and
objects in one invocation, rather than trying to \emph{compile} the object and
choking on its binary contents.  Only the objects kcc compiled itself are
tracked in a temp-object list and removed afterwards; a \texttt{.o} supplied by
the user is left untouched.

Because this path compiles each source inline as it scans the arguments, it
first makes a preliminary pass to honour \texttt{-Wall} and \texttt{-g}
wherever they appear, so a warning or debug-info request applies to every
source regardless of its position on the command line; the compile pass then
skips those flags rather than mistaking them for source files.

@d Driver: link @{
// -- kcc_getenv ---------------------------------------------------------------
// char *kcc_getenv(const char *name, uint64_t namelen)
//   Returns the value (text after '=') of environment variable name, or 0.
.text
.globl _kcc_getenv
.p2align 2
_kcc_getenv:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    mov x19, x0                  // name
    mov x20, x1                  // namelen
    adrp x0, _kcc_envp@@PAGE
    add  x0, x0, _kcc_envp@@PAGEOFF
    ldr x21, [x0]                // envp
    cbz x21, .Lge_none
.Lge_loop:
    ldr x22, [x21]               // entry
    cbz x22, .Lge_none
    mov x0, x22
    mov x1, x19
    mov x2, x20
    bl _kcc_memcmp
    cbnz x0, .Lge_next
    ldrb w0, [x22, x20]          // entry[namelen] == '=' ?
    cmp w0, #'='
    b.ne .Lge_next
    add x0, x22, x20
    add x0, x0, #1               // value = entry + namelen + 1
    b .Lge_ret
.Lge_next:
    add x21, x21, #8
    b .Lge_loop
.Lge_none:
    mov x0, #0
.Lge_ret:
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

// -- kcc_dir_exists -----------------------------------------------------------
// int kcc_dir_exists(const char *path) — 1 if it can be opened, else 0.
.text
.globl _kcc_dir_exists
.p2align 2
_kcc_dir_exists:
    stp x29, x30, [sp, #-16]!
    mov x29, sp
    mov x1, #0                   // O_RDONLY
    mov x2, #0
    bl _kcc_sys_open
    cmp x0, #0
    b.lt .Lde_no
    bl _kcc_sys_close
    mov x0, #1
    b .Lde_ret
.Lde_no:
    mov x0, #0
.Lde_ret:
    ldp x29, x30, [sp], #16
    ret

// -- kcc_driver_sdkroot -------------------------------------------------------
// char *kcc_driver_sdkroot(void) — SDK path for `ld -syslibroot`.
.text
.globl _kcc_driver_sdkroot
.p2align 2
_kcc_driver_sdkroot:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]
    // 1. $SDKROOT if set and openable
    adrp x0, _kcc_str_sdkroot_env@@PAGE
    add  x0, x0, _kcc_str_sdkroot_env@@PAGEOFF
    mov x1, #7
    bl _kcc_getenv
    cbz x0, .Lsr_clt
    mov x19, x0
    bl _kcc_dir_exists
    cbnz x0, .Lsr_use
    // 2. Command Line Tools SDK
.Lsr_clt:
    adrp x19, _kcc_str_sdk_clt@@PAGE
    add  x19, x19, _kcc_str_sdk_clt@@PAGEOFF
    mov x0, x19
    bl _kcc_dir_exists
    cbnz x0, .Lsr_use
    // 3. Xcode SDK
    adrp x19, _kcc_str_sdk_xcode@@PAGE
    add  x19, x19, _kcc_str_sdk_xcode@@PAGEOFF
    mov x0, x19
    bl _kcc_dir_exists
    cbnz x0, .Lsr_use
    // 4. fall back to the CLT path unconditionally
    adrp x19, _kcc_str_sdk_clt@@PAGE
    add  x19, x19, _kcc_str_sdk_clt@@PAGEOFF
.Lsr_use:
    mov x0, x19
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- kcc_driver_spawn ---------------------------------------------------------
// int kcc_driver_spawn(const char *path, char *const argv[])
//   fork+execve+wait4; returns the child's exit status (or -1 on fork error).
.text
.globl _kcc_driver_spawn
.p2align 2
_kcc_driver_spawn:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]
    mov x19, x0                  // path
    mov x20, x1                  // argv
    bl _kcc_sys_fork
    cbz x0, .Lsp_child
    cmp x0, #0
    b.lt .Lsp_err
    mov x21, x0                  // child pid
    add x1, sp, #40             // &status
    mov x0, x21
    mov x2, #0
    mov x3, #0
    bl _kcc_sys_wait4
    ldr w0, [sp, #40]           // status
    lsr w0, w0, #8              // WEXITSTATUS
    and w0, w0, #0xff
    b .Lsp_ret
.Lsp_child:
    mov x0, x19                  // path
    mov x1, x20                  // argv
    adrp x2, _kcc_envp@@PAGE
    add  x2, x2, _kcc_envp@@PAGEOFF
    ldr x2, [x2]                 // envp
    bl _kcc_sys_execve
    mov x0, #127                 // exec failed
    bl _kcc_sys_exit
.Lsp_err:
    mov x0, #-1
.Lsp_ret:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret

// -- kcc_driver_link_all ------------------------------------------------------
// void kcc_driver_link_all(int argc, char **argv)
//   Compile every source argument to a .o, link them into an executable
//   (output from "-o" or "a.out"), remove the objects, and exit with the
//   linker's status.
.text
.globl _kcc_driver_link_all
.p2align 2
_kcc_driver_link_all:
    stp x29, x30, [sp, #-112]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    stp x25, x26, [sp, #64]
    str x27, [sp, #80]
    mov x19, x0                  // argc
    mov x20, x1                  // argv
    // [sp,#88] = temp-object list (compiled .c → .o names to unlink after the
    // link), [sp,#96] = its count.  Only these are removed; a .o handed to us
    // on the command line is the user's and must survive.

    // Pass 1: honour -Wall and -g wherever they appear on the command line,
    // so every source is compiled with them active regardless of position
    // (the compile-and-link loop below processes sources inline, in one pass).
    mov x21, #1
.Lla_pre:
    cmp x21, x19
    b.ge .Lla_pre_done
    ldr x0, [x20, x21, lsl #3]
    adrp x1, _kcc_opt_wall@@PAGE
    add  x1, x1, _kcc_opt_wall@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lla_pre_wall
    ldr x0, [x20, x21, lsl #3]
    adrp x1, _kcc_opt_emitasm@@PAGE
    add  x1, x1, _kcc_opt_emitasm@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lla_pre_emitasm
    ldr x0, [x20, x21, lsl #3]
    adrp x1, _kcc_opt_target_x86@@PAGE
    add  x1, x1, _kcc_opt_target_x86@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lla_pre_target
    ldr x0, [x20, x21, lsl #3]
    adrp x1, _kcc_opt_g@@PAGE
    add  x1, x1, _kcc_opt_g@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lla_pre_g
    // -Idir / -I dir: register the include directory
    ldr x0, [x20, x21, lsl #3]
    add x1, x21, #1
    cmp x1, x19
    b.ge .Lla_pre_I_nonext
    ldr x1, [x20, x1, lsl #3]
    b .Lla_pre_I_call
.Lla_pre_I_nonext:
    mov x1, #0
.Lla_pre_I_call:
    mov x2, #1                   // register the directory
    bl _kcc_driver_I
    cbz x0, .Lla_pre_D
    add x21, x21, x0
    b .Lla_pre
.Lla_pre_D:
    // -DNAME[=VALUE] / -D NAME: record a command-line macro
    ldr x0, [x20, x21, lsl #3]
    add x1, x21, #1
    cmp x1, x19
    b.ge .Lla_pre_D_nonext
    ldr x1, [x20, x1, lsl #3]
    b .Lla_pre_D_call
.Lla_pre_D_nonext:
    mov x1, #0
.Lla_pre_D_call:
    mov x2, #1
    bl _kcc_driver_D
    cbz x0, .Lla_pre_m
    add x21, x21, x0
    b .Lla_pre
.Lla_pre_m:
    // code-model / red-zone / tuning flag: honoured as a no-op
    ldr x0, [x20, x21, lsl #3]
    bl _kcc_driver_skipopt
    cbz x0, .Lla_pre_next
    add x21, x21, #1
    b .Lla_pre
.Lla_pre_next:
    add x21, x21, #1
    b .Lla_pre
.Lla_pre_wall:
    adrp x0, _kcc_warn_all@@PAGE
    add  x0, x0, _kcc_warn_all@@PAGEOFF
    mov  x1, #1
    str  x1, [x0]
    add x21, x21, #1
    b .Lla_pre
.Lla_pre_g:
    adrp x0, _kcc_dwarf_enabled@@PAGE
    add  x0, x0, _kcc_dwarf_enabled@@PAGEOFF
    mov  x1, #1
    str  x1, [x0]
    add x21, x21, #1
    b .Lla_pre
.Lla_pre_emitasm:
    adrp x0, _kcc_emit_asm@@PAGE
    add  x0, x0, _kcc_emit_asm@@PAGEOFF
    mov  x1, #1
    str  x1, [x0]
    add x21, x21, #1
    b .Lla_pre
.Lla_pre_target:
    // "--target=x86_64": select the x86-64 back end for both compilation and
    // the final link (which then passes `-arch x86_64` to ld).
    adrp x0, _kcc_target@@PAGE
    add  x0, x0, _kcc_target@@PAGEOFF
    mov  x1, #1
    str  x1, [x0]
    add x21, x21, #1
    b .Lla_pre
.Lla_pre_done:

    // Linker argv: at most argc + 12 pointers.
    add x0, x19, #12
    lsl x0, x0, #3
    bl _kcc_arena_alloc
    mov x21, x0                  // larg

    // Temp-object list: at most one per argument.
    add x0, x19, #1
    lsl x0, x0, #3
    bl _kcc_arena_alloc
    str x0, [sp, #88]           // temp-object array
    str xzr, [sp, #96]          // temp-object count

    adrp x0, _kcc_str_ld_argv0@@PAGE
    add  x0, x0, _kcc_str_ld_argv0@@PAGEOFF
    str x0, [x21]                // larg[0] = "ld"
    mov x22, #1                  // k (next larg slot)
    mov x23, #0                  // output (0 = default)
    mov x24, #1                  // scan index (from argv[1])
    mov x25, #0                  // compile-error accumulator
    mov x26, #0                  // source count

.Lla_loop:
    cmp x24, x19
    b.ge .Lla_link
    ldr x27, [x20, x24, lsl #3]  // argv[i]
    mov x0, x27
    adrp x1, _kcc_opt_o@@PAGE
    add  x1, x1, _kcc_opt_o@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lla_o
    // -Wall / -g were consumed in pass 1; skip them here (not source files).
    mov x0, x27
    adrp x1, _kcc_opt_wall@@PAGE
    add  x1, x1, _kcc_opt_wall@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lla_skipopt
    mov x0, x27
    adrp x1, _kcc_opt_g@@PAGE
    add  x1, x1, _kcc_opt_g@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lla_skipopt
    mov x0, x27
    adrp x1, _kcc_opt_emitasm@@PAGE
    add  x1, x1, _kcc_opt_emitasm@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lla_skipopt           // --emit-asm: handled in pass 1
    mov x0, x27
    adrp x1, _kcc_opt_target_x86@@PAGE
    add  x1, x1, _kcc_opt_target_x86@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lla_skipopt           // --target=x86_64: handled in pass 1
    // -Idir / -I dir: skip (registered in pass 1)
    mov x0, x27
    mov x1, #0
    mov x2, #0                   // do not register again
    bl _kcc_driver_I
    cbz x0, .Lla_skip_D
    add x24, x24, x0
    b .Lla_loop
.Lla_skip_D:
    // -DNAME / -D NAME: skip (recorded in pass 1)
    mov x0, x27
    mov x1, #0
    mov x2, #0
    bl _kcc_driver_D
    cbz x0, .Lla_m
    add x24, x24, x0
    b .Lla_loop
.Lla_m:
    // code-model / red-zone / tuning flag: consumed so it is not forwarded to ld
    mov x0, x27
    bl _kcc_driver_skipopt
    cbz x0, .Lla_src
    add x24, x24, #1
    b .Lla_loop
.Lla_src:
    // Classify a non-option argument.  A leading '-' is an unrecognised linker
    // flag (e.g. -lm, -Lpath, -framework): forward it verbatim so ld sees it in
    // order.  A ".c" file is compiled to a temporary object.  Anything else
    // (".o", ".a", or another file) is handed straight to the linker.
    ldrb w0, [x27]
    cmp w0, #'-'
    b.eq .Lla_passthru
    mov x0, x27
    bl _kcc_strlen
    cmp x0, #2
    b.lt .Lla_object             // too short for "x.c" → treat as a linker input
    add x1, x27, x0
    ldrh w2, [x1, #-2]           // last two bytes, little-endian: 'c'<<8 | '.'
    mov w3, #0x632E              // ".c"
    cmp w2, w3
    b.ne .Lla_object

    // A ".c" source: compile it to a temporary object and record that object
    // both for the linker (larg) and for later removal (temp-object list).
    mov x0, x27
    bl _kcc_driver_obj_name
    str x0, [x21, x22, lsl #3]   // larg[k] = obj name
    ldr x1, [sp, #88]           // temp-object array
    ldr x2, [sp, #96]           // temp-object count
    str x0, [x1, x2, lsl #3]
    add x2, x2, #1
    str x2, [sp, #96]
    mov x1, x0                    // out
    mov x0, x27                   // src
    bl _kcc_driver_compile
    orr x25, x25, x0
    add x22, x22, #1
    add x26, x26, #1              // a file input
    add x24, x24, #1
    b .Lla_loop
.Lla_object:
    // A pre-compiled object / archive / other file: pass to the linker as-is.
    str x27, [x21, x22, lsl #3]
    add x22, x22, #1
    add x26, x26, #1              // a file input
    add x24, x24, #1
    b .Lla_loop
.Lla_passthru:
    // An unrecognised linker flag: forward it without counting it as an input.
    str x27, [x21, x22, lsl #3]
    add x22, x22, #1
    add x24, x24, #1
    b .Lla_loop
.Lla_skipopt:
    add x24, x24, #1
    b .Lla_loop
.Lla_o:
    add x24, x24, #1
    cmp x24, x19
    b.ge .Lla_link
    ldr x23, [x20, x24, lsl #3]   // output name
    add x24, x24, #1
    b .Lla_loop

.Lla_link:
    cbnz x25, .Lla_fail          // a compile failed → do not link
    cbz x26, .Lla_noinput

    cbnz x23, .Lla_out_ok
    adrp x23, _kcc_str_aout@@PAGE
    add  x23, x23, _kcc_str_aout@@PAGEOFF
.Lla_out_ok:
    // Append: -o <out> -lSystem -syslibroot <sdk> -arch arm64 -e _main NULL
    adrp x0, _kcc_opt_o@@PAGE
    add  x0, x0, _kcc_opt_o@@PAGEOFF
    str x0, [x21, x22, lsl #3]
    add x22, x22, #1
    str x23, [x21, x22, lsl #3]
    add x22, x22, #1
    adrp x0, _kcc_str_lsystem@@PAGE
    add  x0, x0, _kcc_str_lsystem@@PAGEOFF
    str x0, [x21, x22, lsl #3]
    add x22, x22, #1
    adrp x0, _kcc_str_syslibroot@@PAGE
    add  x0, x0, _kcc_str_syslibroot@@PAGEOFF
    str x0, [x21, x22, lsl #3]
    add x22, x22, #1
    bl _kcc_driver_sdkroot
    str x0, [x21, x22, lsl #3]
    add x22, x22, #1
    adrp x0, _kcc_str_arch@@PAGE
    add  x0, x0, _kcc_str_arch@@PAGEOFF
    str x0, [x21, x22, lsl #3]
    add x22, x22, #1
    // Architecture: "x86_64" under --target=x86_64, else the native "arm64".
    adrp x0, _kcc_target@@PAGE
    add  x0, x0, _kcc_target@@PAGEOFF
    ldr x0, [x0]
    cbz x0, .Lla_arch_arm64
    adrp x0, _kcc_str_x86_64@@PAGE
    add  x0, x0, _kcc_str_x86_64@@PAGEOFF
    b .Lla_arch_set
.Lla_arch_arm64:
    adrp x0, _kcc_str_arm64@@PAGE
    add  x0, x0, _kcc_str_arm64@@PAGEOFF
.Lla_arch_set:
    str x0, [x21, x22, lsl #3]
    add x22, x22, #1
    adrp x0, _kcc_str_dash_e@@PAGE
    add  x0, x0, _kcc_str_dash_e@@PAGEOFF
    str x0, [x21, x22, lsl #3]
    add x22, x22, #1
    adrp x0, _kcc_str_umain@@PAGE
    add  x0, x0, _kcc_str_umain@@PAGEOFF
    str x0, [x21, x22, lsl #3]
    add x22, x22, #1
    str xzr, [x21, x22, lsl #3]   // NULL terminator

    bl _kcc_io_flush              // flush before fork

    adrp x0, _kcc_str_ld_path@@PAGE
    add  x0, x0, _kcc_str_ld_path@@PAGEOFF
    mov x1, x21
    bl _kcc_driver_spawn
    mov x25, x0                    // link status

    // Remove only the objects we compiled ourselves (the temp-object list);
    // a .o passed in on the command line belongs to the user and is left alone.
    ldr x21, [sp, #88]          // temp-object array
    ldr x26, [sp, #96]          // temp-object count
    mov x24, #0
.Lla_unlink:
    cmp x24, x26
    b.ge .Lla_done
    ldr x0, [x21, x24, lsl #3]
    bl _kcc_sys_unlink
    add x24, x24, #1
    b .Lla_unlink
.Lla_done:
    bl _kcc_io_flush
    mov x0, x25
    bl _kcc_sys_exit

.Lla_fail:
    bl _kcc_io_flush
    mov x0, #1
    bl _kcc_sys_exit

.Lla_noinput:
    adrp x0, _kcc_driver_err_noinput@@PAGE
    add  x0, x0, _kcc_driver_err_noinput@@PAGEOFF
    bl _kcc_io_err
    mov x0, #1
    bl _kcc_sys_exit
@| _kcc_getenv _kcc_dir_exists _kcc_driver_sdkroot _kcc_driver_spawn _kcc_driver_link_all
@}

@d Driver: data @{
// -- Driver string constants --------------------------------------------------
.section __TEXT,__cstring,cstring_literals
.globl _kcc_opt_compile
_kcc_opt_compile:
    .asciz "-c"
_kcc_opt_o:
    .asciz "-o"
_kcc_opt_wall:
    .asciz "-Wall"
_kcc_opt_g:
    .asciz "-g"
_kcc_opt_incdir:
    .asciz "-I"
_kcc_opt_defmac:
    .asciz "-D"
_kcc_opt_emitasm:
    .asciz "--emit-asm"
_kcc_opt_target_x86:
    .asciz "--target=x86_64"
_kcc_opt_target_linux:
    .asciz "--target=x86_64-linux"
_kcc_opt_mcmodel:
    .asciz "-mcmodel="
_kcc_opt_mnoredzone:
    .asciz "-mno-red-zone"
_kcc_opt_mredzone:
    .asciz "-mred-zone"
_kcc_str_cm_small:
    .asciz "small"
_kcc_str_cm_kernel:
    .asciz "kernel"
_kcc_driver_err_cmodel:
    .asciz "kcc: error: unsupported -mcmodel (only 'small' and 'kernel')\n"
_kcc_xf_dO:
    .asciz "-O"
_kcc_xf_df:
    .asciz "-f"
_kcc_xf_dW:
    .asciz "-W"
_kcc_xf_dm:
    .asciz "-m"
_kcc_xf_std:
    .asciz "-std="
_kcc_xf_pipe:
    .asciz "-pipe"
_kcc_xf_nostdinc:
    .asciz "-nostdinc"
_kcc_str_x86_64:
    .asciz "x86_64"
_kcc_str_as_argv0:
    .asciz "as"
_kcc_str_as_path:
    .asciz "/usr/bin/as"
_kcc_str_dot_s:
    .asciz ".s"
_kcc_driver_err_noinput:
    .asciz "kcc: error: no input files\n"
_kcc_str_ld_argv0:
    .asciz "ld"
_kcc_str_ld_path:
    .asciz "/usr/bin/ld"
_kcc_str_lsystem:
    .asciz "-lSystem"
_kcc_str_syslibroot:
    .asciz "-syslibroot"
_kcc_str_arch:
    .asciz "-arch"
_kcc_str_arm64:
    .asciz "arm64"
_kcc_str_dash_e:
    .asciz "-e"
_kcc_str_umain:
    .asciz "_main"
_kcc_str_aout:
    .asciz "a.out"
_kcc_str_sdkroot_env:
    .asciz "SDKROOT"
_kcc_str_sdk_clt:
    .asciz "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk"
_kcc_str_sdk_xcode:
    .asciz "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk"

.data
.p2align 3
.globl _kcc_envp
_kcc_envp:
    .quad 0
.globl _kcc_emit_asm
_kcc_emit_asm:               // 1 = produce the object via `.s` + `as` (--emit-asm)
    .quad 0
@| _kcc_envp
@}

\section{Multi-file Tests}

These tests split a program across two translation units that share
declarations through a prototype: one file defines the functions, the
other calls them.  A single \texttt{kcc~-c~a.c~b.c} compiles both, and
the system linker resolves the cross-object references---the end-to-end
shape a self-hosting build takes.

@d Test: codegen multifile @{
echo ""
echo "--- Multi-file Compilation ---"

run_test_multi "multi-two-units" \
    "int helper(int x){ return x * 10; }" \
    "int helper(int x); int main(void){ return helper(4) + 2; }" 42

run_test_multi "multi-extern-global" \
    "int total; void add(int n){ total = total + n; }" \
    "extern int total; void add(int n); int main(void){ add(5); add(7); return total; }" 12

run_test_multi "multi-mutual-call" \
    "int dbl(int x); int quad(int x){ return dbl(dbl(x)); }" \
    "int quad(int x); int dbl(int x){ return x + x; } int main(void){ return quad(6); }" 24
@}

\section{End-to-End Driver Tests}
\label{sec:e2e-tests}

Automatic linking (\S\ref{sec:auto-linking}) lets \kcc{} produce runnable
executables directly.  These tests drive the whole toolchain the way a user
would---\texttt{kcc src.c -o out} then run \texttt{out}---covering a single
file, the default \texttt{a.out} name, a multi-file link, a call into
\texttt{libSystem} (\texttt{printf}), and the propagation of a linker error.

@d E2E: runner @{
#!/bin/bash
# kcc end-to-end driver tests (compile + auto-link + run) — generated by weft
set -u
PASS=0
FAIL=0
KCC="tmp/kcc"
TMP="/tmp/kcc_e2e_$$"
mkdir -p "$TMP"
trap 'rm -rf "$TMP"' EXIT

# e2e name expected src...   (last-but-one is expected exit, rest are sources)
run_e2e() {
    local name="$1"; shift
    local expected="$1"; shift
    local srcs=() i=0
    for s in "$@@"; do printf '%s\n' "$s" > "$TMP/f$i.c"; srcs+=("$TMP/f$i.c"); i=$((i+1)); done
    "$KCC" "${srcs[@@]}" -o "$TMP/prog" >/dev/null 2>&1
    if [ ! -x "$TMP/prog" ]; then
        printf "  %-24s FAIL (no executable)\n" "$name"; FAIL=$((FAIL+1)); return
    fi
    "$TMP/prog" >/dev/null 2>&1
    local rc=$?
    rm -f "$TMP/prog"
    if [ "$rc" = "$expected" ]; then
        printf "  %-24s ok (%s)\n" "$name" "$rc"; PASS=$((PASS+1))
    else
        printf "  %-24s FAIL got=%s exp=%s\n" "$name" "$rc" "$expected"; FAIL=$((FAIL+1))
    fi
}

echo "=== end-to-end driver (compile + link + run) ==="
run_e2e "single-file" 42 "int main(void){ return 42; }"
run_e2e "arithmetic"  30 "int sq(int x){ return x*x; } int main(void){ return sq(5)+sq(2)+1; }"
run_e2e "two-units"   42 "int add(int a,int b){ return a+b; }" \
                         "int add(int,int); int main(void){ return add(20,22); }"
run_e2e "libsystem-printf" 7 "int printf(const char*,...); int main(void){ printf(\"kcc e2e ok\n\"); return 7; }"
run_e2e "header-stdlib-string" 5 "#include <stdlib.h>
#include <string.h>
int main(void){ char *p = malloc(16); strcpy(p, \"hello\"); int n = strlen(p); free(p); return n; }"
run_e2e "header-math" 7 "#include <math.h>
int main(void){ return (int) sqrt(49.0); }"
run_e2e "header-vararg-sprintf" 23 "#include <stdio.h>
#include <stdlib.h>
int main(void){ char buf[16]; sprintf(buf, \"%d\", 123); return atoi(buf) - 100; }"
run_e2e "header-std-streams" 9 "#include <stdio.h>
int main(void){ fprintf(stdout, \"out %d\n\", 1); fprintf(stderr, \"err %d\n\", 2); return 9; }"

# A missing symbol must make the driver fail (no executable, nonzero status).
printf 'int gone(void); int main(void){ return gone(); }\n' > "$TMP/bad.c"
$KCC "$TMP/bad.c" -o "$TMP/bad" >/dev/null 2>&1
if [ $? -ne 0 ] && [ ! -x "$TMP/bad" ]; then
    printf "  %-24s ok (rejected)\n" "link-error"; PASS=$((PASS+1))
else
    printf "  %-24s FAIL (should reject)\n" "link-error"; FAIL=$((FAIL+1))
fi

echo ""
echo "=== e2e: $PASS ok, $FAIL fail ==="
[ "$FAIL" -eq 0 ]
@}
