% 48x-self-hosting-emit-x86.weft — Stage 8y: the x86-64 back end, written in C,
% compiled by kcc itself, and linked back into the compiler.

\chapter{Self-Hosting: The x86-64 Back End in C}
\label{ch:self-hosting-emit-x86}

The second target's back end (Chapter~\ref{ch:emit-x86}) walks the same neutral
IR the ARM64 path consumes and prints x86-64 assembly text for the system
assembler.  Porting it to C completes \emph{both} back ends in kcc-compiled
C---the ARM64 encoder (Chapter~\ref{ch:self-hosting-emit-arm64}) and now the
x86-64 emitter.  The module is long but entirely mechanical: a family of small
helpers that append AT\&T text to the shared growable buffer
(\texttt{kcc\_as\_str}/\texttt{kcc\_as\_ch}/\texttt{kcc\_as\_dec}), a flat
opcode dispatch that routes each IR instruction to the right shape, an all-spill
frame, System~V argument marshalling, and the data-emission paths for globals,
static locals, read-only constants, and string literals.  A single flag,
\texttt{kcc\_x86\_os}, chooses Mach-O (Darwin) or ELF (Linux) directives.

Unlike the ARM64 suites, the code-generation and difftest corpora do not
exercise x86 selection (they target ARM64), so the port is verified
\emph{functionally}: a broad, opcode-exercising probe suite is compiled with
\texttt{--target=x86\_64} by the C emitter and run under Rosetta, and its exit
status must match the ARM64 reference.

\section{State, Constants, and the AT\&T Vocabulary}

@l c
@d Selfhost: emit_x86 preamble @{
void kcc_as_init(void);
void kcc_as_str(const char *s);
void kcc_as_ch(unsigned c);
void kcc_as_dec(unsigned long n);
int kcc_as_write_file(const char *path);
void *kcc_vec_init(unsigned long elemsize);
void kcc_vec_push(void *vec, const void *elem);
void *kcc_vec_get(void *vec, unsigned long i);
void *kcc_sema_resolve_type(void *node);
unsigned long kcc_type_layout(void *ty);
int kcc_strcmp(const char *a, const char *b);
void kcc_io_err(const char *s);
void kcc_io_flush(void);
void kcc_sys_exit(long code);
int kcc_global_const_rodata(void *decl);
int kcc_global_const_ptrarr(void *decl);
extern void *kcc_ir_static_decls;      /* every static-local decl (ir.c) */
unsigned long kcc_rodata_leaf_bits(void *node, unsigned long kind);
const char *kcc_ir_static_name(void *decl);
void *kcc_ht_init(unsigned long capacity);
unsigned long kcc_ht_get(void *ht, const void *key, unsigned long keylen);
void kcc_ht_put(void *ht, const void *key, unsigned long keylen, unsigned long value);
unsigned long kcc_strlen(const char *s);
/* Linkage-attribute side table populated by the parser (48t). */
struct AttrRec { unsigned long weak; const char *section; const char *alias; };
extern void *kcc_attr_ht;
static struct AttrRec *x86_attr(const char *name) {
    if (!kcc_attr_ht || !name) return 0;
    return (struct AttrRec *)kcc_ht_get(kcc_attr_ht, name, kcc_strlen(name));
}

extern void *kcc_ir_funcs;           /* vec of IR function pointers */
extern char kcc_str_modinit[];       /* "kcc.module_init" */
extern unsigned long kcc_modinit_present;

/* IR instruction / block / function / type / vec / AST field offsets */
#define IR_OP 0
#define IR_DEST 8
#define IR_SRC1 16
#define IR_SRC2 24
#define IR_TYPE 32
#define IR_NEXT 40
#define BB_ID 0
#define BB_FIRST 8
#define IRF_NAME 0
#define IRF_BLOCKS 16
#define IRF_VREG_N 24
#define IRF_PARAMS 40
#define IRF_PARAM_CLS 48
#define IRF_STATIC 72
#define IRF_VARIADIC 88
#define VEC_COUNT 8
#define TY_KIND 0
#define TY_SIZE 8
#define TY_F0 32
#define TY_VOID 1
#define TY_STRUCT 14
#define TY_ARRAY 12
#define TY_FUNC 13
#define TY_PTR 11
#define TY_FLOAT 8
#define TY_DOUBLE 9
#define AST_TAG 0
#define AST_COL 16
#define AST_F0 24
#define AST_F1 32
#define AST_F2 40
#define AST_F3 48
#define AST_F4 56

/* IR opcodes */
enum {
    IR_ADD=1, IR_SUB=2, IR_MUL=3, IR_SDIV=4, IR_UDIV=5, IR_SMOD=6, IR_UMOD=7,
    IR_NEG=8, IR_AND=10, IR_OR=11, IR_XOR=12, IR_SHL=13, IR_LSHR=14, IR_ASHR=15,
    IR_NOT=16, IR_CMP_EQ=20, IR_CMP_NE=21, IR_CMP_SLT=22, IR_CMP_SLE=23,
    IR_CMP_SGT=24, IR_CMP_SGE=25, IR_CMP_ULT=26, IR_CMP_ULE=27,
    IR_LOAD=30, IR_STORE=31, IR_ALLOCA=32, IR_GEP=33, IR_BR=40, IR_BR_COND=41,
    IR_RET=42, IR_CALL=43, IR_CALL_IND=44, IR_SEXT=50, IR_ZEXT=51, IR_TRUNC=52,
    IR_BITCAST=53, IR_SITOFP=54, IR_FPTOSI=55, IR_VA_START=56, IR_FPROUND=57, IR_UITOFP=58,
    IR_CONST=60, IR_NOP=61, IR_GLOBAL_REF=63, IR_STRING_LIT=64, IR_ASM=65,
    IR_LADDR=66, IR_BR_IND=67
};
/* AST tags used by the data/static walks */
enum {
    AST_VAR_DECL=10, AST_FUNC_DECL=11, AST_STR_LIT=52, AST_ASM_STMT=74, AST_COMPOUND=30, AST_IF_STMT=32,
    AST_SWITCH_STMT=33, AST_WHILE_STMT=34, AST_DO_STMT=35, AST_FOR_STMT=36,
    AST_CASE_STMT=42, AST_LABEL_STMT=41, AST_DEFAULT_STMT=43, AST_INIT_LIST=65,
    AST_IDENT_EXPR=50, AST_UNARY_EXPR=55
};

/* exported target-selection state (the driver sets these) */
unsigned long kcc_target = 0;        /* 0 = arm64/Mach-O, 1 = x86-64 */
void *kcc_x86_tu = 0;                /* AST translation unit (data emission) */
unsigned long kcc_x86_os = 0;        /* 0 = Darwin/Mach-O, 1 = Linux/ELF */
static unsigned long kcc_x86_vreg_n = 0;
static void *kcc_x86_strs = 0;
static unsigned long kcc_x86_rsa_top = 0;   /* rbp-relative top of the variadic register-save area */

#define S(name, str) static const char name[] = str
S(s_text, ".text\n"); S(s_globl, ".globl "); S(s_us, "_");
S(s_weak, ".weak "); S(s_section, ".section "); S(s_set, "\t.set "); S(s_prev, "\t.previous\n");
S(s_bss, ".bss\n"); S(s_ax, ",\"ax\",@@progbits\n"); S(s_aw, ",\"aw\"\n");
S(s_rodata, ".section .rodata\n"); S(s_comm, "\t.comm "); S(s_comm_a8, ",8\n");
S(s_local, "\t.local ");
S(s_modinit_d, ".section __DATA,__mod_init_func,mod_init_funcs\n\t.p2align 3\n\t.quad ");
