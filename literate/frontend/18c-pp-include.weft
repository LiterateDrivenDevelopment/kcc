@d Header: assert @{
#ifndef _ASSERT_H
#define _ASSERT_H
#define assert(x) ((void)0)
#endif
@}

The last two bridges show how cheap a new hosted header now is---each is a file
and nothing else.  \verb|<errno.h>| is the interesting case on this platform:
\texttt{errno} is not a global but a thread-local accessed through a function,
so the macro expands to \verb|(*__error())| and the bridge declares
\texttt{\_\_error} returning \texttt{int *}, exactly as \texttt{libSystem}
provides it; the \texttt{E*} constants carry the BSD values macOS uses.
\verb|<time.h>| gives \texttt{time\_t} (a \texttt{long}) and a \texttt{struct
tm} laid out to match the platform's, including the \texttt{tm\_gmtoff} and
\texttt{tm\_zone} tail fields so a program that reads them sees the real thing.

@d Header: time @{
#ifndef _TIME_H
#define _TIME_H
typedef long time_t;
typedef long clock_t;
struct tm {
    int tm_sec;
    int tm_min;
    int tm_hour;
    int tm_mday;
    int tm_mon;
    int tm_year;
    int tm_wday;
    int tm_yday;
    int tm_isdst;
    long tm_gmtoff;
    char *tm_zone;
};
time_t time(time_t *t);
double difftime(time_t end, time_t begin);
clock_t clock(void);
struct tm *localtime(time_t *t);
struct tm *gmtime(time_t *t);
time_t mktime(struct tm *tm);
char *asctime(struct tm *tm);
char *ctime(time_t *t);
unsigned long strftime(char *s, unsigned long max, char *fmt, struct tm *tm);
#define CLOCKS_PER_SEC 1000000
#endif
@}

@d Header: errno @{
#ifndef _ERRNO_H
#define _ERRNO_H
int *__error(void);
#define errno (*__error())
#define EPERM 1
#define ENOENT 2
#define ESRCH 3
#define EINTR 4
#define EIO 5
#define ENXIO 6
#define EBADF 9
#define ENOMEM 12
#define EACCES 13
#define EFAULT 14
#define EBUSY 16
#define EEXIST 17
#define ENOTDIR 20
#define EISDIR 21
#define EINVAL 22
#define ENOSPC 28
#define EPIPE 32
#define ERANGE 34
#endif
@}

The remaining hosted headers round out the C library surface.  None is required
of a freestanding compiler; each is a spare bridge to \texttt{libSystem}, added
because it costs only a file.  \verb|<inttypes.h>| pulls in \verb|<stdint.h>|
and adds the \texttt{PRI}/\texttt{SCN} format-string macros (the \texttt{ld}
family, since this is an LP64 target) with \texttt{imaxabs} and the
\texttt{strtoimax} pair.  \verb|<signal.h>| and \verb|<setjmp.h>| carry the
usual handlers; the \texttt{jmp\_buf} is generously sized so \texttt{setjmp}
never overruns it.  A caution on \verb|<setjmp.h>|: a non-\texttt{volatile}
local modified between \texttt{setjmp} and \texttt{longjmp} has an indeterminate
value after the long jump (\stdref{7.13.2.1})---the program must mark such
variables \texttt{volatile}, and kcc inserts no barrier of its own.
\verb|<locale.h>|, \verb|<fenv.h>|, and the wide-character trio
(\verb|<wchar.h>|, \verb|<wctype.h>|, \verb|<uchar.h>|) supply the platform
\texttt{struct}s and constants; \texttt{wint\_t} carries a private guard so the
wide headers compose without a duplicate typedef.

@d Header: inttypes @{
#ifndef _INTTYPES_H
#define _INTTYPES_H
#include <stdint.h>
typedef struct { long quot; long rem; } imaxdiv_t;
long imaxabs(long n);
imaxdiv_t imaxdiv(long num, long den);
long strtoimax(char *s, char **end, int base);
unsigned long strtoumax(char *s, char **end, int base);
#define PRId8  "d"
#define PRId16 "d"
#define PRId32 "d"
#define PRId64 "ld"
#define PRIi64 "li"
#define PRIu8  "u"
#define PRIu16 "u"
#define PRIu32 "u"
#define PRIu64 "lu"
#define PRIx64 "lx"
#define PRIX64 "lX"
#define PRIo64 "lo"
#define PRIdPTR "ld"
#define PRIuPTR "lu"
#define PRIxPTR "lx"
#endif
@}

@d Header: signal @{
#ifndef _SIGNAL_H
#define _SIGNAL_H
typedef int sig_atomic_t;
typedef void (*sig_handler_t)(int);
sig_handler_t signal(int sig, sig_handler_t handler);
int raise(int sig);
#define SIG_DFL ((sig_handler_t)0)
#define SIG_IGN ((sig_handler_t)1)
#define SIG_ERR ((sig_handler_t)-1)
#define SIGINT  2
#define SIGILL  4
#define SIGABRT 6
#define SIGFPE  8
#define SIGSEGV 11
#define SIGTERM 15
#endif
@}

@d Header: setjmp @{
#ifndef _SETJMP_H
#define _SETJMP_H
typedef long jmp_buf[48];
int setjmp(jmp_buf env);
void longjmp(jmp_buf env, int val);
#endif
@}

@d Header: locale @{
