% 25-types.weft — Type System
%
% This chapter implements the type system for kcc.  Every C type is
% represented by a 48-byte type descriptor, arena-allocated.  Basic types
% (void, int, char, etc.) are pre-allocated as singletons at init time.
% Derived types (pointer, array, function, struct, union, enum) are
% constructed on demand.

\chapter{Type System}
\label{ch:types}

Every C expression has a type, and the compiler must track these types to enforce the language's constraints and to determine the size, alignment, and representation of every object.  This chapter defines the type descriptor---a 48-byte arena-allocated record that encodes kind, size, alignment, and qualifiers---and builds the infrastructure around it.  We begin with the descriptor layout and the pre-allocated singletons for built-in types, then provide constructors for derived types (pointers, arrays, functions, structures, unions, and enumerations), predicate functions for querying type properties, a specifier resolver that converts the parser's bitmask into a canonical type, and a diagnostic dump for debugging.

\section{Type Descriptor Layout}

A type descriptor occupies 48 bytes with the following layout:

\begin{center}
\begin{tabular}{lll}
Offset & Field & Description \\
\hline
0  & TY\_KIND  & type kind constant \\
8  & TY\_SIZE  & size in bytes \\
16 & TY\_ALIGN & alignment in bytes \\
24 & TY\_QUALS & const=1, volatile=2, restrict=4, \_Atomic=8 \\
32 & TY\_F0    & kind-specific field 0 \\
40 & TY\_F1    & kind-specific field 1 \\
\end{tabular}
\end{center}

@d Types: constants @{
// -- Type descriptor layout -----------------------------------------------
.equ TY_KIND,       0
.equ TY_SIZE,       8
.equ TY_ALIGN,     16
.equ TY_QUALS,     24
.equ TY_F0,        32
.equ TY_F1,        40
.equ TY_DESC_SIZE, 48

// -- Type kind constants --------------------------------------------------
.equ TY_VOID,       1
.equ TY_BOOL,       2
.equ TY_CHAR,       3    // F0=signed(1)/unsigned(0)
.equ TY_SHORT,      4    // F0=signed(1)/unsigned(0)
.equ TY_INT,        5    // F0=signed(1)/unsigned(0)
.equ TY_LONG,       6    // F0=signed(1)/unsigned(0)
.equ TY_LLONG,      7    // F0=signed(1)/unsigned(0)
.equ TY_FLOAT,      8
.equ TY_DOUBLE,     9
.equ TY_LDOUBLE,   10
.equ TY_PTR,       11    // F0=pointee type descriptor
.equ TY_ARRAY,     12    // F0=element type, F1=length
.equ TY_FUNC,      13    // F0=return type, F1=param vec*
.equ TY_STRUCT,    14    // F0=struct_decl AST, F1=member vec*
.equ TY_UNION,     15    // F0=union_decl AST, F1=member vec*
.equ TY_ENUM,      16    // F0=enum_decl AST

// -- Specifier bitmask constants (from parser) ----------------------------
.equ SPEC_VOID,       (1 << 0)
.equ SPEC_CHAR,       (1 << 1)
.equ SPEC_SHORT,      (1 << 2)
.equ SPEC_INT,        (1 << 3)
.equ SPEC_LONG,       (1 << 4)
.equ SPEC_LLONG,      (1 << 5)
.equ SPEC_FLOAT,      (1 << 6)
.equ SPEC_DOUBLE,     (1 << 7)
.equ SPEC_SIGNED,     (1 << 8)
.equ SPEC_UNSIGNED,   (1 << 9)
.equ SPEC_BOOL,       (1 << 10)
.equ SPEC_COMPLEX,    (1 << 11)
@}

\section{Type Initialization}

Pre-allocate singleton descriptors for all basic types.

@d Types: init @{
// -- kcc_types_init --------------------------------------------------------
// void kcc_types_init(void)
// Pre-allocates singleton type descriptors for all basic types.
.text
.globl _kcc_types_init
.p2align 2
_kcc_types_init:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    // void
    mov x0, #TY_DESC_SIZE
    bl _kcc_arena_alloc
    mov x19, x0
    mov x1, #TY_VOID
    str x1, [x19, #TY_KIND]
    str xzr, [x19, #TY_SIZE]       // void has no size
    str xzr, [x19, #TY_ALIGN]
    str xzr, [x19, #TY_QUALS]
    str xzr, [x19, #TY_F0]
    str xzr, [x19, #TY_F1]
    adrp x1, _kcc_type_void@@PAGE
    add  x1, x1, _kcc_type_void@@PAGEOFF
    str x19, [x1]

    // _Bool
    mov x0, #TY_DESC_SIZE
    bl _kcc_arena_alloc
    mov x19, x0
    mov x1, #TY_BOOL
    str x1, [x19, #TY_KIND]
    mov x1, #1
    str x1, [x19, #TY_SIZE]
    str x1, [x19, #TY_ALIGN]
    str xzr, [x19, #TY_QUALS]
    str xzr, [x19, #TY_F0]
    str xzr, [x19, #TY_F1]
    adrp x1, _kcc_type_bool@@PAGE
    add  x1, x1, _kcc_type_bool@@PAGEOFF
    str x19, [x1]
@| _kcc_types_init
@}

\paragraph{Character and Integer Type Singletons}

The next block allocates singletons for every standard integer type, from
\texttt{char} through \texttt{long long}, each in both signed and unsigned
variants.  The C17 standard treats plain \texttt{char}, \texttt{signed char},
and \texttt{unsigned char} as three distinct types (\stdref{6.2.5p15}); our
implementation maps plain \texttt{char} to \texttt{signed char}, following the
default sign convention on Apple ARM64 targets.  Each descriptor stores its
signedness in \texttt{TY\_F0} (1 for signed, 0 for unsigned) so that later
stages can select the correct conversion and promotion rules.

@d Types: init @{
    // signed char
    mov x0, #TY_DESC_SIZE
    bl _kcc_arena_alloc
    mov x19, x0
    mov x1, #TY_CHAR
    str x1, [x19, #TY_KIND]
    mov x1, #1
    str x1, [x19, #TY_SIZE]
    str x1, [x19, #TY_ALIGN]
    str xzr, [x19, #TY_QUALS]
    mov x1, #1                      // signed
    str x1, [x19, #TY_F0]
    str xzr, [x19, #TY_F1]
    adrp x1, _kcc_type_char_s@@PAGE
    add  x1, x1, _kcc_type_char_s@@PAGEOFF
    str x19, [x1]

    // unsigned char
    mov x0, #TY_DESC_SIZE
    bl _kcc_arena_alloc
    mov x19, x0
    mov x1, #TY_CHAR
    str x1, [x19, #TY_KIND]
    mov x1, #1
    str x1, [x19, #TY_SIZE]
    str x1, [x19, #TY_ALIGN]
    str xzr, [x19, #TY_QUALS]
    str xzr, [x19, #TY_F0]         // unsigned
    str xzr, [x19, #TY_F1]
    adrp x1, _kcc_type_char_u@@PAGE
    add  x1, x1, _kcc_type_char_u@@PAGEOFF
    str x19, [x1]

    // signed short
    mov x0, #TY_DESC_SIZE
    bl _kcc_arena_alloc
    mov x19, x0
    mov x1, #TY_SHORT
    str x1, [x19, #TY_KIND]
    mov x1, #2
    str x1, [x19, #TY_SIZE]
    str x1, [x19, #TY_ALIGN]
    str xzr, [x19, #TY_QUALS]
    mov x1, #1                      // signed
    str x1, [x19, #TY_F0]
    str xzr, [x19, #TY_F1]
    adrp x1, _kcc_type_short_s@@PAGE
    add  x1, x1, _kcc_type_short_s@@PAGEOFF
    str x19, [x1]

    // unsigned short
    mov x0, #TY_DESC_SIZE
    bl _kcc_arena_alloc
    mov x19, x0
    mov x1, #TY_SHORT
    str x1, [x19, #TY_KIND]
    mov x1, #2
    str x1, [x19, #TY_SIZE]
    str x1, [x19, #TY_ALIGN]
    str xzr, [x19, #TY_QUALS]
    str xzr, [x19, #TY_F0]         // unsigned
    str xzr, [x19, #TY_F1]
    adrp x1, _kcc_type_short_u@@PAGE
    add  x1, x1, _kcc_type_short_u@@PAGEOFF
    str x19, [x1]

    // signed int
    mov x0, #TY_DESC_SIZE
    bl _kcc_arena_alloc
    mov x19, x0
    mov x1, #TY_INT
    str x1, [x19, #TY_KIND]
    mov x1, #4
    str x1, [x19, #TY_SIZE]
    str x1, [x19, #TY_ALIGN]
    str xzr, [x19, #TY_QUALS]
    mov x1, #1                      // signed
    str x1, [x19, #TY_F0]
    str xzr, [x19, #TY_F1]
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    str x19, [x1]

    // unsigned int
    mov x0, #TY_DESC_SIZE
    bl _kcc_arena_alloc
    mov x19, x0
    mov x1, #TY_INT
    str x1, [x19, #TY_KIND]
    mov x1, #4
    str x1, [x19, #TY_SIZE]
    str x1, [x19, #TY_ALIGN]
    str xzr, [x19, #TY_QUALS]
    str xzr, [x19, #TY_F0]         // unsigned
    str xzr, [x19, #TY_F1]
    adrp x1, _kcc_type_int_u@@PAGE
    add  x1, x1, _kcc_type_int_u@@PAGEOFF
    str x19, [x1]

    // signed long (8 bytes on ARM64)
    mov x0, #TY_DESC_SIZE
    bl _kcc_arena_alloc
    mov x19, x0
    mov x1, #TY_LONG
    str x1, [x19, #TY_KIND]
    mov x1, #8
    str x1, [x19, #TY_SIZE]
    str x1, [x19, #TY_ALIGN]
    str xzr, [x19, #TY_QUALS]
    mov x1, #1                      // signed
    str x1, [x19, #TY_F0]
    str xzr, [x19, #TY_F1]
    adrp x1, _kcc_type_long_s@@PAGE
    add  x1, x1, _kcc_type_long_s@@PAGEOFF
    str x19, [x1]

    // unsigned long
    mov x0, #TY_DESC_SIZE
    bl _kcc_arena_alloc
    mov x19, x0
    mov x1, #TY_LONG
    str x1, [x19, #TY_KIND]
    mov x1, #8
    str x1, [x19, #TY_SIZE]
    str x1, [x19, #TY_ALIGN]
    str xzr, [x19, #TY_QUALS]
    str xzr, [x19, #TY_F0]         // unsigned
    str xzr, [x19, #TY_F1]
    adrp x1, _kcc_type_long_u@@PAGE
    add  x1, x1, _kcc_type_long_u@@PAGEOFF
    str x19, [x1]

    // signed long long (8 bytes on ARM64)
    mov x0, #TY_DESC_SIZE
    bl _kcc_arena_alloc
    mov x19, x0
    mov x1, #TY_LLONG
    str x1, [x19, #TY_KIND]
    mov x1, #8
    str x1, [x19, #TY_SIZE]
    str x1, [x19, #TY_ALIGN]
    str xzr, [x19, #TY_QUALS]
    mov x1, #1                      // signed
    str x1, [x19, #TY_F0]
    str xzr, [x19, #TY_F1]
    adrp x1, _kcc_type_llong_s@@PAGE
    add  x1, x1, _kcc_type_llong_s@@PAGEOFF
    str x19, [x1]

    // unsigned long long
    mov x0, #TY_DESC_SIZE
    bl _kcc_arena_alloc
    mov x19, x0
    mov x1, #TY_LLONG
    str x1, [x19, #TY_KIND]
    mov x1, #8
    str x1, [x19, #TY_SIZE]
    str x1, [x19, #TY_ALIGN]
    str xzr, [x19, #TY_QUALS]
    str xzr, [x19, #TY_F0]         // unsigned
    str xzr, [x19, #TY_F1]
    adrp x1, _kcc_type_llong_u@@PAGE
    add  x1, x1, _kcc_type_llong_u@@PAGEOFF
    str x19, [x1]
@}

\paragraph{Floating-Point Type Singletons}

The floating-point singletons cover \texttt{float} (4~bytes) and
\texttt{double} (8~bytes).  \texttt{long double} is a third floating type in
the abstract machine, but the Apple ARM64 ABI defines it to have the same
representation as \texttt{double} (64-bit IEEE-754)---unlike AArch64 Linux,
where it is a 128-bit quad.  We honour that ABI by \emph{aliasing} the
\texttt{long double} singleton to the \texttt{double} descriptor rather than
allocating a distinct one, so the many places that recognise a floating type
by its kind (\texttt{TY\_DOUBLE}) need no change and \texttt{long double}
lowers, sizes, and passes exactly as \texttt{double}.  Unlike integer types,
floating-point descriptors do not use \texttt{TY\_F0} for signedness --- all
are inherently signed per \stdref{6.2.5p10}.  After allocating the last
singleton the function restores callee-saved registers
\texttt{x19}/\texttt{x20} and returns.

@d Types: init @{
    // float
    mov x0, #TY_DESC_SIZE
    bl _kcc_arena_alloc
    mov x19, x0
    mov x1, #TY_FLOAT
    str x1, [x19, #TY_KIND]
    mov x1, #4
    str x1, [x19, #TY_SIZE]
    str x1, [x19, #TY_ALIGN]
    str xzr, [x19, #TY_QUALS]
    str xzr, [x19, #TY_F0]
    str xzr, [x19, #TY_F1]
    adrp x1, _kcc_type_float@@PAGE
    add  x1, x1, _kcc_type_float@@PAGEOFF
    str x19, [x1]

    // double
    mov x0, #TY_DESC_SIZE
    bl _kcc_arena_alloc
    mov x19, x0
    mov x1, #TY_DOUBLE
    str x1, [x19, #TY_KIND]
    mov x1, #8
    str x1, [x19, #TY_SIZE]
    str x1, [x19, #TY_ALIGN]
    str xzr, [x19, #TY_QUALS]
    str xzr, [x19, #TY_F0]
    str xzr, [x19, #TY_F1]
    adrp x1, _kcc_type_double@@PAGE
    add  x1, x1, _kcc_type_double@@PAGEOFF
    str x19, [x1]

    // long double: on the Apple ARM64 ABI, long double is identical to
    // double (64-bit IEEE-754), unlike AArch64 Linux where it is a 128-bit
    // quad.  Alias the descriptor to the double one just built, so every
    // path---FP lowering, sizeof, printf, argument passing---treats a
    // long double exactly as a double.
    adrp x1, _kcc_type_double@@PAGE
    add  x1, x1, _kcc_type_double@@PAGEOFF
    ldr  x0, [x1]                 // the double descriptor
    adrp x1, _kcc_type_ldouble@@PAGE
    add  x1, x1, _kcc_type_ldouble@@PAGEOFF
    str  x0, [x1]

    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@}

\section{Type Constructors}

\subsection{Pointer Type}

Construct a pointer type descriptor from a given pointee type.  The function
arena-allocates a \texttt{TY\_DESC\_SIZE} record, sets its kind to
\texttt{TY\_PTR}, and records size and alignment as 8 bytes (the pointer
width on ARM64).  The pointee type descriptor is stored in \texttt{TY\_F0}
so that later phases can dereference through the pointer chain.

@d Types: make pointer @{
// -- kcc_type_ptr ---------------------------------------------------------
// type_desc *kcc_type_ptr(type_desc *pointee)
//   x0 = pointee type descriptor
// Returns pointer to TY_PTR descriptor.
.text
.globl _kcc_type_ptr
.p2align 2
_kcc_type_ptr:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    mov x19, x0                     // save pointee

    mov x0, #TY_DESC_SIZE
    bl _kcc_arena_alloc
    mov x1, #TY_PTR
    str x1, [x0, #TY_KIND]
    mov x1, #8                      // pointer size on ARM64
    str x1, [x0, #TY_SIZE]
    str x1, [x0, #TY_ALIGN]
    str xzr, [x0, #TY_QUALS]
    str x19, [x0, #TY_F0]          // pointee
    str xzr, [x0, #TY_F1]

    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_type_ptr
@}

\paragraph{Parameter type adjustment.}  A function parameter declared with
array type is, per \stdref{6.7.6.3}, adjusted to a \emph{pointer} to the
element type; likewise a function-typed parameter becomes a pointer to the
function.  This matters because the callee never receives the array by
value---it receives the address the array decayed to at the call site.  If
the parameter kept its array type, the code generator would allocate inline
array storage and index \emph{that} rather than loading the passed pointer,
so \texttt{a[i]} would read the callee's own stack.  \texttt{kcc\_type\_param\_adjust}
performs the adjustment; it is applied wherever a parameter's type is
resolved (symbol registration, the alloca, and AAPCS64 classification).

@d Types: make pointer @{
// -- kcc_type_param_adjust ------------------------------------------------
// type_desc *kcc_type_param_adjust(type_desc *t)
//   x0 = resolved parameter type; returns the adjusted type: an array or
//   function type becomes a pointer (to element / to function); any other
//   type is returned unchanged (\stdref{6.7.6.3}).
.text
.globl _kcc_type_param_adjust
.p2align 2
_kcc_type_param_adjust:
    cbz x0, .Ltpa_ret
    ldr x1, [x0, #TY_KIND]
    cmp x1, #TY_ARRAY
    b.eq .Ltpa_array
    cmp x1, #TY_FUNC
    b.eq _kcc_type_ptr          // function → pointer to function (x0 unchanged)
    ret
.Ltpa_array:
    ldr x0, [x0, #TY_F0]        // element type
    b _kcc_type_ptr             // pointer to element
.Ltpa_ret:
    ret
@| _kcc_type_param_adjust
@}

\subsection{Array Type}

Construct an array type descriptor.  The element type is saved in
\texttt{TY\_F0} and the array length in \texttt{TY\_F1}; a length of zero
indicates an incomplete array type (\stdref{6.2.5}).  The total size is
computed as element size multiplied by length, and alignment is inherited
directly from the element type.

Aggregate element types are sized \emph{lazily}: \texttt{kcc\_type\_struct}
leaves \texttt{TY\_SIZE} at zero until \texttt{kcc\_type\_layout} runs.  If we
read the element size before that layout happens---as when a local
\texttt{struct~S~a[3]} is declared before \texttt{S} is otherwise
referenced---the multiplication captures a stale zero and the whole array
appears to have size zero (so \texttt{sizeof~a} is wrong and
\texttt{memset(a,0,sizeof~a)} clears nothing).  We therefore lay the element
out first; layout is idempotent, so this is safe for scalar elements too and
merely returns their already-known size.

@d Types: make array @{
// -- kcc_type_array -------------------------------------------------------
// type_desc *kcc_type_array(type_desc *elem, uint64_t len)
//   x0 = element type, x1 = length (0 = incomplete)
// Returns TY_ARRAY descriptor.
.text
.globl _kcc_type_array
.p2align 2
_kcc_type_array:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]

    mov x19, x0                     // elem type
    mov x20, x1                     // length

    mov x0, #TY_DESC_SIZE
    bl _kcc_arena_alloc
    mov x21, x0                     // array descriptor
    mov x1, #TY_ARRAY
    str x1, [x21, #TY_KIND]
    // Ensure the element is laid out so aggregate sizes are known, then
    // size = elem_size * length.
    mov x0, x19
    bl _kcc_type_layout            // x0 = element size
    mul x0, x0, x20
    str x0, [x21, #TY_SIZE]
    ldr x2, [x19, #TY_ALIGN]
    str x2, [x21, #TY_ALIGN]
    str xzr, [x21, #TY_QUALS]
    str x19, [x21, #TY_F0]         // element type
    str x20, [x21, #TY_F1]         // length

    mov x0, x21
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_type_array
@}

\subsection{Function Type}

Construct a function type descriptor.  The return type is stored in
\texttt{TY\_F0} and the parameter type vector in \texttt{TY\_F1}.  Function
types are not object types, so both size and alignment are set to zero
(\stdref{6.2.5}).  The parameter vector may be null for unprototyped
(K\&R-style) declarations.

@d Types: make function @{
// -- kcc_type_func --------------------------------------------------------
// type_desc *kcc_type_func(type_desc *ret, vec *params)
//   x0 = return type, x1 = parameter type vec (or 0)
// Returns TY_FUNC descriptor.
.text
.globl _kcc_type_func
.p2align 2
_kcc_type_func:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    mov x19, x0                     // return type
    mov x20, x1                     // params vec

    mov x0, #TY_DESC_SIZE
    bl _kcc_arena_alloc
    mov x1, #TY_FUNC
    str x1, [x0, #TY_KIND]
    str xzr, [x0, #TY_SIZE]        // function types have no size
    str xzr, [x0, #TY_ALIGN]
    str xzr, [x0, #TY_QUALS]
    str x19, [x0, #TY_F0]          // return type
    str x20, [x0, #TY_F1]          // param vec

    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_type_func
@}

\subsection{Struct/Union Type}

Construct struct and union type descriptors.  At creation time, size and
alignment are left at zero because member layout has not been computed yet;
the semantic analysis pass fills them in once all members are known.  The
AST declaration node is stored in \texttt{TY\_F0}, and \texttt{TY\_F1}
will later hold the member vector populated by sema.  The only difference
between the two constructors is the kind constant (\texttt{TY\_STRUCT}
versus \texttt{TY\_UNION}).

@d Types: make struct @{
// -- kcc_type_struct ------------------------------------------------------
// type_desc *kcc_type_struct(node *decl_node)
//   x0 = AST struct/union declaration node
// Returns TY_STRUCT descriptor.
.text
.globl _kcc_type_struct
.p2align 2
_kcc_type_struct:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    mov x19, x0                     // decl node

    // Memoise one descriptor per struct-definition AST node (cached in the
    // decl's spare AST_F2, zero-initialised by ast_alloc).  Re-resolving the
    // same definition---especially an ANONYMOUS one, which has no tag to dedup
    // through---must return the SAME descriptor.  A second descriptor would
    // share the field AST nodes, and laying it out would re-run destructive
    // bit-field packing, dereferencing an AST_F2 the first layout already
    // replaced with a packed (bit_offset<<16 | width) integer as if it were a
    // width-expression pointer.  SQLite's `struct SrcItem` has an anonymous
    // `struct {...} fg` of bit-fields accessed as `pItem->fg.isTabFunc`.
    cbz x19, .Lts_alloc
    ldr x0, [x19, #AST_F2]          // cached descriptor?
    cbnz x0, .Lts_ret
.Lts_alloc:
    mov x0, #TY_DESC_SIZE
    bl _kcc_arena_alloc
    mov x1, #TY_STRUCT
    str x1, [x0, #TY_KIND]
    str xzr, [x0, #TY_SIZE]        // computed later during layout
    str xzr, [x0, #TY_ALIGN]
    str xzr, [x0, #TY_QUALS]
    str x19, [x0, #TY_F0]          // AST decl node
    str xzr, [x0, #TY_F1]          // member vec (populated by sema)
    cbz x19, .Lts_ret
    str x0, [x19, #AST_F2]          // cache on the decl node
.Lts_ret:
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- kcc_type_union -------------------------------------------------------
// type_desc *kcc_type_union(node *decl_node)
.globl _kcc_type_union
.p2align 2
_kcc_type_union:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    mov x19, x0

    // Memoise one descriptor per union-definition node (see kcc_type_struct).
    cbz x19, .Ltu_alloc
    ldr x0, [x19, #AST_F2]
    cbnz x0, .Ltu_ret
.Ltu_alloc:
    mov x0, #TY_DESC_SIZE
    bl _kcc_arena_alloc
    mov x1, #TY_UNION
    str x1, [x0, #TY_KIND]
    str xzr, [x0, #TY_SIZE]
    str xzr, [x0, #TY_ALIGN]
    str xzr, [x0, #TY_QUALS]
    str x19, [x0, #TY_F0]
    str xzr, [x0, #TY_F1]
    cbz x19, .Ltu_ret
    str x0, [x19, #AST_F2]
.Ltu_ret:
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_type_struct
@| _kcc_type_union
@}

\subsection{Enum Type}

Construct an enum type descriptor.  Per \stdref{6.7.2.2}, the underlying
type of an enumeration is \texttt{int}, so size and alignment are both set
to~4.  The AST enum declaration node is stored in \texttt{TY\_F0} for later
reference during enumerator constant evaluation.

@d Types: make enum @{
// -- kcc_type_enum --------------------------------------------------------
// type_desc *kcc_type_enum(node *decl_node)
//   x0 = AST enum declaration node
// Returns TY_ENUM descriptor (underlying type is int).
.text
.globl _kcc_type_enum
.p2align 2
_kcc_type_enum:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    mov x19, x0

    mov x0, #TY_DESC_SIZE
    bl _kcc_arena_alloc
    mov x1, #TY_ENUM
    str x1, [x0, #TY_KIND]
    mov x1, #4                      // enum has int size
    str x1, [x0, #TY_SIZE]
    str x1, [x0, #TY_ALIGN]
    str xzr, [x0, #TY_QUALS]
    str x19, [x0, #TY_F0]          // decl node
    str xzr, [x0, #TY_F1]

    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_type_enum
@}

\section{Specifier Bitmask Resolution}

The parser stores a bitmask of type specifiers in \texttt{AST\_TYPE\_BUILTIN.F0}.
This function maps each valid combination to the corresponding singleton
type descriptor.

@d Types: resolve specmask @{
// -- kcc_type_from_specmask -----------------------------------------------
// type_desc *kcc_type_from_specmask(uint64_t mask)
//   x0 = specifier bitmask from parser
// Returns type descriptor pointer, or 0 on invalid combination.
.text
.globl _kcc_type_from_specmask
.p2align 2
_kcc_type_from_specmask:
    stp x29, x30, [sp, #-16]!
    mov x29, sp

    // void
    cmp x0, #SPEC_VOID
    b.eq .Ltfm_void

    // _Bool
    mov x1, #SPEC_BOOL
    cmp x0, x1
    b.eq .Ltfm_bool

    // char (plain or signed char)
    cmp x0, #SPEC_CHAR
    b.eq .Ltfm_char_s
    mov x1, #(SPEC_SIGNED | SPEC_CHAR)
    cmp x0, x1
    b.eq .Ltfm_char_s

    // unsigned char
    mov x1, #(SPEC_UNSIGNED | SPEC_CHAR)
    cmp x0, x1
    b.eq .Ltfm_char_u

    // short / signed short / short int / signed short int
    cmp x0, #SPEC_SHORT
    b.eq .Ltfm_short_s
    mov x1, #(SPEC_SIGNED | SPEC_SHORT)
    cmp x0, x1
    b.eq .Ltfm_short_s
    mov x1, #(SPEC_SHORT | SPEC_INT)
    cmp x0, x1
    b.eq .Ltfm_short_s
    mov x1, #(SPEC_SIGNED | SPEC_SHORT | SPEC_INT)
    cmp x0, x1
    b.eq .Ltfm_short_s

    // unsigned short / unsigned short int
    mov x1, #(SPEC_UNSIGNED | SPEC_SHORT)
    cmp x0, x1
    b.eq .Ltfm_short_u
    mov x1, #(SPEC_UNSIGNED | SPEC_SHORT | SPEC_INT)
    cmp x0, x1
    b.eq .Ltfm_short_u

    // int / signed / signed int
    cmp x0, #SPEC_INT
    b.eq .Ltfm_int_s
    mov x1, #SPEC_SIGNED
    cmp x0, x1
    b.eq .Ltfm_int_s
    mov x1, #(SPEC_SIGNED | SPEC_INT)
    cmp x0, x1
    b.eq .Ltfm_int_s

    // unsigned / unsigned int
    mov x1, #SPEC_UNSIGNED
    cmp x0, x1
    b.eq .Ltfm_int_u
    mov x1, #(SPEC_UNSIGNED | SPEC_INT)
    cmp x0, x1
    b.eq .Ltfm_int_u
@| _kcc_type_from_specmask
@}

\paragraph{Long, Long Long, and Floating-Point Dispatch}

The remaining dispatch covers \texttt{long} and \texttt{long long} types,
which accept the most specifier combinations in C17.  The parser may set
\texttt{SPEC\_LONG} alone or combined with \texttt{SPEC\_LLONG} (from two
successive \texttt{long} keywords), and any of these may appear with or
without \texttt{SPEC\_SIGNED}, \texttt{SPEC\_UNSIGNED}, or \texttt{SPEC\_INT}.
After the integer specifiers, the floating-point keywords \texttt{float},
\texttt{double}, and \texttt{long double} are matched.  Any bitmask that
falls through every comparison returns zero to signal an invalid combination.

@d Types: resolve specmask @{
    // long / signed long / long int / signed long int
    mov x1, #SPEC_LONG
    cmp x0, x1
    b.eq .Ltfm_long_s
    mov x1, #(SPEC_SIGNED | SPEC_LONG)
    cmp x0, x1
    b.eq .Ltfm_long_s
    mov x1, #(SPEC_LONG | SPEC_INT)
    cmp x0, x1
    b.eq .Ltfm_long_s
    mov x1, #(SPEC_SIGNED | SPEC_LONG | SPEC_INT)
    cmp x0, x1
    b.eq .Ltfm_long_s

    // unsigned long / unsigned long int
    mov x1, #(SPEC_UNSIGNED | SPEC_LONG)
    cmp x0, x1
    b.eq .Ltfm_long_u
    mov x1, #(SPEC_UNSIGNED | SPEC_LONG | SPEC_INT)
    cmp x0, x1
    b.eq .Ltfm_long_u

    // long long / signed long long / long long int / signed long long int
    mov x1, #SPEC_LLONG
    cmp x0, x1
    b.eq .Ltfm_llong_s
    mov x1, #(SPEC_SIGNED | SPEC_LLONG)
    cmp x0, x1
    b.eq .Ltfm_llong_s
    mov x1, #(SPEC_LLONG | SPEC_INT)
    cmp x0, x1
    b.eq .Ltfm_llong_s
    mov x1, #(SPEC_SIGNED | SPEC_LLONG | SPEC_INT)
    cmp x0, x1
    b.eq .Ltfm_llong_s
    // Also accept long + long long combined
    mov x1, #(SPEC_LONG | SPEC_LLONG)
    cmp x0, x1
    b.eq .Ltfm_llong_s
    mov x1, #(SPEC_SIGNED | SPEC_LONG | SPEC_LLONG)
    cmp x0, x1
    b.eq .Ltfm_llong_s
    mov x1, #(SPEC_LONG | SPEC_LLONG | SPEC_INT)
    cmp x0, x1
    b.eq .Ltfm_llong_s
    mov x1, #(SPEC_SIGNED | SPEC_LONG | SPEC_LLONG | SPEC_INT)
    cmp x0, x1
    b.eq .Ltfm_llong_s

    // unsigned long long / unsigned long long int
    mov x1, #(SPEC_UNSIGNED | SPEC_LLONG)
    cmp x0, x1
    b.eq .Ltfm_llong_u
    mov x1, #(SPEC_UNSIGNED | SPEC_LLONG | SPEC_INT)
    cmp x0, x1
    b.eq .Ltfm_llong_u
    mov x1, #(SPEC_UNSIGNED | SPEC_LONG | SPEC_LLONG)
    cmp x0, x1
    b.eq .Ltfm_llong_u
    mov x1, #(SPEC_UNSIGNED | SPEC_LONG | SPEC_LLONG | SPEC_INT)
    cmp x0, x1
    b.eq .Ltfm_llong_u

    // float
    mov x1, #SPEC_FLOAT
    cmp x0, x1
    b.eq .Ltfm_float

    // double
    mov x1, #SPEC_DOUBLE
    cmp x0, x1
    b.eq .Ltfm_double

    // long double
    mov x1, #(SPEC_LONG | SPEC_DOUBLE)
    cmp x0, x1
    b.eq .Ltfm_ldouble

    // Invalid combination
    mov x0, #0
    b .Ltfm_done
@}

\paragraph{Singleton Pointer Loads}

Each label target below loads the address of the corresponding global
singleton pointer (e.g.\ \texttt{\_kcc\_type\_int\_s}) using an
\texttt{ADRP+ADD} pair, dereferences it to obtain the type descriptor
allocated by \texttt{kcc\_types\_init}, and branches to the common
epilogue at \texttt{.Ltfm\_done}.  The pattern is uniform across all
fifteen basic types --- only the symbol name changes.

@d Types: resolve specmask @{
.Ltfm_void:
    adrp x0, _kcc_type_void@@PAGE
    add  x0, x0, _kcc_type_void@@PAGEOFF
    ldr  x0, [x0]
    b .Ltfm_done
.Ltfm_bool:
    adrp x0, _kcc_type_bool@@PAGE
    add  x0, x0, _kcc_type_bool@@PAGEOFF
    ldr  x0, [x0]
    b .Ltfm_done
.Ltfm_char_s:
    adrp x0, _kcc_type_char_s@@PAGE
    add  x0, x0, _kcc_type_char_s@@PAGEOFF
    ldr  x0, [x0]
    b .Ltfm_done
.Ltfm_char_u:
    adrp x0, _kcc_type_char_u@@PAGE
    add  x0, x0, _kcc_type_char_u@@PAGEOFF
    ldr  x0, [x0]
    b .Ltfm_done
.Ltfm_short_s:
    adrp x0, _kcc_type_short_s@@PAGE
    add  x0, x0, _kcc_type_short_s@@PAGEOFF
    ldr  x0, [x0]
    b .Ltfm_done
.Ltfm_short_u:
    adrp x0, _kcc_type_short_u@@PAGE
    add  x0, x0, _kcc_type_short_u@@PAGEOFF
    ldr  x0, [x0]
    b .Ltfm_done
.Ltfm_int_s:
    adrp x0, _kcc_type_int_s@@PAGE
    add  x0, x0, _kcc_type_int_s@@PAGEOFF
    ldr  x0, [x0]
    b .Ltfm_done
.Ltfm_int_u:
    adrp x0, _kcc_type_int_u@@PAGE
    add  x0, x0, _kcc_type_int_u@@PAGEOFF
    ldr  x0, [x0]
    b .Ltfm_done
.Ltfm_long_s:
    adrp x0, _kcc_type_long_s@@PAGE
    add  x0, x0, _kcc_type_long_s@@PAGEOFF
    ldr  x0, [x0]
    b .Ltfm_done
.Ltfm_long_u:
    adrp x0, _kcc_type_long_u@@PAGE
    add  x0, x0, _kcc_type_long_u@@PAGEOFF
    ldr  x0, [x0]
    b .Ltfm_done
.Ltfm_llong_s:
    adrp x0, _kcc_type_llong_s@@PAGE
    add  x0, x0, _kcc_type_llong_s@@PAGEOFF
    ldr  x0, [x0]
    b .Ltfm_done
.Ltfm_llong_u:
    adrp x0, _kcc_type_llong_u@@PAGE
    add  x0, x0, _kcc_type_llong_u@@PAGEOFF
    ldr  x0, [x0]
    b .Ltfm_done
.Ltfm_float:
    adrp x0, _kcc_type_float@@PAGE
    add  x0, x0, _kcc_type_float@@PAGEOFF
    ldr  x0, [x0]
    b .Ltfm_done
.Ltfm_double:
    adrp x0, _kcc_type_double@@PAGE
    add  x0, x0, _kcc_type_double@@PAGEOFF
    ldr  x0, [x0]
    b .Ltfm_done
.Ltfm_ldouble:
    adrp x0, _kcc_type_ldouble@@PAGE
    add  x0, x0, _kcc_type_ldouble@@PAGEOFF
    ldr  x0, [x0]

.Ltfm_done:
    ldp x29, x30, [sp], #16
    ret
@}

\section{Type Predicates}

The type predicates implement the classification rules from \stdref{6.2.5}
and the compatibility check from \stdref{6.2.7}.  \texttt{kcc\_type\_compatible}
first tests pointer identity (same descriptor means trivially compatible),
then compares kind constants and, for basic types, the signedness field in
\texttt{TY\_F0}.  The helper predicates \texttt{kcc\_type\_is\_integer},
\texttt{kcc\_type\_is\_arithmetic}, and \texttt{kcc\_type\_is\_scalar}
classify a type by checking its kind against the relevant set of constants.

@d Types: compatible @{
// -- kcc_type_compatible --------------------------------------------------
// int kcc_type_compatible(type_desc *t1, type_desc *t2)
//   x0 = first type, x1 = second type
// Returns 1 if types are compatible per §6.2.7, else 0.
.text
.globl _kcc_type_compatible
.p2align 2
_kcc_type_compatible:
    // Same pointer → trivially compatible
    cmp x0, x1
    b.eq .Ltc_yes

    // Must have same kind
    ldr x2, [x0, #TY_KIND]
    ldr x3, [x1, #TY_KIND]
    cmp x2, x3
    b.ne .Ltc_no

    // For basic types: same kind + same F0 (signedness) → compatible
    cmp x2, #TY_PTR
    b.ge .Ltc_derived

    // Basic type: compare signedness (F0)
    ldr x2, [x0, #TY_F0]
    ldr x3, [x1, #TY_F0]
    cmp x2, x3
    b.ne .Ltc_no

.Ltc_yes:
    mov x0, #1
    ret

.Ltc_derived:
    // For pointers: compare pointee compatibility (simplified)
    cmp x2, #TY_PTR
    b.ne .Ltc_no
    // TODO: recursive compatibility check for derived types
    mov x0, #1
    ret

.Ltc_no:
    mov x0, #0
    ret
@| _kcc_type_compatible
@}

\texttt{kcc\_type\_is\_integer} checks whether a type belongs to the
integer category (\stdref{6.2.5p17}): \texttt{\_Bool}, \texttt{char},
\texttt{short}, \texttt{int}, \texttt{long}, \texttt{long long}, and
enumerated types.  The check is a linear scan of kind constants ---
seven comparisons at most.

@d Types: is integer @{
// -- kcc_type_is_integer --------------------------------------------------
// int kcc_type_is_integer(type_desc *t)
// Returns 1 if t is an integer type (bool, char, short, int, long, llong, enum).
.text
.globl _kcc_type_is_integer
.p2align 2
_kcc_type_is_integer:
    ldr x1, [x0, #TY_KIND]
    cmp x1, #TY_BOOL
    b.eq .Ltii_yes
    cmp x1, #TY_CHAR
    b.eq .Ltii_yes
    cmp x1, #TY_SHORT
    b.eq .Ltii_yes
    cmp x1, #TY_INT
    b.eq .Ltii_yes
    cmp x1, #TY_LONG
    b.eq .Ltii_yes
    cmp x1, #TY_LLONG
    b.eq .Ltii_yes
    cmp x1, #TY_ENUM
    b.eq .Ltii_yes
    mov x0, #0
    ret
.Ltii_yes:
    mov x0, #1
    ret
@| _kcc_type_is_integer
@}

Arithmetic types are the union of integer types and floating-point
types (\stdref{6.2.5p18}).  \texttt{kcc\_type\_is\_arithmetic} first
delegates to \texttt{kcc\_type\_is\_integer}; if that returns false, it
checks for \texttt{float}, \texttt{double}, and \texttt{long double}.

@d Types: is arithmetic @{
// -- kcc_type_is_arithmetic -----------------------------------------------
// int kcc_type_is_arithmetic(type_desc *t)
// Returns 1 if t is an arithmetic type (integer or floating).
.text
.globl _kcc_type_is_arithmetic
.p2align 2
_kcc_type_is_arithmetic:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    mov x19, x0                     // save type in callee-saved
    bl _kcc_type_is_integer
    cbnz x0, .Ltia_yes

    ldr x1, [x19, #TY_KIND]
    cmp x1, #TY_FLOAT
    b.eq .Ltia_yes
    cmp x1, #TY_DOUBLE
    b.eq .Ltia_yes
    cmp x1, #TY_LDOUBLE
    b.eq .Ltia_yes

    mov x0, #0
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
.Ltia_yes:
    mov x0, #1
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_type_is_arithmetic
@}

Scalar types comprise all arithmetic types plus pointer types
(\stdref{6.2.5p21}).  This predicate is used throughout semantic
analysis wherever the standard requires a ``scalar expression'' ---
for example, the controlling expression of \texttt{if}, \texttt{while},
and \texttt{for} statements.

@d Types: is scalar @{
// -- kcc_type_is_scalar ---------------------------------------------------
// int kcc_type_is_scalar(type_desc *t)
// Returns 1 if t is a scalar type (arithmetic or pointer).
.text
.globl _kcc_type_is_scalar
.p2align 2
_kcc_type_is_scalar:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    mov x19, x0
    bl _kcc_type_is_arithmetic
    cbnz x0, .Ltis_yes

    ldr x1, [x19, #TY_KIND]
    cmp x1, #TY_PTR
    b.eq .Ltis_yes

    mov x0, #0
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
.Ltis_yes:
    mov x0, #1
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@| _kcc_type_is_scalar
@}

\section{Integer Conversion Rank}

Every integer type has a \emph{conversion rank} that governs the usual
arithmetic conversions (\stdref{6.3.1.1}).  The ranking assigns
\texttt{\_Bool} the lowest rank (1) and \texttt{long long} the highest (6),
with \texttt{enum} sharing the rank of \texttt{int}.  The function returns
the rank as an unsigned integer so that callers can compare two types with
a simple greater-than test.

@d Types: rank @{
// -- kcc_type_rank --------------------------------------------------------
// uint64_t kcc_type_rank(type_desc *t)
// Returns integer conversion rank per §6.3.1.1.
// Higher rank = wider type for UAC purposes.
.text
.globl _kcc_type_rank
.p2align 2
_kcc_type_rank:
    ldr x1, [x0, #TY_KIND]
    cmp x1, #TY_BOOL
    b.eq .Ltr_bool
    cmp x1, #TY_CHAR
    b.eq .Ltr_char
    cmp x1, #TY_SHORT
    b.eq .Ltr_short
    cmp x1, #TY_INT
    b.eq .Ltr_int
    cmp x1, #TY_LONG
    b.eq .Ltr_long
    cmp x1, #TY_LLONG
    b.eq .Ltr_llong
    cmp x1, #TY_ENUM
    b.eq .Ltr_int           // enum has rank of int
    // Default: 0
    mov x0, #0
    ret
.Ltr_bool:
    mov x0, #1
    ret
.Ltr_char:
    mov x0, #2
    ret
.Ltr_short:
    mov x0, #3
    ret
.Ltr_int:
    mov x0, #4
    ret
.Ltr_long:
    mov x0, #5
    ret
.Ltr_llong:
    mov x0, #6
    ret
@| _kcc_type_rank
@}

\section{Type Dump}

Print a human-readable representation of a type descriptor.

@d Types: dump @{
// -- kcc_type_dump --------------------------------------------------------
// void kcc_type_dump(type_desc *t)
//   x0 = type descriptor
// Prints the type as a readable string (e.g., "int", "const char *").
.text
.globl _kcc_type_dump
.p2align 2
_kcc_type_dump:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    str x19, [sp, #16]

    cbz x0, .Ltd_null
    mov x19, x0

    // Check qualifiers
    ldr x0, [x19, #TY_QUALS]
    cbz x0, .Ltd_kind

    tst x0, #1
    b.eq .Ltd_no_const
    adrp x0, _kcc_ty_str_const@@PAGE
    add  x0, x0, _kcc_ty_str_const@@PAGEOFF
    bl _kcc_io_puts
.Ltd_no_const:
    ldr x0, [x19, #TY_QUALS]
    tst x0, #2
    b.eq .Ltd_no_volatile
    adrp x0, _kcc_ty_str_volatile@@PAGE
    add  x0, x0, _kcc_ty_str_volatile@@PAGEOFF
    bl _kcc_io_puts
.Ltd_no_volatile:

.Ltd_kind:
    ldr x0, [x19, #TY_KIND]

    cmp x0, #TY_VOID
    b.eq .Ltd_void
    cmp x0, #TY_BOOL
    b.eq .Ltd_bool
    cmp x0, #TY_CHAR
    b.eq .Ltd_char
    cmp x0, #TY_SHORT
    b.eq .Ltd_short
    cmp x0, #TY_INT
    b.eq .Ltd_int
    cmp x0, #TY_LONG
    b.eq .Ltd_long
    cmp x0, #TY_LLONG
    b.eq .Ltd_llong
    cmp x0, #TY_FLOAT
    b.eq .Ltd_float
    cmp x0, #TY_DOUBLE
    b.eq .Ltd_double
    cmp x0, #TY_LDOUBLE
    b.eq .Ltd_ldouble
    cmp x0, #TY_PTR
    b.eq .Ltd_ptr
    cmp x0, #TY_ARRAY
    b.eq .Ltd_array
    cmp x0, #TY_FUNC
    b.eq .Ltd_func
    cmp x0, #TY_STRUCT
    b.eq .Ltd_struct
    cmp x0, #TY_UNION
    b.eq .Ltd_union
    cmp x0, #TY_ENUM
    b.eq .Ltd_enum

    // Unknown
    adrp x0, _kcc_ty_str_unknown@@PAGE
    add  x0, x0, _kcc_ty_str_unknown@@PAGEOFF
    bl _kcc_io_puts
    b .Ltd_done
@| _kcc_type_dump
@}

\paragraph{Basic Type Label Targets}

Each label below prints the human-readable name for one basic type kind.
For integer types (\texttt{char} through \texttt{long long}), the code
checks the \texttt{TY\_F0} signedness flag stored in the descriptor and
selects the appropriate string --- for example, \texttt{"int"} versus
\texttt{"unsigned int"}.  Non-integer basic types (\texttt{void},
\texttt{\_Bool}, \texttt{float}, \texttt{double}, \texttt{long double})
print a fixed string unconditionally since they have no signed/unsigned
variants.

@d Types: dump @{
.Ltd_null:
    adrp x0, _kcc_ty_str_null@@PAGE
    add  x0, x0, _kcc_ty_str_null@@PAGEOFF
    bl _kcc_io_puts
    b .Ltd_done

.Ltd_void:
    adrp x0, _kcc_ty_str_void@@PAGE
    add  x0, x0, _kcc_ty_str_void@@PAGEOFF
    bl _kcc_io_puts
    b .Ltd_done
.Ltd_bool:
    adrp x0, _kcc_ty_str_bool@@PAGE
    add  x0, x0, _kcc_ty_str_bool@@PAGEOFF
    bl _kcc_io_puts
    b .Ltd_done
.Ltd_char:
    ldr x0, [x19, #TY_F0]
    cbz x0, .Ltd_char_u
    adrp x0, _kcc_ty_str_char@@PAGE
    add  x0, x0, _kcc_ty_str_char@@PAGEOFF
    bl _kcc_io_puts
    b .Ltd_done
.Ltd_char_u:
    adrp x0, _kcc_ty_str_uchar@@PAGE
    add  x0, x0, _kcc_ty_str_uchar@@PAGEOFF
    bl _kcc_io_puts
    b .Ltd_done
.Ltd_short:
    ldr x0, [x19, #TY_F0]
    cbz x0, .Ltd_short_u
    adrp x0, _kcc_ty_str_short@@PAGE
    add  x0, x0, _kcc_ty_str_short@@PAGEOFF
    bl _kcc_io_puts
    b .Ltd_done
.Ltd_short_u:
    adrp x0, _kcc_ty_str_ushort@@PAGE
    add  x0, x0, _kcc_ty_str_ushort@@PAGEOFF
    bl _kcc_io_puts
    b .Ltd_done
.Ltd_int:
    ldr x0, [x19, #TY_F0]
    cbz x0, .Ltd_int_u
    adrp x0, _kcc_ty_str_int@@PAGE
    add  x0, x0, _kcc_ty_str_int@@PAGEOFF
    bl _kcc_io_puts
    b .Ltd_done
.Ltd_int_u:
    adrp x0, _kcc_ty_str_uint@@PAGE
    add  x0, x0, _kcc_ty_str_uint@@PAGEOFF
    bl _kcc_io_puts
    b .Ltd_done
.Ltd_long:
    ldr x0, [x19, #TY_F0]
    cbz x0, .Ltd_long_u
    adrp x0, _kcc_ty_str_long@@PAGE
    add  x0, x0, _kcc_ty_str_long@@PAGEOFF
    bl _kcc_io_puts
    b .Ltd_done
.Ltd_long_u:
    adrp x0, _kcc_ty_str_ulong@@PAGE
    add  x0, x0, _kcc_ty_str_ulong@@PAGEOFF
    bl _kcc_io_puts
    b .Ltd_done
.Ltd_llong:
    ldr x0, [x19, #TY_F0]
    cbz x0, .Ltd_llong_u
    adrp x0, _kcc_ty_str_llong@@PAGE
    add  x0, x0, _kcc_ty_str_llong@@PAGEOFF
    bl _kcc_io_puts
    b .Ltd_done
.Ltd_llong_u:
    adrp x0, _kcc_ty_str_ullong@@PAGE
    add  x0, x0, _kcc_ty_str_ullong@@PAGEOFF
    bl _kcc_io_puts
    b .Ltd_done
.Ltd_float:
    adrp x0, _kcc_ty_str_float@@PAGE
    add  x0, x0, _kcc_ty_str_float@@PAGEOFF
    bl _kcc_io_puts
    b .Ltd_done
.Ltd_double:
    adrp x0, _kcc_ty_str_double@@PAGE
    add  x0, x0, _kcc_ty_str_double@@PAGEOFF
    bl _kcc_io_puts
    b .Ltd_done
.Ltd_ldouble:
    adrp x0, _kcc_ty_str_ldouble@@PAGE
    add  x0, x0, _kcc_ty_str_ldouble@@PAGEOFF
    bl _kcc_io_puts
    b .Ltd_done
@}

\paragraph{Derived Type Label Targets}

Derived types require more than a single string print.  Pointer types
recursively call \texttt{kcc\_type\_dump} on the pointee stored in
\texttt{TY\_F0}, then append \texttt{" *"}.  Array types print the element
type followed by the length in brackets via \texttt{kcc\_io\_putu}.  Function
types print the return type followed by \texttt{" ()"}.  Aggregate types
(\texttt{struct}, \texttt{union}, \texttt{enum}) currently print only their
tag keyword; full member layout details are deferred to the semantic analysis
dump routines.

@d Types: dump @{
.Ltd_ptr:
    // Print pointee type then " *"
    ldr x0, [x19, #TY_F0]
    bl _kcc_type_dump
    adrp x0, _kcc_ty_str_ptr@@PAGE
    add  x0, x0, _kcc_ty_str_ptr@@PAGEOFF
    bl _kcc_io_puts
    b .Ltd_done
.Ltd_array:
    ldr x0, [x19, #TY_F0]
    bl _kcc_type_dump
    adrp x0, _kcc_ty_str_arr_open@@PAGE
    add  x0, x0, _kcc_ty_str_arr_open@@PAGEOFF
    bl _kcc_io_puts
    ldr x0, [x19, #TY_F1]
    bl _kcc_io_putu
    adrp x0, _kcc_ty_str_arr_close@@PAGE
    add  x0, x0, _kcc_ty_str_arr_close@@PAGEOFF
    bl _kcc_io_puts
    b .Ltd_done
.Ltd_func:
    ldr x0, [x19, #TY_F0]
    bl _kcc_type_dump
    adrp x0, _kcc_ty_str_func@@PAGE
    add  x0, x0, _kcc_ty_str_func@@PAGEOFF
    bl _kcc_io_puts
    b .Ltd_done
.Ltd_struct:
    adrp x0, _kcc_ty_str_struct@@PAGE
    add  x0, x0, _kcc_ty_str_struct@@PAGEOFF
    bl _kcc_io_puts
    b .Ltd_done
.Ltd_union:
    adrp x0, _kcc_ty_str_union@@PAGE
    add  x0, x0, _kcc_ty_str_union@@PAGEOFF
    bl _kcc_io_puts
    b .Ltd_done
.Ltd_enum:
    adrp x0, _kcc_ty_str_enum@@PAGE
    add  x0, x0, _kcc_ty_str_enum@@PAGEOFF
    bl _kcc_io_puts

.Ltd_done:
    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #32
    ret
@}

\section{Type Data}

This section collects the global storage for the type subsystem.  The
singleton pointers (one \texttt{.quad} per basic type) are initialised to
zero and filled by \texttt{kcc\_types\_init} at startup.  The string
literals in \texttt{\_\_TEXT,\_\_cstring} provide human-readable names used
by \texttt{kcc\_type\_dump} for diagnostic output.

@d Types: data @{
// -- Type singleton pointers ----------------------------------------------
.data
.globl _kcc_type_void
_kcc_type_void:       .quad 0
.globl _kcc_type_bool
_kcc_type_bool:       .quad 0
.globl _kcc_type_char_s
_kcc_type_char_s:     .quad 0
.globl _kcc_type_char_u
_kcc_type_char_u:     .quad 0
.globl _kcc_type_short_s
_kcc_type_short_s:    .quad 0
.globl _kcc_type_short_u
_kcc_type_short_u:    .quad 0
.globl _kcc_type_int_s
_kcc_type_int_s:      .quad 0
.globl _kcc_type_int_u
_kcc_type_int_u:      .quad 0
.globl _kcc_type_long_s
_kcc_type_long_s:     .quad 0
.globl _kcc_type_long_u
_kcc_type_long_u:     .quad 0
.globl _kcc_type_llong_s
_kcc_type_llong_s:    .quad 0
.globl _kcc_type_llong_u
_kcc_type_llong_u:    .quad 0
.globl _kcc_type_float
_kcc_type_float:      .quad 0
.globl _kcc_type_double
_kcc_type_double:     .quad 0
.globl _kcc_type_ldouble
_kcc_type_ldouble:    .quad 0

// -- Type name strings ----------------------------------------------------
.section __TEXT,__cstring,cstring_literals
_kcc_ty_str_void:     .asciz "void"
_kcc_ty_str_bool:     .asciz "_Bool"
_kcc_ty_str_char:     .asciz "char"
_kcc_ty_str_uchar:    .asciz "unsigned char"
_kcc_ty_str_short:    .asciz "short"
_kcc_ty_str_ushort:   .asciz "unsigned short"
_kcc_ty_str_int:      .asciz "int"
_kcc_ty_str_uint:     .asciz "unsigned int"
_kcc_ty_str_long:     .asciz "long"
_kcc_ty_str_ulong:    .asciz "unsigned long"
_kcc_ty_str_llong:    .asciz "long long"
_kcc_ty_str_ullong:   .asciz "unsigned long long"
_kcc_ty_str_float:    .asciz "float"
_kcc_ty_str_double:   .asciz "double"
_kcc_ty_str_ldouble:  .asciz "long double"
_kcc_ty_str_ptr:      .asciz " *"
_kcc_ty_str_arr_open: .asciz "["
_kcc_ty_str_arr_close:.asciz "]"
_kcc_ty_str_func:     .asciz " ()"
_kcc_ty_str_struct:   .asciz "struct"
_kcc_ty_str_union:    .asciz "union"
_kcc_ty_str_enum:     .asciz "enum"
_kcc_ty_str_const:    .asciz "const "
_kcc_ty_str_volatile: .asciz "volatile "
_kcc_ty_str_unknown:  .asciz "<unknown>"
_kcc_ty_str_null:     .asciz "<null>"
@| _kcc_type_void
@| _kcc_type_bool
@| _kcc_type_char_s
@| _kcc_type_char_u
@| _kcc_type_short_s
@| _kcc_type_short_u
@| _kcc_type_int_s
@| _kcc_type_int_u
@| _kcc_type_long_s
@| _kcc_type_long_u
@| _kcc_type_llong_s
@| _kcc_type_llong_u
@| _kcc_type_float
@| _kcc_type_double
@| _kcc_type_ldouble
@| _kcc_ty_str_void
