% 35-peephole.weft — Constant Folding and Identity Elimination
%
% This chapter implements peephole optimizations on the IR:
% 1. Constant folding: IR_CONST + IR_CONST → single IR_CONST
% 2. Identity elimination: x + 0, x * 1, x & ~0 → x

\chapter{Peephole Optimization}
\label{ch:peephole}

Peephole optimizations examine a small window of instructions and replace patterns that can be simplified without global analysis.  This chapter implements constant folding on the IR: an instruction whose inputs are all compile-time constants is evaluated at compile time and replaced with a single \texttt{IR\_CONST}.  Three shapes fold.  A \emph{binary} operation with two constant operands (\texttt{2 * 3}) evaluates directly.  A \emph{unary} \texttt{NEG} or \texttt{NOT} of a constant folds likewise---and although a bare 64-bit complement of \texttt{\~{}0u} is not the 32-bit \texttt{0xFFFFFFFF} the source means, the front end appends a width cast after every such operation, and that cast folds in turn, narrowing the value to the correct width.  That is the third and load-bearing shape: a \emph{width cast}---the \texttt{SEXT}/\texttt{ZEXT}/\texttt{TRUNC} inserted on nearly every integer operation---folds when its operand is constant.  Without it a constant chain stalls at the first cast (folding \texttt{3*4} but not the surrounding \texttt{2 + \dots - 1}, because the intervening sign-extend hid the intermediate constant), so folding through casts is what lets a whole constant expression collapse to one value.  All three feed the fixed-point loop of Chapter~\ref{ch:ir-passes}, so each fold that produces a fresh constant can unblock the next.

\section{Constant Folding}

Constant folding is the classic peephole optimization: when both operands
of a binary instruction are compile-time constants, we evaluate the
operation at compile time and replace the instruction with a single
\texttt{IR\_CONST}.  This eliminates work at run time and, equally
important, feeds additional constants into later iterations---an
\texttt{IR\_ADD} whose result becomes constant may enable a downstream
\texttt{IR\_MUL} to fold as well.

The implementation works in two linear passes over the function's basic
blocks.  Pass~1 scans every instruction and records which vregs were
produced by \texttt{IR\_CONST}; pass~2 revisits every binary operation
and, when both source vregs appear in the constant map, computes the
result and rewrites the instruction in place.  A dense array indexed by
vreg number stores the known constant values, with a parallel valid
array so we can distinguish ``not a constant'' from ``constant zero.''

\subsection{Building the Constant Map}

Before folding can begin we need a fast lookup from vreg number to
constant value.  We allocate two arena arrays sized to the function's
vreg count: \texttt{values[]} holds the immediate and \texttt{valid[]}
records whether a mapping exists.  Pass~1 then walks every instruction;
for each \texttt{IR\_CONST} it finds, it stores the immediate in the
corresponding slot and marks it valid.

@d Opt: constant fold @{
// -- kcc_opt_constfold ---
// uint64_t kcc_opt_constfold(ir_func *func)
// Folds constant expressions.  Returns number of folds performed.
.text
.globl _kcc_opt_constfold
.p2align 2
_kcc_opt_constfold:
    stp x29, x30, [sp, #-96]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    stp x25, x26, [sp, #64]
    str x27, [sp, #80]

    mov x19, x0                 // func
    mov x27, #0                 // fold count

    // Allocate const value map: array of (valid, value) pairs
    // Max vregs = func.vreg_n
    ldr x20, [x19, #IRF_VREG_N]
    cbz x20, .Lcf_done
    add x20, x20, #1            // +1 for safety

    // Allocate arrays: values[vreg_n] and valid[vreg_n]
    lsl x0, x20, #3             // values: 8 bytes each
    bl _kcc_arena_alloc
    mov x21, x0                 // x21 = values array

    mov x0, x20                 // valid: 1 byte each (we'll use 8)
    lsl x0, x0, #3
    bl _kcc_arena_alloc
    mov x22, x0                 // x22 = valid array

    // Zero valid array
    mov x0, x22
    mov x1, #0
    lsl x2, x20, #3
    bl _kcc_memset

    // Pass 1: collect all IR_CONST → record in map
    ldr x0, [x19, #IRF_BLOCKS]
    cbz x0, .Lcf_done
    mov x23, x0                 // blocks vec
    ldr x24, [x23, #VEC_COUNT]
    mov x25, #0

.Lcf_collect_bb:
    cmp x25, x24
    b.ge .Lcf_pass2

    mov x0, x23
    mov x1, x25
    bl _kcc_vec_get
    ldr x26, [x0]               // BB ptr

    ldr x0, [x26, #BB_FIRST]
.Lcf_collect_instr:
    cbz x0, .Lcf_collect_next_bb
    mov x26, x0                 // current instr

    ldr x1, [x26, #IR_OP]
    cmp x1, #IR_CONST
    b.ne .Lcf_collect_skip

    // Record: valid[dest] = 1, values[dest] = src1
    ldr x1, [x26, #IR_DEST]
    cmp x1, x20
    b.ge .Lcf_collect_skip
    mov x2, #1
    str x2, [x22, x1, lsl #3]
    ldr x2, [x26, #IR_SRC1]
    str x2, [x21, x1, lsl #3]

.Lcf_collect_skip:
    ldr x0, [x26, #IR_NEXT]
    b .Lcf_collect_instr

.Lcf_collect_next_bb:
    add x25, x25, #1
    b .Lcf_collect_bb
@| _kcc_opt_constfold
@}

\subsection{Folding Binary Operations}

With the constant map in hand, pass~2 walks every instruction a second
time.  For each binary operation (arithmetic, bitwise, shift, or
comparison) it checks whether both source vregs have entries in the
map.  When they do, the two constant values are loaded and the
appropriate operation is dispatched.  Non-binary opcodes and operations
with at least one non-constant source are skipped untouched.

@d Opt: constant fold @{
    // Pass 2: fold binary ops with two const sources
.Lcf_pass2:
    mov x25, #0

.Lcf_fold_bb:
    cmp x25, x24
    b.ge .Lcf_done

    mov x0, x23
    mov x1, x25
    bl _kcc_vec_get
    ldr x26, [x0]

    ldr x0, [x26, #BB_FIRST]
.Lcf_fold_instr:
    cbz x0, .Lcf_fold_next_bb
    mov x26, x0

    // A floating operation must never be folded with integer arithmetic: the
    // fold below negates/adds the raw 64-bit pattern, which is meaningless for a
    // double.  Skip any FP-typed instruction and let the back end materialise
    // the constant and compute with FADD/FNEG at run time.
    ldr x1, [x26, #IR_TYPE]
    cmp x1, #0x1000
    b.lo .Lcf_check_op
    ldr x2, [x1, #TY_KIND]
    cmp x2, #8                   // FLOAT
    b.lo .Lcf_check_op
    cmp x2, #10                  // ..LDOUBLE
    b.ls .Lcf_fold_skip
.Lcf_check_op:
    ldr x1, [x26, #IR_OP]
    // Width casts of a constant fold too: the front end inserts SEXT/ZEXT/TRUNC
    // on nearly every integer operation, and without folding through them a
    // constant chain stalls at the first cast (e.g. 2+3*4 folds 3*4 but the
    // sign-extend then blocks the add).
    cmp x1, #IR_SEXT
    b.eq .Lcf_ext
    cmp x1, #IR_ZEXT
    b.eq .Lcf_ext
    cmp x1, #IR_TRUNC
    b.eq .Lcf_ext
    // Check if it's a foldable binary op (1-7, 10-15, 20-25)
    cmp x1, #IR_ADD
    b.lt .Lcf_fold_skip
    cmp x1, #IR_CMP_SGE
    b.gt .Lcf_fold_skip
    // Unary NEG/NOT of a constant fold to a constant too; the width
    // normalization the front end appends is a cast that folds in turn, so the
    // 64-bit result is narrowed to the right width by the next iteration.
    cmp x1, #IR_NEG
    b.eq .Lcf_unary
    cmp x1, #IR_NOT
    b.eq .Lcf_unary

    // Check both sources are const
    ldr x2, [x26, #IR_SRC1]
    cmp x2, x20
    b.ge .Lcf_fold_skip
    ldr x3, [x22, x2, lsl #3]   // valid[src1]?
    cbz x3, .Lcf_fold_skip

    ldr x3, [x26, #IR_SRC2]
    cmp x3, x20
    b.ge .Lcf_fold_skip
    ldr x4, [x22, x3, lsl #3]   // valid[src2]?
    cbz x4, .Lcf_fold_skip

    // Both const! Get values
    ldr x2, [x26, #IR_SRC1]
    ldr x2, [x21, x2, lsl #3]   // val1
    ldr x3, [x26, #IR_SRC2]
    ldr x3, [x21, x3, lsl #3]   // val2

    // Compute result based on opcode
    ldr x1, [x26, #IR_OP]
    cmp x1, #IR_ADD
    b.eq .Lcf_do_add
    cmp x1, #IR_SUB
    b.eq .Lcf_do_sub
    cmp x1, #IR_MUL
    b.eq .Lcf_do_mul
    cmp x1, #IR_SDIV
    b.eq .Lcf_do_sdiv
    cmp x1, #IR_AND
    b.eq .Lcf_do_and
    cmp x1, #IR_OR
    b.eq .Lcf_do_or
    cmp x1, #IR_XOR
    b.eq .Lcf_do_xor
    cmp x1, #IR_SHL
    b.eq .Lcf_do_shl
    cmp x1, #IR_ASHR
    b.eq .Lcf_do_ashr
    cmp x1, #IR_CMP_EQ
    b.eq .Lcf_do_eq
    cmp x1, #IR_CMP_NE
    b.eq .Lcf_do_ne
    cmp x1, #IR_CMP_SLT
    b.eq .Lcf_do_slt
    cmp x1, #IR_CMP_SGT
    b.eq .Lcf_do_sgt
    b .Lcf_fold_skip
@}

\subsection{Arithmetic Dispatch}

Each foldable opcode maps to a short straight-line sequence that computes
the result in register \texttt{x4} from the two constant operands in
\texttt{x2} and \texttt{x3}.  After the computation, control falls
through to the replacement logic, which rewrites the original instruction
as an \texttt{IR\_CONST} carrying the folded value, updates the constant
map (so cascading folds work within the same pass), and increments the
fold counter.

@d Opt: constant fold @{
.Lcf_do_add:
    add x4, x2, x3
    b .Lcf_replace
.Lcf_do_sub:
    sub x4, x2, x3
    b .Lcf_replace
.Lcf_do_mul:
    mul x4, x2, x3
    b .Lcf_replace
.Lcf_do_sdiv:
    cbz x3, .Lcf_fold_skip      // div by zero: skip
    sdiv x4, x2, x3
    b .Lcf_replace
.Lcf_do_and:
    and x4, x2, x3
    b .Lcf_replace
.Lcf_do_or:
    orr x4, x2, x3
    b .Lcf_replace
.Lcf_do_xor:
    eor x4, x2, x3
    b .Lcf_replace
.Lcf_do_shl:
    lsl x4, x2, x3
    b .Lcf_replace
.Lcf_do_ashr:
    asr x4, x2, x3
    b .Lcf_replace
.Lcf_do_eq:
    cmp x2, x3
    cset x4, eq
    b .Lcf_replace
.Lcf_do_ne:
    cmp x2, x3
    cset x4, ne
    b .Lcf_replace
.Lcf_do_slt:
    cmp x2, x3
    cset x4, lt
    b .Lcf_replace
.Lcf_do_sgt:
    cmp x2, x3
    cset x4, gt
    b .Lcf_replace

.Lcf_unary:
    ldr x2, [x26, #IR_SRC1]
    cmp x2, x20
    b.ge .Lcf_fold_skip
    ldr x3, [x22, x2, lsl #3]
    cbz x3, .Lcf_fold_skip
    ldr x2, [x21, x2, lsl #3]
    ldr x1, [x26, #IR_OP]
    cmp x1, #IR_NEG
    b.eq .Lcf_un_neg
    mvn x4, x2
    b .Lcf_replace
.Lcf_un_neg:
    neg x4, x2
    b .Lcf_replace

.Lcf_ext:
    // Fold a width cast of a constant.  SEXT/ZEXT read the source width from
    // SRC2; TRUNC reads the target width from its result type.  The folded
    // value is the constant sign- or zero-adjusted to that width.
    ldr x2, [x26, #IR_SRC1]
    cmp x2, x20
    b.ge .Lcf_fold_skip
    ldr x3, [x22, x2, lsl #3]   // valid[src1]?
    cbz x3, .Lcf_fold_skip
    ldr x2, [x21, x2, lsl #3]   // val
    ldr x1, [x26, #IR_OP]
    cmp x1, #IR_TRUNC
    b.eq .Lcf_ext_trunc
    ldr x5, [x26, #IR_SRC2]     // source width (bytes)
    cbz x5, .Lcf_fold_skip
    cmp x5, #8
    b.hs .Lcf_ext_id
    cmp x1, #IR_ZEXT
    b.eq .Lcf_ext_mask
    // SEXT: sign-extend from width*8 bits
    lsl x6, x5, #3
    mov x7, #64
    sub x7, x7, x6
    lsl x4, x2, x7
    asr x4, x4, x7
    b .Lcf_replace
.Lcf_ext_trunc:
    ldr x5, [x26, #IR_TYPE]
    cbz x5, .Lcf_fold_skip
    ldr x5, [x5, #TY_SIZE]      // target width
    cbz x5, .Lcf_fold_skip
    cmp x5, #8
    b.hs .Lcf_ext_id
.Lcf_ext_mask:
    // ZEXT / TRUNC: keep the low width*8 bits, zero the rest
    lsl x6, x5, #3
    mov x7, #1
    lsl x7, x7, x6
    sub x7, x7, #1
    and x4, x2, x7
    b .Lcf_replace
.Lcf_ext_id:
    mov x4, x2                  // width >= 8: value unchanged

.Lcf_replace:
    // Replace instruction with IR_CONST
    mov x1, #IR_CONST
    str x1, [x26, #IR_OP]
    str x4, [x26, #IR_SRC1]     // folded value
    str xzr, [x26, #IR_SRC2]

    // Update const map
    ldr x1, [x26, #IR_DEST]
    cmp x1, x20
    b.ge .Lcf_fold_count
    mov x2, #1
    str x2, [x22, x1, lsl #3]
    str x4, [x21, x1, lsl #3]

.Lcf_fold_count:
    add x27, x27, #1

.Lcf_fold_skip:
    ldr x0, [x26, #IR_NEXT]
    b .Lcf_fold_instr

.Lcf_fold_next_bb:
    add x25, x25, #1
    b .Lcf_fold_bb

.Lcf_done:
    mov x0, x27                 // return fold count

    ldr x27, [sp, #80]
    ldp x25, x26, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #96
    ret
@}

\section{Strength Reduction and Algebraic Simplification}
\label{sec:opt-strength}

Constant folding collapses expressions whose operands are \emph{all}
constant.  A second, complementary peephole handles the common case where
only \emph{one} operand is constant: a multiply, unsigned divide, or
unsigned remainder by a power of two, which the target lowers far more
cheaply as a shift or a mask.  Because these rewrites are pure IR-to-IR
transforms they belong above the code generator, so every back end inherits
them.  \texttt{\_kcc\_opt\_strength} reuses the constant map built exactly as
in constant folding (a values array and a parallel valid array indexed by
vreg), then walks each block a second time and rewrites:

\begin{itemize}
\item \texttt{x * 2\textsuperscript{k}} $\to$ \texttt{x << k}.  Correct for
      both signed and unsigned operands: two's-complement multiplication and
      a left shift agree bit-for-bit, overflow included.
\item \texttt{x /\textsubscript{u} 2\textsuperscript{k}} $\to$
      \texttt{x >>\textsubscript{u} k} (logical), for \emph{unsigned} divide
      only.  A signed \texttt{SDIV} rounds toward zero while an arithmetic
      shift rounds toward $-\infty$, so \texttt{SDIV}/\texttt{SMOD} are left
      untouched.
\item \texttt{x \%\textsubscript{u} 2\textsuperscript{k}} $\to$
      \texttt{x \& (2\textsuperscript{k}-1)}, unsigned only.
\item \texttt{x * 0} and \texttt{x \& 0} $\to$ the constant 0, rewritten in
      place like a fold.
\end{itemize}

A shift or mask needs a fresh constant for its amount, so the pass allocates
an \texttt{IR\_CONST} (drawing a new vreg straight from the function's
\texttt{IRF\_VREG\_N} counter) and splices it into the block's instruction
list immediately before the rewritten instruction---which is why the walk
tracks the previous instruction.  Floating-point instructions are skipped
outright: a \texttt{double} multiply carries an \texttt{IR\_MUL} whose
constant operand is an IEEE-754 bit pattern that can \emph{look} like a power
of two (\texttt{2.0} is \texttt{0x4000\dots0}), and turning that into a shift
would be catastrophic.  The pass feeds the same fixed-point loop as the other
peepholes, and its rewrites are behaviour-preserving, so the differential
corpus, Lua, and zlib are the oracle rather than byte-identical output.

@d Opt: strength reduction @{
// -- kcc_opt_strength ---
// uint64_t kcc_opt_strength(ir_func *func) -> number of rewrites.
// Strength reduction + algebraic simplification, all behaviour-preserving:
//   x * 2^k   -> x << k          (signed & unsigned)
//   x /u 2^k  -> x >>u k         (UDIV only; SDIV rounds differently)
//   x %u 2^k  -> x & (2^k - 1)   (UMOD only)
//   x * 0, x & 0 -> const 0
.text
.globl _kcc_opt_strength
.p2align 2
_kcc_opt_strength:
    stp x29, x30, [sp, #-112]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    stp x25, x26, [sp, #64]
    stp x27, x28, [sp, #80]

    mov x19, x0                 // func
    mov x23, #0                 // rewrite count

    ldr x20, [x19, #IRF_VREG_N]
    cbz x20, .Lsr_done
    add x20, x20, #1            // map size (const map covers old vregs only)

    lsl x0, x20, #3
    bl _kcc_arena_alloc
    mov x21, x0                 // values[]
    mov x0, x20
    lsl x0, x0, #3
    bl _kcc_arena_alloc
    mov x22, x0                 // valid[]
    mov x0, x22
    mov x1, #0
    lsl x2, x20, #3
    bl _kcc_memset

    // Pass 1: record every IR_CONST's (dest -> value).
    ldr x24, [x19, #IRF_ENTRY]
.Lsr_col_bb:
    cbz x24, .Lsr_pass2
    ldr x0, [x24, #BB_FIRST]
.Lsr_col_i:
    cbz x0, .Lsr_col_nb
    ldr x1, [x0, #IR_OP]
    cmp x1, #IR_CONST
    b.ne .Lsr_col_sk
    ldr x1, [x0, #IR_DEST]
    cmp x1, x20
    b.ge .Lsr_col_sk
    mov x2, #1
    str x2, [x22, x1, lsl #3]
    ldr x2, [x0, #IR_SRC1]
    str x2, [x21, x1, lsl #3]
.Lsr_col_sk:
    ldr x0, [x0, #IR_NEXT]
    b .Lsr_col_i
.Lsr_col_nb:
    ldr x24, [x24, #BB_NEXT]
    b .Lsr_col_bb

.Lsr_pass2:
    ldr x24, [x19, #IRF_ENTRY]
.Lsr_bb:
    cbz x24, .Lsr_done
    mov x26, #0                 // prev = 0
    ldr x25, [x24, #BB_FIRST]   // cur
.Lsr_i:
    cbz x25, .Lsr_nb

    // Skip floating-point instructions: a constant FP operand is a raw
    // IEEE-754 pattern, not an integer power of two.
    ldr x1, [x25, #IR_TYPE]
    cmp x1, #0x1000
    b.lo .Lsr_intop
    ldr x2, [x1, #TY_KIND]
    cmp x2, #8
    b.lo .Lsr_intop
    cmp x2, #10
    b.ls .Lsr_next
.Lsr_intop:
    ldr x9, [x25, #IR_OP]
    cmp x9, #IR_MUL
    b.eq .Lsr_mul
    cmp x9, #IR_UDIV
    b.eq .Lsr_udiv
    cmp x9, #IR_UMOD
    b.eq .Lsr_umod
    b .Lsr_next

.Lsr_mul:
    // Multiplication is commutative: try SRC2 first, then SRC1.
    ldr x10, [x25, #IR_SRC2]
    bl _kcc_opt_sr_cval         // x0 = const value if SRC2 const, else marker
    cbz x0, .Lsr_mul_s1
    mov x12, x1                 // C
    ldr x27, [x25, #IR_SRC1]    // x operand
    b .Lsr_mul_have
.Lsr_mul_s1:
    ldr x10, [x25, #IR_SRC1]
    bl _kcc_opt_sr_cval
    cbz x0, .Lsr_next
    mov x12, x1                 // C
    ldr x27, [x25, #IR_SRC2]    // x operand
.Lsr_mul_have:
    cbz x12, .Lsr_to_zero       // x * 0 -> 0
    cmp x12, #2
    b.lt .Lsr_next              // C == 1 (identity) or negative: leave alone
    sub x14, x12, #1
    tst x12, x14
    b.ne .Lsr_next              // not a power of two
    clz x15, x12
    mov x0, #63
    sub x28, x0, x15            // amount = log2(C)
    mov x9, #IR_SHL
    b .Lsr_emit

.Lsr_udiv:
    ldr x10, [x25, #IR_SRC2]    // divisor (not commutative)
    bl _kcc_opt_sr_cval
    cbz x0, .Lsr_next
    mov x12, x1
    cmp x12, #2
    b.lt .Lsr_next              // /1 identity or /0 undefined
    sub x14, x12, #1
    tst x12, x14
    b.ne .Lsr_next
    clz x15, x12
    mov x0, #63
    sub x28, x0, x15            // amount = log2(C)
    ldr x27, [x25, #IR_SRC1]
    mov x9, #IR_LSHR
    b .Lsr_emit

.Lsr_umod:
    ldr x10, [x25, #IR_SRC2]
    bl _kcc_opt_sr_cval
    cbz x0, .Lsr_next
    mov x12, x1
    cmp x12, #1
    b.lt .Lsr_next             // %0 undefined
    sub x14, x12, #1
    tst x12, x14
    b.ne .Lsr_next             // C=1 passes (mask 0 -> x%1 == 0)
    sub x28, x12, #1           // mask = C - 1
    ldr x27, [x25, #IR_SRC1]
    mov x9, #IR_AND
    b .Lsr_emit

.Lsr_to_zero:
    mov x0, #IR_CONST
    str x0, [x25, #IR_OP]
    str xzr, [x25, #IR_SRC1]
    str xzr, [x25, #IR_SRC2]
    add x23, x23, #1
    b .Lsr_next

.Lsr_emit:
    // x27 = value operand vreg, x28 = shift/mask amount, x9 = new opcode.
    // Splice a fresh IR_CONST(amount) before cur, then rewrite cur.
    str x9, [sp, #96]           // stash new opcode across calls
    mov x0, #IR_CONST
    bl _kcc_ir_alloc_instr
    str x0, [sp, #104]          // stash const instr
    adrp x1, _kcc_type_int_s@@PAGE
    add  x1, x1, _kcc_type_int_s@@PAGEOFF
    ldr x1, [x1]
    str x1, [x0, #IR_TYPE]
    str x28, [x0, #IR_SRC1]     // the amount
    str xzr, [x0, #IR_SRC2]
    // Fresh vreg straight from this function's counter.
    ldr x1, [x19, #IRF_VREG_N]
    add x2, x1, #1
    str x2, [x19, #IRF_VREG_N]
    ldr x0, [sp, #104]
    str x1, [x0, #IR_DEST]      // const.dest = new vreg
    mov x11, x1                 // new vreg number
    str x25, [x0, #IR_NEXT]     // const.next = cur
    cbz x26, .Lsr_emit_head
    str x0, [x26, #IR_NEXT]     // prev.next = const
    b .Lsr_emit_rw
.Lsr_emit_head:
    str x0, [x24, #BB_FIRST]    // block head = const
.Lsr_emit_rw:
    ldr x9, [sp, #96]
    str x9, [x25, #IR_OP]       // cur becomes SHL/LSHR/AND
    str x27, [x25, #IR_SRC1]    // value operand
    str x11, [x25, #IR_SRC2]    // amount vreg
    add x23, x23, #1

.Lsr_next:
    mov x26, x25               // prev = cur
    ldr x25, [x25, #IR_NEXT]   // cur = cur.next
    b .Lsr_i
.Lsr_nb:
    ldr x24, [x24, #BB_NEXT]
    b .Lsr_bb

.Lsr_done:
    mov x0, x23
    ldp x27, x28, [sp, #80]
    ldp x25, x26, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #112
    ret

// -- kcc_opt_sr_cval ---
// Helper: given a vreg in x10 and the const map (x20 size, x21 values,
// x22 valid), return x0 = 1 and x1 = value if the vreg holds a known
// constant, else x0 = 0.  Leaf; clobbers x0-x3 only.
.p2align 2
_kcc_opt_sr_cval:
    cmp x10, x20
    b.ge .Lsrc_no
    ldr x2, [x22, x10, lsl #3]
    cbz x2, .Lsrc_no
    ldr x1, [x21, x10, lsl #3]
    mov x0, #1
    ret
.Lsrc_no:
    mov x0, #0
    ret
@}
