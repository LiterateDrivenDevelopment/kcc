S(s_pop_r13, "\tpopq\t%r13\n"); S(s_pop_r14, "\tpopq\t%r14\n");
S(s_cl_r10, "%cl, %r10\n"); S(s_c_r10, ", %r10\n"); S(s_c_r10d, ", %r10d\n");
S(s_pr11_r10, "(%r11), %r10\n"); S(s_pr11_r10d, "(%r11), %r10d\n");
