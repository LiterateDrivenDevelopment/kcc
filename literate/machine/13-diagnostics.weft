% 13-diagnostics.weft — Diagnostic Engine
%
% ISO 9899:2018 §5.1.1.3 requires that a conforming implementation
% produce at least one diagnostic message if a preprocessing translation
% unit or translation unit contains a violation of any syntax rule or
% constraint.
%
% The diagnostic engine provides structured error reporting in the
% format universally adopted by compilers:
%
%     file:line:col: severity: message
%
% Three severity levels are supported: error (constraint violation),
% warning (suspicious but permitted construct), and note (additional
% context for a preceding diagnostic).  An error count is maintained,
% and compilation aborts if it exceeds a configurable fatal limit.

\chapter{Diagnostic Engine}
\label{ch:diagnostics}

The C standard (\stdref{5.1.1.3}) requires that a conforming implementation issue at least one diagnostic for any syntax rule or constraint violation.
This chapter implements a structured diagnostic engine that formats messages in the conventional \texttt{file:line:col: severity: message} form, supports three severity levels (error, warning, note), and enforces a fatal error limit to prevent cascading output from overwhelming the user.

\section{Severity Levels}

The C standard distinguishes only ``diagnostic message'' from other
output, but modern practice recognizes three levels: errors that prevent
translation, warnings that flag suspicious code, and notes that provide
supplementary context.  We encode these as integer constants.

The fatal error limit prevents the compiler from drowning the user
in cascading errors.  After \texttt{DIAG\_MAX\_ERRORS} errors, the
engine prints a summary and calls \texttt{sys\_exit(1)}.

@d Diag: constants @{
// -- Diagnostic severity codes ---
.equ DIAG_ERROR,       0
.equ DIAG_WARNING,     1
.equ DIAG_NOTE,        2

// Maximum errors before aborting
.equ DIAG_MAX_ERRORS, 20
@}

\section{Stderr Integer Output}

The diagnostic engine needs to print line and column numbers to stderr.
This helper converts a \texttt{uint64\_t} to decimal ASCII and writes
it directly to file descriptor~2 via \texttt{sys\_write}.  The algorithm
mirrors \texttt{kcc\_io\_putu} (Chapter~\ref{ch:io}) but bypasses the
stdout buffer.

@d Diag: putu stderr @{
// -- _kcc_diag_putu ---
// void _kcc_diag_putu(uint64_t n)
//   x0 = unsigned integer to print
// Outputs the decimal representation directly to stderr (fd=2).
.p2align 2
_kcc_diag_putu:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    str x19, [sp, #16]

    mov x19, x0                  // x19 = number
    add x3, sp, #48              // x3 = one past end of digit buffer
    mov x4, x3                   // x4 = saved end pointer

    // Handle zero specially
    cbnz x19, .Ldiag_putu_nonzero
    mov w1, #'0'
    sub x3, x3, #1
    strb w1, [x3]
    b .Ldiag_putu_print

.Ldiag_putu_nonzero:
    mov x5, #10
.Ldiag_putu_loop:
    udiv x1, x19, x5            // x1 = n / 10
    msub x2, x1, x5, x19        // x2 = n % 10
    add  w2, w2, #'0'           // convert to ASCII digit
    sub  x3, x3, #1
    strb w2, [x3]
    mov  x19, x1
    cbnz x19, .Ldiag_putu_loop

.Ldiag_putu_print:
    // sys_write(2, digits, count)
    mov x0, #2                  // fd = stderr
    mov x1, x3                  // buffer
    sub x2, x4, x3              // length
    bl _kcc_sys_write

    ldr x19, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@}

\section{Core Emission}

The heart of the diagnostic engine is \texttt{kcc\_diag\_emit}.  Given
a severity level, source location, and message string, it writes the
full diagnostic to stderr in the standard format.

Each component (file path, colon, number, severity label, message) is
written as a separate string to stderr.  This avoids the need for
\texttt{sprintf}-style formatting.  Stderr writes are unbuffered, so
diagnostics appear immediately even if the program crashes.

After an error diagnostic, the error counter is incremented.  If it
reaches \texttt{DIAG\_MAX\_ERRORS}, a ``too many errors'' message is
printed and the process exits with status~1.

@d Diag: emit @{
// -- kcc_diag_emit ---
// void kcc_diag_emit(int severity, uint64_t line, uint64_t col,
//                    const char *msg)
//   x0 = severity (DIAG_ERROR/DIAG_WARNING/DIAG_NOTE)
//   x1 = line number (1-based)
//   x2 = column number (1-based)
//   x3 = pointer to null-terminated message string
// Writes: file:line:col: severity: message\n   to stderr.
.globl _kcc_diag_emit
.p2align 2
_kcc_diag_emit:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    str x23, [sp, #48]

    mov x19, x0                  // x19 = severity
    mov x20, x1                  // x20 = line
    mov x21, x2                  // x21 = column
    mov x22, x3                  // x22 = message

    // Print file path (from source manager)
    adrp x0, _kcc_src_path@@PAGE
    add  x0, x0, _kcc_src_path@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Ldiag_no_path
    bl _kcc_io_err
    b .Ldiag_colon1
.Ldiag_no_path:
    adrp x0, _kcc_diag_unknown_file@@PAGE
    add  x0, x0, _kcc_diag_unknown_file@@PAGEOFF
    bl _kcc_io_err

.Ldiag_colon1:
    // Print ":"
    adrp x0, _kcc_diag_colon@@PAGE
    add  x0, x0, _kcc_diag_colon@@PAGEOFF
    bl _kcc_io_err

    // Print line number
    mov x0, x20
    bl _kcc_diag_putu

    // Print ":"
    adrp x0, _kcc_diag_colon@@PAGE
    add  x0, x0, _kcc_diag_colon@@PAGEOFF
    bl _kcc_io_err

    // Print column number
    mov x0, x21
    bl _kcc_diag_putu

    // Print ": "
    adrp x0, _kcc_diag_colon_space@@PAGE
    add  x0, x0, _kcc_diag_colon_space@@PAGEOFF
    bl _kcc_io_err

    // Print severity string based on level
    cmp x19, #DIAG_WARNING
    b.eq .Ldiag_sev_warn
    cmp x19, #DIAG_NOTE
    b.eq .Ldiag_sev_note
    // Default: error
    adrp x0, _kcc_diag_str_error@@PAGE
    add  x0, x0, _kcc_diag_str_error@@PAGEOFF
    b .Ldiag_sev_done
.Ldiag_sev_warn:
    adrp x0, _kcc_diag_str_warning@@PAGE
    add  x0, x0, _kcc_diag_str_warning@@PAGEOFF
    b .Ldiag_sev_done
.Ldiag_sev_note:
    adrp x0, _kcc_diag_str_note@@PAGE
    add  x0, x0, _kcc_diag_str_note@@PAGEOFF
.Ldiag_sev_done:
    bl _kcc_io_err

    // Print ": "
    adrp x0, _kcc_diag_colon_space@@PAGE
    add  x0, x0, _kcc_diag_colon_space@@PAGEOFF
    bl _kcc_io_err

    // Print message
    mov x0, x22
    bl _kcc_io_err

    // Print newline
    adrp x0, _kcc_diag_newline@@PAGE
    add  x0, x0, _kcc_diag_newline@@PAGEOFF
    bl _kcc_io_err

    // Print the offending source line and a caret under the column
    mov x0, x20                  // line
    mov x1, x21                  // column
    bl _kcc_diag_caret

    // Update counters based on severity
    cmp x19, #DIAG_ERROR
    b.ne .Ldiag_check_warn

    // Increment error count
    adrp x0, _kcc_diag_error_count@@PAGE
    add  x0, x0, _kcc_diag_error_count@@PAGEOFF
    ldr  x1, [x0]
    add  x1, x1, #1
    str  x1, [x0]

    // Check fatal error limit
    cmp x1, #DIAG_MAX_ERRORS
    b.lt .Ldiag_done

    // Too many errors — abort
    adrp x0, _kcc_diag_too_many@@PAGE
    add  x0, x0, _kcc_diag_too_many@@PAGEOFF
    bl _kcc_io_err
    mov x0, #1
    bl _kcc_sys_exit

.Ldiag_check_warn:
    cmp x19, #DIAG_WARNING
    b.ne .Ldiag_done

    // Increment warning count
    adrp x0, _kcc_diag_warn_count@@PAGE
    add  x0, x0, _kcc_diag_warn_count@@PAGEOFF
    ldr  x1, [x0]
    add  x1, x1, #1
    str  x1, [x0]

.Ldiag_done:
    ldr x23, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@| _kcc_diag_emit
@}

\section{Source Snippet and Caret}

A location alone (\texttt{file:line:col}) tells the reader \emph{where}
the problem is; a caret shows it.  Immediately after the message line,
\kcc{} reproduces the offending source line verbatim and, on the line
below, a single \texttt{\char`\^} positioned under the reported column ---
exactly the presentation \texttt{clang} and \texttt{gcc} use.  This turns
an abstract coordinate into something the eye lands on directly.

The routine reads straight from the live source buffer
(\texttt{\_kcc\_src\_base}/\texttt{\_kcc\_src\_size}), which the driver
leaves pointing at the current translation unit and the preprocessor
restores to the includer on every \texttt{\#include} pop.  It is written
to be \emph{unfailing}: a null buffer, a zero line, or a line number
past the end of the file simply suppresses the snippet rather than
risking a bad read --- diagnostics must never themselves crash.  Because
carets only render on the error path, and every valid program never
reaches it, they add nothing to the output of correct code.

Two details make the caret land in the right place.  First, the column
is 1-based, so the indent is \texttt{col\,$-$\,1} characters.  Second,
to stay aligned when the line contains tabs, the indent is copied
\emph{from the source line itself} --- a tab in the source yields a tab
in the caret line, a non-tab yields a space --- so the terminal's own
tab stops keep the \texttt{\char`\^} under the right glyph.  The whole
caret line is assembled in a stack buffer and written in one syscall;
an over-long indent is clamped to the buffer, which at worst nudges the
caret left on a pathologically wide line.

@d Diag: caret @{
// -- _kcc_diag_caret ---
// void _kcc_diag_caret(uint64_t line, uint64_t col)
//   x0 = line (1-based), x1 = column (1-based)
// Prints the source line for `line`, then a caret under `col`.
// No-op if the source buffer is absent or the line is out of range.
.equ CARET_MAX, 500
.p2align 2
_kcc_diag_caret:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    sub sp, sp, #512             // scratch buffer for the caret line

    mov x24, x0                  // x24 = line
    mov x19, x1                  // x19 = col

    adrp x2, _kcc_src_base@@PAGE
    add  x2, x2, _kcc_src_base@@PAGEOFF
    ldr  x2, [x2]                // x2 = base
    cbz  x2, .Lcaret_done
    cbz  x24, .Lcaret_done       // line 0 → nothing to show
    adrp x3, _kcc_src_size@@PAGE
    add  x3, x3, _kcc_src_size@@PAGEOFF
    ldr  x3, [x3]
    add  x22, x2, x3             // x22 = end pointer

    // Walk to the start of the target line
    mov  x4, x2                  // p = base
    mov  x5, #1                  // curline
.Lcaret_findline:
    cmp  x5, x24
    b.ge .Lcaret_found
.Lcaret_scan:
    cmp  x4, x22
    b.hs .Lcaret_done           // ran off the end before reaching line
    ldrb w6, [x4], #1
    cmp  w6, #10                // '\n'
    b.ne .Lcaret_scan
    add  x5, x5, #1
    b    .Lcaret_findline
.Lcaret_found:
    mov  x20, x4                 // x20 = line start
    mov  x21, x4                 // x21 = line end (scan forward)
.Lcaret_endscan:
    cmp  x21, x22
    b.hs .Lcaret_printline
    ldrb w6, [x21]
    cmp  w6, #10
    b.eq .Lcaret_printline
    add  x21, x21, #1
    b    .Lcaret_endscan

.Lcaret_printline:
    // Write the source line [x20, x21) to stderr, then a newline
    mov  x0, #2
    mov  x1, x20
    sub  x2, x21, x20
    bl   _kcc_sys_write
    adrp x0, _kcc_diag_newline@@PAGE
    add  x0, x0, _kcc_diag_newline@@PAGEOFF
    bl   _kcc_io_err

    // Build the caret line: (col-1) indent chars, then '^', then '\n'
    mov  x23, sp                 // x23 = stack buffer
    mov  x9, #0                  // x9 = bytes in buffer
    subs x10, x19, #1            // x10 = indent count = col-1
    b.le .Lcaret_put             // col <= 1 → no indent
    mov  x11, x20                // x11 = source cursor (for tab copy)
.Lcaret_indent:
    cmp  x10, #0
    b.eq .Lcaret_put
    cmp  x9, #CARET_MAX
    b.hs .Lcaret_put            // clamp pathologically wide lines
    mov  w12, #32               // default: space
    cmp  x11, x21
    b.hs .Lcaret_store
    ldrb w13, [x11]
    cmp  w13, #9                // tab → copy tab for alignment
    b.ne .Lcaret_store
    mov  w12, #9
.Lcaret_store:
    strb w12, [x23, x9]
    add  x9, x9, #1
    add  x11, x11, #1
    sub  x10, x10, #1
    b    .Lcaret_indent
.Lcaret_put:
    mov  w12, #0x5E             // '^'
    strb w12, [x23, x9]
    add  x9, x9, #1
    mov  w12, #10              // '\n'
    strb w12, [x23, x9]
    add  x9, x9, #1
    mov  x0, #2
    mov  x1, x23
    mov  x2, x9
    bl   _kcc_sys_write

.Lcaret_done:
    add sp, sp, #512
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@| _kcc_diag_caret
@}

\section{Convenience Wrappers}

Three wrappers provide a simpler calling convention for the common
case where the caller already has line, column, and message:

\begin{center}
\begin{tabular}{ll}
\texttt{kcc\_diag\_error(line, col, msg)} & emits an error \\
\texttt{kcc\_diag\_warning(line, col, msg)} & emits a warning \\
\texttt{kcc\_diag\_note(line, col, msg)} & emits a note \\
\end{tabular}
\end{center}

These are tail-call wrappers: they rearrange the arguments and branch
(not \texttt{bl}) to \texttt{kcc\_diag\_emit}, so the return address
in \reg{x30} passes through untouched.

@d Diag: error @{
// -- kcc_diag_error ---
// void kcc_diag_error(uint64_t line, uint64_t col, const char *msg)
//   x0 = line, x1 = col, x2 = msg
.globl _kcc_diag_error
.p2align 2
_kcc_diag_error:
    mov x3, x2                   // msg → x3
    mov x2, x1                   // col → x2
    mov x1, x0                   // line → x1
    mov x0, #DIAG_ERROR          // severity → x0
    b _kcc_diag_emit             // tail call
@| _kcc_diag_error
@}

The warning wrapper is identical in structure, substituting
\texttt{DIAG\_WARNING} for the severity argument.

@d Diag: warning @{
// -- kcc_diag_warning ---
// void kcc_diag_warning(uint64_t line, uint64_t col, const char *msg)
.globl _kcc_diag_warning
.p2align 2
_kcc_diag_warning:
    mov x3, x2
    mov x2, x1
    mov x1, x0
    mov x0, #DIAG_WARNING
    b _kcc_diag_emit
@| _kcc_diag_warning
@}

The note wrapper completes the set, using \texttt{DIAG\_NOTE}
as the severity.  Notes are typically emitted immediately after an
error to provide additional context (e.g., ``previous definition
was here'').

@d Diag: note @{
// -- kcc_diag_note ---
// void kcc_diag_note(uint64_t line, uint64_t col, const char *msg)
.globl _kcc_diag_note
.p2align 2
_kcc_diag_note:
    mov x3, x2
    mov x2, x1
    mov x1, x0
    mov x0, #DIAG_NOTE
    b _kcc_diag_emit
@| _kcc_diag_note
@}

\section{Error Count Query}

\texttt{kcc\_diag\_had\_errors} returns the current error count.
The driver uses this after tokenization to decide whether to continue
with subsequent phases or exit with a failure status.

@d Diag: had errors @{
// -- kcc_diag_had_errors ---
// uint64_t kcc_diag_had_errors(void)
// Returns the error count in x0.
.globl _kcc_diag_had_errors
.p2align 2
_kcc_diag_had_errors:
    adrp x0, _kcc_diag_error_count@@PAGE
    add  x0, x0, _kcc_diag_error_count@@PAGEOFF
    ldr  x0, [x0]
    ret
@| _kcc_diag_had_errors
@}

\section{Reset}

\texttt{kcc\_diag\_reset} clears both error and warning counters.
This is used by the test harness between individual tests to prevent
counters from one test affecting the next.

@d Diag: reset @{
// -- kcc_diag_reset ---
// void kcc_diag_reset(void)
// Resets error and warning counts to zero.
.globl _kcc_diag_reset
.p2align 2
_kcc_diag_reset:
    adrp x0, _kcc_diag_error_count@@PAGE
    add  x0, x0, _kcc_diag_error_count@@PAGEOFF
    str  xzr, [x0]
    adrp x0, _kcc_diag_warn_count@@PAGE
    add  x0, x0, _kcc_diag_warn_count@@PAGEOFF
    str  xzr, [x0]
    ret
@| _kcc_diag_reset
@}

\section{Global State}

The diagnostic engine maintains two counters, a set of format
strings, and a single policy flag.  The counters are initialized to
zero by the \texttt{.data} section.  \texttt{\_kcc\_warn\_all} records
whether \texttt{-Wall} was passed on the command line; the driver sets
it while scanning arguments, and the warning checks scattered through
semantic analysis consult it before emitting.  Keeping the whole
\texttt{-Wall} family behind one default-off flag means a compile
without it produces exactly the output it did before warnings existed,
so no existing test's stderr shifts.

@d Diag: data @{
// -- Diagnostic global state ---
.data
.p2align 3
_kcc_diag_error_count:  .quad 0    // running error count
_kcc_diag_warn_count:   .quad 0    // running warning count
.globl _kcc_warn_all
_kcc_warn_all:          .quad 0    // -Wall enabled (set by the driver from argv)

// Format strings (read-only)
.section __TEXT,__cstring,cstring_literals
_kcc_diag_colon:         .asciz ":"
_kcc_diag_colon_space:   .asciz ": "
_kcc_diag_newline:       .asciz "\n"
_kcc_diag_str_error:     .asciz "error"
_kcc_diag_str_warning:   .asciz "warning"
_kcc_diag_str_note:      .asciz "note"
_kcc_diag_unknown_file:  .asciz "<input>"
_kcc_diag_too_many:      .asciz "kcc: fatal: too many errors emitted, stopping\n"
@| _kcc_diag_error_count
@| _kcc_diag_warn_count
@| _kcc_warn_all
@| _kcc_diag_colon
@| _kcc_diag_colon_space
@| _kcc_diag_newline
@| _kcc_diag_str_error
@| _kcc_diag_str_warning
@| _kcc_diag_str_note
@| _kcc_diag_unknown_file
@| _kcc_diag_too_many
@}

\section{Diagnostic Tests}
\label{sec:diag-tests}

Correct diagnostics are as much a feature as correct code generation, and
they need their own kind of test: not a program that compiles and runs, but
one that \emph{must not}.  The harness below feeds \kcc{} a series of invalid
translation units and checks that the compiler (a)~exits non-zero,
(b)~prints the expected error text, and (c)~does not hang---each run is wrapped
in an \texttt{alarm} so a runaway recovery loop fails loudly instead of
stalling the suite.  A final ``clean'' case guards the other direction: an
implicit \texttt{printf} call must still compile without an
undeclared-identifier error, so the leniency the call path depends on is not
lost.  \texttt{make diagtest} runs it.

@d Diag: tests @{
#!/bin/bash
BASE="$(cd "$(dirname "$0")/.." && pwd)"
# kcc diagnostic tests (invalid inputs must be rejected clearly) — generated by weft
set -u
PASS=0
FAIL=0
KCC="$BASE/kcc"
TMP="/$BASE/kcc_diag_$$"
mkdir -p "$TMP"
trap 'rm -rf "$TMP"' EXIT

# run_diag name mode pattern src
#   mode=err   : expect a non-zero exit whose output contains <pattern>
#   mode=clean : expect a zero exit (no diagnostics)
run_diag() {
    local name="$1"; local mode="$2"; local pattern="$3"; local src="$4"
    printf '%s\n' "$src" > "$TMP/d.c"
    local out rc
    out=$(perl -e 'alarm 8; exec @@ARGV' "$KCC" -c "$TMP/d.c" -o "$TMP/d.o" 2>&1)
    rc=$?
    if [ "$rc" = "142" ] || [ "$rc" = "137" ]; then
        printf "  %-26s FAIL (hang/timeout)\n" "$name"; FAIL=$((FAIL+1)); return
    fi
    if [ "$mode" = "clean" ]; then
        if [ "$rc" -eq 0 ]; then printf "  %-26s ok (clean)\n" "$name"; PASS=$((PASS+1))
        else printf "  %-26s FAIL (wanted clean, rc=%s)\n" "$name" "$rc"; FAIL=$((FAIL+1)); fi
        return
    fi
    if [ "$rc" -ne 0 ] && printf '%s' "$out" | grep -qF "$pattern"; then
        printf "  %-26s ok\n" "$name"; PASS=$((PASS+1))
    else
        printf "  %-26s FAIL (rc=%s, wanted '%s')\n" "$name" "$rc" "$pattern"; FAIL=$((FAIL+1))
    fi
}

echo "=== diagnostics (invalid inputs must be rejected) ==="
run_diag "undeclared-var"    err "use of undeclared identifier 'nope'" \
    "int main(void){ return nope; }"
run_diag "undeclared-two"    err "use of undeclared identifier 'b'" \
    "int main(void){ return a + b; }"
run_diag "missing-semicolon" err "expected ';'" \
    "int main(void){ return 0 }"
run_diag "missing-expression" err "expected expression" \
    "int x = ;"
run_diag "missing-rparen"    err "expected ')'" \
    "int f(void){ return (1 + 2; }"
run_diag "recover-past-syntax" err "use of undeclared identifier" \
    "int a = ;
int main(void){ return undeclared_name; }"
run_diag "implicit-printf-ok" clean "" \
    "int main(void){ printf(\"hi\"); return 0; }"
run_diag "call-non-function"  err "called object is not a function" \
    "int main(void){ int x = 5; return x(); }"
run_diag "member-non-struct"  err "member access on non-struct/union type" \
    "int main(void){ int x = 5; return x.f; }"
run_diag "no-such-member"     err "no member named 'zzz'" \
    "struct P { int a; }; int main(void){ struct P p; return p.zzz; }"
run_diag "redefinition-local" err "redefinition of 'x'" \
    "int main(void){ int x; int x; return 0; }"
run_diag "redefinition-param" err "redefinition of 'x'" \
    "int f(int x, int x){ return x; }"
run_diag "tentative-ok"       clean "" \
    "int x;
int x;
int main(void){ return x; }"
run_diag "shadow-ok"          clean "" \
    "int main(void){ int x = 1; { int x = 2; return x; } }"
run_diag "void-returns-value" err "void function should not return a value" \
    "void f(void){ return 5; }
int main(void){ f(); return 0; }"
run_diag "nonvoid-bare-return" err "non-void function should return a value" \
    "int f(void){ return; }
int main(void){ return f(); }"
run_diag "void-bare-return-ok" clean "" \
    "void f(void){ return; }
int main(void){ f(); return 0; }"
run_diag "int-returns-value-ok" clean "" \
    "int f(void){ return 5; }
int main(void){ return f(); }"
run_diag "vla-local"          err "variable-length arrays are not supported" \
    "int main(void){ int n = 4; int a[n]; a[0]=1; return a[0]; }"
run_diag "vla-param"          err "variable-length arrays are not supported" \
    "int f(int n){ char b[n]; b[0]=1; return b[0]; }
int main(void){ return f(3); }"
run_diag "fixed-array-ok"     clean "" \
    "enum { N = 4 }; int g[N]; int main(void){ int a[10]; a[0]=1; return a[0]+g[0]+(int)sizeof(a); }"
run_diag "complex-type"       err "complex types (_Complex/_Imaginary) are not supported" \
    "int main(void){ double _Complex z; return 0; }"
run_diag "atomic-qual-ok"     clean "" \
    "_Atomic int x; int main(void){ x = 5; return x; }"
run_diag "int128-arith"       err "128-bit integer arithmetic (__int128) is not yet supported" \
    "unsigned __int128 f(unsigned __int128 a, unsigned __int128 b){ return a + b; }
int main(void){ return (int)f(1,2); }"
run_diag "int128-decl-ok"     clean "" \
    "typedef unsigned __int128 u128; union h { u128 full; struct { unsigned long lo, hi; }; };
int main(void){ union h x; x.lo=5; x.hi=0; return (int)(sizeof(u128) + x.lo - 16); }"

echo ""
echo "=== diagtest: $PASS ok, $FAIL fail ==="
[ "$FAIL" -eq 0 ]
@}

\section{Warning Tests}
\label{sec:warn-tests}

Warnings are the mirror image of the diagnostics above: the program is
\emph{valid}, so it must still compile (exit~0, object file produced),
yet under \texttt{-Wall} \kcc{} must \emph{say something}.  The harness
below therefore checks three things at once for each case---that the
compile succeeds, that the expected warning text appears, and, in the
\texttt{gated} cases, that the very same program is \emph{silent}
without \texttt{-Wall}.  That last check is the load-bearing one: it is
what proves the whole warning family stays behind its flag and leaves
the default build byte-for-byte as it was.  \texttt{make warntest} runs
it.

@d Warn: tests @{
#!/bin/bash
BASE="$(cd "$(dirname "$0")/.." && pwd)"
# kcc warning tests (valid programs; -Wall must warn, default must not) — generated by weft
set -u
PASS=0
FAIL=0
KCC="$BASE/kcc"
TMP="/$BASE/kcc_warn_$$"
mkdir -p "$TMP"
trap 'rm -rf "$TMP"' EXIT

# run_warn name mode pattern src
#   mode=warn  : with -Wall, expect exit 0, object produced, output contains <pattern>
#   mode=clean : with -Wall, expect exit 0 and NO "warning:" in the output
#   mode=gated : WITHOUT -Wall, expect exit 0 and NO "warning:" in the output
run_warn() {
    local name="$1"; local mode="$2"; local pattern="$3"; local src="$4"
    printf '%s\n' "$src" > "$TMP/w.c"
    rm -f "$TMP/w.o"
    local wall="-Wall"
    [ "$mode" = "gated" ] && wall=""
    local out rc
    out=$(perl -e 'alarm 8; exec @@ARGV' "$KCC" -c "$TMP/w.c" -o "$TMP/w.o" $wall 2>&1)
    rc=$?
    if [ "$rc" != "0" ]; then
        printf "  %-26s FAIL (compile rc=%s, want 0)\n" "$name" "$rc"; FAIL=$((FAIL+1)); return
    fi
    if [ ! -f "$TMP/w.o" ]; then
        printf "  %-26s FAIL (no object produced)\n" "$name"; FAIL=$((FAIL+1)); return
    fi
    if [ "$mode" = "warn" ]; then
        if printf '%s' "$out" | grep -qF "$pattern"; then
            printf "  %-26s ok\n" "$name"; PASS=$((PASS+1))
        else
            printf "  %-26s FAIL (wanted warning '%s')\n" "$name" "$pattern"; FAIL=$((FAIL+1))
        fi
    else
        # clean / gated: no warning at all
        if printf '%s' "$out" | grep -q "warning:"; then
            printf "  %-26s FAIL (unexpected warning)\n" "$name"; FAIL=$((FAIL+1))
        else
            printf "  %-26s ok (%s)\n" "$name" "$mode"; PASS=$((PASS+1))
        fi
    fi
}

echo "=== warnings (-Wall on valid programs) ==="
run_warn "implicit-func"       warn "implicit declaration of function 'foo'" \
    "int main(void){ return foo(3); }"
run_warn "unused-var"          warn "unused variable 'x'" \
    "int main(void){ int x = 5; int y = 3; return y; }"
run_warn "unused-nested"       warn "unused variable 'z'" \
    "int main(void){ { int z = 9; } return 0; }"
run_warn "used-var-clean"      clean "" \
    "int main(void){ int x = 5; return x; }"
run_warn "write-counts-clean"  clean "" \
    "int main(void){ int x; x = 5; return 0; }"
run_warn "nested-use-clean"    clean "" \
    "int main(void){ int x = 5; { return x; } }"
run_warn "param-not-warned"    clean "" \
    "int f(int p){ return 0; }
int main(void){ return f(1); }"
run_warn "unused-gated"        gated "" \
    "int main(void){ int x = 5; int y = 3; return y; }"
run_warn "implicit-gated"      gated "" \
    "int main(void){ return foo(3); }"
run_warn "reach-end-plain"     warn "control reaches end of non-void function" \
    "int f(void){ int x = 1; }
int main(void){ return f(); }"
run_warn "reach-end-if"        warn "control reaches end of non-void function" \
    "int f(int c){ if(c) return 1; }
int main(void){ return f(0); }"
run_warn "return-ok-clean"     clean "" \
    "int f(int c){ if(c) return 1; else return 2; }
int main(void){ return f(1); }"
run_warn "infinite-loop-clean" clean "" \
    "int f(void){ for(;;){ } }
int main(void){ return 0; }"
run_warn "noreturn-call-clean" clean "" \
    "void abort(void);
int f(void){ abort(); }
int main(void){ return 0; }"
run_warn "switch-return-clean" clean "" \
    "int f(int c){ switch(c){ default: return 0; } }
int main(void){ return f(1); }"
run_warn "main-fallthrough-clean" clean "" \
    "int main(void){ }"
run_warn "reach-end-gated"     gated "" \
    "int f(void){ int x = 1; }
int main(void){ return f(); }"
run_warn "sign-compare-var"    warn "comparison of integers of different signedness" \
    "int f(int a, unsigned b){ return a < b; }
int main(void){ return f(1, 2); }"
run_warn "sign-compare-neg"    warn "comparison of integers of different signedness" \
    "int f(unsigned u){ return u < -1; }
int main(void){ return f(1); }"
run_warn "sign-const-clean"    clean "" \
    "int f(unsigned u){ return u < 10; }
int main(void){ return f(1); }"
run_warn "sign-samesign-clean" clean "" \
    "int f(unsigned a, unsigned b){ return a < b; }
int main(void){ return f(1, 2); }"
run_warn "sign-ptr-clean"      clean "" \
    "int f(int *p, int *q){ return p < q; }
int main(void){ int x; return f(&x, &x); }"
run_warn "sign-compare-gated"  gated "" \
    "int f(int a, unsigned b){ return a < b; }
int main(void){ return f(1, 2); }"
run_warn "int-to-ptr-init"     warn "incompatible integer to pointer conversion" \
    "int *p = 5;
int main(void){ return 0; }"
run_warn "int-to-ptr-assign"   warn "incompatible integer to pointer conversion" \
    "int main(void){ int *p; int n = 5; p = n; return 0; }"
run_warn "ptr-to-int-return"   warn "incompatible pointer to integer conversion" \
    "int f(void){ int x; return &x; }
int main(void){ return 0; }"
run_warn "null-const-clean"    clean "" \
    "int *p = 0;
int main(void){ int *q; q = 0; return 0; }"
run_warn "ptr-to-ptr-clean"    clean "" \
    "int main(void){ int x; int *p = &x; int *q = p; return *q; }"
run_warn "cast-clean"          clean "" \
    "int main(void){ int *p = (int*)5; return p != 0; }"
run_warn "compound-ptr-clean"  clean "" \
    "int main(void){ int a[3]; int *p = a; p += 1; return 0; }"
run_warn "int-conv-gated"      gated "" \
    "int *p = 5;
int main(void){ return 0; }"

echo ""
echo "=== warntest: $PASS ok, $FAIL fail ==="
[ "$FAIL" -eq 0 ]
@}
