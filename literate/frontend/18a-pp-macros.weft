% 18a-pp-macros.weft — macro definition, expansion, and predefined macros
%
% Split from 18-preprocessor.weft (structural refactor, no content changes):
% #define/#undef, function-like macro expansion, and predefined macros.

\section{Macro Definition (\texttt{\#define})}

A \texttt{\#define} directive creates a macro.  If the identifier is
immediately followed by \texttt{(} (no intervening whitespace), it is
a function-like macro with parameters (\stdref{6.10.3}).  Otherwise
it is an object-like macro.

The replacement body is the text from after the macro name (or
parameter list) to the end of the directive line.

Each parameter is an identifier---or, as with the macro name, a token the lexer
classified as a keyword, since translation phase~4 has no keywords
(\stdref{6.4.1}) and the kernel's \texttt{TRACE\_EVENT} names a parameter
\texttt{struct}.  A bare \texttt{...} in final position makes
the macro variadic, binding the trailing arguments to \texttt{\_\_VA\_ARGS\_\_}
(\stdref{6.10.3}).  The parser also accepts the GNU \emph{named} variadic form
\texttt{name...}---an identifier immediately followed by \texttt{...}---which
names the rest parameter so the body refers to the trailing arguments as
\texttt{name} instead of \texttt{\_\_VA\_ARGS\_\_}; the Linux kernel headers use
this spelling heavily.  Either way the binding name is written into the variadic
slot \texttt{params[x22]} at definition time---\texttt{\_\_VA\_ARGS\_\_} for the
bare form, the identifier for the named form---and the fixed-parameter count in
\texttt{x22} excludes it, so expansion need only collapse the trailing arguments
into that already-named slot.

@d PP: define @{
.text
// -- _kcc_pp_do_define ----------------------------------------------
// Handles #define: reads macro name, optional params, body.
.p2align 2
_kcc_pp_do_define:
    stp x29, x30, [sp, #-80]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    stp x25, x26, [sp, #64]

    // Read macro name.  During preprocessing (translation phase 4) there are
    // no keywords yet (\stdref{6.4.1}): `int`, `inline`, even `__attribute__`
    // are ordinary identifiers that a portability header may legally #define.
    // The lexer, however, eagerly classifies them as keyword tokens, so we
    // accept both TOK_IDENT and any keyword-class code [10, TOK_LPAREN) here.
    bl _kcc_lex_next
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_IDENT
    b.eq .Ldef_name_ok
    sub  x1, x0, #10           // keyword-class tokens occupy [10, 60)
    cmp  x1, #50               // 60-10; hs → neither identifier nor keyword
    b.hs .Ldef_err_name
.Ldef_name_ok:

    // Save macro name (callee-saved)
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x19, [x0]             // x19 = name ptr
    adrp x0, _kcc_tok_len@@PAGE
    add  x0, x0, _kcc_tok_len@@PAGEOFF
    ldr  x20, [x0]             // x20 = name len

    // Check if function-like: '(' immediately after name (no space)
    // Peek at the character right after the identifier in source
    adrp x0, _kcc_lex_cursor@@PAGE
    add  x0, x0, _kcc_lex_cursor@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_lex_end@@PAGE
    add  x1, x1, _kcc_lex_end@@PAGEOFF
    ldr  x1, [x1]
    cmp  x0, x1
    b.hs .Ldef_object          // at end → object-like
    ldrb w2, [x0]
    cmp  w2, #'('
    b.eq .Ldef_funclike

.Ldef_object:
    // Object-like macro
    mov x21, #0                // x21 = flags (not function-like)
    mov x22, #0                // x22 = param count
    mov x23, #0                // x23 = params ptr (none)

    // Get rest of line as replacement body
    bl _kcc_pp_rest_of_line
    mov x24, x0                // x24 = body ptr
    mov x25, x1                // x25 = body len
    b .Ldef_store

.Ldef_funclike:
    // Function-like macro
    mov x21, #PP_FLAG_FUNCLIKE
    mov x22, #0                // param count
    mov x23, #0                // params ptr

    // Consume the '(' by calling lex_next, then read first param/rparen
    bl _kcc_lex_next           // reads '(' token
    bl _kcc_lex_next           // reads first param or ')'

    // Allocate param array (max PP_MAX_ARGS entries)
    mov x0, #PP_MAX_ARGS
    mov x1, #PP_PARAM_SIZE
    mul x0, x0, x1
    bl _kcc_arena_alloc
    mov x23, x0                // x23 = params array

    // Read parameters
    // Check for empty parameter list: )
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_RPAREN
    b.eq .Ldef_params_done

.Ldef_param_loop:
    // A `...` here marks a variadic macro: the trailing arguments bind to
    // __VA_ARGS__ (\stdref{6.10.3}).  It is not a named parameter and must be
    // the last item, so the next token has to be ')'.
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_ELLIPSIS
    b.eq .Ldef_variadic
    // Expect a parameter name.  As with the macro name (translation phase 4 has
    // no keywords, \stdref{6.4.1}), the lexer may have classified it as a
    // keyword token, so accept TOK_IDENT or any keyword-class code [10, 60):
    // the kernel's TRACE_EVENT names a parameter `struct`.
    cmp  x0, #TOK_IDENT
    b.eq .Ldef_param_name_ok
    sub  x1, x0, #10
    cmp  x1, #50
    b.hs .Ldef_err_param
.Ldef_param_name_ok:

    // Store parameter name
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_tok_len@@PAGE
    add  x1, x1, _kcc_tok_len@@PAGEOFF
    ldr  x1, [x1]

    // params[param_count] = {name, len}.  Do not count it yet: a trailing
    // `...` would make it a GNU named-variadic parameter (see .Ldef_named_variadic).
    mov x2, #PP_PARAM_SIZE
    mul x3, x22, x2
    add x3, x23, x3
    str x0, [x3, #PP_PARAM_NAME]
    str x1, [x3, #PP_PARAM_LEN]

    // Read next: '...' (named variadic), ',' or ')'
    bl _kcc_lex_next
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_ELLIPSIS
    b.eq .Ldef_named_variadic
    add x22, x22, #1
    cmp  x0, #TOK_COMMA
    b.ne .Ldef_check_rparen

    // Comma: read next parameter
    bl _kcc_lex_next
    b .Ldef_param_loop

.Ldef_check_rparen:
    cmp  x0, #TOK_RPAREN
    b.ne .Ldef_err_param
    b .Ldef_params_done

.Ldef_named_variadic:
    // GNU "name...": the identifier just stored in params[x22] binds the
    // trailing arguments (\stdref{6.10.3}, GNU extension).  Mark variadic and
    // leave x22 uncounted so that slot stays the variadic slot the expander
    // collapses into.
    orr x21, x21, #PP_FLAG_VARIADIC
    bl _kcc_lex_next
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_RPAREN
    b.ne .Ldef_err_param
    b .Ldef_params_done

.Ldef_variadic:
    orr x21, x21, #PP_FLAG_VARIADIC   // mark variadic; ... consumes no param slot
    // Bind the variadic slot params[x22] to __VA_ARGS__ at definition time
    // (the named-variadic path above binds it to an identifier instead), so
    // the expander's collapse need not choose the name.
    mov x2, #PP_PARAM_SIZE
    mul x3, x22, x2
    add x3, x23, x3
    adrp x4, _kcc_pp_va_args_str@@PAGE
    add  x4, x4, _kcc_pp_va_args_str@@PAGEOFF
    str  x4, [x3, #PP_PARAM_NAME]
    mov  x4, #11
    str  x4, [x3, #PP_PARAM_LEN]
    bl _kcc_lex_next
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_RPAREN               // ... must be the final parameter
    b.ne .Ldef_err_param

.Ldef_params_done:
    // Get rest of line as replacement body
    bl _kcc_pp_rest_of_line
    mov x24, x0                // x24 = body ptr
    mov x25, x1                // x25 = body len
    b .Ldef_store
@}

\paragraph{Storage and error reporting.}
Both the object-like and function-like paths converge at
\texttt{.Ldef\_store}, which allocates the macro definition structure
in the arena, fills in every field, and inserts the definition into
the macro hash table.  If the directive was malformed---a missing name
or an invalid parameter list---the corresponding error label emits a
diagnostic and skips to the end of the line.

@d PP: define @{
.Ldef_store:
    // Allocate macro definition in arena
    mov x0, #PP_MACRO_SIZE
    bl _kcc_arena_alloc
    mov x26, x0                // x26 = macro_def ptr

    // Fill in the definition
    str x19, [x26, #PP_MACRO_NAME]
    str x20, [x26, #PP_MACRO_NAMELEN]
    str x21, [x26, #PP_MACRO_FLAGS]
    str x22, [x26, #PP_MACRO_NPARAMS]
    str x24, [x26, #PP_MACRO_BODY]
    str x25, [x26, #PP_MACRO_BODYLEN]
    str x23, [x26, #PP_MACRO_PARAMS]

    // Store in macro hash table
    adrp x0, _kcc_pp_macros@@PAGE
    add  x0, x0, _kcc_pp_macros@@PAGEOFF
    ldr  x0, [x0]             // hash table
    mov  x1, x19              // key = name
    mov  x2, x20              // keylen
    mov  x3, x26              // value = macro_def ptr
    bl _kcc_ht_put

    // Skip remaining text on directive line
    bl _kcc_pp_skip_line

    ldp x25, x26, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #80
    ret

.Ldef_err_name:
    adrp x0, _kcc_pp_dir_line@@PAGE
    add  x0, x0, _kcc_pp_dir_line@@PAGEOFF
    ldr  x0, [x0]
    mov  x1, #1
    adrp x2, _kcc_pp_err_def_name@@PAGE
    add  x2, x2, _kcc_pp_err_def_name@@PAGEOFF
    bl _kcc_diag_error
    bl _kcc_pp_skip_line
    ldp x25, x26, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #80
    ret

.Ldef_err_param:
    adrp x0, _kcc_pp_dir_line@@PAGE
    add  x0, x0, _kcc_pp_dir_line@@PAGEOFF
    ldr  x0, [x0]
    mov  x1, #1
    adrp x2, _kcc_pp_err_def_param@@PAGE
    add  x2, x2, _kcc_pp_err_def_param@@PAGEOFF
    bl _kcc_diag_error
    bl _kcc_pp_skip_line
    ldp x25, x26, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #80
    ret
@}

\section{Macro Undefine (\texttt{\#undef})}

\texttt{\#undef} removes a macro from the table by storing zero as
its value.

@d PP: undef @{
.text
// -- _kcc_pp_do_undef -----------------------------------------------
.p2align 2
_kcc_pp_do_undef:
    stp x29, x30, [sp, #-16]!
    mov x29, sp

    // Read macro name
    bl _kcc_lex_next
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, #TOK_IDENT
    b.ne .Lundef_done

    // Put 0 in the hash table for this name
    adrp x0, _kcc_pp_macros@@PAGE
    add  x0, x0, _kcc_pp_macros@@PAGEOFF
    ldr  x0, [x0]

    adrp x1, _kcc_tok_start@@PAGE
    add  x1, x1, _kcc_tok_start@@PAGEOFF
    ldr  x1, [x1]

    adrp x2, _kcc_tok_len@@PAGE
    add  x2, x2, _kcc_tok_len@@PAGEOFF
    ldr  x2, [x2]

    mov  x3, #0                // value = 0 (removed)
    bl _kcc_ht_put

.Lundef_done:
    bl _kcc_pp_skip_line
    ldp x29, x30, [sp], #16
    ret
@}

\section{The \texttt{push\_macro} and \texttt{pop\_macro} Pragmas}

Most \texttt{\#pragma} directives are implementation-defined and kcc ignores
them, but two are worth honouring because real headers lean on them to
save and restore a macro around a local redefinition:
\texttt{\#pragma push\_macro("NAME")} remembers \texttt{NAME}'s current
definition, and a later \texttt{\#pragma pop\_macro("NAME")} restores it,
undoing any intervening \texttt{\#undef}/\texttt{\#define}.  Because a
redefinition never mutates the old macro object---\texttt{\#define} installs a
\emph{fresh} entry and the arena keeps the previous one alive---saving is just
capturing the current hash-table value (a macro pointer, possibly null for an
undefined name) and restoring is putting it back.

The save records live on a small stack of arena nodes, each holding the
next link, the macro name and length, and the saved macro pointer.  A push
prepends a node; a pop scans from the head for the newest node whose name
matches and reinstalls its saved pointer, unlinking that node.  A single
global head, \texttt{\_kcc\_pp\_macro\_stack}, roots the stack, and the whole
mechanism reuses the same \texttt{\_kcc\_pp\_macros} table that
\texttt{\#define} and \texttt{\#undef} manipulate.

@d PP: pragma @{
// -- _kcc_pp_do_pragma ----------------------------------------------
// Handles `#pragma push_macro("X")` / `#pragma pop_macro("X")`; any other
// pragma is skipped.  Called with the `pragma` keyword already consumed.
.text
.p2align 2
_kcc_pp_do_pragma:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    // Read the pragma verb.
    bl _kcc_lex_next
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr x0, [x0]
    cmp x0, #TOK_IDENT
    b.ne .Lprag_skip
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr x19, [x0]                // verb start
    adrp x0, _kcc_tok_len@@PAGE
    add  x0, x0, _kcc_tok_len@@PAGEOFF
    ldr x20, [x0]                // verb length
    // push_macro?  (10 characters)
    cmp x20, #10
    b.ne .Lprag_try_pop
    mov x0, x19
    adrp x1, _kcc_pp_s_push_macro@@PAGE
    add  x1, x1, _kcc_pp_s_push_macro@@PAGEOFF
    mov x2, #10
    bl _kcc_memcmp
    cbz x0, .Lprag_push
.Lprag_try_pop:
    cmp x20, #9                  // pop_macro (9 characters)
    b.ne .Lprag_skip
    mov x0, x19
    adrp x1, _kcc_pp_s_pop_macro@@PAGE
    add  x1, x1, _kcc_pp_s_pop_macro@@PAGEOFF
    mov x2, #9
    bl _kcc_memcmp
    cbz x0, .Lprag_pop
    b .Lprag_skip

.Lprag_push:
    bl _kcc_pp_pragma_name       // x0=name ptr, x1=len (0 on parse failure)
    cbz x1, .Lprag_skip
    mov x19, x0                  // name
    mov x20, x1                  // len
    // saved = ht_get(macros, name, len)
    adrp x0, _kcc_pp_macros@@PAGE
    add  x0, x0, _kcc_pp_macros@@PAGEOFF
    ldr x0, [x0]
    mov x1, x19
    mov x2, x20
    bl _kcc_ht_get               // x0 = current macro (or 0)
    str x0, [sp, #-16]!          // stash saved across arena_alloc (x2 is caller-saved)
    // node = arena_alloc(32); {next, name, len, saved}
    mov x0, #32
    bl _kcc_arena_alloc
    ldr x2, [sp], #16            // reload saved
    str x19, [x0, #8]            // name
    str x20, [x0, #16]           // len
    str x2, [x0, #24]            // saved macro pointer
    adrp x1, _kcc_pp_macro_stack@@PAGE
    add  x1, x1, _kcc_pp_macro_stack@@PAGEOFF
    ldr x2, [x1]                 // old head
    str x2, [x0, #0]             // node.next = head
    str x0, [x1]                 // head = node
    b .Lprag_skip

.Lprag_pop:
    bl _kcc_pp_pragma_name       // x0=name, x1=len
    cbz x1, .Lprag_skip
    mov x19, x0                  // name
    mov x20, x1                  // len
    // Scan the stack for the newest node with a matching name.
    adrp x0, _kcc_pp_macro_stack@@PAGE
    add  x0, x0, _kcc_pp_macro_stack@@PAGEOFF
    mov x3, x0                   // x3 = address of the link to update (head first)
.Lprag_pop_scan:
    ldr x4, [x3]                 // x4 = current node
    cbz x4, .Lprag_skip          // no matching push: nothing to restore
    ldr x1, [x4, #16]            // node.len
    cmp x1, x20
    b.ne .Lprag_pop_next
    mov x0, x19                  // name
    ldr x1, [x4, #8]             // node.name
    mov x2, x20                  // len
    stp x3, x4, [sp, #-16]!      // preserve link addr + node across memcmp
    bl _kcc_memcmp
    ldp x3, x4, [sp], #16
    cbz x0, .Lprag_pop_found
.Lprag_pop_next:
    add x3, x4, #0               // link to update = &node.next (offset 0)
    b .Lprag_pop_scan
.Lprag_pop_found:
    // Restore: ht_put(macros, name, len, node.saved).
    adrp x0, _kcc_pp_macros@@PAGE
    add  x0, x0, _kcc_pp_macros@@PAGEOFF
    ldr x0, [x0]
    mov x1, x19
    mov x2, x20
    ldr x5, [x4, #24]            // saved macro pointer
    stp x3, x4, [sp, #-16]!
    mov x3, x5
    bl _kcc_ht_put
    ldp x3, x4, [sp], #16
    // Unlink node: *link = node.next.
    ldr x0, [x4, #0]
    str x0, [x3]
    b .Lprag_skip

.Lprag_skip:
    bl _kcc_pp_skip_line
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- _kcc_pp_pragma_name --------------------------------------------
// Parse `( "NAME" )` following a push_macro/pop_macro verb.  Returns
// x0 = pointer to NAME's bytes (inside the string literal), x1 = its length,
// or x1 = 0 on any parse failure.  The macro name is the string-literal
// content without its surrounding quotes.
.text
.p2align 2
_kcc_pp_pragma_name:
    stp x29, x30, [sp, #-16]!
    mov x29, sp
    bl _kcc_lex_next             // (
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr x0, [x0]
    cmp x0, #TOK_LPAREN
    b.ne .Lpname_fail
    bl _kcc_lex_next             // "NAME"
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr x0, [x0]
    cmp x0, #TOK_STRING_LIT
    b.ne .Lpname_fail
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr x0, [x0]
    adrp x1, _kcc_tok_len@@PAGE
    add  x1, x1, _kcc_tok_len@@PAGEOFF
    ldr x1, [x1]
    add x0, x0, #1               // skip opening quote
    sub x1, x1, #2               // drop both quotes
    ldp x29, x30, [sp], #16
    ret
.Lpname_fail:
    mov x1, #0
    ldp x29, x30, [sp], #16
    ret
@| _kcc_pp_do_pragma _kcc_pp_pragma_name
@}

\section{Macro Expansion}

When \texttt{kcc\_pp\_next} encounters an identifier, it checks
the macro table.  If a macro is found and is not currently being
expanded (anti-recursion per \stdref{6.10.3.4}), the replacement
text is pushed onto the context stack.

For function-like macros, arguments are collected first, and
parameter names in the replacement text are substituted with the
corresponding argument text.

@d PP: expand @{
.text
// -- _kcc_pp_try_expand ---------------------------------------------
// Checks current identifier token against macro table.
// Returns x0 = 1 if expanded (pushed context), 0 if not.
.globl _kcc_pp_try_expand
.p2align 2
_kcc_pp_try_expand:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]

    // Get token start and length
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x19, [x0]            // x19 = name ptr
    adrp x0, _kcc_tok_len@@PAGE
    add  x0, x0, _kcc_tok_len@@PAGEOFF
    ldr  x20, [x0]            // x20 = name len

    // Look up in macro table
    adrp x0, _kcc_pp_macros@@PAGE
    add  x0, x0, _kcc_pp_macros@@PAGEOFF
    ldr  x0, [x0]
    mov  x1, x19
    mov  x2, x20
    bl _kcc_ht_get
    cbz  x0, .Lexp_no         // not a macro
    mov  x21, x0              // x21 = macro_def ptr

    // Check anti-recursion flag
    ldr  x0, [x21, #PP_MACRO_FLAGS]
    tst  x0, #PP_FLAG_EXPANDING
    b.ne .Lexp_no             // already expanding → don't recurse

    // Dynamic built-in __LINE__: expands to the current line number, formatted
    // fresh at each use, so a static macro body cannot represent it.
    tst  x0, #PP_FLAG_BUILTIN
    b.eq .Lexp_not_dyn
    cmp  x20, #8              // "__LINE__" and "__FILE__" are both length 8
    b.ne .Lexp_chk_counter
    mov  x0, x19
    adrp x1, _kcc_pp_pre_linem@@PAGE
    add  x1, x1, _kcc_pp_pre_linem@@PAGEOFF
    mov  x2, #8
    bl _kcc_memcmp
    cbz  x0, .Lexp_line_dyn
    mov  x0, x19
    adrp x1, _kcc_pp_pre_filem@@PAGE
    add  x1, x1, _kcc_pp_pre_filem@@PAGEOFF
    mov  x2, #8
    bl _kcc_memcmp
    cbz  x0, .Lexp_file_dyn
    b .Lexp_not_dyn
.Lexp_chk_counter:
    // __COUNTER__ (length 11): a fresh sequential integer at each use.
    cmp  x20, #11
    b.ne .Lexp_not_dyn
    mov  x0, x19
    adrp x1, _kcc_pp_pre_counterm@@PAGE
    add  x1, x1, _kcc_pp_pre_counterm@@PAGEOFF
    mov  x2, #11
    bl _kcc_memcmp
    cbz  x0, .Lexp_counter_dyn
.Lexp_not_dyn:

    // Check if function-like
    ldr  x0, [x21, #PP_MACRO_FLAGS]
    tst  x0, #PP_FLAG_FUNCLIKE
    b.ne .Lexp_funclike

    // --- Object-like expansion ---
    ldr  x22, [x21, #PP_MACRO_BODY]     // body ptr
    ldr  x23, [x21, #PP_MACRO_BODYLEN]  // body len
    cbz  x23, .Lexp_empty     // empty replacement

    // Copy body to arena buffer (for lexer to scan)
    mov  x0, x23
    bl _kcc_arena_alloc
    mov  x24, x0              // x24 = buffer
    mov  x0, x24
    mov  x1, x22
    mov  x2, x23
    bl _kcc_memcpy

    // Mark macro as expanding
    ldr  x0, [x21, #PP_MACRO_FLAGS]
    orr  x0, x0, #PP_FLAG_EXPANDING
    str  x0, [x21, #PP_MACRO_FLAGS]

    // Push expansion context
    mov  x0, #PP_CTX_EXPAND
    mov  x1, x21              // macro_def for unmark on pop
    mov  x2, x24              // buffer start
    mov  x3, x23              // buffer len
    bl _kcc_pp_ctx_push_expand

    mov  x0, #1               // expanded
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret

.Lexp_empty:
    // Empty macro body — nothing to expand, return 1 to skip the token
    mov  x0, #1
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret

.Lexp_counter_dyn:
    // __COUNTER__ — expand to the current value of a monotonic counter, then
    // increment it so the next use sees the successor (\stdref{gcc __COUNTER__}).
    // The value is formatted through the same decimal path as __LINE__.
    adrp x0, _kcc_pp_counter@@PAGE
    add  x0, x0, _kcc_pp_counter@@PAGEOFF
    ldr  x22, [x0]               // value to emit = current counter
    add  x1, x22, #1
    str  x1, [x0]                // counter++ for the next expansion
    b .Lexp_num_format

.Lexp_line_dyn:
    // Format the current line number as a decimal token and push it as the
    // expansion.  Digits are written from the end of a small arena buffer.
    // The physical line is offset by any #line adjustment.
    adrp x0, _kcc_lex_line@@PAGE
    add  x0, x0, _kcc_lex_line@@PAGEOFF
    ldr  x22, [x0]               // physical line number
    adrp x0, _kcc_line_delta@@PAGE
    add  x0, x0, _kcc_line_delta@@PAGEOFF
    ldr  x0, [x0]
    add  x22, x22, x0            // presumed line = physical + #line delta
.Lexp_num_format:
    mov  x0, #24
    bl _kcc_arena_alloc
    mov  x24, x0                 // buffer
    add  x23, x24, #24           // one past the end
    mov  x5, #10
    cbnz x22, .Lexp_line_loop
    mov  w1, #'0'
    sub  x23, x23, #1
    strb w1, [x23]
    b .Lexp_line_push
.Lexp_line_loop:
    udiv x1, x22, x5
    msub x2, x1, x5, x22         // x2 = line % 10
    add  w2, w2, #'0'
    sub  x23, x23, #1
    strb w2, [x23]
    mov  x22, x1
    cbnz x22, .Lexp_line_loop
.Lexp_line_push:
    add  x0, x24, #24
    sub  x22, x0, x23            // x22 = digit count
    // Mark builtin expanding and push, symmetric with the object-like path.
    ldr  x0, [x21, #PP_MACRO_FLAGS]
    orr  x0, x0, #PP_FLAG_EXPANDING
    str  x0, [x21, #PP_MACRO_FLAGS]
    mov  x0, #PP_CTX_EXPAND
    mov  x1, x21                 // macro_def for unmark on pop
    mov  x2, x23                 // digit buffer
    mov  x3, x22                 // length
    bl _kcc_pp_ctx_push_expand
    mov  x0, #1
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret

.Lexp_file_dyn:
    // __FILE__ — expand to the current source path as a string-literal token.
    // _kcc_src_path tracks the file being read (the include machinery saves and
    // restores it, §6.10.8.1), so this is the header's own name inside a header.
    adrp x0, _kcc_src_path@@PAGE
    add  x0, x0, _kcc_src_path@@PAGEOFF
    ldr  x22, [x0]               // x22 = path pointer (0 before any file)
    cbnz x22, .Lexp_file_have
    adrp x22, _kcc_pp_file_unknown@@PAGE
    add  x22, x22, _kcc_pp_file_unknown@@PAGEOFF
.Lexp_file_have:
    mov  x0, x22
    bl _kcc_strlen
    mov  x23, x0                 // x23 = path length
    add  x0, x23, #3             // 2 quotes + 1 slack
    bl _kcc_arena_alloc
    mov  x24, x0                 // x24 = buffer
    mov  w1, #'"'
    strb w1, [x24]               // opening quote
    add  x0, x24, #1
    mov  x1, x22
    mov  x2, x23
    bl _kcc_memcpy               // path bytes after the quote
    add  x0, x24, #1
    add  x0, x0, x23
    mov  w1, #'"'
    strb w1, [x0]                // closing quote
    add  x22, x23, #2            // token length = path + 2 quotes
    ldr  x0, [x21, #PP_MACRO_FLAGS]
    orr  x0, x0, #PP_FLAG_EXPANDING
    str  x0, [x21, #PP_MACRO_FLAGS]
    mov  x0, #PP_CTX_EXPAND
    mov  x1, x21                 // macro_def for unmark on pop
    mov  x2, x24                 // buffer
    mov  x3, x22                 // length
    bl _kcc_pp_ctx_push_expand
    mov  x0, #1
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@| _kcc_pp_try_expand
@}

\paragraph{Function-like expansion.}
When a function-like macro is invoked, the preprocessor must first
locate the opening parenthesis (skipping whitespace), then collect the
argument list by tracking parenthesis depth across nested calls and
splitting on commas at the top level.  Once all arguments are gathered,
the substitution engine replaces each parameter name in the replacement
body with the corresponding argument text before pushing the result
onto the context stack.

The depth counter must survive the argument loop's own calls.  Each
iteration invokes \texttt{\_kcc\_lex\_next}, which for an identifier
argument calls \texttt{\_kcc\_ht\_get} to test it against the keyword
table---and any such call is free to clobber the caller-saved scratch
registers.  A depth kept in a scratch register therefore held only by
luck for numeric arguments and was corrupted the moment an argument was
an identifier or keyword, so a call like \verb|FOO(int)| or
\verb|CJSON_PUBLIC(cJSON *)| never found its closing parenthesis and
reported an ``unterminated macro argument list.''  The depth lives in a
callee-saved register (\texttt{x20}, dead in this path once the macro has
been looked up), which the called routines are obliged to preserve.

@d PP: expand @{
.Lexp_funclike:
    // Function-like: peek for '(' after the identifier.  A function-like macro
    // invocation may span a context boundary---an object-like macro can expand
    // to a function-like macro name whose '(' lies in the enclosing text
    // (`#define outer inner` used as `outer(a,b)`).  So first pop any expansion
    // context we have run to the end of, exposing that enclosing text; each
    // such context is exhausted and would be popped by the next read anyway.
.Lexp_fl_droptail:
    adrp x0, _kcc_lex_cursor@@PAGE
    add  x0, x0, _kcc_lex_cursor@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_lex_end@@PAGE
    add  x1, x1, _kcc_lex_end@@PAGEOFF
    ldr  x1, [x1]
    cmp  x0, x1
    b.lo .Lexp_peek_ws           // current buffer still has text
    adrp x2, _kcc_pp_ctx_depth@@PAGE
    add  x2, x2, _kcc_pp_ctx_depth@@PAGEOFF
    ldr  x2, [x2]
    cbz  x2, .Lexp_peek_ws       // no enclosing context → genuinely at end
    // Never pop past the argument-prescan boundary.  While expanding a macro
    // argument, drain_floor marks the pushed argument context; popping it to
    // hunt for '(' would reach into the enclosing macro body and wrongly treat
    // a bare function-like macro name passed as an argument (say `l_addi` in
    // `op_arithI(l_addi)`, whose body is `iop(0,5,1)`) as an invocation that
    // consumes the body's '(', dropping the name.  A function-like macro name
    // with no '(' inside its own argument is just an identifier (\stdref{6.10.3}).
    adrp x3, _kcc_pp_drain_floor@@PAGE
    add  x3, x3, _kcc_pp_drain_floor@@PAGEOFF
    ldr  x3, [x3]
    cmp  x2, x3
    b.ls .Lexp_peek_ws           // at/below the drain floor → don't cross it
    bl _kcc_pp_ctx_pop
    adrp x0, _kcc_lex_cursor@@PAGE
    add  x0, x0, _kcc_lex_cursor@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_lex_end@@PAGE
    add  x1, x1, _kcc_lex_end@@PAGEOFF
    ldr  x1, [x1]
    b .Lexp_fl_droptail

    // Skip whitespace looking for '('
.Lexp_peek_ws:
    cmp  x0, x1
    b.hs .Lexp_no              // EOF → not a function call
    ldrb w2, [x0]
    cmp  w2, #' '
    b.eq .Lexp_peek_next
    cmp  w2, #0x09
    b.eq .Lexp_peek_next
    cmp  w2, #0x0A
    b.eq .Lexp_peek_next
    cmp  w2, #0x0D
    b.eq .Lexp_peek_next
    // Non-whitespace found
    cmp  w2, #'('
    b.ne .Lexp_no              // not '(' → not a function call
    b .Lexp_func_call
.Lexp_peek_next:
    add  x0, x0, #1
    b .Lexp_peek_ws

.Lexp_func_call:
    // Consume the '(' via lexer
    bl _kcc_lex_next           // should yield TOK_LPAREN

    // Collect arguments
    ldr  x22, [x21, #PP_MACRO_NPARAMS]  // expected param count

    // Allocate argument array: PP_MAX_ARGS * 16 bytes
    mov  x0, #PP_MAX_ARGS
    lsl  x0, x0, #4           // * 16
    bl _kcc_arena_alloc
    mov  x23, x0              // x23 = arg array

    // Collect arguments: track paren depth in a callee-saved register (x20,
    // dead here) so _kcc_lex_next's calls cannot clobber it.
    mov  x24, #0              // arg count
    mov  x20, #1             // paren depth (we already consumed '(')

    // Mark start of first argument
    adrp x0, _kcc_lex_cursor@@PAGE
    add  x0, x0, _kcc_lex_cursor@@PAGEOFF
    ldr  x0, [x0]
    // Save arg start in arg array
    lsl  x1, x24, #4
    add  x1, x23, x1
    str  x0, [x1, #0]         // arg[0].start = cursor
    str  xzr, [x1, #8]        // arg[0].len = 0 (placeholder)

.Lexp_arg_loop:
    bl _kcc_lex_next
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]

    cmp  x0, #TOK_EOF
    b.eq .Lexp_arg_err         // unterminated args

    cmp  x0, #TOK_LPAREN
    b.ne .Lexp_arg_not_lp
    add  x20, x20, #1         // depth++
    b .Lexp_arg_loop

.Lexp_arg_not_lp:
    cmp  x0, #TOK_RPAREN
    b.ne .Lexp_arg_not_rp
    sub  x20, x20, #1         // depth--
    cbz  x20, .Lexp_arg_end   // matched → done
    b .Lexp_arg_loop

.Lexp_arg_not_rp:
    cmp  x0, #TOK_COMMA
    b.ne .Lexp_arg_loop
    cmp  x20, #1
    b.ne .Lexp_arg_loop        // comma inside nested parens

    // End of argument: compute length
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x0, [x0]             // comma position
    lsl  x1, x24, #4
    add  x1, x23, x1
    ldr  x2, [x1, #0]         // arg start
    sub  x2, x0, x2            // length = comma_start - arg_start
    str  x2, [x1, #8]

    // Start next argument
    add  x24, x24, #1
    adrp x0, _kcc_lex_cursor@@PAGE
    add  x0, x0, _kcc_lex_cursor@@PAGEOFF
    ldr  x0, [x0]
    lsl  x1, x24, #4
    add  x1, x23, x1
    str  x0, [x1, #0]         // next arg start
    str  xzr, [x1, #8]
    b .Lexp_arg_loop

.Lexp_arg_end:
    // Finalize last argument
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x0, [x0]             // ')' position
    lsl  x1, x24, #4
    add  x1, x23, x1
    ldr  x2, [x1, #0]         // arg start
    sub  x2, x0, x2            // length
    str  x2, [x1, #8]
    add  x24, x24, #1         // total arg count

    // Variadic macro (\stdref{6.10.3.1}): collapse the trailing arguments past
    // the fixed parameters into a single __VA_ARGS__ argument---the raw source
    // span from the first trailing arg to the last, commas and all.  The
    // variadic slot params[NPARAMS] was already bound to its name at definition
    // time---"__VA_ARGS__" for a plain `...`, or the identifier for a GNU
    // "name..." parameter---so the ordinary substitution engine replaces that
    // name with the joined text.  Too few args (only fixed ones) yield an empty
    // variadic argument.
    ldr  x0, [x21, #PP_MACRO_FLAGS]
    tst  x0, #PP_FLAG_VARIADIC
    b.eq .Lexp_arg_done_va
    ldr  x2, [x21, #PP_MACRO_NPARAMS]   // fixed parameter count
    lsl  x3, x2, #4
    add  x3, x23, x3                    // &arg[NPARAMS]
    cmp  x24, x2
    b.le .Lexp_va_empty                 // no trailing args → empty __VA_ARGS__
    ldr  x4, [x3, #0]                   // first trailing arg's start
    sub  x5, x24, #1                    // last arg index
    lsl  x6, x5, #4
    add  x6, x23, x6                    // &arg[last]
    ldr  x7, [x6, #0]                   // last arg start
    ldr  x9, [x6, #8]                   // last arg len
    add  x7, x7, x9                     // last arg end
    sub  x7, x7, x4                     // joined length
    str  x7, [x3, #8]                   // arg[NPARAMS].len = joined (start kept)
    b .Lexp_va_setcount
.Lexp_va_empty:
    ldr  x4, [x23, #0]                  // any valid readable start; length 0
    str  x4, [x3, #0]
    str  xzr, [x3, #8]
.Lexp_va_setcount:
    add  x2, x2, #1                     // params/args now include __VA_ARGS__
    mov  x22, x2                        // param count for substitute
    mov  x24, x2                        // arg count
.Lexp_arg_done_va:
@}

\paragraph{Substitution and expansion context.}
With all arguments collected in the argument array, the expansion
proceeds to the substitution phase.  The macro's replacement body,
parameter list, and the freshly gathered argument texts are passed to
\texttt{\_kcc\_pp\_substitute}, which performs textual replacement of
parameter names with argument text.  If the result is non-empty, the
macro is marked with \texttt{PP\_FLAG\_EXPANDING} to prevent recursive
re-expansion, and the substituted text is pushed onto the context stack.

@d PP: expand @{
    // Argument prescan (6.10.3.1): fully expand each argument before it is
    // substituted, while this macro's PP_FLAG_EXPANDING is still clear, so a
    // nested invocation of the same macro inside an argument expands.
    mov  x0, x23              // arg array
    mov  x1, x24              // arg count
    bl _kcc_pp_expand_all_args

    // Now substitute: build expanded text
    // For each identifier in body matching a param name, replace with arg text
    ldr  x0, [x21, #PP_MACRO_BODY]
    ldr  x1, [x21, #PP_MACRO_BODYLEN]
    ldr  x2, [x21, #PP_MACRO_PARAMS]
    mov  x3, x22              // param count
    mov  x4, x23              // arg array
    mov  x5, x24              // arg count
    bl _kcc_pp_substitute
    // Returns x0 = buffer ptr, x1 = buffer len

    cbz  x1, .Lexp_empty_func

    mov  x22, x0              // buffer
    mov  x23, x1              // len

    // Mark macro as expanding
    ldr  x0, [x21, #PP_MACRO_FLAGS]
    orr  x0, x0, #PP_FLAG_EXPANDING
    str  x0, [x21, #PP_MACRO_FLAGS]

    // Push expansion context
    mov  x0, #PP_CTX_EXPAND
    mov  x1, x21
    mov  x2, x22
    mov  x3, x23
    bl _kcc_pp_ctx_push_expand

    mov  x0, #1
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret

.Lexp_empty_func:
    mov  x0, #1
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret

.Lexp_arg_err:
    adrp x0, _kcc_pp_dir_line@@PAGE
    add  x0, x0, _kcc_pp_dir_line@@PAGEOFF
    ldr  x0, [x0]
    mov  x1, #1
    adrp x2, _kcc_pp_err_unterm_args@@PAGE
    add  x2, x2, _kcc_pp_err_unterm_args@@PAGEOFF
    bl _kcc_diag_error
    mov  x0, #0
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret

.Lexp_no:
    mov  x0, #0               // not expanded
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret
@}

\subsection{Argument Prescan}

\stdref{6.10.3.1} requires each macro argument to be \emph{completely
macro-expanded} before it is substituted into the replacement list.  Our
expander previously skipped this step, substituting the raw argument text
and relying on the later rescan to expand everything.  That fails for a
function-like macro nested inside its own argument---\texttt{cast(StkId,
cast\_charp(p))} where \texttt{cast\_charp} is itself
\texttt{cast(char~*,~\ldots)}, or the minimal \texttt{F(1,~F(2,~3))}:
the single per-macro \texttt{PP\_FLAG\_EXPANDING} bit paints the macro
across the entire rescan, including the substituted argument, so the
nested invocation reaches the parser unexpanded (``expected expression'').

\texttt{\_kcc\_pp\_expand\_arg} fixes this by expanding an argument to text
up front, while the outer macro's flag is not yet set.  It pushes the
argument text as an expansion context carrying \emph{no} macro (so nothing
is painted on its account) and drains \texttt{\_kcc\_pp\_next}, appending
each fully-expanded token to a growing buffer.  The subtle part is knowing
when the argument ends: \texttt{\_kcc\_pp\_next} normally pops an exhausted
context and reads straight on into the enclosing text, and that trailing
token could itself be a macro it would expand---silently pulling
surrounding tokens into the argument.  So the drain installs a
\emph{drain floor}: \texttt{\_kcc\_pp\_next} returns its \texttt{TOK\_EOF}
the moment the context stack drops below the floor, one above the depth at
entry, rather than reading further.  The floor is saved and restored so a
nested prescan (an argument that invokes this same macro) installs its own
deeper floor.  Tokens are joined with single spaces, which never changes
meaning because kcc implements neither \texttt{\#} nor \texttt{\#\#}---%
there are no operands whose spelling or pasting the spacing could disturb.

@d PP: expand @{
// -- _kcc_pp_expand_arg ---------------------------------------------
// (const char *text, uint64_t len) → x0 = expanded buf, x1 = expanded len
// Fully macro-expands one argument's text (argument prescan, 6.10.3.1).
.p2align 2
_kcc_pp_expand_arg:
    stp x29, x30, [sp, #-144]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    stp x25, x26, [sp, #64]
    str x27, [sp, #80]

    mov x19, x0                  // text
    mov x20, x1                  // len
    cbz x20, .Lea_empty

    // base_depth = current stack depth.  Set the drain floor one above it, so
    // _kcc_pp_next stops (returns EOF) the instant the argument context we are
    // about to push is popped---never reading on into the enclosing text.  The
    // floor is saved/restored so nested prescans (an argument that itself calls
    // this same macro) each install their own, deeper floor.
    adrp x0, _kcc_pp_ctx_depth@@PAGE
    add  x0, x0, _kcc_pp_ctx_depth@@PAGEOFF
    ldr  x24, [x0]               // base_depth
    adrp x0, _kcc_pp_drain_floor@@PAGE
    add  x0, x0, _kcc_pp_drain_floor@@PAGEOFF
    ldr  x1, [x0]
    str  x1, [sp, #96]           // saved drain_floor
    add  x1, x24, #1
    str  x1, [x0]                // floor = base_depth + 1
    adrp x0, _kcc_pp_has_pending@@PAGE
    add  x0, x0, _kcc_pp_has_pending@@PAGEOFF
    ldr  x1, [x0]
    str  x1, [sp, #104]          // saved has_pending
    str  xzr, [x0]               // clear so the drain reads the arg buffer

    // Output buffer, initial cap = len*4 + 256.
    lsl x0, x20, #2
    add x23, x0, #256            // cap
    mov x0, x23
    bl _kcc_arena_alloc
    mov x21, x0                  // out_buf
    mov x22, #0                  // out_len
    mov x27, #0                  // prev_end: end of the last token emitted

    // Push the argument text as an expand context with no macro.
    mov x0, #PP_CTX_EXPAND
    mov x1, #0
    mov x2, x19
    mov x3, x20
    bl _kcc_pp_ctx_push_expand

.Lea_loop:
    bl _kcc_pp_next
    // Argument done once the stack falls back to base_depth.
    adrp x0, _kcc_pp_ctx_depth@@PAGE
    add  x0, x0, _kcc_pp_ctx_depth@@PAGEOFF
    ldr  x0, [x0]
    cmp  x0, x24
    b.le .Lea_done
    // EOF safety
    adrp x0, _kcc_tok_type@@PAGE
    add  x0, x0, _kcc_tok_type@@PAGEOFF
    ldr  x0, [x0]
    cbz  x0, .Lea_done
    // Token text → x25 = start, x26 = len.
    adrp x0, _kcc_tok_start@@PAGE
    add  x0, x0, _kcc_tok_start@@PAGEOFF
    ldr  x25, [x0]
    adrp x0, _kcc_tok_len@@PAGE
    add  x0, x0, _kcc_tok_len@@PAGEOFF
    ldr  x26, [x0]
    // Ensure room for a space + the token; grow (alloc+copy) if needed.
    add x0, x22, x26
    add x0, x0, #1
    cmp x0, x23
    b.ls .Lea_do_append
    lsl x0, x0, #1
    mov x23, x0                  // new cap
    bl _kcc_arena_alloc
    str x0, [sp, #136]           // new buf
    mov x1, x21
    mov x2, x22
    bl _kcc_memcpy               // memcpy(new, old, out_len)
    ldr x21, [sp, #136]
.Lea_do_append:
    // Separate consecutive tokens with a single space ONLY where the source had
    // whitespace: two tokens adjacent in the same buffer (`.` then `section` in
    // `.section`) must stay joined, or a later `#`-stringify would produce
    // `. section` and break asm templates like EXPORT_SYMBOL's `.section`.  A
    // buffer change (macro-expansion boundary) leaves the token start != prev_end
    // and gets a space, which also blocks accidental token paste.  No separator
    // precedes the first token (a leading space would defeat a `##` paste).
    cbz x22, .Lea_no_sep
    cmp x25, x27                 // token adjacent to the previous one?
    b.eq .Lea_no_sep
    mov w0, #0x20                // separator space
    strb w0, [x21, x22]
    add x22, x22, #1
.Lea_no_sep:
    add x0, x21, x22
    mov x1, x25
    mov x2, x26
    bl _kcc_memcpy
    add x22, x22, x26
    add x27, x25, x26            // prev_end = token start + length
    b .Lea_loop

.Lea_done:
    // Restore the drain floor and pending flag.  The argument context has
    // already popped cleanly (the floor stopped pp_next at its EOF), so the
    // lexer is back at the enclosing position with nothing to undo.
    ldr x0, [sp, #96]
    adrp x1, _kcc_pp_drain_floor@@PAGE
    add  x1, x1, _kcc_pp_drain_floor@@PAGEOFF
    str  x0, [x1]
    ldr x0, [sp, #104]
    adrp x1, _kcc_pp_has_pending@@PAGE
    add  x1, x1, _kcc_pp_has_pending@@PAGEOFF
    str  x0, [x1]
    mov x0, x21                  // buf
    mov x1, x22                  // len
    ldr x27, [sp, #80]
    ldp x25, x26, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #144
    ret

.Lea_empty:
    mov x0, x19                  // original (empty) text
    mov x1, #0
    ldr x27, [sp, #80]
    ldp x25, x26, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #144
    ret

// -- _kcc_pp_expand_all_args ----------------------------------------
// (arg_array, count): replaces each 16-byte {start,len} entry with its
// fully-expanded {buf,len} in place, ahead of substitution.
.p2align 2
_kcc_pp_expand_all_args:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    str x21, [sp, #32]
    mov x19, x0                  // arg array
    mov x20, x1                  // count
    mov x21, #0                  // index
.Leaa_loop:
    cmp x21, x20
    b.ge .Leaa_done
    add x2, x19, x21, lsl #4     // entry = args + i*16
    ldr x0, [x2, #0]             // start
    ldr x1, [x2, #8]             // len
    bl _kcc_pp_expand_arg        // → x0 = buf, x1 = len
    add x2, x19, x21, lsl #4     // recompute (x2 was clobbered)
    str x0, [x2, #0]
    str x1, [x2, #8]
    add x21, x21, #1
    b .Leaa_loop
.Leaa_done:
    ldr x21, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_pp_expand_arg _kcc_pp_expand_all_args
@}

\subsection{Parameter Substitution}

For function-like macros, parameter names appearing in the replacement
body must be replaced with the corresponding argument text collected
from the call site.  \texttt{\_kcc\_pp\_substitute} walks the body
character by character; when it encounters an identifier, it compares
it against each parameter name using \texttt{\_kcc\_memcmp}.  On a
match, the argument text is copied to the output buffer instead of
the parameter name.  Non-identifier characters and unmatched
identifiers are copied verbatim.

A string literal or character constant is lexically a \emph{single}
preprocessing token, so a parameter name that happens to appear inside
quotes is not a parameter at all and must never be replaced
(\stdref{6.10.3.1}).  The walker therefore recognises a leading \texttt{"}
or \texttt{'} and copies the entire literal---through its matching close
delimiter, honouring backslash escapes---straight to the output before the
identifier logic can see it.  Without this, a body such as
\texttt{puts("value x here")} would wrongly expand \texttt{x}, and an
inline-asm template \texttt{"...\%[ptr]..."} whose operand-name letters
collide with a macro parameter would be silently rewritten.

The \texttt{\#\#} token-paste operator (\stdref{6.10.3.3}) is handled in
the same pass.  Pasting two tokens is, at the textual level, simply making
them \emph{adjacent}: when the concatenated output is rescanned the lexer
reads \texttt{foo} immediately followed by \texttt{bar} as the single token
\texttt{foobar}.  So on seeing \texttt{\#\#} the walker trims any whitespace
it has already emitted for the left operand, skips the operator and any
whitespace before the right operand, and continues---the next token, be it
a substituted argument or a literal, lands flush against the left one.
Operands are taken from the substituted argument text; because kcc's
arguments are already prescan-expanded and a paste operand is normally a
bare identifier or number, this matches the standard in every case a real
header exercises.  One GNU special case is handled first: in
\texttt{,\,\#\#\,\_\_VA\_ARGS\_\_}, when the right operand is a parameter whose
argument is empty, the paste deletes the operand \emph{and} a preceding comma
(peeking the operand identifier and consulting its argument length before the
ordinary trim).  This is what makes the kernel's
\texttt{static\_assert(expr,\,...)} macro---and hence the
\texttt{<linux/bitops.h>} assertions---expand correctly.  A lone \texttt{\#} is
the stringisation operator, handled just below.

@d PP: expand @{
// -- _kcc_pp_substitute ---------------------------------------------
// Substitutes parameters in macro body with argument text.
// x0=body_ptr, x1=body_len, x2=params, x3=nparam, x4=args, x5=nargs
// Returns x0=result_ptr, x1=result_len (arena-allocated)
.p2align 2
_kcc_pp_substitute:
    stp x29, x30, [sp, #-96]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]
    stp x25, x26, [sp, #64]
    stp x27, x28, [sp, #80]

    mov x19, x0               // body ptr
    mov x20, x1               // body len
    mov x21, x2               // params array
    mov x22, x3               // param count
    mov x23, x4               // args array
    mov x24, x5               // arg count

    // Allocate the output buffer sized to the inputs rather than a fixed 4 KB:
    // a macro that substitutes several large arguments (e.g. the kernel's
    // `pr_alert(fmt, data_race(x), data_race(y), ...)`, whose arguments are big
    // _Generic expansions) can otherwise overflow and truncate mid-token.  The
    // bound is body length + 4x the total argument length (covering a parameter
    // repeated a few times) + slack.  (The C preprocessor port grows on demand;
    // this reference binary never preprocesses such macros, so the generous
    // input-sized bound suffices.)
    mov x9, #0                // k
    mov x10, x20              // total = body len
.Lsub_cap_loop:
    cmp x9, x24
    b.hs .Lsub_cap_done
    lsl x11, x9, #4
    add x11, x23, x11         // &args[k]
    ldr x12, [x11, #8]        // args[k].len
    add x10, x10, x12, lsl #2 // total += 4 * len
    add x9, x9, #1
    b .Lsub_cap_loop
.Lsub_cap_done:
    add x0, x10, #4096        // + slack
    bl _kcc_arena_alloc
    mov x25, x0               // x25 = output buffer
    mov x26, #0                // x26 = output position

    // Walk through body text
    mov x27, #0                // x27 = body position
.Lsub_loop:
    cmp x27, x20
    b.hs .Lsub_done

    // Check for identifier start
    add x0, x19, x27
    ldrb w0, [x0]

    // A string literal or character constant is a single token whose contents
    // are never subject to parameter replacement (\stdref{6.10.3.1}); copy it
    // through verbatim so a parameter name inside quotes---`x` in
    // "value x here", or `%[ptr]` in an inline-asm template---is not rewritten.
    cmp w0, #0x22                // "
    b.eq .Lsub_qlit
    cmp w0, #0x27                // '
    b.eq .Lsub_qlit

    // Token paste: a `##` in the body concatenates the token to its left with
    // the token to its right by making them textually adjacent in the output,
    // so the rescan lexes them as one token.
    cmp w0, #'#'
    b.ne .Lsub_dispatch
    add x1, x27, #1
    cmp x1, x20
    b.hs .Lsub_dispatch          // trailing '#' → verbatim
    add x2, x19, x1
    ldrb w2, [x2]
    cmp w2, #'#'
    b.eq .Lsub_paste
    b .Lsub_stringize            // single '#' → stringise the next parameter

.Lsub_dispatch:
    // Is it an identifier char? (a-z, A-Z, _)
    cmp w0, #'_'
    b.eq .Lsub_ident
    cmp w0, #'a'
    b.lo .Lsub_not_lower
    cmp w0, #'z'
    b.ls .Lsub_ident
.Lsub_not_lower:
    cmp w0, #'A'
    b.lo .Lsub_copy_char
    cmp w0, #'Z'
    b.ls .Lsub_ident

.Lsub_copy_char:
    // Not an identifier: copy byte
    add x1, x25, x26
    strb w0, [x1]
    add x26, x26, #1
    add x27, x27, #1
    b .Lsub_loop

.Lsub_qlit:
    // Copy a "..." or '...' literal verbatim through its matching close
    // delimiter, honouring backslash escapes.  w1 holds the delimiter.
    mov w1, w0
    add x2, x25, x26             // emit opening delimiter
    strb w0, [x2]
    add x26, x26, #1
    add x27, x27, #1
.Lsub_qlit_body:
    cmp x27, x20
    b.hs .Lsub_loop              // unterminated at body end: stop, resume loop
    add x2, x19, x27
    ldrb w0, [x2]
    add x2, x25, x26             // emit this byte
    strb w0, [x2]
    add x26, x26, #1
    add x27, x27, #1
    cmp w0, #0x5c                // backslash: next byte is escaped, copy verbatim
    b.ne .Lsub_qlit_notesc
    cmp x27, x20
    b.hs .Lsub_loop
    add x2, x19, x27
    ldrb w0, [x2]
    add x2, x25, x26
    strb w0, [x2]
    add x26, x26, #1
    add x27, x27, #1
    b .Lsub_qlit_body
.Lsub_qlit_notesc:
    cmp w0, w1                   // matching close delimiter ends the literal
    b.eq .Lsub_loop
    b .Lsub_qlit_body

.Lsub_stringize:
    // `# param` → a string literal of the argument's spelling.  Consume the
    // `#` and any whitespace, extract the parameter name, and emit its argument
    // quoted (via _kcc_pp_emit_string).  A `#` not followed by a parameter is
    // copied verbatim.
    add x27, x27, #1             // skip '#'
.Lsub_str_ws:
    cmp x27, x20
    b.hs .Lsub_str_hash
    add x0, x19, x27
    ldrb w0, [x0]
    cmp w0, #0x20
    b.eq .Lsub_str_ws_adv
    cmp w0, #0x09
    b.ne .Lsub_str_id
.Lsub_str_ws_adv:
    add x27, x27, #1
    b .Lsub_str_ws
.Lsub_str_id:
    mov x28, x27                 // identifier start
.Lsub_str_id_cont:
    add x27, x27, #1
    cmp x27, x20
    b.hs .Lsub_str_id_end
    add x0, x19, x27
    ldrb w0, [x0]
    cmp w0, #'_'
    b.eq .Lsub_str_id_cont
    cmp w0, #'a'
    b.lo .Lsub_str_id_nl
    cmp w0, #'z'
    b.ls .Lsub_str_id_cont
.Lsub_str_id_nl:
    cmp w0, #'A'
    b.lo .Lsub_str_id_nu
    cmp w0, #'Z'
    b.ls .Lsub_str_id_cont
.Lsub_str_id_nu:
    cmp w0, #'0'
    b.lo .Lsub_str_id_end
    cmp w0, #'9'
    b.ls .Lsub_str_id_cont
.Lsub_str_id_end:
    // Match identifier body[x28..x27) against the parameter names.
    add x0, x19, x28
    sub x1, x27, x28
    mov x2, #0
.Lsub_str_pcheck:
    cmp x2, x22
    b.hs .Lsub_str_notparam
    mov x3, #PP_PARAM_SIZE
    mul x4, x2, x3
    add x4, x21, x4
    ldr x5, [x4, #PP_PARAM_NAME]
    ldr x6, [x4, #PP_PARAM_LEN]
    cmp x1, x6
    b.ne .Lsub_str_pnext
    stp x0, x1, [sp, #-16]!
    mov x7, x2
    mov x2, x1
    mov x1, x5
    bl _kcc_memcmp
    ldp x8, x1, [sp], #16
    mov x2, x7
    cbz x0, .Lsub_str_found
    mov x0, x8
.Lsub_str_pnext:
    add x2, x2, #1
    b .Lsub_str_pcheck
.Lsub_str_found:
    // Emit the argument as a quoted string literal.
    lsl x3, x2, #4
    add x3, x23, x3
    ldr x0, [x3, #0]             // arg text
    ldr x1, [x3, #8]             // arg len
    add x2, x25, x26             // dest
    bl _kcc_pp_emit_string       // → x0 = bytes written
    add x26, x26, x0
    b .Lsub_loop
.Lsub_str_notparam:
    // '#' followed by a non-parameter identifier: emit '#' then the identifier.
    add x1, x25, x26
    mov w0, #'#'
    strb w0, [x1]
    add x26, x26, #1
    mov x3, #0
.Lsub_str_np_copy:
    sub x1, x27, x28
    cmp x3, x1
    b.hs .Lsub_loop
    add x4, x19, x28
    ldrb w5, [x4, x3]
    add x4, x25, x26
    strb w5, [x4]
    add x26, x26, #1
    add x3, x3, #1
    b .Lsub_str_np_copy
.Lsub_str_hash:
    // Trailing '#': emit verbatim.
    add x1, x25, x26
    mov w0, #'#'
    strb w0, [x1]
    add x26, x26, #1
    b .Lsub_loop

.Lsub_paste:
    // GNU comma elision `, ## PARAM`: if the ## right operand is a parameter
    // whose argument is empty, the ## deletes it and a preceding comma (the
    // kernel's `static_assert(expr, ...)` macro relies on this).  Peek the
    // operand identifier; if it names a parameter with an empty argument, drop
    // the comma and consume both the ## and the operand.
    add x9, x27, #2              // past the ##
.Lsub_ce_ws:
    cmp x9, x20
    b.hs .Lsub_paste_trim
    add x0, x19, x9
    ldrb w0, [x0]
    cmp w0, #0x20
    b.eq .Lsub_ce_ws_adv
    cmp w0, #0x09
    b.ne .Lsub_ce_id0
.Lsub_ce_ws_adv:
    add x9, x9, #1
    b .Lsub_ce_ws
.Lsub_ce_id0:
    mov x10, x9                 // operand identifier start
.Lsub_ce_idc:
    cmp x9, x20
    b.hs .Lsub_ce_idend
    add x0, x19, x9
    ldrb w0, [x0]
    cmp w0, #'_'
    b.eq .Lsub_ce_idadv
    cmp w0, #'0'
    b.lo .Lsub_ce_idend
    cmp w0, #'9'
    b.ls .Lsub_ce_idadv
    cmp w0, #'a'
    b.lo .Lsub_ce_idup
    cmp w0, #'z'
    b.ls .Lsub_ce_idadv
.Lsub_ce_idup:
    cmp w0, #'A'
    b.lo .Lsub_ce_idend
    cmp w0, #'Z'
    b.hi .Lsub_ce_idend
.Lsub_ce_idadv:
    add x9, x9, #1
    b .Lsub_ce_idc
.Lsub_ce_idend:
    sub x11, x9, x10            // operand identifier length
    cbz x11, .Lsub_paste_trim
    mov x12, #0                 // param index k
.Lsub_ce_match:
    cmp x12, x22
    b.hs .Lsub_paste_trim       // no parameter matched → normal paste
    mov x13, #PP_PARAM_SIZE
    mul x13, x12, x13
    add x13, x21, x13           // &params[k]
    ldr x14, [x13, #PP_PARAM_LEN]
    cmp x14, x11
    b.ne .Lsub_ce_next
    stp x10, x11, [sp, #-16]!
    stp x12, x13, [sp, #-16]!
    add x0, x19, x10
    ldr x1, [x13, #PP_PARAM_NAME]
    mov x2, x11
    bl _kcc_memcmp
    ldp x12, x13, [sp], #16
    ldp x10, x11, [sp], #16
    cbnz x0, .Lsub_ce_next
    // Parameter k matched.  Is its argument empty? (args[k].len at offset 8)
    lsl x13, x12, #4
    add x13, x23, x13
    ldr x14, [x13, #8]
    cbnz x14, .Lsub_paste_trim  // non-empty operand → normal paste
    // Empty operand: trim trailing whitespace, then drop a trailing comma.
.Lsub_ce_trim:
    cbz x26, .Lsub_ce_done
    sub x1, x26, #1
    add x3, x25, x1
    ldrb w4, [x3]
    cmp w4, #0x20
    b.eq .Lsub_ce_trim_adv
    cmp w4, #0x09
    b.ne .Lsub_ce_comma
.Lsub_ce_trim_adv:
    mov x26, x1
    b .Lsub_ce_trim
.Lsub_ce_comma:
    sub x1, x26, #1
    add x3, x25, x1
    ldrb w4, [x3]
    cmp w4, #','
    b.ne .Lsub_ce_done
    mov x26, x1
.Lsub_ce_done:
    mov x27, x9                 // consume the ## and the empty operand
    b .Lsub_loop
.Lsub_ce_next:
    add x12, x12, #1
    b .Lsub_ce_match

    // Drop any whitespace already emitted for the left operand, so it abuts.
.Lsub_paste_trim:
    cbz x26, .Lsub_paste_skip
    sub x1, x26, #1
    add x3, x25, x1
    ldrb w4, [x3]
    cmp w4, #0x20            // space
    b.eq .Lsub_paste_drop
    cmp w4, #0x09            // tab
    b.ne .Lsub_paste_skip
.Lsub_paste_drop:
    mov x26, x1
    b .Lsub_paste_trim
.Lsub_paste_skip:
    add x27, x27, #2         // skip the ##
    // Skip whitespace before the right operand so it, too, abuts.
.Lsub_paste_ws:
    cmp x27, x20
    b.hs .Lsub_loop
    add x0, x19, x27
    ldrb w0, [x0]
    cmp w0, #0x20
    b.eq .Lsub_paste_ws_adv
    cmp w0, #0x09
    b.ne .Lsub_loop
.Lsub_paste_ws_adv:
    add x27, x27, #1
    b .Lsub_paste_ws
@}

\paragraph{Identifier extraction and parameter matching.}
When the body walker encounters the start of an identifier (a letter or
underscore), it enters the extraction path.  The scanner advances through
subsequent identifier characters to delimit the full name, then compares
it against every parameter in the macro's parameter list using
\texttt{\_kcc\_memcmp}.  A match causes the corresponding argument text
to be copied into the output buffer; an unmatched identifier is copied
verbatim.

@d PP: expand @{
.Lsub_ident:
    // Found identifier start. Extract the full identifier
    mov x28, x27               // x28 = ident start position
.Lsub_ident_cont:
    add x27, x27, #1
    cmp x27, x20
    b.hs .Lsub_ident_end
    add x0, x19, x27
    ldrb w0, [x0]
    cmp w0, #'_'
    b.eq .Lsub_ident_cont
    cmp w0, #'a'
    b.lo .Lsub_id_not_lower
    cmp w0, #'z'
    b.ls .Lsub_ident_cont
.Lsub_id_not_lower:
    cmp w0, #'A'
    b.lo .Lsub_id_not_upper
    cmp w0, #'Z'
    b.ls .Lsub_ident_cont
.Lsub_id_not_upper:
    cmp w0, #'0'
    b.lo .Lsub_ident_end
    cmp w0, #'9'
    b.ls .Lsub_ident_cont

.Lsub_ident_end:
    // Identifier is body[x28..x27)
    add  x0, x19, x28         // ident text ptr
    sub  x1, x27, x28         // ident len

    // Check against each parameter name
    mov  x2, #0                // param index
.Lsub_param_check:
    cmp  x2, x22
    b.hs .Lsub_not_param      // no match

    // params[x2]
    mov  x3, #PP_PARAM_SIZE
    mul  x4, x2, x3
    add  x4, x21, x4
    ldr  x5, [x4, #PP_PARAM_NAME]
    ldr  x6, [x4, #PP_PARAM_LEN]

    // Compare lengths first
    cmp  x1, x6
    b.ne .Lsub_param_next

    // Compare text
    // Save registers we need across memcmp
    stp  x0, x1, [sp, #-16]!  // push ident ptr, len
    mov  x7, x2                // save param index
    mov  x2, x1                // len for memcmp
    mov  x1, x5                // param name
    // x0 already = ident text
    bl _kcc_memcmp
    ldp  x8, x1, [sp], #16    // restore ident ptr, len
    mov  x2, x7                // restore param index

    cbz  x0, .Lsub_found_param
    mov  x0, x8                // restore ident ptr
    b .Lsub_param_next

.Lsub_param_next:
    add  x2, x2, #1
    b .Lsub_param_check

.Lsub_not_param:
    // Not a parameter: copy identifier text as-is
    sub  x1, x27, x28         // ident len
    mov  x2, #0
.Lsub_copy_ident:
    cmp  x2, x1
    b.hs .Lsub_loop
    add  x3, x19, x28
    ldrb w4, [x3, x2]
    add  x3, x25, x26
    strb w4, [x3]
    add  x26, x26, #1
    add  x2, x2, #1
    b .Lsub_copy_ident

.Lsub_found_param:
    // Substitute: copy argument text instead
    // x2 = param index (same as arg index)
    lsl  x3, x2, #4           // * 16
    add  x3, x23, x3
    ldr  x4, [x3, #0]         // arg text ptr
    ldr  x5, [x3, #8]         // arg text len

    mov  x2, #0
.Lsub_copy_arg:
    cmp  x2, x5
    b.hs .Lsub_loop
    ldrb w6, [x4, x2]
    add  x3, x25, x26
    strb w6, [x3]
    add  x26, x26, #1
    add  x2, x2, #1
    b .Lsub_copy_arg

.Lsub_done:
    mov  x0, x25               // result ptr
    mov  x1, x26               // result len

    ldp x27, x28, [sp, #80]
    ldp x25, x26, [sp, #64]
    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #96
    ret
@}

\paragraph{Stringising an argument.}
The \texttt{\#} operator (\stdref{6.10.3.2}) turns an argument into a string
literal.  \texttt{\_kcc\_pp\_emit\_string} writes the quoted form: an opening
\texttt{"}, the argument with leading and trailing whitespace stripped and
every internal run of whitespace collapsed to a single space, each embedded
\texttt{"} or \texttt{\textbackslash} preceded by a backslash, then a closing
\texttt{"}.  It operates on the substituted argument text; since kcc's
arguments are already prescan-expanded this differs from the strict standard
only when a \texttt{\#} operand is itself a macro, which real code stringising
a type or token name never does.

@d PP: expand @{
// -- _kcc_pp_emit_string --------------------------------------------
// (const char *src, uint64_t len, char *dest) → x0 = bytes written.
// Emits a "..." string literal of src with whitespace collapsed and " / \ escaped.
.p2align 2
_kcc_pp_emit_string:
    mov x3, x2                 // dest cursor
    mov w4, #0x22              // opening quote
    strb w4, [x3], #1
    mov x5, #0                 // index
.Les_lead:
    cmp x5, x1
    b.hs .Les_close
    ldrb w6, [x0, x5]
    cmp w6, #0x20
    b.eq .Les_lead_adv
    cmp w6, #0x09
    b.ne .Les_body
.Les_lead_adv:
    add x5, x5, #1
    b .Les_lead
.Les_body:
    mov x7, #0                 // pending-space flag (collapses whitespace runs)
.Les_loop:
    cmp x5, x1
    b.hs .Les_close
    ldrb w6, [x0, x5]
    cmp w6, #0x20
    b.eq .Les_ws
    cmp w6, #0x09
    b.eq .Les_ws
    cbz x7, .Les_noflush
    mov w8, #0x20
    strb w8, [x3], #1          // flush one collapsed space
    mov x7, #0
.Les_noflush:
    cmp w6, #0x22              // escape " and \
    b.eq .Les_esc
    cmp w6, #0x5C
    b.eq .Les_esc
    strb w6, [x3], #1
    b .Les_adv
.Les_esc:
    mov w8, #0x5C
    strb w8, [x3], #1
    strb w6, [x3], #1
    b .Les_adv
.Les_ws:
    mov x7, #1                 // remember; trailing whitespace is never flushed
.Les_adv:
    add x5, x5, #1
    b .Les_loop
.Les_close:
    mov w4, #0x22              // closing quote
    strb w4, [x3], #1
    sub x0, x3, x2             // bytes written
    ret
@| _kcc_pp_emit_string
@}

\section{Predefined Macros}

ISO C17 requires several predefined macros (\stdref{6.10.8}).  We
define \texttt{\_\_STDC\_\_} (1), \texttt{\_\_STDC\_VERSION\_\_}
(201710L), and \texttt{\_\_STDC\_HOSTED\_\_} (1).  \texttt{\_\_LINE\_\_}
is also registered, but with a placeholder body: because its value is the
line of each \emph{use}, \texttt{\_kcc\_pp\_try\_expand} recognises it and
substitutes the current \texttt{\_kcc\_lex\_line} formatted as a decimal
token, rather than expanding a fixed body.  Registering it still lets
\verb|#ifdef __LINE__| see it and prevents \verb|#undef|.
\texttt{\_\_FILE\_\_} works the same way: recognised in
\texttt{\_kcc\_pp\_try\_expand}, it substitutes the current source path
(\texttt{\_kcc\_src\_path}, which the \texttt{\#include} machinery saves and
restores per file, so it names the header when used inside one) wrapped in
double quotes as a fresh string-literal token.  The kernel reaches
\texttt{\_\_FILE\_\_} through \texttt{WARN()}/\texttt{BUG()}/\texttt{pr\_*} in
roughly half of all source files.  \texttt{\_\_COUNTER\_\_} is dynamic in the
same family, but its value depends on nothing in the source: each expansion
yields the next integer of a monotonically increasing counter
(\texttt{\_kcc\_pp\_counter}, starting at~0), which \texttt{\_kcc\_pp\_try\_expand}
formats through the very decimal path \texttt{\_\_LINE\_\_} uses and then
increments.  The kernel builds unique identifiers with it
(\texttt{\_\_UNIQUE\_ID}, lockdep key names).

Four further macros advertise the \emph{conditional features}
(\stdref{6.10.8.3}) kcc does not implement.  Atomics, threads, complex
arithmetic, and variable-length arrays are the only optional parts of the
language; an implementation that omits one must say so by defining the
matching \texttt{\_\_STDC\_NO\_*} macro, so that a program can test for the
feature with \verb|#ifdef| and choose a fallback rather than fail at a missing
header or type.  Declaring the absence is what makes the omission
\emph{conforming} rather than a gap: kcc defines
\texttt{\_\_STDC\_NO\_ATOMICS\_\_}, \texttt{\_\_STDC\_NO\_THREADS\_\_},
\texttt{\_\_STDC\_NO\_COMPLEX\_\_}, and \texttt{\_\_STDC\_NO\_VLA\_\_}, each to
\texttt{1}.  With them the compiler is fully conforming in the freestanding
sense without ever supplying \verb|<stdatomic.h>|, \verb|<threads.h>|,
\verb|<complex.h>|, or \verb|<tgmath.h>|.

Five more announce the target's \emph{byte order}, using gcc and clang's own
spelling: \texttt{\_\_ORDER\_LITTLE\_ENDIAN\_\_} (1234),
\texttt{\_\_ORDER\_BIG\_ENDIAN\_\_} (4321), \texttt{\_\_ORDER\_PDP\_ENDIAN\_\_}
(3412), \texttt{\_\_BYTE\_ORDER\_\_} (set to the little-endian value, since both
Apple ARM64 and Linux x86-64 are little-endian), and the older bare
\texttt{\_\_LITTLE\_ENDIAN\_\_} flag.  Portable code selects its endian-swap
routines with \verb|#if __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__| and
\verb|#error|s when no order name resolves---\emph{doomgeneric}'s
\texttt{i\_swap.h} is exactly this shape.  All three order names \emph{must} be
defined together: an undefined \texttt{\_\_BYTE\_ORDER\_\_} is \texttt{0} inside a
\verb|#if|, which would compare equal to a likewise-undefined
\texttt{\_\_ORDER\_LITTLE\_ENDIAN\_\_} and silently pick the wrong branch.

@d PP: predefined @{
.text
// -- _kcc_pp_predefine ----------------------------------------------
// Registers predefined macros in the macro table.
.p2align 2
_kcc_pp_predefine:
    stp x29, x30, [sp, #-32]!
    mov x29, sp
    stp x19, x20, [sp, #16]

    // __STDC__ = 1
    adrp x0, _kcc_pp_pre_stdc@@PAGE
    add  x0, x0, _kcc_pp_pre_stdc@@PAGEOFF
    mov  x1, #8                // len("__STDC__")
    adrp x2, _kcc_pp_pre_one@@PAGE
    add  x2, x2, _kcc_pp_pre_one@@PAGEOFF
    mov  x3, #1                // len("1")
    bl _kcc_pp_def_simple

    // __STDC_VERSION__ = 201710L
    adrp x0, _kcc_pp_pre_stdc_ver@@PAGE
    add  x0, x0, _kcc_pp_pre_stdc_ver@@PAGEOFF
    mov  x1, #16               // len("__STDC_VERSION__")
    adrp x2, _kcc_pp_pre_c17val@@PAGE
    add  x2, x2, _kcc_pp_pre_c17val@@PAGEOFF
    mov  x3, #7                // len("201710L")
    bl _kcc_pp_def_simple

    // __STDC_HOSTED__ = 1
    adrp x0, _kcc_pp_pre_hosted@@PAGE
    add  x0, x0, _kcc_pp_pre_hosted@@PAGEOFF
    mov  x1, #15               // len("__STDC_HOSTED__")
    adrp x2, _kcc_pp_pre_one@@PAGE
    add  x2, x2, _kcc_pp_pre_one@@PAGEOFF
    mov  x3, #1
    bl _kcc_pp_def_simple

    // Conditional-feature macros (\stdref{6.10.8.3}): kcc supports none of
    // atomics, threads, complex arithmetic, or variable-length arrays, so it
    // declares each absent (= 1) rather than leaving it undefined.
    adrp x0, _kcc_pp_pre_no_atomics@@PAGE
    add  x0, x0, _kcc_pp_pre_no_atomics@@PAGEOFF
    mov  x1, #19               // len("__STDC_NO_ATOMICS__")
    adrp x2, _kcc_pp_pre_one@@PAGE
    add  x2, x2, _kcc_pp_pre_one@@PAGEOFF
    mov  x3, #1
    bl _kcc_pp_def_simple

    adrp x0, _kcc_pp_pre_no_threads@@PAGE
    add  x0, x0, _kcc_pp_pre_no_threads@@PAGEOFF
    mov  x1, #19               // len("__STDC_NO_THREADS__")
    adrp x2, _kcc_pp_pre_one@@PAGE
    add  x2, x2, _kcc_pp_pre_one@@PAGEOFF
    mov  x3, #1
    bl _kcc_pp_def_simple

    adrp x0, _kcc_pp_pre_no_complex@@PAGE
    add  x0, x0, _kcc_pp_pre_no_complex@@PAGEOFF
    mov  x1, #19               // len("__STDC_NO_COMPLEX__")
    adrp x2, _kcc_pp_pre_one@@PAGE
    add  x2, x2, _kcc_pp_pre_one@@PAGEOFF
    mov  x3, #1
    bl _kcc_pp_def_simple

    adrp x0, _kcc_pp_pre_no_vla@@PAGE
    add  x0, x0, _kcc_pp_pre_no_vla@@PAGEOFF
    mov  x1, #15               // len("__STDC_NO_VLA__")
    adrp x2, _kcc_pp_pre_one@@PAGE
    add  x2, x2, _kcc_pp_pre_one@@PAGEOFF
    mov  x3, #1
    bl _kcc_pp_def_simple

    // Data-model macros.  Apple ARM64 is LP64---long and pointer are 64-bit---so
    // __LP64__/_LP64 are defined; portable code selects type widths from them.
    // Arch/OS identity macros (__APPLE__, __aarch64__) are deliberately NOT
    // defined: they gate platform-specific headers, intrinsics, and inline asm
    // that kcc does not support, so announcing them would break otherwise
    // portable code.  Data-model macros only steer type choices kcc handles.
    adrp x0, _kcc_pp_pre_lp64@@PAGE
    add  x0, x0, _kcc_pp_pre_lp64@@PAGEOFF
    mov  x1, #8                // len("__LP64__")
    adrp x2, _kcc_pp_pre_one@@PAGE
    add  x2, x2, _kcc_pp_pre_one@@PAGEOFF
    mov  x3, #1
    bl _kcc_pp_def_simple

    adrp x0, _kcc_pp_pre_lp64b@@PAGE
    add  x0, x0, _kcc_pp_pre_lp64b@@PAGEOFF
    mov  x1, #5                // len("_LP64")
    adrp x2, _kcc_pp_pre_one@@PAGE
    add  x2, x2, _kcc_pp_pre_one@@PAGEOFF
    mov  x3, #1
    bl _kcc_pp_def_simple

    // __LINE__ — registered so `#ifdef __LINE__` sees it and it cannot be
    // #undef'd; the body here is a placeholder, since _kcc_pp_try_expand
    // substitutes the current line number dynamically at each use (§6.10.8.1).
    adrp x0, _kcc_pp_pre_linem@@PAGE
    add  x0, x0, _kcc_pp_pre_linem@@PAGEOFF
    mov  x1, #8                // len("__LINE__")
    adrp x2, _kcc_pp_pre_one@@PAGE
    add  x2, x2, _kcc_pp_pre_one@@PAGEOFF
    mov  x3, #1
    bl _kcc_pp_def_simple

    // __FILE__ — like __LINE__, registered so `#ifdef __FILE__` sees it and it
    // cannot be #undef'd; _kcc_pp_try_expand substitutes the current source path
    // as a string literal dynamically at each use (§6.10.8.1).
    adrp x0, _kcc_pp_pre_filem@@PAGE
    add  x0, x0, _kcc_pp_pre_filem@@PAGEOFF
    mov  x1, #8                // len("__FILE__")
    adrp x2, _kcc_pp_pre_one@@PAGE
    add  x2, x2, _kcc_pp_pre_one@@PAGEOFF
    mov  x3, #1
    bl _kcc_pp_def_simple

    // __COUNTER__ — like __LINE__, registered so `#ifdef __COUNTER__` sees it and
    // it cannot be #undef'd; _kcc_pp_try_expand substitutes a fresh incrementing
    // integer at each use.  The kernel's `unique id` idioms (e.g. lock names,
    // __UNIQUE_ID) rely on it.
    adrp x0, _kcc_pp_pre_counterm@@PAGE
    add  x0, x0, _kcc_pp_pre_counterm@@PAGEOFF
    mov  x1, #11               // len("__COUNTER__")
    adrp x2, _kcc_pp_pre_one@@PAGE
    add  x2, x2, _kcc_pp_pre_one@@PAGEOFF
    mov  x3, #1
    bl _kcc_pp_def_simple

    // Byte-order macros, exactly as gcc/clang publish them.  Real code selects
    // its endian-swap routines with `#if __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__'
    // and `#error's when none of the three order names resolve (doomgeneric's
    // i_swap.h does this); an undefined `__BYTE_ORDER__' is 0 in a `#if', which
    // would compare equal to a likewise-undefined `__ORDER_*' and take the wrong
    // branch, so all must be defined.  Both kcc targets are little-endian.
    adrp x0, _kcc_pp_pre_ord_le@@PAGE
    add  x0, x0, _kcc_pp_pre_ord_le@@PAGEOFF
    mov  x1, #23               // len("__ORDER_LITTLE_ENDIAN__")
    adrp x2, _kcc_pp_pre_v1234@@PAGE
    add  x2, x2, _kcc_pp_pre_v1234@@PAGEOFF
    mov  x3, #4
    bl _kcc_pp_def_simple

    adrp x0, _kcc_pp_pre_ord_be@@PAGE
    add  x0, x0, _kcc_pp_pre_ord_be@@PAGEOFF
    mov  x1, #20               // len("__ORDER_BIG_ENDIAN__")
    adrp x2, _kcc_pp_pre_v4321@@PAGE
    add  x2, x2, _kcc_pp_pre_v4321@@PAGEOFF
    mov  x3, #4
    bl _kcc_pp_def_simple

    adrp x0, _kcc_pp_pre_ord_pdp@@PAGE
    add  x0, x0, _kcc_pp_pre_ord_pdp@@PAGEOFF
    mov  x1, #20               // len("__ORDER_PDP_ENDIAN__")
    adrp x2, _kcc_pp_pre_v3412@@PAGE
    add  x2, x2, _kcc_pp_pre_v3412@@PAGEOFF
    mov  x3, #4
    bl _kcc_pp_def_simple

    adrp x0, _kcc_pp_pre_byteord@@PAGE
    add  x0, x0, _kcc_pp_pre_byteord@@PAGEOFF
    mov  x1, #14               // len("__BYTE_ORDER__")
    adrp x2, _kcc_pp_pre_v1234@@PAGE
    add  x2, x2, _kcc_pp_pre_v1234@@PAGEOFF
    mov  x3, #4
    bl _kcc_pp_def_simple

    adrp x0, _kcc_pp_pre_le@@PAGE
    add  x0, x0, _kcc_pp_pre_le@@PAGEOFF
    mov  x1, #17               // len("__LITTLE_ENDIAN__")
    adrp x2, _kcc_pp_pre_one@@PAGE
    add  x2, x2, _kcc_pp_pre_one@@PAGEOFF
    mov  x3, #1
    bl _kcc_pp_def_simple

    // Replay any command-line -D definitions on top of the built-ins.  The
    // macro table is rebuilt for every translation unit, so this runs each time
    // the preprocessor is (re)initialised, keeping -D macros defined per source.
    bl _kcc_pp_apply_cmdline_defines

    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #32
    ret

// -- _kcc_pp_def_simple ---------------------------------------------
// Helper: define a simple object-like macro.
// x0=name, x1=namelen, x2=body, x3=bodylen
.p2align 2
_kcc_pp_def_simple:
    stp x29, x30, [sp, #-64]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    stp x23, x24, [sp, #48]

    mov x19, x0               // name
    mov x20, x1               // namelen
    mov x21, x2               // body
    mov x22, x3               // bodylen

    // Allocate macro definition
    mov x0, #PP_MACRO_SIZE
    bl _kcc_arena_alloc
    mov x23, x0

    str x19, [x23, #PP_MACRO_NAME]
    str x20, [x23, #PP_MACRO_NAMELEN]
    mov x0, #PP_FLAG_BUILTIN
    str x0, [x23, #PP_MACRO_FLAGS]
    str xzr, [x23, #PP_MACRO_NPARAMS]
    str x21, [x23, #PP_MACRO_BODY]
    str x22, [x23, #PP_MACRO_BODYLEN]
    str xzr, [x23, #PP_MACRO_PARAMS]

    // Store in hash table
    adrp x0, _kcc_pp_macros@@PAGE
    add  x0, x0, _kcc_pp_macros@@PAGEOFF
    ldr  x0, [x0]
    mov  x1, x19
    mov  x2, x20
    mov  x3, x23
    bl _kcc_ht_put

    ldp x23, x24, [sp, #48]
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #64
    ret

// Command-line -D definitions.  The driver records each -D argument's payload
// ("NAME" or "NAME=VALUE") here during argument scanning; the list is replayed
// into the macro table by _kcc_pp_apply_cmdline_defines whenever the
// preprocessor is initialised, so the macros are present for every source.
.data
.p2align 3
_kcc_cmdline_defs:  .space 512    // up to 64 payload pointers
_kcc_cmdline_ndefs: .quad 0
.text

// -- _kcc_pp_add_cmdline_define -------------------------------------
// void _kcc_pp_add_cmdline_define(const char *payload)
//   Records a -D payload ("NAME" or "NAME=VALUE"); ignored once full.
.globl _kcc_pp_add_cmdline_define
.p2align 2
_kcc_pp_add_cmdline_define:
    adrp x1, _kcc_cmdline_ndefs@@PAGE
    add  x1, x1, _kcc_cmdline_ndefs@@PAGEOFF
    ldr  x2, [x1]
    cmp  x2, #64
    b.hs .Lacd_done
    adrp x3, _kcc_cmdline_defs@@PAGE
    add  x3, x3, _kcc_cmdline_defs@@PAGEOFF
    str  x0, [x3, x2, lsl #3]
    add  x2, x2, #1
    str  x2, [x1]
.Lacd_done:
    ret

// -- _kcc_pp_apply_cmdline_defines ----------------------------------
// void _kcc_pp_apply_cmdline_defines(void)
//   Defines each recorded -D macro.  "NAME" defines NAME as 1; "NAME=VALUE"
//   splits at the first '=' and defines NAME as VALUE (a bare NAME with no
//   value takes 1, matching cc's convention).  Names and bodies point into the
//   original argv strings and are used by length, so no copy is needed.
.globl _kcc_pp_apply_cmdline_defines
.p2align 2
_kcc_pp_apply_cmdline_defines:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]
    adrp x0, _kcc_cmdline_ndefs@@PAGE
    add  x0, x0, _kcc_cmdline_ndefs@@PAGEOFF
    ldr  x20, [x0]                 // count
    mov  x19, #0                   // i
.Lapd_loop:
    cmp  x19, x20
    b.hs .Lapd_done
    adrp x0, _kcc_cmdline_defs@@PAGE
    add  x0, x0, _kcc_cmdline_defs@@PAGEOFF
    ldr  x21, [x0, x19, lsl #3]    // payload ptr
    // Scan for '=' → x22 = name length (or full length when absent).
    mov  x22, #0
.Lapd_scan:
    ldrb w0, [x21, x22]
    cbz  w0, .Lapd_no_eq
    cmp  w0, #'='
    b.eq .Lapd_have_eq
    add  x22, x22, #1
    b .Lapd_scan
.Lapd_have_eq:
    add  x2, x21, x22
    add  x2, x2, #1               // value = payload + namelen + 1
    mov  x0, x2
    bl _kcc_strlen                 // x0 = value length
    mov  x3, x0
    add  x2, x21, x22
    add  x2, x2, #1               // value ptr (recompute; strlen clobbers)
    mov  x0, x21                   // name
    mov  x1, x22                   // namelen
    bl _kcc_pp_def_simple
    b .Lapd_next
.Lapd_no_eq:
    // Bare NAME: define as 1.
    mov  x0, x21                   // name
    mov  x1, x22                   // namelen
    adrp x2, _kcc_pp_pre_one@@PAGE
    add  x2, x2, _kcc_pp_pre_one@@PAGEOFF
    mov  x3, #1
    bl _kcc_pp_def_simple
.Lapd_next:
    add  x19, x19, #1
    b .Lapd_loop
.Lapd_done:
    ldp x21, x22, [sp, #32]
    ldp x19, x20, [sp, #16]
    ldp x29, x30, [sp], #48
    ret
@| _kcc_pp_add_cmdline_define _kcc_pp_apply_cmdline_defines
@}

