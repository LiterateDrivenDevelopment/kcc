% 43-main.weft — Entry Point and Argument Parsing
%
% This is where kcc begins execution.  The _main function receives
% argc and argv from the macOS kernel, initializes the compiler's
% subsystems, and orchestrates the compilation pipeline.
%
% Phase 1 adds --dump-tokens: open a source file, tokenize it,
% and print every token with its source location.

\chapter{The Driver}
\label{ch:driver}

This chapter is where execution begins.  The \texttt{\_main} function receives \texttt{argc} and \texttt{argv} from the macOS kernel, initializes the compiler's core subsystems (arena allocator, keyword table, I/O), and dispatches to the appropriate pipeline based on the command-line flags.  Supported modes include \texttt{--dump-tokens} for lexer debugging, \texttt{--dump-ast} for parser output, \texttt{--dump-ir} for IR inspection, and \texttt{-c} for full compilation to a Mach-O object file.  The diagnostic modes are selected by \texttt{argv[1]}, but \texttt{-c} is recognised \emph{anywhere} in the argument list: a gcc-driven build (Kbuild) leads with its flags and ends with \texttt{-c -o out.o in.c}, so a fixed \texttt{argv[1]} test would miss the \texttt{-c} and fall through to link mode.

\section{Entry Point}

On macOS, the kernel passes control to \texttt{\_main} with:
\begin{itemize}
\item \reg{x0} = \texttt{argc} (argument count)
\item \reg{x1} = \texttt{argv} (pointer to argument vector)
\end{itemize}

We save these immediately in callee-saved registers, then initialize
the arena and I/O subsystems before doing any real work.

@d Main: entry point @{
// -- _main ---
// Entry point for kcc.
// x0 = argc, x1 = argv
.text
.globl _main
.p2align 2
_main:
    stp x29, x30, [sp, #-48]!
    mov x29, sp
    stp x19, x20, [sp, #16]
    stp x21, x22, [sp, #32]

    // Save argc and argv
    mov x19, x0                   // x19 = argc
    mov x20, x1                   // x20 = argv

    // Capture envp (= argv + (argc+1)*8, past the NULL that ends argv) so the
    // driver can pass the environment on to the linker via execve.
    add x2, x19, #1
    add x2, x20, x2, lsl #3
    adrp x3, _kcc_envp@@PAGE
    add  x3, x3, _kcc_envp@@PAGEOFF
    str x2, [x3]

    // Initialize subsystems
    bl _kcc_arena_init
    bl _kcc_lex_kw_init

    // Register the compiler's default include directory (dirname(argv[0]) +
    // "include") once, before any file is processed and outliving the per-file
    // preprocessor state, so the shipped hosted headers resolve with no -I.
    // Uses the arena, so it must follow arena initialisation.
    ldr x0, [x20]                 // argv[0] = program path
    bl _kcc_pp_add_default_includes

    // Print banner
    adrp x0, _kcc_banner@@PAGE
    add  x0, x0, _kcc_banner@@PAGEOFF
    bl _kcc_io_puts

    // Check for arguments
    cmp x19, #2
    b.lt .Lmain_no_args

    // Check if argv[1] is "--dump-tokens"
    ldr x0, [x20, #8]            // argv[1]
    adrp x1, _kcc_opt_dump_tokens@@PAGE
    add  x1, x1, _kcc_opt_dump_tokens@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lmain_dump_tokens

    // Check if argv[1] is "-E" (preprocess only)
    ldr x0, [x20, #8]            // argv[1]
    adrp x1, _kcc_opt_preprocess@@PAGE
    add  x1, x1, _kcc_opt_preprocess@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lmain_preprocess

    // Check if argv[1] is "--dump-ast"
    ldr x0, [x20, #8]            // argv[1]
    adrp x1, _kcc_opt_dump_ast@@PAGE
    add  x1, x1, _kcc_opt_dump_ast@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lmain_dump_ast

    // Check if argv[1] is "--dump-types"
    ldr x0, [x20, #8]            // argv[1]
    adrp x1, _kcc_opt_dump_types@@PAGE
    add  x1, x1, _kcc_opt_dump_types@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lmain_dump_types

    // Check if argv[1] is "--check"
    ldr x0, [x20, #8]            // argv[1]
    adrp x1, _kcc_opt_check@@PAGE
    add  x1, x1, _kcc_opt_check@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lmain_check

    // Check if argv[1] is "--dump-ir"
    ldr x0, [x20, #8]            // argv[1]
    adrp x1, _kcc_opt_dump_ir@@PAGE
    add  x1, x1, _kcc_opt_dump_ir@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lmain_dump_ir

    // Compile-only mode: "-c" anywhere in the argument list, not just as the
    // first argument.  gcc-driven builds (Kbuild) place the compiler flags
    // first and end with `-c -o out.o in.c`, so a fixed argv[1] test would miss
    // the `-c` and fall through to link mode---feeding the object flags to ld.
    mov x21, #1                  // i = 1
.Lmain_scan_c:
    cmp x21, x19
    b.ge .Lmain_scan_c_done
    ldr x0, [x20, x21, lsl #3]   // argv[i]
    adrp x1, _kcc_opt_compile@@PAGE
    add  x1, x1, _kcc_opt_compile@@PAGEOFF
    bl _kcc_strcmp
    cbz x0, .Lmain_compile
    add x21, x21, #1
    b .Lmain_scan_c
.Lmain_scan_c_done:

    // Not a flag: the argument is a source file.  Compile every source and
    // link the resulting objects into an executable (the default mode).
    mov x0, x19
    mov x1, x20
    bl _kcc_driver_link_all
    b .Lmain_exit
@| _main
@}

\paragraph{Front-end diagnostic modes.}
The first group of flags run progressively deeper prefixes of the
compilation pipeline, stopping early to dump intermediate results.
\texttt{--dump-tokens} opens the source, runs translation phases~1--2,
initializes the lexer, and prints every token.  \texttt{-E} adds the
preprocessor and dumps its output.  \texttt{--dump-ast} further adds
the parser and prints the AST tree.

@d Main: entry point @{
.Lmain_dump_tokens:
    // --dump-tokens requires a source file argument
    cmp x19, #3
    b.lt .Lmain_dump_usage

    // Open and mmap the source file
    ldr x0, [x20, #16]           // argv[2] = source file path
    bl _kcc_source_open

    // Translation Phase 1: trigraph replacement (§5.1.1.2 para 1)
    bl _kcc_source_encode

    // Translation Phase 2: line splicing (§5.1.1.2 para 2)
    bl _kcc_source_splice

    // Initialize lexer with the translated source
    adrp x0, _kcc_src_base@@PAGE
    add  x0, x0, _kcc_src_base@@PAGEOFF
    ldr  x0, [x0]

    adrp x1, _kcc_src_size@@PAGE
    add  x1, x1, _kcc_src_size@@PAGEOFF
    ldr  x1, [x1]

    bl _kcc_lex_init

    // Dump all tokens
    bl _kcc_lex_dump_all

    // Check if any errors occurred during lexing
    bl _kcc_diag_had_errors
    cbnz x0, .Lmain_error_exit
    b .Lmain_exit

.Lmain_preprocess:
    // -E requires a source file argument
    cmp x19, #3
    b.lt .Lmain_preprocess_usage

    // Open and mmap the source file
    ldr x0, [x20, #16]           // argv[2] = source file path
    bl _kcc_source_open

    // Translation Phase 1: trigraph replacement
    bl _kcc_source_encode

    // Translation Phase 2: line splicing
    bl _kcc_source_splice

    // Initialize lexer with the translated source
    adrp x0, _kcc_src_base@@PAGE
    add  x0, x0, _kcc_src_base@@PAGEOFF
    ldr  x0, [x0]

    adrp x1, _kcc_src_size@@PAGE
    add  x1, x1, _kcc_src_size@@PAGEOFF
    ldr  x1, [x1]

    bl _kcc_lex_init

    // Initialize preprocessor
    bl _kcc_pp_init

    // Dump preprocessed tokens
    bl _kcc_pp_dump_all

    // Check for errors
    bl _kcc_diag_had_errors
    cbnz x0, .Lmain_error_exit
    b .Lmain_exit

.Lmain_dump_ast:
    // --dump-ast requires a source file argument
    cmp x19, #3
    b.lt .Lmain_ast_usage

    // Open and mmap the source file
    ldr x0, [x20, #16]           // argv[2] = source file path
    bl _kcc_source_open

    // Translation Phase 1: trigraph replacement
    bl _kcc_source_encode

    // Translation Phase 2: line splicing
    bl _kcc_source_splice

    // Initialize lexer with the translated source
    adrp x0, _kcc_src_base@@PAGE
    add  x0, x0, _kcc_src_base@@PAGEOFF
    ldr  x0, [x0]

    adrp x1, _kcc_src_size@@PAGE
    add  x1, x1, _kcc_src_size@@PAGEOFF
    ldr  x1, [x1]

    bl _kcc_lex_init

    // Initialize preprocessor
    bl _kcc_pp_init

    // Initialize string table
    bl _kcc_strtab_init

    // Initialize typedef table
    bl _kcc_typedef_init

    // Parse translation unit
    bl _kcc_parse

    // Dump AST
    bl _kcc_ast_dump

    // Flush output
    bl _kcc_io_flush

    // Check for errors
    bl _kcc_diag_had_errors
    cbnz x0, .Lmain_error_exit
    b .Lmain_exit
@}

\paragraph{Semantic analysis and IR modes.}
\texttt{--dump-types} runs the full front-end plus semantic analysis,
then prints each declaration with its resolved type.  \texttt{--check}
performs the same pipeline but only reports errors---no output on
success except a confirmation message.  \texttt{--dump-ir} extends
the pipeline through IR construction and optimization, then prints the
textual IR.

@d Main: entry point @{
.Lmain_dump_types:
    // --dump-types: parse + sema + print typed declarations
    cmp x19, #3
    b.lt .Lmain_types_usage

    ldr x0, [x20, #16]           // argv[2]
    bl _kcc_source_open
    bl _kcc_source_encode
    bl _kcc_source_splice

    adrp x0, _kcc_src_base@@PAGE
    add  x0, x0, _kcc_src_base@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_src_size@@PAGE
    add  x1, x1, _kcc_src_size@@PAGEOFF
    ldr  x1, [x1]
    bl _kcc_lex_init
    bl _kcc_pp_init
    bl _kcc_strtab_init
    bl _kcc_typedef_init
    bl _kcc_parse
    mov x21, x0                   // save trans_unit

    // Initialize type system and symbol table
    bl _kcc_types_init
    bl _kcc_symtab_init

    // Run semantic analysis
    mov x0, x21
    bl _kcc_sema_check

    // Dump types
    mov x0, x21
    bl _kcc_sema_dump_types

    bl _kcc_io_flush
    bl _kcc_diag_had_errors
    cbnz x0, .Lmain_error_exit
    b .Lmain_exit

.Lmain_check:
    // --check: parse + sema, report errors only
    cmp x19, #3
    b.lt .Lmain_check_usage

    ldr x0, [x20, #16]           // argv[2]
    bl _kcc_source_open
    bl _kcc_source_encode
    bl _kcc_source_splice

    adrp x0, _kcc_src_base@@PAGE
    add  x0, x0, _kcc_src_base@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_src_size@@PAGE
    add  x1, x1, _kcc_src_size@@PAGEOFF
    ldr  x1, [x1]
    bl _kcc_lex_init
    bl _kcc_pp_init
    bl _kcc_strtab_init
    bl _kcc_typedef_init
    bl _kcc_parse
    mov x21, x0                   // save trans_unit

    // Initialize type system and symbol table
    bl _kcc_types_init
    bl _kcc_symtab_init

    // Run semantic analysis
    mov x0, x21
    bl _kcc_sema_check

    bl _kcc_io_flush
    bl _kcc_diag_had_errors
    cbnz x0, .Lmain_error_exit

    // Print success message
    adrp x0, _kcc_msg_check_ok@@PAGE
    add  x0, x0, _kcc_msg_check_ok@@PAGEOFF
    bl _kcc_io_puts
    b .Lmain_exit

.Lmain_dump_ir:
    // --dump-ir: parse + sema + IR build + optimize + dump
    cmp x19, #3
    b.lt .Lmain_ir_usage

    ldr x0, [x20, #16]           // argv[2]
    bl _kcc_source_open
    bl _kcc_source_encode
    bl _kcc_source_splice

    adrp x0, _kcc_src_base@@PAGE
    add  x0, x0, _kcc_src_base@@PAGEOFF
    ldr  x0, [x0]
    adrp x1, _kcc_src_size@@PAGE
    add  x1, x1, _kcc_src_size@@PAGEOFF
    ldr  x1, [x1]
    bl _kcc_lex_init
    bl _kcc_pp_init
    bl _kcc_strtab_init
    bl _kcc_typedef_init
    bl _kcc_parse
    mov x21, x0                   // save trans_unit

    // Initialize type system and symbol table
    bl _kcc_types_init
    bl _kcc_symtab_init

    // Run semantic analysis
    mov x0, x21
    bl _kcc_sema_check

    // Check for errors before IR
    bl _kcc_diag_had_errors
    cbnz x0, .Lmain_error_exit

    // Initialize IR module
    bl _kcc_ir_init

    // Build IR from AST
    mov x0, x21
    bl _kcc_ir_build

    // Run optimization passes
    bl _kcc_opt_run

    // Dump IR
    bl _kcc_ir_dump

    bl _kcc_io_flush
    bl _kcc_diag_had_errors
    cbnz x0, .Lmain_error_exit
    b .Lmain_exit
@}

\paragraph{Compilation and error handling.}
The \texttt{-c} flag hands the whole argument vector to
\texttt{\_kcc\_driver\_compile\_all} (Chapter~\ref{ch:compile-driver}),
which compiles \emph{each} source argument through the full pipeline
and writes one Mach-O object file per input---so a multi-file subsystem
builds in a single invocation.  An explicit \texttt{-o} names the
output only when there is exactly one source; otherwise each object
takes its source's name with \texttt{.c} rewritten to \texttt{.o}.  The
remainder of the function handles usage errors for each flag, the
no-arguments case, and the two exit paths (success with code~0, error
with code~1).

@d Main: entry point @{
.Lmain_compile:
    // -c <source...> [-o <output>]
    // At minimum one source: kcc -c source.c  (argc >= 3)
    cmp x19, #3
    b.lt .Lmain_compile_usage

    mov x0, x19                   // argc
    mov x1, x20                   // argv
    bl _kcc_driver_compile_all    // compiles each source, then exits
    b .Lmain_exit

.Lmain_compile_usage:
    // Minimal: kcc -c source.c -o out.o (but allow kcc -c src -o out)
    // Also allow: kcc -c source (default output: a.o? No, require -o)
    adrp x0, _kcc_err_compile_usage@@PAGE
    add  x0, x0, _kcc_err_compile_usage@@PAGEOFF
    bl _kcc_io_err
    mov x0, #1
    bl _kcc_sys_exit

.Lmain_ir_usage:
    adrp x0, _kcc_err_ir_usage@@PAGE
    add  x0, x0, _kcc_err_ir_usage@@PAGEOFF
    bl _kcc_io_err
    mov x0, #1
    bl _kcc_sys_exit

.Lmain_types_usage:
    adrp x0, _kcc_err_types_usage@@PAGE
    add  x0, x0, _kcc_err_types_usage@@PAGEOFF
    bl _kcc_io_err
    mov x0, #1
    bl _kcc_sys_exit

.Lmain_check_usage:
    adrp x0, _kcc_err_check_usage@@PAGE
    add  x0, x0, _kcc_err_check_usage@@PAGEOFF
    bl _kcc_io_err
    mov x0, #1
    bl _kcc_sys_exit

.Lmain_ast_usage:
    adrp x0, _kcc_err_ast_usage@@PAGE
    add  x0, x0, _kcc_err_ast_usage@@PAGEOFF
    bl _kcc_io_err
    mov x0, #1
    bl _kcc_sys_exit

.Lmain_preprocess_usage:
    adrp x0, _kcc_err_preprocess_usage@@PAGE
    add  x0, x0, _kcc_err_preprocess_usage@@PAGEOFF
    bl _kcc_io_err
    mov x0, #1
    bl _kcc_sys_exit

.Lmain_dump_usage:
    adrp x0, _kcc_err_dump_usage@@PAGE
    add  x0, x0, _kcc_err_dump_usage@@PAGEOFF
    bl _kcc_io_err
    mov x0, #1
    bl _kcc_sys_exit

.Lmain_no_args:
    adrp x0, _kcc_msg_usage@@PAGE
    add  x0, x0, _kcc_msg_usage@@PAGEOFF
    bl _kcc_io_puts
    b .Lmain_exit

.Lmain_error_exit:
    bl _kcc_io_flush
    mov x0, #1
    bl _kcc_sys_exit

.Lmain_exit:
    // Flush buffered output
    bl _kcc_io_flush

    // Exit cleanly
    mov x0, #0
    bl _kcc_sys_exit

    // Unreachable
    brk #1
@}

\section{String Constants}

The driver's string literals.  These live in the read-only data section.
Each is null-terminated for use with \texttt{kcc\_io\_puts}.

@d Main: data @{
// -- Driver string constants ---
.section __TEXT,__cstring,cstring_literals
_kcc_banner:
    .asciz "kcc v@<version@> - a formal C17 compiler for ARM64\n"
_kcc_msg_source:
    .asciz "source: "
_kcc_msg_usage:
    .asciz "usage: kcc [--dump-tokens|-E|--dump-ast|--dump-types|--check|--dump-ir|-c <src> -o <out>] <source.c>\n"
_kcc_msg_newline:
    .asciz "\n"
_kcc_opt_dump_tokens:
    .asciz "--dump-tokens"
_kcc_opt_preprocess:
    .asciz "-E"
_kcc_err_dump_usage:
    .asciz "kcc: error: --dump-tokens requires a source file\n"
_kcc_err_preprocess_usage:
    .asciz "kcc: error: -E requires a source file\n"
_kcc_opt_dump_ast:
    .asciz "--dump-ast"
_kcc_opt_dump_types:
    .asciz "--dump-types"
_kcc_opt_check:
    .asciz "--check"
_kcc_err_ast_usage:
    .asciz "kcc: error: --dump-ast requires a source file\n"
_kcc_err_types_usage:
    .asciz "kcc: error: --dump-types requires a source file\n"
_kcc_err_check_usage:
    .asciz "kcc: error: --check requires a source file\n"
_kcc_msg_check_ok:
    .asciz "semantic check passed\n"
_kcc_opt_dump_ir:
    .asciz "--dump-ir"
_kcc_err_ir_usage:
    .asciz "kcc: error: --dump-ir requires a source file\n"
_kcc_err_compile_usage:
    .asciz "kcc: error: usage: kcc -c <source.c>... [-o <output.o>]\n"
@}
